{
	"name": "@rsvelte-experimental/writing",
	"private": true,
	"description": "Checks the English prose of the repository's Markdown files with textlint",
	"type": "module",
	"scripts": {
		"lint": "node lint.ts",
		"test": "node --test '*.test.ts'",
		"typecheck": "node ../../node_modules/typescript-7/bin/tsc -p ."
	},
	"devDependencies": {
		"@textlint-rule/textlint-rule-no-invalid-control-character": "3.0.0",
		"@textlint-rule/textlint-rule-no-unmatched-pair": "2.0.4",
		"dictionary-en": "4.0.0",
		"textlint": "15.8.0",
		"textlint-rule-abbr-within-parentheses": "1.0.2",
		"textlint-rule-alex": "5.0.0",
		"textlint-rule-common-misspellings": "1.0.1",
		"textlint-rule-diacritics": "2.1.4",
		"textlint-rule-en-capitalization": "2.0.3",
		"textlint-rule-en-max-word-count": "2.0.1",
		"textlint-rule-max-comma": "4.0.0",
		"textlint-rule-no-empty-section": "1.1.0",
		"textlint-rule-no-nfd": "2.0.2",
		"textlint-rule-no-start-duplicated-conjunction": "2.0.2",
		"textlint-rule-no-zero-width-spaces": "1.0.1",
		"textlint-rule-spelling": "0.3.0",
		"textlint-rule-stop-words": "5.2.0",
		"textlint-rule-terminology": "5.2.16",
		"textlint-rule-unexpanded-acronym": "1.2.4",
		"textlint-rule-write-good": "2.0.0"
	},
	"engines": {
		"node": ">=26"
	}
}

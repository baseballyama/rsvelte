		"acorn": "8.18.0",
		"eslint": "10.11.0",
		"eslint-plugin-svelte": "3.23.0",
		"eslint-plugin-vue": "10.11.1",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"smol-toml": "1.9.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"svelte-eslint-parser": "1.8.1",
		"typescript": "6.0.3",
		"vue": "3.5.43",
		"vue-eslint-parser": "10.4.1",
		"vue-tsc": "3.3.11"

{
	"name": "@rsvelte-experimental/oracle",
	"private": true,
	"description": "The official tools: imports the corpus, runs the oracles over it, compares rsvelte against them and writes the crates' upstream cases",
	"type": "module",
	"scripts": {
		"oracle": "node oracle.ts",
		"test": "node --test '*.test.ts' '*/*.test.ts'",
		"typecheck": "node ../../node_modules/typescript-7/bin/tsc -p ."
	},
	"dependencies": {
		"@jridgewell/trace-mapping": "0.3.31",
		"@rsvelte-experimental/type-information": "workspace:*",
		"@typescript-eslint/parser": "8.73.0",
		"@volar/typescript": "2.4.31",
		"@vue/compiler-sfc": "3.5.45",
		"@vue/language-core": "3.3.14",
		"acorn": "8.19.0",
		"eslint": "10.15.0",
		"eslint-plugin-svelte": "3.24.1",
		"eslint-plugin-vue": "10.12.1",
		"globals": "16.5.0",
		"jsdom": "31.0.1",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"smol-toml": "1.9.1",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"svelte-eslint-parser": "1.10.1",
		"svelte-language-server": "0.18.6",
		"svelte2tsx": "0.7.63",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"vue": "3.5.45",
		"vue-eslint-parser": "10.4.2",
		"vue-tsc": "3.3.14",
		"vue-vapor": "npm:vue@3.6.0-rc.15",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@types/jsdom": "30.0.0",
		"@types/node": "26.6.6",
		"typescript-7": "npm:typescript@7.1.0-dev.20261102.1"
	},
	"engines": {
		"node": ">=26"
	}
}

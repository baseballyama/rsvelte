{
	"name": "@rsvelte-experimental/eslint-plugin",
	"private": true,
	"description": "eslint-plugin-rsvelte: turns off the ESLint rules rsvelte lint runs; tools/release writes the package npm publishes",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"scripts": {
		"test": "node --test '*.test.ts'",
		"typecheck": "node ../../node_modules/typescript-7/bin/tsc -p ."
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"eslint": "10.14.0",
		"eslint-plugin-svelte": "3.23.1",
		"eslint-plugin-vue": "10.12.0",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=26"
	}
}

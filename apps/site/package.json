{
	"name": "@rsvelte-experimental/site",
	"private": true,
	"type": "module",
	"description": "The rsvelte site: landing page and the /learn developer guide. SvelteKit on Cloudflare Workers.",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"lint:code-names": "node scripts/lint-code-names.mjs",
		"lint:prose": "node scripts/lint-prose.mjs",
		"lint:english": "node scripts/lint-english.mjs",
		"build:wasm": "wasm-pack build ../../crates/hosts/browser --out-dir ../../../apps/site/src/lib/wasm/kernel --out-name rsvelte_kernel_browser --target web --release",
		"predev": "pnpm run build:wasm",
		"dev": "vite dev",
		"prebuild": "pnpm run build:wasm",
		"build": "node scripts/lint-code-names.mjs && node scripts/lint-prose.mjs && vite build",
		"preview": "wrangler dev",
		"predeploy": "pnpm run build:wasm",
		"precheck": "pnpm run build:wasm",
		"deploy": "pnpm run build && wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"pretest": "pnpm run build:wasm",
		"test": "node --test scripts/prose.test.mjs scripts/english.test.mjs scripts/code-names.test.mjs && node scripts/lint-code-names.mjs && node scripts/lint-prose.mjs && vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
		"@types/node": "24.19.0",
		"shiki": "4.4.3",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"textlint": "15.8.0",
		"textlint-rule-preset-ja-technical-writing": "12.0.2",
		"textlint-rule-prh": "6.1.0",
		"typescript": "6.0.3",
		"vite": "8.3.1",
		"vitest": "5.0.2",
		"wrangler": "4.143.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}

{
	"name": "@rsvelte-experimental/site",
	"private": true,
	"description": "The rsvelte site: the user guide, the lint rules, a playground and how the toolchain works. A static SvelteKit site on GitHub Pages.",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#generated/*": "./generated/*"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"lint:code-names": "node scripts/lint-code-names.ts",
		"lint:prose": "node scripts/lint-prose.ts",
		"lint": "pnpm run lint:code-names && pnpm run lint:prose",
		"generate": "node scripts/generate.ts",
		"predev": "pnpm run generate",
		"dev": "vite dev",
		"prebuild": "pnpm run generate",
		"build": "pnpm run lint && pnpm run build:bundle",
		"build:bundle": "vite build",
		"preview": "vite preview",
		"precheck": "pnpm run generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test 'scripts/*.test.ts' 'src/**/*.test.ts' && pnpm run lint"
	},
	"devDependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-css": "6.3.1",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lezer/highlight": "1.2.5",
		"@replit/codemirror-lang-svelte": "6.0.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"engines": {
		"node": ">=26"
	}
}

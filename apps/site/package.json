{
	"name": "@rsvelte-experimental/site",
	"private": true,
	"type": "module",
	"description": "The rsvelte site: landing page and the /learn developer guide. SvelteKit on Cloudflare Workers.",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"lint:code-names": "node scripts/lint-code-names.ts",
		"lint:prose": "node scripts/lint-prose.ts",
		"generate": "node scripts/generate.ts",
		"predev": "pnpm run generate",
		"dev": "vite dev",
		"prebuild": "pnpm run generate",
		"build": "node scripts/lint-code-names.ts && node scripts/lint-prose.ts && vite build",
		"preview": "wrangler dev",
		"predeploy": "pnpm run generate",
		"precheck": "pnpm run generate",
		"deploy": "pnpm run build && wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"pretest": "pnpm run generate",
		"test": "node --test scripts/*.test.ts && node scripts/lint-code-names.ts && node scripts/lint-prose.ts && vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
		"@types/node": "24.19.0",
		"shiki": "4.4.3",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"textlint": "15.8.0",
		"textlint-rule-preset-ja-technical-writing": "12.0.2",
		"textlint-rule-prh": "6.1.0",
		"typescript": "6.0.3",
		"vite": "8.3.1",
		"vitest": "5.0.2",
		"wrangler": "4.143.0"
	}
}

{
	"name": "@rsvelte-experimental/site",
	"private": true,
	"description": "The rsvelte site: landing page and the /learn developer guide. SvelteKit on Cloudflare Workers.",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*",
		"#generated/*": "./generated/*"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"lint:code-names": "node scripts/lint-code-names.ts",
		"lint:prose": "node scripts/lint-prose.ts",
		"generate": "node scripts/generate.ts",
		"predev": "pnpm run generate",
		"dev": "vite dev",
		"prebuild": "pnpm run generate",
		"build": "node scripts/lint-code-names.ts && node scripts/lint-prose.ts && vite build",
		"preview": "wrangler dev",
		"predeploy": "pnpm run generate",
		"precheck": "pnpm run generate",
		"deploy": "pnpm run build && wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"pretest": "pnpm run generate",
		"test": "node --test scripts/*.test.ts && node scripts/lint-code-names.ts && node scripts/lint-prose.ts && vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.4",
		"@textlint-ja/textlint-rule-no-dropping-i": "3.0.0",
		"@textlint-ja/textlint-rule-no-filler": "1.1.0",
		"@textlint-ja/textlint-rule-no-insert-dropping-sa": "2.0.1",
		"@textlint-ja/textlint-rule-no-synonyms": "1.3.0",
		"@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
		"@types/node": "26.6.6",
		"shiki": "4.6.0",
		"sudachi-synonyms-dictionary": "20.0.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.4",
		"textlint": "15.8.0",
		"textlint-rule-ja-hiragana-daimeishi": "1.0.0",
		"textlint-rule-ja-hiragana-hojodoushi": "1.1.0",
		"textlint-rule-ja-hiragana-keishikimeishi": "1.1.0",
		"textlint-rule-ja-joyo-or-jinmeiyo-kanji": "1.0.3",
		"textlint-rule-ja-no-orthographic-variants": "2.0.0",
		"textlint-rule-no-kangxi-radicals": "0.2.2",
		"textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "1.0.1",
		"textlint-rule-preset-ja-spacing": "3.0.4",
		"textlint-rule-preset-ja-technical-writing": "12.0.2",
		"textlint-rule-preset-jtf-style": "3.0.3",
		"textlint-rule-prh": "6.1.1",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.1.0",
		"wrangler": "4.156.2"
	},
	"engines": {
		"node": ">=26"
	}
}

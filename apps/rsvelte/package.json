{
	"name": "@rsvelte-experimental/rsvelte",
	"private": true,
	"description": "rsvelte's JavaScript API and command: rsvelte/compiler, the official svelte/compiler API over rsvelte's compiler, and the rsvelte command",
	"bin": {
		"rsvelte": "./bin.js"
	},
	"files": [
		"bin.js",
		"binding.js",
		"compiler.js",
		"source-map.js",
		"compiler.d.ts"
	],
	"type": "module",
	"exports": {
		"./compiler": {
			"types": "./compiler.d.ts",
			"default": "./compiler.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "node ../../node_modules/typescript-7/bin/tsc -p ."
	},
	"dependencies": {
		"@jridgewell/remapping": "2.3.5"
	},
	"devDependencies": {
		"@jridgewell/trace-mapping": "0.3.31",
		"@types/node": "26.6.6",
		"acorn": "8.19.0",
		"svelte": "5.59.1"
	},
	"peerDependencies": {
		"svelte": "5.59.1"
	},
	"engines": {
		"node": ">=26"
	}
}

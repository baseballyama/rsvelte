{
	"name": "@rsvelte-experimental/rsvelte",
	"private": true,
	"description": "rsvelte's JavaScript API and command: rsvelte/compiler, the official svelte/compiler API over rsvelte's compiler, and the rsvelte command",
	"bin": {
		"rsvelte": "./bin.js"
	},
	"files": [
		"bin.js",
		"binding.js",
		"compiler.js",
		"compiler.browser.js",
		"compiler-api.js",
		"wasm-binding.js",
		"source-map.js",
		"compiler.d.ts",
		"generated/wasm/rsvelte.js",
		"generated/wasm/rsvelte_bg.wasm"
	],
	"type": "module",
	"imports": {
		"#wasm": "./generated/wasm/rsvelte.js"
	},
	"exports": {
		"./compiler": {
			"types": "./compiler.d.ts",
			"browser": "./compiler.browser.js",
			"default": "./compiler.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"generate": "node scripts/generate.ts",
		"test:wasm": "node --test compiler.test.ts bundle.test.ts",
		"test:browser": "node --conditions=browser --import ./browser.ts --test compiler.test.ts",
		"typecheck": "node ../../node_modules/typescript-7/bin/tsc -p ."
	},
	"dependencies": {
		"@jridgewell/remapping": "2.3.5"
	},
	"devDependencies": {
		"@jridgewell/trace-mapping": "0.3.31",
		"@types/node": "26.6.6",
		"acorn": "8.19.0",
		"esbuild": "0.28.2",
		"svelte": "5.59.1",
		"vite": "8.3.8"
	},
	"peerDependencies": {
		"svelte": "5.59.1"
	},
	"engines": {
		"node": ">=26"
	}
}

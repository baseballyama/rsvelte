{
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"$lib/*": ["src/lib/*"],
			"$shared/*": ["${configDir}/src/shared/*"]
		}
	},
	"include": ["${configDir}/src"]
}

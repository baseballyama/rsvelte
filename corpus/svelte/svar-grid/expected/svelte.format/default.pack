  // mark split right columns
  const rightColumns = $derived.by(() => {
    let columns = [];
    let width = 0;

    if ($split.right) {
      columns = $_columns
        .slice($split.right * -1)
        .filter((c) => !c.hidden)
        .map((a) => ({ ...a }));

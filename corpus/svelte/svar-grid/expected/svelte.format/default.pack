<script>
  import { getContext, tick, onMount, untrack } from "svelte";
  import { onresize } from "../helpers/actions/onresize";
  import { reorder as drag, getOffset } from "../helpers/actions/reorder";
  import {
    resetAutoScroll,
    tryAutoScroll,
  } from "../helpers/actions/dragscroll";
  import {
    clickOutside,
    delegateClick,

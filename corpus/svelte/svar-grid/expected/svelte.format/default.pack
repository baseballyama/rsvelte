  const columns = repeatColumns(20);

  let mode = $state("portrait");
  let paper = $state("a4");

  const modes = [
    { id: "portrait", label: "Portrait" },
    { id: "landscape", label: "Landscape" },
  ];
  const papers = [
    { id: "a3", label: "a3" },
    { id: "a4", label: "a4" },

        {
          text: "Company",
          colspan: 2,
          collapsible: true,
        },
        { text: "Name", rowspan: 2 },
        "",
      ],
    },
    {
      id: "country",
      options: countries,
      header: [
        "",
        "Country",
        {
          filter: {
            type: "richselect",
          },
        },
      ],
    },
    {

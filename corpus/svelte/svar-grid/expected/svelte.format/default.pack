  const isRowDraggable = (row) =>
    typeof draggableRows === "function" ? draggableRows(row) : draggableRows;

  // reorder
  let dragItem = $state(null),
    dragNode = $state(null);

  let rowHeights = [];
  let renderedHeight = $state(0);
  let renderEnd = $state(0);

  const fullWidth = $derived(
    $_columns.reduce((acc, col) => {
      if (!col.hidden) {
        acc += col.width;
      }
      return acc;
    }, 0),
  );
  // $inspect(fullWidth, "fullWidth");

  // mark split left columns
  const leftColumns = $derived.by(() => {
    let columns = [];
    let width = 0;

    if ($split.left) {
      columns = $_columns
        .slice(0, $split.left)
        .filter((c) => !c.hidden)
        .map((a) => ({ ...a }));
      columns.forEach((a) => {
        a.fixed = { left: 1, leftSize: $split.left };
        a.left = width;
        width += a.width;

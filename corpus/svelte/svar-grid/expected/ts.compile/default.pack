                if (ev.eventSource === "undo" ||
                    ev.eventSource === "redo" ||
                    ev.skipUndo ||
                    ev.inProgress)
                    return;
                const historyEntry = handlers[action].handler(ev);
                if (historyEntry)
                    this.addToHistory(historyEntry);
            });
        }
    }
    setPrev(prop) {
        this._previousValues[prop] = deepCopy(this.getState()[prop]);
    }

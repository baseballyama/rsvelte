                        if (COLUMNS_ACTIONS.includes(action))
                            this.setPrev("columns");
                    }
                    this.progress[action] = ev.inProgress;
                    return;
                }
                if (DATA_ACTIONS.includes(action))
                    this.setPrev("data");
                if (COLUMNS_ACTIONS.includes(action))
                    this.setPrev("columns");

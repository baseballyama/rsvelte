=== 898 store/test/stubs/helpers.ts	js
export function findById(data, id) {
    for (let i = 0; i < data.length; i++) {
        if (data[i].id === id)
            return data[i];
        if (data[i].data) {
            const res = findById(data[i].data, id);
            if (res)
                return res;
        }
    }
    return null;
}
export function findColumnById(columns, id) {
    return columns.find(c => c.id == id);
}
export function extractPropsAndFlatten(obj, props = [], out = []) {
    if (props && props.length) {
        const propArr = [];
        props.forEach((p) => {
            if (typeof obj[p] !== "undefined")
                propArr.push(obj[p]);
        });
        if (propArr.length)
            out.push(propArr);
    }
    else if (typeof obj.name !== "undefined")
        out.push(obj.name);
    if (obj.data)
        obj.data.forEach((x) => extractPropsAndFlatten(x, props, out));
    return out;
}

=== 563 store/test/stubs/writable.ts	js
export function writable(value) {
    let subscriptions = [];
    const trigger = (b) => subscriptions.forEach((a) => {
        if (a)
            a(b);
    });
    return {
        subscribe: (handler) => {
            subscriptions.push(handler);
            trigger(value);
            return () => (subscriptions = subscriptions.filter(a => a != handler));
        },
        set: (nv) => {
            value = nv;
            trigger(value);
        },
        update: (cb) => {
            value = cb(value);
            trigger(value);
        },
    };
}


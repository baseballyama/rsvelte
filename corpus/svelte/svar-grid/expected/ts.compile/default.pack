import { uid } from "@svar-ui/lib-state";
function rawGetter(key) {
    return obj => obj[key];
}
function rawSetter(key) {
    return (obj, v) => (obj[key] = v);
}
export function getValue(row, col) {
    return (col.getter || rawGetter(col.id))(row);
}
export function setValue(row, col, v) {
    return (col.setter || rawSetter(col.id))(row, v);
}
export function getEditorConfig(columns) {
    return columns
        .filter(a => !!a.editor)
        .map(col => {
        let obj = {
            key: col.id || uid(),
            label: col.header,
        };
        if (col.options)
            obj.options = col.options;
        let editor = col.editor;
        if (typeof editor === "function")
            editor = editor();
        if (typeof editor === "object") {
            obj = { ...obj, ...editor };
            obj.comp = editor.type;
        }
        else
            obj.comp = editor;
        return obj;
    });
}


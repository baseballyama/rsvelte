import { Grid } from "../../src/";

export default function Styling($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		const { data } = getData();
		const columns = repeatColumns(50);
		let cellStyle = void 0;
		let i = 0;

		function setCellStyle() {

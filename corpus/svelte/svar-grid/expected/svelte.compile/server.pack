			font-size: 18px;
			margin: 12px 0;
			font-weight: normal;
		}
		.demo-box {
			margin: 20px;
		}
		.demo-box + .demo-box {
			margin-top: 40px;
		}
		.demo-code {
			font-family: monospace;
			line-height: 30px;
		}

		.demo-status {
			height: 30px;
			line-height: 30px;
			background: rgba(0, 0, 0, 0.15);
			padding-left: 10px;
		}

		.demo-toolbar {
			border: 2px solid var(--wx-background-alt);
			max-width: 600px;
		}

		.demo-row {
			display: flex;
			gap: 4px;
			flex-wrap: wrap;
		}

		.demo-hscroll {
			display: flex;
			gap: 4px;
			overflow-x: auto;
			padding-bottom: 4px;
			white-space: nowrap;
		}
	}

	.box-links.svelte-50cyl5 {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.group-title.svelte-50cyl5 {
		letter-spacing: 0.6px;
		text-transform: uppercase;
		color: var(--wx-color-font-alt);
		padding: 20px 16px 2px;
		font-size: 12px;
		font-weight: 600;
		border-top: var(--wx-border);
	}

	.box-links.svelte-50cyl5 > .group-title:where(.svelte-50cyl5):first-child {
		margin-top: 0;
		border-top: none;
	}

	.hint.svelte-50cyl5 {
		font-size: 16px;
		font-weight: 500;
		line-height: 24px;
		color: var(--demo-fg);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.title.svelte-50cyl5 {
		margin: 0;
		font-size: 18px;
		font-weight: 500;
		line-height: 24px;
		color: var(--demo-fg);
		white-space: nowrap;
	}

	.segmented-box.svelte-50cyl5 {
		div.segmented-themes {
			height: 36px;
			padding: 2px;
			border-radius: 4px;
		}

		div.segmented-themes button {
			font-size: 14px;
			font-weight: 400;
			line-height: 18px;
			color: var(--wx-color-font-alt);
			background-color: transparent;
			padding: 7px 12px;
			border: none;
		}

		div.segmented-themes button.wx-selected {
			border-radius: 2px;
			font-weight: 500;
			color: var(--wx-color-font);
			background: var(--demo-segmented-selected-bg);
			box-shadow: var(--demo-segmented-selected-shadow);
		}

		div.segmented-themes button svg {
			height: 16px;
			width: 16px;
		}
	}

	.narrow.svelte-50cyl5 .segmented-box:where(.svelte-50cyl5) {
		div.segmented-themes {
			height: 44px;
		}
		div.segmented-themes button {
			padding: 7px 10px;
		}
		div.segmented-themes button svg {
			height: 24px;
			width: 24px;
		}
	}

	.wx-willow-dark-theme
		.segmented-box.svelte-50cyl5
		div.segmented-themes {
		background-color: var(--demo-segmented-bg);
	}


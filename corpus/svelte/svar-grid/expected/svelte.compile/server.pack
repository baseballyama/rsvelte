			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----></p> <div style="max-width: 800px;">`);

		Grid($$renderer, {
			tree: true,
			data: treeData,
			columns: treeFixedColumns,
			footer: true
		});

		$$renderer.push(`<!----></div></div>`);
	});
}

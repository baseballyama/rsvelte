		if (filterId === 1) {
			$$renderer.push('<!--[0-->');

			FilterBar($$renderer, {
				fields: [
					{
						type: "all",
						by: ["id", "city", "firstName", "lastName", "email"]
					}
				],
				onchange: handleValueChange
			});
		} else if (filterId === 2) {
			$$renderer.push('<!--[1-->');

			FilterBar($$renderer, {
				fields: [{ type: "text", id: "city", options: cities }],
				onchange: handleValueChange
			});
		} else if (filterId === 3) {
			$$renderer.push('<!--[2-->');

			FilterBar($$renderer, {
				fields: [
					{
						type: "dynamic",
						by: ["city", "firstName", "lastName", "email"]
					}
				],
				onchange: handleValueChange
			});
		} else {
			$$renderer.push('<!--[-1-->');
		}

		$$renderer.push(`<!--]--> `);
		Grid($$renderer, { data, columns });
		$$renderer.push(`<!----></div>`);
	});
}

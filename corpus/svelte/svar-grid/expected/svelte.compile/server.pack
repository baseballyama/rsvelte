						$$renderer.push(`<div style="padding: 20px;"><div style="width: 800px; height: 400px;">`);
						Grid($$renderer, { data, columns, reorder: true });
						$$renderer.push(`<!----></div></div>`);
					},
					$$slots: { default: true }
				});
			},
			$$slots: { default: true }
		});
	});
}

			api.exec("resize-column", { id: cell.id, width: Math.max(1, start + dx), inProgress });
		}

		function sort(ev) {
			if (!column.sort || cell.filter) return;

			if (sortMark()?.order) {
				sortMark().order = sortMark()?.order === "asc" ? "desc" : "asc";
			}

			api.exec("sort-rows", {
				key: cell.id,
				add: ev.ctrlKey || ev.metaKey,
				order: sortMark()?.order
			});
		}


				$$renderer.push(`<div>`);
				ColorBoard($$renderer, { value, onchange: updateValue, button: true });
				$$renderer.push(`<!----></div>`);
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!---->`);
	});
}

			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----></div> <h4>Custom tooltips</h4> <div>`);

		Tooltip($$renderer, {
			content: CustomTooltip,
			api: api1,
			children: ($$renderer) => {
				Grid($$renderer, { data, columns });
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----></div></div>`);
	});
}

	var div = root_1();
	var div_1 = $.child(div);
	var node = $.sibling($.child(div_1), 4);

	$.each(node, 17, () => cards, (card) => card.email, ($$anchor, card) => {
		var div_2 = root();
		var div_3 = $.child(div_2);
		var text = $.only_child(div_3);

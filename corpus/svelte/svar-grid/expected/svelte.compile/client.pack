			$.append($$anchor, text_2);
		},
		$$slots: { default: true }
	});

	$.reset(div_1);

	var div_2 = $.sibling(div_1, 2);
	var node_3 = $.child(div_2);

	Button(node_3, {
		type: 'primary',
		onclick: () => doScrollTo(5000, 0),

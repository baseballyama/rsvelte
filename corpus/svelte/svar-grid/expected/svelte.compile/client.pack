			header: { text: "Email", collapsible: true },
			footer: "Email"
		},

		{
			id: "companyName",
			header: { text: "Company", collapsible: true },
			footer: "Company"
		},
		{ id: "city", header: "City" },
		{ id: "stars", header: "Stars" }
	];

	columns.forEach((c) => c.resize = true);

	function handleUndo(api) {
		api.exec("undo");
	}

	function handleRedo(api) {
		api.exec("redo");
	}


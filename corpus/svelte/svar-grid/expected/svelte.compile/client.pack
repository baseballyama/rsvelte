		},
		type: "simple",
		get fields() {
			return fields;
		},

		get options() {
			return options;
		},
		onchange: (ev) => applyFilter(ev.value)
	});

	var node_1 = $.sibling(node, 2);

	Grid(node_1, {
		get data() {
			return $.get(filteredData);
		},

		get columns() {
			return columns;
		}
	});

	$.reset(div);
	$.append($$anchor, div);
	$.pop();
}

	const [$$stores, $$cleanup] = $.setup_stores();
	const { data } = getData();
	let api = $.state(void 0);
	let history = $.derived(() => $.get(api)?.getReactiveState().history);

	const columns = [
		{ id: "id", width: 50 },
		{
			id: "firstName",
			header: "First Name",
			footer: "First Name",
			editor: "text",
			width: 150
		},

		{
			id: "lastName",
			header: "Last Name",
			footer: "Last Name",
			editor: "text",
			width: 150
		},


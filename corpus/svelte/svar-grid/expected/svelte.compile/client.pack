		let $2 = $.derived(() => log("[delete] handler"));

		Grid(node_3, {
			init,
			get data() {
				return $.get(data);
			},

			get columns() {
				return columns;
			},

			get onselectrow() {
				return $.get($0);
			},

			get onaddrow() {
				return $.get($1);
			},

			get ondeleterow() {
				return $.get($2);
			}
		});
	}

	$.reset(div_1);
	$.reset(div);
	$.append($$anchor, div);
	$.pop();

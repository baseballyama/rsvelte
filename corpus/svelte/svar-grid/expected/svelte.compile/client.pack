	$.event('dragstart', div_1, onGridDragStart);
	$.event('dragover', div_2, onBoxDragOver);
	$.event('dragleave', div_2, onBoxDragLeave);
	$.event('drop', div_2, onBoxDrop);
	$.append($$anchor, div);
	$.pop();
}

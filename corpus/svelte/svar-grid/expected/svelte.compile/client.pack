	var div_1 = $.child(div);
	var node = $.child(div_1);

	{
		let $0 = $.derived(() => $.get(history) && !$history().undo);

		Button(node, {
			type: 'primary',
			onclick: () => handleUndo($.get(api)),
			get disabled() {
				return $.get($0);
			},

			children: ($$anchor, $$slotProps) => {
				$.next();

				var text = $.text('Undo');

				$.append($$anchor, text);
			},
			$$slots: { default: true }
		});
	}

	var node_1 = $.sibling(node, 2);

	{
		let $0 = $.derived(() => $.get(history) && !$history().redo);

		Button(node_1, {
			type: 'primary',
			onclick: () => handleRedo($.get(api)),
			get disabled() {
				return $.get($0);
			},

			children: ($$anchor, $$slotProps) => {
				$.next();

				var text_1 = $.text('Redo');

				$.append($$anchor, text_1);
			},
			$$slots: { default: true }
		});
	}

	$.reset(div_1);

	var div_2 = $.sibling(div_1, 2);
	var node_2 = $.child(div_2);

	ContextMenu(node_2, {
		get api() {
			return $.get(api);
		},

		children: ($$anchor, $$slotProps) => {
			HeaderMenu($$anchor, {
				get api() {
					return $.get(api);
				},

				children: ($$anchor, $$slotProps) => {
					$.bind_this(
						Grid($$anchor, {
							get data() {

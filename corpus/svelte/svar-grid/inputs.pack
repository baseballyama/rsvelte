				undefined,
				undefined,
				"",
				"Item 1",
				"Item 2",
				"Item 3",
				"Item 4",
			]);

			store.in.exec("sort-rows", { key: "name", order: "desc" });

			({ data, flatData } = store.getState());

			expect(data.map(x => x.name)).to.deep.eq([
				"Item 4",
				"Item 3",
				"Item 2",
				"Item 1",
				"",
				null,
				undefined,
				undefined,
			]);

			expect(flatData.map(x => x.name)).to.deep.eq([
				"Item 4",

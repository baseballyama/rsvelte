		test("can sort hierarchical data in descending order", () => {
			resetState(getData("tree"));

			store.in.exec("sort-rows", { key: "name", order: "desc" });

			const { data, flatData } = store.getState();

			expect(extractPropsAndFlatten({ data })).to.deep.eq([
				"Parent 3",

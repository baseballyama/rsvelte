import type { TID } from "@svar-ui/lib-state";

export interface IOptionConfig {
	id?: TID;
	text?: string;
	icon?: string;
	comp?: "separator";
}

export const defaultMenuOptions: IOptionConfig[] = [
	{
		id: "add-row:before",
		text: "Add before",
		icon: "wxi-table-row-plus-before",
	},

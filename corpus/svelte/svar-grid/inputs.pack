			start = Math.floor($scrollTop / defaultRowHeight);
			start = Math.max(0, start - EXTRAROWS);
			deltaTop = start * defaultRowHeight;
		}

		const end = Math.min(
			$dynamic ? $dynamic.rowCount : $data.length,
			start + visibleRows + EXTRAROWS
		);

		return { d: deltaTop, start, end };

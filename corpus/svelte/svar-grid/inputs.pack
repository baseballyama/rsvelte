<script>
	import { Button } from "@svar-ui/svelte-core";
	import { getData } from "../data";
	import { Grid } from "../../src";

	const { allData, data, countries, users } = getData();

	const dateFormat = new Intl.DateTimeFormat("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
		hour: "2-digit",
		minute: "2-digit",
		hour12: false,
	});


<div class="a">
  <span class="b">b</span>
</div>

<style>
  /* before a rule */
  .a /* after a selector */ {
    /* before a declaration */
    color: red; /* after a declaration */
    background: /* before a value */ blue;
  }

  .a,
	/* between two selectors */
	.b {
    margin: 0;
  }

  @media /* in a prelude */ (min-width: 1px) {
    /* before a nested rule */
    .b {
      padding: 0;
    }
  }
  /* at the end */
</style>

=== 663 pattern/adversarial/css/css-comment-positions.svelte	svelte
<div class="a"><b class="b">x</b></div>

<style>
  /* before the first rule */
  .a /* after the selector */ {
    /* first in the block */
    color: /* before the value */ red /* after the value */;
    /* between declarations */
    background: blue;
    /* last in the block */
  }

  .a /* before the comma */, .b /* before the brace */ {
    color: green;
  }

  .a, /* after the comma */ .b {
    color: purple;
  }

  @media /* in the prelude */ (min-width: 1px) {
    /* inside the at-rule block */
    .a {
      color: teal;
    }
  }

  .a {
    /* before a nested rule */
    & .b {
      color: olive;
    }
  }
  /* after the last rule */
</style>


<p>{string_then_number}</p>
<p>{number_then_string}</p>
<p>{both_numbers}</p>
<p>{not_numeric}</p>
<p>{with_boolean}</p>
<p>{with_null}</p>
<p>{with_undefined}</p>
<p>{empty_string}</p>
<p>{boolean_first}</p>
<p>{null_first}</p>
<p>{negative}</p>
<p>{times}</p>
<p>{minus}</p>
<p>{minus_nan}</p>
<p>{precedence}</p>
<p>{precedence_string}</p>
<p>{associativity}</p>
<p>{alias}</p>
<p>{alias_number}</p>
<p>{float_sum}</p>


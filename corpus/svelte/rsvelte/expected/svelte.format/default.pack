  import { writable } from "svelte/store";

  let base = $state(1);
  let v = $derived(base);
  let list = $derived([base]);
  const y = writable(1);

  function object_default({ v } = { v: 0 }) {
    return v;
  }

  function array_default([list] = [0]) {
    return list;
  }

  function second_param(a, { v } = { v: 0 }) {
    return a + v;

    return $y;
  }

  const arrow_default = ({ v } = { v: 0 }) => v;

  class Host {
    method({ v } = { v: 0 }) {
      return v;
    }
  }

  function real_assignment(o) {
    ({ v: base } = o);
    return base;
  }
</script>


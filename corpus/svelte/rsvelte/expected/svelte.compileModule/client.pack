			}
		} catch(error) {
			console.error(`Error when writing value from persisted store "${this.#key}" to ${this.#storage}`, error);
		}
	}

	#setupStorageListener() {
		if (!this.#window || !this.#connected) return;

		this.#subscribe = createSubscriber((update) => {
			this.#update = update;

			this.#storageCleanup = this.#connected && this.#syncTabs && this.#storageType === "local"
				? on(this.#window, "storage", this.#handleStorageEvent)
				: undefined;

			return () => {
				this.#storageCleanup?.();
				this.#storageCleanup = undefined;
				this.#update = undefined;
			};
		});
	}

	#teardownStorageListener() {
		this.#storageCleanup?.();
		this.#storageCleanup = undefined;
		this.#subscribe = undefined;
	}

	/**

import * as $ from 'svelte/internal/client';
import { goto, pushState, replaceState } from '$app/navigation';
import { base } from '$app/paths';

const state = {};

export function bad() {
	goto('/plain');
}

export function good() {
	goto(base + '/ok');
}

export function templated(pathname) {
	goto(`${pathname}?x=1`);
}

export function shallow() {
	pushState('', state);
	replaceState('/bad-replace', state);
}

export class Holder {
	set target(value) {
		goto(`${base}/${value}`);
	}

	set broken(value) {
		goto(`/nope/${value}`);
	}
}

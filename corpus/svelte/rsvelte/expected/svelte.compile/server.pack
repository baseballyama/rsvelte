		}
	);

	$$renderer.push(` <div${$.attr_class($.clsx(active ? 'd' : 'e'), 'svelte-lnm5xj')}>z</div> <div${$.attr_class('svelte-lnm5xj', void 0, { 'f': active })}>w</div></div>`);
}

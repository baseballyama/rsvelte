			}

			set doubled($$value) {
				return this.#doubled($$value);
			}

			static origin = 'static';

			bump() {
				this.count += 1;
				this.#hidden -= 1;
			}

			get sum() {
				return this.count + this.#hidden;
			}
		}

		const c = new Counter();

		$$renderer.push(`<button>${$.escape(c.doubled)} ${$.escape(c.sum)} ${$.escape(Counter.origin)}</button>`);
	});
}

	$.slot($$renderer, $$props, 'default', {}, null);
	$$renderer.push(`<!--]--> <!--[-->`);

	$.slot($$renderer, $$props, 'header', { label: name, count: 2 }, () => {
		$$renderer.push(`<span>header fallback</span>`);
	});

	$$renderer.push(`<!--]--> <!--[-->`);

	$.slot($$renderer, $$props, 'footer', {}, () => {
		$$renderer.push(`<span>footer fallback ${$.escape(name)}</span>`);
	});

	$$renderer.push(`<!--]--></div> `);

	if ($$slots.header) {
		$$renderer.push(`<!--[0--><p>has header</p>`);
	} else {
		$$renderer.push('<!--[-1-->');
	}

	$$renderer.push(`<!--]--> `);

	if ($$slots['footer']) {
		$$renderer.push(`<!--[0--><p>has footer</p>`);
	} else {
		$$renderer.push('<!--[-1-->');
	}

	$$renderer.push(`<!--]-->`);
}

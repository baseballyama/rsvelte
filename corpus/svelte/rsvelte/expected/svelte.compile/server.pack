			for (let once = 0; once < 1; once += 1) var value = $.derived(() => 4);

			return value?.();
		}

		function bare_for_of(flag) {
			for (const item of [flag]) var value = $.derived(() => 5);

			return value?.();
		}

		function bare_while(flag) {
			while (flag) var value = $.derived(() => 6);

			return value?.();
		}


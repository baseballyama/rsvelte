import * as $ from 'svelte/internal/server';

export default function _1_dynamic_import_lookalikes($$renderer) {
	const loader = {
		import(spec) {
			return spec;
		}
	};

	// A member call named `import` is not a dynamic import.
	void loader.import('svelte/internal');

	// A boundary miss: `svelte/internalx` is a different package.
	const near = () => import('svelte/internalx');

	void near;

	$.await(
		$$renderer,
		loader.import('svelte/internal'),
		() => {
			$$renderer.push(`<p>loading</p>`);
		},
		(value) => {
			$$renderer.push(`<p>${$.escape(typeof value)}</p>`);
		}
	);

	$$renderer.push(`<!--]--> <button>deep</button>`);
}

	/* A level that opens with `&` names the same element as the level below it. */
	.box.svelte-k3iyf5 {
		&:disabled + .el:where(.svelte-k3iyf5) {
			& + .lab:where(.svelte-k3iyf5) { color: red }
		}
	}
	.c.svelte-k3iyf5 {
		.box:where(.svelte-k3iyf5) {
			&:disabled + .el:where(.svelte-k3iyf5) {
				& + .lab:where(.svelte-k3iyf5) { color: red }
			}
		}
	}
	.a.svelte-k3iyf5 {
		& {
			& + .a2:where(.svelte-k3iyf5) { color: red }
		}
	}
	.a.svelte-k3iyf5 { & & { color: red } }

	/* A level with no `&` is an implicit descendant and must NOT merge. */
	.g.svelte-k3iyf5 {
		.a:where(.svelte-k3iyf5) {
			& + .a2:where(.svelte-k3iyf5) { color: red }
		}
	}

	/* The parent level is not structurally evaluable, so its own compounds
	   still have to constrain rather than being dropped. */
	.sidebar.svelte-k3iyf5:has(input:where(.svelte-k3iyf5):checked) {
		& + .sidebar-backdrop:where(.svelte-k3iyf5) { color: red }
	}

	/* Negatives: each of these must still be reported. */
	/* (empty) .zzbox {
		&:disabled + .el {

		[1, 0, 1],
		[2, 0, 1],
		[3, 0, 1],
		[4, 0, 1],
		[5, 0, 1]
	];

	const calls = [
		f(0, 0),
		f(1, 0),
		f(2, 0),
		f(3, 0),
		f(4, 0),
		f(5, 0),
		f(6, 0)
	];

	const wide = [{ c: "✈️", k: 0 }, { c: "✈️", k: 1 }, { c: "✈️", k: 2 }];
	const twin = [{ c: "xxx", k: 0 }, { c: "xxx", k: 1 }, { c: "xxx", k: 2 }];


export default function _9_object_value_resolution($$renderer) {
	const BASE = { CHECK: 'checkbox' };
	const SPREAD = { ...BASE, RADIO: 'radio' };
	const NESTED = { inner: { kind: 'checkbox' } };
	const LIST = ['checkbox', 'radio'];
	const MUTATED = { CHECK: 'checkbox' };

	MUTATED.CHECK = 'text';

	const GETTER = {
		get CHECK() {
			return 'checkbox';
		}
	};

	let v = '';

	$$renderer.push(`<input${$.attr('type', SPREAD.CHECK)}${$.attr('value', v)}/> <input${$.attr('type', SPREAD.RADIO)}${$.attr('value', v)}/> <input${$.attr('type', NESTED.inner.kind)}${$.attr('value', v)}/> <input${$.attr('type', LIST[0])}${$.attr('value', v)}/> <input${$.attr('type', LIST[1])}${$.attr('value', v)}/> <input${$.attr('type', MUTATED.CHECK)}${$.attr('value', v)}/> <input${$.attr('type', GETTER.CHECK)}${$.attr('value', v)}/> <input${$.attr('type', LIST.missing)}${$.attr('value', v)}/>`);
}

import C from './01-basic.svelte';

export default function _8_component_hosts($$renderer) {
	let h = () => {};

	C($$renderer, {});
	$$renderer.push(`<!----> `);

	if (C) {
		$$renderer.push('<!--[-->');
		C($$renderer, {});
		$$renderer.push('<!--]-->');
	} else {
		$$renderer.push('<!--[!-->');
		$$renderer.push('<!--]-->');
	}

	$$renderer.push(` `);

	if (false) {
		$$renderer.push('<!--[0-->');
		_8_component_hosts($$renderer, {});
		$$renderer.push(`<!---->`);
	} else {
		$$renderer.push('<!--[-1-->');
	}

	$$renderer.push(`<!--]-->`);
}

	const each_array_1 = $.ensure_array_like(boxes);

	for (let $$index_1 = 0, $$length = each_array_1.length; $$index_1 < $$length; $$index_1++) {
		let box = each_array_1[$$index_1];
		const area = box.w * 2;
		const label = `${area}`;

		$$renderer.push(`<p>${$.escape(area)} ${$.escape(label)}</p>`);
	}

	$$renderer.push(`<!--]--> `);

	$.await($$renderer, Promise.resolve('x'), () => {}, (value) => {
		$$renderer.push(`<b>${$.escape(value)}</b>`);
	});

	$$renderer.push(`<!--]--> <p>${$.escape(caught)}</p>`);
}

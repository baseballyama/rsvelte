import * as $ from 'svelte/internal/server';

export default function A_block_declaration_shadows_above_itself($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let base = 1;
		let v = $.derived(() => base);
		let { w } = $$props;

		function hoisted() {
			const a = typeof v;
			const b = typeof w;

			function v() {}

			var w = 1;

			return a + b + w;
		}

		function tdz() {
			const a = typeof v;
			const b = typeof w;
			let v = 1;

			class w {}

			return a + b;
		}

		function sibling() {
			return typeof v() + typeof w;
		}

		$$renderer.push(`<button></button> ${$.escape(hoisted())}${$.escape(tdz())}${$.escape(sibling())}${$.escape(v())}${$.escape(w)}`);
	});
}

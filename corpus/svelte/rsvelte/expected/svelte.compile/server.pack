export default function Box($$renderer, $$props) {
	let { title, children } = $$props;

	$$renderer.push(`<section>`);

	if (typeof title === 'string') {
		$$renderer.push(`<!--[0--><h1>${$.escape(title)}</h1>`);
	} else if (title) {
		$$renderer.push('<!--[1-->');
		title($$renderer);
		$$renderer.push(`<!---->`);
	} else {
		$$renderer.push('<!--[-1-->');
	}

	$$renderer.push(`<!--]--> `);
	children($$renderer);
	$$renderer.push(`<!----></section>`);
}

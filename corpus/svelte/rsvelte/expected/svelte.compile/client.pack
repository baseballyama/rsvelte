	$.template_effect(() => $.set_text(text, `${$.get(top) ?? ''}${h.v ?? ''}${obj.value ?? ''}`));

	$.delegated('click', button, () => {
		outer()();
		h.bump();
		obj.method();
	});

	$.append($$anchor, button);
	$.pop();
}


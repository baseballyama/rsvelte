		// optional call: the CallExpression's parent is a ChainExpression
		s.subscribe?.(() => {});

		// bare identifier call — no MemberExpression at all
		subscribe;

		// sequence: the CallExpression's parent is a SequenceExpression
		(s.subscribe(), s.subscribe());

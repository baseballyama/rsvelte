=== 782 pattern/issues/legacy-state-member-update.svelte	js
import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';

var root = $.from_html(`<button> </button> <button> </button>`, 1);

export default function Legacy_state_member_update($$anchor) {
	let counts = {};

	function increment(key) {
		counts[key]++;
	}

	function decrement() {
		--counts.total;
	}

	var fragment = root();
	var button = $.first_child(fragment);
	var text = $.only_child(button, true);
	var button_1 = $.sibling(button, 2);
	var text_1 = $.only_child(button_1, true);

	$.template_effect(() => {
		$.set_text(text, counts.clicks);
		$.set_text(text_1, counts.total);
	});

	$.delegated('click', button, () => increment('clicks'));
	$.delegated('click', button_1, decrement);
	$.append($$anchor, fragment);
}

$.delegate(['click']);

import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { writable } from 'svelte/store';

var root = $.from_html(`<span> </span>`);
var root_1 = $.from_html(`<button> </button> <input/> <!>`, 1);

export default function Store_in_handlers($$anchor, $$props) {
	$.push($$props, true);

	const $count = () => $.store_get(count, '$count', $$stores);
	const $items = () => $.store_get(items, '$items', $$stores);
	const [$$stores, $$cleanup] = $.setup_stores();
	const count = writable(0);
	const items = writable([]);
	var fragment = root_1();
	var button = $.first_child(fragment);
	var text = $.only_child(button, true);
	var input = $.sibling(button, 2);

	$.remove_input_defaults(input);

	var node = $.sibling(input, 2);

	$.each(node, 1, $items, $.index, ($$anchor, it) => {
		var span = root();
		var text_1 = $.only_child(span, true);

		$.template_effect(() => $.set_text(text_1, $.get(it)));
		$.append($$anchor, span);
	});

	$.template_effect(() => $.set_text(text, $count()));

	$.delegated('click', button, () => {
		$.update_store(count, $count());
		$.store_set(items, [...$items(), $count()]);
		$.store_mutate(items, $.untrack($items)[0] = 0, $.untrack($items));
	});

	$.delegated('keydown', input, (e) => e.key === 'Escape' && count.set(0));
	$.bind_value(input, () => String($count()), (v) => count.set(Number(v) || 0));
	$.append($$anchor, fragment);
	$.pop();
	$$cleanup();
}

$.delegate(['click', 'keydown']);

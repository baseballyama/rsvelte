import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';

var root = $.from_html(`<div></div>`);

export default function Named_function_expression_reserves_its_own_name($$anchor, $$props) {
	$.push($$props, true);

	let handled = $.state(0);

	const wrap = () => {
		const inner = function change(chunk) {
			return String(chunk);
		};

		return inner;
	};

	var div = root();

	$.delegated('change', div, () => {
		$.set(handled, wrap()(1).length, true);
	});

	$.delegated('input', div, () => {
		$.set(handled, 1);
	});

	$.append($$anchor, div);
	$.pop();
}

$.delegate(['change', 'input']);

			$.transition(2, div_1, () => blur);
			$.transition(1, div_2, () => fly, () => ({ x: 10, y: -10, opacity: 0.2, easing: cubicInOut }));
			$.transition(2, div_2, () => fly, () => ({ y: 5 }));
			$.transition(3, div_3, () => slide, () => ({ axis: "x", duration: 50 }));
			$.transition(3, div_4, () => scale, () => ({ start: 0.5, easing: elasticIn }));
			$.transition(1, div_5, () => receive, () => ({ key }));
			$.transition(2, div_5, () => send, () => ({ key }));

import * as $ from 'svelte/internal/client';

var root = $.from_html(`<button> </button> <button>go</button> <button>m</button>`, 1);

export default function Legacy_state_name_redeclared_inside_a_function($$anchor, $$props) {
	$.push($$props, true);

	let v = { n: 1 };
	let w;

	function tick() {
		v = { n: v.n + 1 };
		w = v.n;
	}

	function go() {
		let v = { n: 0 };

		v.n = 2;

		let w;

		w = 3;

		return [v, w];
	}

	class C {
		m() {
			let v = { n: 0 };

			return v.n;
		}
	}

	const c = new C();
	var fragment = root();
	var button = $.first_child(fragment);
	var text = $.only_child(button);
	var button_1 = $.sibling(button, 2);
	var button_2 = $.sibling(button_1, 2);

	$.template_effect(() => $.set_text(text, `${v.n ?? ''}${w ?? ''}`));
	$.event('click', button, tick);
	$.event('click', button_1, go);
	$.event('click', button_2, () => c.m());
	$.append($$anchor, fragment);
	$.pop();
}

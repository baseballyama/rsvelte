import * as $ from 'svelte/internal/client';

var root = $.from_html(`<b> </b> <button> </button>`, 1);

export default function Control_statement_forms($$anchor) {
	let n = $.state(0);

	function tour() {
		const out = [];

		outer: for (let i = 0; i < 3; i++) {
			inner: for (let j = 0; j < 3; j++) {
				if (j > 1) {
					continue outer;
				}

				if (i > 1) {
					break outer;
				}

				out.push(`${i}${j}`);
			}
		}

		let k = 0;

		do {
			out.push(`d${k}`);
			k += 1;
		} while (k < 2);

		while (k < 4) {
			out.push(`w${k}`);
			k += 1;
		}

		switch (out.length % 3) {
			case 0:

			case 1:
				out.push("low");
				break;

			case 2:
				{
					out.push("mid");

					break;
				}

			default:
				out.push("high");
		}

		try {
			out.push("try");
		} catch {
			out.push("catch");
		} finally {
			out.push("finally");
		}

		block: {
			out.push("block");

			break block;
		}

		return out.join(",");
	}

	var fragment = root();
	var b = $.first_child(fragment);
	var text = $.only_child(b, true);
	var button = $.sibling(b, 2);
	var text_1 = $.only_child(button, true);

	$.template_effect(
		($0) => {
			$.set_text(text, $0);
			$.set_text(text_1, $.get(n));
		},
		[() => tour()]
	);

	$.delegated('click', button, () => $.set(n, $.get(n) + 1));
	$.append($$anchor, fragment);
}


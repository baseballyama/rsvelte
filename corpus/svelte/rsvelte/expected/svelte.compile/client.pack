import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';

var root = $.from_html(`<p> </p>`);

export default function Arrows($$anchor, $$props) {
	$.push($$props, true);

	const id = (x) => x;
	const wrong = id('after the comma');
	const frozen = (x) => x;
	const later = async (x) => x;
	const defaulted = (x) => x;
	const bounded = (x) => x;
	const already = (x) => x;
	const commented = (/* , */ x) => x;

	const lineCommented = (
		// a comment that hides the comma
		x
	) => x;

	const outer = (x) => {
		const inner = (y) => [x, y];

		return inner;
	};

	class Holder {
		pick = (k) => k;
	}

	const count = [
		frozen(1),
		later(1),
		defaulted('d'),
		bounded('b'),
		already(1),
		commented(1),
		lineCommented(1),
		outer(1)(2),
		new Holder().pick(1)
	].length;

	var p = root();

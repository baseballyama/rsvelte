var root = $.from_html(`<button>shorthand prop handler</button> <input/> <button>fallback</button> <button>fn expr</button>`, 1);

export default function Event_shorthand_computed($$anchor, $$props) {
	let kind = 'click';
	const handlers = { click: () => console.log('c'), key: (e) => console.log(e) };
	var fragment = root();
	var button = $.first_child(fragment);
	var input = $.sibling(button, 2);
	var button_1 = $.sibling(input, 2);
	var button_2 = $.sibling(button_1, 2);

	$.delegated('click', button, function (...$$args) {
		$$props.onclick?.apply(this, $$args);
	});

	$.delegated('keydown', input, function (...$$args) {
		$$props.onkeydown?.apply(this, $$args);
	});

	$.delegated('input', input, function (...$$args) {
		handlers[kind]?.apply(this, $$args);
	});

	$.delegated('change', input, function (...$$args) {
		handlers['key']?.apply(this, $$args);
	});

	$.delegated('click', button_1, function (...$$args) {
		(handlers[kind] ?? $$props.onclick)?.apply(this, $$args);
	});

	$.delegated('pointerdown', button_2, function named(e) {
		console.log(named.name, e.type);
	});

	$.append($$anchor, fragment);
}


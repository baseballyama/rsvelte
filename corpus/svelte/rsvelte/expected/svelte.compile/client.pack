=== 1507 pattern/issues/console-wrap-types-a-global-call.svelte	js
import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';

var root = $.from_html(`<button></button> <button></button> `, 1);

export default function Console_wrap_types_a_global_call($$anchor) {
	let base = 1;
	let d = $.derived(() => base);

	function logs() {
		const random = Math.random();
		const floored = Math.floor(base);
		const numbered = Number(base);
		const stringed = String(base);
		const big = BigInt(1);
		const charred = String.fromCharCode(base);
		const checked = Number.isInteger(base);
		const pi = Math.PI;

		console.log(random, floored, numbered, stringed);
		console.log(big, charred, checked, pi);
		console.log(Math.random());
		console.log(Math.PI);
	}

	function shadow() {
		const Math = { random: () => 1, PI: 1 };
		const rolled = Math.random();
		const circle = Math.PI;

		console.log(rolled, circle);

		return [rolled, circle];
	}

	function unknowns() {
		const missing = Math.notAThing(base);
		const other = JSON.stringify(base);
		const shadowed = shadow();

		console.log(missing);
		console.log(other);
		console.log(shadowed);
		console.log(Math.notAThing(1));
		console.log(Math.notAThing);
		console.log($.get(d));
	}

	var fragment = root();
	var button = $.first_child(fragment);
	var button_1 = $.sibling(button, 2);
	var text = $.sibling(button_1);

	text.nodeValue = ` ${$.get(d) ?? ''}`;
	$.delegated('click', button, logs);
	$.delegated('click', button_1, unknowns);
	$.append($$anchor, fragment);
}

$.delegate(['click']);

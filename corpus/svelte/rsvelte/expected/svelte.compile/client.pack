import 'svelte/internal/disclose-version';
import 'svelte/internal/flags/legacy';
import * as $ from 'svelte/internal/client';
import { writable } from 'svelte/store';

export default function Legacy_title_store_call($$anchor, $$props) {
	$.push($$props, false);

	const $translate = () => $.store_get(translate, '$translate', $$stores);
	const [$$stores, $$cleanup] = $.setup_stores();
	const translate = writable((key) => key);

	$.init();

	$.head('dbri1n', ($$anchor) => {
		$.deferred_template_effect(
			($0) => {
				$.document.title = `${$0 ?? ''} — site`;
			},
			[
				() => ($translate(), $.untrack(() => $translate()('page.title')))
			]
		);
	});

	$.pop();
	$$cleanup();
}

	var div_3 = $.sibling(div_2, 2);
	var div_4 = $.sibling(div_3, 2);

	$.template_effect(() => {
		$.set_class(div_1, 1, $.clsx($$props.flag ? 'ternary-a' : 'ternary-b'), 'svelte-tqtfvb');

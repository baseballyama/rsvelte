import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';

var root = $.from_html(`<button> </button>`);
var root_1 = $.from_html(`<div>a</div> <button>wire</button> <!>`, 1);

export default function _8_cross_dom_listener_reactivity($$anchor, $$props) {
	$.push($$props, true);

	let el;
	const seen = new Map();
	const rows = [1, 2];

	function wire() {
		el.addEventListener('click', () => {
			seen.set(1, 2);
			el.innerHTML = '';
		});

		el['rem' + 'ove']();
	}

	var fragment = root_1();
	var div = $.first_child(fragment);

	$.bind_this(div, ($$value) => el = $$value, () => el);

	var button = $.sibling(div, 2);
	var node = $.sibling(button, 2);

	$.each(node, 17, () => rows, $.index, ($$anchor, el, $$index, $$array) => {
		var button_1 = root();
		var text = $.only_child(button_1, true);

		$.template_effect(() => $.set_text(text, $.get(el)));
		$.delegated('click', button_1, () => $.get(el).addEventListener('x', () => $.get(el).remove()));
		$.append($$anchor, button_1);
	});

	$.delegated('click', button, wire);
	$.append($$anchor, fragment);
	$.pop();
}


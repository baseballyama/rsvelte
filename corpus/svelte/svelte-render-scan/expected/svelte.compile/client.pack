export default function RenderScan($$anchor, $$props) {
	$.push($$props, true);

	// Props with defaults
	let initialEnabled = $.prop($$props, 'initialEnabled', 3, true),
		offsetLeft = $.prop($$props, 'offsetLeft', 3, 0),

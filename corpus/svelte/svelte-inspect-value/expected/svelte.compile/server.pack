import { CustomLine } from '$lib/index.js';

export default function ErrorOnHover($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let { value, $$slots, $$events, ...rest } = $$props;
		let doAnError = false;

		CustomLine($$renderer, $.spread_props([

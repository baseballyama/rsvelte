				$$renderer.push(`<!--[-->`);

				{
					$$renderer.push(`<div${$.attributes({ class: 'code', ...rest }, 'svelte-1g6xvrs', { multi })}><div class="util svelte-1g6xvrs">`);

					if (label) {

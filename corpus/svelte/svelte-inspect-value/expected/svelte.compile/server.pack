=== 4823 packages/svelte/src/routes/(app)/+layout.svelte	css

  header.svelte-8nzpty {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1em;
    view-transition-name: header;
    /* padding-inline: 1em; */
    padding-top: 1em;
  }

  .title.svelte-8nzpty {
    width: max-content;
    font-weight: bold;
    font-size: 0.8rem;
    text-decoration: none;
  }

  h1.header-lib-title.svelte-8nzpty {
    max-width: max-content;
    text-decoration: none;
    text-wrap: nowrap;
    white-space: nowrap;
  }

  main.svelte-8nzpty {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: 0.5em;
    transition: all 200ms ease-in-out;
    margin-bottom: 150px;
    padding-top: 0.5em;
    padding-left: 3em;
    width: 100%;
  }

  nav.svelte-8nzpty {
    /* padding-top: 0.5em; */
    view-transition-name: nav;
    padding-left: 0.5rem;
  }

  nav.svelte-8nzpty:not(.drawer-nav) {
    ul:where(.svelte-8nzpty) {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 1em;
      padding: 0;

      li:where(.svelte-8nzpty) {
        display: inline;
        list-style-type: none;
      }
    }
  }

  a.svelte-8nzpty {
    transition: color 300ms linear;
    color: #fafafa;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;

    h1:where(.svelte-8nzpty) {
      text-decoration: none;

      code:where(.svelte-8nzpty) {
        background: transparent;
        padding-inline: 0.2em;
        font-weight: normal;
        font-size: 0.8em;

        .inspect:where(.svelte-8nzpty) {
          color: var(--red);
          font-weight: bold;
        }

        .value:where(.svelte-8nzpty) {
          color: var(--blue);
          font-weight: normal;
        }
      }
    }
  }

  a.active.svelte-8nzpty,
  span.active.svelte-8nzpty {
    /* text-decoration: underline; */
    position: relative;
    color: var(--red);
  }

  @media (min-width: 768px) {
    main.svelte-8nzpty {
      /* padding-left: 3em; */
      padding-top: 0.5em;
      padding-right: 2rem;
      width: 90%;
    }

    main.drawer-open.svelte-8nzpty {
      padding-right: 2rem;
      padding-left: calc(3em + 230px);
      width: 100%;
    }

    .title.svelte-8nzpty {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    main.svelte-8nzpty {
      /* padding-left: 1em; */
      padding-right: 3em;
      width: 90%;
    }

    .title.svelte-8nzpty {
      font-size: 1.5rem;
    }
  }

  /* VIEW TRANSITIONS */
  @keyframes svelte-8nzpty-fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes svelte-8nzpty-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes svelte-8nzpty-slide-from-right {
    from {
      transform: translateX(30px);
    }
  }

  @keyframes svelte-8nzpty-slide-to-left {
    to {
      transform: translateX(-30px);
    }
  }

  :root::view-transition-old(root) {
    animation:
      90ms cubic-bezier(0.4, 0, 1, 1) both svelte-8nzpty-fade-out,
      300ms cubic-bezier(0.4, 0, 0.2, 1) both svelte-8nzpty-slide-to-left;
  }

  :root::view-transition-new(root) {
    animation:
      210ms cubic-bezier(0, 0, 0.2, 1) 90ms both svelte-8nzpty-fade-in,
      300ms cubic-bezier(0.4, 0, 0.2, 1) both svelte-8nzpty-slide-from-right;
  }

  .badges.svelte-8nzpty {
    display: flex;
    gap: 1ch;
    width: 100%;
    /* justify-content: flex-end; */
  }

  nav.drawer-nav.svelte-8nzpty {
    /* font-size: 16px; */
    overflow-y: auto;
    font-family: 'EB Garamond', serif;

    ul:where(.svelte-8nzpty) {
      display: flex;
      flex-direction: column;
      padding: 0;
      font-weight: bold;
      font-size: 18px;
      /* margin-bottom: 1em; */

      ul:where(.svelte-8nzpty) {
        padding-left: 1ch;
        font-weight: normal;
        font-size: 18px;

        ul:where(.svelte-8nzpty) {
          font-size: 12px;
          font-family: monospace;

          /* li::before {
            content: '- ';
          } */
        }
      }
    }

    ul:where(.svelte-8nzpty) li:where(.svelte-8nzpty) a:where(.svelte-8nzpty),
    ul:where(.svelte-8nzpty) li:where(.svelte-8nzpty) span:where(.svelte-8nzpty) {
      color: var(--_text-color) !important;
      line-height: 1.5;

      &:hover:not(span) {
        text-decoration: underline;
      }
    }

    ul:where(.svelte-8nzpty) li:where(.svelte-8nzpty) span:where(.svelte-8nzpty) {
      font-weight: bold;
    }

    ul:where(.svelte-8nzpty) li:where(.svelte-8nzpty) a.active:where(.svelte-8nzpty),
    ul:where(.svelte-8nzpty) li:where(.svelte-8nzpty) span.active:where(.svelte-8nzpty) {
      color: var(--red) !important;
    }


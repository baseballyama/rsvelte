					} else {
						$$renderer.push('<!--[-1-->');
					}

					$$renderer.push(`<!--]--> <button title="copy code"${$.attr_class('svelte-1g6xvrs', void 0, { 'copied': copied })}>`);
					Copy($$renderer, {});
					$$renderer.push(`<!----></button></div> `);

					if (children) {
						$$renderer.push('<!--[0-->');
						children($$renderer);
						$$renderer.push(`<!---->`);
					} else {
						$$renderer.push('<!--[-1-->');

						$.await(
							$$renderer,
							highlighted(),
							() => {
								$$renderer.push(`...`);
							},
							(result) => {
								$$renderer.push(`<div>${$.html(result)}</div>`);
							}
						);

						$$renderer.push(`<!--]-->`);
					}

					$$renderer.push(`<!--]--></div>`);
				}

				$$renderer.push(`<!--]-->`);

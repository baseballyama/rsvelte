	const _setOption = getContext('set-global-option');

	function customStore(initialValue = 0) {
		let interval;

		let val = writable(initialValue, () => {
			if (browser) {
				interval = window.setInterval(
					() => {
						val.update((n) => n + 1);
					},
					500
				);
			}

			return () => {
				window.clearInterval(interval);
			};
		});

		return {
			...val,
			set value(v) {

		{
			let $0 = $.derived(() => ({
				arr: values.veryNested,
				levelOne: {
					a: 'a',
					b: 'b',
					levelTwo: {
						a: 'a',
						b: 'b',
						levelThree: { a: 'a', b: 'b', levelFour: { msg: 'end' } }
					}
				},
				expandPathsValue: $.get(expandPaths)
			}));

			Inspect($$anchor, $.spread_props(() => $.get(props), {
				class: 'not-content mt',

					if ($.get(currentIndex) === MAX) {
						$.set(currentIndex, 0);
						alwaysPresent.search = true;
					} else {
						$.set(currentIndex, $.get(currentIndex) + 1);
					}
				},
				5000
			);
		});

		return () => {
			window.clearInterval(interval);
		};
	});

	$.user_effect(() => {
		let timeout;


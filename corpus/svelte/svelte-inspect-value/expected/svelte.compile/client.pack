	$.set_attribute(input, 'min', 0);
	$.set_attribute(input, 'max', 30);
	$.reset(label);

	var label_1 = $.sibling(label, 2);
	var input_1 = $.sibling($.child(label_1));

	$.remove_input_defaults(input_1);
	$.reset(label_1);
	$.reset(div);


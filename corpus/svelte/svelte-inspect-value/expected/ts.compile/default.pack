export function focusBySearch(string, focusId) {
    // Find a focus target that matches the string.
    try {
        const regex = new RegExp(string.split('').join('[^a-z0-9]*.?[^a-z0-9]*'), 'i');
        let scope = document.activeElement;
        const outer = scope.closest(`[data-focus-id="${focusId}"]`);
        do {
            scope = getParentScope(scope.parentElement);
            const targets = scope?.querySelectorAll('[data-focus-target]');
            for (let i = 0; i < targets?.length; i++) {
                const target = targets[i];
                // check non-preview keys first
                const keyElements = target?.querySelectorAll('.key-button:not([data-search-ignore])');
                if (keyElements.length) {
                    for (let j = 0; j < keyElements.length; j++) {
                        const t = keyElements[j];
                        const text = t.textContent ?? '';
                        if (regex.test(text) && outer?.contains(target)) {
                            return setFocus(target);
                        }
                    }
                }
                const text = target.textContent ?? '';
                if (regex.test(text) && outer?.contains(target)) {
                    return setFocus(target);
                }
            }
        } while (scope);
    }
    catch (e) {
        console.error('error while setting focus using typebuffer search:', e);
    }
    return false;
}

=== 431 packages/svelte/src/lib/attachments/inspect-element.ts	js
import { addToPanel } from '../global.svelte.js';
/**
 * Inspect an element with `Inspect.Panel`
 *
 * @param name key of element in `Inspect.Panel` global values. Defaults to `node.nodeName`
 *
 * @example
 * ```svelte
 * <input bind:value={amount} type="number" {@attach inspectElement('amountInput')} />
 * ```
 */
export const inspectElement = (name) => {
    return (node) => addToPanel(name ?? node.nodeName, () => node);
};

=== 794 packages/svelte/src/lib/attachments/update-flash.svelte.ts	js
import equal from 'fast-deep-equal';
export const flash = (value, onupdate, enabled = false, prevValue = undefined, initialized = false) => {
    return (node) => {
        $effect(() => {
            const newVal = value();
            if (enabled) {
                if (initialized) {
                    if (!equal(newVal, prevValue)) {
                        onupdate?.(node);
                        node.dispatchEvent(new CustomEvent('inspectvaluechange', { bubbles: true }));
                        prevValue = newVal;
                    }
                }
                else {
                    initialized = true;
                    prevValue = newVal;
                }
            }
            else {
                prevValue = newVal;
            }
        });
    };
};


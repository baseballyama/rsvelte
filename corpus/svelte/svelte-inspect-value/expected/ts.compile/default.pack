export const prerender = false;
export const load = (async ({ fetch }) => {
    const installCount = fetch('https://api.npmjs.org/downloads/point/1970-01-01:2038-01-19/svelte-inspect-value')
        .then((res) => res.json())
        .then((res) => res.downloads);
    const githubStars = fetch('https://api.github.com/repos/ampled/svelte-inspect-value')
        .then((res) => res.json())
        .then((data) => data.stargazers_count);
    return {
        stats: Promise.all([installCount, githubStars]).then(([installCount, githubStars]) => ({
            installCount,
            githubStars,
        })),
    };
});

=== 932 packages/svelte/src/routes/(app)/api/docs/+server.ts	js
import { json } from '@sveltejs/kit';
async function getPosts() {
    const posts = [];
    try {
        const paths = import.meta.glob('/src/doclib/typedoc/md/**/*.md', { eager: true });
        for (const path in paths) {
            const file = paths[path];
            const type = path.split('/').at(-2);
            if (file && typeof file === 'object' && 'metadata' in file) {
                const metadata = file.metadata;
                const post = { ...metadata, type };
                posts.push(post);
            }
        }
        return posts;
    }
    catch (e) {
        console.error('error in /docs endpoint:');
        console.error(e);
        return [];
    }
    // posts = posts.sort(
    //   (first, second) => new Date(second.date).getTime() - new Date(first.date).getTime()
    // )
    return [];
}
export const GET = async () => {
    const posts = await getPosts();
    return json(posts);
};


    }
    const note = addedBy ? { title: addedBy, description: addedByPath } : undefined;
    const entry = {
        note,
        get value() {
            return val();
        },
    };
    const remove = () => {
        globalValues.delete(name);
    };
    try {
        $effect(() => {
            val();
            globalValues.set(name, entry);
        });
        onDestroy(remove);
    }
    catch {
        // lifecycle_outside_component error
        // return manual remove fn
        globalValues.set(name, entry);
        return remove;
    }
    return remove;
}


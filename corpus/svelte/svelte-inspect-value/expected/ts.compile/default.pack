export function highlightText(text, terms) {
    if (!text || !terms.length) {
        return [];
    }
    const chunks = [];
    let currentIndex = 0;
    // Build a regex pattern to match all terms
    const regexParts = terms.map(({ value }) => escapeRegex(value));
    const regex = new RegExp(regexParts.join('|'), 'gi'); // Case-insensitive global match
    let match;
    while ((match = regex.exec(text)) !== null) {
        const matchStart = match.index;
        const matchEnd = regex.lastIndex;
        // Add unmatched text before the match
        if (currentIndex < matchStart) {
            chunks.push({
                match: false,
                text: text.slice(currentIndex, matchStart),
                start: currentIndex,
                end: matchStart,
            });
        }
        // Add the matched text
        chunks.push({
            match: true,
            text: text.slice(matchStart, matchEnd),
            start: matchStart,
            end: matchEnd,
        });
        currentIndex = matchEnd;
    }
    // Add any remaining unmatched text
    if (currentIndex < text.length) {
        chunks.push({
            match: false,
            text: text.slice(currentIndex),
            start: currentIndex,
            end: text.length,
        });
    }
    return chunks;
}
// Helper function to escape special regex characters
function escapeRegex(value) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}


/* hello.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { stringifyOrToString } from './util.js';

export function logToConsole(path = [], value, type) {
	const prefix = [
		`%cInspect ${type} at ${path.join('.')}:`,
		'background-color: black; padding: 5px; color: hotpink; border-radius: 8px;'
	];

	console.log(...prefix);

	let method = 'log';

	if (type === 'object') {
		method = 'dir';
	}

	try {
		console[method]($.snapshot(value));
	} catch(e) {
		console.error('[Inspect] caught error trying to log snapshot of value. retrying without cloning. error:', e);
		console.log('retry:', value);
	}
}

export function copyToClipBoard(item, type) {
	if (type === 'bigint') {
		item = item.toString() + 'n';

		return navigator.clipboard.writeText(item);
	}

	return navigator.clipboard.writeText(stringifyOrToString(item));
}

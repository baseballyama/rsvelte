/* mutation-observer.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { onMount } from 'svelte';

export function htmlState(ele) {
	let element = ele;
	let lastMutation = void 0;

	const observer = new MutationObserver(([mutation]) => {
		// reset element reference to trigger reactivity
		element = null;

		element = mutation.target;
		lastMutation = mutation;
	});

	onMount(() => {
		observer.observe(ele, {
			attributes: true,
			childList: true,
			attributeOldValue: true,
			characterData: true
		});

		return () => {
			observer.disconnect();
		};
	});

	return {
		get ele() {
			return element;
		},

		get lastMutation() {
			return lastMutation;
		},

		destroy: () => {
			observer.disconnect();
		}
	};
}

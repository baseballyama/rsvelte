  {/snippet}
  {#each value as num, i (i)}
    <Entry {i}>
      <Node key={i} value={num} {path} />
    </Entry>
  {/each}
  {#each entries as [key, val], i (key)}
    <Entry i={value.length + i}>
      <Node {key} value={val} {path} />
    </Entry>

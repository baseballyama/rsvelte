=== 5642 apps/docs/src/examples/panel/PanelExample.svelte	svelte	runes	runes
<script lang="ts">
  import { globalOpts } from '@components/global-opts/globalopts.svelte'
  import { onMount } from 'svelte'
  import Inspect, { addToPanel } from 'svelte-inspect-value'
  import { flip } from 'svelte/animate'
  import { quintOut } from 'svelte/easing'
  import { crossfade } from 'svelte/transition'

  let board: HTMLDivElement
  let fullscreenAvailable = $state(false)

  onMount(() => {
    fullscreenAvailable = document.fullscreenEnabled
  })

  const [send, receive] = crossfade({
    fallback(node) {
      const style = getComputedStyle(node)
      const transform = style.transform === 'none' ? '' : style.transform

      return {
        duration: 600,
        easing: quintOut,
        css: (t) => `
					transform: ${transform} scale(${t});
					opacity: ${t}
				`,
      }
    },
  })

  let todos = $state([
    { id: 1, done: false, description: 'write some docs' },
    { id: 2, done: false, description: 'tune the banjo' },
    { id: 3, done: false, description: 'fix some bugs' },
    { id: 4, done: false, description: 'mow the lawn' },
    { id: 5, done: true, description: 'feed the turtle' },
  ])

  // svelte-ignore state_referenced_locally
  let uid = todos.length + 1

  // @ts-expect-error foo
  function add(input) {
    const todo = {
      id: uid++,
      done: false,
      description: input.value,
    }

    todos = [todo, ...todos]
    input.value = ''
  }

  // @ts-expect-error foo
  function remove(todo) {
    todos = todos.filter((t) => t !== todo)
  }

  let todo = $derived(todos.filter((t) => !t.done))
  let done = $derived(todos.filter((t) => t.done))

  addToPanel(
    'isTurtleFed',
    () => {
      const turtle = todos.find((t) => t.description.includes('turtle'))
      if (turtle) {
        return turtle.done
      }
      return 'dunno'
    },
    'App.svelte'
  )

  addToPanel('allTodos', () => todos, 'Added manually')

  async function toggleFullscreen() {
    if (!document.fullscreenElement) {
      try {
        await board.requestFullscreen({ navigationUI: 'show' })
      } catch (e) {
        console.error('Error when requesting fullscreen')
      }
    } else {
      await document.exitFullscreen()
    }
  }
</script>

<div class="panel-example not-content" bind:this={board}>
  {#if fullscreenAvailable}
    <button onclick={toggleFullscreen}>toggle fullscreen</button>
  {/if}
  <Inspect.Panel
    {...globalOpts}
    values={{ todo, done }}
    align="right bottom"
    heading="todos"
    expandLevel={1}
    previewEntries={Infinity}
    style="position:absolute"
    appearance="solid"
    open
    zIndex={999}
  >
    <p
      style="font-size: 1rem;background-color: var(--_background-color); width: 100%; padding: 0.5em; border-radius: var(--_border-radius); border: 1px solid var(--_border-color); text-align: center"
    >
      👈 Try resizing the panel!<br />
      Double-click the edge to reset size.
    </p>
  </Inspect.Panel>

  <div class="board">
    <input
      class="new-todo"
      name="new-todo"
      placeholder="what needs to be done?"
      onkeydown={(event) => event.key === 'Enter' && add(event.target)}
    />

    <div class="left">
      <h2>todo</h2>
      {#each todos.filter((t) => !t.done) as todo (todo.id)}
        <label in:receive={{ key: todo.id }} out:send={{ key: todo.id }} animate:flip>
          <input name={todo.description} type="checkbox" bind:checked={todo.done} />
          {todo.description}
          <button onclick={() => remove(todo)}>x</button>
          <button onclick={() => addToPanel(`todo.${todo.id}`, () => todo)}>i</button>
        </label>
      {/each}
    </div>

    <div class="right">
      <h2>done</h2>
      {#each todos.filter((t) => t.done) as todo (todo.id)}
        <label in:receive={{ key: todo.id }} out:send={{ key: todo.id }} animate:flip>
          <input name={todo.description} type="checkbox" bind:checked={todo.done} />
          {todo.description}
          <button onclick={() => remove(todo)}>x</button>
        </label>
      {/each}
    </div>
  </div>

  <Inspect
    {...globalOpts}
    values={{ msg: 'add to panel from here 👉', allTodos: todos }}
    showLength={false}
    name="all"
    style="max-width: 420px"
  />
</div>

<style>
  .panel-example {
    display: flex;
    position: relative;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 1ch;
    border-radius: 8px;
    background-color: rgb(94, 84, 106);
    padding: 2ch;
    width: 100%;
    height: 800px;
    overflow: hidden;
    color: black;
    font-size: 12px;
    font-family: monospace;
  }

  .new-todo {
    margin: 2em 0 1em 0;
    width: 100%;
    font-size: 1.4em;
  }

  .board {
    margin: 0 3em;
    max-width: 36em;
  }

  .left,
  .right {
    float: left;
    box-sizing: border-box;
    padding: 0 1em 0 0;
    width: 50%;

    button {
      float: right;
      opacity: 0;
      transition: opacity 0.2s;
      box-sizing: border-box;
      border: none;

    h1 {
        font-family: "SUSE", sans-serif;
        font-size: 12rem;

        mix-blend-mode: difference;
        color: var(--color);

        margin: 10rem 0 0 10rem;
    }

    @media (max-width: 1000px) {
        h1 {
            font-size: 4rem;
            margin: 2rem;
        }
    }
</style>


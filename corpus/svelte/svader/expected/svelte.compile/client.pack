	let val = $.state(0.75);
	var main = root();
	var span = $.sibling($.child(main), 2);
	var div = $.child(span);
	var node = $.child(div);

	{
		let $0 = $.derived(() => [
			{ label: "Resolution", binding: 0, value: "resolution" },
			{ label: "Offset", binding: 1, value: "offset" },
			{ label: "Scale", binding: 2, value: "scale" },
			{
				label: "Value",
				binding: 3,
				value: new Float32Array([$.get(val)])
			}
		]);

		WebGpuShader(node, {
			get code() {

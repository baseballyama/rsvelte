import * as $ from 'svelte/internal/server';
import { WebGlShader, WebGpuShader } from "svader";

export default function Invalid($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		WebGlShader($$renderer, {
			forceAnimation: 'yeah',
			width: // @ts-expect-error: forceAnimation must be a boolean
			// @ts-expect-error: width must be a string
			100,

			height: // @ts-expect-error: height must be a string
			100,

			code: // @ts-expect-error: code is not a string
			42,

			parameters: [
				// @ts-expect-error: missing name property
				{ type: "float", value: 42 },

				// @ts-expect-error: missing type property
				{ name: "value1", value: 42 },

				// @ts-expect-error: missing value property
				{ name: "value2", type: "float" },

				{
					name: "value3",
					// @ts-expect-error: type should not be present with built-in value
					type: "float",
					value: "resolution"
				},

				{
					name: "value4",
					// @ts-expect-error: misspelled type
					type: "flote",
					value: 42
				},

				{
					name: "value5",
					// @ts-expect-error: misspelled built-in value
					value: "resoltion"
				},

				{
					// @ts-expect-error: name must be a string
					name: 6,
					type: "float",
					value: 42
				},

				{
					name: "value7",
					// @ts-expect-error: type must be a string
					type: 7,
					value: 42
				},

				{
					name: "value8",
					type: "float",
					// @ts-expect-error: float corresponds to number
					value: [0, 0]
				},

				{
					name: "value9",
					type: "int",
					// @ts-expect-error: int corresponds to number
					value: [0, 0]
				},

				{

		nullable: true,
		isAlpha: true,
		isDialog: false,
		a11yLevel: 'AAA',
		a11yColors: [
			{ textHex: '#FFF', reverse: true, placeholder: 'background' },
			{
				textHex: '#FFF',
				bgHex: '#FF0000',
				reverse: true,
				placeholder: 'background /w alpha'
			},
			{ bgHex: '#FFF', placeholder: 'title', size: 'large' },
			{ bgHex: '#7F7F7F', placeholder: 'button' }
		],

		get hex() {
			return $.get(hex);
		},

		set hex($$value) {
			$.set(hex, $$value, true);
		},

		get rgb() {
			return $.get(rgb);
		},

		set rgb($$value) {
			$.set(rgb, $$value, true);
		},

		get hsv() {
			return $.get(hsv);
		},

		set hsv($$value) {
			$.set(hsv, $$value, true);
		}
	});

	$.reset(div);
	$.append($$anchor, fragment);
}

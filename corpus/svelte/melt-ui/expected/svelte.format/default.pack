                : "border-neutral-400 bg-neutral-100",
              "dark:border-white",
            ]}
          >
            {#if item.checked}
              <div
                class={[
                  "h-3 w-3 rounded-full",
                  item.checked && "dark:bg-accent-500 bg-white",
                ]}
                aria-hidden="true"
              ></div>
            {/if}
          </div>

          <span
            class="font-semibold capitalize leading-none text-gray-600 dark:text-gray-100"
          >
            {i}
          </span>
        </div>
      {/each}
    </div>

	[data-melt-tabs-content][data-orientation="horizontal"].svelte-1upx803 {
		width: min(550px, 50vw);
	}

	[class*="-grid"].svelte-1upx803 {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 1rem;
	}

	.media.svelte-1upx803 {
		position: relative;
		object-fit: cover;
	}

	.media.svelte-1upx803::after {
		position: absolute;
		content: "";
		inset: 0;
		z-index: 1;
		background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.5));
	}

	/* Movies */
	.movie-grid.svelte-1upx803 {
		grid-template-rows: repeat(auto-fill, 250px);
	}

	.movie-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(1) {
		grid-column: 1 / 8;
	}

	.movie-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(2) {
		grid-column: 8 / 12;
	}

	.movie-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(3) {
		grid-column: 2 / 6;
	}

	.movie-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(4) {
		grid-column: 6 / 13;
	}

	/* Anime */
	.anime-grid.svelte-1upx803 {
		grid-template-rows: repeat(auto-fill, 200px);
	}

	.anime-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(1) {
		grid-column: 1 / 9;
	}

	.anime-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(2) {
		grid-column: 9 / 13;
	}

	.anime-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(3) {
		grid-column: 1 / 6;
	}

	.anime-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(4) {
		grid-column: 6 / 13;
	}

	/* Games */
	.game-grid.svelte-1upx803 {
		grid-template-rows: 260px 200px;
	}

	.game-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(1) {
		grid-column: 1 / 13;
	}

	.game-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(2) {
		grid-column: 1 / 5;
	}

	.game-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(3) {
		grid-column: 5 / 9;
	}

	.game-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(4) {
		grid-column: 9 / 13;
	}

	/* Music */
	.music-grid.svelte-1upx803 {
		grid-template-rows: repeat(2, 220px);
	}

	.music-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(1) {
		grid-column: 1 / 7;
	}

	.music-grid.svelte-1upx803 > :where(.svelte-1upx803):nth-child(2) {

const items = [];

testWithEffect("Should have valid types for single and multiple", () => {
	const undefTree = new Tree({ items });

	expectTypeOf(undefTree.selected).toMatchTypeOf();
	expectTypeOf(undefTree.expanded).toMatchTypeOf();

	const defSingle = new Tree({ items, selected: "test" });

	expectTypeOf(defSingle.selected).toMatchTypeOf();
	expectTypeOf(defSingle.expanded).toMatchTypeOf();

	const dynamicSingle = new Tree({ items: [], selected: () => undefined });

	expectTypeOf(dynamicSingle.selected).toMatchTypeOf();
	expectTypeOf(dynamicSingle.expanded).toMatchTypeOf();

	const defMult = new Tree({ items, selected: ["test"], multiple: true });

	expectTypeOf(defMult.selected).toMatchTypeOf();
	expectTypeOf(defMult.expanded).toMatchTypeOf();

	const undefMult = new Tree({ items, multiple: true });

	expectTypeOf(undefMult.selected).toMatchTypeOf();
	expectTypeOf(undefMult.expanded).toMatchTypeOf();

	const dynamicMult = new Tree({ items: [], selected: () => ["hi"], multiple: true });

	expectTypeOf(dynamicMult.selected).toMatchTypeOf();
	expectTypeOf(dynamicMult.expanded).toMatchTypeOf();
});

testWithEffect("Should auto infer item type when passing static array", () => {

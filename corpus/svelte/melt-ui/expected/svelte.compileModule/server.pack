		});

		it("should reflect changes in source set", () => {
			const data = new SvelteSet([1, 2, 3]);
			const collection = new Collection(data);

			expect([...collection]).toEqual([1, 2, 3]);
			data.add(4);
			expect([...collection]).toEqual([1, 2, 3, 4]);
		});
	});
});

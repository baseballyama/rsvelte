/* preview-ctx.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { getContext, setContext } from "svelte";
import { objectMap } from "@antfu/utils";

const CTX_KEY = Symbol();

function set(ctx) {
	return setContext(CTX_KEY, ctx);
}

function get() {
	return getContext(CTX_KEY) ?? {};
}

export const previewCtx = { get, set };

export function usePreviewControls(schema) {
	const values = objectMap(schema, (key, { defaultValue }) => {
		return [key, defaultValue];
	});

	previewCtx.set({ values, schema });

	return values;
}

		if (!this.open) return;

		const target = e.target;
		if (!(target instanceof Element) && !(target instanceof Document)) return;

		const triggerEl = document.getElementById(this.ids.trigger);
		if ((triggerEl && target.contains(triggerEl)) || this.open) {
			this.#closeTooltip();
		}
	}
}


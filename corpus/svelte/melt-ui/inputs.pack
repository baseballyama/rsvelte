					...acc,
					{ x: point.x + PADDING, y: point.y + PADDING },
					{ x: point.x + PADDING, y: point.y - PADDING },
					{ x: point.x - PADDING, y: point.y + PADDING },
					{ x: point.x - PADDING, y: point.y - PADDING },

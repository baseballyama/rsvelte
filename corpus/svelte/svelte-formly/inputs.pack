=== 219 src/lib/utils/validation/rules/max.ts	ts	module	-
export function max(val: any, args: any) {
  const maxValue = parseFloat(args[0]);
  val = val ? val : "";
  const value = isNaN(val) ? val.length : parseFloat(val);

  return isNaN(value) ? true : value <= maxValue;
}

=== 197 src/lib/utils/validation/rules/min.ts	ts	module	-
export function min(val: any, args: any) {
  const minValue = parseFloat(args[0]);
  val = val ? val : "";
  const value = isNaN(val) ? val.length : parseFloat(val);

  return value >= minValue;
}

=== 406 src/lib/utils/validation/rules/required.ts	ts	module	-
export function required(val: any, args: any) {
  if (
    val === undefined ||
    val === null ||
    val === "undefined" ||
    val === "null" ||
    val === null ||
    Number.isNaN(val)
  ) {
    return false;
  }

  if (typeof val === "string") {
    const tmp = val.replace(/\s/g, "");
    return tmp.length > 0;
  }
  if (typeof val === "object") {
    return val.length > 0;
  }

  return true;
}

=== 202 src/lib/utils/validation/rules/url.ts	ts	module	-
export function url(val: any, args: any) {
  const regex =
    /(https?|ftp|git|svn):\/\/(www\.)?[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-z]{2,63}\b([-a-zA-Z0-9@:%_\+.~#?&//=]*)/i;
  return regex.test(val);
}


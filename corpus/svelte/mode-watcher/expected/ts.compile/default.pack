class CustomTheme {
    #storage = isBrowser ? localStorage : noopStorage;
    #initialValue = this.#storage.getItem(themeStorageKey.current);
    #value = this.#initialValue === null || this.#initialValue === undefined ? "" : this.#initialValue;

function getClasses(element) {
    if (element === null)
        return [];
    const classes = element.className.split(" ").filter((c) => c.length > 0);
    return classes;
}
function getColorScheme(element) {
    if (element === null)
        return "";
    return element.style.colorScheme;
}
function getThemeColor(element) {
    if (element === null)
        return "";
    const themeMetaEl = element.querySelector('meta[name="theme-color"]');
    if (themeMetaEl === null)
        return "";
    const content = themeMetaEl.getAttribute("content");
    if (content === null)
        return "";
    return content;
}


<script lang="ts">
  import { setInitialMode } from "../mode.js";
  import type { ThemeColors } from "../types.js";

  let {
    trueNonce = "",
    initConfig,
    themeColors,
  }: {
    trueNonce: string;
    initConfig: Parameters<typeof setInitialMode>[0];
    themeColors: ThemeColors;
  } = $props();
</script>

<svelte:head>

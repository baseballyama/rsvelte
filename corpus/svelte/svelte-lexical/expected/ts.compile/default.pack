export const PUNCTUATION = '\\.,\\+\\*\\?\\$\\@\\|#{}\\(\\)\\^\\-\\[\\]\\\\/!%\'"~=<>_:;';
export function useBasicTypeaheadTriggerMatch(trigger, { minLength = 1, maxLength = 75, punctuation = PUNCTUATION, allowWhitespace = false, }) {
    return (text) => {

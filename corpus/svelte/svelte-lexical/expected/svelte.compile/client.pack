		get className() {
			return $$props.className;
		},

		get format() {
			return $$props.format;
		},

		get nodeKey() {
			return $$props.nodeKey;
		},

		children: ($$anchor, $$slotProps) => {
			var fragment_1 = root();
			var node = $.first_child(fragment_1);

			{

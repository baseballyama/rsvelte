					$.template_effect(() => $.set_text(text, $$props.loadingComponent));
					$.append($$anchor, text);
				};

				$.if(node, ($$render) => {
					if ($.get(isTweetLoading)) $$render(consequent);
				});
			}

			var div = $.sibling(node, 2);


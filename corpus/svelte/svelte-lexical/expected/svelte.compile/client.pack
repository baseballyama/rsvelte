  .new-note-btn.svelte-uv8ryn,
  .icon-btn.svelte-uv8ryn {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: none;
    background: #313244;
    color: #cdd6f4;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }

  .icon-btn.svelte-uv8ryn {
    font-size: 14px;
  }

  .new-note-btn.svelte-uv8ryn:hover,
  .icon-btn.svelte-uv8ryn:hover {
    background: #45475a;
  }

  .notes-list.svelte-uv8ryn {
    flex: 1;
    overflow-y: auto;
    padding: 6px 0;
  }

  .notes-list.svelte-uv8ryn::-webkit-scrollbar {
    width: 4px;
  }

  .notes-list.svelte-uv8ryn::-webkit-scrollbar-track {
    background: transparent;
  }

  .notes-list.svelte-uv8ryn::-webkit-scrollbar-thumb {
    background: #45475a;
    border-radius: 2px;
  }

  .empty-message.svelte-uv8ryn {
    color: #6c7086;
    font-size: 13px;
    text-align: center;
    padding: 24px 16px;
    line-height: 1.6;
  }

  .note-item.svelte-uv8ryn {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    cursor: pointer;
    border-radius: 6px;
    margin: 1px 6px;
    transition: background 0.1s;
    user-select: none;
    gap: 4px;
  }

  .note-item.svelte-uv8ryn:hover {
    background: #313244;
  }

  .note-item.active.svelte-uv8ryn {
    background: #313244;
  }

  .note-item.active.svelte-uv8ryn .note-title:where(.svelte-uv8ryn) {
    color: #cba6f7;
  }

  .note-item-content.svelte-uv8ryn {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .note-title.svelte-uv8ryn {
    font-size: 13px;
    font-weight: 500;
    color: #cdd6f4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .note-date.svelte-uv8ryn {
    font-size: 11px;
    color: #6c7086;
  }

  .rename-input.svelte-uv8ryn {
    width: 100%;
    background: #313244;
    border: 1px solid #cba6f7;
    border-radius: 4px;
    color: #cdd6f4;
    font-size: 13px;
    padding: 2px 4px;
    outline: none;
  }

  .delete-btn.svelte-uv8ryn {
    opacity: 0;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: #6c7086;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.1s;
    padding: 0;
  }

  .note-item.svelte-uv8ryn:hover .delete-btn:where(.svelte-uv8ryn) {
    opacity: 1;
  }

  .delete-btn.svelte-uv8ryn:hover {
    background: #f38ba8;
    color: #1e1e2e;
  }


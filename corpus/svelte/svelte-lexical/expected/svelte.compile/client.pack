	$isEditorIsNestedEditor as isEditorIsNestedEditor
} from '@lexical/utils';

import { getContext, onMount } from 'svelte';
import { $isCodeNode as isCodeNode, CODE_LANGUAGE_MAP } from '@lexical/code';

  dialog.svelte-fampxd {
    border-radius: 12px;
    border: none;
    padding: 0;
  }
  dialog.svelte-fampxd::backdrop {
    background: rgba(0, 0, 0, 0.3);
  }
  dialog.svelte-fampxd > div:where(.svelte-fampxd) {
    padding: 1em;
  }
  dialog[open].svelte-fampxd {
    animation: svelte-fampxd-zoom 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes svelte-fampxd-zoom {
    from {
      transform: scale(0.95);
    }
    to {
      transform: scale(1);
    }
  }
  dialog[open].svelte-fampxd::backdrop {
    animation: svelte-fampxd-fade 0.2s ease-out;
  }
  @keyframes svelte-fampxd-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }


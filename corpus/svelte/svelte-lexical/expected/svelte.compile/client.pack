	$.reset(div);
	$.template_effect(() => button.disabled = $.get(isDisabled));

	$.delegated('click', button, () => {
		$activeEditor().dispatchCommand(INSERT_IMAGE_COMMAND, { altText: $.get(altText), src: $.get(src) });
		$$props.onconfirm?.();

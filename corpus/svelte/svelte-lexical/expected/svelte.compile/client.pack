	var div = $.sibling(node, 2);
	var node_1 = $.sibling($.child(div), 2);

	$.html(node_1, () => $.get(html));
	$.reset(div);

	var div_1 = $.sibling(div, 2);
	var text = $.sibling($.child(div_1));

	$.reset(div_1);
	$.template_effect(() => $.set_text(text, ` ${$.get(html) ?? ''}`));

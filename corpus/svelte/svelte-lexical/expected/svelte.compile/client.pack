	$.template_effect(
		($0, $1) => {
			button.disabled = $0;
			$.set_attribute(button, 'title', `Decrease font size (${SHORTCUTS.DECREASE_FONT_SIZE})`);
			input.disabled = !$isEditable();
			$.set_attribute(input, 'min', MIN_ALLOWED_FONT_SIZE);
			$.set_attribute(input, 'max', MAX_ALLOWED_FONT_SIZE);
			button_1.disabled = $1;

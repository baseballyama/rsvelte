				Toolbar($$renderer, {});
				$$renderer.push(`<!----> <div class="editor-scroller svelte-1g8o6ha"><div class="editor svelte-1g8o6ha">`);
				RichTextPlugin($$renderer, {});
				$$renderer.push(`<!----> `);
				ContentEditable($$renderer, {});
				$$renderer.push(`<!----> `);


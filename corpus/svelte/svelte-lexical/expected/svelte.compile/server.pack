import FileInput from '../../generic/input/FileInput.svelte';

export default function InsertImageUploadedDialogBody($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		var $$store_subs;
		const activeEditor = getActiveEditor();
		let { onconfirm } = $$props;

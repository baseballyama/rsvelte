    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .editor-wrapper :global(.toolbar) {
    scrollbar-width: none;
  }

  .editor-wrapper :global(.toolbar)::-webkit-scrollbar {

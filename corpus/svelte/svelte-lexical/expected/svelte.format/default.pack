    left: 10px; /* 10px instead of 28px as we don't have the re-arrange handle implemented yet*/
    right: 28px;
    user-select: none;
    white-space: nowrap;
    display: inline-block;
    pointer-events: none;
  }

  @media (max-width: 1025px) {
    .Placeholder__root {
      left: 8px;
    }
  }
</style>


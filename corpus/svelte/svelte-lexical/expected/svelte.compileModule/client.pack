/* themeTracker.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { CAN_USE_DOM } from '@lexical/utils';

class ThemeTracker {
	darkModeMediaQuery = CAN_USE_DOM && window.matchMedia('(prefers-color-scheme: dark)');
	#themeMode = $.state($.proxy(CAN_USE_DOM && localStorage.getItem('app-theme') || 'system'));

	get themeMode() {
		return $.get(this.#themeMode);
	}

	set themeMode(value) {
		$.set(this.#themeMode, value, true);
	}

	#themeColor = $.state('light');

	get themeColor() {
		return $.get(this.#themeColor);
	}

	set themeColor(value) {
		$.set(this.#themeColor, value, true);
	}

	constructor() {
		if (!CAN_USE_DOM) return;

		this.updateTheme();
		this.darkModeMediaQuery.addEventListener('change', () => this.updateTheme());
	}

	get mode() {
		return this.themeMode;
	}

	set mode(mode) {
		this.themeMode = mode;
		this.updateTheme();
		localStorage.setItem('app-theme', mode);
	}

	get color() {
		return this.themeColor;
	}

	updateTheme() {
		if (this.themeMode === 'system') {
			const currentColor = this.darkModeMediaQuery.matches ? 'dark' : 'light';

			if (currentColor !== this.themeColor) {
				this.themeColor = currentColor;
				this.setThemeInDom();
			}
		} else if (this.themeColor !== this.themeMode) {
			this.themeColor = this.themeMode;
			this.setThemeInDom();
		}
	}

	setThemeInDom() {
		if (CAN_USE_DOM) {
			document.documentElement.setAttribute('data-theme', this.themeColor);
		}
	}
}

export const themeTracker = new ThemeTracker();

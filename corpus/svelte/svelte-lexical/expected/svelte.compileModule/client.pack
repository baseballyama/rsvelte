/* notesStore.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { getNotesBackend } from './notesBackend';

function createNotesStore() {
	const backend = getNotesBackend();
	let notes = $.state($.proxy([]));
	let activeNoteId = $.state(null);
	let activeNoteContent = $.state(null);
	let notesLocation = $.state('');
	let isLoading = $.state(false);
	let isSaving = $.state(false);
	let isInitialized = $.state(false);

	async function init() {
		if ($.get(isInitialized)) return;

		$.set(notesLocation, await backend.init(), true);
		await loadNotes();
		$.set(isInitialized, true);
	}

	async function loadNotes() {
		$.set(isLoading, true);

		try {
			const entries = await backend.list();

			$.set(
				notes,
				entries.map(({ id, data }) => ({
					id,
					title: data.title || 'Untitled',
					createdAt: data.createdAt,
					updatedAt: data.updatedAt
				})).sort((a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()),
				true
			);
		} finally {
			$.set(isLoading, false);
		}
	}

	async function createNote() {
		const id = `note_${Date.now()}`;
		const now = new Date().toISOString();

		const noteData = {
			title: 'Untitled',
			content: '',
			createdAt: now,
			updatedAt: now
		};

		await backend.write(id, noteData);

		const newNote = { id, title: 'Untitled', createdAt: now, updatedAt: now };

		$.set(notes, [newNote, ...$.get(notes)], true);
		await openNote(id);
	}

	async function openNote(id) {
		try {
			const data = await backend.read(id);

			$.set(activeNoteId, id, true);
			$.set(activeNoteContent, data.content || null, true);
		} catch(e) {
			// eslint-disable-next-line no-console
			console.error(`Failed to open note ${id}:`, e);
		}
	}

	async function saveNoteContent(id, content) {
		$.set(isSaving, true);

		try {
			const data = await backend.read(id);
			const updated = { ...data, content, updatedAt: new Date().toISOString() };

			await backend.write(id, updated);
			$.set(notes, $.get(notes).map((n) => n.id === id ? { ...n, updatedAt: updated.updatedAt } : n).sort((a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()), true);
		} finally {
			$.set(isSaving, false);
		}
	}

	async function renameNote(id, newTitle) {
		const data = await backend.read(id);

		const updated = {
			...data,
			title: newTitle,
			updatedAt: new Date().toISOString()
		};

		await backend.write(id, updated);

		$.set(
			notes,
			$.get(notes).map((n) => n.id === id
				? { ...n, title: newTitle, updatedAt: updated.updatedAt }
				: n),
			true
		);
	}

	async function deleteNote(id) {
		await backend.remove(id);
		$.set(notes, $.get(notes).filter((n) => n.id !== id), true);

		if ($.get(activeNoteId) === id) {
			$.set(activeNoteId, null);
			$.set(activeNoteContent, null);
		}
	}

	return {
		get notes() {
			return $.get(notes);
		},

		get notesDir() {
			return $.get(notesLocation);
		},

		get activeNoteId() {
			return $.get(activeNoteId);
		},

		get activeNote() {
			return $.get(notes).find((n) => n.id === $.get(activeNoteId)) ?? null;
		},

		get activeNoteContent() {
			return $.get(activeNoteContent);
		},

		get isLoading() {
			return $.get(isLoading);
		},

		get isSaving() {
			return $.get(isSaving);
		},

		get isInitialized() {
			return $.get(isInitialized);
		},
		init,
		createNote,
		openNote,
		saveNoteContent,
		renameNote,
		deleteNote
	};
}

export const notesStore = createNotesStore();

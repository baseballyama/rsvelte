					closeButton = $$value;
					$$settled = false;
				}
			});

			$$renderer.push(`<!----></div></main> `);
			Footer($$renderer, {});
			$$renderer.push(`<!---->`);
		}

		do {
			$$settled = true;
			$$inner_renderer = $$renderer.copy();
			$$render_inner($$inner_renderer);

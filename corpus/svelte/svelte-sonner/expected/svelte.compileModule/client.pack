let toastsCounter = 0;

function getToastId(data) {
	return typeof data?.id === 'number' || typeof data?.id === 'string' && data.id.length > 0 ? data.id : toastsCounter++;
}

class ToastState {
	#toasts = $.state($.proxy([]));


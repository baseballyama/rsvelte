		min-width: 118px;
		justify-content: center;
		border: 1px solid currentColor;
		padding: 8px 18px;
		background: #fff;
		color: var(--plum);
		font-size: 12px;
		line-height: 16px;
		text-transform: uppercase;
	}

	.lime-categories.svelte-bqnxlw {
		padding: 60px 40px 52px;
		text-align: center;
	}

	.lime-section-heading.svelte-bqnxlw h2:where(.svelte-bqnxlw) {
		margin: 0 0 10px;
		color: var(--plum);
		font-family: var(--font-heading);
		font-size: 24px;
		font-weight: 400;
		line-height: 31.2px;
	}

	.lime-section-heading.svelte-bqnxlw p:where(.svelte-bqnxlw) {
		margin: 0 0 20px;
		color: #000;
		font-size: 16px;
		line-height: 20.8px;
	}

	.lime-category-row.svelte-bqnxlw {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 20px;
	}

	.lime-category.svelte-bqnxlw img:where(.svelte-bqnxlw) {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		display: block;
	}

	.lime-category.svelte-bqnxlw h3:where(.svelte-bqnxlw) {
		margin: 16px 0 0;
		color: var(--plum);
		font-family: var(--font-heading);
		font-size: 20px;
		font-weight: 400;
		line-height: 1.3;
	}

	.lime-collage.svelte-bqnxlw,
	.lime-split-campaign.svelte-bqnxlw,
	.lime-demand.svelte-bqnxlw,
	.lime-story.svelte-bqnxlw,
	.lime-store.svelte-bqnxlw,
	.lime-faq.svelte-bqnxlw {
		width: min(var(--container-max, 1360px), 100% - 2 * var(--container-gutter, 40px));
		margin: 0 auto;
	}

	.lime-collage.svelte-bqnxlw {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 30px;
	}

	.lime-collage.svelte-bqnxlw img:where(.svelte-bqnxlw),
	.lime-split-campaign.svelte-bqnxlw img:where(.svelte-bqnxlw),
	.lime-demand.svelte-bqnxlw img:where(.svelte-bqnxlw),
	.lime-story.svelte-bqnxlw img:where(.svelte-bqnxlw),
	.lime-store.svelte-bqnxlw img:where(.svelte-bqnxlw) {

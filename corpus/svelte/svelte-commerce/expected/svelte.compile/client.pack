	/* Shown when the store has not uploaded a logo. */
	.lime-wordmark.svelte-3tnr1h {
		display: block;
		max-width: 200px;
		color: var(--lime-plum, #460032);
		font-family: var(--font-heading);
		font-size: 26px;
		line-height: 1.1;
		letter-spacing: 0.02em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.lime-nav.svelte-3tnr1h {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		padding-left: 10px;
		font-size: 12px;

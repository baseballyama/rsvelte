		white-space: nowrap;
	}

	.lime-actions.svelte-3tnr1h {
		display: flex;
		justify-content: flex-end;
		gap: 17px;
		align-items: center;
	}

	.lime-actions.svelte-3tnr1h svg,
	.lime-mobile-trigger.svelte-3tnr1h svg {
		width: 18px;
		height: 18px;
		stroke-width: 1.5;

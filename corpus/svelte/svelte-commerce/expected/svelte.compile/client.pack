	.lime-mobile-trigger.svelte-3tnr1h {
		display: none;
	}

	@media (max-width: 1200px) {
		.lime-header.svelte-3tnr1h {
			grid-template-columns: 170px minmax(0, 1fr) 132px;
			padding: 12px 24px;
		}

		.lime-logo.svelte-3tnr1h img:where(.svelte-3tnr1h) {
			width: 170px;
		}

		.lime-wordmark.svelte-3tnr1h {
			max-width: 170px;

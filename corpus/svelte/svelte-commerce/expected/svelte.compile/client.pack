	.ed.svelte-d9v6bn .ed-action:where(.svelte-d9v6bn) {
		color: var(--ed-ink);
		transition: color 0.25s ease;
	}

	.ed.svelte-d9v6bn .ed-action:where(.svelte-d9v6bn):hover {
		color: hsl(var(--primary));
	}

	/* Mobile product-listing header */
	.ed.svelte-d9v6bn .ed-plp-title:where(.svelte-d9v6bn) {
		font-family: var(--ed-display);
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--ed-ink);
	}

	.ed.svelte-d9v6bn .ed-plp-count:where(.svelte-d9v6bn) {
		color: var(--ed-soft);
		letter-spacing: 0.02em;
	}

	/* ---------- Mobile drawer ---------- */
	.ed.svelte-d9v6bn .ed-drawer:where(.svelte-d9v6bn) {
		background: var(--ed-surface);
		border-right-color: var(--ed-line);
		color: var(--ed-ink);
	}

	.ed.svelte-d9v6bn .ed-drawer-head:where(.svelte-d9v6bn),
	.ed.svelte-d9v6bn .ed-drawer-user:where(.svelte-d9v6bn),
	.ed.svelte-d9v6bn .ed-drawer-foot:where(.svelte-d9v6bn) {
		border-color: var(--ed-line);
	}

	.ed.svelte-d9v6bn .ed-drawer-user:where(.svelte-d9v6bn),
	.ed.svelte-d9v6bn .ed-drawer-foot:where(.svelte-d9v6bn) {
		background: var(--ed-canvas);
	}

	.ed.svelte-d9v6bn .ed-drawer-label:where(.svelte-d9v6bn) {
		font-family: var(--ed-body);
		color: var(--ed-soft);
		letter-spacing: 0.18em;
		font-weight: 600;
	}

	.ed.svelte-d9v6bn .ed-drawer-link:where(.svelte-d9v6bn) {
		color: var(--ed-ink);
		font-family: var(--ed-body);
		border-radius: var(--ed-radius);
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}

	.ed.svelte-d9v6bn .ed-drawer-link:where(.svelte-d9v6bn):hover {
		background: var(--ed-canvas);
		color: hsl(var(--primary));
	}

	.ed.svelte-d9v6bn .ed-drawer-link:where(.svelte-d9v6bn) svg {
		color: var(--ed-soft);
		transition: color 0.2s ease;
	}

	.ed.svelte-d9v6bn .ed-drawer-link:where(.svelte-d9v6bn):hover svg {
		color: hsl(var(--primary));
	}

	.ed.svelte-d9v6bn .ed-contact:where(.svelte-d9v6bn) {
		color: var(--ed-soft);
		transition: color 0.2s ease;
	}

	.ed.svelte-d9v6bn .ed-contact:where(.svelte-d9v6bn):hover {
		color: hsl(var(--primary));
	}

	.ed.svelte-d9v6bn .ed-contact:where(.svelte-d9v6bn) svg {

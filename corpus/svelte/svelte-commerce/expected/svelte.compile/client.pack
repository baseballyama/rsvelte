		font-size: 0.82rem !important;
		font-weight: 600;
		letter-spacing: 0.08em;
		transition:
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
			opacity 0.25s ease,
			background 0.25s ease;

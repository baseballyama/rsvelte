		}

		.lime-find-store.svelte-3tnr1h svg {
			width: 13px;
			height: 13px;
		}

		.lime-account.svelte-3tnr1h {
			display: none;
		}

		.lime-header.svelte-3tnr1h {
			grid-template-columns: 1fr auto 1fr;
			height: 52px;
			padding: 8px 14px;
		}

		.lime-mobile-trigger.svelte-3tnr1h {
			display: flex;
			justify-self: start;
			background: transparent;
			border: none;
			padding: 0;
			cursor: pointer;
		}

		.lime-logo.svelte-3tnr1h {
			justify-self: center;
		}

		.lime-logo.svelte-3tnr1h img:where(.svelte-3tnr1h) {
			width: 126px;
		}

		.lime-wordmark.svelte-3tnr1h {
			max-width: 126px;
			font-size: 18px;
		}

		.lime-nav.svelte-3tnr1h {
			display: none;
		}

		.lime-actions.svelte-3tnr1h {
			justify-self: end;
			gap: 12px;
		}
	}


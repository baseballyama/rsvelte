		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(3.2rem, 7.7vw, 7.2rem);
		font-weight: 400;
		line-height: 1.02;
		color: #222;
	}

	.organic-hero-content.svelte-1nhk12g h1:where(.svelte-1nhk12g) span:where(.svelte-1nhk12g):last-child,
	.organic-text-primary.svelte-1nhk12g {
		color: #6bb252;
		font-weight: 800;
	}

	.organic-text-secondary.svelte-1nhk12g {
		color: #ffc43f;
	}

	.organic-hero-content.svelte-1nhk12g p:where(.svelte-1nhk12g) {
		margin: 0;
		max-width: 620px;
		color: #747474;
		font-size: 1.1rem;
		line-height: 1.9;
	}

	.organic-hero-actions.svelte-1nhk12g {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 8px;
	}

	.organic-btn-primary.svelte-1nhk12g,
	.organic-btn-secondary.svelte-1nhk12g {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 30px;
		border-radius: 8px;
		color: #fff;
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		transition: all 0.3s ease;
	}

	.organic-btn-primary.svelte-1nhk12g {
		background: #6bb252;
	}

	.organic-btn-secondary.svelte-1nhk12g {

	.lime-find-store.svelte-3tnr1h {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 7px 16px;
		border-radius: 999px;
		background: var(--lime-plum, #460032);
		color: #fff;
		font-size: 14px;
		line-height: 1;
		white-space: nowrap;
	}


	}

	.lime-header.svelte-3tnr1h {
		position: sticky;
		top: 0;
		z-index: 20;
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr) 156px;
		align-items: center;
		height: 82px;
		padding: 12px 40px;
		background: #fff;
		color: var(--lime-plum, #460032);
		font-family: var(--font-body);

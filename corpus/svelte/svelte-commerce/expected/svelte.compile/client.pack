		height: 100%;
		object-fit: cover;
		display: block;
	}

	.lime-collage-large.svelte-bqnxlw {
		height: 697px;
	}

	.lime-collage-stack.svelte-bqnxlw {
		display: grid;
		grid-template-rows: 332px 330px;
		gap: 35px;
	}

	.lime-split-campaign.svelte-bqnxlw {
		display: grid;
		grid-template-columns: 530fr 801fr;
		gap: 30px;
		padding-top: 60px;
	}

	.lime-split-campaign.svelte-bqnxlw a:where(.svelte-bqnxlw) {
		height: 691px;
	}

	.lime-demand.svelte-bqnxlw {
		display: grid;
		grid-template-columns: 602fr 606fr;
		gap: 64px;
		padding-top: 60px;
	}

	.lime-demand-feature.svelte-bqnxlw {
		position: relative;

	[data-theme='default'] .ed-mf__menu.svelte-l2jkuf {
		background: #efeae1;
		border-right: 1px solid var(--ed-line);
	}

	[data-theme='default'] .ed-mf__tab {
		border-left-color: transparent !important;
		color: var(--ed-soft);
		font-family: var(--ed-body);
	}

	[data-theme='default'] .ed-mf__tab span {
		letter-spacing: 0.14em;
	}

	[data-theme='default'] .ed-mf__content {
		background: var(--ed-surface);
	}

	/* Search inputs */
	[data-theme='default'] .ed-mf__search.svelte-l2jkuf {
		background: var(--ed-canvas);
		border: 1px solid var(--ed-line-strong);
		border-radius: var(--ed-radius);
		color: var(--ed-ink);
		font-family: var(--ed-body);
	}

	[data-theme='default'] .ed-mf__search.svelte-l2jkuf:focus {
		outline: none;
		border-color: hsl(var(--primary));
		box-shadow: none;
	}

	/* Labels + options */
	[data-theme='default'] .ed-mf__label.svelte-l2jkuf {
		font-family: var(--ed-body);
		letter-spacing: 0.18em;
		color: var(--ed-soft);
	}

	[data-theme='default'] .ed-mf__opt.svelte-l2jkuf {
		color: var(--ed-ink);
		font-family: var(--ed-body);
	}

	[data-theme='default'] .ed-mf__priceval.svelte-l2jkuf {
		font-family: var(--ed-display);
		font-weight: 500;
		color: var(--ed-ink);
	}

	/* Editorial checkboxes inside the panel */
	[data-theme='default'] .ed-mf__content [role='checkbox'] {
		border-color: var(--ed-line-strong);
		border-radius: 3px;
		box-shadow: none;
	}

	/* Price range slider */
	[data-theme='default'] .ed-mf__track.svelte-l2jkuf {
		height: 3px;
		background: var(--ed-line);
	}

	[data-theme='default'] .ed-mf__fill.svelte-l2jkuf {
		height: 3px;
		background: hsl(var(--primary));
	}

	[data-theme='default'] .ed-mf__slider input[type='range']::-webkit-slider-thumb {
		border: 1px solid hsl(var(--primary));
		background: var(--ed-surface);
		box-shadow: 0 1px 4px rgba(27, 26, 23, 0.22);
	}

	[data-theme='default'] .ed-mf__slider input[type='range']::-moz-range-thumb {
		border: 1px solid hsl(var(--primary));
		background: var(--ed-surface);
		box-shadow: 0 1px 4px rgba(27, 26, 23, 0.22);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-theme='default'] .ed-mf__apply {
			transition: none;
		}
	}


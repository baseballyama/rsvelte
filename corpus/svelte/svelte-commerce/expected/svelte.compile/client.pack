	$.push($$props, true);

	var fragment = root();

	$.head('h1wdv9', ($$anchor) => {
		$.effect(() => {
			$.document.title = 'Privacy Policy';
		});
	});

	var section = $.first_child(fragment);
	var div = $.child(section);
	var div_1 = $.sibling($.child(div), 2);

	$.html(div_1, () => $$props.data?.page?.content, true);

		}
	}

	.sliding-list.svelte-d9v6bn {
		list-style: none;
		margin: 0;
		padding: 0;
		height: 1.8rem;
		overflow: hidden;
		position: relative;
	}

	.sliding-list.svelte-d9v6bn li:where(.svelte-d9v6bn) {
		height: 1.8rem;
		line-height: 1.8rem;
		position: absolute;
		width: 100%;
		opacity: 0;

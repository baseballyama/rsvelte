	.lime-home.svelte-bqnxlw {
		--plum: var(--lime-plum, #460032);
		--wine: var(--lime-wine, #6f1648);
		--line: var(--lime-line, #d9c6ba);
		background: #fff;
		color: var(--plum);
		font-family: var(--font-body);
	}




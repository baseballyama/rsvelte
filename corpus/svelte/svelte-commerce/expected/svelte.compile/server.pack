			} else {
				$$renderer.push(`<!--[-1-->${$.escape(title)}`);
			}

			$$renderer.push(`<!--]-->`);
		}
	);

	$$renderer.push(` `);

	if (subtitle) {
		$$renderer.push(`<!--[0--><p class="ll-heading-sub svelte-1t1774b">${$.escape(subtitle)}</p>`);
	} else {

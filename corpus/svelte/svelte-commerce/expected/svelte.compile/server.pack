=== 1583 src/lib/theme/ThemeSections.svelte	js
import * as $ from 'svelte/internal/server';
import { SECTIONS } from './sections/index.js';

export default function ThemeSections($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		/**
		 * Renders a theme's homepage from its layout: an ordered list of section types with options,
		 * served by the API. The storefront supplies the section components and the live commerce
		 * data; the theme supplies the order, the settings and the stylesheet.
		 *
		 * An unknown section type is skipped rather than thrown, so a layout authored against a
		 * newer section library degrades to the sections this build knows instead of a blank page.
		 */
		let { layout, ctx } = $$props;

		const sections = $.derived(() => (layout?.sections ?? []).filter((section) => {
			const known = !!SECTIONS[section.type];

			if (!known && typeof console !== 'undefined') {
				console.warn(`[theme] unknown section type "${section.type}" — skipped`);
			}

			return known;
		}));

		$$renderer.push(`<div${$.attr_class(`ts-home ${$.stringify(layout?.rootClass ?? '')}`)}><!--[-->`);

		const each_array = $.ensure_array_like(sections());

		for (let index = 0, $$length = each_array.length; index < $$length; index++) {
			let section = each_array[index];
			const Section = SECTIONS[section.type];

			if (Section) {
				$$renderer.push('<!--[-->');
				Section($$renderer, { ctx, options: section.options ?? {} });
				$$renderer.push('<!--]-->');
			} else {
				$$renderer.push('<!--[!-->');
				$$renderer.push('<!--]-->');
			}
		}

		$$renderer.push(`<!--]--></div>`);
	});
}
=== 18946 src/lib/theme/default/DefaultHomepage.svelte	css

	/* The --ed-* token set (canvas / surface / ink / soft / line / radius / display / body) is
	   declared once, on [data-theme='default'] in src/app.css, and inherited here — this block
	   used to restate it with drifting contents (it omitted --ed-line-strong and added its own
	   --ed-gutter), so the homepage could sit on a stale palette. */
	.ed.svelte-156wvlk {
		background: var(--ed-canvas);
		color: var(--ed-ink);
		font-family: var(--ed-body);
		-webkit-font-smoothing: antialiased;
	}

	/* Same container rail as the header (.page-width) and footer (.ed-foot-inner). */
	.ed-wrap.svelte-156wvlk {
		width: min(var(--container-max, 1240px), 100% - 2 * var(--container-gutter, 32px));
		margin-inline: auto;
	}

	.ed-section.svelte-156wvlk {
		padding-block: clamp(56px, 9vw, 120px);
	}

	.ed-display.svelte-156wvlk {
		font-family: var(--ed-display);
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	.ed-eyebrow.svelte-156wvlk {
		display: inline-block;
		margin-bottom: 14px;
		color: var(--ed-soft);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	/* ---------- HERO ---------- */
	.ed-hero.svelte-156wvlk {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		align-items: center;
		gap: clamp(28px, 5vw, 72px);
		padding-block: clamp(48px, 8vw, 104px);
	}

	.ed-hero__body.svelte-156wvlk {
		max-width: 34rem;
	}

	.ed-hero.svelte-156wvlk h1:where(.svelte-156wvlk) {
		margin: 0;
		font-size: clamp(2.6rem, 5.6vw, 4.9rem);
		line-height: 1.02;
	}

	.ed-hero.svelte-156wvlk h1:where(.svelte-156wvlk) em:where(.svelte-156wvlk) {
		font-style: italic;
		color: hsl(var(--primary));
	}

	.ed-hero__text.svelte-156wvlk {
		max-width: 42ch;
		margin: 22px 0 0;
		color: var(--ed-soft);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.ed-hero__actions.svelte-156wvlk {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px 26px;
		margin-top: 34px;
	}

	.ed-hero__note.svelte-156wvlk {
		margin: 26px 0 0;
		color: var(--ed-soft);
		font-size: 0.82rem;
		letter-spacing: 0.01em;
	}

	.ed-hero__media.svelte-156wvlk {
		position: relative;
		overflow: hidden;
		border-radius: var(--ed-radius);
		aspect-ratio: 4 / 3.4;
		background: #eae5dd;
	}

	.ed-hero__media.svelte-156wvlk img:where(.svelte-156wvlk) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* ---------- HOME PAGE SLIDER (merchant banners from the admin Home page) ---------- */
	/* Full-bleed strip at the banner proportions the admin asks merchants to upload, so
	   artwork with baked-in text survives instead of being cropped to the middle third.
	   The three tiers below mirror BANNER_SIZES and the <picture> breakpoints — change one
	   and you must change all three. */
	.ed-slider.svelte-156wvlk {
		position: relative;
		aspect-ratio: 1500 / 380;
		background: #eae5dd;
	}

	/* Tablet artwork: 1024x320 */
	@media (max-width: 1199px) {
		.ed-slider.svelte-156wvlk {
			aspect-ratio: 1024 / 320;
		}
	}

	/* Mobile artwork: 360x190 */
	@media (max-width: 767px) {
		.ed-slider.svelte-156wvlk {
			aspect-ratio: 360 / 190;
		}
	}

	/* Arrows are pointer affordances: touch devices swipe the track natively, and on a phone
	   they would just cover the artwork. */
	@media (hover: none), (max-width: 767px) {
		.ed-slider__arrow.svelte-156wvlk {
			display: none;
		}
	}

	.ed-slider__track.svelte-156wvlk {
		display: flex;
		height: 100%;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.ed-slider__track.svelte-156wvlk::-webkit-scrollbar {
		display: none;
	}

	.ed-slide.svelte-156wvlk {
		flex: 0 0 100%;
		height: 100%;
		scroll-snap-align: start;
	}

	.ed-slide.svelte-156wvlk picture:where(.svelte-156wvlk),
	.ed-slide.svelte-156wvlk img:where(.svelte-156wvlk) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.ed-slider__arrow.svelte-156wvlk {
		position: absolute;
		top: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		cursor: pointer;
		color: var(--ed-ink);
		background: rgb(255 255 255 / 0.82);
		box-shadow: 0 2px 10px rgb(0 0 0 / 0.14);
		transform: translateY(-50%);
		transition:
			background 0.25s ease,
			box-shadow 0.25s ease;
	}

	.ed-slider__arrow.svelte-156wvlk:hover {
		background: #fff;
		box-shadow: 0 4px 16px rgb(0 0 0 / 0.2);
	}

	.ed-slider__arrow--prev.svelte-156wvlk {
		left: clamp(12px, 2vw, 28px);
	}

	.ed-slider__arrow--next.svelte-156wvlk {
		right: clamp(12px, 2vw, 28px);
	}

	.ed-slider.svelte-156wvlk .ed-slider__arrow-icon {
		width: 20px;
		height: 20px;
	}

	.ed-slider__dots.svelte-156wvlk {
		position: absolute;
		inset: auto 0 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}

	/* Pause/play sits with the dots so the control is where the motion is. */
	.ed-slider__playpause.svelte-156wvlk {
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		margin-left: 4px;
		padding: 0;
		border: 0;
		border-radius: 99px;
		cursor: pointer;
		color: var(--ed-ink);
		background: rgb(255 255 255 / 0.85);
		box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
	}

	.ed-slider.svelte-156wvlk .ed-slider__playpause-icon {
		width: 11px;
		height: 11px;
	}

	.ed-dot.svelte-156wvlk {
		width: 7px;
		height: 7px;
		padding: 0;
		border: 0;
		border-radius: 99px;
		cursor: pointer;
		background: rgb(255 255 255 / 0.6);
		box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
		transition:
			width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
			background 0.35s ease;
	}

	.ed-dot[aria-current='true'].svelte-156wvlk {
		width: 22px;
		background: #fff;
	}

	/* ---------- BUTTONS / LINKS ---------- */
	.ed-btn.svelte-156wvlk {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 52px;
		padding: 0 30px;
		border: 1px solid hsl(var(--primary));
		border-radius: var(--ed-radius);
		background: hsl(var(--primary));
		color: hsl(var(--primary-foreground));
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition:
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
			opacity 0.25s ease;
	}

	.ed-btn.svelte-156wvlk:hover {
		transform: translateY(-2px);
		opacity: 0.92;
	}

	.ed-btn--ghost.svelte-156wvlk {
		background: transparent;
		border-color: var(--ed-ink);
		color: var(--ed-ink);
	}

	.ed-btn--ghost.svelte-156wvlk:hover {
		background: var(--ed-ink);
		color: var(--ed-canvas);
	}

	.ed-link.svelte-156wvlk {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ed-ink);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.ed-link.svelte-156wvlk .ed-link__icon {
		width: 16px;
		height: 16px;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.ed-link.svelte-156wvlk:hover .ed-link__icon {
		transform: translateX(4px);
	}

	/* ---------- RIBBON ---------- */
	.ed-ribbon.svelte-156wvlk {
		border-block: 1px solid var(--ed-line);
		background: var(--ed-surface);
	}

	.ed-ribbon__row.svelte-156wvlk {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 14px 22px;
		padding-block: 16px;
		color: var(--ed-soft);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.ed-ribbon__dot.svelte-156wvlk {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: hsl(var(--primary));
	}

	/* ---------- SECTION HEADERS ---------- */
	.ed-head.svelte-156wvlk {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: clamp(28px, 4vw, 52px);
	}

	.ed-head__title.svelte-156wvlk {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.2rem);
		line-height: 1.05;
	}

	.ed-tint.svelte-156wvlk {
		background: var(--ed-surface);
	}

	/* ---------- CATEGORY TILES ---------- */
	.ed-cats.svelte-156wvlk {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(14px, 1.6vw, 22px);
	}

	.ed-cat.svelte-156wvlk {
		display: block;
		color: var(--ed-ink);
	}

	.ed-cat__media.svelte-156wvlk {
		overflow: hidden;
		border-radius: var(--ed-radius);
		aspect-ratio: 4 / 5;
		background: #eae5dd;
	}

	.ed-cat__media.svelte-156wvlk img:where(.svelte-156wvlk),
	.ed-cat__placeholder.svelte-156wvlk {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.ed-cat__placeholder.svelte-156wvlk {
		background: linear-gradient(160deg, #efe9e0, #e3dcd1);
	}

	.ed-cat.svelte-156wvlk:hover .ed-cat__media:where(.svelte-156wvlk) img:where(.svelte-156wvlk),
	.ed-cat.svelte-156wvlk:hover .ed-cat__placeholder:where(.svelte-156wvlk) {
		transform: scale(1.05);
	}

	.ed-cat__label.svelte-156wvlk {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-top: 14px;
		font-size: 0.95rem;
		font-weight: 600;
	}

	.ed-cat.svelte-156wvlk .ed-cat__icon {
		width: 16px;
		height: 16px;
		color: var(--ed-soft);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.ed-cat.svelte-156wvlk:hover .ed-cat__icon {
		transform: translate(3px, -3px);
		color: hsl(var(--primary));
	}

	/* ---------- HOME PAGE GRIDS (merchant sections from the admin Home page) ---------- */
	.ed-bands.svelte-156wvlk {
		display: grid;
		gap: clamp(36px, 5vw, 64px);
	}

	.ed-band__grid.svelte-156wvlk {
		display: grid;
		grid-template-columns: repeat(var(--ed-band-cols, 2), minmax(0, 1fr));
		gap: clamp(10px, 1.4vw, 18px);
	}

	/* Horizontal scroll row: the tiles keep their grid width so both layouts read alike. */
	.ed-band__grid--carousel.svelte-156wvlk {
		display: flex;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x proximity;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.ed-band__grid--carousel.svelte-156wvlk::-webkit-scrollbar {
		display: none;
	}

	.ed-band__grid--carousel.svelte-156wvlk .ed-band__item:where(.svelte-156wvlk) {
		flex: 0 0 calc((100% - (var(--ed-band-cols, 2) - 1) * 14px) / var(--ed-band-cols, 2));
		scroll-snap-align: start;
	}

	.ed-band__item.svelte-156wvlk {
		display: block;
		color: var(--ed-ink);
	}

	.ed-band__media.svelte-156wvlk {
		overflow: hidden;
		border-radius: var(--ed-radius);

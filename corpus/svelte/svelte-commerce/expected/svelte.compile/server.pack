	.noor-card-media.svelte-2y8o17 {
		position: relative;
		display: block;
		overflow: hidden;
		background: #f6f2ec;
	}

	.noor-card-media.svelte-2y8o17 img:where(.svelte-2y8o17) {
		display: block;

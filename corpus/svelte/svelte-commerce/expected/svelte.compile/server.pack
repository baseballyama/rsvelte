			width: calc(100% - 2 * var(--container-gutter, 14px));
		}

		.lime-collage.svelte-bqnxlw,
		.lime-split-campaign.svelte-bqnxlw,
		.lime-demand.svelte-bqnxlw,
		.lime-story.svelte-bqnxlw,
		.lime-store.svelte-bqnxlw {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.lime-collage-large.svelte-bqnxlw,
		.lime-collage-stack.svelte-bqnxlw a:where(.svelte-bqnxlw),
		.lime-split-campaign.svelte-bqnxlw a:where(.svelte-bqnxlw),
		.lime-demand-feature.svelte-bqnxlw,
		.lime-story.svelte-bqnxlw img:where(.svelte-bqnxlw),
		.lime-store.svelte-bqnxlw img:where(.svelte-bqnxlw) {
			height: auto;
		}

		.lime-collage-stack.svelte-bqnxlw {

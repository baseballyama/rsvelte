				}

				$$renderer.push(`<!--]--></span> <span class="font-semibold edp-opt-value">${$.escape(productState.selectedVariant?.options?.find((opt) => option.id === opt.optionId)?.value)}</span></div> `);

				if (option.type === 'Size') {
					$$renderer.push('<!--[0-->');
					SizeGuideDrawer($$renderer, {});
				} else {
					$$renderer.push('<!--[-1-->');

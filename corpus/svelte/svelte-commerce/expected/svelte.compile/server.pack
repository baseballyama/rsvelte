	}

	.ed.svelte-d9v6bn .ed-drawer-link:where(.svelte-d9v6bn):hover {
		background: var(--ed-canvas);
		color: hsl(var(--primary));
	}

	.ed.svelte-d9v6bn .ed-drawer-link:where(.svelte-d9v6bn) svg {
		color: var(--ed-soft);
		transition: color 0.2s ease;

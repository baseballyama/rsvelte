		.noor-nav.svelte-loucq3 {
			justify-content: flex-start;
			gap: 22px;
			overflow-x: auto;
			padding: 12px 16px;
			scrollbar-width: none;
		}

		.noor-nav.svelte-loucq3::-webkit-scrollbar {
			display: none;

						$$renderer.push(`<span class="text-sm font-bold uppercase tracking-widest">More about ${$.escape(storeData()?.name)}</span> `);

						ChevronDown($$renderer, {
							size: 20,
							class: `transition-transform duration-300 ${isExpanded ? 'rotate-180' : ''}`
						});

						$$renderer.push(`<!---->`);

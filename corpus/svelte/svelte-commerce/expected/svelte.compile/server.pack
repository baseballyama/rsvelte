					$$renderer.push(`<div class="relative pl-8 sm:pl-10"><div class="absolute left-[18px] top-2 box-content h-[9px] w-[9px] -translate-x-[50%] rounded-full border-[3px] border-white bg-[#515151]"></div> `);

					if ('avatar' in item) {

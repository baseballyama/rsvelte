			padding-bottom: 8px;
			scroll-snap-type: x mandatory;
		}

		.lime-category.svelte-bqnxlw {
			flex: 0 0 138px;
			scroll-snap-align: start;
		}

		.lime-category.svelte-bqnxlw h3:where(.svelte-bqnxlw) {

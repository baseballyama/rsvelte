				CollectionGrid($$renderer, { block });
			} else {
				$$renderer.push('<!--[-1-->');
			}

			$$renderer.push(`<!--]--></div>`);
		}

		$$renderer.push(`<!--]--></section>`);
	}

	$$renderer.push(`<!--]-->`);
}

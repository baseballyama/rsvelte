		const tiles = $.derived(() => resolveTiles(ctx, options));
		const caption = $.derived(() => options.caption ?? 'overlay');
		const hasHeading = $.derived(() => !!(options.heading && Object.keys(options.heading).length));

		function tileMarkup($$renderer, tile) {
			if (tile.href) {

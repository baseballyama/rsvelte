			Button($$renderer, {
				onclick: () => goto('/'),
				variant: 'default',
				class: 'bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-700 hover:to-pink-600',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Continue Shopping`);
				},
				$$slots: { default: true }
			});


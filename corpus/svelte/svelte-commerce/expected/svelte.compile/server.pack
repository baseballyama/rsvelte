		font-family: var(--font-heading);
		font-size: 38px;
		text-align: center;
	}

	.lime-product-grid.svelte-bqnxlw {
		display: flex;
		gap: 30px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-bottom: 20px;
		-ms-overflow-style: none; /* IE and Edge */
		scrollbar-width: none; /* Firefox */
	}


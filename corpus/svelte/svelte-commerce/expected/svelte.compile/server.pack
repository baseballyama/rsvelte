		}

		.lime-store.svelte-bqnxlw > div:where(.svelte-bqnxlw) {
			order: 2;
		}

		.lime-store.svelte-bqnxlw > img:where(.svelte-bqnxlw) {
			order: 1;
		}

		.lime-story.svelte-bqnxlw p:where(.svelte-bqnxlw),

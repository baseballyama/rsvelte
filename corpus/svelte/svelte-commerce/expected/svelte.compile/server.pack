	.lime-faq.svelte-bqnxlw details:where(.svelte-bqnxlw) p:where(.svelte-bqnxlw) {
		max-width: 1120px;
		padding-bottom: 22px;
		font-size: 14px;
		line-height: 25px;
	}

	@media (max-width: 900px) {
		.lime-hero.svelte-bqnxlw {
			height: 506px;
		}

		.lime-hero.svelte-bqnxlw img:where(.svelte-bqnxlw) {

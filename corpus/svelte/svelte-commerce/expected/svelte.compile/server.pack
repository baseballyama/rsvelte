					}

					$$renderer.push(`<!--]-->`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----></div>`);
		}

		$$renderer.push(`<!--]--></div> `);
		wishlistButton($$renderer);
		$$renderer.push(`<!----></div>`);
	});
}

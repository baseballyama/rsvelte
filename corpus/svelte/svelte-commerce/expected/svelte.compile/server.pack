						Mail($$renderer, { class: 'h-3.5 w-3.5 text-muted-foreground' });
						$$renderer.push(`<!----> <span class="truncate svelte-d9v6bn">${$.escape(page?.data?.store?.businessEmail)}</span></a>`);

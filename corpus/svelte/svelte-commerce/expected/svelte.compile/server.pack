		gap: 70px;
		align-items: center;
		padding-top: 72px;
	}

	.lime-story.svelte-bqnxlw img:where(.svelte-bqnxlw) {
		height: 443px;
	}

	.lime-story.svelte-bqnxlw h2:where(.svelte-bqnxlw),

	Carousel($$renderer, {
		opts: { align: 'center', loop: true, dragFree: true },
		class: 'mx-auto w-full py-10 sm:w-[90%] laptop:w-[80%]',
		children: ($$renderer) => {
			CarouselContent($$renderer, {
				class: '-ml-1',
				children: ($$renderer) => {

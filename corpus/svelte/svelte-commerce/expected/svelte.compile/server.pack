						$$renderer.push(`<!--]--></div>`);
					} else {
						$$renderer.push('<!--[-1-->');
					}

					$$renderer.push(`<!--]--></div></section>`);
				}

				ProductCardRenderer($$renderer, { product, aspectRatio, content, $$slots: { content: true } });

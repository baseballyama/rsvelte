		const getStatusStyles = (status) => {
			switch (status?.toLowerCase()) {
				case 'delivered':
					return {
						bg: 'bg-green-50',
						text: 'text-green-700',
						ring: 'ring-green-600/20',
						dot: 'bg-green-500',
						icon: CheckCircle2

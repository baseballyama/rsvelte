					: 'border-gray-200')))}>2</div> <span${$.attr_class(`ml-2 text-xs font-bold uppercase tracking-widest ${step === 2 ? '' : 'hidden sm:inline'}`)}>Address</span>`);
			},
			$$slots: { default: true }

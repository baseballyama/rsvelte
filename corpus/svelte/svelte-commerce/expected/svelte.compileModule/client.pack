/* collection.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { getContext, onMount, setContext } from 'svelte';
import { collectionService } from '$lib/core/services/index.js';

class CollectionState {
	static instance = null;
	#loading = $.state(false);

	get loading() {
		return $.get(this.#loading);
	}

	set loading(value) {
		$.set(this.#loading, value, true);
	}

	#count = $.state(0);

	get count() {
		return $.get(this.#count);
	}

	set count(value) {
		$.set(this.#count, value, true);
	}

	#collections = $.state(null);

	get collections() {
		return $.get(this.#collections);
	}

	set collections(value) {
		$.set(this.#collections, value, true);
	}

	constructor() {
		onMount(() => {
			this.setState();
		});
	}

	setState = async () => {
		try {
			this.loading = true;
			this.count = 0;

			const res = await collectionService.list({});

			this.count = res?.data?.length;
			this.collections = res?.data;
		} catch(e) {
			console.error('While fetching collection', e);
		} finally {
			this.loading = false;
		}
	};

	getOneById = (id) => {
		return this.collections?.find((x) => x.id === id);
	};

	// `rank` is a varchar column on product_collections, not a number.
	getOneByRank = (rank) => {
		return this.collections?.find((x) => x.rank === rank);
	};
}

const COLLECTION_KEY = Symbol('COLLECTION');

export function setCollectionState() {
	return setContext(COLLECTION_KEY, new CollectionState());
}

export function getCollectionState() {
	return getContext(COLLECTION_KEY);
}

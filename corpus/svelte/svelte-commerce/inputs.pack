						<Skeleton class="h-5 w-5" />
						<Skeleton class="h-5 w-5" />
						<Skeleton class="h-5 w-5" />
						<Skeleton class="h-5 w-5" />
					</div>
				</div>
				<Skeleton class="h-12 w-32" />
			</div>
		</div>

		<div class="mb-5 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
			{#each Array(10) as _}
				<div class="space-y-3">

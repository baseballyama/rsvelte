	}

	.lime-demand {
		display: grid;
		grid-template-columns: 602fr 606fr;
		gap: 64px;
		padding-top: 60px;
	}

	.lime-demand-feature {
		position: relative;
		height: 685px;
	}

	.lime-demand-feature span {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 52px;

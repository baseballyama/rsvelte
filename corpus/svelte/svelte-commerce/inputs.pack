	.lime-trust-item :global(svg) {
		width: 22px;
		height: 22px;
		flex: none;
		stroke-width: 1.4;
	}

	.lime-story {
		display: grid;
		grid-template-columns: 600px minmax(0, 1fr);
		gap: 70px;
		align-items: center;
		padding-top: 72px;
	}


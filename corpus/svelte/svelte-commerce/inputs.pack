	import { DropdownMenu as DropdownMenuPrimitive, type WithoutChild } from 'bits-ui'
	import { Check, Minus } from '@lucide/svelte'
	import { cn } from '$lib/core/utils'

	let {
		ref = $bindable(null),
		class: className,
		children: childrenProp,
		checked = $bindable(false),

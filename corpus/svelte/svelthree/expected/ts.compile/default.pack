=== 4015 src/lib/utils/GLTF_utils.ts	js
export default class GLTF_utils {
    /** Get an array of references to all **Meshes** (_all scenes_) inside the loaded GLTF content. */
    static async get_all_meshes(content) {
        const found_meshes = [];
        const is_foo = "isMesh";
        if (content) {
            if (content.scenes?.length > 1) {
                for (let i = 0; i < content.scenes.length; i++) {
                    await GLTF_utils.get_all(content.scenes[i], found_meshes, is_foo);
                }
            }
            else {
                await GLTF_utils.get_all(content.scene, found_meshes, is_foo);
            }
        }
        else {
            console.error("SVELTHREE > GLTF_utils > async 'get_all_meshes(content)' -> 'content' not available!", {
                content
            });
        }
        return found_meshes;
    }
    /** Get an array of references to all **Meshes** in a specific scene inside the loaded GLTF content. */
    static async get_all_scene_meshes(scene) {
        const found_meshes = [];
        if (scene) {
            const is_foo = "isMesh";
            await GLTF_utils.get_all(scene, found_meshes, is_foo);
        }
        else {
            console.error("SVELTHREE > GLTF_utils > async 'get_all_scene_meshes(scene)' -> 'scene' not available!", {
                scene
            });
        }
        return found_meshes;
    }
    /** Get an array of references to all **Lights** (_all scenes_) inside the loaded GLTF content. */
    static async get_all_lights(content) {
        const found_lights = [];
        const is_foo = "isLight";
        if (content) {
            if (content.scenes?.length > 1) {
                for (let i = 0; i < content.scenes.length; i++) {
                    await GLTF_utils.get_all(content.scenes[i], found_lights, is_foo);
                }
            }
            else {
                await GLTF_utils.get_all(content.scene, found_lights, is_foo);
            }
        }
        else {
            console.error("SVELTHREE > GLTF_utils > async 'get_all_lights(content)' -> 'content' not available!", {
                content
            });
        }
        return found_lights;
    }
    /** Get an array of references to all **Lights** in a specific scene inside the loaded GLTF content. */
    static async get_all_scene_lights(scene) {
        const found_lights = [];
        if (scene) {
            const is_foo = "isLight";
            await GLTF_utils.get_all(scene, found_lights, is_foo);
        }
        else {
            console.error("SVELTHREE > GLTF_utils > async 'get_all_scene_lights(scene)' -> 'scene' not available!", {
                scene
            });
        }
        return found_lights;
    }
    /** [ _**internal utility**_ ] Get all references of a specific type from a scene. */
    static async get_all(scene, found, is_foo) {
        //console.log(`get_all_of_type - ${check} - started!`)
        if (scene) {
            const fns = [];
            const check_obj = (obj, is_foo, depot) => async () => {
                if (obj) {
                    if (Object.hasOwn(obj, is_foo))
                        depot.push(obj);
                }
                else {
                    console.error("SVELTHREE > GLTF_utils > async 'get_all(scene, ...)' -> async check_obj(obj, ...) -> 'obj' not available!", { obj });
                }
            };
            const traverse = (child) => {
                fns.push(check_obj(child, is_foo, found));
                const children = child.children;
                for (let i = 0, l = children.length; i < l; i++) {
                    traverse(children[i]);
                }
            };
            traverse(scene);
            for (const fn of fns) {
                await fn();
            }
        }
        else {
            console.error("SVELTHREE > GLTF_utils > async 'get_all(scene, ...)' -> 'scene' not available!", { scene });
        }
        //console.log(`get_all_of_type - ${check} - finished!`)
    }
}

=== 32631 src/lib/utils/PropUtils.ts	js
import { Color, Euler, Matrix4, Quaternion, Vector2, Vector3 } from "three";
import { verbose_mode, log_prop_utils } from "../utils/SvelthreeLogger.js";
/**
 * Collection of static utility methods which allow setting props to various values.
 * `PropUtils` are being used by:
 * - component's props directly / on change of component's attributes (reactive)
 * - `SvelthreeProps` (`sProps`) via `Propeller`
 */
export default class PropUtils {
    static verbose = verbose_mode();
    static getShortHandAttrWarnings(prefix) {
        const warnings = {
            rot: `${prefix} 'rot' attribute ignored! : overridden by either 'matrix' or 'quat' attribute!`,
            pos: `${prefix} 'pos' attribute ignored! : overridden by 'matrix' attribute!`,
            quat: `${prefix} 'quat' attribute ignored! : overridden by 'matrix' attribute!`,
            scale: `${prefix} 'scale' attribute ignored! : overridden by 'matrix' attribute!`,
            lookAt: `${prefix} 'lookAt' attribute ignored! : overridden by 'matrix' attribute!`
        };
        return warnings;
    }
    static warn(message) {
        console.warn(message);
    }
    /** Check if an Array contains exactly 2 numbers. */
    static is2Nums(p) {
        return p.length === 2 && p.every((el) => !isNaN(el));
    }
    static isArray2Nums(p) {
        return Array.isArray(p) && PropUtils.is2Nums(p);
    }
    static isArray3Nums(p) {
        return Array.isArray(p) && PropUtils.is3Nums(p);
    }
    /** Check if an Array contains exactly 3 numbers. */
    static is3Nums(p) {
        return p.length === 3 && p.every((el) => !isNaN(el));
    }
    static isMatrix4ParamsArray(p) {
        return Array.isArray(p) && p.length === 16 && p.every((el) => !isNaN(el));
    }
    /** Check if an Array contains exactly 16 numbers. */
    static isMatrix4Params(p) {
        return p.length === 16 && p.every((el) => !isNaN(el));
    }
    static isEulerParamsArray(p) {
        return (Array.isArray(p) &&
            p.length === 4 &&
            !isNaN(p[0]) &&
            !isNaN(p[1]) &&
            !isNaN(p[2]) &&
            typeof p[3] === "string");
    }
    /** Check if an Array contains exactly three numbers and one string. */
    static isEulerParams(p) {
        return (p.length === 4 &&
            !isNaN(p[0]) &&
            !isNaN(p[1]) &&
            !isNaN(p[2]) &&
            typeof p[3] === "string");
    }
    static isQuaternionParamsArray(p) {
        return Array.isArray(p) && p.length === 4 && p.every((el) => !isNaN(el));
    }
    /** Check if an Array contains exactly 4 numbers. */
    static isQuaternionParams(p) {
        return p.length === 4 && p.every((el) => !isNaN(el));
    }
    static checkIfComplexValueType(val) {
        if (Array.isArray(val)) {
            if (PropUtils.is2Nums(val))
                return "Array2Nums";
            if (PropUtils.is3Nums(val))
                return "Array3Nums";
            if (PropUtils.isEulerParams(val))
                return "EulerParamsArray";
            if (PropUtils.isQuaternionParams(val))
                return "QuaternionParamsArray";
            if (PropUtils.isMatrix4Params(val))
                return "Matrix4ParamsArray";
        }
        else if (val) {
            if (val.isVector2)
                return "Vector2";
            if (val.isVector3)
                return "Vector3";
            if (val.isColor)
                return "Color";
            if (val.isEuler)
                return "Euler";
            if (val.isQuaternion)
                return "Quaternion";
            if (val["isMatrix4"])
                return "Matrix4";
        }
        return undefined;
    }
    static setRotationFromValue(obj, val, complex) {
        switch (complex) {
            case undefined:
                if (val && Array.isArray(val)) {
                    PropUtils.is3Nums(val)
                        ? PropUtils.setRotArray3(obj, val)
                        : PropUtils.isEulerParams(val)
                            ? PropUtils.setRotEulerArray(obj, val)
                            : PropUtils.isQuaternionParams(val)
                                ? PropUtils.setRotQuaternionArray(obj, val)
                                : console.error("SVELTHREE > [ PropUtils ] -> setRotationFromValue : invalid 'rotation' value!", {
                                    obj: obj,
                                    value: val
                                });
                }
                else if (val) {
                    ;
                    val.isEuler
                        ? PropUtils.setRotEuler(obj, val)
                        : val.isVector3
                            ? PropUtils.setRotVector3(obj, val)
                            : val.isQuaternion
                                ? PropUtils.setRotQuaternion(obj, val)
                                : console.error("SVELTHREE > [ PropUtils ] -> setRotationFromValue : invalid 'rotation' value!", {
                                    obj: obj,
                                    value: val
                                });
                }
                else {
                    console.error("SVELTHREE > [ PropUtils ] -> setRotationFromValue : invalid 'rotation' value!", {
                        obj: obj,
                        value: val
                    });
                }
                break;
            case "Euler":
                PropUtils.setRotEuler(obj, val);
                break;
            case "EulerParamsArray":
                PropUtils.setRotEulerArray(obj, val);
                break;
            case "Vector3":
                PropUtils.setRotVector3(obj, val);
                break;
            case "Array3Nums":
                PropUtils.setRotArray3(obj, val);
                break;
            case "Quaternion":
                PropUtils.setRotQuaternion(obj, val);
                break;
            case "QuaternionParamsArray":
                PropUtils.setRotQuaternionArray(obj, val);
                break;
            default:
                console.error("SVELTHREE > [ PropUtils ] -> setRotationFromValue : invalid 'rotation' value! No such 'ComplexValueType'!", {
                    obj: obj,
                    value: val,
                    complex: complex
                });
                break;
        }

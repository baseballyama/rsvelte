=== 466 src/lib/logic/shared/find.ts	js
/** Search in all scenes (_direct children of canvas_) for an instance with the specified `uuid` */
const find_in_canvas = (scenes_array, uuid) => {
    if (scenes_array) {
        for (let i = 0; i < scenes_array.length; i++) {
            const scene = scenes_array[i].scene;
            const found = scene.getObjectByProperty("uuid", uuid);
            if (found)
                return found;
        }
    }
    return undefined;
};
export { find_in_canvas };


                        Propeller.update(this.obj, this.obj_type, k, props[k], origin);
                        this.updatedKeys.push(k);
                    }
                }
                else {
                    console.warn(`SVELTHREE > SvelthreeProps > resetAndMap : unknown property '${k}' in 'props' object -> not available for '${this.obj_type}'`);

                if (obj) {
                    if (Object.hasOwn(obj, typ)) {
                        // see https://github.com/mrdoob/three.js/blob/1a241ef10048770d56e06d6cd6a64c76cc720f95/src/core/Object3D.js#L342-L369
                        if (parent) {
                            const index_to_remove = parent.children.indexOf(obj);

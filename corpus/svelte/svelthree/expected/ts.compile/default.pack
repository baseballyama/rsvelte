            case value:
                // same object, perform deep check
                if (this.prevValues) {
                    for (let i = 0; i < 3; i++) {
                        if (not_equal(this.prevValues[i], value[i])) {
                            Propeller.update(obj, this.obj_type, this.key, value, this.origin, "Array3Nums");
                            this.prevValues = [value[0], value[1], value[2]];

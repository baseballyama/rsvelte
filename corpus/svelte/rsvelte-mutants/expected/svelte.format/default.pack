  {#each actions as action, i}
    {@const previousAction = i === 0 ? undo : actions[i - 1]}
    <Action do={$state(action)} undo={previousAction} />
  {/each}
{:else}
  <div bind:this={el} class="fragment hidden" data-fragment-index={order}></div>

	import { SvelteGantt, SvelteGanttTable, SvelteGanttExternal } from 'svelte-gantt/svelte';
	import { defaultOptions, time } from '$lib';
	import { onMount } from 'svelte';

	let element;
	let gantt;
	let tasks = [];

	onMount(() => {

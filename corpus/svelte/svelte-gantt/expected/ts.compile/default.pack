        // you know those issues when task gets rounded incorrectly on resize? could be the cause
        // ....or not really, this issue results in task resizing when task is merely dragged
        if (triggered && options.onDrop) {
            options.onDrop({
                mouseEvent: event,
                x,
                y,
                width,
                dragging: dragging,
                resizing: resizing

export function getPositionByDate(date, from, to, width) {
    if (!date) {
        return undefined;
    }
    const durationTo = date - from;
    const durationToEnd = to - from;
    return (durationTo / durationToEnd) * width;
}
export function getDateByPosition(x, from, to, width) {

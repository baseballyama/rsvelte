                //resize right
                if (mousePos.x - x <= 0) {
                    direction = 'left';
                    resultX = mousePos.x;
                    resultWidth = mousePos.x - x;
                    mouseStartRight = x;
                }
                else {
                    resultX = x;
                    resultWidth = mousePos.x - x;
                }
            }
            if (options.onResize) {
                options.onResize({
                    x: resultX,
                    width: resultWidth,

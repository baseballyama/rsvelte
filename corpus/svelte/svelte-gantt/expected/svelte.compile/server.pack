    button.svelte-poj9ve, input[type=button].svelte-poj9ve{
        border: transparent;
        font-size: 14px;
        font-weight: 300;
        padding: 6px 12px;
        background: #cc595e;
        color: #ffffff;
        cursor: pointer;
        transition: background 0.2s;
        outline: none;
    }
    
    button.svelte-poj9ve:hover, input[type=button].svelte-poj9ve:hover {
        background-color: #b14d51;
    }
    
    button.svelte-poj9ve:active, input[type=button].svelte-poj9ve:active{
        background-color: #9d4548;
    }
    

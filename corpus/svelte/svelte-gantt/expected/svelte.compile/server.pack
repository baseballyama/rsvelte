				},

				elementContent: () => {
					const element = document.createElement('div');

					element.innerHTML = 'New Task';
					element.className = 'sg-external-indicator';

					return element;
				}
			});
		});

		function onChangeOptions(event) {
			const opts = event.detail;

			Object.assign(options, opts);
			gantt.$set(options);

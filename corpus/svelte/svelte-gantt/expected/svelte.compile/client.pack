					children: [{ id: 11, label: 'Child 1' }, { id: 12, label: 'Child 2' }]
				},

				{
					id: 2,
					label: 'Parent 2',
					expanded: true,
					children: [
						{
							id: 21,
							label: 'Child 1',
							children: [{ id: 211, label: 'Grandchild 1' }]
						},
						{ id: 22, label: 'Child 2' },
						{ id: 23, label: 'Child 3' }
					]
				},
				{ id: 3, label: 'No children' }
			],

			get ganttTableModules() {
				return $.get($2);
			}
		});
	}

	$.reset(div);
	$.append($$anchor, div);
	$.pop();
}

        <div>Hello</div>
        <div>{@html foo}{@debug foo}</div>
      `;
			const messages = (await linter.lintText(code, { filePath: 'test.svelte' }))[0].messages;

			assert.strictEqual(messages.length, 4);

			assert.strictEqual(messages[0].ruleId, 'svelte/comment-directive');
			assert.strictEqual(

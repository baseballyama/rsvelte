		it('dont report used <!-- eslint-disable-next-line svelte/no-at-debug-tags, svelte/no-at-html-tags -->', async () => {
			const code = `
        <!-- eslint-disable-next-line svelte/no-at-debug-tags, svelte/no-at-html-tags -->

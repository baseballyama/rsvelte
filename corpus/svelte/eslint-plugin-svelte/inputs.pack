				'Nested `<style>` elements are not scoped and may lead to unintended styles being applied.'
		},
		type: 'problem'
	},
	create(context) {
		return {
			SvelteElement(node) {
				if (node.kind !== 'html' || node.name.type !== 'SvelteName' || node.name.name !== 'style') {
					return;
				}
				context.report({ node, messageId: 'nestedStyle' });

			assert.strictEqual(messages[0].line, 5);
			assert.strictEqual(messages[0].column, 9);
		});

		it('report unused <!-- eslint-disable svelte/no-at-debug-tags, svelte/no-at-html-tags -->', async () => {
			const code = `

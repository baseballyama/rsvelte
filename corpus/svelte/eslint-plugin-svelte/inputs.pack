			const prevToken = sourceCode.getTokenBefore(target);
			const nextToken = sourceCode.getTokenAfter(target);
			if (
				prevToken &&
				isOpeningParenToken(prevToken) &&
				nextToken &&
				isClosingParenToken(nextToken)

		});

		it("don't disable rules if <!-- eslint-disable-next-line --> is on another line", async () => {
			const code = `
      <!-- eslint-disable-next-line -->

      {@html a+b} <!-- eslint-disable-next-line -->
      <!-- eslint-disable-next-line -->
      `;
			const result = await linter.lintText(code, { filePath: 'test.svelte' });

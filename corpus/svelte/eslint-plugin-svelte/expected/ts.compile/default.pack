        cp.execSync('code -v', { stdio: 'ignore' });
        cp.execSync(`code "${fileURLToPath(ruleFileURL)}"`);
        cp.execSync(`code "${fileURLToPath(testFileURL)}"`);
        cp.execSync(`code "${fileURLToPath(docFileURL)}"`);

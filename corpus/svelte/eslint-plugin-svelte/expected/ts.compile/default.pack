        if (langAttribute) {
            return {
                desc: `Replace a <${tagName}> block with the lang attribute set to "${lang}".`,
                fix: (fixer) => {
                    return fixer.replaceText(langAttribute, langAttributeText.trim());
                }
            };
        }

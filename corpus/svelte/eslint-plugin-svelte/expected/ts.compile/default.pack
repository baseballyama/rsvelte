import { createRule } from '../utils/index.js';
export default createRule('no-export-load-in-svelte-module-in-kit-pages', {
    meta: {
        docs: {
            description: 'disallow exporting load functions in `*.svelte` module in SvelteKit page components.',
            category: 'SvelteKit',

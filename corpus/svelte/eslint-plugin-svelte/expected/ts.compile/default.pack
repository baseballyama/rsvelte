import { createRule } from '../utils/index.js';
import { equalTokens } from '../utils/ast-utils.js';
export default createRule('no-dupe-on-directives', {
    meta: {
        docs: {
            description: 'disallow duplicate `on:` directives',
            category: 'Possible Errors',
            recommended: true

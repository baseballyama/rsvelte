        return {
            SvelteShorthandAttribute(node) {
                if (node.key.name !== 'style') {
                    return;
                }
                context.report({
                    node,
                    messageId: 'shorthand'
                });
            },
            SvelteAttribute(node) {
                if (node.key.name !== 'style' || !node.value?.length) {
                    return;
                }
                const root = parseStyleAttributeValue(node, context);

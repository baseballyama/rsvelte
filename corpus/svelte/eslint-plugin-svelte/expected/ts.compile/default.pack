const TYPE_MESSAGES = {
    normal: 'HTML elements',
    void: 'HTML void elements',
    svg: 'SVG elements',
    math: 'MathML elements',
    component: 'Svelte custom components',
    svelte: 'Svelte special elements'
};
export default createRule('html-self-closing', {
    meta: {

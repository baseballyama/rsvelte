                    if (child.type === 'decl') {
                        if (child.unknownInterpolations.length) {
                            context.report({
                                node,
                                loc: child.loc,
                                messageId: 'complex'
                            });
                        }
                        else if (child.prop.interpolations.length) {
                            context.report({
                                node,
                                loc: child.prop.loc,
                                messageId: 'interpolationKey'
                            });
                        }
                    }
                    else if (child.type === 'comment') {
                        context.report({
                            node,
                            loc: child.loc,
                            messageId: 'comment'
                        });
                    }
                    else {
                        context.report({
                            node,
                            loc: child.loc,
                            messageId: 'complex'
                        });
                    }
                }
            }
        };
    }
});


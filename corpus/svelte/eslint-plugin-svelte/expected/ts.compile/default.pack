            },
            {
                svelteVersions: ['5']
            }
        ]), true);
    });
    it('or false', () => {
        assert.strictEqual(shouldRun(actualSvelteKit, [
            {
                svelteKitFileTypes: ['+page.[js|ts]']
            },
            {
                svelteKitFileTypes: ['+page.server.[js|ts]']
            }

import { parseStyleAttributeValue } from '../utils/css-utils/index.js';
export default createRule('no-dupe-style-properties', {
    meta: {
        docs: {
            description: 'disallow duplicate style properties',
            category: 'Possible Errors',
            recommended: true
        },
        schema: [],

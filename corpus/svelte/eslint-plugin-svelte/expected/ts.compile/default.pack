                            reference.identifier.range[1] <= node.key.range[1]) {
                            // A variable is used in the key.
                            return;
                        }
                    }
                }
                context.report({
                    node: node.key,
                    messageId: 'keyUseEachVars'
                });
            }
        };
    }
});


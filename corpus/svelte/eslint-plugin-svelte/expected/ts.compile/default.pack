            {
                svelteVersions: ['3/4']
            }
        ]), true);
    });
    it('real - Svelte5 with runes', () => {
        assert.strictEqual(shouldRun(actualSvelte5, [
            {
                svelteVersions: ['5'],
                svelteFileTypes: ['.svelte'],
                runes: [true]
            }
        ]), true);
    });
    it('real - Svelte5 without runes', () => {
        assert.strictEqual(shouldRun(actualSvelte5, [
            {
                svelteVersions: ['5'],
                svelteFileTypes: ['.svelte'],
                runes: [false]
            }
        ]), false);
    });

            // </script>
            'Program > SvelteScriptElement:exit': () => {
                isScript = false;
            },
            // Svelte3,4
            'ExportNamedDeclaration > VariableDeclaration > VariableDeclarator': (node) => {
                if (!isScript)
                    return;
                // export let foo
                if (node.id.type === 'Identifier') {
                    if (!LEGACY_PAGE_PROP_NAMES.includes(node.id.name)) {
                        context.report({
                            node,
                            loc: node.loc,
                            messageId: 'unexpected'

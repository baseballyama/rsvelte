import { createRule } from '../utils/index.js';
export default createRule('no-nested-style-tag', {
    meta: {
        docs: {
            description: 'disallow `<style>` elements nested inside other elements or blocks',
            category: 'Possible Errors',
            recommended: false
        },
        schema: [],

		$$renderer.push(`<!--]--> <form method="POST"><textarea>`);

		const $$body = $.escape(comment);

		if ($$body) {
			$$renderer.push(`${$$body}`);
		} else {}

		$$renderer.push(`</textarea> <button>Post comment</button></form>`);
		$.bind_props($$props, { snapshot });
	});
}

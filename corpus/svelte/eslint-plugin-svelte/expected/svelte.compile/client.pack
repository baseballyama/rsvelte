import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { value } from "package";

var root = $.from_html(`<a>Click me!</a> <a class="svelte-1g96cu9">Click me two!</a> <a class="svelte-1g96cu9">Click me three!</a> <a class="svelte-1g96cu9">Click me four!</a>`, 1);

export default function Id_dynamic_prefix01_input($$anchor) {
	const derived = "link-three-" + value;
	var fragment = root();
	var a = $.sibling($.first_child(fragment), 2);
	var a_1 = $.sibling(a, 2);
	var a_2 = $.sibling(a_1, 2);

	$.template_effect(() => {
		$.set_attribute(a, 'id', "link-one-" + value);
		$.set_attribute(a_1, 'id', `link-two-${value}`);
		$.set_attribute(a_2, 'id', derived);
	});

	$.append($$anchor, fragment);
}

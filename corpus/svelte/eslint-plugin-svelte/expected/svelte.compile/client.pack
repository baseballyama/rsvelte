export default function Class01_input($$anchor) {
	var fragment = root();
	var b = $.sibling($.first_child(fragment), 14);

	$.set_class(b, 1, 'svelte-3b4sig', null, {}, { conditional: true });
	$.append($$anchor, fragment);
}

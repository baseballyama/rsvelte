					checked={notifications.email}
					onCheckedChange={(checked) =>
						(notifications = { ...notifications, email: checked === true })}
				>
					<IconPlaceholder
						lucide="MailIcon"
						tabler="IconMail"
						hugeicons="MailIcon"
						phosphor="EnvelopeIcon"
						remixicon="RiMailLine"
					/>

						</Collapsible.Content>
					</Sidebar.MenuItem>
				</Collapsible.Root>
			{/each}
			<Sidebar.MenuItem>
				<Sidebar.MenuButton class="text-sidebar-foreground/70">
					<EllipsisIcon />
					<span>More</span>
				</Sidebar.MenuButton>
			</Sidebar.MenuItem>

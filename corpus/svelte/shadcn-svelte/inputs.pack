		<Chart.Container config={sleepChartConfig} class="h-32 w-full">
			<BarChart
				data={sleepChartData}
				xScale={scaleBand().padding(0.4)}
				x="hour"
				rule={false}
				series={[
					{
						key: "deep",
						label: "Deep",

<Example title="Area Chart">
	<Card.Root class="w-full">
		<Card.Header>
			<Card.Title>Area Chart</Card.Title>
			<Card.Description>Showing total visitors for the last 6 months</Card.Description>
		</Card.Header>
		<Card.Content>
			<Chart.Container config={areaChartConfig}>
				<AreaChart
					data={areaChartData}
					x="month"
					xScale={scaleBand()}
					axis="x"
					series={[

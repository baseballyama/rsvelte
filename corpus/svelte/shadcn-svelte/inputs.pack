							<Accordion.Content>{item.a}</Accordion.Content>
						</Accordion.Item>
					{/each}
				</Accordion.Root>
			</Tabs.Content>
		</Tabs.Root>
	</Card.Content>
	<Card.Footer>
		<Button variant="outline" class="w-full">Contact Support</Button>

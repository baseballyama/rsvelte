	const radialChartData = [{ browser: "safari", visitors: 1260, fill: "var(--color-safari)" }];

	const radialChartConfig = {
		visitors: {
			label: "Visitors",
		},
		safari: {
			label: "Safari",
			color: "var(--chart-2)",
		},

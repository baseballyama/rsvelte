	const activityData = [
		{ month: "Jan", amount: 40 },
		{ month: "Feb", amount: 55 },
		{ month: "Mar", amount: 35 },
		{ month: "Apr", amount: 60 },
		{ month: "May", amount: 45 },
		{ month: "Jun", amount: 50 },
		{ month: "Jul", amount: 65 },
		{ month: "Aug", amount: 40 },
		{ month: "Sep", amount: 55 },
		{ month: "Oct", amount: 70 },
		{ month: "Nov", amount: 45 },
		{ month: "Dec", amount: 80 },
	];

	const chartConfig = {
		amount: { label: "Activity", color: "var(--chart-2)" },
	} satisfies Chart.ChartConfig;
</script>


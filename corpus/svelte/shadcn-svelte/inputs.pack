						<Button variant="ghost" size="sm" class="justify-start gap-1.5">
							<IconPlaceholder
								lucide="DownloadIcon"
								tabler="IconDownload"
								hugeicons="DownloadIcon"
								phosphor="DownloadIcon"
								remixicon="RiDownloadLine"
								data-icon="inline-start"
							/>
							Download ZIP
						</Button>
					</div>
				</Tabs.Content>
			</Tabs.Root>
		</Card.Content>
	</Card.Root>
</Example>


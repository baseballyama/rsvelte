		"feature/search-functionality",
		"release/v1.9.0",
		"feature/notifications",
		"bugfix/cache-issue",
		"feature/payment-gateway",
		"hotfix/critical-bug",
		"feature/admin-panel",
		"bugfix/validation-error",
		"feature/analytics",
		"release/v2.1.0",
	];
</script>

<Example title="Repository Toolbar">
	<div class="flex items-center gap-2">
		<InputGroup.Root>
			<InputGroup.Input placeholder="Go to file" />

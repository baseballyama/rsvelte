					checked={notifications.push}
					onCheckedChange={(checked) =>
						(notifications = { ...notifications, push: checked === true })}
				>
					<IconPlaceholder
						lucide="BellIcon"
						tabler="IconBell"
						hugeicons="NotificationIcon"
						phosphor="BellIcon"
						remixicon="RiNotificationLine"
					/>
					Push notifications
				</DropdownMenu.CheckboxItem>
			</DropdownMenu.Group>
		</DropdownMenu.Content>
	</DropdownMenu.Root>
</Example>


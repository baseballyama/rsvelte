					<Tooltip.Root>
						<Tooltip.Trigger>
							{#snippet child({ props })}
								<InputGroup.Button {...props} class="rounded-full" size="icon-xs">
									<IconPlaceholder
										lucide="InfoIcon"
										tabler="IconInfoCircle"
										hugeicons="AlertCircleIcon"
										phosphor="InfoIcon"
										remixicon="RiInformationLine"

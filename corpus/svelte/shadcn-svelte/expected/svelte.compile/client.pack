							$.template_effect(() => $.set_text(text, $.get(previewItem).label));
							$.append($$anchor, text);
						},
						$$slots: { default: true }
					});
				}
			});

			$.reset(div);
			$.append($$anchor, div);
		};

		$.if(node, ($$render) => {
			if ($.get(visible)) $$render(consequent);
		});
	}

	$.append($$anchor, fragment);
	$.pop();
}

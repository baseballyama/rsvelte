		onCheckedChange = $.prop($$props, 'onCheckedChange', 3, (v) => checked(v)),
		restProps = $.rest_props($$props, rest_excludes);

	var div = root();
	var node = $.child(div);
	var bind_get = () => checked();
	var bind_set = onCheckedChange();

	Checkbox(node, $.spread_props(
		{
			get checked() {
				return bind_get();
			},

			set checked($$value) {
				bind_set($$value);
			}
		},
		() => restProps
	));

	$.reset(div);
	$.append($$anchor, div);
}

	let value = $.prop($$props, 'value', 15),
		restProps = $.rest_props($$props, rest_excludes);

	var div = root_2();
	var node = $.child(div);

	$.component(node, () => HoverCard.Root, ($$anchor, HoverCard_Root) => {

			},

			children: ($$anchor, $$slotProps) => {
				var fragment = root_1();
				var node_3 = $.first_child(fragment);

				{
					const child = ($$anchor, $$arg0) => {
						let props = () => ($$arg0?.()).props;

						Button($$anchor, $.spread_props(props, {
							variant: 'ghost',
							class: 'absolute end-2 top-1/2 size-6 -translate-y-1/2',

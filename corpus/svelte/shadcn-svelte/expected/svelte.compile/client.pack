		AccordionPrimitive_Content($$anchor, $.spread_props(
			{
				'data-slot': 'accordion-content',
				class: 'cn-accordion-content overflow-hidden'
			},
			() => restProps,
			{
				get ref() {
					return ref();
				},

				set ref($$value) {

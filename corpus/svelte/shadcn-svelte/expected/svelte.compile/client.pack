			code: "jp",
			value: "japan",
			label: "Japan",
			continent: "Asia"
		},

		{
			code: "cn",
			value: "china",
			label: "China",
			continent: "Asia"
		},

		{
			code: "br",
			value: "brazil",
			label: "Brazil",
			continent: "South America"
		},

		{
			code: "in",
			value: "india",
			label: "India",
			continent: "Asia"
		}
	];

	let open = $.state(false);
	let value = $.state(null);
	let triggerRef = $.state(null);

	function closeAndFocusTrigger() {
		$.set(open, false);

		tick().then(() => {
			$.get(triggerRef)?.focus();

			$.next();

			var text = $.text('Subscription Date');

			$.append($$anchor, text);
		},
		$$slots: { default: true }
	});

	var div_1 = $.sibling(node, 2);
	var node_1 = $.child(div_1);
	var bind_get = () => $.get(inputValue);

	var bind_set = (v) => {
		const date = new Date(v);

		$.set(inputValue, v, true);

		if (isValidDate(date)) {
			$.set(value, new CalendarDate(date.getFullYear(), date.getMonth(), date.getDate()), true);
		}
	};

	Input(node_1, {
		get id() {
			return `${id}-date`;
		},
		placeholder: 'June 01, 2025',
		class: 'bg-background pe-10',
		get value() {
			return bind_get();
		},

		set value($$value) {
			bind_set($$value);
		},

		onkeydown: (e) => {
			if (e.key === "ArrowDown") {
				e.preventDefault();
				$.set(open, true);
			}
		}
	});

	var node_2 = $.sibling(node_1, 2);

	$.component(node_2, () => Popover.Root, ($$anchor, Popover_Root) => {
		Popover_Root($$anchor, {

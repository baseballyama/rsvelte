	$.bind_this(canvas, ($$value) => canvasRef = $$value, () => canvasRef);
	$.reset(div);
	$.bind_this(div, ($$value) => containerRef = $$value, () => containerRef);
	$.append($$anchor, div);
	$.pop();
}

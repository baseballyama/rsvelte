																						children: ($$anchor, $$slotProps) => {
																							var fragment_8 = $.comment();
																							var node_9 = $.first_child(fragment_8);

																							{
																								const child = ($$anchor, $$arg0) => {
																									let props = () => ($$arg0?.()).props;
																									var a = root();

																									$.attribute_effect(a, () => ({ href: $.get(project).url, ...props() }));

																									var node_10 = $.child(a);


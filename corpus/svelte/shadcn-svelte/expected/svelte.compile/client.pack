							});
						});

						var div = $.sibling(node_1, 2);
						var node_5 = $.child(div);

						$.component(node_5, () => Tabs.Content, ($$anchor, Tabs_Content) => {
							Tabs_Content($$anchor, {
								value: 'account',
								children: ($$anchor, $$slotProps) => {

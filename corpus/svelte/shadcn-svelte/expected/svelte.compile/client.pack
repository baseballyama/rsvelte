									$.next();

									var text = $.text('Username');

									$.append($$anchor, text);
								},
								$$slots: { default: true }
							});
						});

						var node_3 = $.sibling(node_2, 2);

						Input(node_3, $.spread_props(props, {
							get value() {
								return $formData().username;
							},


			source.disconnect();
			audioContext.close();
		};

		return { analyser, audioContext, cleanup };
	}

	// Multiband volume processing
	function normalizeDb(value) {
		if (value === -Infinity) return 0;

		const minDb = -100;
		const maxDb = -10;

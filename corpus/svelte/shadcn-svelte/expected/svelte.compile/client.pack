				$.snippet(node_2, () => $$props.children);
				$.append($$anchor, fragment);
			},
			$$slots: { default: true }
		});
	});

	$.reset(main);

	var node_3 = $.sibling(main, 2);

	SiteFooter(node_3, {});
	$.reset(div);
	$.append($$anchor, div);
}

			$.reset(div_2);
			$.reset(figcaption);

			var div_3 = $.sibling(figcaption, 2);
			var node_5 = $.child(div_3);

			{
				var consequent = ($$anchor) => {
					var fragment_1 = $.comment();
					var node_6 = $.first_child(fragment_1);

					$.html(node_6, () => $.get(file)?.highlightedContent);
					$.append($$anchor, fragment_1);
				};


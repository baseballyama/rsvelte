			continent: "North America"
		},

		{
			code: "gb",
			value: "united-kingdom",
			label: "United Kingdom",
			continent: "Europe"
		},

		{
			code: "ca",
			value: "canada",
			label: "Canada",
			continent: "North America"
		},

		{
			code: "au",
			value: "australia",
			label: "Australia",
			continent: "Oceania"
		},

		{
			code: "de",
			value: "germany",
			label: "Germany",
			continent: "Europe"
		},


import * as $ from 'svelte/internal/client';
import { onMount } from "svelte";
import { cn } from "$lib/utils.js";

var rest_excludes = new Set([
	'$$slots',
	'$$events',
	'$$legacy',
	'active',
	'processing',
	'deviceId',
	'barWidth',
	'barGap',
	'barRadius',
	'barColor',
	'fadeEdges',
	'fadeWidth',
	'barHeight',
	'height',
	'sensitivity',
	'smoothingTimeConstant',

		monthIndex = $.prop($$props, 'monthIndex', 3, 0);

	function formatYear(date) {
		const dateObj = date.toDate(getLocalTimeZone());

		if (typeof $$props.yearFormat === "function") return $$props.yearFormat(dateObj.getFullYear());


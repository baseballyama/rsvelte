				});
			});

			var node_3 = $.sibling(node_2, 2);

			$.component(node_3, () => Kbd.Root, ($$anchor, Kbd_Root_3) => {
				Kbd_Root_3($$anchor, {
					children: ($$anchor, $$slotProps) => {
						$.next();

						var text_3 = $.text('→');

						$.append($$anchor, text_3);
					},
					$$slots: { default: true }
				});
			});

			$.reset(div);
			$.append($$anchor, div);
		},
		$$slots: { default: true }
	});
}

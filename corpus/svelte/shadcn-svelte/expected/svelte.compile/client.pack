									var node_5 = $.sibling(node_4, 2);

									$.component(node_5, () => Command.Group, ($$anchor, Command_Group) => {
										Command_Group($$anchor, {
											heading: 'Suggestions',
											children: ($$anchor, $$slotProps) => {

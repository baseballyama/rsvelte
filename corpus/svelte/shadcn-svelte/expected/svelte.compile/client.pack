							var fragment_2 = $.comment();
							var node_2 = $.first_child(fragment_2);

							$.component(node_2, () => Chart.Container, ($$anchor, Chart_Container) => {
								Chart_Container($$anchor, {
									get config() {
										return chartConfig;
									},
									class: 'mx-auto aspect-square max-h-[220px]',
									children: ($$anchor, $$slotProps) => {
										{
											const aboveMarks = ($$anchor) => {
												var fragment_4 = root();
												var node_3 = $.first_child(fragment_4);

												Text(node_3, {
													value: '$24,000',
													textAnchor: 'middle',
													verticalAnchor: 'middle',
													class: 'fill-foreground text-2xl! font-bold',
													dy: -8
												});

												var node_4 = $.sibling(node_3, 2);

												Text(node_4, {
													value: '80% of $30,000',
													textAnchor: 'middle',
													verticalAnchor: 'middle',
													class: 'fill-muted-foreground! text-muted-foreground',
													dy: 14
												});

												$.append($$anchor, fragment_4);
											};

											const tooltip = ($$anchor) => {
												var fragment_5 = $.comment();
												var node_5 = $.first_child(fragment_5);

												$.component(node_5, () => Chart.Tooltip, ($$anchor, Chart_Tooltip) => {
													Chart_Tooltip($$anchor, { hideLabel: true });
												});

												$.append($$anchor, fragment_5);
											};

											PieChart($$anchor, {
												get data() {
													return chartData;
												},
												key: 'name',
												value: 'value',
												c: 'color',
												innerRadius: 0.8,
												padding: 28,
												aboveMarks,

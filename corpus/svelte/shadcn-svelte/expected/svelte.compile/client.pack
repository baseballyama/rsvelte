				$.component(node_4, () => HoverCard.Content, ($$anchor, HoverCard_Content) => {
					HoverCard_Content($$anchor, {
						class: 'w-[260px] text-sm',
						align: 'start',
						side: 'left',
						children: ($$anchor, $$slotProps) => {
							$.next();

							var text_2 = $.text('Controls randomness: lowering results in less random completions. As the temperature\n			approaches zero, the model will become deterministic and repetitive.');


														$$renderer.push('<!--[!-->');
														$$renderer.push('<!--]-->');
													}
												}

												LineChart($$renderer, {
													data: chartData,
													y: 'visitors',
													yPadding: [0, 25],
													x: 'browser',
													axis: false,
													xScale: scaleBand(),
													props: {
														spline: {

		];

		const chartConfig = {
			views: { label: "Page Views", color: "" },
			desktop: { label: "Desktop", color: "var(--chart-2)" },
			mobile: { label: "Mobile", color: "var(--chart-1)" }
		};

		let activeChart = "desktop";

		const total = $.derived(() => ({
			desktop: chartData.reduce((acc, curr) => acc + curr.desktop, 0),

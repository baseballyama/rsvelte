										style: `--sidebar-width: ${$.stringify(SIDEBAR_WIDTH_MOBILE)};`,
										side,
										get ref() {
											return ref;
										},

										set ref($$value) {
											ref = $$value;
											$$settled = false;
										},

										children: ($$renderer) => {
											if (Sheet.Header) {
												$$renderer.push('<!--[-->');

												Sheet.Header($$renderer, {
													class: 'sr-only',
													children: ($$renderer) => {
														if (Sheet.Title) {

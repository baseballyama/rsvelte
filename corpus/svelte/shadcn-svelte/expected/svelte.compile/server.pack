															$$renderer.push('<!--]-->');
														} else {
															$$renderer.push('<!--[!-->');
															$$renderer.push('<!--]-->');
														}

														$$renderer.push(` `);

														if (Sheet.Description) {
															$$renderer.push('<!--[-->');

															Sheet.Description($$renderer, {
																children: ($$renderer) => {

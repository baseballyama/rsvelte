			totalAmount: "$250.00",
			paymentMethod: "Credit Card"
		},

		{
			invoice: "INV002",
			paymentStatus: "Pending",
			totalAmount: "$150.00",
			paymentMethod: "PayPal"
		},

		{
			invoice: "INV003",
			paymentStatus: "Unpaid",
			totalAmount: "$350.00",
			paymentMethod: "Bank Transfer"
		}
	];

	Example($$renderer, {
		title: 'Basic',
		children: ($$renderer) => {
			if (Table.Root) {
				$$renderer.push('<!--[-->');


				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!---->`);
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!----> `);

	PageNav($$renderer, {
		id: 'examples',
		children: ($$renderer) => {

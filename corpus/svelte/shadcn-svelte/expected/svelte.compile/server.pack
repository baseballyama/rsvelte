							}

							$$renderer.push(` `);

							if (Table.Body) {
								$$renderer.push('<!--[-->');

								Table.Body($$renderer, {
									children: ($$renderer) => {
										$$renderer.push(`<!--[-->`);

										const each_array = $.ensure_array_like(tableData);

										for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
											let row = each_array[$$index];

											if (Table.Row) {

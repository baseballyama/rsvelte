									$$renderer.push('<!--]-->');
								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}
							}

							if (InputOTP.Root) {
								$$renderer.push('<!--[-->');

								InputOTP.Root($$renderer, {
									id: 'alphanumeric',
									maxlength: 6,
									pattern: REGEXP_ONLY_DIGITS_AND_CHARS,
									children,
									$$slots: { default: true }
								});


							$$renderer.push('<!--[-->');

							Popover.Content($$renderer, {
								class: 'w-64',
								align: 'start',
								children: ($$renderer) => {
									if (Popover.Header) {
										$$renderer.push('<!--[-->');

										Popover.Header($$renderer, {
											children: ($$renderer) => {

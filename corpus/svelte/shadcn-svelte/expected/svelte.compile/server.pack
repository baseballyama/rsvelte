import Example from "../../../../../routes/(app)/(layout)/(create)/components/example.svelte";

export default function Radio_group_with_field_set($$renderer) {
	Example($$renderer, {
		title: 'With FieldSet',
		children: ($$renderer) => {
			if (Field.Set) {
				$$renderer.push('<!--[-->');

				Field.Set($$renderer, {
					children: ($$renderer) => {
						if (Field.Legend) {
							$$renderer.push('<!--[-->');


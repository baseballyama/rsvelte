																					$$renderer.push(`<!---->${$.escape(holding.name)}`);
																				},
																				$$slots: { default: true }
																			});

																			$$renderer.push('<!--]-->');
																		} else {
																			$$renderer.push('<!--[!-->');
																			$$renderer.push('<!--]-->');
																		}

																		$$renderer.push(` `);

																		if (Item.Description) {
																			$$renderer.push('<!--[-->');

																			Item.Description($$renderer, {
																				class: 'text-xs tracking-wider uppercase',
																				children: ($$renderer) => {
																					$$renderer.push(`<!---->${$.escape(holding.shares)} Shares · ${$.escape(holding.added)}`);
																				},
																				$$slots: { default: true }
																			});

																			$$renderer.push('<!--]-->');
																		} else {
																			$$renderer.push('<!--[!-->');
																			$$renderer.push('<!--]-->');
																		}
																	},

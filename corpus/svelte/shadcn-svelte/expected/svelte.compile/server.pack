																hugeicons: 'LinkIcon',
																phosphor: 'LinkIcon',
																remixicon: 'RiLinksLine'
															});

															$$renderer.push(`<!----> Link `);

															if (Menubar.Shortcut) {
																$$renderer.push('<!--[-->');

																Menubar.Shortcut($$renderer, {
																	children: ($$renderer) => {
																		$$renderer.push(`<!---->⌘K`);
																	},
																	$$slots: { default: true }
																});

																$$renderer.push('<!--]-->');
															} else {
																$$renderer.push('<!--[!-->');
																$$renderer.push('<!--]-->');
															}
														},
														$$slots: { default: true }
													});

													$$renderer.push('<!--]-->');
												} else {
													$$renderer.push('<!--[!-->');
													$$renderer.push('<!--]-->');
												}

												$$renderer.push(` `);

												if (Menubar.Item) {
													$$renderer.push('<!--[-->');

													Menubar.Item($$renderer, {
														children: ($$renderer) => {
															IconPlaceholder($$renderer, {
																lucide: 'TableIcon',
																tabler: 'IconTable',
																hugeicons: 'TableIcon',
																phosphor: 'TableIcon',
																remixicon: 'RiTableLine'
															});

															$$renderer.push(`<!----> Table`);
														},
														$$slots: { default: true }
													});

													$$renderer.push('<!--]-->');

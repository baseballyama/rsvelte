export default function Button_group_with_text($$renderer) {
	Example($$renderer, {
		title: 'With Text',
		children: ($$renderer) => {
			$$renderer.push(`<div class="flex flex-col gap-4">`);

			ButtonGroup($$renderer, {
				children: ($$renderer) => {
					ButtonGroupText($$renderer, {
						children: ($$renderer) => {
							$$renderer.push(`<!---->Text`);
						},
						$$slots: { default: true }
					});

					$$renderer.push(`<!----> `);


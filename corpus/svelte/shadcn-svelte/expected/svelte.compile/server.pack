			$$renderer.push(`<!----> `);
			FieldExamples($$renderer, {});
			$$renderer.push(`<!----> `);
			ItemExample($$renderer, {});
			$$renderer.push(`<!----> `);
			ButtonGroupExamples($$renderer, {});
			$$renderer.push(`<!----> `);
			EmptyAvatarGroup($$renderer, {});
			$$renderer.push(`<!----> `);
			InputGroupExamples($$renderer, {});
			$$renderer.push(`<!----> `);
			SheetExample($$renderer, {});
			$$renderer.push(`<!----> `);
			BadgeExamples($$renderer, {});
			$$renderer.push(`<!---->`);
		},
		$$slots: { default: true }
	});
}

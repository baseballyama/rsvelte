									if (Pagination.Previous) {
										$$renderer.push('<!--[-->');
										Pagination.Previous($$renderer, {});
										$$renderer.push('<!--]-->');
									} else {
										$$renderer.push('<!--[!-->');
										$$renderer.push('<!--]-->');
									}
								},
								$$slots: { default: true }
							});

							$$renderer.push('<!--]-->');
						} else {
							$$renderer.push('<!--[!-->');
							$$renderer.push('<!--]-->');
						}

						$$renderer.push(` <!--[-->`);

						const each_array = $.ensure_array_like(pages);

						for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
							let page = each_array[$$index];

							if (page.type === "ellipsis") {
								$$renderer.push('<!--[0-->');

								if (Pagination.Item) {
									$$renderer.push('<!--[-->');

									Pagination.Item($$renderer, {
										children: ($$renderer) => {
											if (Pagination.Ellipsis) {
												$$renderer.push('<!--[-->');
												Pagination.Ellipsis($$renderer, {});
												$$renderer.push('<!--]-->');
											} else {
												$$renderer.push('<!--[!-->');
												$$renderer.push('<!--]-->');
											}
										},
										$$slots: { default: true }
									});

									$$renderer.push('<!--]-->');
								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}
							} else {
								$$renderer.push('<!--[-1-->');

								if (Pagination.Item) {
									$$renderer.push('<!--[-->');

									Pagination.Item($$renderer, {
										children: ($$renderer) => {
											if (Pagination.Link) {
												$$renderer.push('<!--[-->');

												Pagination.Link($$renderer, {
													page,
													isActive: currentPage === page.value,
													children: ($$renderer) => {
														$$renderer.push(`<!---->${$.escape(page.value)}`);
													},
													$$slots: { default: true }
												});

												$$renderer.push('<!--]-->');
											} else {
												$$renderer.push('<!--[!-->');
												$$renderer.push('<!--]-->');
											}
										},
										$$slots: { default: true }
									});

									$$renderer.push('<!--]-->');
								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}
							}

							$$renderer.push(`<!--]-->`);
						}

						$$renderer.push(`<!--]--> `);

						if (Pagination.Item) {
							$$renderer.push('<!--[-->');

							Pagination.Item($$renderer, {
								children: ($$renderer) => {
									if (Pagination.Ellipsis) {
										$$renderer.push('<!--[-->');
										Pagination.Ellipsis($$renderer, {});
										$$renderer.push('<!--]-->');

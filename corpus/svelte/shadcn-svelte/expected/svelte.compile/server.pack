								Item.Actions($$renderer, {
									children: ($$renderer) => {
										Button($$renderer, {
											variant: 'outline',
											size: size === "xs" || size === "sm" ? "sm" : undefined,
											children: ($$renderer) => {
												$$renderer.push(`<!---->Action`);
											},
											$$slots: { default: true }
										});

					});

					$$renderer.push('<!--]-->');
				} else {
					$$renderer.push('<!--[!-->');
					$$renderer.push('<!--]-->');
				}

				$$renderer.push(` `);

				if (ButtonGroup.Root) {
					$$renderer.push('<!--[-->');

					ButtonGroup.Root($$renderer, {
						children: ($$renderer) => {
							if (InputGroup.Root) {
								$$renderer.push('<!--[-->');

								InputGroup.Root($$renderer, {
									children: ($$renderer) => {
										if (InputGroup.Input) {
											$$renderer.push('<!--[-->');

											InputGroup.Input($$renderer, {
												placeholder: voiceEnabled ? "Record and send audio..." : "Send a message...",
												disabled: voiceEnabled
											});


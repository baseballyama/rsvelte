							$$renderer.push('<!--[-->');

							Dialog.Content($$renderer, {
								showCloseButton: false,
								children: ($$renderer) => {
									if (Dialog.Header) {
										$$renderer.push('<!--[-->');

										Dialog.Header($$renderer, {
											children: ($$renderer) => {
												if (Dialog.Title) {

								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}

								$$renderer.push(` `);

								if (Picker.Group) {
									$$renderer.push('<!--[-->');

									Picker.Group($$renderer, {
										children: ($$renderer) => {
											if (Picker.Label) {

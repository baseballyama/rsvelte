			$$renderer.push('<!--[!-->');
			$$renderer.push('<!--]-->');
		}

		$$renderer.push(` `);

		LockButton($$renderer, {
			prop: 'menuAccent',
			class: 'absolute top-1/2 right-10 -translate-y-1/2'
		});

		$$renderer.push(`<!----></div>`);
	});
}

														let s = each_array[$$index];

														{
															function children($$renderer, { gradient }) {
																Area($$renderer, $.spread_props([
																	{
																		seriesKey: s.key,
																		curve: curveNatural,
																		fillOpacity: 0.4,
																		line: { class: "stroke-1" },
																		motion: 'tween'
																	},
																	s.props,

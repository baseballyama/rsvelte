									let { label, value } = each_array[$$index];

									$$renderer.push(`<div class="text-center"><div class="text-sm font-medium tabular-nums">${$.escape(value)}</div> <div class="text-xs text-muted-foreground">${$.escape(label)}</div></div>`);

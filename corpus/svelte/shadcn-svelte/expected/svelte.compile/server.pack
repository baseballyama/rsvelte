			description: "validated in sandboxes before you merge."
		},

		{
			id: "root-cause",
			title: "Root-cause analysis",
			description: "for production issues with deployment context.",
			hasBadge: true
		}
	];

	Example($$renderer, {
		title: 'Activate Agent',
		class: 'items-center justify-center',

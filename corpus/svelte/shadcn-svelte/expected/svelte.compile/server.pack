								value: '30',
								title: 'Mobile',
								children: ($$renderer) => {
									SmartphoneIcon($$renderer, {});
								},
								$$slots: { default: true }
							});

							$$renderer.push('<!--]-->');
						} else {
							$$renderer.push('<!--[!-->');
							$$renderer.push('<!--]-->');
						}

						$$renderer.push(` `);
						Separator($$renderer, { orientation: 'vertical', class: '!h-4' });
						$$renderer.push(`<!----> `);

						Button($$renderer, {
							size: 'icon',
							variant: 'ghost',
							class: 'size-6 rounded-sm p-0',
							title: 'Open in New Tab',
							href: `/view/${$.stringify(ctx.item.name)}`,
							target: '_blank',
							children: ($$renderer) => {
								$$renderer.push(`<span class="sr-only">Open in New Tab</span> `);
								FullscreenIcon($$renderer, {});
								$$renderer.push(`<!---->`);
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);
						Separator($$renderer, { orientation: 'vertical', class: '!h-4' });
						$$renderer.push(`<!----> `);

						Button($$renderer, {
							size: 'icon',
							variant: 'ghost',
							class: 'size-6 rounded-sm p-0',
							title: 'Refresh Preview',
							onclick: () => {

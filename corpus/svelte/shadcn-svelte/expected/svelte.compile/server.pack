								$$renderer.push(`<!----> `);
								Input($$renderer, { id: 'maxWidth', value: '300px', class: 'col-span-2 h-8' });
								$$renderer.push(`<!----></div> <div class="grid grid-cols-3 items-center gap-4">`);

								Label($$renderer, {
									for: 'height',
									children: ($$renderer) => {
										$$renderer.push(`<!---->Height`);
									},
									$$slots: { default: true }

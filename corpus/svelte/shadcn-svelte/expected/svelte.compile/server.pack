					$$renderer.push('<!--]-->');
				}
			},
			$$slots: { default: true }
		});

		$$renderer.push('<!--]-->');
	} else {
		$$renderer.push('<!--[!-->');
		$$renderer.push('<!--]-->');
	}

	$$renderer.push(`</div> <div class="flex w-[100px] items-center justify-center text-sm font-medium">Page ${$.escape(table.atoms.pagination.get().pageIndex + 1)} of

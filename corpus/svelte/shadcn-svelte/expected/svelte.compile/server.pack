		function $$render_inner($$renderer) {
			{
				function children($$renderer, { checked, indeterminate }) {
					$$renderer.push(`<span class="cn-menubar-checkbox-item-indicator pointer-events-none absolute flex items-center justify-center">`);

					if (indeterminate) {
						$$renderer.push('<!--[0-->');


											});

											$$renderer.push('<!--]-->');
										} else {
											$$renderer.push('<!--[!-->');
											$$renderer.push('<!--]-->');
										}
									}

									if (InputOTP.Root) {
										$$renderer.push('<!--[-->');

										InputOTP.Root($$renderer, $.spread_props([
											{ maxlength: 6 },
											props,
											{
												get value() {
													return $.store_get($$store_subs ??= {}, '$formData', formData).pin;
												},

												set value($$value) {

				$$renderer.push('<!--[-->');

				NativeSelect.Root($$renderer, {
					value: '+1',
					children: ($$renderer) => {
						if (NativeSelect.Option) {
							$$renderer.push('<!--[-->');

							NativeSelect.Option($$renderer, {
								value: '+1',
								children: ($$renderer) => {
									$$renderer.push(`<!---->+1`);

export default function Button_group_text_alignment($$renderer) {
	Example($$renderer, {
		title: 'Text Alignment',
		children: ($$renderer) => {
			if (Field.Field) {
				$$renderer.push('<!--[-->');

				Field.Field($$renderer, {
					children: ($$renderer) => {
						Label($$renderer, {
							id: 'alignment-label',

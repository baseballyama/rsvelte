						} else {
							$$renderer.push('<!--[!-->');
							$$renderer.push('<!--]-->');
						}

						$$renderer.push(` `);

						if (Pagination.Item) {
							$$renderer.push('<!--[-->');

							Pagination.Item($$renderer, {
								children: ($$renderer) => {
									if (Pagination.Next) {

import { Button } from "$lib/registry/ui/button/index.js";
import { cn } from "$lib/utils.js";
import { useSidebar } from "./context.svelte.js";

export default function Sidebar_trigger($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let {
			ref = null,
			class: className,
			onclick,
			$$slots,
			$$events,
			...restProps

															labelFormatter: (v) => {
																return v.toLocaleDateString("en-US", { month: "long" });
															},
															indicator: 'line'
														});

														$$renderer.push('<!--]-->');
													} else {
														$$renderer.push('<!--[!-->');
														$$renderer.push('<!--]-->');
													}
												}

												LineChart($$renderer, {
													points: { r: 4 },
													labels: { offset: 12 },
													data: chartData,
													x: 'date',
													axis: 'x',
													xScale: scaleUtc(),
													series: [
														{
															key: "desktop",
															label: "Desktop",
															color: chartConfig.desktop.color
														}
													],
													props: {
														spline: { curve: curveNatural, motion: "tween", strokeWidth: 2 },
														highlight: { points: { motion: "none", r: 6 } },
														xAxis: {
															format: (v) => v.toLocaleDateString("en-US", { month: "short" })
														}
													},
													tooltip,
													$$slots: { tooltip: true }
												});
											}
										},
										$$slots: { default: true }
									});

									$$renderer.push('<!--]-->');
								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}
							},
							$$slots: { default: true }
						});

						$$renderer.push('<!--]-->');
					} else {
						$$renderer.push('<!--[!-->');
						$$renderer.push('<!--]-->');
					}

					$$renderer.push(` `);


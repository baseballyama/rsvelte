				Popover.Root($$renderer, {
					children: ($$renderer) => {
						{
							function child($$renderer, { props }) {
								Button($$renderer, $.spread_props([
									{ variant: 'outline', size: 'sm' },
									props,
									{
										children: ($$renderer) => {
											$$renderer.push(`<!---->Start`);
										},
										$$slots: { default: true }
									}
								]));
							}

							if (Popover.Trigger) {

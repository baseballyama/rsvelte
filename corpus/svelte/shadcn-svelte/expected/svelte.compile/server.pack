							children: ($$renderer) => {
								if (Sheet.Header) {
									$$renderer.push('<!--[-->');

									Sheet.Header($$renderer, {
										children: ($$renderer) => {
											if (Sheet.Title) {
												$$renderer.push('<!--[-->');


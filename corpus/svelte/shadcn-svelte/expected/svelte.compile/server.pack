													$$renderer.push('<!--]-->');
												} else {
													$$renderer.push('<!--[!-->');
													$$renderer.push('<!--]-->');
												}

												$$renderer.push(` `);

												if (Popover.Description) {
													$$renderer.push('<!--[-->');

													Popover.Description($$renderer, {
														children: ($$renderer) => {

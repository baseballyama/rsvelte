											$$renderer.push(`<!---->${$.escape(triggerLabel())} `);
											CalendarPlusIcon($$renderer, {});
											$$renderer.push(`<!---->`);
										},
										$$slots: { default: true }
									}
								]));
							}

							if (Drawer.Trigger) {

			headings.</p> <p class="text-sm leading-relaxed text-muted-foreground">Thoughtful spacing and cadence help paragraphs scan quickly without feeling dense.</p>`);
								},
								$$slots: { default: true }
							});

							$$renderer.push('<!--]-->');
						} else {
							$$renderer.push('<!--[!-->');
							$$renderer.push('<!--]-->');
						}

						$$renderer.push(` `);

						if (Card.Footer) {
							$$renderer.push('<!--[-->');

							Card.Footer($$renderer, {

		{ name: "Support", url: "#", icon: LifeBuoyIcon, badge: "21" },
		{ name: "Feedback", url: "#", icon: SendIcon, badge: "8" }
	];

	if (Sidebar.Provider) {
		$$renderer.push('<!--[-->');

		Sidebar.Provider($$renderer, {
			children: ($$renderer) => {
				if (Sidebar.Root) {
					$$renderer.push('<!--[-->');


											$$renderer.push('<!--]-->');
										}

										$$renderer.push(` `);

										if (Command.Group) {
											$$renderer.push('<!--[-->');

											Command.Group($$renderer, {
												heading: 'Suggestions',
												children: ($$renderer) => {
													if (Command.Item) {
														$$renderer.push('<!--[-->');

														Command.Item($$renderer, {
															children: ($$renderer) => {

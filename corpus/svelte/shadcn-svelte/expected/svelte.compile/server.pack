													$$renderer.push('<!--]-->');
												}

												$$renderer.push(` `);

												if (Menubar.Item) {
													$$renderer.push('<!--[-->');

													Menubar.Item($$renderer, {
														disabled: true,
														children: ($$renderer) => {
															$$renderer.push(`<!---->New Incognito Window`);
														},
														$$slots: { default: true }
													});

													$$renderer.push('<!--]-->');

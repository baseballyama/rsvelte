									},
									$$slots: { default: true }
								});

								$$renderer.push(`<!----> `);

								Input($$renderer, {
									id: 'email-spacing',
									type: 'email',
									placeholder: 'm@example.com',
									required: true
								});

								$$renderer.push(`<!----></div> <div class="grid gap-2"><div class="flex items-center">`);

								Label($$renderer, {

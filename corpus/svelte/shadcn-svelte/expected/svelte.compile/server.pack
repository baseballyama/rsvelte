export default function Button_group_with_dropdown($$renderer) {
	Example($$renderer, {
		title: 'With Dropdown',
		children: ($$renderer) => {
			$$renderer.push(`<div class="flex flex-col gap-4">`);

			ButtonGroup($$renderer, {
				children: ($$renderer) => {

											if (InputGroup.Addon) {
												$$renderer.push('<!--[-->');

												InputGroup.Addon($$renderer, {
													children: ($$renderer) => {
														IconPlaceholder($$renderer, {
															lucide: 'SearchIcon',
															tabler: 'IconSearch',
															hugeicons: 'Search01Icon',
															phosphor: 'MagnifyingGlassIcon',
															remixicon: 'RiSearchLine'
														});
													},
													$$slots: { default: true }
												});

												$$renderer.push('<!--]-->');
											} else {
												$$renderer.push('<!--[!-->');
												$$renderer.push('<!--]-->');
											}

											$$renderer.push(` `);

											if (InputGroup.Input) {
												$$renderer.push('<!--[-->');
												InputGroup.Input($$renderer, { placeholder: 'Search holdings or tickers...' });
												$$renderer.push('<!--]-->');
											} else {
												$$renderer.push('<!--[!-->');
												$$renderer.push('<!--]-->');
											}
										},
										$$slots: { default: true }
									});

									$$renderer.push('<!--]-->');

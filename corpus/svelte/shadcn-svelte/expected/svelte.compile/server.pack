import Example from "../../../../../routes/(app)/(layout)/(create)/components/example.svelte";

export default function Menubar_with_inset($$renderer) {
	let showBookmarks = true;
	let showUrls = false;
	let theme = "system";
	let $$settled = true;
	let $$inner_renderer;


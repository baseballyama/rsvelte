			$$events,
			...restProps
		} = $$props;

		let $$settled = true;
		let $$inner_renderer;

		function $$render_inner($$renderer) {
			DrawerPortal($$renderer, $.spread_props([
				portalProps,
				{
					children: ($$renderer) => {
						DrawerOverlay($$renderer, {});
						$$renderer.push(`<!----> `);

						if (DrawerPrimitive.Content) {
							$$renderer.push('<!--[-->');


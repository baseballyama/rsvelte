									$$renderer.push('<!--[-->');

									Form.Description($$renderer, {
										children: ($$renderer) => {
											$$renderer.push(`<!---->Receive emails about new products, features, and more.`);
										},
										$$slots: { default: true }
									});

									$$renderer.push('<!--]-->');
								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}

								$$renderer.push(`</div> `);

								Switch($$renderer, $.spread_props([

						$$renderer.push('<!--]-->');
					}

					$$renderer.push(` `);

					if (Card.Content) {
						$$renderer.push('<!--[-->');

						Card.Content($$renderer, {
							children: ($$renderer) => {
								$$renderer.push(`<form><div class="flex flex-col gap-6"><div class="grid gap-2">`);

								Label($$renderer, {
									for: 'email-spacing',
									children: ($$renderer) => {

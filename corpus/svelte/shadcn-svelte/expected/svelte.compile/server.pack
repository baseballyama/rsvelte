				$$renderer.push(`<!----> `);

				Button($$renderer, {
					variant: 'outline',
					size: 'icon',
					children: ($$renderer) => {
						Minus($$renderer, {});
					},
					$$slots: { default: true }
				});

				$$renderer.push(`<!---->`);
			},
			$$slots: { default: true }
		});

		$$renderer.push('<!--]-->');
	} else {
		$$renderer.push('<!--[!-->');
		$$renderer.push('<!--]-->');
	}
}

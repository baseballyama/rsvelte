/* use-mutation-observer.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export function useMutationObserver(
	ref,
	callback,
	options = {
		attributes: true,
		characterData: true,
		childList: true,
		subtree: true
	}
) {
	const element = $.derived(ref);

	$.user_effect(() => {
		if (!$.get(element)) return;

		const observer = new MutationObserver(callback);

		observer.observe($.get(element), options);

		return () => observer.disconnect();
	});
}

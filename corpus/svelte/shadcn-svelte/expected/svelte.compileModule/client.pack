/* use-clipboard.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export class UseClipboard {
	#copiedStatus = $.state();
	delay;
	reset;
	timeout = undefined;
	#lastCopied = $.state(undefined);

	constructor({ delay = 2000, reset = true } = {}) {
		this.delay = delay;
		this.reset = reset;
	}

	/** Copies the given text to the users clipboard.
	 *
	 * ## Usage
	 * ```ts
	 * clipboard.copy('Hello, World!');
	 * ```
	 *
	 * @param text
	 * @returns
	 */
	async copy(text) {
		if (this.timeout) {
			$.set(this.#copiedStatus, undefined);
			clearTimeout(this.timeout);
		}

		$.set(this.#copiedStatus, await copyText(text.toString()), true);

		this.timeout = setTimeout(
			() => {
				$.set(this.#copiedStatus, undefined);
			},
			this.delay
		);

		return $.get(this.#copiedStatus);
	}

	/** True when the user has just copied to the clipboard. */
	get copied() {
		return $.get(this.#copiedStatus) === "success";
	}

	/**	Indicates whether a copy has occurred
	 * and gives a status of either `success` or `failure`. */
	get status() {
		return $.get(this.#copiedStatus);
	}

	/**
	 * The last copied text.
	 */
	get lastCopied() {
		return $.get(this.#lastCopied);
	}
}

export async function copyText(text) {
	try {
		if (navigator.clipboard && window.isSecureContext) {
			await navigator.clipboard.writeText(text);

			return "success";
		}

		// when navigator.clipboard is unavailable we fallback to this for wider browser compatibility
		const textArea = document.createElement("textarea");

		textArea.value = text;
		textArea.style.position = "fixed";
		textArea.style.top = "0";
		textArea.style.left = "0";
		document.body.appendChild(textArea);
		textArea.select();

		const successful = document.execCommand("copy");

		document.body.removeChild(textArea);

		return successful ? "success" : "failure";
	} catch {
		return "failure";
	}
}
=== 458 docs/src/lib/hooks/use-is-mac.svelte.ts	js
/* use-is-mac.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { browser } from "$app/environment";

export function useIsMac() {
	const isMac = $.derived(() => browser ? navigator.userAgent.includes("Mac") : false);

	return {
		get current() {
			return $.get(isMac);
		},

		get cmdOrCtrl() {
			return $.get(isMac) ? "⌘" : "Ctrl";
		},

		get optionOrAlt() {
			return $.get(isMac) ? "⌥" : "Alt";
		}
	};
}

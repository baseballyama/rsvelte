    existsSync: vi.fn(),
    promises: {
        mkdir: vi.fn(),
        writeFile: vi.fn(),
        readFile: vi.fn().mockResolvedValue(""),
    },
}));
vi.mock("@clack/prompts", () => ({
    confirm: vi.fn(),
    tasks: vi.fn(),
    isCancel: vi.fn().mockReturnValue(false),

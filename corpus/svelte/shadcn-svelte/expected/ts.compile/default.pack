export function getEnvProxy() {
    const { env } = process;
    return (env.HTTP_PROXY ||
        env.http_proxy ||
        env.HTTPS_PROXY ||
        env.https_proxy ||
        env.npm_config_proxy ||
        env.npm_config_https_proxy);
}

=== 1161 packages/cli/src/utils/get-package-info.ts	js
import fs from "node:fs";
import path from "node:path";
import { createRequire } from "node:module";
import { fileURLToPath } from "node:url";
export function getCLIPackageInfo() {
    const packageJsonPath = getPackageFilePath("../package.json");
    return readJSONSync(packageJsonPath);
}
function getPackageFilePath(filePath) {
    const distPath = fileURLToPath(new URL(`.`, import.meta.url));
    return path.resolve(distPath, filePath);
}
export function readJSONSync(path) {
    const content = fs.readFileSync(path, { encoding: "utf8" });
    return JSON.parse(content);
}
export function getDependencyPackageInfo(cwd, depName) {
    const require = createRequire(path.resolve(cwd, "noop.js"));
    const paths = require.resolve.paths(depName);
    if (!paths)
        return;
    let pkgPath;
    for (const nodeModulesPath of paths) {
        const check = path.join(nodeModulesPath, depName, "package.json");
        if (fs.existsSync(check)) {
            pkgPath = check;
            break;
        }
    }
    if (!pkgPath)
        return;
    const json = fs.readFileSync(pkgPath, "utf8");
    return { pkg: JSON.parse(json), path: pkgPath };
}


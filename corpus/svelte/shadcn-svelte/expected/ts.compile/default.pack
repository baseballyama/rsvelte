=== 992 docs/src/routes/(app)/(layout)/docs/[...slug]/+page.ts	js
import { getDoc } from "$lib/docs.js";
export const prerender = true;
export const entries = () => {
    console.info("Prerendering /docs");
    const modules = import.meta.glob("/content/**/*.md");
    const entries = [];
    for (const path of Object.keys(modules)) {
        const slug = path.replace("/content/", "").replace(".md", "").replace("/index", "");
        entries.push({ slug });
    }
    return entries;
};
/**
 * Any components / blocks that won't have a .json file associated with them.
 */
const ITEMS_TO_IGNORE = ["combobox", "data-table", "date-picker", "typography"];
export const load = async ({ params, fetch }) => {
    const doc = await getDoc(params.slug);
    const name = doc.metadata.slug;
    if (params.slug.includes("components/") && !ITEMS_TO_IGNORE.includes(name)) {
        const res = await fetch(`/api/block/${name}`);
        const item = await res.json();
        return { ...doc, viewerData: item };
    }
    return { ...doc, viewerData: null };
};

=== 402 docs/src/routes/(app)/(layout)/docs/changelog/+page.ts	js
import { getChangelogPages } from "$lib/docs.js";
export const prerender = true;
const NUMBER_OF_LATEST_PAGES = 2;
export const load = async () => {
    const pages = await getChangelogPages({
        includeComponentsForLatest: NUMBER_OF_LATEST_PAGES,
    });
    return {
        latestPages: pages.slice(0, NUMBER_OF_LATEST_PAGES),
        olderPages: pages.slice(NUMBER_OF_LATEST_PAGES),
    };
};


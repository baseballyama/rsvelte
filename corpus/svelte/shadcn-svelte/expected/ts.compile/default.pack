    light: z.optional(colorSchema).describe("CSS variables for the light theme."),
    dark: z.optional(colorSchema).describe("CSS variables for the dark theme."),
})
    .describe("The css variables for the registry item. This will be merged with the project's css variables.");
const registryItemCssSchema = z
    .record(z.string().describe("Direct CSS string (e.g., 'font-family: sans-serif; line-height: 1.5;')"), z
    .lazy(() => z.union([

import { describe, expect, it, vi } from "vitest";
import { getConf, resolvePath } from "./test-helpers.js";
import { SITE_BASE_URL } from "../../src/constants.js";
vi.mock("tinyexec");
describe("getConfig", () => {
    it("handles cases where no config is present", async () => {
        expect(await getConf("config-none")).toEqual(undefined);
    });
    it("handles invalid configurations", async () => {
        await expect(getConf("config-invalid")).rejects.toThrowError();
    });
    it("handles trailing slashes in aliases", async () => {
        expect(await getConf("config-trailing-slashes")).toEqual({
            tailwind: {
                css: "src/app.css",
                baseColor: "zinc",
            },
            aliases: {
                utils: "$lib/utils",
                components: "$lib/components",
                hooks: "$lib/hooks",
                ui: "$lib/components/ui",
                lib: "$lib",
            },

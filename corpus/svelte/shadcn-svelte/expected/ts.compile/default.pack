    }
    else if (result.skippedDeps.size) {
        const prettyList = prettifyList([...result.skippedDeps], 7);
        p.log.warn(`shadcn-svelte has been initialized ${color.bold(color.red("without"))} the following ${highlight("dependencies")}:\n${color.gray(prettyList)}`);
    }

  --chart-1: <%- colors.dark["chart-1"] %>;
  --chart-2: <%- colors.dark["chart-2"] %>;
  --chart-3: <%- colors.dark["chart-3"] %>;
  --chart-4: <%- colors.dark["chart-4"] %>;
  --chart-5: <%- colors.dark["chart-5"] %>;
  --sidebar: <%- colors.dark["sidebar"] %>;

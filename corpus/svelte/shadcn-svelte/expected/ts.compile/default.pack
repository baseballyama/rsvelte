    });
});
describe("transform", () => {
    it("transforms content with TypeScript enabled", async () => {
        const content = `
      import { Button } from "$COMPONENTS$/button";
      interface Props {
        name: string;
      }
      export function Component({ name }: Props) {
        return name;
      }
    `;

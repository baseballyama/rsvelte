		<Stepper.Root>
			{#each { length: 5 } as _, i (i)}
				<Stepper.Item step={i + 1} />
			{/each}
		</Stepper.Root>
		",
		      "target": "checkout-steps.svelte",
		      "type": "registry:component",
		    },

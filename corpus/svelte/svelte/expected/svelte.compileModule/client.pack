/* store.svelte.js generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

class RawStore {
	#values = $.state({ visible: true });

	get values() {
		return $.get(this.#values);
	}

	set values(value) {
		$.set(this.#values, value);
	}

	get(key) {
		return this.values[key];
	}

	set(key, value) {
		this.values = { ...this.values, [key]: value };
	}
}

export const store = new RawStore();

/* index.svelte.js generated by Svelte v5.59.1 */
import * as $ from 'svelte/internal/client';

let a = $.state(1);
let b = $.state(2);
let c = 3;
let d = 4;

export function update(array) {
	((array) => {
		var $$array = $.to_array(array, 2);

		$.set(a, $$array[0], true);
		$.set(b, $$array[1], true);
	})(array);

	[c, d] = array;
}

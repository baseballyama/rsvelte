            const d = derived(() => set.has('test'));
            set.add('test');
            assert.equal($.get(d), true);
        };
    });
    test('deriveds read inside the root/branches are cleaned up', () => {
        return () => {
            const a = state(0);
            const destroy = effect_root(() => {
                const b = derived(() => $.get(a));
                $.get(b);
            });
            destroy();

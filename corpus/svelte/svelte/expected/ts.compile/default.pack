        const inner_states = [];
        const d = derived(() => {
            const destroy = effect_root(() => {
                const x = state(0);
                inner_states.push(x);
                effect(() => {
                    log.push('inner ' + $.get(x));
                    return () => {
                        log.push('inner destroyed');

        render_effect(() => {
            log.push(params.toString());
        });
    });
    flushSync(() => {
        params.delete('a');
    });
    flushSync(() => {
        // nothing should happen here
        params.delete('a');
    });
    flushSync(() => {
        params.set('a', 'b');
    });
    assert.deepEqual(log, ['a=b&c=d', 'c=d', 'c=d&a=b']);
    cleanup();
});
test('URLSearchParams.get', () => {
    const params = new SvelteURLSearchParams('a=b&c=d');

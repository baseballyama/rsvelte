            log.push(date.getUTCHours() % 24);
        });
    });
    flushSync(() => {
        date.setHours(a.getHours());
    });
    flushSync(() => {
        date.setHours(date.getHours() + 1);
    });
    flushSync(() => {
        date.setHours(date.getHours()); // no change expected
    });
    flushSync(() => {

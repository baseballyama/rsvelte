            cleanup.push(destroy);
            return $.get(c);
        });
        return () => {
            log.push($.get(d));
            flushSync();
            assert.deepEqual(log, [0, 'inner 0']);
            log.length = 0;
            set(inner_states[0], 1);
            flushSync();
            assert.deepEqual(log, ['inner destroyed', 'inner 1']);
            log.length = 0;
            set(c, 1);
            log.push($.get(d));
            flushSync();
            assert.deepEqual(log, [1, 'inner 0']);
            log.length = 0;
            cleanup.forEach((fn) => fn());
            flushSync();
            assert.deepEqual(log, ['inner destroyed', 'inner destroyed']);
        };
    });
    test('derived read in an untracked context should not leak in deps reactions', () => {
        return () => {
            let s = state('hello');
            let a = derived(() => $.get(s));
            let b = derived(() => $.get(a));
            let destroy = effect_root(() => {

                        await Promise.resolve();
                        throw new Error(input);
                    });
                };
                return (await Renderer.render(component, {
                    transformError: transform
                })).body;
            }
        }
    ];
    describe.each(paths)('$path', ({ async: needs_async, render }) => {
        if (needs_async) {

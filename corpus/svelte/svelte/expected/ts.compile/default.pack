            getFullYear: true,
            getUTCFullYear: true,
            getMonth: true,
            getUTCMonth: true,
            getDay: true,
            getUTCDay: true,
            getTime: true,
            toISOString: true,
            toJSON: true,
            toUTCString: true,
            toString: true,
            toLocaleString: true
        };
        test_description = 'changing setFullYear that will cause month/day change as well';
        date.setFullYear(initial_date.getFullYear() + 1, initial_date.getMonth() + 1);
    });
    flushSync(() => {
        expect_all_changes_to_be_false();
        changes = {
            ...changes,
            getDate: true,
            getUTCDate: true,
            getDay: true,
            getUTCDay: true,
            getHours: true,
            getUTCHours: true,
            getMinutes: true,
            getUTCMinutes: true,
            getSeconds: true,

        getTime: true,
        toISOString: true,
        toJSON: true,
        toUTCString: true,
        toString: true,
        toLocaleString: true
    };
    let test_description = '';
    const expect_all_changes_to_be_false = () => {
        for (const key of Object.keys(changes)) {
            assert.equal(changes[key], false, `${test_description}: effect for ${key} was not fired`);
        }
    };
    const cleanup = effect_root(() => {
        for (const key of Object.keys(changes)) {

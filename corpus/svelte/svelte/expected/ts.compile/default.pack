test('Date fine grained tests', () => {
    const date = new SvelteDate(initial_date);
    let changes = {
        getFullYear: true,
        getUTCFullYear: true,
        getMonth: true,
        getUTCMonth: true,
        getDate: true,
        getUTCDate: true,
        getDay: true,
        getUTCDay: true,
        getHours: true,
        getUTCHours: true,
        getMinutes: true,
        getUTCMinutes: true,

				if (num) $$render(consequent);
			});
		}

		$.append($$anchor, fragment_1);
	});

	$.next(2);
	$.reset(section);

	var button = $.sibling(section, 2);

	$.event('click', button, changeNum);
	$.append($$anchor, fragment);
}

	}

	var button = root();

	$.action(button, ($$node, $$action_arg) => action?.($$node, $$action_arg), () => $.get(toggle));

	$.delegated('mouseup', button, () => {
		$.set(toggle, true);
	});

	$.append($$anchor, button);
}


	$.template_effect(() => $.set_text(text, ` ${props.foo ?? ''} ${props.bar ?? ''} ${props.baz ?? ''} ${props.buz ?? ''} `));

	$.delegated('click', button, () => {
		legacy.$set({ foo: 'foo', bar: 'bar', baz: 'baz', buz: 'buz' });
		props.foo = 'foo';
		props.bar = 'bar';
		props.baz = 'baz';
		props.buz = 'buz';

=== 1418 packages/svelte/tests/css/samples/global-block/input.svelte	css

	/* :global {*/
		.x {
			color: green;
		}

		.a, .selector, .list {
			color: green;
		}
	/*}*/

	div.svelte-1yk7nd8 {
		.y {
			color: green;
		}
	}

	/* some css preprocessors de-nest :global blocks with a single child
	   (e.g turn `:global { div { ... } }` into `:global div { ... }`),
	   so we need to support it, too */
	 div {
		.y {
			color: green;
		}
	}

	div.svelte-1yk7nd8 p {
		.y {
			color: green;
		}
	}

	/* `div { :global { &.x { ...} } }` is allowed ... */
	div.svelte-1yk7nd8 {
		/* :global {*/
			&.x {
				color: green;
			}
		/*}*/
	}

	/* ...which is equivalent to `div :global { &.x { ...} }` ... */
	div.svelte-1yk7nd8 {
		&.x {
			color: green;
		}
	}

	/* ...so `div :global.x` must be, too ... */
	div.svelte-1yk7nd8.x {
		color: green;
	}

	/* ...and therefore `div { :global.x { ... }` as well */
	div.svelte-1yk7nd8 {
		&.x {
			color: green;
		}
	}

	div.svelte-1yk7nd8 {
		&.x {
			color: green;
		}
	}

	div.svelte-1yk7nd8:is(html.dark-mode *) {
		color: green;
	}

	/* (unused) .unused :global {

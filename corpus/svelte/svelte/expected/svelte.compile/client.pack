			var fragment_1 = $.comment();
			var node_1 = $.first_child(fragment_1);

			$.component(node_1, () => Component, ($$anchor, $$component) => {
				$$component($$anchor, {});
			});

			$.append($$anchor, fragment_1);
		};

		$.if(node, ($$render) => {
			if (shown) $$render(consequent); else $$render(alternate, -1);
		});
	}

	$.append($$anchor, fragment);
}

			input_3,
			() => {
				$.get(flavour);

				return $order().iceCream[index].flavours;
			},
			($$value) => $.store_mutate(order, $.untrack($order).iceCream[index].flavours = $$value, $.untrack($order))
		);

		$.append($$anchor, fragment_1);
	});

	$.reset(form);

	var div = $.sibling(form, 2);
	var text_1 = $.only_child(div, true);

	$.template_effect(($0) => $.set_text(text_1, $0), [() => $order().iceCream[index].flavours.join('+')]);

	$.bind_group(
		binding_group,
		[],
		input,
		() => {
			1;

			return $order().scoops;
		},
		($$value) => $.store_mutate(order, $.untrack($order).scoops = $$value, $.untrack($order))
	);

	$.bind_group(
		binding_group,
		[],
		input_1,
		() => {
			2;

			return $order().scoops;
		},
		($$value) => $.store_mutate(order, $.untrack($order).scoops = $$value, $.untrack($order))
	);

	$.bind_group(
		binding_group,
		[],
		input_2,
		() => {
			3;

			return $order().scoops;
		},
		($$value) => $.store_mutate(order, $.untrack($order).scoops = $$value, $.untrack($order))
	);

	$.append($$anchor, fragment);
	$.pop();
	$$cleanup();
}

var root = $.from_html(`<p> </p> <p> </p>`, 1);
var root_1 = $.from_html(`<p>loading...</p>`);

export default function Main($$anchor, $$props) {
	$.push($$props, true);

	let count = 0;

	const get_promise = () => {
		return sleep(10).then(() => {
			count += 1;


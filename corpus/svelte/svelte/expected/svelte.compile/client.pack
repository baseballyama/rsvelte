	/** @type {{ object?: { count: number }, non_bindable?: { count: number }}} */
	let object = $.prop($$props, 'object', 31, () => $.proxy({ count: 0 })),
		non_bindable = $.prop($$props, 'non_bindable', 23, () => ({ count: 0 }));

	var fragment = root();

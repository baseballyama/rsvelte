			$.append($$anchor, text);
		},
		($$anchor) => {
			$.next();

			var text_1 = $.text('Fallback');

			$.append($$anchor, text_1);
		}
	);

	$.reset(div);

	var button = $.sibling(div, 2);

	$.delegated('click', button, toggle_filter);
	$.append($$anchor, fragment);
}


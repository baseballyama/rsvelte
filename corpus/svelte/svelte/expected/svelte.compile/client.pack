export default function Input($$anchor) {
	var fragment = root_1();
	var x = $.first_child(fragment);
	var y = $.child(x);
	var node = $.sibling($.child(y), 2);

	{
		var consequent = ($$anchor) => {
			var fragment_1 = root();

			$.next(4);
			$.append($$anchor, fragment_1);
		};

		$.if(node, ($$render) => {
			if (foo) $$render(consequent);
		});
	}

	$.reset(y);
	$.reset(x);
	$.next(6);
	$.append($$anchor, fragment);
}

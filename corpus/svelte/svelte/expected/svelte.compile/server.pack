import Child2 from './Child2.svelte';
import Child from './Child.svelte';

export default function Main($$renderer) {
	let loginname = '';
	let password = '';
	let $$settled = true;
	let $$inner_renderer;

	function $$render_inner($$renderer) {
		Child($$renderer, {
			get value() {
				return loginname;

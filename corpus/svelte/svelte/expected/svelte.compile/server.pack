				this.#text = $.derived(() => text + ': ' + this.elapsed);
			}
		}

		let timer = $.derived(() => new Timer('hello'));
		let visible = true;

		$$renderer.push(`<button>toggle</button> <button>run</button> `);

		if (visible) {
			$$renderer.push(`<!--[0--><p>${$.escape(timer().text)}</p>`);
		} else {

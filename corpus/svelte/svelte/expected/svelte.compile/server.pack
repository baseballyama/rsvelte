class SomeLogic {
	#isAboveThree;

	get isAboveThree() {
		return this.#isAboveThree();
	}

	set isAboveThree($$value) {
		return this.#isAboveThree($$value);
	}

	trigger() {
		this.someValue++;
	}

	constructor() {
		this.someValue = 0;
		this.#isAboveThree = $.derived(() => this.someValue > 3);
	}
}

const someLogic = new SomeLogic();


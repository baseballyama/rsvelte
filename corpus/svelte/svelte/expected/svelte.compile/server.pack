=== 1421 packages/svelte/tests/css/samples/container-query/input.svelte	css

	div.svelte-13bwje7 {
		container: test-container / inline-size;
	}

  /* Most common container query statements. */

	@container (min-width: 400px) {
		div.svelte-13bwje7 {
			color: red;
		}
	}

	@container test-container (min-width: 410px) {
		div.svelte-13bwje7 {
			color: green;
		}
	}

	@container test-container (width < 400px) {
		div.svelte-13bwje7 {
			color: blue;
		}
	}

	@container test-container (0 <= width < 300px) {
		div.svelte-13bwje7 {
			color: purple;
		}
	}

	@container not (width < 400px) {
		div.svelte-13bwje7 {
			color: pink;
		}
	}

	@container (width > 400px) and (height > 400px) {
		div.svelte-13bwje7 {
			color: lightgreen;
		}
	}

	@container (width > 400px) or (height > 400px) {
		div.svelte-13bwje7 {
			color: lightblue;
		}
	}

	@container (width > 400px) and (width > 800px) or (orientation: portrait) {
		div.svelte-13bwje7 {
			color: salmon;
		}
	}

	@container style(color: blue) {
		div.svelte-13bwje7 {
			color: tan;
		}
	}

	@container test-container (min-width: calc(400px + 1px)) {
		div.svelte-13bwje7 {
			color: green;
		}
	}

	@container test-container (width < clamp(200px, 40%, 400px)) {
		div.svelte-13bwje7 {
			color: blue;
		}
	}

	@container test-container (calc(400px + 1px) <= width < calc(500px + 1px)) {
		div.svelte-13bwje7 {
			color: purple;
		}
	}

	@container style(--var: calc(400px + 1px)) {
		div.svelte-13bwje7 {
			color: sandybrown;
		}
	}


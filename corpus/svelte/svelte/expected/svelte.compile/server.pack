		let n = each_array[$$index];

		x($$renderer, n);
	}

	$$renderer.push(`<!--]--></div> <div><!--[-->`);

	const each_array_1 = $.ensure_array_like(numbers);

	for (let $$index_1 = 0, $$length = each_array_1.length; $$index_1 < $$length; $$index_1++) {
		let n = each_array_1[$$index_1];

		x($$renderer, n);
	}

	$$renderer.push(`<!--]--></div></div>`);
}

			$$renderer.option({ value: 'a' }, ($$renderer) => {
				$$renderer.push(`A`);
			});

			$$renderer.option({ value: 'b' }, ($$renderer) => {
				$$renderer.push(`B`);
			});
		});

		$$renderer.push(` selected: ${$.escape(entry.selected)}`);
	}

	$$renderer.push(`<!--]-->`);
}

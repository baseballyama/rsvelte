	$$renderer.push(`<!----> `);
	C($$renderer, { 'xml:click': true });
	$$renderer.push(`<!----> `);
	C($$renderer, { 'xmlns:click': true });
	$$renderer.push(`<!----> `);
	C($$renderer, { 'xlink:click': true });
	$$renderer.push(`<!----> <button foo:bar="">click me</button> `);
	C($$renderer, { 'foo:bar': true });
	$$renderer.push(`<!---->`);
}

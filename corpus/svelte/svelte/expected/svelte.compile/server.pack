export default function Input($$renderer) {
	$$renderer.push(`<x class="svelte-rofjrh"><y class="svelte-rofjrh"><z class="svelte-rofjrh"></z> `);

	if (foo) {
		$$renderer.push(`<!--[0--><d class="svelte-rofjrh"></d> <e class="svelte-rofjrh"></e> <f class="svelte-rofjrh"></f>`);

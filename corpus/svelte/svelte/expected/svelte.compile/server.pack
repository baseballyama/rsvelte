	function asd() {
		foo; // trailing

		/* leading comment 1 */
		/* leading comment 2 */
		/* leading comment 3 */
		bar;

		/* trailing comment 1 */
		/* trailing comment 2 */
		/* trailing comment 3 */
	}

	const array = [
		// leading comment 1
		// leading comment 2
		1 // trailing comment 1

		/* trailing comment 2 */
	];

	const object = {
		// leading comment 1
		// leading comment 2

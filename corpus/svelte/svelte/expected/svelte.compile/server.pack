=== 627 packages/svelte/tests/runtime-browser/custom-elements-samples/element-effect-context/main.svelte	js
import * as $ from 'svelte/internal/server';

class Tracking extends HTMLElement {
	static observedAttributes = ["count"];
	tracking = false;

	set count(_) {
		this.tracking = false;
		this.render();
	}

	constructor() {
		super();
		this.attachShadow({ mode: 'open' });
	}

	render() {
		this.shadowRoot.innerHTML = `<p>${this.tracking}</p>`;

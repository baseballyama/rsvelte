    secondNonStore,
    thirdNonStore,
    firstStore,
    secondStore,
    thirdStore;
  [
    firstNonStore,
    secondNonStore,
    thirdNonStore,
    firstStore,
    secondStore,
    thirdStore,
  ] = $bagOlStores;

  function changeStores() {
    $bagOlStores = [
      firstNonStore,
      secondNonStore,
      thirdNonStore,
      firstStore,
      $secondStore,
      thirdStore,
    ] = [7, 8, 9, writable(10), 11, writable(12), writable(14), writable(15)];
  }
</script>


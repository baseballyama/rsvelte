  import { onMount } from "svelte";
  import Child from "./Child.svelte";

  let updateCounter = 0;
  let promiseResolve;
  export const done = new Promise((resolve) => {
    promiseResolve = resolve;
  });
  export const getCounter = () => {
    return updateCounter;
  };

  let vals = [1, 2, 3];
  const instances = [];
  let count = 3;

  const increment = () => {
    ++updateCounter;

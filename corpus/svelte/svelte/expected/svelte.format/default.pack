<script>
  let tag = $state("button");
  let values = $state({ a: "red", b: "red", c: "red", d: "red" });

  let count = 0;
  const factory = (name) => {
    count++;
    // check that spread effects are isolated from each other
    if (count > 8) throw new Error("too many calls");

    return {
      class: values[name],
      onclick: () => {
        values[name] = "blue";
      },
    };
  };

<script lang="ts">
  class Item {
    product: number;

    constructor(n: number) {
      this.product = $derived(multiplier * n);
    }
  }

  let numbers = $state([1, 2, 3]);
  let multiplier = $state(1);

  let items = $derived(numbers.map((n) => new Item(n)));
  let products = $derived(items.map((item) => item.product));
</script>


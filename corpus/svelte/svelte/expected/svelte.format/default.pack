<script>
  let data = $state({ items: [] });

  function fetchData() {
    data = {
      items: [
        {
          id: 1,
          price: 1,
          name: "test",
        },
        {
          id: 2,
          price: 2,
          name: "test 2",
        },
      ],
    };
  }

  fetchData();

  function copyItems(original) {
    return [...original.map((item) => ({ ...item }))];
  }

  let items = $state();

  $effect(() => {
    items = copyItems(data.items);
  });
</script>


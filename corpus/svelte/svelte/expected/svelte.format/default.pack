=== 643 packages/svelte/tests/runtime-legacy/samples/attribute-custom-element-inheritance/main.svelte	svelte
<script>
  class MyCustomElement extends HTMLElement {
    constructor() {
      super();
      this._obj = null;
      this._text = null;
    }

    set text(text) {
      this._text = text;
      this.render();
    }

    set camelCase(obj) {
      this._obj = obj;
      this.render();
    }

    connectedCallback() {
      this.render();
    }

    render() {
      this.innerHTML = "Hello " + this._obj.text + this._text;
    }
  }

  class Extended extends MyCustomElement {}

  window.customElements.define("my-custom-inheritance-element", Extended);
</script>

<my-custom-inheritance-element camelCase={{ text: "World" }} text="!" />


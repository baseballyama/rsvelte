		showCompass = $.prop($$props, 'showCompass', 3, true),
		showZoom = $.prop($$props, 'showZoom', 3, true),
		visualizePitch = $.prop($$props, 'visualizePitch', 3, false);

	let control = $.state(void 0);

	$.user_pre_effect(() => {
		if ($.get(map) && !$.get(control)) {

		let { class: className = '', close } = $$props;

		const examples = [
			{ href: '/examples/basic', title: `Plain Map` },
			{ href: '/examples/marker', title: `Default Markers` },
			{ href: '/examples/custom_marker', title: `Custom Markers` },
			{

					type: 'Feature',
					properties: { image: 'quake' },
					geometry: { type: 'Point', coordinates: [-127.5, 45.5] }
				},

				{
					type: 'Feature',
					properties: { image: 'tsunami' },
					geometry: { type: 'Point', coordinates: [-91.6, 28.7] }
				}
			]
		};


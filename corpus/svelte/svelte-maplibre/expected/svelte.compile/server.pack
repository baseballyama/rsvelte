				});
			},
			'svelte-r0s2ik'
		);

		$$renderer.push(`</div> `);

		MapLibre($$renderer, {
			style: style(),
			class: mapClasses,
			standardControls: true,
			center: [-98.137, 40.137],
			zoom: 3,
			images: [
				{ id: 'quake', url: quakeImageUrl },
				{ id: 'tsunami', url: tsunamiImageUrl }

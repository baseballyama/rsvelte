			'icon-sm': 'size-8 rounded-[min(var(--radius-md),10px)] in-data-[slot=button-group]:rounded-md',
			'icon-lg': 'size-10'
		}
	},
	defaultVariants: { variant: 'default', size: 'default' }
});

export default function Button($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let {
			class: className,
			variant = 'default',
			size = 'default',
			ref = null,
			href = undefined,
			type = 'button',
			disabled,
			children,
			$$slots,
			$$events,
			...restProps
		} = $$props;


			($$renderer) => {
				$$renderer.option({ value: 'light' }, ($$renderer) => {
					$$renderer.push(`Light`);
				});

				$$renderer.option({ value: 'dark' }, ($$renderer) => {
					$$renderer.push(`dark`);
				});

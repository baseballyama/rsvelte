				RasterTileSource($$renderer, {
					tiles: [url()],
					tileSize: 256,
					children: ($$renderer) => {
						RasterLayer($$renderer, { paint: { 'raster-opacity': 0.5 } });
					},
					$$slots: { default: true }
				});
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> `);
		CodeSample($$renderer, { code });
		$$renderer.push(`<!---->`);
	});
}

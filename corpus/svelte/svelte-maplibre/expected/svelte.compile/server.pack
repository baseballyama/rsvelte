		$$renderer.push(`<!--]--> <p class="mt-2 px-2 text-sm"><a class="hover:text-primary underline underline-offset-4" href="https://github.com/dimfeld/svelte-maplibre">Github</a></p></nav>`);

		if ($$store_subs) $.unsubscribe_stores($$store_subs);

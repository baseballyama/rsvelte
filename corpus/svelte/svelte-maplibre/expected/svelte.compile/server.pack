		// [longitude, latitude]
		// RGB values
		// RGB values
		function calculateArcs(fc) {
			let centers = new Map(fc.features.map((f) => [f.properties?.GEOID, geoCentroid(f)]));
			let count = fc.features.length > 100 ? 5000 : 100;


					$$slots: { default: true }
				});

				$$renderer.push(`<!----> `);
				Terrain($$renderer, { source: 'terrainSource', exaggeration: terrainExaggeration });
				$$renderer.push(`<!----> `);

				TerrainControl($$renderer, {
					source: 'terrainSource',

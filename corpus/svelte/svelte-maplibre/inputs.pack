  class={cn(
    'overflow-x-auto rounded-lg border border-white/10 bg-[#0d1117] p-4 text-sm leading-relaxed shadow-sm',
    className
  )}><code class="hljs language-{language} !bg-transparent !p-0">{@html highlighted}</code></pre>


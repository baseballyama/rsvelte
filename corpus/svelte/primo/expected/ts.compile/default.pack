=== 1269 src/lib/pocketbase/OrderedSvelteMap.ts	js
import { SvelteMap } from 'svelte/reactivity';
/**
 * SvelteMap that determines order based initial "set" call. Calls to set with
 * existing id, aka. overwrites, does not change the order.
 */
export class OrderedSvelteMap extends SvelteMap {
    order = [];
    *iterator() {
        for (const key of this.order) {
            const value = super.get(key);
            yield [key, value];
        }
    }
    forEach(callbackfn) {
        for (const [key, value] of this.iterator()) {
            callbackfn(value, key, this);
        }
    }
    set(key, value) {
        if (!this.order.includes(key)) {
            this.order.push(key);
        }
        super.set(key, value);
        return this;
    }
    delete(key) {
        this.order = this.order.filter((k) => k !== key);
        return super.delete(key);
    }
    clear() {
        this.order = [];
        super.clear();
    }
    *keys() {
        super.keys();
        for (const [key] of this.iterator())
            yield key;
    }
    *values() {
        super.values();
        for (const [, value] of this.iterator())
            yield value;
    }
    entries() {
        super.entries();
        return this.iterator();
    }
    [Symbol.iterator]() {
        return this.entries();
    }
}


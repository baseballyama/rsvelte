import { untrack } from 'svelte';
export const useSvelteWorker = (ready, loaded, work) => {
    let status = $state('standby');
    let parameters;
    let done;
    $effect(() => {
        if (status === 'waiting' && ready()) {
            status = 'standby';
        }
        else if (status === 'standby' && !ready()) {
            status = 'waiting';
        }
        if (status === 'loading' && loaded()) {
            status = 'working';
            untrack(() => Promise.resolve()
                .then(() => work(...parameters))
                .then((value) => done?.(null, value))
                .catch((error) => done?.(error)));
        }
    });
    return new (class {
        status = $derived(status);
        async run(...params) {
            parameters = params;
            if (status === 'standby') {
                status = 'loading';
            }
            else {
                throw new Error('Cannot run, worker not in standby');
            }
            return new Promise((resolve, reject) => {
                done = (error, value) => {
                    status = 'standby';
                    if (error) {
                        reject(error);
                    }
                    else {
                        resolve(value);
                    }
                };
            });
        }
    })();
};


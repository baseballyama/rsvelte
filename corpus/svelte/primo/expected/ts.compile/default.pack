            }
            else if (change && change.operation === 'update' && !change.committed) {
                // Reset position of the change to place it the last
                changes.delete(id);
                changes.set(id, 
                // Create a new operation object to ensure reactivity
                {
                    collection: name,
                    operation: 'update',
                    committed: false,
                    data: { ...change.data, ...values }
                });
            }

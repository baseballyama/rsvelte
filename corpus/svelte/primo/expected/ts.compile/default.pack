    if (!error || typeof error !== 'object') {
        return `CSS Error: ${baseMessage}`;
    }
    const positions = [];
    if ('line' in error && typeof error.line === 'number') {
        positions.push(`line ${error.line}`);
    }
    if ('column' in error && typeof error.column === 'number') {
        positions.push(`column ${error.column}`);
    }
    const suffix = positions.length ? ` (${positions.join(', ')})` : '';
    return `CSS Error: ${baseMessage}${suffix}`;
}

=== 633 src/lib/builder/utils/popper-fix.ts	js
export const offsetByFixedParents = {
    name: 'offsetByFixedParents',
    enabled: true,
    phase: 'read',
    fn: ({ state }) => {
        if (state.options.strategy !== 'fixed') {
            return;
        }
        let el = state.elements.reference;
        while (el.parentElement) {
            if (getComputedStyle(el.parentElement).position === 'fixed') {
                const rect = el.parentElement.getBoundingClientRect();
                state.modifiersData.popperOffsets.x -= rect.x;
                state.modifiersData.popperOffsets.y -= rect.y;
            }
            el = el.parentElement;
        }
    }
};


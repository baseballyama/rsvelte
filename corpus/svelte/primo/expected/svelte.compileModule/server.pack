/* Worker.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { untrack } from 'svelte';

export const useSvelteWorker = (ready, loaded, work) => {
	let status = 'standby';
	let parameters;
	let done;

	return new (class {
		#status = $.derived(() => status);

		get status() {
			return this.#status();
		}

		set status($$value) {
			return this.#status($$value);
		}

		async run(...params) {
			parameters = params;

			if (status === 'standby') {
				status = 'loading';
			} else {
				throw new Error('Cannot run, worker not in standby');
			}

			return new Promise((resolve, reject) => {
				done = (error, value) => {
					status = 'standby';

					if (error) {
						reject(error);
					} else {
						resolve(value);
					}
				};
			});
		}
	})();
};

		}

		.error-body:where(.svelte-sjqicf) code:where(.svelte-sjqicf) {
			display: block;
			white-space: pre-wrap;
			word-break: break-word;
		}

		.block-data:where(.svelte-sjqicf) {
			background: var(--color-gray-9);
			border-bottom: 1px solid var(--color-gray-8);
		}

		.block-data-header:where(.svelte-sjqicf) {
			display: flex;
			align-items: center;
			width: 100%;
			gap: 0.25rem;
			padding: 5px;
			background: var(--color-gray-9);
			color: #eee;
			font-size: 0.675rem;
			cursor: pointer;
			transition: var(--transition-colors);

			&:hover {
				background: var(--color-gray-8);
			}

			.chevron:where(.svelte-sjqicf) {
				display: flex;
				align-items: center;
				transition: transform 0.1s;
			}

			.chevron.rotated:where(.svelte-sjqicf) {

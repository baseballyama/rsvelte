		justify-content: center;
		z-index: 5;
		--Spinner-font-size: 3rem;
		--Spinner-color: var(--primo-primary-color);
		--Spinner-color-opaque: rgba(248, 68, 73, 0.2);
	}
	main.svelte-wiu0gb {
		padding: 0;
		background-color: var(--color-gray-950);
		transition: 0.2s opacity;
		opacity: 0;
		border-top: 0;
		height: 100%;
		overflow-y: auto;
		box-sizing: border-box;
	}

	.page-content.svelte-wiu0gb {
		padding: 1rem 0.5rem;
		min-height: 100%;
	}

	.head-editor-container.svelte-wiu0gb {
		margin-bottom: 1rem;
	}

	.resize-handle.svelte-wiu0gb {
		display: flex;
		justify-content: center;
		align-items: center;
		height: 8px;
		background: var(--color-gray-900);
		border-top: 1px solid var(--color-gray-800);
		border-bottom: 1px solid var(--color-gray-800);
		cursor: row-resize;
		user-select: none;
		-webkit-user-select: none;
		margin-top: -1px;
	}

	.resize-handle.svelte-wiu0gb:hover,
	.resize-handle.resizing.svelte-wiu0gb {
		background: var(--color-gray-800);
	}

	.resize-handle.svelte-wiu0gb .grab-handle:where(.svelte-wiu0gb) {
		color: var(--color-gray-600);
		transition: color 0.2s;
		transform: rotate(90deg);
	}

	.resize-handle.svelte-wiu0gb:hover .grab-handle:where(.svelte-wiu0gb),
	.resize-handle.resizing.svelte-wiu0gb .grab-handle:where(.svelte-wiu0gb) {
		color: var(--color-gray-400);
	}

	.zones-container.svelte-wiu0gb {
		padding: 0;
	}

	main.fadein.svelte-wiu0gb {
		opacity: 1;
	}
	main.dragging.svelte-wiu0gb iframe {
		pointer-events: none !important;
	}
	main.resizing-editor.svelte-wiu0gb [data-section]:where(.svelte-wiu0gb) {
		pointer-events: none !important;
	}

	.page-zone.svelte-wiu0gb {
		padding: 0.5rem;
		position: relative;
		border: 2px dashed rgba(255, 255, 255, 0.1);
		transition: all 0.2s ease;

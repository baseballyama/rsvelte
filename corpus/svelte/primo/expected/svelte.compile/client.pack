=== 2086 src/lib/builder/views/editor/ToolbarButton.svelte	css

	/* @tailwind base; */

	.primo-button.svelte-1kqoqrl {
		font-size: 0.85rem;
		user-select: none;
		/* border: 1px solid var(--color-gray-8); */
		--Spinner-size: 0.75rem;

		/* &:first-child {
      border-top-left-radius: var(--primo-border-radius);
      border-bottom-left-radius: var(--primo-border-radius);
    }

    &:last-child {
      border-top-right-radius: var(--primo-border-radius);
      border-bottom-right-radius: var(--primo-border-radius);
    } */

		&[disabled] {
			background: none;
			opacity: 0.35;
			pointer-events: none;
		}
	}

	.primo-button.primo.svelte-1kqoqrl {
		box-shadow: var(--primo-ring-thin);
		color: var(--primo-color-white);
		transition: 0.1s;
		/* border: 1.5px solid var(--primo-primary-color); */
		/* border-radius: 0.25rem; */

		&:hover {
			background: var(--primo-primary-color);
			color: white;
		}
	}

	.primo-button.svelte-1kqoqrl {
		padding: 6px 10px;
		border-radius: 2px;
		color: var(--primo-color-white);
		font-weight: 400;
		font-size: 0.75rem;
		height: 100%;
		transition: 0.1s box-shadow;
		outline: 0;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;

		&.has-icon-button {
			/* padding: 10px; */

			svg {
				width: 1rem;
				height: auto;
			}
		}

		&:hover,
		&:focus {
			/* background: var(--primo-color-codeblack); */
			background: var(--primo-color-codeblack);
			/* z-index: 2; */
		}

		&:active {
			background: #404040;
			/* box-shadow: var(--primo-ring); */
			/* background: var(--primo-primary-color); */
			/* color: var(--color-gray-8); */
		}
	}

	.primo-button[disabled].svelte-1kqoqrl {
		opacity: 0.1;
		cursor: default;
		transition: var(--transition-colors);

		&:hover,
		&:focus {
			box-shadow: none;
		}
	}

	@keyframes svelte-1kqoqrl-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.key-hint.svelte-1kqoqrl {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.75rem;
		pointer-events: none;
		white-space: nowrap;
	}


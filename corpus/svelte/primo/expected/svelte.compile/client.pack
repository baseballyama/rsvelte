		z-index: 0;
	}
	button.svelte-uxy6ld {
		margin: auto 0.5rem;
		display: flex;
		justify-content: center;
		color: white;
		font-size: 0.875rem;
		position: relative;
		border: 1px solid var(--color-gray-8);

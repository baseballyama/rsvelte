				return $.get(formatted_value);
			},
			oninput: (text) => $$props.onchange({ [$$props.field.key]: { 0: { value: text } } }),
			type: 'date'
		}));
	});

	$.reset(div);
	$.append($$anchor, div);
	$.pop();
}

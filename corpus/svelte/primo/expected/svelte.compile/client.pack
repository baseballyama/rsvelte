			color: #b6b6b6;
			display: grid;
			gap: 0.5rem;
			font-size: 0.875rem;
			font-weight: 400;
		}

		input:where(.svelte-g40i6i) {
			color: #dadada;
			border-radius: 0.25rem;
			border: 1px solid #6e6e6e;
			padding: 0.75rem;
			background-color: #1c1c1c;
			font-size: 1rem;

			&:focus {
				outline: none;
				border-color: #ff6b35;
			}
		}

		.button:where(.svelte-g40i6i) {
			color: #cecece;
			font-weight: 500;
			display: flex;
			flex-direction: row;
			justify-content: center;
			align-items: center;
			padding: 0.65rem;
			border: 1.5px solid #ff6b35;
			border-radius: 0.25rem;
			position: relative;
			transition: 0.2s;

			&:not(:disabled):hover {
				background-color: #ff6b35;
				color: #121212;
			}

			&:disabled {
				opacity: 0.75;
				cursor: not-allowed;
				color: #6e6e6e !important;
				border-color: #444 !important;
				background-color: #2a2a2a !important;
				pointer-events: none;
			}

			.invisible:where(.svelte-g40i6i) {
				visibility: hidden;
			}

			@keyframes svelte-g40i6i-spin {
				from {
					transform: rotate(0deg);
				}
				to {
					transform: rotate(360deg);
				}
			}
		}
	}

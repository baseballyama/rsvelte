			});

			$.append($$anchor, fragment);
		};

		var alternate = ($$anchor) => {
			Icon($$anchor, { icon: 'mage:dashboard-fill' });
		};

		$.if(node, ($$render) => {
			if ($loadingSite()) $$render(consequent); else $$render(alternate, -1);
		});
	}

	$.reset(a);
	$.template_effect(($0) => $.set_attribute(a, 'href', $0), [() => get_dashboard_url()]);
	$.append($$anchor, a);
	$$cleanup();
}

			/* border-bottom-color: var(--primo-primary-color); */
		}

		&.showing_key_hint .label:where(.svelte-uxy6ld) {
			visibility: hidden;
		}

		.key-hint:where(.svelte-uxy6ld) {
			font-size: 12px;
			position: absolute;
		}

		.label:where(.svelte-uxy6ld) {
			display: flex;
			align-items: center;
			gap: 0.25rem;
		}
	}


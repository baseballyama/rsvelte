		opacity: 0;
		border: 0;
		transition: opacity 0.2s;
		background: var(--primo-color-white);
		height: 100%;
		width: 100%;
		transform-origin: top left;
	}
	.fadein.svelte-sjqicf {
		opacity: 1;
	}
	.preview-container.svelte-sjqicf {
		background: var(--primo-color-white);
		border: 2px solid var(--color-gray-8);
		overflow: hidden;

	.page-zone.header-zone.svelte-wiu0gb {
		border-style: solid;
		margin-bottom: 1rem;
	}

	.page-zone.header-zone.dragging-over.svelte-wiu0gb {
		border-color: rgba(59, 130, 246, 0.8) !important;
	}

	.page-zone.body-zone.svelte-wiu0gb {

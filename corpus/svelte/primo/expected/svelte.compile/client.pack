	.BlockToolbar.svelte-15zkeyd {
		box-shadow: inset 0 0 0 4px var(--color-gray-8);
		z-index: 999;
		position: fixed;
		pointer-events: none;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		font-size: 0.875rem;
	}
	.component-button.svelte-15zkeyd {
		height: 100%;
		display: flex;
		left: 0px;

		button:where(.svelte-15zkeyd) {
			display: flex;
			font-size: 0.875rem;
			gap: 0.25rem;
		}

		button:where(.svelte-15zkeyd):last-child {
			border-bottom-right-radius: 0.25rem;
		}
	}

	.top-right.svelte-15zkeyd {
		display: flex;
	}

	.block-id.svelte-15zkeyd {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.5rem;
		pointer-events: all;
		background: rgba(0, 0, 0, 0.9);
		color: white;
		font-size: 0.75rem;
	}

	.button-delete.svelte-15zkeyd {
		border-bottom-left-radius: 0.25rem;
		padding-left: 0.75rem;
		padding-right: 0.75rem;
	}

	button.svelte-15zkeyd {
		pointer-events: all;
		padding: 0.5rem 1rem;
		display: flex;
		justify-content: center;
		align-items: center;
		font-size: 1rem;
		/* height: 2rem; */
		/* color: var(--primo-color-white); */
		/* background-color: var(--primo-color-black-opaque); */
		background: var(--primo-color-codeblack);

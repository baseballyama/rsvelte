			display: flex;
			align-items: center;
			margin-right: 1rem;
		}

		input:where(.svelte-a16uxj),
		textarea:where(.svelte-a16uxj) {
			font-size: 0.875rem;
			flex: 1;
			background: transparent;
			width: 100%;


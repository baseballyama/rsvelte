				children: ($$renderer) => {
					$$renderer.push(`<span>${$.escape(button.label)}</span> `);

					if (button.icon) {
						$$renderer.push('<!--[0-->');

						if (button.icon) {
							$$renderer.push('<!--[-->');
							button.icon($$renderer, {});
							$$renderer.push('<!--]-->');
						} else {

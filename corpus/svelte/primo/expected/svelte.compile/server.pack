			$$renderer.push(`<!--[0--><iframe tabindex="-1"${$.attr_class('w-[1024px] rounded overflow-hidden bg-white svelte-d5jpdx', void 0, { 'fadein': iframeLoaded })} title="site preview"${$.attr('src', src ?? `/?_site=${site.id}`)}${$.attr_style('', {

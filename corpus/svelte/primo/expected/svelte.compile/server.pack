			$$renderer.push(`<!--[!--><p class="empty-description svelte-aei9lh">`);

			if ($.store_get($$store_subs ??= {}, '$current_user', current_user)?.siteRole === 'developer') {
				$$renderer.push(`<!--[0-->When you create fields, they'll be editable from here`);
			} else {

import * as $ from 'svelte/internal/server';
import { Skeleton } from '$lib/components/ui/skeleton';

export default function Masonry($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let {
			items,
			loading = false,
			class: className = '',
			columnCount = null,

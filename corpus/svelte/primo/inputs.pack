							<button
								onclick={() => {
									add_language(loc.key)
									addingLanguage = false
								}}
								class="option"
								class:active={loc.key === $locale}
							>
								{loc.name} ({loc.key})
							</button>
						{/each}
					</div>
				</div>
			{/if}
		</div>
	{/if}

									}
								} else {
									nextConfig = null
								}
								// Immediately reflect the auto-selected type in the UI select
								selected_field_type_id = nextType
								// config updates handled via onchange
							}
						}

						onchange({
							id: field.id,
							data: {
								label: text,
								key: key_edited ? field.key : validate_field_key(text),
								type: nextType,
								config: nextConfig
							}

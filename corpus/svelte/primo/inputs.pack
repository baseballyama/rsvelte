		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.2rem;
		transition: background-color 0.2s;
	}

	.edit-button {
		background: rgba(0, 0, 0, 0.6);

		flex: 1;

		&:hover {
			background: rgba(0, 0, 0, 0.8);
		}
	}

	.delete-button {

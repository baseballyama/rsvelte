        if (!transactions)
            return;
        transactions.forEach((transaction) => {
            transaction.write(transaction.object, transaction.historicValue);
        });
        this.undoneQueue.push(transactions);
        this.onUndoCallbacks.forEach((callback) => {
            callback(transactions);

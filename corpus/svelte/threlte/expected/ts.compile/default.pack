        // before pointerover/pointerenter on newly hit objects.
        if (isPointerMove)
            cancelPointer(hits);
        let stopped = false;
        // loop through all hits and dispatch events
        dispatchEvents: for (const hit of hits) {
            const events = dispatchers.get(hit.eventObject);
            if (events === undefined)
                continue;
            const intersectionEvent = {
                stopped,
                ...hit,

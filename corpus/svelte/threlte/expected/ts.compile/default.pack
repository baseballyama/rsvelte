import { Color, PerspectiveCamera, Scene, Texture } from 'three';
import { levels } from './scenes/levels';
import { Sound } from './sound';
class Game {
    state = $state('off');
    sound = new Sound();
    levelIndex = $state(0);
    score = $state(0);
    gameOver = $state(false);
    playerPosition = $state(0);
    ballPosition = $state({
        x: 0,
        z: 0
    });
    baseColor = $derived.by(() => {
        if (this.state == 'outro')
            return 'green';
        return 'red';
    });
    muted = $state(false);
    blinkClock = $state(0);
    arcadeMachineScene = $state();
    averageScreenColor = $state(new Color('black'));
    gameScene = $state();
    gameCamera = $state();
    gameTexture = $state();
    ballRigidBody = $state();
    debug = $state(false);
    orbitControls = $state(false);
    restart() {
        this.reset();
        this.state = 'menu';
    }
    reset() {
        this.state = 'intro';
        this.levelIndex = 0;
        this.gameOver = false;
        this.score = 0;
        this.playerPosition = 0;
        this.ballPosition = {
            x: 0,
            z: 0
        };
    }
    nextLevel() {
        if (this.levelIndex < levels.length - 1) {
            this.levelIndex += 1;
            this.state = 'level-loading';
        }
        else {
            this.state = 'outro';
        }
    }
    switchOff() {
        this.reset();
        this.state = 'off';
    }
    /**
     * Optionally resets the game and starts it again
     */
    startGame() {
        this.state = 'level-loading';
    }
}
export const game = new Game();


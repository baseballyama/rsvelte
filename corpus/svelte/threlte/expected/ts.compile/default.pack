import colors from 'kleur';
export var Context;
(function (Context) {
    Context["ErrorTransformingStaticState"] = "Error transforming static state";
    Context["ErrorCompilingComponent"] = "Error compiling component";
    Context["NoTComponentFound"] = "No <T> component found";
})(Context || (Context = {}));
const parseErrorMessage = (error) => {
    try {
        return 'message' in error && typeof error.message === 'string'
            ? error.message
            : error.toString();
    }
    catch {
        return undefined;
    }
};
export const logError = (options) => {
    const { moduleId, context, error } = options;
    let log = `Threlte Studio: ${context}`;
    if (error) {
        log += `: ${parseErrorMessage(error)}`;
    }
    if (moduleId) {
        log += `, module id: ${moduleId}`;
    }
    console.warn(colors.red(log));
};


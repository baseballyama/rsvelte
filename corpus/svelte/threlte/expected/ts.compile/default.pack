=== 5512 apps/docs/src/components/Menu/LeftSidebar/getLeftSidebarMenu.ts	js
import { getCollection } from 'astro:content';
const referenceSidebarMenuCategoryOrder = [
    '@threlte/core',
    '@threlte/extras',
    '@threlte/gltf',
    '@threlte/rapier',
    '@threlte/theatre',
    '@threlte/xr',
    '@threlte/flex',
    '@threlte/studio',
    'Documentation'
];
const getReferenceSidebarMenu = async () => {
    const referenceCollection = await getCollection('reference');
    const categoryNames = [...new Set(referenceCollection.map((item) => item.data.category))];
    const categories = categoryNames.map((category) => {
        const items = referenceCollection.filter((item) => item.data.showInSidebar && item.data.category === category);
        let menuItems;
        if (category === '@threlte/extras') {
            const ungrouped = items
                .filter((item) => !item.data.group && !item.data.isDivider)
                .sort((a, b) => a.data.title.localeCompare(b.data.title))
                .map((item) => ({
                title: item.data.title,
                slug: item.id,
                isDivider: false
            }));
            const groupMap = new Map();
            for (const item of items) {
                if (!item.data.group)
                    continue;
                if (!groupMap.has(item.data.group))
                    groupMap.set(item.data.group, []);
                groupMap
                    .get(item.data.group)
                    .push({ title: item.data.title, slug: item.id, isDivider: false });
            }
            for (const groupItems of groupMap.values()) {
                groupItems.sort((a, b) => a.title.localeCompare(b.title));
            }
            const sortedGroups = [...groupMap.entries()].sort(([a], [b]) => a.localeCompare(b));
            menuItems = [
                ...ungrouped,
                ...sortedGroups.flatMap(([group, groupItems]) => [
                    { title: group, slug: '', isDivider: true },
                    ...groupItems
                ])
            ];
        }
        else {
            menuItems = items
                .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
                .map((item) => ({
                title: item.data.title,
                slug: item.id,
                isDivider: item.data.isDivider ?? false
            }));
        }
        return {
            urlPrefix: '/docs/reference',
            menuItems,
            title: category
        };
    });
    categories.sort((a, b) => {
        return (referenceSidebarMenuCategoryOrder.indexOf(a.title) -
            referenceSidebarMenuCategoryOrder.indexOf(b.title));
    });
    return {
        categories
    };
};
const learnSidebarMenuCategoryOrder = [
    'Getting Started',
    'Basics',
    'Advanced',
    'More',
    'Preprocessing'
];
const getLearnSidebarMenu = async () => {
    const learnCollection = await getCollection('learn');
    const categoryNames = [...new Set(learnCollection.map((item) => item.data.category))];
    const categories = categoryNames.map((category) => {
        const menuItems = learnCollection
            .filter((item) => item.data.showInSidebar && item.data.category === category)
            .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
            .map((item) => {
            return {
                title: item.data.title,
                slug: item.id,
                isDivider: item.data.isDivider ?? false
            };
        });
        return {
            urlPrefix: '/docs/learn',
            menuItems,
            title: category
        };
    });
    categories.sort((a, b) => {
        return (learnSidebarMenuCategoryOrder.indexOf(a.title) -
            learnSidebarMenuCategoryOrder.indexOf(b.title));
    });
    return {
        categories
    };
};
const getExamplesSidebarMenu = async () => {
    const learnCollection = await getCollection('examples');
    // Trying to find the category names by looking at the directory structure. An
    // example in the dir 'src/content/examples/Animation System/transitions.mdx'
    // would have a category name of "Animation System".
    const categoryNames = [
        ...new Set(learnCollection
            .filter((item) => {
            // only use items that are nested in a subdirectory
            return item.id.split('/').length > 1;
        })
            .map((item) => {
            return item.id.split('/')[0];
        }))
    ].sort((a, b) => a.localeCompare(b));
    const categories = categoryNames.map((category) => {
        const menuItems = learnCollection
            .filter((item) => item.id.startsWith(category))
            .map((item) => {
            // Removes the file extension from item.id and finds last item in array
            // when splitting on '/'. This is the title of the example.
            const title = item.id.split('/').pop()?.split('.')[0];
            return {
                title,
                slug: item.id,
                isDivider: false
            };
        })
            .sort((a, b) => a.title.localeCompare(b.title));
        return {
            urlPrefix: '/docs/examples',
            menuItems,
            title: category
        };
    });
    return {
        categories
    };
};
export const getLeftSidebarMenu = async () => {
    const reference = await getReferenceSidebarMenu();
    const learn = await getLearnSidebarMenu();
    const examples = await getExamplesSidebarMenu();
    return {
        reference,
        learn,
        examples
    };
};


export const readStick = (pad, mapping, defaultXAxis, defaultYAxis) => {
    const xAxis = mapping?.xAxis ?? defaultXAxis;
    const yAxis = mapping?.yAxis ?? defaultYAxis;
    const x = (pad.axes[xAxis] ?? 0) * (mapping?.invertX ? -1 : 1);

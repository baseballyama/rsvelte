        this.needsSort = true;
    }
    remove(key) {
        const removeKey = this.getKey(key);
        // check if it's an unlinked vertex
        const unlinkedVertex = this.isolatedVertices.get(removeKey);
        if (unlinkedVertex) {
            this.isolatedVertices.delete(removeKey);

export const parsePropLabel = (alphaNumericKey, propValue) => {
    let label = alphaNumericKey;
    if (typeof propValue === 'string') {
        label = propValue;
    }
    else if (typeof propValue === 'object') {
        label = propValue.label || alphaNumericKey;
    }
    return label;
};


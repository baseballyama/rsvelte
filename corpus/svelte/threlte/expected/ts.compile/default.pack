import { getContext } from 'svelte';
import { pluginContextKey } from '../../../plugins/types.js';
export const usePlugins = (args) => {
    const plugins = getContext(pluginContextKey);
    if (!plugins)
        return;
    const pluginsProps = [];
    const pluginsArray = Object.values(plugins);

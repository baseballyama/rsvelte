};
/**
 * Stringifies any value with a set precision (default 4).
 */
const stringifyAttributeValue = (value, precision = 4) => {
    const reducedPrecision = JSON.parse(JSON.stringify(value, (_, val) => {
        return val.toFixed ? Number(val.toFixed(precision)) : val;

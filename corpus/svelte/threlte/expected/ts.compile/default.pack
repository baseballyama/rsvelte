import { MathUtils } from 'three';
export const FIELD_WIDTH = 6;
export const FIELD_HEIGHT = 10;
export const CHANNEL_X = FIELD_WIDTH / 2 - 0.32;
export const CHANNEL_TOP_Y = FIELD_HEIGHT / 2 - 2.2;

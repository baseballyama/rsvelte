<script lang="ts">
  import { T } from "@threlte/core";
  import {
    Environment,
    Grid,
    OrbitControls,
    ShadowAlpha,
    transitions,
  } from "@threlte/extras";
  import { fade, scale } from "./transitions";

  transitions();

  let { red, blue }: { red: boolean; blue: boolean } = $props();
</script>

{#if red}
  <T.Mesh castShadow transition={scale(0)} position.y={1} position.x={-1.5}>
    <T.SphereGeometry />
    <T.MeshStandardMaterial transparent color="red" />
    <ShadowAlpha />
  </T.Mesh>
{/if}

{#if blue}
  <T.Mesh castShadow position.y={1} position.x={1.5}>
    <T.SphereGeometry />
    <T.MeshToonMaterial transparent transition={fade()} color="blue" />
    <ShadowAlpha />
  </T.Mesh>
{/if}


<script lang="ts">
  import { T } from "@threlte/core";
  import { Edges, HTML, Text, useGamepad, useTexture } from "@threlte/extras";
  import { fly } from "svelte/transition";
  import { Spring } from "svelte/motion";
  import { Color } from "three";


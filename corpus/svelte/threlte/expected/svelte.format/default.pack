    linearDamping={1}
    angularDamping={1}
    onsleep={() => sleepingObjects++}
  >
    <AutoColliders>
      <T.Mesh castShadow receiveShadow>
        <T.MeshStandardMaterial color="blue" />
        <T.BoxGeometry />
      </T.Mesh>
    </AutoColliders>

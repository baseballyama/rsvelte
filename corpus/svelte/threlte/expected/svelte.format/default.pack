  import Rope from "./Rope.svelte";

  let {
    debug,
    damping,
    segments,
  }: { debug: boolean; damping: number; segments: number } = $props();

  interactivity();

  let ropeEnd = $state<Vector3Tuple>([0, 0, 0]);

  const onpointermove = (e: IntersectionEvent<PointerEvent>) => {
    e.point.x -= 0.2;
    ropeEnd = e.point.toArray();
  };
</script>


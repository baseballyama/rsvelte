      polarAngle: 1,
      azimuthLocked: true,
      azimuthAngle: 0,
      pointerLock: false,
      lookAtOffset: [0, 0.8, 0],
      deadZone: [0, 0],
      lookAhead: 0.4,
      followSmoothTime: 0.05,
      trackRotation: false,

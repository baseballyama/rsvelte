    <AutoColliders>
      <T.Mesh castShadow receiveShadow>
        <T.MeshStandardMaterial color="red" transparent opacity={0.4} />
        <T.BoxGeometry />
      </T.Mesh>
    </AutoColliders>
  </RigidBody>
</T.Group>

<Attractor
  position={[0, 0, 0.3]}
  strength={0.2}
  range={2}
  gravityType="linear"
/>

<T.AmbientLight />
<T.DirectionalLight

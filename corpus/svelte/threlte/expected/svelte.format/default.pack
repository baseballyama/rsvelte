  };

  const filesMap = {
    bridge: [
      "posx.jpg",
      "negx.jpg",
      "posy.jpg",
      "negy.jpg",
      "posz.jpg",
      "negz.jpg",
    ],
    pisa: ["nx.hdr", "ny.hdr", "nz.hdr", "px.hdr", "py.hdr", "pz.hdr"],

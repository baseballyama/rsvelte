        <Collider shape="cuboid" args={[1.2, 0.15, 0.15]} density={0.5} />
        <T.Mesh castShadow>
          <T.BoxGeometry args={[2.4, 0.3, 0.3]} />
          <T.MeshStandardMaterial color="#8B5A2B" />
        </T.Mesh>
      </RigidBody>
    </T.Group>

    <T.Group position={[1, 0, 0]}>
      <RigidBody bind:rigidBody={head} linearVelocity={velocity}>
        <Collider shape="cuboid" args={[0.4, 0.4, 0.4]} density={8} />
        <T.Mesh castShadow>
          <T.BoxGeometry args={[0.8, 0.8, 0.8]} />
          <T.MeshStandardMaterial
            color="#444"
            metalness={0.8}
            roughness={0.3}
          />
        </T.Mesh>
      </RigidBody>
    </T.Group>

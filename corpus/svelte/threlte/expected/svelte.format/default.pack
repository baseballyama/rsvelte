      | AmbientLight
      | DirectionalLight
      | PointLight
      | SpotLight
      | HemisphereLight
      | RectAreaLight
    )[];
  };

  let { lights }: Props = $props();

  const filterUndefined = <T,>(value: T | undefined): value is T =>
    value !== undefined;
</script>

<Folder title="Light" expanded>

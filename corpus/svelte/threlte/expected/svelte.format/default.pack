=== 1268 apps/docs/src/components/Menu/LeftSidebar/LeftSidebarCategory.svelte	svelte
<script lang="ts">
  import Details from "../Details.svelte";

  interface Props {
    category: LeftSidebarMenuCategory;
    activeUrlPathName: string;
    baseUrl: string;
  }

  let { category, activeUrlPathName, baseUrl }: Props = $props();

  let open = true;

  const trim = (x: string) => {
    x = x.startsWith("/") ? x.slice(1) : x;
    x = x.endsWith("/") ? x.slice(0, -1) : x;
    return x;
  };
</script>

<Details {open} id="sidebar-category-{category.title}">
  {#snippet summary()}
    {category.title}
  {/snippet}

  <ul class="my-2">
    {#each category.menuItems as item}
      {#if item.isDivider}
        <div
          class="mb-2 flex flex-row items-end justify-start gap-1 py-1 pt-4 text-xs font-bold tracking-wide text-white uppercase"
        >
          {item.title}
        </div>
      {:else}
        <li
          class={[
            "sidebar-list-item",
            trim(activeUrlPathName) ===
            trim(`${category.urlPrefix}/${item.slug}`)
              ? "border-orange! text-orange font-bold"
              : "text-faded",
          ]}
        >
          <a href={`${baseUrl}${category.urlPrefix.substring(1)}/${item.slug}`}>
            {item.title}
          </a>
        </li>
      {/if}
    {/each}
  </ul>
</Details>


<TransactionalBinding
  {objects}
  key="far"
  label="far"
  on:change={() => {
    objects.forEach((object) => {
      object.updateProjectionMatrix();
    });
  }}
/>
<TransactionalBinding
  {objects}
  key="zoom"
  label="zoom"
  options={{
    min: 0,
  }}
  on:change={() => {
    objects.forEach((object) => {
      object.updateProjectionMatrix();
    });
  }}

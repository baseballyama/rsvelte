    right: "right",
  } as const;

  const anchorYOptions = {
    top: "top",
    "top-baseline": "top-baseline",
    middle: "middle",
    "bottom-baseline": "bottom-baseline",
    bottom: "bottom",
  } as const;

  const directionOptions = {
    auto: "auto",

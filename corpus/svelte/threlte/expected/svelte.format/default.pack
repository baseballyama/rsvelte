    () => group,
    () => margin,
    () => animate,
    () => onFit,
  );

  const controls = $derived<
    OrbitControls | CameraControls | TrackballControls | undefined
  >($cameraControls ?? $orbitControls ?? $trackballControls);

  export const fit = () => {
    bounds.fit();
  };

  export const reset = () => {
    bounds.reset();
  };

  $effect(() => {
    $size;
    enabled;
    margin;
    $camera;
    controls;
    animate;

    if (enabled) {

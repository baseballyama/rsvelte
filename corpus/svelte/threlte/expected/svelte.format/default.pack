          material.envMapIntensity={0.5}
        />
      </T.Mesh>
    </T.Mesh>

    <!-- The Button -->
    <T.Mesh
      geometry={nodes.Main_Button_Enclosure.geometry}
      material={materials["joystick base"]}
      position={[-0.1143, 0.9795, -0.0933]}
      rotation={[-0.1801, 0, 0]}
      scale={0.9409}
    >
      <T.Mesh

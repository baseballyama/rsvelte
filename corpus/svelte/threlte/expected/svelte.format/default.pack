=== 1009 apps/docs/src/examples/xr/use-hand-joint/JointBody.svelte	svelte
<script lang="ts">
  import { useTask } from "@threlte/core";
  import { handJoints, useHandJoint } from "@threlte/xr";
  import type { RigidBody as RapierRigidBody } from "@dimforge/rapier3d-compat";
  import { Collider, RigidBody } from "@threlte/rapier";

  interface Props {
    jointIndex: number;
    hand: "left" | "right";
  }

  let { jointIndex, hand }: Props = $props();

  let body = $state.raw<RapierRigidBody>();

  const joint = useHandJoint(hand, handJoints[jointIndex]!);

  const radius = $derived($joint?.jointRadius);

  useTask(
    () => {
      if (joint.current === undefined || body === undefined) return;

      const { x, y, z } = joint.current.position;
      body.setNextKinematicTranslation({ x, y, z });
    },
    {
      running: () =>
        body !== undefined && $joint !== undefined && radius !== undefined,
    },
  );
</script>

{#if radius}
  <RigidBody bind:rigidBody={body} type="kinematicPosition">
    <Collider shape="ball" args={[radius]} />
  </RigidBody>
{/if}


  import { T, useLoader } from "@threlte/core";
  import { useGltf, MeshRefractionMaterial, useDraco } from "@threlte/extras";

  import { RGBELoader } from "three/examples/jsm/loaders/RGBELoader.js";

  let { ...props } = $props();

  type GLTFResult = {
    nodes: {
      Diamond_1_0: Mesh;

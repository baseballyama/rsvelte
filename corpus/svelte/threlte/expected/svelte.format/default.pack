  import { MathUtils } from "three";
  import { T, useTask } from "@threlte/core";
  import { injectLookAtPlugin } from "./lookAtPlugin.svelte";

  let cubePos: [number, number, number] = $state.raw([0, 0.8, 0]);

  let time = 0;


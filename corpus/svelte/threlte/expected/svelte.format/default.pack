    left: "left",
    right: "right",
    center: "center",
    justify: "justify",
  } as const;

  const whiteSpaceOptions = {
    normal: "normal",
    nowrap: "nowrap",
    "pre-wrap": "pre-wrap",
  } as const;

  const overflowWrapOptions = {
    normal: "normal",
    "break-word": "break-word",
  } as const;

  let options = $state({
    text: "hello world",
    fontSize: 1,

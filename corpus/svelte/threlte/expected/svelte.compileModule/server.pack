/* TourStop.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';

export class TourStop {
	mask;
	instructions;
	isActive = false;
	isCompleted = false;

	constructor(mask, instructions) {
		this.mask = mask;
		this.instructions = instructions;
	}

	stopCompleted() {
		this.isCompleted = true;
	}

	activate() {
		this.isActive = true;
		this.isCompleted = false;
		this.onActivate?.();
	}

	deactivate() {
		this.isActive = false;
		this.isCompleted = false;
		this.onDeactivate?.();
	}
}

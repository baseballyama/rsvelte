const updateProjectionMatrixKeys = new Set([
	'fov',
	'aspect',
	'near',
	'far',
	'left',
	'right',
	'top',
	'bottom',
	'zoom',
	'filmGauge',
	'filmOffset'
]);

export const updateCamera = (camera, width, height) => {
	if (isInstanceOf(camera, 'PerspectiveCamera')) {
		camera.aspect = width / height;
	} else if (isInstanceOf(camera, 'OrthographicCamera')) {
		camera.left = width / -2;
		camera.right = width / 2;
		camera.top = height / 2;
		camera.bottom = height / -2;
	}

	camera.updateProjectionMatrix();
	camera.updateMatrixWorld();
};

export const useCamera = (camera, manual, makeDefault, props) => {
	const {

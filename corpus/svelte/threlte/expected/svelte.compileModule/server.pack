import { useInteractivity } from './context.js';

export const interactivityEventNames = [
	'onclick',
	'oncontextmenu',
	'ondblclick',
	'onwheel',
	'onpointerup',
	'onpointerdown',
	'onpointerover',
	'onpointerout',
	'onpointerenter',
	'onpointerleave',
	'onpointermove',
	'onpointermissed'

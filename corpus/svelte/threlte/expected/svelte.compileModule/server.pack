/* Game.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { Color, PerspectiveCamera, Scene, Texture } from 'three';
import { levels } from './scenes/levels';
import { Sound } from './sound';

class Game {
	state = 'off';
	sound = new Sound();
	levelIndex = 0;
	score = 0;
	gameOver = false;
	playerPosition = 0;
	ballPosition = { x: 0, z: 0 };

	#baseColor = $.derived(() => {
		if (this.state == 'outro') return 'green';

		return 'red';
	});

	get baseColor() {
		return this.#baseColor();
	}

	set baseColor($$value) {
		return this.#baseColor($$value);
	}

	muted = false;
	blinkClock = 0;
	arcadeMachineScene;
	averageScreenColor = new Color('black');
	gameScene;
	gameCamera;
	gameTexture;
	ballRigidBody;
	debug = false;
	orbitControls = false;

	restart() {
		this.reset();
		this.state = 'menu';
	}

	reset() {
		this.state = 'intro';
		this.levelIndex = 0;
		this.gameOver = false;
		this.score = 0;
		this.playerPosition = 0;
		this.ballPosition = { x: 0, z: 0 };
	}

	nextLevel() {
		if (this.levelIndex < levels.length - 1) {
			this.levelIndex += 1;
			this.state = 'level-loading';
		} else {
			this.state = 'outro';
		}
	}

	switchOff() {
		this.reset();
		this.state = 'off';
	}

	/**
	 * Optionally resets the game and starts it again
	 */
	startGame() {
		this.state = 'level-loading';
	}
}

export const game = new Game();

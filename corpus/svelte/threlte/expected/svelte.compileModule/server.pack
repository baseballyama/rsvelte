export const useCollisionGroups = () => {
	const collidersMap = new Map();
	const bitMask = getContext('threlte-rapier-collision-group');

	if (!bitMask) {
		return { registerColliders: () => {}, removeColliders: () => {} };
	}

	const registerColliders = (colliders) => {
		for (const collider of colliders) {
			if (!collidersMap.has(collider.handle)) {
				collidersMap.set(collider.handle, { collider, initialCollisionGroup: collider.collisionGroups() });
			}
		}

		applyBitMask(collidersMap, bitMask());
	};

	const removeColliders = (colliders) => {
		for (const collider of colliders) {
			const mapItem = collidersMap.get(collider.handle);

			if (mapItem) {
				if (collider && collider.isValid()) {
					collider.setCollisionGroups(mapItem.initialCollisionGroup);
				}
			}

			collidersMap.delete(collider.handle);
		}
	};

	return { registerColliders, removeColliders };

		this.onCommitCallbacks.forEach((callback) => {
			callback(transactions);
		});

		this.onTransactionCallbacks.forEach((callback) => {
			callback(transactions);
		});

		transactions.filter((t) => (t.createHistoryRecord ?? true) && t.sync).forEach((transaction) => {
			if (transaction.sync) {

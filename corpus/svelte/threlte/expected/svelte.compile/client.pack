		} else {
			return originalRaf(callback);
		}
	};

	const pauseRaf = () => {
		if (!$.get(isPaused)) {
			$.set(isPaused, true);
		}
	};

	const resumeRaf = () => {
		if ($.get(isPaused)) {
			$.set(isPaused, false);
			pendingCallbacks.forEach((callback) => originalRaf(callback));
			pendingCallbacks = [];
		}

	};

	const onError = (error) => {
		gltf(undefined);
		scene(undefined);
		animations(undefined);
		asset(undefined);
		cameras(undefined);
		scenes(undefined);
		userData(undefined);
		parser(undefined);
		nodes(undefined);
		materials(undefined);
		$$props.onerror?.(error);
	};

	const suspend = useSuspense();

	const loadGltf = async (url) => {
		try {
			// eslint-disable-next-line svelte/require-store-reactive-access

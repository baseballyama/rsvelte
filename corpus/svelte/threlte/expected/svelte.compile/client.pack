		},

		children: ($$anchor, $$slotProps) => {
			Scene($$anchor, {
				get w() {
					return $.get(w);
				}
			});
		},
		$$slots: { default: true }
	});

	var node_1 = $.sibling(node, 2);

	Pane(node_1, {
		title: 'shadow mesh',
		position: 'fixed',
		children: ($$anchor, $$slotProps) => {
			Slider($$anchor, {
				label: 'light position.w',
				min: 0.1,
				max: 0.9,
				get value() {
					return $.get(w);
				},

				set value($$value) {
					$.set(w, $$value, true);
				}
			});
		},
		$$slots: { default: true }
	});

	$.append($$anchor, fragment);
	$.pop();
}

import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import anime from 'animejs';
import { clamp, mapLinear } from 'three/src/math/MathUtils.js';

var rest_excludes = new Set([
	'$$slots',
	'$$events',
	'$$legacy',
	'type',
	'progress',
	'id',

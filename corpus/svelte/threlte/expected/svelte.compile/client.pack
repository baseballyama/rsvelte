				label: 'scaleDown',
				min: 0,
				max: 10,
				step: 0.1,
				get value() {
					return $.get(scaleDown);
				},

				set value($$value) {
					$.set(scaleDown, $$value, true);
				}
			});

			var node_4 = $.sibling(node_3, 2);

			Folder(node_4, {

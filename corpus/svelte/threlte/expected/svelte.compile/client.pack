				cellColor: '#0A0F19',
				sectionColor: '#481D1A',
				sectionSize: 100,
				cellSize: 10,
				fadeStrength: 0
			});

			var node_8 = $.sibling(node_7, 2);

			{
				let $0 = $.derived(() => $.get(innerWidth) / 1200);

				$.component(node_8, () => T.OrthographicCamera, ($$anchor, T_OrthographicCamera) => {
					T_OrthographicCamera($$anchor, {

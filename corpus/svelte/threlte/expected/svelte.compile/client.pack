		};

		if (game.state === 'menu') return {
			text: 'Press Space\nto Start',
			size: { width: 7.5, height: 2.5 }
		};

		if (game.state === 'level-complete') return {
			text: `Level ${game.levelIndex + 1} Complete\nScore: ${game.score}`,

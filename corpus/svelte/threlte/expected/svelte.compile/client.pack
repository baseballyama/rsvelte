	let materials = $.state(true);
	var fragment = root_2();
	var node = $.first_child(fragment);

	Pane(node, {
		title: 'Debug',
		position: 'fixed',
		children: ($$anchor, $$slotProps) => {
			var fragment_1 = root();
			var node_1 = $.first_child(fragment_1);

			Checkbox(node_1, {
				label: 'Debug',

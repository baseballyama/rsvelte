	$.each(node_8, 16, () => ({ length: 120 }), $.index, ($$anchor, _, x) => {
		const distance = $.derived(() => Math.abs(Math.sin(x)) * 50 + 10);
		const height = $.derived(() => Math.abs((30 - $.get(distance)) / 2));

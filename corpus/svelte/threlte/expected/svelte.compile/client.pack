	let mounted = false;

	$.user_effect(() => {
		if (mounted && $$props.show) {
			$.set(animation, 'In');
		} else if (!$$props.show && $.get(animation) === 'In') {
			$.set(animation, 'Out');
		} else {
			mounted = true;
		}
	});

	var fragment = $.comment();
	var node = $.first_child(fragment);

	$.component(node, () => T.Sprite, ($$anchor, T_Sprite) => {
		T_Sprite($$anchor, {

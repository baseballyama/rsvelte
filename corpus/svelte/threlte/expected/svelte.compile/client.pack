		if (type() === 'fade-up-skew-individual') {
			// get all letter elements
			$.get(timeline).add({
				targets: `#${$$props.id} .letter`,
				translateY: [30, 0],
				skewY: [10, 0],
				opacity: [0, 1],
				easing: 'easeOutCubic',
				duration: 1000,
				delay: (_el, i) => 50 * (i + 1)
			});
		} else if (type() === 'fade-individual') {
			$.get(timeline).add({
				targets: `#${$$props.id} .letter`,
				opacity: [0, 1],
				easing: 'easeOutCubic',
				duration: 1000,
				delay: (_el, i) => 150 * (i + 1)
			});
		} else if (type() === 'fade') {
			$.get(timeline).add({
				targets: `#${$$props.id} .letter`,
				opacity: [0, 1],
				easing: 'easeOutCubic',
				duration: 1000
			});
		} else if (type() === 'fade-up') {
			$.get(timeline).add({
				targets: `#${$$props.id} .letter`,
				opacity: [0, 1],
				translateY: [5, 0],
				easing: 'easeOutCubic',
				duration: 1000
			});
		}

		$.set(completeDuration, $.get(timeline).duration, true);
		$.set(timeline, $.get(timeline), true);
	};

	const transform = (node) => {

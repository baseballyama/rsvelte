		var consequent = ($$anchor) => {
			var fragment = $.comment();
			var node_1 = $.first_child(fragment);

			$.snippet(node_1, () => $$props.children ?? $.noop);
			$.append($$anchor, fragment);
		};

		$.if(node, ($$render) => {
			if ($.get(p) > 0) $$render(consequent);
		});
	}

	$.reset(div);
	$.template_effect(() => $.set_style(div, `opacity: ${$.get(p) ?? ''};`));

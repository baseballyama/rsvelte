	}

	var nav = $.sibling(node, 2);
	var select = $.child(nav);

	$.each(select, 21, () => $.get(components), ({ name }) => name, ($$anchor, $$item) => {
		let name = () => $.get($$item).name;
		var option = root_2();
		var text = $.only_child(option, true);
		var option_value = {};

		$.template_effect(() => {
			$.set_text(text, name());

			if (option_value !== (option_value = name())) {

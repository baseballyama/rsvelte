import { ACESFilmicToneMapping, MathUtils } from 'three';

import {
	DirectionalLight,
	MeshPhysicalNodeMaterial,
	MeshStandardMaterial,
	WebGPURenderer
} from 'three/webgpu';

var root = $.from_html(`<!> <!> <!>`, 1);
var root_1 = $.from_html(`<!> <!>`, 1);

export default function App($$anchor, $$props) {
	$.push($$props, true);


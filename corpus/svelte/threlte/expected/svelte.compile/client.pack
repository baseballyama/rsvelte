	const $rigidBodyB = () => $.store_get(rigidBodyB, '$rigidBodyB', $$stores);
	const [$$stores, $$cleanup] = $.setup_stores();
	const CHARGE_TIME_MS = 1000;
	const AUTOFIRE_INTERVAL_MS = 140;

			children: ($$anchor, $$slotProps) => {
				{
					let $0 = $.derived(() => 85 * MathUtils.DEG2RAD);
					let $1 = $.derived(() => 20 * MathUtils.DEG2RAD);
					let $2 = $.derived(() => 45 * MathUtils.DEG2RAD);
					let $3 = $.derived(() => -45 * MathUtils.DEG2RAD);

					OrbitControls($$anchor, {
						'target.y': 0.75,
						get maxPolarAngle() {
							return $.get($0);
						},

						get minPolarAngle() {
							return $.get($1);
						},

						get maxAzimuthAngle() {
							return $.get($2);
						},

						get minAzimuthAngle() {

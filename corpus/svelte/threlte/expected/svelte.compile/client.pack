									T_Mesh($$anchor, {
										children: ($$anchor, $$slotProps) => {
											var fragment_4 = root();
											var node_2 = $.first_child(fragment_4);

											$.component(node_2, () => T.BoxGeometry, ($$anchor, T_BoxGeometry) => {

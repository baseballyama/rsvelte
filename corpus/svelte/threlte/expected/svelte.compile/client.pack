import * as $ from 'svelte/internal/client';
import { T, useTask } from '@threlte/core';
import { Edges, useGltf } from '@threlte/extras';
import { AutoColliders } from '@threlte/rapier';
import { MathUtils } from 'three';

import {
	arenaHeight,
	arenaWidth,
	playerHeight,
	playerSpeed,
	playerWidth

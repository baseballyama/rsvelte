						},

						set value($$value) {
							$.set(color, $$value, true);
						}
					});

					var node_7 = $.sibling(node_6, 2);

					{
						var consequent = ($$anchor) => {
							Checkbox($$anchor, {
								label: 'block',
								get value() {
									return $.get(block);
								},

								set value($$value) {
									$.set(block, $$value, true);
								}
							});
						};

						$.if(node_7, ($$render) => {
							if ($.get(color)) $$render(consequent);

											return $.get(gltf).materials.Mat;
										},
										'rotation.x': -0.62,
										get 'rotation.y'() {
											return $.get($0);
										},

										get 'rotation.z'() {
											return $.get($1);
										}
									});
								});
							}

							$.append($$anchor, fragment_4);
						},
						$$slots: { default: true }
					});

					var node_6 = $.sibling(node_4, 2);

					Float(node_6, {

           bendWobble = mix(bendUniform, bendPerVertex, noise);
         }
         float bendTheta = bendWobble * gust * factor * weight / 2.0;

         vec3 bent = wobbleRotate(position - anchorPoint, bendAxisVec, bendTheta) + anchorPoint;

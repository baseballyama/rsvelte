				}
			});

			$.append($$anchor, fragment);
		},
		$$slots: { default: true }
	});

	var node_3 = $.sibling(node, 2);

	Settings(node_3, {
		get billboarding() {
			return $.get(billboarding);
		},

		set billboarding($$value) {

		oncreate: (ref) => {
			ref.setPosition(5, 5, 5);
		},

		get ref() {
			return controls();
		},

		set ref($$value) {
			controls($$value);
		}
	});

	var node_1 = $.sibling(node, 2);

	$.component(node_1, () => T.Mesh, ($$anchor, T_Mesh) => {
		T_Mesh($$anchor, {
			'position.y': 0.5,
			get ref() {

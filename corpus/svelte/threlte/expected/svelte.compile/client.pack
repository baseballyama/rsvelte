				});
			},
			$$slots: { default: true }
		});
	});

	var node_8 = $.sibling(node_7, 2);

	$.component(node_8, () => T.Group, ($$anchor, T_Group_1) => {
		T_Group_1($$anchor, {
			get 'position.x'() {
				return $.get(x);
			},
			'position.y': 2.5,
			get 'position.z'() {
				return $.get(z);
			},

			children: ($$anchor, $$slotProps) => {

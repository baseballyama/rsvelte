export default function Chain($$anchor, $$props) {
	$.push($$props, true);

	const segments = 10;
	const spacing = 0.4;
	const radius = 0.18;
	const wreckingRadius = 0.4;
	const beadDensity = 1;
	const wreckingDensity = 3;
	const wreckingOffset = radius + wreckingRadius + 0.05;
	const wreckingAnchor = wreckingOffset - spacing / 2;

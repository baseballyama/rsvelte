var root = $.from_html(`<div class="svelte-l9pgem"><!></div> <!>`, 1);

export default function App($$anchor) {
	const options = { logo: 0, ordering: 1 };
	let selection = 0;
	var fragment = root();
	var div = $.first_child(fragment);
	var node = $.child(div);


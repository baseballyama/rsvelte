		high: { color: '#ffaa55', value: 50 },
		jackpot: { color: '#ff3da6', value: 250 }
	};

	// A weak attractor hovers above the jackpot pocket — a touch of rigged pachinko physics.
	const JACKPOT_STRENGTH = 0.004;

	const JACKPOT_RANGE = 1.8;

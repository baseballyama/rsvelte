		const rnd = Math.random();

		if (rnd > 0.97) {
			return `dead_${Math.floor(deadTrees * Math.random())}`;
		}

		if (rnd > 0.9) {
			return `red_${Math.floor(redTrees * Math.random())}`;
		}


	});

	var div = $.sibling(node, 2);
	var node_4 = $.child(div);

	Canvas(node_4, {
		get toneMapping() {
			return NoToneMapping;
		},

		children: ($$anchor, $$slotProps) => {
			World($$anchor, {
				children: ($$anchor, $$slotProps) => {
					Scene($$anchor, {
						get debug() {
							return $.get(debug);
						},

						get damping() {
							return $.get(damping);

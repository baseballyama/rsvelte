import * as $ from 'svelte/internal/client';
import { T } from '@threlte/core';
import { Grid, OrbitControls, Sky, AnimatedSpriteMaterial } from '@threlte/extras';

var root = $.from_html(`<!> <!>`, 1);
var root_1 = $.from_html(`<!> <!> <!> <!> <!> <!>`, 1);


			'position.y': 0.5,
			children: ($$anchor, $$slotProps) => {
				var fragment_2 = root_2();
				var node_5 = $.first_child(fragment_2);

				$.component(node_5, () => T.MeshStandardMaterial, ($$anchor, T_MeshStandardMaterial) => {

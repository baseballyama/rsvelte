					return $.get(minPolarAngle);
				},

				get maxPolarAngle() {
					return $.get(maxPolarAngle);
				},

				get enableZoom() {
					return $.get(enableZoom);
				}
			});
		},
		$$slots: { default: true }
	});

	$.reset(div);

	var node_1 = $.sibling(div, 2);

	Settings(node_1, {
		get enableDamping() {
			return $.get(enableDamping);

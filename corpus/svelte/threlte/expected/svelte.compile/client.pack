										$.append($$anchor, fragment_5);
									},
									$$slots: { default: true }
								});
							});

							var node_6 = $.sibling(node_3, 2);

							Text(node_6, {
								color: '#fde68a',
								fontSize: 0.085,
								anchorX: 'center',
								anchorY: 'bottom',
								position: [0, 0.16, 0],

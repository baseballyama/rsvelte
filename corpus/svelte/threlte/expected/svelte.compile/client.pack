								T_Group($$anchor, {
									get position() {
										return $.get($0);
									},

									children: ($$anchor, $$slotProps) => {
										var fragment_4 = root();
										var node_4 = $.first_child(fragment_4);

										Collider(node_4, { shape: 'cuboid', args: [0.05, 0.2, 0.18] });

										var node_5 = $.sibling(node_4, 2);

										$.component(node_5, () => T.Mesh, ($$anchor, T_Mesh) => {

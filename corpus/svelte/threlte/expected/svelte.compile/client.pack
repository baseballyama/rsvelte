			'position.y': 0.2,
			children: ($$anchor, $$slotProps) => {
				AnimatedSpriteMaterial($$anchor, {
					textureUrl: '/textures/sprites/Threlte_7.png',
					dataUrl: '/textures/sprites/Threlte_7.json',

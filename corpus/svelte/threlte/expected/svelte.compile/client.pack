					},
					autoRotateSpeed: 0.5
				});
			},
			$$slots: { default: true }
		});
	});

	var node_1 = $.sibling(node, 2);

	Environment(node_1, {
		url: '/textures/equirectangular/hdr/shanghai_riverside_1k.hdr'

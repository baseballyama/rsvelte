			$.component(node_1, () => $.get(example).dom, ($$anchor, example_dom) => {
				example_dom($$anchor, {});
			});

			$.reset(div_2);
			$.reset(div_1);

			var div_3 = $.sibling(div_1, 2);
			var node_2 = $.child(div_3);

			Canvas(node_2, {
				get toneMapping() {
					return NoToneMapping;
				},


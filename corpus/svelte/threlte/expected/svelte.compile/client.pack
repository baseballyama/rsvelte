	const noise = new SimplexNoise();

	$.user_effect(() => {
		for (let i = 0; i < positions.count; i += 1) {
			const x = positions.getX(i) / flatness();
			const y = positions.getY(i) / flatness();

			positions.setZ(i, noise.noise(x, y));

								$.template_effect(() => {
									classes_1 = $.set_class(div_6, 1, 'power-fill svelte-k1v5oq', null, classes_1, { max: gameState.charge >= 1 });
									styles = $.set_style(div_6, '', styles, { width: `${gameState.charge * 100}%` });
								});

								$.append($$anchor, div_3);
							},
							$$slots: { default: true }
						});
					}

					$.append($$anchor, fragment_1);
				},
				$$slots: { default: true }
			});
		});
	}

	$.append($$anchor, fragment);
	$.pop();
}

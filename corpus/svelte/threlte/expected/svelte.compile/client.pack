		},
		$$slots: { default: true }
	});

	$.reset(div);

	var node_1 = $.sibling(div, 2);

	Pane(node_1, {
		position: 'fixed',
		title: 'SVG',
		children: ($$anchor, $$slotProps) => {
			List($$anchor, {
				label: 'scene',
				get options() {
					return options;
				},

				get value() {

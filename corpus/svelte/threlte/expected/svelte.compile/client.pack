					children: ($$anchor, $$slotProps) => {
						var fragment_2 = $.comment();
						var node_2 = $.first_child(fragment_2);

						$.await(node_2, () => env, null, ($$anchor, e) => {
							MeshRefractionMaterial($$anchor, {
								get envMap() {
									return $.get(e);
								},
								fresnel: 0.5,
								ior: 2.75,
								aberrationStrength: 0.04,
								bounces: 3,
								color: '#ffdddd'
							});
						});

						$.append($$anchor, fragment_2);
					},
					$$slots: { default: true }
				}

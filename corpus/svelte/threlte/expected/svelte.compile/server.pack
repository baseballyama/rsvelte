				$$renderer.push('<!--]-->');
			}

			$$renderer.push(` `);

			if (T.MeshBasicMaterial) {
				$$renderer.push('<!--[-->');
				T.MeshBasicMaterial($$renderer, { color: 'white', transparent: true, opacity: 0.2 });
				$$renderer.push('<!--]-->');
			} else {
				$$renderer.push('<!--[!-->');
				$$renderer.push('<!--]-->');
			}

			$$renderer.push(` <!--[-->`);

			const each_array = $.ensure_array_like({ length: 40 });

			for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
				Star($$renderer, {});
			}

			$$renderer.push(`<!--]-->`);
		},
		$$slots: { default: true }
	});
}

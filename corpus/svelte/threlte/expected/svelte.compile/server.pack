      vec2 P2 = mod(floor(0.5 * v), 2.0);
      return 4.0 * bayerDither2x2(P1) + bayerDither2x2(P2);
    }
  `;

const patchShader = (material, uniforms) => {
	material.onBeforeCompile = (shader) => {
		shader.uniforms.uShadowOpacity = uniforms.uShadowOpacity;

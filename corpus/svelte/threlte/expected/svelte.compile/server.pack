							$$renderer.push(`<!----> `);

							if (T.Group) {
								$$renderer.push('<!--[-->');

								T.Group($$renderer, {
									position: [2.5, 1.55, -1.8],
									'rotation.z': MathUtils.DEG2RAD * 90,
									'rotation.y': MathUtils.DEG2RAD * 90 - armPos.current * 0.3,
									children: ($$renderer) => {
										if (T.Mesh) {
											$$renderer.push('<!--[-->');

											T.Mesh($$renderer, {
												castShadow: true,
												'position.y': 1.5,
												children: ($$renderer) => {
													if (T.CylinderGeometry) {
														$$renderer.push('<!--[-->');
														T.CylinderGeometry($$renderer, { args: [0.1, 0.1, 3, 12] });
														$$renderer.push('<!--]-->');
													} else {
														$$renderer.push('<!--[!-->');
														$$renderer.push('<!--]-->');
													}

													$$renderer.push(` `);

													if (T.MeshStandardMaterial) {
														$$renderer.push('<!--[-->');
														T.MeshStandardMaterial($$renderer, { color: '#ffffff' });
														$$renderer.push('<!--]-->');
													} else {

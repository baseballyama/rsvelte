									$$slots: { default: true }
								});

								$$renderer.push('<!--]-->');
							} else {
								$$renderer.push('<!--[!-->');
								$$renderer.push('<!--]-->');
							}

							$$renderer.push(` `);

							Button($$renderer, {
								position: [-2.3, 1.01, 0.8],
								onClick: changeSide,
								text: source === sideA ? 'SIDE B' : 'SIDE A'

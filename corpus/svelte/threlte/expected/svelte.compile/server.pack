import * as $ from 'svelte/internal/server';
import { onMount } from 'svelte';
import { onDestroy } from 'svelte';

export default function RightSidebar($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let {
			editUrl = undefined,
			sourceUrl = undefined,
			headings,
			children
		} = $$props;

		const lowestHeadingDepth = Math.min(...headings.map((heading) => heading.depth));
		let intersectionObserver = undefined;
		let currentHeadingSlug = undefined;
		let currentHeading = headings[0];

		const setCurrentHeading = (id) => {
			currentHeadingSlug = id;

			const newHeadingIndex = headings.findIndex((heading) => {
				return heading.slug == id;
			});

			currentHeading = headings[newHeadingIndex] || currentHeading;
		};

		const headingClicked = (slug) => {
			setCurrentHeading(slug);
		};

		onMount(() => {
			intersectionObserver = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							const { id } = entry.target;

							setCurrentHeading(id);

							break;
						}
					}
				},
				{
					// Negative top margin accounts for `scroll-margin`.
					// Negative bottom margin means heading needs to be
					// towards top of viewport to trigger intersection.
					rootMargin: '-100px 0% -66%',
					threshold: 1
				}
			);

			document.querySelectorAll(`article :is(${headings.map((heading) => `h${heading.depth}`).join(',')})`).forEach((h) => intersectionObserver?.observe(h));
		});

		onDestroy(() => {
			intersectionObserver?.disconnect();
		});

		const focusFirstDropdownLink = ({ target }) => {
			target.firstElementChild.focus();
		};

		$$renderer.push(`<div class="scrollbar-hide relative h-full w-full overflow-auto px-6 pt-6 pb-12 lg:px-0 lg:pl-6 lg:text-sm">`);

		if (headings.length) {
			$$renderer.push(`<!--[0--><span class="mt-3 mb-3 ml-[calc(1rem+2px)] block px-0 py-0 text-xs text-white/80 lg:relative lg:top-0 lg:w-full lg:text-sm lg:font-bold lg:text-white">On this page</span> <ul class="mb-8 w-full bg-[#0c1421] text-left transition-all duration-50 lg:pointer-events-auto lg:bg-transparent lg:opacity-100"><!--[-->`);

			const each_array = $.ensure_array_like(headings);

			for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
				let heading = each_array[$$index];

				$$renderer.push(`<li${$.attr_class($.clsx([
					'sidebar-list-item',
					heading.slug === currentHeadingSlug ? 'border-orange! text-orange font-bold' : 'text-faded'
				]))}><a${$.attr('data-depth', heading.depth)} class="block py-2 pr-4 no-underline hover:underline lg:py-0"${$.attr_style(`margin-left: ${$.stringify((heading.depth - lowestHeadingDepth) * 10)}px;`)}${$.attr('href', `#${heading.slug}`)}>${$.escape(heading.text)}</a></li>`);

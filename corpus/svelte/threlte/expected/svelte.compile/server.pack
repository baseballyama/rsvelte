import * as $ from 'svelte/internal/server';
import { Canvas } from '@threlte/core';
import { HTML } from '@threlte/extras';
import { World } from '@threlte/rapier';
import { Button, Checkbox, Pane } from 'svelte-tweakpane-ui';
import Scene from './Scene.svelte';

export default function App($$renderer) {
	let debug = false;
	let resetKey = 0;
	let $$settled = true;
	let $$inner_renderer;

	function $$render_inner($$renderer) {
		Pane($$renderer, {
			position: 'fixed',
			title: 'Revolute Joint',
			children: ($$renderer) => {
				Button($$renderer, { title: 'Reset' });
				$$renderer.push(`<!----> `);

				Checkbox($$renderer, {
					label: 'Debug',
					get value() {
						return debug;
					},

					set value($$value) {
						debug = $$value;
						$$settled = false;
					}
				});

				$$renderer.push(`<!---->`);
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <div class="svelte-1iczi95">`);

		Canvas($$renderer, {
			children: ($$renderer) => {
				{
					function fallback($$renderer) {
						HTML($$renderer, {
							transform: true,
							children: ($$renderer) => {
								$$renderer.push(`<p class="text-xs">It seems your browser<br/> doesn't support WASM.<br/> I'm sorry.</p>`);
							},
							$$slots: { default: true }
						});
					}

					World($$renderer, {
						fallback,
						children: ($$renderer) => {

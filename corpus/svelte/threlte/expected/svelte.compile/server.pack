				configured = true;
			}

			// ---- charge / autofire state machine ----
			if (gameState.holding) {
				gameState.charge = Math.min(1, gameState.charge + delta * 1000 / CHARGE_TIME_MS);

				if (gameState.charge >= 1) gameState.autoFiring = true;
			} else {
				gameState.charge = 0;
				gameState.autoFiring = false;

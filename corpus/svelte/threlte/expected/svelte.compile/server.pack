				children: ($$renderer) => {
					Slider($$renderer, {
						label: 'size',
						min: 8,
						max: 256,
						step: 8,
						get value() {
							return size;
						},

						set value($$value) {
							size = $$value;
							$$settled = false;
						}
					});


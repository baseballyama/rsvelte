		$$renderer.push('<!--]-->');
	}

	$$renderer.push(` `);

	if (T.GridHelper) {
		$$renderer.push('<!--[-->');
		T.GridHelper($$renderer, { args: [50] });
		$$renderer.push('<!--]-->');
	} else {
		$$renderer.push('<!--[!-->');
		$$renderer.push('<!--]-->');
	}

	$$renderer.push(` `);
	Ground($$renderer, {});
	$$renderer.push(`<!----> `);
	Debug($$renderer, {});
	$$renderer.push(`<!----> `);
	Emitter($$renderer, {});
	$$renderer.push(`<!---->`);
}

								$$renderer.push(` `);

								if (T.MeshToonMaterial) {
									$$renderer.push('<!--[-->');
									T.MeshToonMaterial($$renderer, { color: '#ff3e00' });
									$$renderer.push('<!--]-->');
								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}

								$$renderer.push(` `);
								Outlines($$renderer, { color: 'white' });
								$$renderer.push(`<!----> `);
								Outlines($$renderer, { color: 'hotpink', thickness: 0.05 });
								$$renderer.push(`<!----> `);
								Outlines($$renderer, { color: 'yellow', thickness: 0.1 });
								$$renderer.push(`<!---->`);
							},
							$$slots: { default: true }
						});

						$$renderer.push('<!--]-->');
					} else {
						$$renderer.push('<!--[!-->');
						$$renderer.push('<!--]-->');

				propMappings[key] = { propertyPath, transformer };

				// add the prop to the props object
				props[key] = value;
			});

			// add the props to the parent IsheetObject
			addProps(props);
		};

		const updateProjectionMatrixKeys = [
			'fov',
			'near',
			'far',
			'zoom',
			'left',
			'right',
			'top',
			'bottom',
			'aspect'
		];

		observe.pre(() => [parent, sheetObject], ([parent, sheetObject]) => {
			if (!parent) return;


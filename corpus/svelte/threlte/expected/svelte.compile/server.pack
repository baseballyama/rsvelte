					Folder($$renderer, {
						title: 'Diagnostics',
						children: ($$renderer) => {
							Textarea($$renderer, {
								value: `<World framerate=${framerate() === 'varying' ? '"varying"' : `{${framerate()}}`}>\n  <Scene />\n<World>`,
								live: false,
								rows: 3,
								disabled: true
							});

							$$renderer.push(`<!----> `);

							Text($$renderer, {
								label: 'Iteration',
								value: iteration.toString(),
								live: false,
								disabled: true
							});

							$$renderer.push(`<!---->`);
						},
						$$slots: { default: true }
					});

					$$renderer.push(`<!---->`);
				},
				$$slots: { default: true }

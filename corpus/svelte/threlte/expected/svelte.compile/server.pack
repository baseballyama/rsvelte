					$$renderer.push(`<!----> `);
					MeshLineMaterial($$renderer, { width: 10, color, attenuate: false });
					$$renderer.push(`<!---->`);
				}

				CursorLine($$renderer, {
					color,
					cursorPosition: cursorPosition.current,
					'position.x': 0.5 * Math.cos(a),
					'position.y': 0.5 * Math.sin(a),

		const handleKeyDown = (event) => {
			if (event.key === 'Escape' && fullscreen) {
				fullscreen = false;
			}
		};

		const detachIframeEscapeListener = () => {
			iframeWindow?.removeEventListener('keydown', handleKeyDown);

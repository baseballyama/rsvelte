		const space = keyboard.key('Space');

		const trackedKeys = [
			{ key: w, label: 'W' },
			{ key: a, label: 'A' },
			{ key: s, label: 'S' },
			{ key: d, label: 'D' },
			{ key: space, label: 'Space' }

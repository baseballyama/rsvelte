			if (ballsInLaunchZone > 0) return;

			const now = performance.now();

			if (now - lastSpawnAt < SPAWN_DEBOUNCE_MS) return;

			const plungerBody = get(rigidBodyB);

			if (!plungerBody) return;

			const p = plungerBody.translation();


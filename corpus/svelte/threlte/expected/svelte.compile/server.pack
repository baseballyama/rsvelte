				results[newPath] = files[path];
			}

			return results;
		});

		const onclick = () => {
			sdk.openProject(
				{
					title: 'Threlte example',
					description: '',
					files: { ...projectTemplate, ...projectFiles() },
					template: 'node'
				},
				{ openFile: 'src/example/App.svelte' }

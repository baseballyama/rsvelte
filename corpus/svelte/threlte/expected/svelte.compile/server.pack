			posX[i] = pos.x;
			posY[i] = agents[i]?.baseHeight ?? 0;
			posZ[i] = pos.y;
		}

		const velocityHelper = new Vector2(0, 0);
		let totalTime = 0;

		const updateAgents = (delta) => {
			for (let i = 0; i < agents.length; i++) {
				// timer
				const agent = agents[i];

				agent.timer -= delta;
				totalTime += delta;

				// apply velocity

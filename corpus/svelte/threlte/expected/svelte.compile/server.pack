				$$renderer.push('<!--[-->');

				T.Group($$renderer, {
					position: [CHANNEL_X, ANCHOR_Y + REST_OFFSET, 0],
					children: ($$renderer) => {
						RigidBody($$renderer, {
							type: 'dynamic',
							enabledTranslations: [false, true, false],
							enabledRotations: [false, false, false],
							linearDamping: 0.2,
							ccd: true,

            if (uHasAlphaMap) shadowAlpha *= texture(uAlphaMap, vUv).x;
          #endif
          if ((bayerDither4x4(floor(mod(gl_FragCoord.xy, 4.0)))) / 16.0 >= shadowAlpha) discard;
        `);
	};

				scene.overrideMaterial = originalOverrideMaterial;
			},
			{ before: autoRenderTask, autoInvalidate: false }
		);

		const selectionMesh = new Mesh();

		selectionMesh.raycast = () => {};
		selectionMesh.position.z = -5;
		selectionMesh.frustumCulled = false;
		selectionMesh.userData.ignoreOverrideMaterial = true;
		selectionMesh.renderOrder = 9999; // Set because of Grid overlap. Why to 9999? I don't know, but it works

		const getMesh = () => selectionMesh; // "getter" to disable reactivity for performance reasons

		useTask(
			() => {
				// TODO: Make perf optimizations in terms of not rendering when no objects
				// are selected
				let scaleX = getMesh().scale.x;

				let scaleY = getMesh().scale.y;

				if (isInstanceOf($.store_get($$store_subs ??= {}, '$camera', camera), 'PerspectiveCamera')) {
					scaleY = Math.tan($.store_get($$store_subs ??= {}, '$camera', camera).fov * Math.PI / 180 * 0.5) * 5 * 2; // 5 being the distance of the camera to the plane
					scaleX = scaleY * $.store_get($$store_subs ??= {}, '$camera', camera).aspect;
				} else if (isInstanceOf($.store_get($$store_subs ??= {}, '$camera', camera), 'OrthographicCamera')) {
					scaleY = ($.store_get($$store_subs ??= {}, '$camera', camera).top - $.store_get($$store_subs ??= {}, '$camera', camera).bottom) / $.store_get($$store_subs ??= {}, '$camera', camera).zoom;
					scaleX = ($.store_get($$store_subs ??= {}, '$camera', camera).right - $.store_get($$store_subs ??= {}, '$camera', camera).left) / $.store_get($$store_subs ??= {}, '$camera', camera).zoom;
				}

				if (scaleX !== getMesh().scale.x || scaleY !== getMesh().scale.y) {

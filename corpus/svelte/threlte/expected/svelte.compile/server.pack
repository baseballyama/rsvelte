				}

				World($$renderer, {
					fallback,
					children: ($$renderer) => {
						$$renderer.push(`<!---->`);

						{
							Scene($$renderer, { testIndex });
						}

						$$renderer.push(`<!---->`);
					},
					$$slots: { fallback: true, default: true }
				});
			}
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!----></div>`);
}

import * as $ from 'svelte/internal/server';
import { T } from '@threlte/core';
import { OrbitControls } from '@threlte/extras';
import { Attractor, Collider, RigidBody } from '@threlte/rapier';
import { MeshBasicMaterial, SphereGeometry } from 'three';

const geometry = new SphereGeometry(1);
const material = new MeshBasicMaterial({ color: 'red' });

export default function AdvancedScene($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let { type = 'static' } = $$props;
		let hide = false;

		const reset = () => {
			hide = true;
			setTimeout(() => hide = false);
		};

		const config = {
			static: {
				type: 'static',
				strength: 3,
				range: 100,
				gravitationalConstant: undefined
			},
			linear: {
				type: 'linear',
				strength: 1,
				range: 100,
				gravitationalConstant: undefined
			},
			newtonian: {
				type: 'newtonian',
				strength: 10,
				range: 100,
				gravitationalConstant: 10
			}
		};

		if (T.PerspectiveCamera) {
			$$renderer.push('<!--[-->');

			T.PerspectiveCamera($$renderer, {
				'position.y': 50,
				'position.z': 100,
				makeDefault: true,
				fov: 70,
				far: 10000,
				children: ($$renderer) => {
					OrbitControls($$renderer, { 'target.y': 20 });
				},

<span class="line"><span style="color: #F6F6F4">/&gt;</span></span>
</code></pre>`;

	$$renderer.push(`<div class="flex flex-col gap-3"><h2 class="text-xl leading-snug font-bold text-neutral-800">Auto Sync</h2> <div class="overflow-hidden rounded-md text-sm whitespace-pre-wrap">${$.html(html)}</div> `);

	InstructionsBasic($$renderer, {
		clickAnywhere: true,
		message: 'All changes to objects are persisted back to your code in real-time (limitations apply).',
		tip: 'This is a demo environment. Changes are not persisted.'
	});

	$$renderer.push(`<!----></div>`);
}

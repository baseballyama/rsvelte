							$$renderer.push(` `);

							if (T.Group) {
								$$renderer.push('<!--[-->');

								T.Group($$renderer, {
									'position.y': 1,
									'position.z': -2.2,
									'rotation.x': -coverAngle.current * MathUtils.DEG2RAD,
									children: ($$renderer) => {

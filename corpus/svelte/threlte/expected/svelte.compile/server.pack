		$$renderer.push(`<!----> `);

		Pane($$renderer, {
			title: 'shadow material',
			position: 'fixed',
			children: ($$renderer) => {
				Color($$renderer, {
					label: 'shadow color',
					get value() {
						return color;
					},

					set value($$value) {
						color = $$value;
						$$settled = false;
					}
				});
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!---->`);
	}

	do {
		$$settled = true;
		$$inner_renderer = $$renderer.copy();
		$$render_inner($$inner_renderer);
	} while (!$$settled);

	$$renderer.subsume($$inner_renderer);
}

							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----></div></div></div>`);
					}

					Trigger($$renderer, { in: 0.5, out: 2.7, children, $$slots: { default: true } });
				}

				$$renderer.push(`<!----> `);

				Trigger($$renderer, {

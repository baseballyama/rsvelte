		} else {
			$$renderer.push('<!--[!-->');
			$$renderer.push('<!--]-->');
		}

		$$renderer.push(` `);

		VirtualEnvironment($$renderer, {
			visible: debug,
			children: ($$renderer) => {
				lightformer($$renderer, '#FF4F4F', 'plane', 20, [0, 0, -20], debug);
				$$renderer.push(`<!----> `);

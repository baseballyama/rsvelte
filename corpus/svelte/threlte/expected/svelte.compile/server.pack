									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);

						if (T.Mesh) {
							$$renderer.push('<!--[-->');

							T.Mesh($$renderer, {
								receiveShadow: true,
								geometry: gltf.nodes.Floor.geometry,
								material: gltf.materials.Mat,
								position: [0, -0.1, 0]
							});

							$$renderer.push('<!--]-->');
						} else {

		});

		$$renderer.push(`<!---->`);

		{
			T($$renderer, {
				is: selectionMesh,
				attach: $.store_get($$store_subs ??= {}, '$camera', camera),
				children: ($$renderer) => {
					if (T.PlaneGeometry) {
						$$renderer.push('<!--[-->');
						T.PlaneGeometry($$renderer, {});
						$$renderer.push('<!--]-->');
					} else {
						$$renderer.push('<!--[!-->');
						$$renderer.push('<!--]-->');
					}

					$$renderer.push(` `);

					if (T.ShaderMaterial) {
						$$renderer.push('<!--[-->');

						T.ShaderMaterial($$renderer, {
							fragmentShader,
							vertexShader,
							uniforms: {
								outlinedObjectsTexture: { value: renderTarget.texture },
								lineWidth: { value: 1.5 },
								outlineColor: { value: new Color('#FFFF00') },
								edgeFactor: { value: 0.0001 }
							},
							depthWrite: false,
							depthTest: false,
							transparent: true
						});

						$$renderer.push('<!--]-->');
					} else {
						$$renderer.push('<!--[!-->');
						$$renderer.push('<!--]-->');
					}
				},
				$$slots: { default: true }
			});
		}

		$$renderer.push(`<!---->`);

		if ($$store_subs) $.unsubscribe_stores($$store_subs);
	});
}

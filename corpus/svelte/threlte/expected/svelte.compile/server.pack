							ref.lookAt(0, 1.8, 0);
						}
					});

					$$renderer.push('<!--]-->');
				} else {
					$$renderer.push('<!--[!-->');
					$$renderer.push('<!--]-->');
				}
			}

			XR($$renderer, {
				fallback,
				children: ($$renderer) => {
					if (playing) {
						$$renderer.push('<!--[0-->');
						Sabers($$renderer, {});
					} else {
						$$renderer.push('<!--[-1-->');
						Controller($$renderer, { left: true });
						$$renderer.push(`<!----> `);
						Controller($$renderer, { right: true });

						OrbitControls($$renderer, {
							autoRotate: isPlaying,
							autoRotateSpeed: 0.5,
							enableDamping: true,
							maxPolarAngle: MathUtils.DEG2RAD * 80,
							'target.y': 1.5
						});

						$$renderer.push(`<!----> `);
						AudioListener($$renderer, {});
						$$renderer.push(`<!---->`);
					},
					$$slots: { default: true }
				});

				$$renderer.push('<!--]-->');
			} else {
				$$renderer.push('<!--[!-->');
				$$renderer.push('<!--]-->');
			}

			$$renderer.push(` `);

			if (T.Mesh) {
				$$renderer.push('<!--[-->');

				T.Mesh($$renderer, {
					receiveShadow: true,
					'rotation.x': MathUtils.DEG2RAD * -90,
					children: ($$renderer) => {
						if (T.CircleGeometry) {
							$$renderer.push('<!--[-->');
							T.CircleGeometry($$renderer, { args: [10, 64] });
							$$renderer.push('<!--]-->');
						} else {
							$$renderer.push('<!--[!-->');
							$$renderer.push('<!--]-->');

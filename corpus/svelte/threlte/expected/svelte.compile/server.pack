		shader.uniforms.uHasAlphaMap = uniforms.uHasAlphaMap;

		shader.fragmentShader = shader.fragmentShader.replace('void main() {', `
          uniform float uShadowOpacity;
          uniform sampler2D uAlphaMap;
          uniform bool uHasAlphaMap;
          ${bayerDither}
          void main() {

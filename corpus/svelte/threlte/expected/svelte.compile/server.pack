		if (T.Points) {
			$$renderer.push('<!--[-->');

			T.Points($$renderer, {
				children: ($$renderer) => {
					T($$renderer, { is: geometry });
					$$renderer.push(`<!----> `);
					T($$renderer, { is: material, size, color, opacity });
					$$renderer.push(`<!---->`);
				},
				$$slots: { default: true }
			});

			$$renderer.push('<!--]-->');
		} else {
			$$renderer.push('<!--[!-->');
			$$renderer.push('<!--]-->');
		}
	});
}

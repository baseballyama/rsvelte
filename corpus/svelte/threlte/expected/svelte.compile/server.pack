			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <div class="svelte-zu2mxn">`);

		Canvas($$renderer, {
			children: ($$renderer) => {
				{
					function fallback($$renderer) {
						HTML($$renderer, {

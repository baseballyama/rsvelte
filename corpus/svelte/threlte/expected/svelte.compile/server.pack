				HorizontalButtonGroup($$renderer, {
					children: ($$renderer) => {
						ToolbarButton($$renderer, {
							onclick: ext.toggleEnabled,
							active: ext.state.enabled,
							label: 'Helpers',
							icon: 'mdiFitToScreen',

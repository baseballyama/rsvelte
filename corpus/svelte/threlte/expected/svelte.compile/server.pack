						label: 'firstHitOnly',
						get value() {
							return options.firstHitOnly;
						},

						set value($$value) {
							options.firstHitOnly = $$value;
							$$settled = false;
						}
					});

					$$renderer.push(`<!----> `);

					Checkbox($$renderer, {
						label: 'setBoundingBox',

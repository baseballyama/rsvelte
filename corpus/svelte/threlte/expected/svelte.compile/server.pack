import * as $ from 'svelte/internal/server';
import { T } from '@threlte/core';

export default function Plane($$renderer, $$props) {
	let { color = 'white', height = 1, width = 1, depth = 0, children } = $$props;

	if (T.Mesh) {
		$$renderer.push('<!--[-->');

		T.Mesh($$renderer, {
			'position.z': depth * 20,
			renderOrder: depth,
			children: ($$renderer) => {

		const onMouseDown = () => {
			listenToModes = true;
			initialValue.position.copy(object().position);
			initialValue.rotation.copy(object().rotation);
			initialValue.scale.copy(object().scale);
		};

		const onMouseUp = () => {
			listenToModes = false;

			if (!initialValue) return;

			const value = {

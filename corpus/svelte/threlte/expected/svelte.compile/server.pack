		project = globalProjects.get(name) ?? getProject(name, config);
		globalProjects.set(name, project);

		const syncReady = async () => {
			await project.ready;
			isReady = true;
		};

		syncReady();

		// CHILD CONTEXT
		setContext(`theatre-project`, project);

		$.await($$renderer, project.ready, () => {}, () => {

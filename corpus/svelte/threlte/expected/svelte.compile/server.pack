			});

			$$renderer.push(`<!---->`);
		}

		RigidBody($$renderer, {
			canSleep: false,
			linearDamping: 0.4,
			angularDamping: 5,
			enabledRotations: [false, false, true],
			type: 'dynamic',
			children,

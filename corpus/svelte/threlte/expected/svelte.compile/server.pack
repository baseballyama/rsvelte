											$$renderer.push('<!--[-->');

											T.Mesh($$renderer, {
												children: ($$renderer) => {
													T($$renderer, { is: ballGeometry });
													$$renderer.push(`<!----> `);
													T($$renderer, { is: ballMaterial });
													$$renderer.push(`<!---->`);
												},
												$$slots: { default: true }
											});

											$$renderer.push('<!--]-->');

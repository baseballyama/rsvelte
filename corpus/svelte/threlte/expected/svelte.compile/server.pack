							});

							$$renderer.push('<!--]-->');
						} else {
							$$renderer.push('<!--[!-->');
							$$renderer.push('<!--]-->');
						}
					} else {
						$$renderer.push('<!--[-1-->');
					}

					$$renderer.push(`<!--]--> `);

					if ('isDirectionalLight' in object) {
						$$renderer.push('<!--[0-->');

						if (T.DirectionalLightHelper) {
							$$renderer.push('<!--[-->');

							T.DirectionalLightHelper($$renderer, {

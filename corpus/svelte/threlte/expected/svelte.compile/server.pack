				$$renderer.push('<!--[-->');
				T.AmbientLight($$renderer, { intensity: Math.PI / 2 });
				$$renderer.push('<!--]-->');
			} else {
				$$renderer.push('<!--[!-->');
				$$renderer.push('<!--]-->');
			}

			$$renderer.push(` `);


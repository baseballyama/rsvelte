		Canvas($$renderer, {
			children: ($$renderer) => {
				Scene($$renderer, {
					count,
					radius,
					depth,
					factor,
					saturation,
					lightness,
					opacity,
					fade,
					rounded,
					speed
				});
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----></div>`);
	}

	do {
		$$settled = true;
		$$inner_renderer = $$renderer.copy();
		$$render_inner($$inner_renderer);
	} while (!$$settled);

	$$renderer.subsume($$inner_renderer);
}

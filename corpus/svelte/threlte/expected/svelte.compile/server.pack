					Slider($$renderer, {
						label: 'maxAge',
						min: 300,
						max: 5000,
						step: 100,
						get value() {
							return maxAge;
						},

						set value($$value) {
							maxAge = $$value;
							$$settled = false;
						}
					});

					$$renderer.push(`<!----> `);

					Slider($$renderer, {
						label: 'radius',
						min: 0,
						max: 1,
						step: 0.01,
						get value() {
							return radius;
						},

						set value($$value) {
							radius = $$value;
							$$settled = false;
						}
					});

					$$renderer.push(`<!----> `);

					Slider($$renderer, {
						label: 'intensity',
						min: 0,
						max: 1,
						step: 0.1,
						get value() {
							return intensity;
						},

						set value($$value) {
							intensity = $$value;
							$$settled = false;
						}
					});

					$$renderer.push(`<!----> `);

					Slider($$renderer, {

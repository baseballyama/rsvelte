export default function Scene($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let { debug } = $$props;

		interactivity();

		// lookAt plugin from the plugin examples
		injectPlugin('lookAt', (args) => {
			if (!isInstanceOf(args.ref, 'Object3D') || !args.props.lookAt) return;


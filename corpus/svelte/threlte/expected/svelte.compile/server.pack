import * as $ from 'svelte/internal/server';
import { Color } from 'three';
import { T, useThrelte } from '@threlte/core';
import { Text, Grid, Outlines, VirtualEnvironment, Stars } from '@threlte/extras';

import {
	XR,
	useXR,
	teleportControls,
	pointerControls,
	touchControls,

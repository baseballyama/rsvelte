		const colors = [
			'#0000ff',
			'#00ff00',
			'#00ffff',
			'#ff0000',
			'#ff00ff',
			'#ffff00'
		];

		const m = 2 * Math.PI / colors.length;

		$$renderer.push(`<!--[-->`);

		const each_array = $.ensure_array_like(colors);

		for (let i = 0, $$length = each_array.length; i < $$length; i++) {
			let color = each_array[i];
			const a = m * i;

			{
				function children($$renderer, { getPoints }) {

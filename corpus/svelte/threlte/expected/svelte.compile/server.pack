			$$renderer.push('<!--]-->');
		}

		$$renderer.push(` `);

		$.await($$renderer, gltf, () => {}, (gltf) => {
			$.await($$renderer, texture, () => {}, (texture) => {
				Mesh($$renderer, {
					geometry: gltf.nodes.Background.geometry,
					texture,
					visible: settings.background,
					wireframe: settings.wireframe

export default function App($$renderer) {
	let enabled = true;
	let size = 60;
	let focus = 0;
	let samples = 16;
	let $$settled = true;
	let $$inner_renderer;

	function $$render_inner($$renderer) {
		Pane($$renderer, {
			title: 'SoftShadows',

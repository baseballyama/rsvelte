		$$renderer.push(`<nav class="svelte-1escm0m"><a${$.attr('href', resolve('/'))}><img alt="Svelte Hacker News logo" class="icon svelte-1escm0m" src="/favicon.png"/></a> <ul class="svelte-1escm0m"><!--[-->`);


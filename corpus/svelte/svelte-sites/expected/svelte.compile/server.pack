		}

		$$renderer.push(`<!--]--> <li class="about svelte-1escm0m"><a${$.attr('href', resolve('/about'))}${$.attr_class('svelte-1escm0m', void 0, { 'selected': section === 'about' })}>about</a></li></ul></nav>`);
	});
}

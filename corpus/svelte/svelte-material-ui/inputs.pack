<div style="margin-top: 1em;">
  <Button
    onclick={() => {
      const idx = selected.findIndex((v) => v === 'Doc');
      if (idx > -1) {
        selected.splice(idx, 1);
      } else {
        selected.push('Doc');
      }
    }}

export enum InteractionTrigger {
  UNSPECIFIED, // Default type
  CLICK,
  BACKSPACE_KEY,
  DELETE_KEY,
  SPACEBAR_KEY,
  ENTER_KEY,
}

export const strings = {
  ARIA_HIDDEN: 'aria-hidden',
  INTERACTION_EVENT: 'MDCChipTrailingAction:interaction',
  NAVIGATION_EVENT: 'MDCChipTrailingAction:navigation',
  TAB_INDEX: 'tabindex',
};


<script lang="ts" generics="TagName extends SmuiEveryElement">
  import type { Snippet } from 'svelte';
  import type { ActionArray } from './internal/useActions.js';
  import { useActions } from './internal/index.js';
  import type {
    SmuiAttrs,
    SmuiElementMap,
    SmuiEveryElement,
  } from './smui.types.js';

  type OwnProps = {
    /**

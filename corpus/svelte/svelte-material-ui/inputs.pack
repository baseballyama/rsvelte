    bind:open
    {centered}
    {mobileStacked}
    onSMUIBannerClosed={handleBannerClosed}
  >
    {#snippet label()}
      <Label>This is a banner with no icon and some actions.</Label>
    {/snippet}
    {#snippet actions()}
      <Button secondary>Secondary</Button>
      <Button>Primary</Button>

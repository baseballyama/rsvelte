    }
    restProps.onSMUIChipTrailingActionInteraction?.(e);
  }}
  onSMUIChipTrailingActionNavigation={(
    e: CustomEvent<{ key: string }> & {
      currentTarget: EventTarget & SmuiElementMap[TagName];
    },

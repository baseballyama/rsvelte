<aside
  bind:this={element}
  use:useActions={use}
  class={classMap({
    'mdc-snackbar': true,
    'mdc-snackbar--stacked': variant === 'stacked',
    'mdc-snackbar--leading': leading,
    ...internalClasses,
    [className]: true,
  })}
  {...exclude(restProps, ['surface$'])}
  onkeydown={(e) => {
    if (instance) {
      instance.handleKeyDown(e);
    }

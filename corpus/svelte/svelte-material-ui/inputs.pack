<div
  bind:this={element}
  use:useActions={use}
  class={classMap({
    'mdc-segmented-button': true,
    'mdc-segmented-button--single-select': singleSelect,
    [className]: true,
  })}
  role={singleSelect ? 'radiogroup' : 'group'}
  {...restProps}
  onselected={(e) => {

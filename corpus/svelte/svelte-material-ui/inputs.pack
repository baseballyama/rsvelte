    class?: string;
    button$class?: string;
    children?: Snippet;
  };
  let {
    class: className = '',
    button$class = '',
    children,
    ...restProps
  }: OwnProps &
    SmuiAttrs<'div', keyof OwnProps> & {
      [
        k in keyof ComponentProps<Button> as `button\$${k}`
      ]?: ComponentProps<Button>[k];
    } = $props();
</script>


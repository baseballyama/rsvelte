=== 225 packages/dialog/src/InitialFocus.ts	js
export default function InitialFocus(node) {
    node.setAttribute('data-mdc-dialog-initial-focus', '');
    return {
        destroy() {
            node.removeAttribute('data-mdc-dialog-initial-focus');
        },
    };
}


import { MDCFoundation } from '@smui/common/base/foundation';
import { cssClasses } from './constants';
/** MDC Floating Label Foundation */
export class MDCFloatingLabelFoundation extends MDCFoundation {
    static get cssClasses() {
        return cssClasses;

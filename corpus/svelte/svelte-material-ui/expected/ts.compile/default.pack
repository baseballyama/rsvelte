            focusChipTrailingActionAtIndex: () => undefined,
            getChipListCount: () => -1,
            getIndexOfChipById: () => -1,
            hasClass: () => false,
            isRTL: () => false,
            removeChipAtIndex: () => undefined,
            removeFocusFromChipAtIndex: () => undefined,
            selectChipAtIndex: () => undefined,

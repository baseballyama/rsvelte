import { MDCRippleFoundation } from '@smui/ripple/foundation';
import { MDCTabIndicator, } from '@smui/tab-indicator/component';
import { MDCTabFoundation } from './foundation';
/** MDC Tab */
export class MDCTab extends MDCComponent {

        const currentScrollLeft = this.adapter.getScrollAreaScrollLeft();
        return Math.round(translateX - currentScrollLeft);
    }
    scrollToRTL(scrollX) {
        const currentScrollLeft = this.adapter.getScrollAreaScrollLeft();

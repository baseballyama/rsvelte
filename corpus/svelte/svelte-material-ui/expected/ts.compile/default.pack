    handleTransitionEnd; // assigned in
    // initialSyncWithDOM()
    initialize() {
        this.area = this.root.querySelector(MDCTabScrollerFoundation.strings.AREA_SELECTOR);
        this.content = this.root.querySelector(MDCTabScrollerFoundation.strings.CONTENT_SELECTOR);
    }

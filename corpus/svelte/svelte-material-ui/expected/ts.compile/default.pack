            isCheckboxAtRowIndexChecked: (rowIndex) => this.rowCheckboxList[rowIndex].checked,
            isHeaderRowCheckboxChecked: () => this.headerRowCheckbox.checked,
            isRowsSelectable: () => !!this.root.querySelector(selectors.ROW_CHECKBOX) ||

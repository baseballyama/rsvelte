            const previouslySelectedIndex = this.adapter.getIndexOfChipById(previouslySelectedChip);
            this.selectedChipIds = [];
            this.adapter.selectChipAtIndex(previouslySelectedIndex, 
            /** isSelected */ false, shouldNotifyClients);
        }
        this.selectedChipIds.push(chipId);
        const index = this.adapter.getIndexOfChipById(chipId);
        this.adapter.selectChipAtIndex(index, 
        /** isSelected */ true, shouldNotifyClients);
    }
}

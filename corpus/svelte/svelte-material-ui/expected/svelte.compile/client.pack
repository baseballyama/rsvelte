									$.append($$anchor, text_1);
								};

								FormField(node_5, {
									label,
									children: ($$anchor, $$slotProps) => {
										Radio($$anchor, {
											value: 'default',
											get group() {
												return $.get(color);
											},

											set group($$value) {
												$.set(color, $$value, true);
											}

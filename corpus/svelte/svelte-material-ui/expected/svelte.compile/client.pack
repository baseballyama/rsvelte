		children: ($$anchor, $$slotProps) => {
			$.next();

			var text_1 = $.text('A dismissible drawer with a header and activated items');

			$.append($$anchor, text_1);
		},
		$$slots: { default: true }
	});

	var node_2 = $.sibling(node_1, 2);

	Demo(node_2, {

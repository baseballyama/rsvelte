					$.next();

					var fragment_1 = root_2();
					var node_3 = $.sibling($.first_child(fragment_1), 6);

					Paper(node_3, {
						elevation: 0,
						children: ($$anchor, $$slotProps) => {
							var fragment_2 = root_1();

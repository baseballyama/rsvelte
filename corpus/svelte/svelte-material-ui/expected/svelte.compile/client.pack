import Modal from './_Modal.svelte';

var root = $.from_html(`<section><h2>Drawers</h2> <h5>Installation</h5> <pre class="demo-spaced">npm i -D @smui/drawer</pre> <h5>Demos</h5> <!> <!> <!></section>`);


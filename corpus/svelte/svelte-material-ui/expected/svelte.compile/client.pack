							$.next();

							var text_1 = $.text('cancel');

							$.append($$anchor, text_1);
						},
						$$slots: { default: true }
					});

					$.append($$anchor, fragment_1);
				},
				$$slots: { default: true }
			});
		};

		ChipSet(node, {
			style: 'display: inline-block;',
			get chips() {
				return $.get(selected);
			},

			set chips($$value) {
				$.set(selected, $$value, true);
			},
			chip,
			$$slots: { chip: true }
		});
	}


			chipTrailingAction$class: 'material-icons',
			'chipTrailingAction$aria-label': 'Remove tag',
			addChipKeys: [' ', ',', '-', '+'],
			get chips() {
				return $.get(tags);
			},

			set chips($$value) {
				$.set(tags, $$value, true);
			},

			get value() {
				return $.get(value);
			},

			set value($$value) {
				$.set(value, $$value, true);
			},
			chipTrailingAction,
			label,
			$$slots: { chipTrailingAction: true, label: true }
		});
	}

	$.reset(div);
	$.append($$anchor, div);
}

				children: ($$anchor, $$slotProps) => {
					$.next();

					var text_1 = $.text('I Know It');

					$.append($$anchor, text_1);
				},
				$$slots: { default: true }
			});
		};

		Banner($$anchor, {
			open: true,
			fixed: true,
			mobileStacked: true,
			content$style: 'max-width: max-content;',
			label,
			actions,
			$$slots: { label: true, actions: true }
		});
	}
}

			$.set(value, $$value, true);
		}
	});

	var pre = $.sibling(node, 2);
	var text = $.only_child(pre);

	$.reset(div);
	$.template_effect(($0) => $.set_text(text, `Selected: ${$0 ?? ''}`), [() => $.get(value) ? JSON.stringify($.get(value)) : '']);

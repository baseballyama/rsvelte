		file: 'drawer/_Modal.svelte',
		children: ($$anchor, $$slotProps) => {
			$.next();

			var text_2 = $.text('A modal drawer with header, activated items, subheading, icons, list groups');

			$.append($$anchor, text_2);
		},
		$$slots: { default: true }
	});

	$.reset(section);
	$.append($$anchor, section);
}

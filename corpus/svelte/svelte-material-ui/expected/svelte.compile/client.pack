var root = $.from_html(`<section><h2>Toolip</h2> <p>Or tooltip. I can't spell.</p> <h5>Installation</h5> <pre class="demo-spaced">npm i -D @smui/tooltip</pre> <h5>Demos</h5> <!> <!> <!> <!> <!></section>`);


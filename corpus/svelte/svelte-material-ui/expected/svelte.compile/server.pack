						});

						$$renderer.push(`<!----> `);
						Separator($$renderer, {});
						$$renderer.push(`<!----> `);

						Item($$renderer, {
							onSMUIAction: () => clicked = 'Delete',
							children: ($$renderer) => {
								Text($$renderer, {
									children: ($$renderer) => {
										PrimaryText($$renderer, {

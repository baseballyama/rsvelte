	let clicked = 0;

	{
		function chip($$renderer, chip) {
			Chip($$renderer, {
				chip,
				shouldRemoveOnTrailingIconClick: false,
				onclick: () => clicked++,
				children: ($$renderer) => {
					if (chip === 'four') {

						disabled: item.disabled,
						selected: selectionIndex === i,
						children: ($$renderer) => {
							Graphic($$renderer, {
								style: `background-image: url(https://placehold.co/40x40?text=${$.stringify(item.name.split(' ').map((val) => val.substring(0, 1)).join(''))});`

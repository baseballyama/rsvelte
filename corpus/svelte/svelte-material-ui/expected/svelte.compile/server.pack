		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!----></div> <div style="margin-top: 1.5em;"><span style="position: relative; display: inline-block; padding: .5em .5em 0 0;">Long content in a badge. `);

	Badge($$renderer, {

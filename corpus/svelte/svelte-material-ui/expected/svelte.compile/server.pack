				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!---->`);
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!----></div> <div style="margin-top: 1.5em;">FAB with a badge. `);

	Fab($$renderer, {
		style: 'position: relative;',
		children: ($$renderer) => {
			Icon($$renderer, {
				class: 'material-icons',
				children: ($$renderer) => {
					$$renderer.push(`<!---->message`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);


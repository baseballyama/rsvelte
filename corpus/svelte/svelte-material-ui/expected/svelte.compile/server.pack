		{ id: 2, label: 'Three' },
		{ id: 3, label: 'Four' },
		{ id: 4, label: 'Five' }
	];

	let newLabel = '';
	let value = void 0;
	let text = '';

	function addObject() {
		const newObject = { id: options[options.length - 1].id + 1, label: newLabel };

		options = [...options, newObject];
		value = newObject;
		dialogOpen = false;
	}


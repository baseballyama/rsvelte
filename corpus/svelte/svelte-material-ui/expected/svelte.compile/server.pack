				},

				set value($$value) {
					value = $$value;
					$$settled = false;
				},
				internalCounter,
				$$slots: { internalCounter: true }
			});
		}

		$$renderer.push(`<!----></div>`);
	}

	do {
		$$settled = true;
		$$inner_renderer = $$renderer.copy();
		$$render_inner($$inner_renderer);
	} while (!$$settled);

	$$renderer.subsume($$inner_renderer);
}

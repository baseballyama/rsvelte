				if (!contains(subMenuElement, event.relatedTarget)) {
					subMenu.setOpen(false);
				}
			});

			on(subMenuElement, 'mouseleave', (event) => {
				if (anchorElement && !contains(anchorElement, event.relatedTarget)) {

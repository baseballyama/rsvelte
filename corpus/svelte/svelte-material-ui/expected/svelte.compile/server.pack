											$$renderer.push(`<!---->${$.escape(item.name)}`);
										},
										$$slots: { default: true }
									});

									$$renderer.push(`<!----> `);

									SecondaryText($$renderer, {
										children: ($$renderer) => {
											$$renderer.push(`<!---->${$.escape(item.description)}`);
										},
										$$slots: { default: true }
									});

									$$renderer.push(`<!---->`);
								},
								$$slots: { default: true }
							});

							$$renderer.push(`<!----> `);

							Meta($$renderer, {

  import Tab, { Icon, Label } from "@smui/tab";
  import TabBar from "@smui/tab-bar";

  let tabs = [
    {
      icon: "access_time",
      label: "Recents",
    },
    {
      icon: "near_me",
      label: "Nearby",
    },
    {
      icon: "favorite",
      label: "Favorites",
    },
  ];

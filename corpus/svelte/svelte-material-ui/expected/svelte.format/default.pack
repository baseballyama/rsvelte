    spanDevices?: {
      desktop?: number;
      tablet?: number;
      phone?: number;
    };

    children?: Snippet;
  };
  let {
    use = [],
    class: className = "",
    align = undefined,
    order = undefined,
    span = undefined,
    spanDevices = {},
    children,
    ...restProps
  }: OwnProps & SmuiAttrs<"div", keyof OwnProps> = $props();


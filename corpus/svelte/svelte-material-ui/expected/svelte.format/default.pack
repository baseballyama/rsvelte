<script lang="ts">
  import type { ComponentProps, Snippet } from "svelte";
  import { onMount, getContext, tick } from "svelte";
  import type { SmuiAttrs, SmuiElementPropMap } from "@smui/common";
  import type { ActionArray } from "@smui/common/internal";
  import {

<script lang="ts">
  import type { Snippet } from "svelte";
  import { onMount, onDestroy, getContext, setContext } from "svelte";
  import { writable } from "svelte/store";
  import type {
    AddLayoutListener,
    RemoveLayoutListener,
    SmuiAttrs,
    SmuiElementPropMap,

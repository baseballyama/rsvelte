    <Item>
      <Image
        src="https://placehold.co/190x{getUnevenImageSize(
          i,
          107,
          200,
          Math.abs,
        )}?text=190x{getUnevenImageSize(i, 107, 200, Math.abs)}"
        alt="Image {i + 1}"
      />
      <Supporting>
        <Label>Image {i + 1}</Label>
      </Supporting>

    instance?.scrollIntoView(index);
  }

  export function getElement() {
    return element;
  }
</script>

<div
  bind:this={element}
  use:useActions={use}
  class={classMap({
    "mdc-tab-bar": true,
    [className]: true,
  })}
  role="tablist"
  {tabindex}
  {...exclude(restProps, ["tabScroller$"])}

  $effect(() => {
    $shouldRemoveOnTrailingIconClickStore = shouldRemoveOnTrailingIconClick;
  });
  setContext(
    "SMUI:chips:chip:shouldRemoveOnTrailingIconClick",
    shouldRemoveOnTrailingIconClickStore,

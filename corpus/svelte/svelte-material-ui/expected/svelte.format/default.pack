      SMUISegmentedButtonSegmentMount(accessor);

    instance.init();

    return () => {
      SMUISegmentedButtonSegmentUnmount &&
        SMUISegmentedButtonSegmentUnmount(accessor);

      instance?.destroy();
      instance = undefined;

    border-bottom-left-radius: 0.4em;
    border-bottom-right-radius: 0.4em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .demo-file-footer a {
    color: inherit;
  }
</style>


      clearTooltipCaretStyles: () => {
        const topCaret = getElement().querySelector<HTMLElement>(
          `.${CssClasses.TOOLTIP_CARET_TOP}`,
        );
        const bottomCaret = getElement().querySelector<HTMLElement>(
          `.${CssClasses.TOOLTIP_CARET_BOTTOM}`,

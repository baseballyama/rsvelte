  let leadingIconClasses: { [k: string]: boolean } = $state({});
  let internalStyles: { [k: string]: string } = $state({});
  const initialSelectedStore = getContext<SvelteStore<boolean>>(
    "SMUI:chips:chip:initialSelected",

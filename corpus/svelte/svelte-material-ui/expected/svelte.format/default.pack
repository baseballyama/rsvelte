<svelte:head>
  <title>Top App Bar - SMUI</title>
</svelte:head>

<section>
  <h2>Top App Bar</h2>

  <h5>Installation</h5>

  <pre class="demo-spaced">npm i -D @smui/top-app-bar</pre>

  <h5>Demos</h5>

  <Demo component={Static} file="top-app-bar/_Static.svelte">
    Top app bars in a container
    {#snippet subtitle()}

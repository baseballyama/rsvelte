    surface$class?: string;
    /**
     * A list of CSS styles.
     */
    surface$style?: string;

    children?: Snippet;
  };
  let {
    use = [],
    class: className = "",
    style = "",
    id = "SMUI-tooltip-" + counter++,
    unbounded = false,
    xPos = "detected",
    yPos = "detected",
    persistent = false,
    interactive = persistent,
    hideFromScreenreader = false,
    showDelay = undefined,
    hideDelay = undefined,
    surface$class = "",
    surface$style = "",
    children,
    ...restProps
  }: OwnProps &
    SmuiAttrs<"div", keyof OwnProps> & {
      [
        k in keyof SmuiElementPropMap["div"] as `surface\$${k}`

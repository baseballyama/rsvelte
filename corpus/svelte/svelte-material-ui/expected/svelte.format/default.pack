    classMap,
    exclude,
    prefixFilter,
    useActions,
  } from "@smui/common/internal";

  import { MDCTabScrollerFoundation, util } from "./mdc";

  const { matches } = ponyfill;

  type OwnProps = {
    /**
     * An array of Action or [Action, ActionProps] to be applied to the element.
     */
    use?: ActionArray;
    /**
     * A space separated list of CSS classes.
     */
    class?: string;

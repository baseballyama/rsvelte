    }
  }

  export function deactivate() {
    active = false;
    instance?.deactivate();
  }

  export function focus() {
    getElement().focus();
  }

  export function getElement() {
    return element.getElement();
  }
</script>

<MyComponent
  {tag}
  bind:this={element}
  use={[
    [
      Ripple,
      {
        ripple,
        unbounded: false,
        addClass,
        removeClass,

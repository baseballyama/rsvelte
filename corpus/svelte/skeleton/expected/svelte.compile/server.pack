		$$renderer.push(`<div class="w-full space-y-4"><header class="flex flex-col items-center gap-4 max-h-96 mx-auto"><div><code class="code">--spacing: ${$.escape(value)}rem</code></div> <input class="input" type="range"${$.attr('value', value)}${$.attr('min', 0.2)}${$.attr('max', 0.3)} step="0.01"/></header> <div class="w-full flex justify-between items-end"><!--[-->`);


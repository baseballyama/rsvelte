import FileIcon from '@lucide/svelte/icons/file';
import FolderIcon from '@lucide/svelte/icons/folder';
import { TreeView, createTreeViewCollection, useTreeView } from '@skeletonlabs/skeleton-svelte';

function treeNode($$renderer, node, indexPath) {
	if (TreeView.NodeProvider) {
		$$renderer.push('<!--[-->');

		TreeView.NodeProvider($$renderer, {
			value: { node, indexPath },
			children: ($$renderer) => {

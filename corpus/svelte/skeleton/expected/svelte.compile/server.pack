				let colorName = each_array[$$index];

				$$renderer.option({ value: colorName }, ($$renderer) => {
					$$renderer.push(`${$.escape(colorName)}`);
				});
			}

			$$renderer.push(`<!--]-->`);
		});

		$$renderer.push(` `);

		if (lightColorName !== 'white') {

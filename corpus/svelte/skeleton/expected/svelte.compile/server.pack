				$$renderer.push('<!--[!-->');
				$$renderer.push('<!--]-->');
			}
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!----> `);

	Slider($$renderer, {
		class: 'w-32 mx-auto',
		value: [value],
		onValueChange: (e) => value = e.value[0],
		step: 10,
		children: ($$renderer) => {
			if (Slider.Control) {
				$$renderer.push('<!--[-->');

				Slider.Control($$renderer, {
					children: ($$renderer) => {

import Edge from '$lib/components/generator/Edges/EdgeOption.svelte';

export default function Edges($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let { mode = 'radius', name, value = void 0, items = [] } = $$props;

		function setValue(v) {
			value = v;

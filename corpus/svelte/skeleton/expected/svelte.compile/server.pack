			let option = each_array[$$index];

			$$renderer.push(`<div class="flex flex-col items-center gap-2"><span class="hidden md:block font-bold text-[10px] -rotate-90 whitespace-nowrap">${$.escape(option.height.replace('h-', ''))}</span> <div${$.attr_class(`${$.stringify(option.height)} w-[5px] bg-primary-500`)}${$.attr_style('', { '--spacing': `${value}rem` })}></div></div>`);

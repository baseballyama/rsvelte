		var text = $.only_child(span, true);

		$.reset(button);

		$.template_effect(
			($0) => {
				$.set_class(button, 1, `btn-icon btn-icon-sm rounded-full ${$0 ?? ''}`);
				$.set_attribute(button, 'title', `Go to ${step.label ?? ''}`);

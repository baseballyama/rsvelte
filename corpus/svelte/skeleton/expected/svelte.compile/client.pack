			avatar: 48,
			name: 'Jane',
			timestamp: 'Yesterday @ 2:30pm',
			message: 'Some message text.',
			color: 'variant-soft-primary'
		},

		{
			id: 1,
			host: false,
			avatar: 14,
			name: 'Michael',

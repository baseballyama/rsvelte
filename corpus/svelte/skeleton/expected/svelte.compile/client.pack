	$.remove_input_defaults(input);

	var button = $.sibling(input, 2);

	$.reset(div);
	$.bind_value(input, () => $.get(value), ($$value) => $.set(value, $$value));
	$.delegated('click', button, handleCopy);
	$.append($$anchor, div);
}

$.delegate(['click']);

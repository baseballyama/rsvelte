															children: ($$anchor, $$slotProps) => {
																$.next();

																var text = $.text();

																text.nodeValue = index + 1;
																$.append($$anchor, text);
															},
															$$slots: { default: true }
														});
													});

													var text_1 = $.sibling(node_4);

													$.template_effect(() => $.set_text(text_1, ` ${$.get(item).title ?? ''}`));
													$.append($$anchor, fragment_5);
												},
												$$slots: { default: true }
											});
										});

										var node_5 = $.sibling(node_3, 2);


		$.template_effect(
			($0) => {
				$.set_class(button, 1, `btn ${$0 ?? ''}`);
				$.set_text(text, o.label);
			},
			[() => activeClass(o.size)]
		);

		$.delegated('click', button, () => set(o.size));
		$.append($$anchor, button);
	});

	$.reset(div_1);
	$.reset(label);
	$.reset(div);
	$.append($$anchor, div);
	$.pop();
}

$.delegate(['click']);

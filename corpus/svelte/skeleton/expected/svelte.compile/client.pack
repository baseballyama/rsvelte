		const results = fuse.search(event.inputValue);

		if (results.length > 0) {
			$.set(items, results.map((result) => result.item), true);
		} else {
			$.set(items, data, true);
		}
	};

	Combobox($$anchor, {
		class: 'max-w-md',
		placeholder: 'Search...',
		get collection() {
			return $.get(collection);
		},

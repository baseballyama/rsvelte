										$.next();

										var fragment_4 = root_1();
										var text = $.first_child(fragment_4);
										var node_4 = $.sibling(text);

										$.component(node_4, () => Accordion.ItemIndicator, ($$anchor, Accordion_ItemIndicator) => {
											Accordion_ItemIndicator($$anchor, {

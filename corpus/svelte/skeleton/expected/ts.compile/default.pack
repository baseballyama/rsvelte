=== 370 packages/skeleton-svelte/src/internal/create-context.ts	js
import { createContext as createContextSvelte } from 'svelte';
export function createContext(defaultValue) {
    const [consume, provide] = createContextSvelte();
    return {
        consume() {
            try {
                return consume();
            }
            catch {
                return defaultValue;
            }
        },
        provide,
    };
}


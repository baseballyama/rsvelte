    const frameworks = await getCollection('frameworks');
    return frameworks.map((framework) => ({
        params: {
            framework: framework.id,
        },
        props: {
            framework,
        },
    }));
}
export const GET = (context) => {
    return new Response(`# Skeleton Documentation\n\n${commonSections
        .map((section) => `## ${section.label}\n\n${section.docs.map((doc) => getMarkdownFromDoc(doc, [context.props.framework])).join('\n')}`)
        .join('\n')}`, {
        headers: {
            'Content-Type': 'text/plain',
        },
    });
};


import { sveltekitCookies } from 'better-auth/svelte-kit';
export const auth = betterAuth({
    baseURL: import.meta.env.DEV ? 'http://localhost:5173' : `https://${env.VERCEL_PROJECT_PRODUCTION_URL}`,
    database: drizzleAdapter(database, {

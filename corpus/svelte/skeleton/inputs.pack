// Utility: Generate Theme
// Generates the {theme}.ts file output for users to copy into their projects.
import {
	settingsBackgrounds,
	settingsBrand,
	settingsColors,
	settingsCore,
	settingsCorners,
	settingsEdges,
	settingsSpacing,
	settingsTypography,
} from '$lib/state/generator.svelte';

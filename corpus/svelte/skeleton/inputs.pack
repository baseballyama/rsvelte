						{/each}
						{#if settingsCustomFonts.font1}
							<option value="var(--font-custom-1)">{settingsCustomFonts.font1.family}</option>
						{/if}
						{#if settingsCustomFonts.font2}
							<option value="var(--font-custom-2)">{settingsCustomFonts.font2.family}</option>
						{/if}
					</select>

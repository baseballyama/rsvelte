=== 1158 packages/skeleton-svelte/src/components/accordion/anatomy/root.svelte	svelte	runes	runes
<script lang="ts" module>
	import type { HTMLAttributes } from '../../../internal/html-attributes.js';
	import type { PropsWithElement } from '../../../internal/props-with-element.js';
	import type { Props } from '@zag-js/accordion';

	export interface AccordionRootProps extends Omit<Props, 'id'>, PropsWithElement<'div'>, HTMLAttributes<'div', 'id' | 'dir'> {}
</script>

<script lang="ts">
	import { useAccordion } from '../modules/provider.svelte';
	import { AccordionRootContext } from '../modules/root-context.js';
	import { splitProps } from '@zag-js/accordion';
	import { mergeProps } from '@zag-js/svelte';

	const props: AccordionRootProps = $props();

	const [accordionProps, componentProps] = $derived(splitProps(props));
	const { element, children, ...rest } = $derived(componentProps);

	const id = $props.id();
	const accordion = useAccordion(() => ({
		...accordionProps,
		id: id,
	}));

	const attributes = $derived(mergeProps(accordion().getRootProps(), rest));

	AccordionRootContext.provide(() => accordion());
</script>

{#if element}
	{@render element(attributes)}
{:else}
	<div {...attributes}>
		{@render children?.()}
	</div>
{/if}

=== 629 packages/skeleton-svelte/src/components/accordion/modules/provider.svelte.ts	svelte-module-ts	runes	-
import { LocaleProviderRootContext } from '../../locale-provider/modules/root-context.js';
import { connect, machine } from '@zag-js/accordion';
import type { Api, Props } from '@zag-js/accordion';
import { normalizeProps, useMachine, type PropTypes } from '@zag-js/svelte';

export function useAccordion(props: Props | (() => Props)): () => Api<PropTypes> {
	const locale = LocaleProviderRootContext.consume();
	const service = useMachine(machine, () => ({
		dir: locale().dir,
		...(typeof props === 'function' ? props() : props),
	}));
	const accordion = $derived(connect(service, normalizeProps));
	return () => accordion;
}


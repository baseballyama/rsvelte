<script>
  import { Layer } from "$lib";

  const render = ({ context, width, height }) => {
    const w = width / 2;
    const h = height / 2;
    const gradient = context.createRadialGradient(w, h, 0, w, h, height);
    gradient.addColorStop(0, "#222");

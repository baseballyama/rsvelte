		$.store_unsub($.set(_y, spring(height * $$props.y, { stiffness: 0.15, damping: 0.2 }), true), '$_y', $$stores);
	};

	const render = ({ context }) => {
		context.globalCompositeOperation = 'screen';
		context.fillStyle = $$props.color;
		context.lineWidth = 10;

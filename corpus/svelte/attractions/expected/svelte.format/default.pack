  export {
    Heading1 as h1,
    Heading2 as h2,
    Heading3 as h3,
    UnorderedList as ul,
    ListItem as li,
    Table as table,
    TableHead as th,
    TableRow as tr,
    TableData as td,
    Mark as mark,
    Paragraph as p,
  };
</script>

<slot />


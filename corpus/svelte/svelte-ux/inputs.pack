    <Button on:click={toggle}>Show Dialog</Button>
    <Dialog {open} on:close={toggleOff}>
      <div slot="title">Are you sure you want to do that?</div>
      <div slot="actions">
        <Button variant="fill" color="primary">Close</Button>
      </div>
    </Dialog>
  </Toggle>

</Preview> -->

<h2>zod schema</h2>

<Preview>
  <Form
    initial={schemaData}
    {schema}
    on:change={(e) => (schemaData = e.detail)}
    let:draft
    let:state
    let:errors
  >
    <div class="grid gap-2">
      <TextField
        label="First Name"

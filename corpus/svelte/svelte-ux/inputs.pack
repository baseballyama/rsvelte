    <svelte:fragment slot="selection" let:value>
      {#if value}
        <Icon data={value?.icon ?? mdiChevronDown} /> {value.label}
      {:else}
        No selection
      {/if}
    </svelte:fragment>
  </MenuButton>
</Preview>

<h2>Icon only</h2>

<Preview>
  <MenuButton options={optionsWithIcons} menuIcon={null}>
    <svelte:fragment slot="selection" let:value>
      <Icon data={value?.icon ?? mdiChevronDown} />
    </svelte:fragment>
  </MenuButton>
</Preview>

<h2>Variant</h2>

<Preview>

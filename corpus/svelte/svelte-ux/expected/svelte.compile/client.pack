							});
						});

						$.append($$anchor, fragment_1);
					}
				}
			});

			$.reset(div);
			$.append($$anchor, div);
		},
		$$slots: { default: true }
	});

	var node_3 = $.sibling(node, 4);

	Preview(node_3, {
		children: ($$anchor, $$slotProps) => {
			var div_1 = root();
			var node_4 = $.child(div_1);

			InfiniteScroll(node_4, {
				get items() {
					return items;
				},
				perPage: 5,
				children: $.invalid_default_snippet,
				$$slots: {

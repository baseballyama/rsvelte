		switch (e.code) {
			case 'ArrowUp':
				increment(step);
				e.preventDefault();
				break;

			case 'ArrowDown':
				increment(-step);
				e.preventDefault();
				break;
		}
	}

	function increment(newValue) {
		value = (value ?? 0) + newValue;

			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <h2>Min / Max date</h2> `);

		Preview($$renderer, {
			children: ($$renderer) => {
				MonthListByYear($$renderer, {
					minDate: startOfYear(subYears(new Date(), 3)),
					maxDate: new Date()
				});
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!---->`);
	});
}

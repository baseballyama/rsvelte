			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <h2>bind:value</h2> `);

		Preview($$renderer, {
			children: ($$renderer) => {
				RangeSlider($$renderer, {
					get value() {
						return value;
					},

					set value($$value) {
						value = $$value;
						$$settled = false;
					}
				});
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <h2>min/max</h2> `);

		Preview($$renderer, {

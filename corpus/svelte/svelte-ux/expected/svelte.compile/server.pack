		$$renderer.push(`<h1>Examples</h1> <h2>Default</h2> `);

		Preview($$renderer, {
			children: ($$renderer) => {
				MonthListByYear($$renderer, {});
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <h2>Selected</h2> `);

		Preview($$renderer, {
			children: ($$renderer) => {
				MonthListByYear($$renderer, { selected });
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <h2>Selected w/ Scroll into view</h2> `);

		Preview($$renderer, {
			children: ($$renderer) => {
				$$renderer.push(`<div class="overflow-auto h-64">`);

				MonthListByYear($$renderer, {
					minDate: subYears(selected, 10),
					maxDate: addYears(selected, 10),
					selected
				});

				$$renderer.push(`<!----></div>`);

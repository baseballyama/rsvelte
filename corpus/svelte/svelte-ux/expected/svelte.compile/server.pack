		let value = 0;

		function onKeyDown(e) {
			const step = e.shiftKey ? 10 : e.altKey ? 100 : 1;

			switch (e.code) {
				case 'ArrowUp':
					increment(step);
					e.preventDefault();
					break;

				case 'ArrowDown':
					increment(-step);
					e.preventDefault();
					break;

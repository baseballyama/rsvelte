interface OptionObject {
  label: string;
  value: string;
}

const simpleOptions: number[] = [];
const complexOptions: string[] | OptionObject[] = [];
const maybeUndefined: number[] | undefined | null = null as any;
const badOptions = {
  object: {},
  number: 1,
};
</script>

<!-- Simple Arrays work fine -->
{#each simpleOptions as option, i}
  <div>{option}, {i}</div>
{/each}

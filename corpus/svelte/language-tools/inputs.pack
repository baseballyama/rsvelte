import ts, { flattenDiagnosticMessageText } from 'typescript';
import {
    CancellationToken,
    Diagnostic,
    DiagnosticSeverity,
    DocumentDiagnosticReport,
    Range
} from 'vscode-languageserver';
import {
    Document,
    getNodeIfIsInStartTag,
    getTextInRange,
    isRangeInTag,
    mapRangeToOriginal

                }
            ],
            label: 'blubb',
            insertText: 'import { blubb$1 } from "../definitions";',
            insertTextFormat: 2,
            kind: CompletionItemKind.Function,
            sortText: '11',
            commitCharacters: undefined,
            preselect: undefined,
            labelDetails: {
                description: '../definitions'
            },
            textEdit: {
                newText: '{ blubb$1 } from "../definitions";',
                range: {
                    end: {
                        character: 15,
                        line: 1
                    },
                    start: {
                        character: 11,
                        line: 1
                    }
                }
            }
        });
    });


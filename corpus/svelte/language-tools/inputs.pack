            {
                diagnostics: [
                    {
                        code: 6133,
                        message: "'a' is declared but its value is never read.",
                        range: Range.create(Position.create(6, 4), Position.create(6, 5)),
                        source: 'ts'
                    }
                ],
                only: [CodeActionKind.QuickFix]
            }
        );


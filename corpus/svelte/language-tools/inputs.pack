function createApiExport(name: string) {
    return {
        allowedIn: ['api', 'server'] as ['api', 'server'],
        displayParts: [
            {
                text: 'export',
                kind: 'keyword'
            },
            {
                text: ' ',
                kind: 'space'
            },
            {

        this.documentHeightProvider = new DocumentHighlightProviderImpl(this.lsAndTsDocResolver);
        this.workspaceSymbolsProvider = new WorkspaceSymbolsProviderImpl(
            this.lsAndTsDocResolver,
            configManager

    codeActionChangeToTextEdit(
        doc: Document,
        snapshot: SvelteDocumentSnapshot,
        change: ts.TextChange,
        isImport: boolean,
        originalTriggerPosition: Position,
        newLine: string,
        is$typeImport?: boolean,
        isCombinedCodeAction?: boolean

        files: Array.from(new Set([...(configFiles ?? []), ...shimFiles])),
        ...(mergedInclude.length ? { include: mergedInclude } : {}),
        ...(mergedExclude.length ? { exclude: mergedExclude } : {}),
        ...(rebasedReferences ? { references: rebasedReferences } : {})

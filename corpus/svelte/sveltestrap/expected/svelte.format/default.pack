<script context="module">
  import Accordion from "./Accordion.svelte";

  export const meta = {
    title: "Stories/Accordion",
    component: Accordion,
    parameters: {
      controls: {
        exclude: /^(default)$/g,
      },
    },
    argTypes: {
      class: {
        control: false,

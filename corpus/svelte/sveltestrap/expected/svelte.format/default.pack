  import Styles from "./Styles.svelte";

  export const meta = {
    title: "Stories/Styles",
    component: Styles,
  };
</script>

<script>
  import { Story } from "@storybook/addon-svelte-csf";

  import {
    Button,
    Icon,
    Dropdown,
    DropdownItem,
    DropdownMenu,
    DropdownToggle,
    ThemeToggler,
    colorMode,
    toggleColorMode,
    useColorMode,
  } from "@sveltestrap/sveltestrap";

  let theme = $colorMode;
</script>

<Story name="Basic">
  <Styles />

  <Button color="primary">
    Nice! <Icon name="emoji-smile-fill" />
  </Button>
</Story>

<Story name="Theme">

      <Dropdown>
        <DropdownToggle color="primary" caret
          >Dropdown's menu is right-aligned</DropdownToggle
        >
        <DropdownMenu end>
          <DropdownItem header>Header</DropdownItem>
          <DropdownItem disabled>Action</DropdownItem>

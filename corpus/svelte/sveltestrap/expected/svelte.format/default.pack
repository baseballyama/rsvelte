            >
            <DropdownMenu>
              <DropdownItem>Menu item</DropdownItem>
              <DropdownItem>Menu item</DropdownItem>
              <DropdownItem>Menu item</DropdownItem>
            </DropdownMenu>
          </Dropdown>
          <Dropdown autoClose="outside">
            <DropdownToggle color="success" caret

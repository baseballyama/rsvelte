			});

			$$renderer.push(`</div>`);
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!----> `);

	Story($$renderer, {
		name: 'Theming',
		children: ($$renderer) => {
			$$renderer.push(`<div class="horizontal gap-lg toast-events">`);

			Toast($$renderer, {
				body: true,
				theme: 'dark',
				header: 'Dark Theme',

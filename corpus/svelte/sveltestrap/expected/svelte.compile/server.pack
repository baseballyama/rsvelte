		plaintext: false,
		reverse: false,
		theme: null,
		type: 'text',
		valid: false,
		value: ''
	}
};

export default function Input_stories($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let changeValue = '';
		let focused = false;
		let inner = '';
		let inputValue = '';
		let radioGroup;

		const resize = () => {
			inner.style.height = 'auto';
			inner.style.height = 4 + inner.scrollHeight + 'px';
		};

		const changeEvent = (e) => {
			changeValue = e.target.value;
		};

		const inputEvent = (e) => {
			inputValue = e.target.value;
		};


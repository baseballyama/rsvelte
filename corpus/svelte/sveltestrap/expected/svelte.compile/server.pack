			$$renderer.push(`<!----></div>`);
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!----> `);

	Story($$renderer, {
		name: 'Uncontrolled',
		children: ($$renderer) => {
			$$renderer.push(`<div class="fade-example">`);

			Button($$renderer, {
				color: 'primary',
				id: 'toggler',
				class: 'mb-3',

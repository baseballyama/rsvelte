			});

			$$renderer.push(`<!----></div></div>`);
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!----> `);

	Story($$renderer, {
		name: 'Actions',
		children: ($$renderer) => {
			$$renderer.push(`<div class="listgroup-example"><div class="listgroup-item-size"><h4 class="text-content">Anchors</h4> `);

			ListGroup($$renderer, {
				children: ($$renderer) => {
					ListGroupItem($$renderer, {

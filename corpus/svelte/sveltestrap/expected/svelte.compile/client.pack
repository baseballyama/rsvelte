				$.key(node_1, () => $.get(args), ($$anchor) => {
					var div = root();
					var node_2 = $.child(div);

					{
						let $0 = $.derived(() => `btn-${$.get(args).placement}`);

						Button(node_2, {
							get id() {
								return $.get($0);

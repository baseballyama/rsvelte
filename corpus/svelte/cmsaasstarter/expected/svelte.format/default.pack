<script lang="ts">
  import { goto } from "$app/navigation";
  import { onMount } from "svelte";

  let { data } = $props();

  let supabase = $derived(data.supabase);
  let message = $state("Signing out....");

  // on mount, sign out
  onMount(() => {
    supabase.auth.signOut().then(({ error }) => {
      if (error) {
        message = "There was an issue signing out.";
      } else {
        goto("/");
      }
    });
  });
</script>


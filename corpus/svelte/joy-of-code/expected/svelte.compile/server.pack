		if (data.component) {
			$$renderer.push('<!--[-->');
			data.component($$renderer, {});
			$$renderer.push('<!--]-->');
		} else {
			$$renderer.push('<!--[!-->');
			$$renderer.push('<!--]-->');
		}

		$$renderer.push(`</article> <div class="cards svelte-jot9ci">`);
		Card($$renderer, { preset: 'support' });
		$$renderer.push(`<!----> `);

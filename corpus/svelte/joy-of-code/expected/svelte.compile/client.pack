		var text = $.only_child(div_3, true);

		$.template_effect(() => $.set_text(text, item));
		$.append($$anchor, div_3);
	});

	$.reset(div_2);

	var button = $.sibling(div_2, 2);

	$.reset(div_1);
	$.reset(div);
	$.delegated('click', button, shuffle);
	$.append($$anchor, div);
	$.pop();
}


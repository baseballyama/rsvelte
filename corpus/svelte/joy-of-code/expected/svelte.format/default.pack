<script lang="ts">
  let text = $state("I love Svelte");

  function toSpongeBobCase(text: string) {
    return text
      .split("")
      .map((c, i) => (i % 2 === 1 ? c.toUpperCase() : c.toLowerCase()))
      .join("");
  }

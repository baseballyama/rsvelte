          <summary>{name}</summary>
          <div class="data">
            <pre>{JSON.stringify(details, null, 2)}</pre>
          </div>
        </details>
      {/each}
    </div>

    <button onclick={() => pokemon.clear()}>🧹 Clear</button>
  </div>
</div>


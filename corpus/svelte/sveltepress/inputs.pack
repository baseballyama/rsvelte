    slug,
    title: slug,
    date: '2026-04-10',
    tags: extra.tags ?? [],
    category: extra.category,
    excerpt: 'x',
    readingTime: 1,
    contentHtml: `<p>${slug}</p>`,
    draft: false,
    ...extra,
  }
}


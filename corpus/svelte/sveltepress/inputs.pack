import { mdToSvelte } from '@sveltepress/vite'
import { describe, expect, it } from 'vitest'
import anchors from '../src/markdown/anchors'

const md = `
## Foo \`foo\`

[foo](/foo/bar)
some content

### Bar/a:b-c&?

some other content

`


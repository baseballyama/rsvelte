    line-height: 1.2;
    margin: 1.75rem 0 0.75rem;
  }

  /* § section glyph divider — replaces the default <hr> */
  .sp-blog-root :global(.sp-post-content hr) {
    border: none;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin: 2rem 0;
    color: var(--sp-blog-muted);
    overflow: visible;

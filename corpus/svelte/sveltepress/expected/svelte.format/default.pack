      "wght" 600,
      "SOFT" 70,
      "WONK" 1;
    font-size: 1.625rem;
    line-height: 1.14;
    margin: 2rem 0 0.875rem;
  }
  .sp-blog-root :global(.sp-post-content h3) {
    font-variation-settings:

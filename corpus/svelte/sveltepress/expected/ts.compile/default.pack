//   +layout.svelte  →  with globalLayout  (GlobalLayout.svelte) as <PageLayout {fm}>
//   +page.svelte    →  with pageLayout    (PageLayout.svelte)   as <PageLayout {fm}>
// The import `import PageLayout from '...'` is injected by the core plugin.

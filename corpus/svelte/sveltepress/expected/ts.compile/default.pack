export function resolveSidebar(routeId) {
    if (!routeId)
        return;
    const normalizedRouteId = routeId.replace(/\/$/, '');
    const key = Object.keys(themeOptions.sidebar || {}).find(key => normalizedRouteId.startsWith(key.replace(/\/$/, '')));

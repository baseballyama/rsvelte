									var text = $.first_child(fragment_4);
									var node_2 = $.sibling(text);

									Refresh(node_2, {});
									$.template_effect(() => $.set_text(text, `${(themeOptions?.i18n?.pwa?.reload || DEFAULT_RELOAD) ?? ''} `));
									$.append($$anchor, fragment_4);

					var fragment_2 = $.comment();
					var node_1 = $.first_child(fragment_2);

					{
						var consequent = ($$anchor) => {
							Btn($$anchor, {
								onclick: () => updateServiceWorker(true),
								children: ($$anchor, $$slotProps) => {
									$.next();


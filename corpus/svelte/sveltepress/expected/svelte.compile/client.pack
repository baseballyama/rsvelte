	var div = $.sibling(node, 2);
	let classes;
	var div_1 = $.child(div);

	$.bind_this(div_1, ($$value) => arrowEl = $$value, () => arrowEl);

	var node_1 = $.sibling(div_1, 2);

	$.snippet(node_1, () => $$props.content ?? $.noop);

			{
				key: 'twitter',
				label: 'Twitter/X',
				href: (v) => `https://x.com/${v}`
			},
			{ key: 'mastodon', label: 'Mastodon', href: (v) => v },
			{
				key: 'bluesky',
				label: 'Bluesky',
				href: (v) => `https://bsky.app/profile/${v}`
			},
			{ key: 'email', label: 'Email', href: (v) => `mailto:${v}` },
			{ key: 'website', label: 'Website', href: (v) => v },
			{ key: 'rss', label: 'RSS', href: (v) => v }

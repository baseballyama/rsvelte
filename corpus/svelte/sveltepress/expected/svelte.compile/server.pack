    line-height: 1;
    color: var(--sp-blog-text);
  }
  .sp-tl__year-sub.svelte-yy4qai {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--sp-blog-primary);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .sp-tl__year-count.svelte-yy4qai {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.72rem;
    color: var(--sp-blog-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Post list ──────────────────────────────────── */
  .sp-tl__list.svelte-yy4qai {
    list-style: none;
    padding: 0;

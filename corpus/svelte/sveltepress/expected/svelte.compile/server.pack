    padding-right: 1.5rem;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.6s,
      transform 0.6s;
  }
  .sp-tl__year.svelte-yy4qai.is-visible {
    opacity: 1;
    transform: none;
  }
  .sp-tl__year-num.svelte-yy4qai {
    display: block;
    font-size: 1.5rem;
    font-weight: 900;

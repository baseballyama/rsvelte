				const end = i + 1 < positions.length ? positions[i + 1] : docBottom;

				if (start < viewportBottom && end > viewportTop) {
					if (first === -1) first = i;

					last = i;
				}
			}

			if (first === -1) first = last = 0;

			activeRange = [first, last];
		}

		onMount(() => {
			mounted = true;

			const anchorTarget = decodeURI(page.url.hash);

			if (!anchorTarget) {
				computeActiveRange();


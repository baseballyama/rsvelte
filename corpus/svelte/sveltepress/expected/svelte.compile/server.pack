				$$renderer.push(`<a${$.attr('href', `${base}/tags/${tag}/`)} class="sp-post-meta__tag svelte-ah1ck6"${$.attr_style(`view-transition-name: sp-tag-${$.stringify(post.slug)}-${$.stringify(i)}`)}>${$.escape(tag)}</a>`);

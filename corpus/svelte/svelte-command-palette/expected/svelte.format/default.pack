  :global(body.light) .cp-result-description {
    color: #9ca3af;
  }

  /* Light mode: media query fallback */
  @media (prefers-color-scheme: light) {
    .cp-result:hover,
    .cp-result-active {
      background: #f3f4f6;
    }

    .cp-result-icon {
      background: #f3f4f6;
    }

    .cp-result-title {

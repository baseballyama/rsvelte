	.hero.svelte-juboms {
		position: relative;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 8rem 1.5rem 4rem;
		overflow: hidden;
	}

	.hero-glow.svelte-juboms {
		position: absolute;
		top: -50%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 800px;
		height: 600px;
		background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(255, 62, 0, 0.15), transparent);
		pointer-events: none;
	}

	.hero-content.svelte-juboms {
		position: relative;
		max-width: 720px;
		text-align: center;
		margin-bottom: 4rem;
	}

	.hero-badge.svelte-juboms {
		margin-bottom: 1.5rem;
	}

	.hero-title.svelte-juboms {
		margin-bottom: 1.5rem;
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.hero-description.svelte-juboms {
		max-width: 560px;
		margin: 0 auto 2rem;
		font-size: 1.125rem;
		line-height: 1.7;
		color: var(--color-text-secondary);
	}

	.hero-actions.svelte-juboms {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 3rem;
	}

	.btn-lg.svelte-juboms {
		padding: 0.875rem 1.5rem;
		font-size: 1rem;
	}

	.btn-primary.svelte-juboms .kbd-group:where(.svelte-juboms) {
		display: flex;
		gap: 0.25rem;
		margin-left: 0.5rem;
		padding-left: 0.75rem;
		border-left: 1px solid rgba(255, 255, 255, 0.2);
	}

	.btn-primary.svelte-juboms .kbd:where(.svelte-juboms) {
		background: rgba(255, 255, 255, 0.15);
		border-color: rgba(255, 255, 255, 0.2);
		color: white;
		box-shadow: none;
	}

	.hero-stats.svelte-juboms {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
	}

	.stat.svelte-juboms {
		text-align: center;
	}

	.stat-value.svelte-juboms {
		display: block;
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--color-text-primary);
	}

	.stat-label.svelte-juboms {
		font-size: 0.875rem;
		color: var(--color-text-tertiary);
	}

	.stat-divider.svelte-juboms {
		width: 1px;
		height: 40px;
		background: var(--color-border);
	}

	/* Demo Window */
	.hero-visual.svelte-juboms {
		position: relative;
		width: 100%;
		max-width: 560px;
		perspective: 1000px;
	}

	.demo-window.svelte-juboms {
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: 
			0 25px 50px -12px rgba(0, 0, 0, 0.4),
			0 0 0 1px rgba(255, 255, 255, 0.05);
		animation: float 6s ease-in-out infinite;
	}

	.demo-header.svelte-juboms {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		background: var(--color-bg-tertiary);
		border-bottom: 1px solid var(--color-border);
	}

	.demo-dots.svelte-juboms {
		display: flex;
		gap: 0.375rem;
	}

	.demo-dots.svelte-juboms span:where(.svelte-juboms) {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}

	.demo-dots.svelte-juboms span:where(.svelte-juboms):nth-child(1) { background: #ff5f57; }
	.demo-dots.svelte-juboms span:where(.svelte-juboms):nth-child(2) { background: #ffbd2e; }
	.demo-dots.svelte-juboms span:where(.svelte-juboms):nth-child(3) { background: #28c840; }

	.demo-title.svelte-juboms {
		font-size: 0.8125rem;
		color: var(--color-text-tertiary);
	}

	.demo-content.svelte-juboms {
		padding: 0.5rem;
	}

	.demo-search.svelte-juboms {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.875rem 1rem;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text-tertiary);
	}

	.demo-search.svelte-juboms span:where(.svelte-juboms) {
		flex: 1;
	}

	.demo-results.svelte-juboms {
		padding: 0.5rem 0;
	}

	.demo-result.svelte-juboms {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		border-radius: var(--radius-md);
		transition: background var(--transition-fast);
	}

	.demo-result.active.svelte-juboms {
		background: var(--color-bg-hover);
	}

	.demo-result-icon.svelte-juboms {
		font-size: 1.25rem;
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-bg-tertiary);
		border-radius: var(--radius-sm);
	}

	.demo-result-content.svelte-juboms {
		flex: 1;
	}

	.demo-result-title.svelte-juboms {
		display: block;
		font-weight: 500;
		color: var(--color-text-primary);
	}

	.demo-result-subtitle.svelte-juboms {
		font-size: 0.8125rem;
		color: var(--color-text-tertiary);
	}

	.demo-result-kbd.svelte-juboms {
		display: flex;
		gap: 0.25rem;
	}

	@media (max-width: 768px) {
		.hero.svelte-juboms {
			padding: 6rem 1rem 2rem;
		}

		.hero-content.svelte-juboms {
			margin-bottom: 2rem;
		}

		.hero-actions.svelte-juboms {
			flex-direction: column;
		}

		.btn-lg.svelte-juboms {
			width: 100%;
			justify-content: center;
		}

		.hero-stats.svelte-juboms {
			gap: 1.5rem;
		}

		.stat-value.svelte-juboms {
			font-size: 1.25rem;
		}

		.demo-window.svelte-juboms {
			animation: none;
		}
	}


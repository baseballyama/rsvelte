<script lang="ts">
	import { page } from '$app/stores';
	import switchTheme from '../utils/switchTheme';

	let isMenuOpen = $state(false);

	const toggleMenu = () => {
		isMenuOpen = !isMenuOpen;
	};

	const closeMenu = () => {
		isMenuOpen = false;
	};
</script>

<nav class="navbar">

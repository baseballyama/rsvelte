	.approach-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--space-md);
		margin: var(--space-xl) 0;
	}

	.approach-card {
		padding: var(--space-lg);

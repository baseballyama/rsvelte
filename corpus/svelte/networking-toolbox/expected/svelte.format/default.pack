            <tr>
              <td><code>{boundary.cidr}</code></td>
              <td><code>{boundary.example}</code></td>
              <td><code>{boundary.reverseZone}</code></td>
              <td>{boundary.description}</td>
              <td>{boundary.delegation}</td>
            </tr>
          {/each}
        </tbody>
      </table>


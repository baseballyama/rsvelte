      <ul>
        {#each arpVsNdpContent.arpDetails.limitations as limitation, index (`arp-limitation-${index}`)}
          <li>{limitation}</li>
        {/each}
      </ul>
    </div>

    <div class="ref-section">
      <h2>{arpVsNdpContent.ndpDetails.title}</h2>

      <h3>NDP Message Types</h3>

          {#if showBinaryView}
            <div class="detail-item full-width">
              <div class="detail-label-wrapper">
                <span class="detail-label">Binary Prefix Representation</span>
                <Tooltip
                  text="128-bit binary representation showing network (1) and host (0) bits"

      display: block;
      margin-top: var(--spacing-xs);
    }
  }

  .info-section {
    margin-bottom: var(--spacing-md);
  }

  .matches-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .export-buttons {

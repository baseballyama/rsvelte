      font-size: var(--font-size-lg);
      margin-bottom: var(--spacing-sm);
      color: var(--text-primary);
    }

    p {
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
    }
  }

  @media (max-width: 768px) {
    .legal-card {
      padding: var(--spacing-md);

      .card-icon {
        width: 40px;
        height: 40px;
      }

      .card-content h3 {
        font-size: var(--font-size-md);
      }

                size="xs"
              />
              {clipboard.isCopied("isc") ? "Copied" : "Copy"}
            </button>
          </div>
          <pre class="output-value code-block">{result.examples.iscDhcpd}</pre>
        </div>
      </div>
    {/if}
  {/if}
</ToolContentContainer>


            <strong>Typical:</strong>
            {ipv6PrivacyContent.lifetimes.validLifetime.typical}
          </div>
          <div>
            <strong>Behavior:</strong>
            {ipv6PrivacyContent.lifetimes.validLifetime.behavior}
          </div>
        </div>

        <div class="grid-item">

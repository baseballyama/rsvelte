              <button
                class="btn btn-danger btn-sm"
                onclick={() => removeGateway(i)}>Remove</button
              >
            {/if}
          </div>
        {/each}
        <button class="btn btn-secondary btn-sm" onclick={addGateway}
          >Add Gateway</button
        >
      </div>

      {#if buildErrors.length > 0}
        <div class="error-card">
          <strong>Validation Errors:</strong>

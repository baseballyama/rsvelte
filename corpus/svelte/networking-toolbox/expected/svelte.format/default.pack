          padding: 0 var(--spacing-sm);
          &:not(:last-child) {
            border-bottom: 1px solid var(--border-primary);
          }
          &:before {
            margin-right: var(--spacing-sm);
            font-weight: bold;
          }
        }
      }
    }
  }

  .license-content {

                  >
                </div>
                {#if diagnosticState.results.tls.certificate}
                  <div class="tls-item">
                    <span class="tls-label">Certificate CN:</span>
                    <span class="tls-value"
                      >{diagnosticState.results.tls.certificate.cn}</span
                    >
                  </div>
                {/if}
              </div>
            </div>
          </div>
        {/if}
      </div>
    </div>
  {/if}
</div>


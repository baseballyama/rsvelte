      color: var(--text-secondary);
    }

    .breakdown-value {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);

      code {
        font-family: var(--font-mono);
        color: var(--color-primary);
        word-break: break-all;
      }

      small {
        color: var(--text-secondary);
        font-size: 0.85rem;
      }
    }
  }

  @media (max-width: 768px) {
    .timestamp-controls {
      flex-direction: column;
    }

    .breakdown-item {
      grid-template-columns: 1fr;
    }
  }

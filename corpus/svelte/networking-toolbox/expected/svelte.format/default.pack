              {/each}
            </ul>
          </div>
        </div>
      {/each}
    </div>

    <div class="ref-section">
      <h2>Troubleshooting Common Issues</h2>
      {#each multicastContent.troubleshooting as issue, index (`${issue.issue}-${index}`)}
        <div class="ref-examples">
          <div class="examples-title">{issue.issue}</div>

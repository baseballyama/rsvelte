/* useDiagnosticState.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export function useDiagnosticState() {
	let loading = $.state(false);
	let error = $.state(null);
	let results = $.state(null);

	function setLoading(value) {
		$.set(loading, value, true);
	}

	function setError(errorMessage) {
		$.set(error, errorMessage, true);
		$.set(loading, false);
	}

	function setResults(data) {
		$.set(results, data, true);
		$.set(error, null);
		$.set(loading, false);
	}

	function reset() {
		$.set(loading, false);
		$.set(error, null);
		$.set(results, null);
	}

	function startOperation() {
		$.set(loading, true);
		$.set(error, null);
		$.set(results, null);
	}

	return {
		get loading() {
			return $.get(loading);
		},

		get error() {
			return $.get(error);
		},

		get results() {
			return $.get(results);
		},
		setLoading,
		setError,
		setResults,
		reset,
		startOperation
	};
}

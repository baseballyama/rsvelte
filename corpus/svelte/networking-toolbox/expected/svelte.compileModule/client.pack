/* useClipboard.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { errorManager } from '$lib/utils/error-manager';

export function useClipboard(autoResetMs = 1500) {
	let copiedStates = $.state($.proxy({}));

	/**
	 * Copy text to clipboard with feedback
	 * @param text - Text to copy
	 * @param id - Unique identifier for this copy action (optional)
	 */
	async function copy(text, id = 'default') {
		try {
			await navigator.clipboard.writeText(text);
			$.get(copiedStates)[id] = true;

			setTimeout(
				() => {
					$.get(copiedStates)[id] = false;
				},
				autoResetMs
			);

			return true;
		} catch(error) {
			errorManager.captureException(error, 'warn', { component: 'Clipboard', action: 'copy', id });

			return false;
		}
	}

	/**
	 * Check if a specific copy action is in "copied" state
	 */
	function isCopied(id = 'default') {
		return $.get(copiedStates)[id] ?? false;
	}

	/**
	 * Reset a specific copy state
	 */
	function reset(id = 'default') {
		$.get(copiedStates)[id] = false;
	}

	/**
	 * Reset all copy states
	 */
	function resetAll() {
		$.set(copiedStates, {}, true);
	}

	return {
		get copiedStates() {
			return $.get(copiedStates);
		},
		copy,
		isCopied,
		reset,
		resetAll
	};
}

/* useExamples.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export function useExamples(examples) {
	let selectedIndex = $.state(null);

	function select(index) {
		$.set(selectedIndex, index, true);
	}

	function clear() {
		$.set(selectedIndex, null);
	}

	function isSelected(index) {
		return $.get(selectedIndex) === index;
	}

	function getSelected() {
		if ($.get(selectedIndex) === null) return null;

		return examples[$.get(selectedIndex)] ?? null;
	}

	return {
		get selectedIndex() {
			return $.get(selectedIndex);
		},
		select,
		clear,
		isSelected,
		getSelected
	};
}
=== 708 src/lib/composables/useToolSearch.svelte.ts	js
/* useToolSearch.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export function useToolSearch(getTools) {
	const state = $.proxy({ query: '', filtered: getTools() });

	// Update filtered whenever query or tools change
	$.user_effect(() => {
		const tools = getTools();

		if (!state.query.trim()) {
			state.filtered = tools;
		} else {
			const normalizedQuery = state.query.toLowerCase().trim();

			state.filtered = tools.filter((tool) => tool.label.toLowerCase().includes(normalizedQuery) || tool.description?.toLowerCase().includes(normalizedQuery) || tool.keywords?.some((keyword) => keyword.toLowerCase().includes(normalizedQuery)));
		}
	});

	return state;
}

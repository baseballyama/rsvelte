/* useDiagnosticState.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';

export function useDiagnosticState() {
	let loading = false;
	let error = null;
	let results = null;

	function setLoading(value) {
		loading = value;
	}

	function setError(errorMessage) {
		error = errorMessage;
		loading = false;
	}

	function setResults(data) {
		results = data;
		error = null;
		loading = false;
	}

	function reset() {
		loading = false;
		error = null;
		results = null;
	}

	function startOperation() {
		loading = true;
		error = null;
		results = null;
	}

	return {
		get loading() {
			return loading;
		},

		get error() {
			return error;
		},

		get results() {
			return results;
		},
		setLoading,
		setError,
		setResults,
		reset,
		startOperation
	};
}

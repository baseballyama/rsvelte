      font-size: var(--font-size-xs);
    }
  }

  .copy-btn.svelte-xt4xlo,
  .export-btn.svelte-xt4xlo {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: var(--font-size-sm);
    transition: all 0.3s ease;

    color: var(--text-secondary);
    cursor: pointer;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    font-size: var(--font-size-sm);

    &:hover {
      background-color: var(--surface-hover);
      color: var(--text-primary);
      border-color: var(--border-primary);
    }

    &.copied {
      color: var(--color-success);
      border-color: var(--color-success);
    }
  }

  .error-result.svelte-lsjtaq {
    text-align: center;
    padding: var(--spacing-xl);
    background-color: var(--bg-secondary);
    border: 1px solid var(--color-error);
    border-radius: var(--radius-lg);
    color: var(--color-error-light);

    .icon {
      color: var(--color-error);
      margin-bottom: var(--spacing-md);
    }

    h4:where(.svelte-lsjtaq) {
      margin-bottom: var(--spacing-md);
    }

    p:where(.svelte-lsjtaq) {
      margin-bottom: var(--spacing-lg);
    }
  }

  .error-help.svelte-lsjtaq {
    text-align: left;
    background-color: var(--bg-tertiary);
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    color: var(--text-secondary);

    ul:where(.svelte-lsjtaq) {
      margin-top: var(--spacing-sm);
      padding-left: var(--spacing-lg);

      li:where(.svelte-lsjtaq) {
        margin-bottom: var(--spacing-xs);
        font-family: var(--font-mono);
        font-size: var(--font-size-sm);
      }
    }
  }

  .education-card.svelte-lsjtaq {
    border-top: 1px solid var(--border-secondary);
    padding-top: var(--spacing-xl);
  }

  .education-grid.svelte-lsjtaq {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
  }

  .education-item.svelte-lsjtaq {
    padding: var(--spacing-lg);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);

    h4:where(.svelte-lsjtaq) {
      margin-bottom: var(--spacing-md);
      font-size: var(--font-size-md);
      color: var(--color-primary);
    }

    p:where(.svelte-lsjtaq) {
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
    }

    code:where(.svelte-lsjtaq) {
      background-color: var(--bg-tertiary);
      color: var(--text-primary);
      padding: 2px var(--spacing-xs);
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
    }
  }

  @media (max-width: 768px) {
    .examples-grid.svelte-lsjtaq {
      grid-template-columns: 1fr;
    }

    .summary-stats.svelte-lsjtaq {
      grid-template-columns: repeat(2, 1fr);
    }

    .records-list.svelte-lsjtaq {
      grid-template-columns: 1fr;
    }

    .education-grid.svelte-lsjtaq {
      grid-template-columns: 1fr;
    }

    .action-item.svelte-lsjtaq .action-header:where(.svelte-lsjtaq) {
      flex-wrap: wrap;
    }
  }


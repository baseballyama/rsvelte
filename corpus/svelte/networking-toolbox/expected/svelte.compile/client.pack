  .lookup-form.svelte-180351m {
    display: flex;
    gap: var(--spacing-md);
    align-items: flex-end;

    label:where(.svelte-180351m) {
      display: block;
      margin-bottom: var(--spacing-sm);
      color: var(--text-primary);
      font-weight: 500;
    }

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .input-row.svelte-180351m {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;

    input:where(.svelte-180351m) {
      width: 100%;
    }
  }

  .port-row.svelte-180351m {
    display: flex;
    flex-direction: column;
    width: 120px;

    input:where(.svelte-180351m) {
      width: 100%;
    }

    @media (max-width: 768px) {
      width: 100%;
    }
  }

  .lookup-btn.svelte-180351m {
    flex-shrink: 0;
    white-space: nowrap;

    @media (max-width: 768px) {
      width: 100%;
    }
  }

  .results-grid.svelte-180351m {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

  .card.svelte-h9my3f {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .card-header.svelte-h9my3f {
    margin-bottom: var(--spacing-lg);

    h2:where(.svelte-h9my3f) {
      margin-bottom: var(--spacing-sm);
      font-size: var(--font-size-xl);
    }

    p:where(.svelte-h9my3f) {
      color: var(--text-secondary);
      margin: 0;
    }
  }

  .input-group.svelte-h9my3f {
    margin-bottom: var(--spacing-lg);

    label:where(.svelte-h9my3f) {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      margin-bottom: var(--spacing-sm);
      font-weight: 600;
      color: var(--text-primary);
    }

    textarea:where(.svelte-h9my3f) {
      width: 100%;
      padding: var(--spacing-md);
      border: 1px solid var(--border-primary);
      border-radius: var(--radius-md);
      background-color: var(--bg-primary);
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      resize: vertical;
      min-height: 120px;

      &:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 2px rgba(var(--color-primary-rgb), 0.2);
      }

      &::placeholder {
        color: var(--text-secondary);
      }
    }
  }

  .algorithm-section.svelte-h9my3f {
    margin-bottom: var(--spacing-lg);

    h4:where(.svelte-h9my3f) {
      margin-bottom: var(--spacing-md);
      color: var(--text-primary);
    }
  }

  .algorithm-options.svelte-h9my3f {
    display: grid;

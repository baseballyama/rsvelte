	var div_3 = $.child(div_2);
	var span = $.sibling($.child(div_3), 2);
	var text = $.only_child(span);

	$.reset(div_3);
	$.reset(div_2);
	$.reset(div);

	$.template_effect(() => {
		$.set_value(input, $mask());
		$.set_class(input, 1, `mask-input ${$isValid() ? '' : 'invalid'}`, 'svelte-9wj47d');
		$.set_text(text, `/${$cidr() ?? ''}`);

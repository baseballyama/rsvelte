  .info-card.svelte-nopgro {
    margin-bottom: var(--spacing-xl);
  }

  .overview-content.svelte-nopgro {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .overview-item.svelte-nopgro {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    color: var(--text-secondary);

    strong:where(.svelte-nopgro) {
      color: var(--text-primary);
    }
  }

  .examples-card.svelte-nopgro {
    margin-bottom: var(--spacing-xl);
    padding: 0;
  }

  .examples-details.svelte-nopgro {
    border: none;
    background: none;

    &[open] {
      .examples-summary:where(.svelte-nopgro) .icon {
        transform: rotate(90deg);
      }
    }
  }

  .examples-summary.svelte-nopgro {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-md);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: all var(--transition-fast);
    border-radius: var(--radius-md);

    &:hover {
      background-color: var(--surface-hover);
    }

    &::-webkit-details-marker {
      display: none;
    }

    .icon {
      transition: transform var(--transition-fast);
    }


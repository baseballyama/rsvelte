		ipv4hint: 'IPv4 address hints to avoid additional DNS lookups',
		ech: 'Encrypted Client Hello configuration',
		ipv6hint: 'IPv6 address hints to avoid additional DNS lookups'
	};

	const parameterKeyMap = {
		mandatory: 0,

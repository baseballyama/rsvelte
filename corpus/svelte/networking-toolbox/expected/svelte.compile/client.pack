      line-height: 1.5;
    }
  }

  .output-formats.svelte-16rb1ok {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .output-group.svelte-16rb1ok {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .output-header.svelte-16rb1ok {
    display: flex;
    align-items: center;
    justify-content: space-between;

    h4:where(.svelte-16rb1ok) {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
    }
  }

  .copy-btn.svelte-16rb1ok {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    background: transparent;
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      background: var(--surface-hover);
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    &.copied {
      background: color-mix(in srgb, var(--color-success), transparent 90%);
      border-color: var(--color-success);
      color: var(--color-success);
    }
  }

  .output-value.svelte-16rb1ok {
    padding: var(--spacing-md);
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-primary);
    word-break: break-all;
    overflow-x: auto;
  }

  .code-block.svelte-16rb1ok {
    white-space: pre;
    word-break: normal;
    overflow-x: auto;
  }

  .format-hint.svelte-16rb1ok {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .info.svelte-16rb1ok {
    margin-top: var(--spacing-lg);
    background: color-mix(in srgb, var(--color-warning), transparent 95%);
    border-color: var(--color-warning);

		if (latency < 100) return 'excellent';
		if (latency < 300) return 'good';
		if (latency < 1000) return 'fair';

		return 'poor';
	}

	function getLatencyDescription(latency) {
		if (latency < 100) return 'Excellent';
		if (latency < 300) return 'Good';
		if (latency < 1000) return 'Fair';

		return 'Poor';
	}


  .card-section-header.svelte-1kxph8y {
    margin-bottom: var(--spacing-md);

    h3:where(.svelte-1kxph8y) {
      margin: 0;
      color: var(--text-primary);
    }
  }

  .info-grid.svelte-1kxph8y {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
  }

  .info-item.svelte-1kxph8y {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--bg-tertiary);
    border-radius: var(--radius-md);
  }

  .info-label.svelte-1kxph8y {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--text-secondary);
  }

  .info-value.svelte-1kxph8y {
    font-size: var(--font-size-sm);
    color: var(--text-primary);

    &.mono {
      font-family: var(--font-mono);
    }
  }

  .status-content.svelte-1kxph8y {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .status-item.svelte-1kxph8y {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .status.svelte-1kxph8y {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);

    &.success {
      color: var(--color-success);
    }
  }

  .loading.svelte-1kxph8y {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);

    .spinner:where(.svelte-1kxph8y) {
      width: 1rem;
      height: 1rem;
      border: 2px solid var(--border-primary);
      border-top: 2px solid var(--color-primary);
      border-radius: 50%;
      animation: svelte-1kxph8y-spin 1s linear infinite;
    }
  }

  .status-summary.svelte-1kxph8y {
    text-align: right;

    @media (max-width: 768px) {
      text-align: left;
    }

    p:where(.svelte-1kxph8y) {
      margin: 0;
      font-size: var(--font-size-xs);
      color: var(--text-secondary);
    }
  }

  .records-header.svelte-1kxph8y {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);

    h3:where(.svelte-1kxph8y) {
      margin: 0;
    }
  }

  .copy-button.svelte-1kxph8y {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--transition-fast);

    &:hover {
      background-color: var(--surface-hover);
    }

    &.copied {
      color: var(--color-success);
      border-color: var(--color-success);
    }
  }

  .record-section.svelte-1kxph8y {
    margin-bottom: var(--spacing-xl);

    h4:where(.svelte-1kxph8y) {
      margin-bottom: var(--spacing-md);
      color: var(--text-primary);
    }
  }

  .record-list.svelte-1kxph8y {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .record-item.svelte-1kxph8y {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
    background-color: var(--bg-tertiary);
    border-radius: var(--radius-md);
  }

  .record-content.svelte-1kxph8y {
    flex: 1;
    min-width: 0;
  }

  .record-text.svelte-1kxph8y {
    font-size: var(--font-size-sm);
    word-break: break-all;
    line-height: 1.4;
    margin-bottom: var(--spacing-xs);

    &.mono {
      font-family: var(--font-mono);
    }
  }

  .record-meta.svelte-1kxph8y {
    font-size: var(--font-size-xs);
    color: var(--text-secondary);
  }

  .copy-button-small.svelte-1kxph8y {
    padding: var(--spacing-xs);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;

    &:hover {
      background-color: var(--surface-hover);
    }

    &.copied {
      color: var(--color-success);
      border-color: var(--color-success);
    }
  }

  .education-card.svelte-1kxph8y {
    border-top: 1px solid var(--border-secondary);
    padding-top: var(--spacing-xl);
  }

  .education-grid.svelte-1kxph8y {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-lg);
  }

  .education-item.svelte-1kxph8y {
    padding: var(--spacing-lg);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);

    h4:where(.svelte-1kxph8y) {
      margin-bottom: var(--spacing-md);
      font-size: var(--font-size-md);
      color: var(--color-primary);
    }

    p:where(.svelte-1kxph8y) {
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
    }
  }

  @keyframes svelte-1kxph8y-spin {
    0% {
      transform: rotate(0deg);
    }
    100% {

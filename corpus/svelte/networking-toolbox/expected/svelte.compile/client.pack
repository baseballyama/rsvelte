	async function checkMXHealth() {
		diagnosticState.startOperation();

		try {
			const response = await fetch('/api/internal/diagnostics/email', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					action: 'mx-health',
					domain: $.get(domain).trim(),
					checkPorts: $.get(checkPorts)
				})

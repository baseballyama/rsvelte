    padding-top: var(--spacing-xl);
  }

  .education-grid.svelte-1o1sghw {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
  }

  .education-item.svelte-1o1sghw {

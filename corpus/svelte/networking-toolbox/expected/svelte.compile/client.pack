  .input-section.svelte-gcckok {
    margin-bottom: var(--spacing-lg);
  }

  .input-grid.svelte-gcckok {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--spacing-md);
  }

  .prefix-input-wrapper.svelte-gcckok {
    position: relative;
    display: flex;
    align-items: center;

    input:where(.svelte-gcckok) {
      padding-right: 3rem;
      width: 100%;
    }

    .prefix-hint:where(.svelte-gcckok) {
      position: absolute;
      right: var(--spacing-md);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      pointer-events: none;
    }

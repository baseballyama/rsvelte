  .explainer-section.svelte-1ln6sgn {
    margin-top: var(--spacing-xl);
    padding: var(--spacing-lg);
    background: linear-gradient(135deg, var(--bg-tertiary), var(--bg-secondary));
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-secondary);

    h3:where(.svelte-1ln6sgn) {
      margin-bottom: var(--spacing-lg);
      text-align: center;
      color: var(--color-primary);
    }

    @media (max-width: 768px) {
      padding: var(--spacing-md);
    }
  }

  .explainer-grid.svelte-1ln6sgn {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .value-copy.svelte-1ln6sgn {
    flex: none;
  }

  .explainer-card.svelte-1ln6sgn {
    cursor: default;
  }

  .tips-box.svelte-1ln6sgn {
    background-color: var(--bg-primary);
    border: 1px solid var(--color-warning);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);

    h4:where(.svelte-1ln6sgn) {
      color: var(--color-warning);
      margin-bottom: var(--spacing-sm);
    }

    ul:where(.svelte-1ln6sgn) {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    li:where(.svelte-1ln6sgn) {
      margin-bottom: var(--spacing-sm);
      color: var(--text-primary);
      font-size: var(--font-size-sm);
      line-height: 1.6;

      &::before {
        content: '•';
        color: var(--color-warning);
        font-weight: bold;
        display: inline-block;
        width: 1em;
        margin-right: var(--spacing-xs);
      }
    }
  }


  .shortcuts-backdrop.svelte-1me4x3i {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-md);
    animation: svelte-1me4x3i-fadeIn 0.15s ease-out;

    @media (max-width: 768px) {
      padding: 0;
      align-items: stretch;
      background: var(--bg-primary);
    }
  }

  .shortcuts-dialog.svelte-1me4x3i {
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    max-width: 32rem;
    width: 100%;
    max-height: 80vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: svelte-1me4x3i-slideInScale 0.2s ease-out;
    min-height: 548px;

    @media (max-width: 768px) {
      max-width: 100%;
      height: 100vh;
      height: 100dvh;
      max-height: none;
      border-radius: 0;
      border: none;
      box-shadow: none;
      animation: svelte-1me4x3i-slideInFromBottom var(--transition-normal);
      min-height: auto;
    }
  }

  .dialog-header.svelte-1me4x3i {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-md) var(--spacing-lg);
    border-bottom: 1px solid var(--border-primary);
    .dialog-header-main:where(.svelte-1me4x3i) {
      display: flex;
      width: 100%;
      padding-right: var(--spacing-sm);
      align-items: center;
      justify-content: space-between;

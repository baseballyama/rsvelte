			if (!dnskey) {
				$.set(error, 'Failed to parse DNSKEY record');

				return;
			}

			const normalizedOwner = $.get(ownerName).trim() || 'example.com.';
			const records = [];

			for (const digestType of $.get(selectedDigestTypes)) {

    .stat:where(.svelte-116tcdm) {
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
      font-family: var(--font-mono);
    }

    .actions:where(.svelte-116tcdm) {
      display: flex;
      gap: var(--spacing-sm);

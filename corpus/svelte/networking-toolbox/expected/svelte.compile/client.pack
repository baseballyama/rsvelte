      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
    }
  }

  .checkbox-group.svelte-116tcdm {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    align-items: baseline;
  }

  .checkbox-label.svelte-116tcdm {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    cursor: pointer;
    font-size: var(--font-size-sm);
    padding: var(--spacing-xs);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;

    &:hover {
      background: var(--color-surface-variant);
      color: var(--color-primary);
    }

    input[type='checkbox']:where(.svelte-116tcdm) {
      margin: 0;
      width: 16px;
      height: 16px;
      accent-color: var(--color-primary);
    }

    span:where(.svelte-116tcdm):first-of-type {
      flex: 1;
      margin-left: var(--spacing-xs);
    }

    span:where(.svelte-116tcdm):last-child {
      margin-left: auto;
    }
  }

  .validation-section.svelte-116tcdm {
    margin: var(--spacing-md) 0;
  }

  .validation-status.svelte-116tcdm {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);

    &.success {
      background: color-mix(in srgb, var(--color-success), transparent 95%);
      color: var(--color-success);
      border: 1px solid var(--color-success);
    }

    &.warning {
      color: var(--color-warning);
      background: color-mix(in srgb, var(--color-warning), transparent 95%);
      border: 1px solid var(--color-warning);
    }

    &.error {
      color: var(--color-error);
      background: color-mix(in srgb, var(--color-error), transparent 95%);
      border: 1px solid var(--color-error);
    }
  }

  .chunks-section.svelte-116tcdm,
  .output-section.svelte-116tcdm {
    margin-bottom: var(--spacing-lg);

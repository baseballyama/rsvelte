=== 5249 src/routes/diagnostics/dns/spf-flatten/+page.svelte	css

  .results-section.svelte-bvqwjc {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .original-section.svelte-bvqwjc,
  .expansion-section.svelte-bvqwjc,
  .flattened-section.svelte-bvqwjc,
  .stats-section.svelte-bvqwjc,
  .warnings-section.svelte-bvqwjc {
    background: var(--bg-secondary);
    width: 100%;
  }

  .section-header.svelte-bvqwjc {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;

    h3:where(.svelte-bvqwjc) {
      margin: 0;
    }

    .copy-button:where(.svelte-bvqwjc) {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      padding: var(--spacing-xs) var(--spacing-sm);
      background: var(--color-primary);
      color: var(--bg-primary);
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all var(--transition-normal);
      font-size: var(--font-size-sm);
      font-weight: 500;

      &:hover {
        background: var(--color-primary-hover);
        transform: translateY(-1px);
      }

      &.success {
        background: var(--color-success);
        color: var(--bg-primary);
        transform: scale(1.05);

        &:hover {
          background: var(--color-success);
        }
      }

      svg {
        width: var(--font-size-sm);
        height: var(--font-size-sm);
      }
    }
  }

  .spf-record.svelte-bvqwjc {
    padding: var(--spacing-md);
    background: var(--bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow-x: auto;

    code:where(.svelte-bvqwjc) {
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      color: var(--color-text-primary);
      word-break: break-all;
      line-height: 1.5;
    }

    &.original {
      background: var(--color-surface-elevated);
    }

    &.flattened {
      background: color-mix(in srgb, var(--color-success), transparent 95%);
      border-color: color-mix(in srgb, var(--color-success), transparent 70%);
    }
  }

  .tree-container.svelte-bvqwjc {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .expansion-item.svelte-bvqwjc {
    background: var(--bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);

    &:last-child {
      margin-bottom: 0;
    }
  }

  .expansion-header.svelte-bvqwjc {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);

    .expansion-type:where(.svelte-bvqwjc) {
      display: inline-flex;
      padding: var(--spacing-2xs) var(--spacing-xs);
      background: color-mix(in srgb, var(--color-primary), transparent 90%);
      color: var(--color-primary);
      border-radius: var(--radius-sm);
      font-size: var(--font-size-xs);
      font-weight: 600;
      text-transform: uppercase;
      min-width: fit-content;
    }

    .expansion-value:where(.svelte-bvqwjc) {
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      color: var(--color-text-primary);
      flex: 1;
      word-break: break-all;
    }

    .lookup-count:where(.svelte-bvqwjc) {
      display: inline-flex;
      padding: var(--spacing-2xs) var(--spacing-xs);
      background: var(--color-surface-elevated);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      font-size: var(--font-size-xs);
      font-weight: 600;
      color: var(--color-text-secondary);
      min-width: fit-content;
    }
  }

  .resolved-items.svelte-bvqwjc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-xs);
  }

  .resolved-item.svelte-bvqwjc {
    display: inline-flex;
    padding: var(--spacing-2xs) var(--spacing-xs);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
  }

  .warnings-list.svelte-bvqwjc {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .warning-item.svelte-bvqwjc {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm);
    background: color-mix(in srgb, var(--color-warning), transparent 95%);
    border: 1px solid color-mix(in srgb, var(--color-warning), transparent 80%);
    border-radius: var(--radius-md);
    color: var(--color-warning);

    svg {
      color: var(--color-warning);
      flex-shrink: 0;
      margin-top: var(--spacing-2xs);
    }

    span:where(.svelte-bvqwjc) {
      flex: 1;
      font-size: var(--font-size-sm);
      line-height: 1.4;
    }
  }

  .stat-value.svelte-bvqwjc {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);

    &.warning {
      color: var(--color-warning);
    }

    &.error {
      color: var(--color-error);
    }

    svg {
      flex-shrink: 0;
    }
  }

  .stat-warning.svelte-bvqwjc {
    font-size: var(--font-size-xs);
    color: var(--color-warning);
    margin-top: var(--spacing-2xs);
    font-weight: 500;
  }


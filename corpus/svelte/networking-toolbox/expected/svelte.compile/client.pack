	function parseIP(ip) {
		return ip.split('.').reduce((acc, octet) => (acc << 8) + parseInt(octet), 0) >>> 0;
	}

	function ipToString(ip) {
		return [
			ip >>> 24 & 0xff,
			ip >>> 16 & 0xff,

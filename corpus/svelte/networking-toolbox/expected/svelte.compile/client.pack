      }

      .accordion-content:where(.svelte-ly52b1) {
        animation: svelte-ly52b1-accordionOpen 0.2s ease-out;
      }
    }
  }

  .accordion-summary.svelte-ly52b1 {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: all var(--transition-fast);

    &::-webkit-details-marker {

  .card-header.svelte-rfxrrf {
    .card-subtitle:where(.svelte-rfxrrf) {
      color: var(--text-secondary);
      margin-top: var(--spacing-xs);
    }
  }

  .grid-layout.svelte-rfxrrf {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-lg);
    margin: var(--spacing-lg) 0;

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
    }
  }

  .input-section.svelte-rfxrrf {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);

    input[type='number']:where(.svelte-rfxrrf) {
      background: var(--bg-primary);
    }
  }

  .controls-header.svelte-rfxrrf {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--spacing-md);
    align-items: end;
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--border-secondary);

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .add-record-btn.svelte-rfxrrf {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-primary);
    color: var(--bg-primary);
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);

    &:hover {
      background: var(--color-primary-dark);
      transform: translateY(-1px);
    }
  }

  .srv-records-section.svelte-rfxrrf {
    .section-header:where(.svelte-rfxrrf) {
      margin-bottom: var(--spacing-md);

      h3:where(.svelte-rfxrrf) {
        margin: 0;
        font-size: var(--font-size-md);
        color: var(--text-primary);
      }
    }
  }

  .records-list.svelte-rfxrrf {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .record-row.svelte-rfxrrf {
    display: grid;
    grid-template-columns: 1fr auto;

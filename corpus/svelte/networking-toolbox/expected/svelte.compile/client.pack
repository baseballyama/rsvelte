		{ cidr: 25, label: '/25', hosts: '126 hosts' },
		{ cidr: 26, label: '/26', hosts: '62 hosts' },
		{ cidr: 27, label: '/27', hosts: '30 hosts' },
		{ cidr: 28, label: '/28', hosts: '14 hosts' },

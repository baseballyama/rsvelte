				[() => getPrefixDescription($.get(prefixLength))]
			);

			$.delegated('input', input, (e) => handleAddressInput(e.target?.value || ''));
			$.bind_value(input, () => $.get(networkAddress), ($$value) => $.set(networkAddress, $$value));

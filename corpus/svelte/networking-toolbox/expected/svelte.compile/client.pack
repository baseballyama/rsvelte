	async function convertAddresses() {
		if (!$.get(inputText).trim()) return $.set(result, null);

		$.set(isLoading, true);

		try {
			$.set(result, await convertMACAddresses($.get(inputText).split('\n').filter((line) => line.trim())), true);
		} finally {
			$.set(isLoading, false);
		}
	}

	function toggleMode() {
		$.set(isBulkMode, !$.get(isBulkMode));

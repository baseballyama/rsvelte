    ul:where(.svelte-ly52b1) {
      margin: 0;
      padding-left: var(--spacing-lg);

      li:where(.svelte-ly52b1) {
        margin-bottom: var(--spacing-sm);
        line-height: 1.6;
        color: var(--text-secondary);

        &:last-child {
          margin-bottom: 0;
        }
      }
    }
  }

  @keyframes svelte-ly52b1-accordionOpen {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .info-card.svelte-ly52b1 {
    margin-top: var(--spacing-lg);
  }


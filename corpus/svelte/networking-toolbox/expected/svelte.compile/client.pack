	const siteTree = [
		...TOP_NAV.map((topItem) => {
			const section = mapToNode(topItem);
			const subNavData = SUB_NAV[topItem.href];

			if (subNavData) {
				section.children = subNavData.map((item) => {
					if ('items' in item) {

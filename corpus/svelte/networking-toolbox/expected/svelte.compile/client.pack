            display: flex;
            align-items: center;
            justify-content: center;
            font-size: var(--font-size-xs);
            border-radius: var(--radius-sm);
            cursor: help;

            &.network-bit {
              background-color: var(--color-info);
              color: var(--bg-secondary);
            }

            &.host-bit {
              background-color: var(--bg-secondary);
              color: var(--text-secondary);

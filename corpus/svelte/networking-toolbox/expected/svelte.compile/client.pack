    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);

    h3:where(.svelte-116tcdm) {
      margin: 0;
      color: var(--color-text);
    }

    .stats:where(.svelte-116tcdm) {
      display: flex;
      gap: var(--spacing-sm);

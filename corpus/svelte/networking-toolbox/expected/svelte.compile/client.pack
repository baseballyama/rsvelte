  .example-targets.svelte-s5gnjv {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--spacing-xs);
  }

  .target-item.svelte-s5gnjv {
    background: var(--bg-tertiary);
    padding: 2px var(--spacing-xs);
    border-radius: var(--radius-xs);
    font-size: var(--font-size-xs);
    color: var(--text-secondary);
  }

  .more-targets.svelte-s5gnjv {
    font-size: var(--font-size-xs);
    color: var(--text-secondary);
    font-style: italic;
  }

  .input-help.svelte-s5gnjv {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--spacing-xs);
  }

  .target-count.svelte-s5gnjv {
    font-size: var(--font-size-xs);
    color: var(--text-secondary);
  }

  .port-shortcuts.svelte-s5gnjv {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-xs);
  }

  .port-btn.svelte-s5gnjv {
    font-size: var(--font-size-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--transition-fast);

    &:hover {
      background: var(--color-primary);
      color: var(--bg-primary);
      border-color: var(--color-primary);
    }
  }

  .status-title.svelte-s5gnjv {
    font-weight: 600;
    color: var(--text-primary);
  }

  .status-desc.svelte-s5gnjv {
    font-size: var(--font-size-xs);
    margin: 2px 0 0 0;
    opacity: 0.8;
  }

  .ports-section.svelte-s5gnjv {
    margin: var(--spacing-lg) 0;

    h4:where(.svelte-s5gnjv) {
      color: var(--text-primary);
      margin: 0 0 var(--spacing-md) 0;
      border-bottom: 1px solid var(--border-primary);
      padding-bottom: var(--spacing-xs);
    }
  }

  .ports-list.svelte-s5gnjv {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .port-result.svelte-s5gnjv {
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    padding: var(--spacing-md);

    &.success {
      border-left: 4px solid var(--color-success);
      background: color-mix(in srgb, var(--color-success), transparent 97%);
    }

    &.error {
      border-left: 4px solid var(--color-error);
      background: color-mix(in srgb, var(--color-error), transparent 97%);
    }
  }

  .port-header.svelte-s5gnjv {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-xs);
  }

  .port-target.svelte-s5gnjv {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .host-port.svelte-s5gnjv {
    font-weight: 600;
    color: var(--text-primary);
  }

  .port-status.svelte-s5gnjv {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--text-primary);
  }

  .port-error.svelte-s5gnjv {
    margin-top: var(--spacing-xs);
    padding: var(--spacing-xs);
    background: color-mix(in srgb, var(--color-error), transparent 90%);
    border-radius: var(--radius-xs);
    border-left: 3px solid var(--color-error);
  }

  .error-detail.svelte-s5gnjv {
    font-size: var(--font-size-xs);
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .mono.svelte-s5gnjv {
    font-family: var(--font-mono);
  }

  textarea.svelte-s5gnjv {
    resize: vertical;
    min-height: 120px;
  }


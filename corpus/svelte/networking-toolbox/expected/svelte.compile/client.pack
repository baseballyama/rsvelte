			if (!response.ok) {
				throw new Error(`MX health check failed: ${response.status}`);
			}

			const data = await response.json();

			diagnosticState.setResults(data);
		} catch(err) {
			diagnosticState.setError(err instanceof Error ? err.message : 'Unknown error occurred');
		}
	}


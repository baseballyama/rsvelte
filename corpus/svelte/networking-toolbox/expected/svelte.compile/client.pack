		if (cert.daysUntilExpiry <= 7) {
			return {
				status: `Expires in ${cert.daysUntilExpiry} days`,
				icon: 'alert-triangle',
				class: 'error'
			};
		}

		if (cert.daysUntilExpiry <= 30) {

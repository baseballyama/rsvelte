		return isHealthy ? 'success' : 'error';
	}

	function getPortStatus(portCheck) {
		const check = portCheck;

		return check.open ? 'success' : 'error';
	}

	function getPortDescription(port) {
		switch (port) {
			case 25:
				return 'SMTP (Standard)';

			case 587:
				return 'Submission (TLS)';

			case 465:
				return 'SMTPS (SSL)';

			default:
				return `Port ${port}`;
		}
	}


		const key = `ds-${ds.keyTag}-${ds.digestType}`;

		clipboard.copy(formatted, key);
	}

	function copyAllDS() {
		const formatted = $.get(dsRecords).map((ds) => formatDSRecord(ds, $.get(ownerName))).join('\n');

		clipboard.copy(formatted, 'all');

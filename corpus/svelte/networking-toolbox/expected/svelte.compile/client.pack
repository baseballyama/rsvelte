    font-size: var(--font-size-sm);
    color: var(--text-secondary);
  }

  .format-list.svelte-1ambgsj li:where(.svelte-1ambgsj),
  .use-case-list.svelte-1ambgsj li:where(.svelte-1ambgsj) {
    position: relative;
    padding-left: var(--spacing-md);

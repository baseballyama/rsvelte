          align-items: flex-start;
          gap: var(--spacing-xs);
        }
      }
    }

    .binary-summary:where(.svelte-1e0xnjm) {
      margin-top: var(--spacing-md);
      padding-top: var(--spacing-sm);
      border-top: 1px solid var(--border-primary);

      .bit-stats:where(.svelte-1e0xnjm) {
        display: flex;
        justify-content: space-between;
        font-size: var(--font-size-sm);

        .bit-stat:where(.svelte-1e0xnjm) {
          display: flex;
          align-items: center;
          gap: var(--spacing-sm);
          color: var(--text-secondary);
        }

        @media (max-width: 768px) {
          flex-direction: column;
          gap: var(--spacing-sm);
        }
      }
    }
  }

  .grid-section.svelte-1e0xnjm {
    margin-bottom: var(--spacing-lg);

    h4:where(.svelte-1e0xnjm) {
      margin-bottom: var(--spacing-sm);
    }

    .address-grid-wrap:where(.svelte-1e0xnjm) {
      padding: var(--spacing-md);
      background-color: var(--bg-tertiary);
      border-radius: var(--radius-lg);
      width: 100%;

      .address-grid:where(.svelte-1e0xnjm) {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: var(--spacing-xs);
        width: fit-content;

        @media (max-width: 768px) {
          grid-template-columns: repeat(4, 1fr);
        }

        .address-block:where(.svelte-1e0xnjm) {
          width: 3rem;
          height: 3rem;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: var(--font-size-xs);
          font-weight: 600;
          border-radius: var(--radius-sm);
          cursor: pointer;
          transition: transform var(--transition-fast);
          color: var(--bg-tertiary);

          &:hover {
            transform: scale(1.1);
          }

          &.network {
            background-color: var(--color-info);
          }

          &.broadcast {
            background-color: var(--color-error);
          }

          &.usable {
            background-color: var(--color-success);
            &:hover {
              background-color: var(--color-success-light);
            }
          }
        }
      }
    }
  }

  .efficiency-section.svelte-1e0xnjm {
    padding: var(--spacing-md);
    background: linear-gradient(135deg, var(--bg-tertiary), var(--bg-secondary));
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-secondary);

    h4:where(.svelte-1e0xnjm) {
      margin-bottom: var(--spacing-sm);
    }

    .efficiency-grid:where(.svelte-1e0xnjm) {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-md);

      .efficiency-metric:where(.svelte-1e0xnjm) {
        text-align: center;

        .metric-value:where(.svelte-1e0xnjm) {
          font-size: var(--font-size-2xl);
          font-weight: 700;
          color: var(--color-info-light);
          margin-bottom: var(--spacing-xs);
        }

        .metric-label:where(.svelte-1e0xnjm) {
          font-size: var(--font-size-sm);
          color: var(--text-secondary);
        }
      }

      @media (max-width: 768px) {
        grid-template-columns: 1fr;
      }
    }
  }

  /* Color coding for address utilization */
  .metric-value.success.svelte-1e0xnjm {
    color: var(--color-success) !important;
  }

  .metric-value.warning.svelte-1e0xnjm {
    color: var(--color-warning) !important;
  }

  .metric-value.error.svelte-1e0xnjm {
    color: var(--color-error) !important;
  }


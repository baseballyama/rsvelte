    .network-label:where(.svelte-1cjcuvu) {
      font-family: var(--font-mono);
      font-weight: 600;
    }

    .network-desc:where(.svelte-1cjcuvu) {
      font-size: var(--font-size-sm);
      opacity: 0.9;
    }
  }

  .aggregation-arrow.svelte-1cjcuvu {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-primary);
    font-weight: 500;

    .icon {
      width: 2rem;
      height: 2rem;
    }
  }

  .supernet-visual.svelte-1cjcuvu {
    width: 100%;


    align-items: center;
    gap: var(--spacing-sm);
    cursor: pointer;

    input[type='checkbox']:where(.svelte-1carq1l) {
      margin: 0;
    }

    .checkbox-text:where(.svelte-1carq1l) {
      color: var(--text-primary);
      font-size: var(--font-size-sm);
    }
  }


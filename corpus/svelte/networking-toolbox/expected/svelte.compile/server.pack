				input: '2001:db8::/64 # 10\nfe80::/10 x 5',
				description: 'IPv6 networks with various syntax formats'
			},

			{
				input: '192.168.0.0/16 100\n203.0.113.0/24 * 20',
				description: 'Large generation counts from different networks'
			},

			{

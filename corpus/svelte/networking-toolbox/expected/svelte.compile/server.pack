    margin: var(--spacing-xs) 0 0 0;
  }

  .parsed-date.svelte-pe9bo2 {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .date-part.svelte-pe9bo2 {
    padding: var(--spacing-xs) var(--spacing-sm);
    background: var(--bg-tertiary);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    font-family: var(--font-mono);
  }

  .unix-date.svelte-pe9bo2 {
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .validity.svelte-pe9bo2 {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);

    &.valid {
      color: var(--color-success);
    }

    &.invalid {
      color: var(--color-error);
    }
  }

  .ttl-value.svelte-pe9bo2 {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .timing-grid.svelte-pe9bo2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
  }

  .timing-param.svelte-pe9bo2 {
    padding: var(--spacing-md);
    background: var(--bg-tertiary);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-primary);

    h5:where(.svelte-pe9bo2) {
      margin: 0 0 var(--spacing-sm) 0;
      color: var(--color-primary);
      font-size: var(--font-size-sm);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
  }

  .param-value.svelte-pe9bo2 {

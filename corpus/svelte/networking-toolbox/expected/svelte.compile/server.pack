  .card.svelte-854nep {
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    border: 1px solid var(--border-primary);
    margin-bottom: var(--spacing-lg);

    &.input-card {
      background: var(--bg-tertiary);
      .card-header:where(.svelte-854nep) {
        margin-bottom: var(--spacing-sm);
      }
    }

    h3:where(.svelte-854nep) {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin: 0 0 var(--spacing-sm);
      font-size: 1.25rem;
      color: var(--text-primary);
    }
  }

  .card-header.svelte-854nep {
    .help-text:where(.svelte-854nep) {
      margin: var(--spacing-xs) 0 0;
      font-size: 0.875rem;
      color: var(--text-secondary);
      font-style: italic;
    }
  }

  .card-content.svelte-854nep {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .input-group.svelte-854nep {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);

    &.flex-grow {
      flex: 1;
    }

    label:where(.svelte-854nep) {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      font-weight: 500;
      font-size: 0.875rem;
      color: var(--text-primary);
    }

    input:where(.svelte-854nep),
    textarea:where(.svelte-854nep),
    select:where(.svelte-854nep) {
      padding: var(--spacing-sm);
      background: var(--bg-primary);
      border: 1px solid var(--border-primary);
      border-radius: var(--radius-md);
      color: var(--text-primary);
      font-family: inherit;
      font-size: 0.9375rem;
      transition: all 0.2s ease;

      &:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary), transparent 90%);
      }
    }

    textarea:where(.svelte-854nep) {
      resize: vertical;
      font-family: var(--font-mono);
    }

    select:where(.svelte-854nep) {
      cursor: pointer;
    }
  }

  .input-row.svelte-854nep {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .server-row.svelte-854nep {
    display: flex;
    gap: var(--spacing-sm);
    align-items: flex-end;
  }

  .btn-icon.svelte-854nep {
    padding: var(--spacing-sm);
    background: transparent;
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-sm);
    color: var(--color-error);
    cursor: pointer;
    transition: all 0.2s ease;
    height: fit-content;

    &:hover {
      background: color-mix(in srgb, var(--color-error), transparent 90%);
      border-color: var(--color-error);
    }
  }

  .btn-add.svelte-854nep,
  .btn-primary.svelte-854nep {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm);
    background: transparent;
    border: 1px dashed var(--border-secondary);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      background: var(--surface-hover);
      border-color: var(--color-primary);

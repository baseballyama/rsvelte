							size: 'sm'
						});

						$$renderer.push(`<!----></button></div></div> <div class="detail-item svelte-13utf9w"><div class="detail-label-wrapper svelte-13utf9w"><span class="detail-label svelte-13utf9w">Network Address (Expanded)</span> `);


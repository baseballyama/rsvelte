      gap: var(--spacing-xs);
      min-width: 0;
      flex: 1;
      font-weight: 400;
      .toggle-description:where(.svelte-feb5js) {
        color: var(--text-secondary);
        font-size: var(--font-size-xs);
        line-height: 1.3;

        .standalone:where(.svelte-feb5js) & {
          display: block;
        }
      }
    }
  }

  .additional-options.svelte-feb5js {
    overflow: hidden;
  }

  .show-more-btn.svelte-feb5js,
  .custom-color-toggle.svelte-feb5js {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm);

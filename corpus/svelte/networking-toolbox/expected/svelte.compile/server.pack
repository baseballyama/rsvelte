    .calculation-card.invalid:where(.svelte-1e7d9k3) & {
      color: var(--color-error);
    }
  }

  .calculation-details.svelte-1e7d9k3 {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .result-section.svelte-1e7d9k3 {

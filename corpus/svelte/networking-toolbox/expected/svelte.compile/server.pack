      margin-bottom: var(--spacing-md);
    }

    p:where(.svelte-gtgubt) {
      color: var(--text-secondary);
      line-height: 1.6;
    }
  }

  .about-grid.svelte-gtgubt {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-xl);
  }

  @media (max-width: 768px) {
    .result-header.svelte-gtgubt {
      flex-direction: column;
    }

    .details-grid.svelte-gtgubt {
      grid-template-columns: 1fr;
    }

    .about-grid.svelte-gtgubt {
      grid-template-columns: 1fr;
    }

    .normalized-form.svelte-gtgubt {
      flex-direction: column;
      align-items: stretch;
    }
  }


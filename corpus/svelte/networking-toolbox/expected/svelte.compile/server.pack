			// Ctrl + / to toggle
			if (e.ctrlKey && e.key === '/') {
				e.preventDefault();

				if (isOpen) {
					close();
				} else {
					openDialog();
				}
			} else // Escape to close
			if (e.key === 'Escape' && isOpen) {
				e.preventDefault();
				close();
			}
		}

		function close() {
			isOpen = false;
		}

		function handleBackdropClick(e) {

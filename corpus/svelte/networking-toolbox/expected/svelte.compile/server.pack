        0 2px 6px color-mix(in srgb, var(--icon-color), transparent 90%),
        inset 0 1px 0 color-mix(in srgb, var(--icon-color), transparent 90%);

      &::before {
        opacity: 1;
      }

      .icon {
        filter: drop-shadow(0 0 4px color-mix(in srgb, var(--icon-color), transparent 50%));
        transform: scale(1.1);
      }
    }


    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);

    .operation-header:where(.svelte-1pc2fd8) {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-sm);

      .operation-symbol:where(.svelte-1pc2fd8) {
        font-size: var(--font-size-xl);
        font-weight: bold;
        color: var(--color-primary);
        width: 70px;
        text-align: center;
      }

      .operation-name:where(.svelte-1pc2fd8) {
        font-weight: 600;
        color: var(--text-primary);
        font-size: var(--font-size-md);
      }
    }

    .operation-desc:where(.svelte-1pc2fd8) {
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
      line-height: 1.5;
      margin-bottom: var(--spacing-sm);
    }

    .operation-example:where(.svelte-1pc2fd8) {
      padding: var(--spacing-sm);
      background-color: var(--bg-secondary);
      border-radius: var(--radius-sm);
      font-size: var(--font-size-sm);

      strong:where(.svelte-1pc2fd8) {
        color: var(--color-primary);
      }

      code:where(.svelte-1pc2fd8) {
        font-family: var(--font-mono);
        background-color: var(--bg-secondary);
        padding: 1px var(--spacing-xs);
        border-radius: var(--radius-xs);
        font-size: var(--font-size-xs);
      }
    }
  }

  .patterns-section.svelte-1pc2fd8 .patterns-grid:where(.svelte-1pc2fd8),
  .notes-section.svelte-1pc2fd8 .notes-grid:where(.svelte-1pc2fd8) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  .notes-section.svelte-1pc2fd8 .notes-grid:where(.svelte-1pc2fd8) {
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  }

  .pattern-card.svelte-1pc2fd8,
  .note-item.svelte-1pc2fd8 {
    padding: var(--spacing-md);
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-md);

    h5:where(.svelte-1pc2fd8) {
      margin-bottom: var(--spacing-sm);
    }
  }

  .note-item.svelte-1pc2fd8 {
    p:where(.svelte-1pc2fd8) {
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
      line-height: 1.5;
      margin: 0;
    }
  }

  .pattern-card.svelte-1pc2fd8 {
    ul:where(.svelte-1pc2fd8) {
      list-style: none;
      padding: 0;
      margin: 0;

      li:where(.svelte-1pc2fd8) {
        margin-bottom: var(--spacing-xs);
        font-size: var(--font-size-sm);
        color: var(--text-secondary);

        strong:where(.svelte-1pc2fd8) {
          color: var(--color-primary);
        }
      }
    }
  }

  .pattern-card.svelte-1pc2fd8 {
    border-left: 4px solid var(--color-info);
  }

  .best-practices.svelte-1pc2fd8 {
    background-color: var(--bg-primary);
    border: 1px solid var(--color-info);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);

    h4:where(.svelte-1pc2fd8) {
      color: var(--color-info);
      margin: 0 0 var(--spacing-sm) 0;
    }

    ul:where(.svelte-1pc2fd8) {
      list-style: none;
      margin: 0;
      padding: 0;

      li:where(.svelte-1pc2fd8) {
        margin-bottom: var(--spacing-xs);
        color: var(--text-primary);
        font-size: var(--font-size-sm);
        position: relative;
        padding-left: 1em;

        &::before {
          content: '•';
          color: var(--color-info);
          font-weight: bold;
          position: absolute;
          left: 0;
        }

        strong:where(.svelte-1pc2fd8) {
          color: var(--color-info);
        }
      }
    }
  }

  @media (max-width: 768px) {
    .operations-grid.svelte-1pc2fd8,
    .patterns-grid.svelte-1pc2fd8,
    .notes-grid.svelte-1pc2fd8 {
      grid-template-columns: 1fr;
    }

    .operation-card.svelte-1pc2fd8 .operation-header:where(.svelte-1pc2fd8) {
      flex-direction: column;
      text-align: center;
      gap: var(--spacing-sm);
    }
  }


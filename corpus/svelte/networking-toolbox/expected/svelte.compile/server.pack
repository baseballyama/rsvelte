				// Parse subnet IDs if provided
				const subnetIdArray = subnetIds.split(/[,\n]/).map((s) => s.trim()).filter((s) => s.length > 0);

				result = generateULAAddresses(count, subnetIdArray.length > 0 ? subnetIdArray : undefined);

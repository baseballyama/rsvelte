			if (!diagnosticState.results) return;

			let text = `TLS Versions Analysis for ${host}\n`;

			text += `Generated at: ${new Date().toISOString()}\n\n`;
			text += `Supported Versions (${diagnosticState.results.totalSupported}):\n`;


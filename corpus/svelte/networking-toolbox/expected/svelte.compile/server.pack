			Icon($$renderer, { name: 'loader', size: 'lg', animate: 'spin' });
			$$renderer.push(`<!----> <div class="loading-text"><h3>Checking TLS Support</h3> <p>Testing connection to ${$.escape(domain)}:${$.escape(port)}...</p></div></div></div></div>`);

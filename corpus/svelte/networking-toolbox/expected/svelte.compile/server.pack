    .table-note:where(.svelte-r6risj) {
      margin-top: var(--spacing-md);
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
    }
  }

  /* How it works section */
  .how-it-works.svelte-r6risj {
    margin: var(--spacing-xl) 0;

    .explanation-grid:where(.svelte-r6risj) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: var(--spacing-lg);
      margin-top: var(--spacing-lg);
    }

    .explanation-item:where(.svelte-r6risj) {
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      border: 1px solid var(--border-primary);

      &.success {
        border-left: 4px solid var(--color-success);
      }

      &.info {
        border-left: 4px solid var(--color-info);
      }

      &.warning {
        border-left: 4px solid var(--color-warning);
      }

      h3:where(.svelte-r6risj) {
        margin-bottom: var(--spacing-md);
        color: var(--text-primary);
      }

      p:where(.svelte-r6risj) {
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: var(--spacing-md);
      }

      .bit-example:where(.svelte-r6risj) {
        background: var(--bg-tertiary);
        padding: var(--spacing-md);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        text-align: center;

        .network-bits:where(.svelte-r6risj) {
          color: var(--color-success);
          display: inline;
        }

        .host-bits:where(.svelte-r6risj) {
          color: var(--color-info);
          display: inline;
        }

        .labels:where(.svelte-r6risj) {
          display: flex;
          justify-content: space-between;
          margin-top: var(--spacing-sm);
          font-size: var(--font-size-xs);

          .network-label:where(.svelte-r6risj) {
            color: var(--color-success);
          }

          .host-label:where(.svelte-r6risj) {
            color: var(--color-info);
          }
        }
      }

      .summary-example:where(.svelte-r6risj) {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: var(--spacing-md);
        align-items: center;
        background: var(--bg-tertiary);
        padding: var(--spacing-md);
        border-radius: var(--radius-sm);
        font-size: var(--font-size-sm);

        .before:where(.svelte-r6risj),
        .after:where(.svelte-r6risj) {
          text-align: center;
        }

        .arrow:where(.svelte-r6risj) {
          font-size: var(--font-size-lg);
          color: var(--color-primary);
          font-weight: bold;
        }
      }

      .planning-tip:where(.svelte-r6risj) {
        background: color-mix(in srgb, var(--color-warning), transparent 90%);
        padding: var(--spacing-md);
        border-radius: var(--radius-sm);
        border: 1px solid var(--color-warning);
        font-size: var(--font-size-sm);

        strong:where(.svelte-r6risj) {
          color: var(--color-warning);
        }
      }
    }
  }

  /* Quick reference section */
  .quick-reference.svelte-r6risj {
    margin: var(--spacing-xl) 0;

    .reference-grid:where(.svelte-r6risj) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--spacing-lg);
      margin-top: var(--spacing-lg);
    }

    .reference-card:where(.svelte-r6risj) {
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      border: 1px solid var(--border-primary);

      h3:where(.svelte-r6risj) {
        margin-bottom: var(--spacing-md);
        color: var(--color-primary);
      }

      ul:where(.svelte-r6risj) {
        list-style: none;
        padding: 0;
        margin: 0;

        li:where(.svelte-r6risj) {
          margin-bottom: var(--spacing-sm);
          padding-left: var(--spacing-md);
          position: relative;
          font-family: var(--font-mono);
          font-size: var(--font-size-sm);

          &::before {
            content: '→';
            color: var(--color-primary);
            position: absolute;
            left: 0;
          }
        }
      }
    }
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .concepts-grid.svelte-r6risj {
      grid-template-columns: 1fr;
    }

    .explanation-grid.svelte-r6risj {
      grid-template-columns: 1fr;
    }

    .reference-grid.svelte-r6risj {
      grid-template-columns: 1fr;
    }

    .summary-example.svelte-r6risj {
      grid-template-columns: 1fr;
      text-align: center;

      .arrow:where(.svelte-r6risj) {
        transform: rotate(90deg);
      }
    }
  }


  /* Core concepts section */
  .concepts-section.svelte-r6risj {
    margin: var(--spacing-xl) 0;

    .concepts-grid:where(.svelte-r6risj) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: var(--spacing-lg);
      margin-top: var(--spacing-lg);
    }

    .concept-card:where(.svelte-r6risj) {
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      border: 1px solid var(--border-primary);
      border-left: 4px solid var(--accent-color);

      .concept-header:where(.svelte-r6risj) {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        margin-bottom: var(--spacing-md);

        .icon {
          color: var(--accent-color);
        }

        h3:where(.svelte-r6risj) {
          margin: 0;
          color: var(--text-primary);
        }
      }

      p:where(.svelte-r6risj) {
        color: var(--text-secondary);
        margin-bottom: var(--spacing-md);
        line-height: 1.6;
      }

      .concept-example:where(.svelte-r6risj) {
        display: block;
        background: var(--bg-tertiary);
        padding: var(--spacing-sm);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: var(--font-size-sm);
        color: var(--accent-color);
        border: 1px solid color-mix(in srgb, var(--accent-color), transparent 80%);
      }
    }
  }

  /* About section */
  .about-section.svelte-r6risj {
    margin: var(--spacing-xl) 0;
    background: linear-gradient(135deg, var(--bg-tertiary), var(--bg-secondary));
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    border: 1px solid var(--border-secondary);

    .about-grid:where(.svelte-r6risj) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-xl);
      margin-top: var(--spacing-lg);

      @media (max-width: 768px) {
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
      }
    }

    .about-content:where(.svelte-r6risj) p:where(.svelte-r6risj) {
      margin-bottom: var(--spacing-md);
      line-height: 1.7;
    }

    .benefits-list:where(.svelte-r6risj) {
      .benefit-item:where(.svelte-r6risj) {
        background: var(--bg-primary);
        padding: var(--spacing-md);
        border-radius: var(--radius-md);
        margin-bottom: var(--spacing-sm);
        border: 1px solid var(--border-primary);

        strong:where(.svelte-r6risj) {
          color: var(--color-primary);
        }
      }
    }
  }

  /* Common sizes table */
  .sizes-section.svelte-r6risj {
    margin: var(--spacing-xl) 0;

    .sizes-table-wrapper:where(.svelte-r6risj) {
      margin-top: var(--spacing-lg);
      overflow-x: auto;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-primary);
    }

    .sizes-table:where(.svelte-r6risj) {
      width: 100%;
      border-collapse: collapse;
      background: var(--bg-secondary);

      th:where(.svelte-r6risj) {
        background: var(--bg-tertiary);
        padding: var(--spacing-md);
        text-align: left;
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 2px solid var(--border-primary);
      }

      .size-row:where(.svelte-r6risj) {
        border-bottom: 1px solid var(--border-secondary);

        td:where(.svelte-r6risj) {
          padding: var(--spacing-md);
          vertical-align: middle;
        }

        .cidr-cell:where(.svelte-r6risj) strong:where(.svelte-r6risj) {
          color: var(--row-color);
          font-weight: 700;
        }

        .mask-cell:where(.svelte-r6risj) code:where(.svelte-r6risj) {
          background: var(--bg-tertiary);
          padding: var(--spacing-xs) var(--spacing-sm);
          border-radius: var(--radius-xs);
          font-family: var(--font-mono);
          font-size: var(--font-size-sm);
        }

        .hosts-cell:where(.svelte-r6risj) {
          font-family: var(--font-mono);
          font-weight: 600;
        }

        .use-cell:where(.svelte-r6risj) {
          color: var(--text-secondary);
        }
      }

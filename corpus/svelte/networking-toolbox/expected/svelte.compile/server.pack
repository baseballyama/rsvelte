import * as $ from 'svelte/internal/server';

export default function SupportSection($$renderer) {
	$$renderer.push(`<section id="support"><h2>Support</h2> <h3>Self-Hosted Users</h3> <p>Networking Toolbox is provided "as-is" with no warranty or guarantees.<br/> We cannot offer dedicated support for non-commercial users.</p> <ul><li>For bugs, open an issue on GitHub with a clear description</li> <li>We prioritize requests and issues from our GitHub sponsors</li> <li>You can also resolve issues yourself in our <a href="https://github.com/Lissy93/networking-toolbox/">GitHub source</a></li></ul> <hr/> <h3>Support Packages</h3> <p>For support packages, contact us at <code>support@aliciasykes.com</code> <br/> We offer support packages for businesses, including:</p> <ul><li>Dedicated or on-prem hosting</li> <li>Guaranteed SLA</li> <li>Custom feature development</li> <li>Own branding</li></ul></section>`);
}

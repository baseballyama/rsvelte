    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem;
    transition: border-color 0.2s ease;
  }

  .step-header.svelte-123bgah {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;

    .step-type:where(.svelte-123bgah) {
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.75rem;
      color: var(--color-primary);
    }

    .step-timing:where(.svelte-123bgah) {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }
  }

  .step-query.svelte-123bgah,
  .step-server.svelte-123bgah,
  .step-response.svelte-123bgah {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;

    strong:where(.svelte-123bgah) {
      color: var(--color-text-secondary);
      margin-right: 0.5rem;
    }
  }

  .record-type.svelte-123bgah {
    display: inline-block;
    padding: 0.125rem 0.375rem;
    background: var(--color-primary-bg);
    color: var(--color-primary);
    border-radius: var(--radius-sm);

  }

  .server-name.svelte-123bgah {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .referral.svelte-123bgah {
    color: var(--color-info);
  }

  .answer.svelte-123bgah {
    color: var(--color-success);
    font-family: var(--font-mono);
  }

  .nodata.svelte-123bgah {
    color: var(--color-warning);
  }

  .nxdomain.svelte-123bgah {

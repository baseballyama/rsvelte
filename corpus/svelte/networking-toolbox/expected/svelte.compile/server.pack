					if (value.includes('@') && !value.startsWith('mailto:')) {
						value = `mailto:${value}`;
					} else if (value.startsWith('http') && !value.startsWith('http://') && !value.startsWith('https://')) {
						value = `https://${value}`;
					}
				}


    }
  }

  .error-message.svelte-1cjcuvu {
    color: var(--color-error);
    font-weight: 500;
    margin: 0;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .network-inputs-row.svelte-1cjcuvu {
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .network-input.svelte-1cjcuvu,

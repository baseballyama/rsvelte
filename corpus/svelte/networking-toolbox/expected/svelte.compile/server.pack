						$$renderer.option({ value: 'high' }, ($$renderer) => {
							$$renderer.push(`High - ${$.escape(formatTime(CHURN_RATE_HOURS.high * 3600))}`);
						});

						$$renderer.option({ value: 'custom' }, ($$renderer) => {
							$$renderer.push(`Custom`);

			const rangeSize = totalRange.end - totalRange.start;
			const blockOffset = start - totalRange.start;

			return Number(blockOffset * 10000n / rangeSize) / 100;
		}

		function getBlockWidth(start, end, totalRange) {
			const rangeSize = totalRange.end - totalRange.start;

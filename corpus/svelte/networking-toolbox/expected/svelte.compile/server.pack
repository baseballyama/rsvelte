  }

  .code-block.svelte-18sbsfb {
    white-space: pre;
    word-break: normal;
  }

  .breakdown-section.svelte-18sbsfb {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);

    h4:where(.svelte-18sbsfb) {
      margin: 0 0 var(--spacing-xs);
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
    }
  }

  .breakdown-item.svelte-18sbsfb {
    padding: var(--spacing-md);
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .breakdown-header.svelte-18sbsfb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--spacing-xs);

    strong:where(.svelte-18sbsfb) {
      color: var(--text-primary);
    }
  }

  .breakdown-length.svelte-18sbsfb {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .breakdown-desc.svelte-18sbsfb {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .breakdown-values.svelte-18sbsfb {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    font-size: 0.875rem;
    font-family: var(--font-mono);

    div:where(.svelte-18sbsfb) {
      strong:where(.svelte-18sbsfb) {
        color: var(--text-secondary);
        font-weight: 500;
      }
    }
  }

  .parse-summary.svelte-18sbsfb {
    display: flex;
    gap: var(--spacing-lg);
    padding: var(--spacing-md);
    background: color-mix(in srgb, var(--color-info), transparent 95%);
    border: 1px solid var(--color-info);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-lg);
    font-size: 0.9375rem;

    div:where(.svelte-18sbsfb) {
      strong:where(.svelte-18sbsfb) {
        color: var(--text-primary);
      }
    }

    @media (max-width: 768px) {
      flex-direction: column;
      gap: var(--spacing-xs);
    }
  }


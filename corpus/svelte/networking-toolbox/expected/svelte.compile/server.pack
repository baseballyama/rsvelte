					$$renderer.push(`<!--[0--><div class="stat-item svelte-lsjtaq"><span class="stat-value svelte-lsjtaq">${$.escape(results.analysis.patternMatches)}</span> <span class="stat-label svelte-lsjtaq">Pattern Matches</span></div>`);

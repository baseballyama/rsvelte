			if (hasItems()()) {
				$$renderer.push(`<!--[0--><div class="toggle-container svelte-wpabmv"><button class="toggle-button svelte-wpabmv">${$.escape(showAll ? 'Hide All Tools' : 'Show All Tools')}</button></div>`);
			} else {
				$$renderer.push('<!--[-1-->');

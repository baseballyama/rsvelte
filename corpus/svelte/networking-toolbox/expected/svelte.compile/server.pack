  .lookup-form.svelte-2zofru {
    display: flex;
    gap: var(--spacing-md);
    align-items: flex-end;

    label:where(.svelte-2zofru) {
      display: block;
      margin-bottom: var(--spacing-sm);
      color: var(--text-primary);
      font-weight: 500;
    }

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .input-row.svelte-2zofru {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;

    input:where(.svelte-2zofru) {
      width: 100%;
    }
  }

  .lookup-btn.svelte-2zofru {
    flex-shrink: 0;
    white-space: nowrap;
    @media (max-width: 768px) {
      width: 100%;
    }
  }

  .results-grid.svelte-2zofru {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .result-card.svelte-2zofru {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);

    h4:where(.svelte-2zofru) {
      margin: 0 0 var(--spacing-md) 0;
      color: var(--text-primary);
      font-size: var(--font-size-md);
    }
  }

  .info-list.svelte-2zofru {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .info-item.svelte-2zofru {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: var(--spacing-sm);
    align-items: center;
  }

  .info-content.svelte-2zofru {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .info-label.svelte-2zofru {
    font-size: var(--font-size-xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .info-value.svelte-2zofru {
    font-size: var(--font-size-sm);
    color: var(--text-primary);
    font-weight: 500;
  }

  .asn-badge.svelte-2zofru {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-primary);
  }

  .coordinates-display.svelte-2zofru {
    display: flex;
    gap: var(--spacing-md);
    align-items: flex-start;

    @media (max-width: 768px) {
      flex-direction: column;
    }
  }

  .coordinate-info.svelte-2zofru {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    flex: 1;
  }

  .coordinate-item.svelte-2zofru {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .coordinate-values.svelte-2zofru {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .coordinate-row.svelte-2zofru {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-md);
    font-size: var(--font-size-sm);
  }

  .coordinate-label.svelte-2zofru {
    color: var(--text-secondary);
  }

  .coordinate-value.svelte-2zofru {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-primary);
  }

  .map-link.svelte-2zofru {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--color-primary);
    text-decoration: none;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
    transition: all 0.2s;

    &:hover {
      background: color-mix(in srgb, var(--color-primary), transparent 90%);
    }
  }

  .map-container.svelte-2zofru {
    flex: 1;
    min-width: 200px;
    height: 150px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border-color);

    iframe:where(.svelte-2zofru) {
      width: 100%;
      height: 100%;
    }

    @media (max-width: 768px) {
      width: 100%;
      height: 200px;
    }
  }

  .connection-flags.svelte-2zofru {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .flag-item.svelte-2zofru {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    transition: all 0.2s;

    &.active {
      color: var(--color-success);
      border-color: var(--color-success);
      background: color-mix(in srgb, var(--color-success), transparent 95%);
    }
  }

  .quick-tips.svelte-2zofru {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--border-color);

    h4:where(.svelte-2zofru) {
      color: var(--text-primary);
      margin: 0 0 var(--spacing-md) 0;
    }

    ul:where(.svelte-2zofru) {
      margin: 0;
      padding-left: var(--spacing-lg);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);

      li:where(.svelte-2zofru) {
        color: var(--text-secondary);
        font-size: var(--font-size-sm);
        line-height: 1.6;
      }
    }
  }

  .info-card.svelte-2zofru {
    background: var(--bg-tertiary);
  }


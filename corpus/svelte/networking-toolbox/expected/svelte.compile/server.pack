					}

					$$renderer.push(`<!--]--></h5> <p><strong>${$.escape(formatContact(contact))}</strong></p> `);

					if (contact.handle) {
						$$renderer.push(`<!--[0--><p><small>Handle: ${$.escape(contact.handle)}</small></p>`);
					} else {
						$$renderer.push('<!--[-1-->');
					}

					$$renderer.push(`<!--]--> `);


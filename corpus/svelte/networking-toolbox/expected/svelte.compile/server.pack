			const formatted = base64.match(/.{1,64}/g)?.join('\n') || base64;

			return `-----BEGIN PRIVATE KEY-----\n${formatted}\n-----END PRIVATE KEY-----`;
		}

		function formatPublicKey(base64) {
			const formatted = base64.match(/.{1,64}/g)?.join('\n') || base64;

			return `-----BEGIN PUBLIC KEY-----\n${formatted}\n-----END PUBLIC KEY-----`;
		}


=== 7827 src/lib/components/tools/IAIDCalculator.svelte	css

  .card.svelte-1htabut {
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    border: 1px solid var(--border-primary);
    margin-bottom: var(--spacing-lg);

    &.input-card {
      background: var(--bg-tertiary);
      .card-header:where(.svelte-1htabut) {
        margin-bottom: var(--spacing-md);
      }
    }

    &.naming-guide-wrap {
      background: var(--bg-tertiary);
    }

    h3:where(.svelte-1htabut) {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin: 0 0 var(--spacing-sm);
      font-size: 1.25rem;
      color: var(--text-primary);
    }

    h4:where(.svelte-1htabut) {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
    }
  }

  .card-header.svelte-1htabut {
    .help-text:where(.svelte-1htabut) {
      margin: var(--spacing-xs) 0 0;
      font-size: 0.875rem;
      color: var(--text-secondary);
      font-style: italic;
    }
  }

  .card-header-with-action.svelte-1htabut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);

    h3:where(.svelte-1htabut) {
      margin: 0;
    }
  }

  .card-content.svelte-1htabut {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .input-group.svelte-1htabut {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);

    label:where(.svelte-1htabut) {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      font-weight: 500;
      font-size: 0.875rem;
      color: var(--text-primary);
    }

    input:where(.svelte-1htabut),
    select:where(.svelte-1htabut) {
      padding: var(--spacing-sm);
      background: var(--bg-primary);
      border: 1px solid var(--border-primary);
      border-radius: var(--radius-md);
      color: var(--text-primary);
      font-family: inherit;
      font-size: 0.9375rem;
      transition: all 0.2s ease;

      &:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary), transparent 90%);
      }
    }

    small:where(.svelte-1htabut) {
      color: var(--text-secondary);
      font-size: 0.85rem;
    }
  }

  .errors-card.svelte-1htabut {
    background: color-mix(in srgb, var(--color-error), transparent 95%);
    border-color: var(--color-error);

    .error-message:where(.svelte-1htabut) {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      padding: var(--spacing-sm);
      color: var(--color-error);
      font-size: 0.9375rem;
    }
  }

  .results.svelte-1htabut {
    background: var(--bg-tertiary);
    animation: svelte-1htabut-slideIn 0.3s ease-out;
  }

  @keyframes svelte-1htabut-slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .summary-card.svelte-1htabut {
    display: flex;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
    padding: var(--spacing-md);
    background: color-mix(in srgb, var(--color-info), transparent 95%);
    border: 1px solid var(--color-info);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-lg);
    font-size: 0.9375rem;

    div:where(.svelte-1htabut) {
      strong:where(.svelte-1htabut) {
        color: var(--text-primary);
      }
    }

    @media (max-width: 768px) {
      flex-direction: column;
      gap: var(--spacing-xs);
    }
  }

  .warning-card.svelte-1htabut {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
    background: color-mix(in srgb, var(--color-warning), transparent 95%);
    border: 1px solid var(--color-warning);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-lg);
    color: var(--color-warning);
    font-size: 0.9375rem;
  }

  .output-group.svelte-1htabut {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-lg);

    &:last-child {
      margin-bottom: 0;
    }
  }

  .output-header.svelte-1htabut {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .copy-btn.svelte-1htabut {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    background: transparent;
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      background: var(--surface-hover);
      border-color: var(--color-primary);
      color: var(--color-primary);
    }


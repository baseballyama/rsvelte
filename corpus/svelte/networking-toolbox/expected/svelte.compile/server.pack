		}

		$$renderer.push(`<!--]--></div> `);

		if (suggestions.length > 0 && status() === 404) {
			$$renderer.push(`<!--[0--><div class="suggested-tools svelte-1j96wlh"><h3 class="svelte-1j96wlh">Did you mean?</h3> <div class="tools-grid svelte-1j96wlh"><!--[-->`);


import * as $ from 'svelte/internal/server';

export default function TipsSection($$renderer) {
	$$renderer.push(`<section id="tips"><h2>Tips</h2> <h3>Customize</h3> <p>If you use Networking Toolbox a lot, you might want to customize it, so that you feel right at home. Just head to
    the <a href="/settings">Settings</a> page, where you can change the branding, colours, layout, behaviour and more.</p> <h3>Bookmark</h3> <p>Right-click on any tool to bookmark it. This will make it available offline and pin it to the top of your homepage.</p> <h3>Shortcuts</h3> <p>The app can be easily navigated with the keyboard alone. Use <code>Ctrl + /</code> to view all keybindings.</p></section>`);
}

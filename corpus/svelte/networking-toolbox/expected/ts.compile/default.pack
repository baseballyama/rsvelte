        const expanded = ip
            .split(':')
            .map((part) => part.padStart(4, '0'))
            .join('');
        const reversed = expanded.split('').reverse().join('.');
        return `${reversed}.ip6.arpa`;
    }
    else {
        // IPv4
        const parts = ip.split('.');

const makePreviewGradient = (colors, angle = 135, splitPercent = 50) => colors.length === 0
    ? 'var(--bg-secondary)'
    : colors.length === 1
        ? colors[0]
        : `linear-gradient(${angle}deg, ${colors.map((c, i) => `${c} ${i === 0 ? 50 : splitPercent}%`).join(', ')})`;

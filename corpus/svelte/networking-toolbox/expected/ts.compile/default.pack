        windowsBinary: hexToWindowsBinary(hex),
        iscDhcp: `option vendor-class-identifier "ArubaAP";\noption vendor-encapsulated-options "${ip}";`,
        infoblox: hexToColonSeparated(hex),
        mikrotik: `option code=43 name=aruba value='"${ip}"'`,

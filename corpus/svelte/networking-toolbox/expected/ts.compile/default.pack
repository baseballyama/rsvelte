        it('should handle edge cases gracefully', () => {
            const edgeCases = [
                null,
                undefined,
                '',
                ' ',
                '\n',
                '\t'
            ];
            edgeCases.forEach(input => {
                const result = validateRegexInput(input);
                // Should either succeed (for valid patterns) or fail gracefully
                expect(typeof result.ok).toBe('boolean');

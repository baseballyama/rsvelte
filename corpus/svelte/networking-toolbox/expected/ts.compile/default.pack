        Answer: [
            {
                name: 'example.com',
                type: 1,
                TTL: 300,
                data: '93.184.216.34'
            }
        ]
    });
}), 
// Mock RIPE RIS API endpoints for BGP tests
http.get('https://stat.ripe.net/data/prefix-overview/data.json', () => {

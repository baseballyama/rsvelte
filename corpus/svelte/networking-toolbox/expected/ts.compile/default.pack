            if (doh !== 'cloudflare') {
                try {
                    const cloudflareEndpoint = DOH_ENDPOINTS['cloudflare'];
                    const result = await doHQuery(cloudflareEndpoint, name, DNS_TYPES[type], timeoutMs);

            }
        });
        socket.on('close', () => {
            if (!completed) {
                completed = true;
                clearTimeout(hardTimeout);
                const responseTime = Date.now() - startTime;
                const analysis = analyzeBanner(banner, protocol, port);
                resolve({
                    host,
                    port,
                    protocol,
                    banner: banner.trim(),
                    responseTime,
                    connected: true,
                    hasData: hasReceivedData,
                    analysis,
                    timestamp: new Date().toISOString(),

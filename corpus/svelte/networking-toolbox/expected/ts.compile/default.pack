            config.pools = [{ start: '2001:db8::100', end: '2001:db8::200' }];
            const result = generateSnippets(config);
            expect(result.keaDhcp4Snippet).toBeUndefined();
        });
        it('should not generate IPv6 snippet when mode is IPv4', () => {

    const binary = octets.map((n) => n.toString(2).padStart(8, '0')).join('');
    // Check if mask is contiguous (all 1s followed by all 0s)
    if (!/^1*0*$/.test(binary)) {
        return { valid: false, error: 'Subnet mask must be contiguous' };
    }
    return { valid: true };
}


        });
        describe('IPv4/IPv6 conversion edge cases', () => {
            it('should handle IPv4 addresses at boundaries', () => {
                const inputs = ['0.0.0.0/32 @ 0', '255.255.255.255/32 @ 0'];
                const result = calculateNthIPs(inputs);

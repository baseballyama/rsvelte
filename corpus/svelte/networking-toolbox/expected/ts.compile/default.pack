                break;
            }
            case 'SOA': {
                const soa = await Promise.race([
                    dns.resolveSoa(name),
                    new Promise((_, reject) => {
                        controller.signal.addEventListener('abort', () => reject(new Error('DNS timeout')));
                    }),

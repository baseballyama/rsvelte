=== 1461 src/lib/composables/useClipboard.svelte.ts	js
/**
 * Clipboard composable for copying text with auto-reset feedback
 * Replaces the repeated copiedState pattern across 81+ files
 */
import { errorManager } from '$lib/utils/error-manager';
export function useClipboard(autoResetMs = 1500) {
    let copiedStates = $state({});
    /**
     * Copy text to clipboard with feedback
     * @param text - Text to copy
     * @param id - Unique identifier for this copy action (optional)
     */
    async function copy(text, id = 'default') {
        try {
            await navigator.clipboard.writeText(text);
            copiedStates[id] = true;
            setTimeout(() => {
                copiedStates[id] = false;
            }, autoResetMs);
            return true;
        }
        catch (error) {
            errorManager.captureException(error, 'warn', { component: 'Clipboard', action: 'copy', id });
            return false;
        }
    }
    /**
     * Check if a specific copy action is in "copied" state
     */
    function isCopied(id = 'default') {
        return copiedStates[id] ?? false;
    }
    /**
     * Reset a specific copy state
     */
    function reset(id = 'default') {
        copiedStates[id] = false;
    }
    /**
     * Reset all copy states
     */
    function resetAll() {
        copiedStates = {};
    }
    return {
        get copiedStates() {
            return copiedStates;
        },
        copy,
        isCopied,
        reset,
        resetAll,
    };
}

=== 1035 src/lib/composables/useDiagnosticState.svelte.ts	js
/**
 * Common state management for diagnostic/tool pages
 * Replaces the repeated state pattern across 80+ files
 */
export function useDiagnosticState() {
    let loading = $state(false);
    let error = $state(null);
    let results = $state(null);
    function setLoading(value) {
        loading = value;
    }
    function setError(errorMessage) {
        error = errorMessage;
        loading = false;
    }
    function setResults(data) {
        results = data;
        error = null;
        loading = false;
    }
    function reset() {
        loading = false;
        error = null;
        results = null;
    }
    function startOperation() {
        loading = true;
        error = null;
        results = null;
    }
    return {
        get loading() {
            return loading;
        },
        get error() {
            return error;
        },
        get results() {
            return results;
        },
        setLoading,
        setError,
        setResults,
        reset,
        startOperation,
    };
}

=== 711 src/lib/composables/useExamples.svelte.ts	js
/**
 * Example selection management for diagnostic/tool pages
 * Handles example loading and selection tracking
 */
export function useExamples(examples) {
    let selectedIndex = $state(null);
    function select(index) {
        selectedIndex = index;
    }
    function clear() {
        selectedIndex = null;
    }
    function isSelected(index) {
        return selectedIndex === index;
    }
    function getSelected() {
        if (selectedIndex === null)
            return null;
        return examples[selectedIndex] ?? null;
    }
    return {
        get selectedIndex() {
            return selectedIndex;
        },
        select,
        clear,
        isSelected,
        getSelected,
    };
}

=== 922 src/lib/composables/useToolSearch.svelte.ts	js
/**
 * Composable for searching and filtering tools
 * @param getTools Function that returns the array of tools to search through
 * @returns Object with query and filtered state that can be bound
 */
export function useToolSearch(getTools) {
    const state = $state({
        query: '',
        filtered: getTools(),
    });
    // Update filtered whenever query or tools change
    $effect(() => {
        const tools = getTools();
        if (!state.query.trim()) {
            state.filtered = tools;
        }
        else {
            const normalizedQuery = state.query.toLowerCase().trim();
            state.filtered = tools.filter((tool) => tool.label.toLowerCase().includes(normalizedQuery) ||
                tool.description?.toLowerCase().includes(normalizedQuery) ||
                tool.keywords?.some((keyword) => keyword.toLowerCase().includes(normalizedQuery)));
        }
    });
    return state;
}

=== 1121 src/lib/composables/useValidation.svelte.ts	js
/**
 * Validation composable for reactive validation logic
 * Provides a consistent pattern for form validation across components
 */
/**
 * Create a reactive validation state
 * @param validator - Function that returns validation result
 * @returns Object with reactive isValid property and error message
 * @example
 * const validation = useValidation(() => {
 *   if (!input.trim()) return { isValid: false, error: 'Required' };
 *   return { isValid: true };
 * });
 */
export function useValidation(validator) {
    const result = $derived(validator());
    return {
        get isValid() {
            return result.isValid;
        },
        get error() {
            return result.error;
        },
    };
}
/**
 * Create a simple boolean validation
 * @param validator - Function that returns boolean
 * @returns Object with reactive isValid property
 * @example
 * const validation = useSimpleValidation(() => input.length > 0);
 */
export function useSimpleValidation(validator) {
    const isValid = $derived(validator());
    return {
        get isValid() {
            return isValid;
        },
    };
}


}
/**
 * Validate IPv4 address format
 */
function isValidIPv4(ip) {
    const parts = ip.split('.');
    if (parts.length !== 4)
        return false;
    for (const part of parts) {
        const num = parseInt(part, 10);
        if (isNaN(num) || num < 0 || num > 255)
            return false;
        if (part !== num.toString())

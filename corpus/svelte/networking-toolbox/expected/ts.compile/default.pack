            vi.doMock('$app/environment', () => ({
                browser: false,
            }));
            const { ALLOWED_DNS_SERVERS } = await import('$lib/config/customizable-settings');
            expect(ALLOWED_DNS_SERVERS).toEqual(['8.8.8.8', '1.1.1.1', '9.9.9.9']);

        it('should analyze PTR coverage for complete coverage', () => {
            const existingPTRs = [
                '0.1.168.192.in-addr.arpa',
                '1.1.168.192.in-addr.arpa',
                '2.1.168.192.in-addr.arpa',
                '3.1.168.192.in-addr.arpa',

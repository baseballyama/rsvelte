                error: 'Invalid DNS resolver IP address. Use valid IPv4 (8.8.8.8) or IPv6 addresses',
            };
        }
    }
    return { isValid: true };
}
export function validateReverseLookupInput(ipAddress, useCustomResolver = false, customResolver = '') {

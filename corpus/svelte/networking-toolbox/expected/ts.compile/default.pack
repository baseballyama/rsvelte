        Number((num >> 16n) & 0xffn),
        Number((num >> 8n) & 0xffn),
        Number(num & 0xffn),
    ].join('.');
}
/**
 * Convert IPv6 address to BigInt
 */
function ipv6ToBigInt(ip) {

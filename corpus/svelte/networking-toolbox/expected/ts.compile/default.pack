            policy: policy.match(/p=([^;]+)/)?.[1],
            subdomainPolicy: policy.match(/sp=([^;]+)/)?.[1],
            alignment: {
                dkim: policy.match(/adkim=([^;]+)/)?.[1] || 'r',
                spf: policy.match(/aspf=([^;]+)/)?.[1] || 'r',

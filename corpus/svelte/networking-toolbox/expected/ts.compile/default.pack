const CONCURRENCY_LIMIT = 8;
function isIPv4(str) {
    return /^(\d{1,3}\.){3}\d{1,3}$/.test(str);
}
function isIPv6(str) {
    return /^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}$/.test(str);

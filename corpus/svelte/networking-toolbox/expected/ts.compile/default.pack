            errors.push(`Octet ${octetNum} is not a valid number: "${part}"`);
            continue;
        }
        if (value < 0 || value > 255) {
            errors.push(`Octet ${octetNum} out of range: ${value} (must be 0-255)`);
            continue;
        }

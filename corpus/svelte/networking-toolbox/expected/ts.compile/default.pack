            else {
                // Final response
                const total = performance.now() - startTime;
                if (redirectChain.length > 0) {
                    redirectChain.push({
                        url: currentUrl,
                        status: response.status,
                        headers: responseHeaders,
                    });
                }
                return {
                    response,
                    timings: { dns, tcp, tls, ttfb, total },
                    redirectChain: redirectChain.length > 0 ? redirectChain : undefined,
                };
            }
        }

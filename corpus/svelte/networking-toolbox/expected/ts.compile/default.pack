import { resolve } from '$app/paths';
import { site, author, license as _license } from '$lib/constants/site';
import { extractAllNavItems } from '$lib/utils/nav-helpers';
// Helper function to create paths with base path support
function makePath(path) {
    return resolve(path) || path;
}
// Individual standalone pages
export const STANDALONE_PAGES = [
    {
        href: makePath('/bookmarks'),
        label: 'Bookmarks',
        icon: 'bookmarks',
        description: 'Save and organize network calculations and tool results',
        keywords: ['bookmarks', 'saved', 'favorites', 'shortcuts', 'calculations'],
    },
    {
        href: makePath('/search'),
        label: 'Search',
        icon: 'search',
        description: 'Find tools and reference content quickly',
        keywords: ['search', 'find', 'lookup', 'tools', 'reference', 'content'],
    },
    {
        href: makePath('/settings'),
        label: 'Settings',
        icon: 'settings2',
        description: 'Customize themes, layouts, and accessibility preferences',
        keywords: ['settings', 'preferences', 'theme', 'layout', 'accessibility', 'customize'],
    },
    // {
    //   href: makePath('/offline'),
    //   label: 'Offline',
    //   description: 'Access cached tools and data offline',
    //   keywords: ['offline', 'cache', 'no-internet', 'local'],
    //   icon: 'offline',
    // },
];
export const TOP_NAV = [
    {
        href: makePath('/subnetting'),
        label: 'Subnetting',
        description: 'Subnet calculators for IPv4, IPv6, VLSM, supernetting',
        keywords: ['subnet calculator', 'ipv4 ipv6 subnetting', 'vlsm', 'network planning', 'netmask calculator'],
    },
    {
        href: makePath('/cidr'),
        label: 'CIDR',
        description: 'CIDR notation tools, converters, and calculators',
        keywords: ['cidr notation', 'subnet mask converter', 'cidr summarizer', 'set operations', 'ip blocks'],
    },
    {
        href: makePath('/ip-address-convertor'),
        label: 'IP Tools',
        description: 'IP address converters, validators, and generators',
        keywords: ['ip converter', 'address validator', 'ipv4 ipv6 tools', 'ip format', 'address generator'],
    },
    {
        href: makePath('/dns'),
        label: 'DNS Tools',
        description: 'DNS record generators, validators, and DNSSEC tools',
        keywords: ['dns records', 'zone files', 'dnssec', 'ptr reverse', 'spf dmarc dkim'],
    },
    {
        href: makePath('/dhcp'),
        label: 'DHCP',
        description: 'DHCP option generators for wireless controllers and network configuration',
        keywords: ['dhcp options', 'vendor specific', 'wireless controller', 'cisco aruba ruckus', 'ap discovery'],
    },
    {
        href: makePath('/diagnostics'),
        label: 'Lookups',
        description: 'Network diagnostics and connectivity testing',
        keywords: ['dns lookup', 'http headers', 'tls certificate', 'network diagnostics', 'port check'],
    },
    {
        href: makePath('/reference'),
        label: 'Ref',
        description: 'Networking reference guides and lookup tables',
        keywords: [
            'reference',
            'guide',
            'explanation',
            'networking',
            'fundamentals',
            'cidr',
            'vlsm',
            'ipv6',
            'dns',
            'protocols',
            'ports',
            'asn',
            'icmp',
            'arp',
            'ndp',
            'multicast',
            'private',
            'public',
        ],
    },
];
// Sections that have sub-pages (drives the conditional SubHeader)
export const SUB_NAV = {
    '/subnetting': [
        {
            href: makePath('/subnetting/ipv4-subnet-calculator'),
            label: 'IPv4 Subnet Calculator',
            description: 'Calculate subnet masks, network addresses, broadcast addresses, and host ranges',
            icon: 'subnet-calculator',
            featured: true,
            keywords: ['ipv4 subnet', 'subnet calculator', 'netmask', 'broadcast address', 'usable hosts', 'cidr notation'],
        },
        {
            href: makePath('/subnetting/ipv6-subnet-calculator'),
            label: 'IPv6 Subnet Calculator',
            description: 'Calculate IPv6 subnets and network prefixes',
            icon: 'ipv6-subnet-calculator',
            keywords: ['ipv6 subnet', 'prefix calculator', '128-bit', 'ipv6 addressing', 'subnet prefix'],
        },
        {
            href: makePath('/subnetting/vlsm-calculator'),
            label: 'VLSM Calculator',
            description: 'Variable Length Subnet Mask calculator for splitting networks into smaller subnets',
            icon: 'vlsm-calculator',
            keywords: ['vlsm', 'variable length subnet', 'subnet allocation', 'network design', 'vlsm calculator'],
        },
        {
            href: makePath('/subnetting/supernet-calculator'),
            label: 'Supernet Calculator',
            description: 'Aggregate multiple networks into supernets for route summarization',
            icon: 'supernet-calculator',
            keywords: ['supernet', 'route summarization', 'aggregate networks', 'supernetting'],
        },
        {
            href: makePath('/subnetting/planner'),
            label: 'Subnet Planner',
            description: 'Design VLSM networks with drag-and-drop planning',

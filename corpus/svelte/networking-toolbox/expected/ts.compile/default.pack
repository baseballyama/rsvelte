import { json, error } from '@sveltejs/kit';
import { promises as dns } from 'node:dns';
import { errorManager } from '$lib/utils/error-manager';
import { logger } from '$lib/utils/logger';
import { validateDNSServer } from '$lib/utils/ip-security';
import { ALLOW_CUSTOM_DNS_SERVERS, ALLOWED_DNS_SERVERS, BLOCK_PRIVATE_DNS_IPS, } from '$lib/config/customizable-settings';
// DNS over HTTPS endpoints
const DOH_ENDPOINTS = {
    cloudflare: 'https://cloudflare-dns.com/dns-query',
    google: 'https://dns.google/dns-query',
    quad9: 'https://dns.quad9.net/dns-query',
    opendns: 'https://doh.opendns.com/dns-query',
};
// DNS record type mapping
const DNS_TYPES = {
    A: 1,
    AAAA: 28,
    CNAME: 5,
    MX: 15,
    TXT: 16,
    NS: 2,
    SOA: 6,
    CAA: 257,
    PTR: 12,
    SRV: 33,
};
// DNS server mapping for fallback
const DNS_SERVERS = {
    cloudflare: '1.1.1.1',
    google: '8.8.8.8',
    quad9: '9.9.9.9',
    opendns: '208.67.222.222',
};

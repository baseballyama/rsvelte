    }
    else if (a === 172 && b >= 16 && b <= 31) {
        details.addressType = 'Private';
        details.scope = 'Private Network';
        details.isPrivate = true;
        details.info.push('RFC 1918 private address space (172.16.0.0/12)');
    }

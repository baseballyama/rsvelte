            pools: poolRanges,
            allocations: allocationRanges,
            freeSpace: freeBlocks.map((f) => ({ ...f, cidr: f.cidr })),
            candidates: candidateRanges,
            version,
            totalRange: { start: minAddr, end: maxAddr },
        };
    }
    catch {
        return undefined;
    }

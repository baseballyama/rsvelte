dhcp-option=tag:cisco_phone,67,${networkConfig.bootFilename}

# Separate IP range for phones (optional)
dhcp-range=tag:cisco_phone,${networkConfig.poolStart},${networkConfig.poolEnd},${networkConfig.leaseTime || '24h'}`;

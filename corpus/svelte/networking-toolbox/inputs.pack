  describe('validateDUIDConfig - DUID-LL', () => {
    it('should require MAC address for DUID-LL', () => {
      const config: DUIDConfig = {
        type: 'DUID-LL',
      };
      const errors = validateDUIDConfig(config);
      expect(errors.length).toBeGreaterThan(0);

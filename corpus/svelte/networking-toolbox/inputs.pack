          border-color: var(--color-primary);
          box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary), transparent 85%);
        }
      }
    }
  }

  .action-btn {
    display: flex;
    align-items: center;
    display: inline-flex;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);

        <thead>
          <tr>
            <th>Layer</th>
            <th>Location</th>
            <th>Inside Address</th>
            <th>Outside Address</th>
            <th>Purpose</th>
          </tr>
        </thead>
        <tbody>
          {#each cgnatContent.howItWorks.layers as layer, index (`${layer.layer}-${index}`)}

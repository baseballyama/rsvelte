    justify-content: center;
    padding: var(--spacing-md);
    animation: fadeIn 0.15s ease-out;

    @media (max-width: 768px) {
      padding: 0;
      align-items: stretch;
      background: var(--bg-primary);
    }
  }

  .shortcuts-dialog {

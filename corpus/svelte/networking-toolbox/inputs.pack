      color: var(--text-secondary);
      font-family: var(--font-mono);
    }
  }

  @keyframes chipAppear {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
</style>


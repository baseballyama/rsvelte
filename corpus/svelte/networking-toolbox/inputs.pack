            <div><strong>Explanation:</strong> {example.explanation}</div>
          </div>
        </div>
      {/each}

      <h3>Network Delegation</h3>
      <p>{reverseDnsContent.ipv4Reverse.delegation.explanation}</p>
      <table class="ref-table">

    const mode = navbarDisplay.init();
    expect(mode).toBe('none');
  });

  it('handles localStorage errors gracefully', async () => {
    global.localStorage = {
      getItem: () => { throw new Error('Storage error'); },
      setItem: () => {},
      removeItem: () => {},
      clear: () => {},
      length: 0,
      key: () => null,
    } as Storage;

    const { navbarDisplay } = await import('../../../../src/lib/stores/navbarDisplay');

          <div class="example-item">
            <h4>Benefits:</h4>
            <ul>
              {#each security.benefits as benefit, index (`benefit-${index}`)}
                <li>{benefit}</li>
              {/each}
            </ul>

            <h4>{security.limitations ? 'Limitations' : 'Challenges'}:</h4>

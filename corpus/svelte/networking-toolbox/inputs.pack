  <h3>Setup</h3>
  <div class="code">
    <code>git clone git@github.com:Lissy93/networking-toolbox.git</code>
    <code>cd networking-toolbox</code>
    <code>npm install</code>
  </div>

  <h3>Dev</h3>
  <div class="code">
    <code>npm run dev</code>
  </div>

  <h3>Check 'n Test</h3>
  <div class="code">
    <code>npm run hold-my-beer</code>
  </div>

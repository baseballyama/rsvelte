    }
  }

  .protocol-details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .detail-section {
    h5 {
      color: var(--text-primary);
      margin: 0 0 var(--spacing-md) 0;
      font-size: var(--font-size-md);
    }
  }

  .protocol-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }


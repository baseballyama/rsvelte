            }

            .test-status {
              font-size: var(--font-size-xs);
              font-weight: 700;
              padding: var(--spacing-2xs) var(--spacing-xs);
              border-radius: var(--radius-xs);
              min-width: 2.5rem;
              text-align: center;

              &.pass {
                color: var(--color-success-light);

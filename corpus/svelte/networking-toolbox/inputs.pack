        ok: false,
        status: 404,
      };
      globalThis.fetch = vi.fn().mockResolvedValueOnce(mockResponse);

      const result = await convertMACAddress('00:1A:2B:3C:4D:5E');

      expect(result.formats.decimalOctets).toBe('0.26.43.60.77.94');
    });


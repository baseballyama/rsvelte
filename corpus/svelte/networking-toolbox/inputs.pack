          <!-- Certificate Information Section -->
          {#if diagnosticState.results.certificate}
            <div class="card certificate-section">
              <div class="card-header">
                <h3>Certificate Information</h3>
              </div>
              <div class="card-content">
                <div class="cert-details">
                  <div class="cert-item">

            </div>
            <pre class="code-block"><code>{decodeResult.configExamples.keaDhcp4}</code></pre>
          </div>

          <div class="output-group">
            <div class="output-header">
              <h5>dnsmasq</h5>
              <button
                class="btn-copy"
                class:copied={clipboard.isCopied('decode-dnsmasq')}

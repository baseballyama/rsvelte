  }

  /* Size classes */
  .w-2 {
    width: 1rem;
    height: 1rem;
  }
  .h-2 {
    height: 1rem;
  }
  .w-4 {
    width: 1.25rem;
    height: 1.25rem;
  }
  .h-4 {
    height: 1.25rem;
  }
  .w-6 {
    width: 1.5rem;

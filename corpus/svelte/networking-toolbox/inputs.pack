        {#each section.list as item, index (index)}
          <li>{item}</li>
        {/each}
      </ul>
    {/if}

    {#if section.link}
      <p>
        <a href={section.link.url} rel="noopener noreferrer" target="_blank">{section.link.text}</a>
      </p>
    {/if}
  </section>

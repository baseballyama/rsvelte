    flex-direction: column;
    gap: var(--spacing-lg);

    @media (max-width: 768px) {
      padding: var(--spacing-md);
      flex: 1;
      -webkit-overflow-scrolling: touch;
    }
  }

  .shortcuts-category {
    h3 {

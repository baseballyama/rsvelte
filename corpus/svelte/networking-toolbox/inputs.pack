      const mockResponse = {
        ok: false,
        status: 404,
      };
      globalThis.fetch = vi.fn().mockResolvedValueOnce(mockResponse);

      const result = await convertMACAddress('00:1A:2B:3C:4D:5E');

      expect(result.formats.reverse).toBe('5E:4D:3C:2B:1A:00');
    });

    it('should format to IPv6 style', async () => {

                                >Type Covered:</span
                              >
                              <code>{sig.typeCovered}</code>
                              {#if sig.valid}
                                <span class="badge success" use:tooltip={'Signature is valid and within time window'}
                                  >Valid</span
                                >
                              {:else}
                                <span class="badge error" use:tooltip={'Signature is expired or not yet valid'}

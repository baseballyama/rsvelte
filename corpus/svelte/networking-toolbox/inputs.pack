      expect(result.formats.ipv6Style).toBe('001A:2B3C:4D5E');
    });

    it('should format to space-separated', async () => {
      const mockResponse = {
        ok: false,
        status: 404,
      };
      globalThis.fetch = vi.fn().mockResolvedValueOnce(mockResponse);


  }

  .range-item {
    padding: var(--spacing-md);
    background: var(--bg-primary);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--border-primary);

    &.success {
      border-left-color: var(--color-success);
      .range-perf {
        color: var(--color-success);
      }
    }

    &.warning {

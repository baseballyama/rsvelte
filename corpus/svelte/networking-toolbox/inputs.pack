                <div class="code-label">Loopback:</div>
                <div class="code-block">
                  <code class="expanded">::1</code>
                  <span class="arrow">↔</span>
                  <code class="compressed">0000:0000:0000:0000:0000:0000:0000:0001</code>
                </div>

    color: inherit;
    opacity: 0.7;

    &:hover {
      opacity: 1;
      background-color: rgba(255, 255, 255, 0.1);
    }

    &.copied {
      opacity: 1;
    }
  }

  .empty-category {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-md);
    color: var(--text-secondary);
    font-style: italic;

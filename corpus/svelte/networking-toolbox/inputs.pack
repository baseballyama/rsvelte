          <h4>Solutions:</h4>
          <ul>
            {#each privateVsPublicContent.natImplications.publicToPrivate.solutions as solution, index (`solution-${index}`)}
              <li>{solution}</li>
            {/each}
          </ul>
        </div>
      </div>
    </div>

    <div class="ref-section">
      <h2>Quick Identification Methods</h2>

      <table class="ref-table">

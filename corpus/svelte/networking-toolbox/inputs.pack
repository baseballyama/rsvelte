      expect(result.ok).toBe(true);
    });

    it('should validate patterns with many alternatives', () => {
      const alternatives = Array.from({ length: 100 }, (_, i) => `option${i}`).join('|');
      const pattern = `(?:${alternatives})`;
      const result = validateRegexInput(pattern);

      expect(result.ok).toBe(true);
    });
  });

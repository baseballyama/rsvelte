        onclick={(e) => e.stopPropagation()}
        onkeydown={(e) => {
          if (e.key === 'Escape') close();
          e.stopPropagation();
        }}
        role="dialog"
        aria-modal="true"
        tabindex="-1"
      >
        {@render searchContent()}

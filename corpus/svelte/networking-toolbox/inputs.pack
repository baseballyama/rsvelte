    .breakdown-hex {
      font-family: var(--font-mono);
      color: var(--color-primary);
      grid-column: 2;
    }

    .breakdown-desc {
      color: var(--text-tertiary);
      font-size: 0.8125rem;
      grid-column: 1 / -1;
    }
  }
</style>


                    </div>
                  </div>
                {/each}
              </div>
            {:else if section.list}
              <ul>
                {#each section.list as item ('step' in item ? item.step : 'level' in item ? item.level : item.point)}
                  <li>
                    <strong>{'step' in item ? item.step : 'level' in item ? item.level : item.point}:</strong>
                    {item.desc}

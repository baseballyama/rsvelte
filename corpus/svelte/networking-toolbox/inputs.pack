      }

      &.acceptable {
        background: var(--color-warning);
        color: var(--bg-primary);
      }

      &.slow {
        background: color-mix(in srgb, var(--color-warning), var(--color-error) 30%);
        color: var(--bg-primary);
      }

      &.very-slow {
        background: var(--color-error);
        color: var(--bg-primary);
      }
    }

    .error-badge {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);

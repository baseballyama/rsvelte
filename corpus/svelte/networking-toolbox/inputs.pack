    font-weight: 600;

    &.single {
      background-color: rgba(34, 197, 94, 0.1);
      color: var(--color-success);
    }

    &.cidr {
      background-color: rgba(59, 130, 246, 0.1);
      color: var(--color-primary);
    }
  }

  .example-input {
    font-family: var(--font-mono);

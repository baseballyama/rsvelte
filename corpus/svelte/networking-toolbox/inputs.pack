    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin: var(--spacing-md) 0;
    &.small {
      gap: var(--spacing-2xs);
    }
  }
  .avatar-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--text-primary);
    transition: transform 0.2s;
    &:hover img {
      transform: scale(1.1);

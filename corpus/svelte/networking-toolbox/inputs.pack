              <button
                class="btn-copy"
                class:copied={clipboard.isCopied('dnsmasq')}
                onclick={() => clipboard.copy(buildResult!.configExamples.dnsmasq, 'dnsmasq')}
              >
                {clipboard.isCopied('dnsmasq') ? 'Copied' : 'Copy'}

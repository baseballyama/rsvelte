// Test-friendly navigation data without SvelteKit dependencies
// This is used by e2e tests to get all page URLs without importing SvelteKit modules

export type NavItem = {
  href: string;
  label: string;
  description?: string;
  icon?: string;
  keywords?: string[];
};

export type NavGroup = {
  title: string;
  description?: string;
  items: NavItem[];
};


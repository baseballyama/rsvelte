                        <ul>
                          {#each link.errors as err, j (j)}
                            <li>{err}</li>
                          {/each}
                        </ul>
                      </div>
                    {/if}
                  </div>
                </div>

                {#if i < results.chain.length - 1}
                  <div class="chain-arrow">
                    <Icon name="arrow-down" size="sm" />
                  </div>
                {/if}
              {/each}
            </div>
          </div>
        </div>
      </div>
    </div>
  {/if}
</div>


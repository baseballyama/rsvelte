      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .search-container {
      margin-left: var(--spacing-md);
      margin-right: var(--spacing-md);
    }

    .search-input {
      font-size: var(--font-size-sm);
    }
  }
</style>


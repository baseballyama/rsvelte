          <tr>
            <th>Command</th>
            <th>Purpose</th>
            <th>ICMP Type Used</th>
          </tr>
        </thead>
        <tbody>
          {#each icmpContent.troubleshootingCommands as cmd, index (`${cmd.purpose}-${index}`)}

    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    display: block;
    word-break: break-all;
  }

  .step-content {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .translation-arrow {
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .copy-button {
    background: none;
    border: none;

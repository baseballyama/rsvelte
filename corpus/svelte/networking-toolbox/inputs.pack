            "pool": "192.168.1.100 - 192.168.1.200"
          }
        ],
        "option-data": [
          {
            "name": "routers",
            "data": "192.168.1.1"
          },
          {
            "name": "domain-name-servers",
            "data": "192.168.1.1"
          }
        ],
        "valid-lifetime": ${leaseSeconds}
      }
    ]
  }
}`;

  return {
    iscDhcpd,
    keaDhcp4,
  };
}

/**

      </section>

      <hr />

      <section>
        <h4>{content.sections.ipv6Advantages.title}</h4>
        <ul>
          {#each content.sections.ipv6Advantages.advantages as { advantage, description } (advantage)}
            <li><strong>{advantage}:</strong> {description}</li>
          {/each}
        </ul>
      </section>

      <hr />

      <section>
        <h4>Quick Tips</h4>
        <ul>
          {#each content.quickTips as tip (tip)}
            <li>{tip}</li>
          {/each}
        </ul>
      </section>
    </div>
  </div>
</div>


=== 312 src/comp/pathUtils.ts	js
import { base } from '$app/paths';
const removeTrailingSlash = (path) => (path.endsWith('/') ? path.slice(0, -1) : path);
// use by the menu to highlight the current selection
export const pathIsCurrent = (path, currentPage) => removeTrailingSlash(base + path) === removeTrailingSlash(currentPage.url.pathname);


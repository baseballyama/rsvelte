				scrollToProps.scrollToIndex = value;
				scrollToProps.scrollToOffset = undefined;
			} else if (key === 'scrollToOffset') {
				scrollToProps.scrollToOffset = value;
				scrollToProps.scrollToIndex = undefined;
			}
		}


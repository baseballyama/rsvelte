<script lang="ts">
  let {
    pressed = $bindable(),
    label,
    onclick
  }: {
    pressed: boolean;
    label: string;
    onclick?: () => void;
  } = $props();

  function clicked() {
    pressed = !pressed;
    onclick?.();
  }
</script>

<button aria-pressed={pressed ? 'true' : 'false'} onclick={clicked}>
  <span style="display: none;">{label}</span>
</button>

<style>
  button {
    position: relative;
    height: 1em;
    width: calc(100% - 0.6em);
    max-width: calc(2em);
    border-radius: 0.5em;
    -webkit-appearance: none;
    appearance: none;
    outline-offset: 2px;
    border: transparent;
  }

  button::before {
    content: '';
    position: absolute;
    display: block;
    height: 100%;
    width: 100%;
    padding: 2px;
    border-radius: 1em;
    top: 0;
    left: 0;
    background: rgb(103, 103, 121);
    box-sizing: border-box;
  }

  button[aria-pressed='true']::before {
    background: rgb(103, 103, 121);

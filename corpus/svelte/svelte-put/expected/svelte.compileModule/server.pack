import * as $ from 'svelte/internal/server';
import { tick } from 'svelte';
import { DEFAULT_TOC_CONFIG, ATTRIBUTES } from '../constants.js';

import {
	extractElementText,
	extractTocItemId,
	processAnchor,
	processObserve
} from './internals.js';

export function createTocRootAction(toc) {

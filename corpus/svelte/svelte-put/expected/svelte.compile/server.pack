	/** has selectors */
	@custom-selector :--group-selected :has(.codeblock-group-selected:checked);
	@custom-selector :--fullscreen :has(.codeblock-fullscreen:checked);
	@custom-selector :--oneliner :has(pre[data-num-lines='1']);

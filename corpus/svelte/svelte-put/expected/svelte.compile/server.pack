		:global(.codeblock:not([data-group-display='files']):last-of-type);

	@custom-selector :--c-first-of-unselected-group
		:global(.codeblock-group:not(:--group-selected) .codeblock:first-of-type);

	.codeblock.svelte-152p7v7 {
		--color-header-fg: hsl(0deg 0% 50%);

		position: relative;

		overflow: hidden;
		display: grid;
		grid-template-columns: 1fr;
		grid-template-rows: auto 1fr;

		margin-block: 24px;

		border-width: 1px;
		border-radius: 0.375rem;

		&.grouped {
			display: contents !important;
		}

		:--fullscreen {
			border-radius: 0;
		}
	}

	.codeblock.svelte-152p7v7:--fullscreen,
	.svelte-152p7v7:--g-fullscreen {
		position: fixed;
		z-index: var(--z-index-overlay);
		inset: 0;

		height: 100dvh;
		margin: 0;
	}

	.codeblock-header.svelte-152p7v7 {
		padding: 12px 16px;
		line-height: normal;
		background-color: var(--color-pre-bg);

		:where(.svelte-152p7v7):--c-collapsible-not-fullscreen & {
			cursor: pointer;
		}

		:where(.svelte-152p7v7):--c-oneliner-not-grouped-or-titled & {
			display: none;
		}
	}

	.codeblock-title.svelte-152p7v7 {
		width: fit-content;
		margin: 0;
		padding: 0;

		font-size: var(--text-xs);
		white-space: nowrap;
	}

	.codeblock-group-label.svelte-152p7v7 {
		cursor: pointer;

		position: relative;
		z-index: 2;

		grid-column: auto;
		grid-row: 1;

		padding: 12px 16px;

		font-size: var(--text-sm);
		line-height: normal;
		color: var(--color-header-fg);

		background-color: var(--color-bg);
		border-top-width: 1px;
		border-left-width: 1px;

		&:has(input:focus-visible) {
			outline-offset: -1px;
		}

		&:hover {
			color: currentcolor;
		}

		/* (unused) :--g-not-fullscreen :--c-first-of-group & {
			border-top-left-radius: 0.375rem;
		}*/

		:where(.svelte-152p7v7):--c-last-of-non-files-group & {
			border-right-width: 1px;

			:where(.svelte-152p7v7):--g-not-fullscreen & {
				border-top-right-radius: 0.375rem;
			}
		}

		:where(.svelte-152p7v7):--c-first-of-unselected-group &,
		:where(.svelte-152p7v7):--c-grouped-and-selected & {
			margin-bottom: -1px;
			color: currentcolor;
			background-color: var(--color-pre-bg);
		}
	}

	.codeblock-content.svelte-152p7v7 {
		z-index: 1;
		display: grid;
		max-width: 100%;

		.codeblock.grouped:where(.svelte-152p7v7) & {
			display: none;
			grid-column: 1 / span calc(var(--cols) + 1);
			grid-row: 2;
		}

		:where(.svelte-152p7v7):--c-grouped-and-selected &,
		:where(.svelte-152p7v7):--c-first-of-unselected-group & {
			display: grid;
		}

		:where(.svelte-152p7v7):--c-collapsible-not-fullscreen & {

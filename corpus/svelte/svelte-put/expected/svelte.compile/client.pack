	var button = $.child(div);
	var button_1 = $.sibling(button, 2);
	var button_2 = $.sibling(button_1, 2);

	$.reset(div);
	$.delegated('click', button, () => lock.toggle());
	$.delegated('click', button_1, () => lock.toggle(true));
	$.delegated('click', button_2, () => lock.toggle(false));
	$.append($$anchor, div);
	$.pop();
}


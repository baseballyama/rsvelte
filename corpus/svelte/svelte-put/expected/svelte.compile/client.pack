	$.append($$anchor, text);
}
=== 3246 sites/docs/src/routes/(site)/+layout.svelte	css

	@import '@svelte-put/ui/css/medias';

	#docs.svelte-lp2mpd {
		--color-bg-aside: color-mix(in oklch, var(--color-bg), var(--color-fg) 4%);
	}

	header.svelte-lp2mpd {
		background-color: var(--color-bg-aside);
	}

	.sidebar.svelte-lp2mpd {
		flex-shrink: 0;

		width: var(--spacing-sidebar);

		font-size: var(--text-sm);

		transition-timing-function: var(--default-transition-timing-function);
		transition-duration: 200ms;
		transition-property: transform, opacity;

		& .sidebar-content:where(.svelte-lp2mpd) {
			position: sticky;
			top: var(--spacing-header);
			overflow: auto;
			padding-block: calc(var(--spacing) * 10);
		}

		&.sidebar-left {
			& .sidebar-content:where(.svelte-lp2mpd) {
				max-height: calc(100dvh - var(--spacing-header));
				padding-inline: calc(var(--spacing) * 4);
			}

			@media (--upto-desktop) {
				position: fixed;
				z-index: calc(var(--z-index-header) + 2);
				top: 0;
				bottom: 0;
				left: 0;
				transform: translateX(-100%);

				display: flex;

				opacity: 0;
				background-color: var(--color-bg-aside);
				border-right-width: 1px;
				box-shadow: var(--box-shadow-lg);

				& .sidebar-content:where(.svelte-lp2mpd) {
					max-height: 100vh;
				}
			}
		}

		&.sidebar-right {
			& .sidebar-content:where(.svelte-lp2mpd) {
				max-height: calc(100dvh - var(--spacing-header));
				padding: calc(var(--spacing) * 10) calc(var(--spacing) * 2) calc(var(--spacing) * 2);
			}

			@media (--upto-widescreen) {
				position: fixed;
				z-index: calc(var(--z-index-header) + 2);
				top: var(--spacing-header);
				right: 0;
				transform: translateX(100%);

				display: flex;
				justify-content: center;

				width: auto;
				max-width: 80vw;

				opacity: 0;
				background-color: var(--color-bg-aside);
				border-bottom-right-radius: var(--radius-sm);
				border-bottom-left-radius: var(--radius-sm);
				box-shadow: var(--box-shadow-lg);

				& .sidebar-content:where(.svelte-lp2mpd) {
					max-height: calc(95dvh - var(--spacing-header));
					padding: calc(var(--spacing) * 8) calc(var(--spacing) * 8) calc(var(--spacing) * 10);
				}
			}
		}
	}

	.sidebar-backdrop.svelte-lp2mpd {
		pointer-events: none;

		position: fixed;
		z-index: calc(var(--z-index-header) + 1);
		inset: 0;

		opacity: 0;
		background-color: color-mix(in oklch, var(--color-black) 50%, transparent 50%);
		backdrop-filter: blur(1px);

		transition: opacity 200ms var(--default-transition-timing-function);

		&::-webkit-scrollbar {
			display: none;
		}
	}

	.sidebar.svelte-lp2mpd:has(input:where(.svelte-lp2mpd):checked) {
		transform: translateX(0);
		opacity: 1;

		& + .sidebar-backdrop:where(.svelte-lp2mpd) {
			pointer-events: unset;
			opacity: 1;
		}
	}

	main.svelte-lp2mpd {
		width: 100%;
		max-width: 100%;
		padding-top: calc(var(--spacing) * 10);
		padding-bottom: calc(var(--spacing) * 20);

		@media (--desktop) {
			max-width: calc(100% - var(--spacing-sidebar));
			padding-inline: calc(var(--spacing) * 10);
		}

		@media (--widescreen) {
			max-width: calc(100% - var(--spacing-sidebar) * 2);
			padding-inline: calc(var(--spacing) * 14);
		}
	}

	:where(#docs.svelte-lp2mpd) :where(h1, h2, h3, h4, h5, h6) {
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--color-outline);
	}


	// :::
	// :::
	async function pushNoti() {
		// :::focus
		// :::highlight
		const pushed = notiStack.push('info', {
			// :::
			// :::
			timeout: 0,
			props: { content: 'persistent' },
		});

		// :::focus
		// :::highlight
		promise = pushed.resolution;
		await promise;
		// :::
		// :::

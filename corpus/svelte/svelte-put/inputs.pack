	>
		<!-- ::: -->
		<!-- ::: -->
		{#each new Array(10) as _, row}
			<div class="grid grid-cols-[repeat(10,1fr)]">
				{#each new Array(10) as _, col}
					<div
						class="
							grid h-20 w-20 select-none place-items-center
              {row % 2 === 0 ? classesForEvenRows : classesForOddRows}
            "
					>
						{row * 10 + col + 1}
					</div>
				{/each}
			</div>
		{/each}
	</div>
</div>


			<input id="toc-toggler" type="checkbox" hidden />
			<div class="sidebar-content text-sm">
				{#if toc.items.size}
					<p class="py-2 font-bold uppercase">On This Page</p>
					<ul class="border-outline space-y-1 border-l">

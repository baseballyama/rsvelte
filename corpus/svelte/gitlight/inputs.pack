			margin-left: auto;
			color: variables.$bg-5;

			&.muted {
				opacity: 1;
			}

			&:hover {
				color: variables.$bg-6;
			}

			:global(svg) {
				height: 1.25rem;
			}
		}
	}

	.empty {
		color: variables.$bg-5;
	}
</style>


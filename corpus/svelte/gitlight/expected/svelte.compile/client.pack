		gap: 2rem;
		inset: 0;

		.text-container:where(.svelte-xcf0tf) {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;

			.title:where(.svelte-xcf0tf) {
				@include typography.heading-2;
			}

			.subtitle:where(.svelte-xcf0tf) {
				color: variables.$bg-5;
			}
		}

		.loading-line:where(.svelte-xcf0tf) {
			@keyframes svelte-xcf0tf-slide {
				0% {
					translate: -100%;
				}

				100% {
					translate: 100%;
				}
			}

			position: absolute;
			height: 0.25rem;
			animation: svelte-xcf0tf-slide 1s infinite forwards linear;
			background-image: linear-gradient(to right, transparent, variables.$blue, transparent);
			inset: auto 0 0;
		}
	}


                IRRELEVANT_NOTIFICATION_IDS.add(id);
                return null;
            }
            value = {
                ...common,
                author,
                creator: { login: user.login, avatar: user.avatar_url, bot: user.type === 'Bot' },
                description,
                icon: getIssueIcon(data),
                opened: state === 'open',
                number,
                labels,
                url,
                previously: previous?.description !== description ? previous : previous?.previously || undefined,

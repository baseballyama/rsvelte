/* 03-input.svelte.js generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export function createCounter() {
	let count = $.state(0);

	function increment() {
		$.set(count, $.get(count) + 1);
	}

	return {
		get count() {
			return $.get(count);
		},
		increment
	};
}

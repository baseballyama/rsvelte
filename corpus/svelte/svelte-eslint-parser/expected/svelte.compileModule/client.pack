import * as $ from 'svelte/internal/client';

export function foo() {
	let a = $.state(null);

	$.set(a, null // *
	);

	const d = $.derived(() => $.get(a)?.n ? fn($.get(a).n) : null);

	return {
		get d() {
			return $.get(d);
		},

		set(b) {
			$.set(a, b, true);
		}
	};

	function fn(n) {
		return n * 2;
	}
}

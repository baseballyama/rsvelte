import * as $ from 'svelte/internal/client';

export class Product {
	#x = $.state(1);

	get x() {
		return $.get(this.#x);
	}

	set x(value) {
		$.set(this.#x, value, true);
	}

	#y = $.state(2);

	get y() {
		return $.get(this.#y);
	}

	set y(value) {
		$.set(this.#y, value, true);
	}

	#result = $.derived(() => this.x * this.y);

	get result() {
		return $.get(this.#result);
	}

	set result(value) {
		$.set(this.#result, value);
	}
}

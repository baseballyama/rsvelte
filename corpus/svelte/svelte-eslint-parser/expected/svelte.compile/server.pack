				$$renderer.push(`<div>${$.escape(item.title)}</div>`);
			}
		}
	});

	$$renderer.push(`<!----> `);

	Component($$renderer, {
		items,
		children: ($$renderer) => {
			$$renderer.push(`<div>${$.escape(item.title)}</div>`);
		},

		$$slots: {
			default: true,
			count: ($$renderer, { count: foo }) => {
				$$renderer.push(`<span slot="count">${$.escape(foo)}</span>`);
			}
		}
	});

	$$renderer.push(`<!----></main>`);
}

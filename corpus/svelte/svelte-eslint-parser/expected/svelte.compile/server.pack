	const items = [
		{ title: "Svelte.dev", link: "https://svelte.dev" },
		{
			title: "TypeScript ESLint",
			link: "https://typescript-eslint.io"
		},
		{ title: "TypeScript", link: "https://www.typescriptlang.org" }

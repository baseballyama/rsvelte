/** Assert equals */
export function assertResult(aRoot, bRoot, _info) {
    const buffers = new Set([
        {
            a: aRoot,
            b: bRoot,
            path: "$",
            parent: null,
        },
    ]);
    const pairs = new Map();
    while (buffers.size) {
        for (const data of buffers) {
            buffers.delete(data);
            const { a, b, path } = data;
            if (a === b) {
                continue;
            }
            if (a == null || b == null) {
                throw error(path, `Not equal at ${path}: ${toDebugString(a)} !== ${toDebugString(b)}`);
            }
            if (typeof a === "function" && typeof b === "function") {
                // Maybe equal
                continue;
            }
            if (typeof a !== "object" || typeof b !== "object") {
                throw error(path, `Not equal at ${path}: ${toDebugString(a)} !== ${toDebugString(b)}`);
            }
            if (pairs.get(a) === b) {
                // Avoid circular reference errors.
                continue;
            }
            pairs.set(a, b);
            if (Array.isArray(a) && Array.isArray(b)) {
                if (a.length !== b.length) {
                    throw error(path, `Not equal array length at ${path}: ${a.length} !== ${b.length}
    ${toDebugString(a)} !== ${toDebugString(b)}`);
                }
                const len = Math.max(a.length, b.length);
                for (let index = 0; index < len; index++) {
                    buffers.add({
                        a: a[index],
                        b: b[index],
                        path: `${path}[${index}]`,
                        parent: data,
                    });
                }
                continue;
            }
            if (a instanceof Map && b instanceof Map) {
                const keys = new Set([...a.keys(), ...b.keys()]);
                for (const key of keys) {
                    buffers.add({
                        a: a.get(key),
                        b: b.get(key),
                        path: `${path}.${key}`,
                        parent: data,
                    });
                }
                continue;
            }
            if (a instanceof Set && b instanceof Set) {
                const keys = new Set([...a.keys(), ...b.keys()]);
                for (const key of keys) {
                    if (!a.has(key) || !b.has(key)) {
                        throw error(path, `Not equal keys at ${path}.${key}: ${toDebugString(key)} !== undefined`);
                    }
                }
                continue;
            }
            const aKeys = Object.getOwnPropertyNames(a).filter((key) => !ignoreKey(key, a));
            const bKeys = Object.getOwnPropertyNames(b).filter((key) => !ignoreKey(key, b));
            const keys = new Set([...aKeys, ...bKeys]);
            for (const key of keys) {
                let aVal = a[key];
                let bVal = b[key];
                if (key === "isWrite" || key === "isRead") {
                    if (typeof aVal === "function" && typeof bVal === "function") {
                        aVal = aVal.call(a);
                        bVal = bVal.call(b);
                    }
                }
                buffers.add({
                    a: aVal,
                    b: bVal,
                    path: `${path}.${key}`,
                    parent: data,
                });
            }
        }
    }
    return true;
    function ignoreKey(key, obj) {
        if (key === "$id" || key === "implicit") {
            // Always ignore these keys
            return true;
        }
        if (key === "argument" && obj.type === "TSImportType") {
            // Ignore the "argument" property of TSImportType.
            // Because the "argument" property is a duplicated property that is not used in the latest version of typescript-eslint
            return true;
        }
        return false;
    }
    function error(_path, message) {
        // console.log(_path, aRoot, bRoot, _info);
        throw new Error(message);
    }
}
/** Object to string */
function toDebugString(o) {
    const circular = new Set();
    return JSON.stringify(normalize(o), (key, value) => {
        if (key === "parent" ||
            key === "childScopes" ||
            key === "variables" ||
            key === "variableScope" ||
            key === "references" ||
            key === "upper" ||
            key === "through" ||
            key === "tokens" ||
            key === "node" ||
            key === "defs" ||
            key === "identifiers" ||
            key === "eslintUsed") {
            return undefined;
        }
        if (value == null || typeof value !== "object") {
            return value;
        }
        if (circular.has(value)) {
            return "[Circular]";
        }
        circular.add(value);
        return normalize(value);
    }, 2);

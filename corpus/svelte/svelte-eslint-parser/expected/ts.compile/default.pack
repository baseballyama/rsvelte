        if (typeof o !== "object") {
            return o;
        }
        if ("type" in o && "range" in o && "loc" in o) {
            return {
                type: o.type,
                name: o.name,
                value: o.value,
                range: o.range,
                loc: o.loc,
            };
        }
        if ("type" in o && o.type === "global") {
            return {
                type: o.type,
                block: o.block,
                childScopes: o.childScopes,
                functionExpressionScope: o.functionExpressionScope,
            };
        }
        if (o instanceof Map) {
            return Object.fromEntries(o.entries());
        }
        if (o instanceof Set) {
            return [...o];
        }
        return o;
    }
}


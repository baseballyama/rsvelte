            output: { compilerOptions: { runes: true } },
        },
        {
            code: `
        const {compilerOptions = {runes:true}} = {}
        export default {compilerOptions}
        `,
            output: { compilerOptions: { runes: true } },
        },
        {
            code: `
        export default {compilerOptions:{}}
        `,
            output: { compilerOptions: {} },
        },
    ];
    for (const { code, output } of testCases) {
        it(code, () => {
            assert.deepStrictEqual(parseConfig(code), output);
        });
    }
});


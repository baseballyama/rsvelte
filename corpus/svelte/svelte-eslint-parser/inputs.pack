/** Convert for Let Directive */
function convertLetDirective(
  node: SvAST.LetDirective | LetDirective,
  parent: SvelteLetDirective["parent"],
  ctx: Context,
): SvelteLetDirective {
  const directive: SvelteLetDirective = {
    type: "SvelteDirective",
    kind: "Let",

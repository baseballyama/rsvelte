    processPattern(pattern) {
      return ctx.letDirCollections
        .getCollection()
        .addPattern(
          pattern,
          directive,
          buildLetDirectiveType(parent.parent, node.name, ctx),
        );
    },
    processName: node.expression
      ? undefined

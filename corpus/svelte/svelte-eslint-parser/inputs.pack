    processExpression: buildProcessExpressionForExpression(
      directive,
      ctx,
      null,
    ),
    processName: (name) =>
      ctx.scriptLet.addExpression(
        name,
        directive.key,
        null,
        buildExpressionTypeChecker(["Identifier"], ctx),

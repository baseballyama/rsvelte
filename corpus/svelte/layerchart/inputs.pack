      style:opacity={rest.opacity}
      {...rest}
      class={['lc-group-div', className]}
      ontouchmove={handleTouchMove}
    >
      {@render children?.()}
    </div>
  {/each}
{:else}
  <div
    bind:this={ref}
    style:transform={c.transform}
    style:opacity={rest.opacity}
    in:transitionIn={transitionInParams}
    {...rest}
    class={['lc-group-div', className]}

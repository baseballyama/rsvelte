  Without<RectPropsWithoutHTML, BaseRectClipPathPropsWithoutHTML>;

export type RectClipPathProps = RectClipPathPropsWithoutHTML &
  Without<SVGAttributes<SVGElement>, RectClipPathPropsWithoutHTML> &
  CommonEvents;


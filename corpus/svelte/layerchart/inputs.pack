      styles: { fill: 'red', fillOpacity: '1', opacity: '0.6', stroke: 'none' },
    });

    // Should be 0.5 (inherited) * 0.6 (element opacity) * 1 (fillOpacity) = 0.3
    expect(globalAlphaValues[0]).toBeCloseTo(0.3);

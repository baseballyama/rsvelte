			{#snippet children({ gradient })}
				<Spline class="stroke-2" stroke={gradient} />
			{/snippet}
		</LinearGradient>
	</Layer>
	<Legend
		scale={temperatureColor}
		title="Temperature (°F)"
		placement="top-right"
		width={240}
		class="-top-[14px]"
	/>

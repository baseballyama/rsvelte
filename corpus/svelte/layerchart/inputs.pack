<script lang="ts">
	import { type ComponentProps } from 'svelte';
	import { cubicOut } from 'svelte/easing';
	import { fade } from 'svelte/transition';
	import { hierarchy as d3Hierarchy, type HierarchyNode } from 'd3-hierarchy';

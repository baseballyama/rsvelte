							height={60}
							class="flex-1"
						>
							<Layer>
								<Trail curve={curve.value} {cap} class="fill-primary/40" />
								<Spline curve={curve.value} class="stroke-surface-content/40 stroke-1" />
							</Layer>
						</Chart>
						<span class="text-xs text-surface-content/50 w-24 shrink-0">{curve.label}</span>
					</div>
				{/each}
			</div>
		</div>
	{/each}
</div>


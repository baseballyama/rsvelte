    if (this.constrainToDomain) {
      this.x = this._clampToDomain('x', this.x);
      this.y = this._clampToDomain('y', this.y);
    }
  }

  /**
   * Sync external domain values into brush state.
   * Only writes when values actually differ to avoid reactive loops.
   */
  syncFromExternal(
    externalX: BrushDomainType | null | undefined,
    externalY: BrushDomainType | null | undefined
  ) {
    const newX = externalX ?? [null, null];
    const newY = externalY ?? [null, null];

    // Only write when values actually differ to avoid reactive loops
    if (!isEqualValue(this.x[0], newX[0]) || !isEqualValue(this.x[1], newX[1])) {
      this.x = newX;
    }
    if (!isEqualValue(this.y[0], newY[0]) || !isEqualValue(this.y[1], newY[1])) {
      this.y = newY;
    }

    const isXAxisActive =
      externalX != null &&
      externalX[0] != null &&
      externalX[1] != null &&
      (!isEqualValue(externalX[0], this.xDomainMin) ||
        !isEqualValue(externalX[1], this.xDomainMax));
    const isYAxisActive =
      externalY != null &&
      externalY[0] != null &&
      externalY[1] != null &&
      (!isEqualValue(externalY[0], this.yDomainMin) ||
        !isEqualValue(externalY[1], this.yDomainMax));

    const newActive =
      this.axis === 'x'
        ? isXAxisActive
        : this.axis === 'y'
          ? isYAxisActive
          : isXAxisActive || isYAxisActive;

    if (this.active !== newActive) {
      this.active = newActive;
    }
  }
}


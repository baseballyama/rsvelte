<script module lang="ts">
	import { getAppleStock } from '$lib/data.remote';
	const data = await getAppleStock();
</script>

<script lang="ts">
	import { AnnotationPoint, Layer, LineChart, Tooltip } from 'layerchart';
	import { format, sortFunc } from '@layerstack/utils';

	// Get a few random points to use for annotations
	const annotations = $derived(
		[...data]
			.sort(() => Math.random() - 0.5)
			.slice(0, 5)
			.sort(sortFunc('date'))
			.map((d, i) => ({
				x: d.date,
				y: d.value,
				label: String.fromCharCode(65 + i),
				details: `This is an annotation for ${format(d.date)}`
			}))
	);

	export { data };
</script>

<LineChart {data} x="date" y="value" height={300} padding={{ left: 25, bottom: 15 }}>

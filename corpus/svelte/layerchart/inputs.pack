								</RectClipPath>
							</Group>
						{/each}
					{/snippet}
				</Treemap>
			</Layer>

			<Tooltip.Root>
				{#snippet children({ data })}
					<Tooltip.Header>{data.data.name}</Tooltip.Header>
					<Tooltip.List>
						<Tooltip.Item label="value" value={data.value} format="integer" />
					</Tooltip.List>
				{/snippet}
			</Tooltip.Root>
		{/snippet}
	</Chart>
</div>


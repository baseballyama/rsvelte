<script lang="ts">
	import { Chart, Layer, LinearGradient, Pattern, Rect } from 'layerchart';
</script>

<Chart height={300}>
	<Layer>
		<LinearGradient stops={['hsl(60 100% 50%)', 'hsl(30 100% 40%)']}>
			{#snippet children({ gradient })}
				<Pattern size={4} background={gradient}>

			date: '2025-11-05T05:00:00.000Z',
			value: 14
		},
		{
			date: '2025-11-07T05:00:00.000Z',
			value: 67
		}
	];

	const keyColors = [
		'var(--color-info)',
		'var(--color-success)',
		'var(--color-warning)',
		'var(--color-danger)'
	];

	export { data };
</script>


    },
  },
  {
    name: 'base-canvas',
    group: 'Base (layer-specific)',
    description: '`Chart` + `Canvas` from `layerchart/canvas`',
    imports: ['Chart', 'Canvas'],
    layers: {
      Chart: 'canvas',

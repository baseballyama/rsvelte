  import { scaleBand } from 'd3-scale';
  import Chart from '../Chart/Chart.svelte';
  import Layer from '../layers/Layer.svelte';
  import Bars from '../Bars/Bars.svelte';

  let {
    data,
    x,
    y,
    orientation = 'vertical',
    barWidth,
    barHeight,
  }: {
    data: any[];
    x: string;
    y: string;
    orientation?: 'horizontal' | 'vertical';
    barWidth?: number;
    barHeight?: number;

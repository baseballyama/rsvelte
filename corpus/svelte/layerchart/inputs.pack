<script lang="ts">
	import { Chart, ClipPath, Frame, Layer, Pattern } from 'layerchart';

	const cx = 150;
	const cy = 150;
	const r = 100;
	const path = `M${cx - r},${cy} a${r},${r} 0 1,0 ${2 * r},0 a${r},${r} 0 1,0 ${-2 * r},0 Z`;
</script>


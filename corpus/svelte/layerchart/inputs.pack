  });

  it('applies strokeDasharray with comma separator', () => {
    const setLineDashSpy = vi.spyOn(ctx, 'setLineDash');

    renderPathData(ctx, 'M0,0 L100,0', {
      styles: {
        fill: 'none',
        stroke: 'black',
        strokeDasharray: '2,2',
        strokeOpacity: '1',

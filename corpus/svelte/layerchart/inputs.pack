	axis={{ placement: 'bottom', rule: true }}
	props={{ xAxis: { label: 'Life expectancy (log)' } }}
>
	{#snippet marks({ context })}
		<Dodge axis="y" anchor="middle" padding={1}>
			{#snippet children({ items })}
				{#each items as { data: country, x, y, r, index } (index)}

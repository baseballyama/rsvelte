      styles: { fill: 'red', fillOpacity: '1', opacity: '1', stroke: 'none' },
    });

    // Should be 0.5 (inherited) * 1 * 1 = 0.5, not overwritten to 1
    expect(globalAlphaValues[0]).toBeCloseTo(0.5);

      style:position="absolute"
      style:left="{item.x1}px"
      style:top="{item.y1}px"
      style:width="{length}px"
      style:height="{resolvedStrokeWidth ?? 1}px"
      style:transform="translateY(-50%) rotate({angle}deg)"

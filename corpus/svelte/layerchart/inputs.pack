		{data}
		x="date"
		y="rain"
		axis={{ placement: 'right', tickMarks: false }}
		yDomain={[0, 500]}
		yRange={({ height }) => [0, height]}
		padding={{ left: 32, right: 32, bottom: 20 }}
		props={{
			bars: {
				rounded: 'none',
				class: '_stroke-none fill-blue-500'
			}
		}}
		height={300}
	/>


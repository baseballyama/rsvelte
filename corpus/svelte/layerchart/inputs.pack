<script lang="ts">
  import { ArcLabelState } from './ArcLabel.shared.svelte.js';

  let {
    Path,
    Text,
    getArcTextProps,
    centroid,
    startAngle,
    endAngle,
    innerRadius,
    outerRadius,
    placement = 'centroid',
    startOffset,
    outerPadding,
    calloutLineLength = 16,
    calloutLabelOffset = 12,
    calloutPadding = 4,
    line,
    offset = 0,
    ...restProps
  }: ArcLabelBaseProps = $props();

  const c = new ArcLabelState(
    () =>
      ({
        getArcTextProps,
        centroid,
        startAngle,
        endAngle,
        innerRadius,
        outerRadius,
        placement,
        startOffset,
        outerPadding,
        calloutLineLength,
        calloutLabelOffset,
        calloutPadding,
        line,
        offset,
      }) as ArcLabelProps
  );
</script>

{#if placement === 'callout' && c.calloutGeometry}

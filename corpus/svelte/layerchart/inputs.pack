				motion={{ type: 'tween', duration: 1000, easing: cubicInOut }}
			/>
			<Arc
				initialValue={0}
				value={80}
				outerRadius={-50}
				innerRadius={-20}
				cornerRadius={10}
				class="fill-cyan-400"
				track={{ class: 'fill-cyan-500/10' }}
				motion={{ type: 'tween', duration: 1000, easing: cubicInOut }}
			/>
		{/if}
	</Layer>
</Chart>


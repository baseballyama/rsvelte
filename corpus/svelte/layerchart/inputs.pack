  data={[{ date: '2024-01', value: 10 }]}
  x="date"
  y="value"
  width={300}
  height={300}
  bind:context={chartContext}
>
  <Layer type="html">
    <ComponentNodeLifecycleParent {onparentnode}>
      {#if showChild}
        <ComponentNodeLifecycleChild />
      {/if}
    </ComponentNodeLifecycleParent>
  </Layer>
</Chart>


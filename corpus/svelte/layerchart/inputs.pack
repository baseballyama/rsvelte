		<Axis placement="bottom" rule tickMultiline />
		<Bars y={['high', 'low']} insets={{ x: 1.5 }} class="fill-surface-content" />
		<Bars y={['open', 'close']} insets={{ x: 0.5 }} />
		<Highlight area />
	</Layer>

	<Tooltip.Root>
		{#snippet children({ data })}

<script lang="ts">
  import { extractLayerProps } from '$lib/utils/attributes.js';
  import { AreaState } from './Area.shared.svelte.js';

  let {
    Path,
    Spline,
    curve,
    data,
    defined,
    fill,
    stroke = 'none',
    opacity,
    // Pulled out of `restProps` so the resolved values win over the raw props
    class: className,
    line = false,
    pathData,
    motion,
    x,
    y0,
    y1,
    z,
    seriesKey,
    ...restProps
  }: AreaBaseProps = $props();

  const c = new AreaState(
    () =>
      ({
        curve,
        data,
        defined,
        fill,
        stroke,
        opacity,
        class: className,
        line,
        pathData,
        motion,
        x,
        y0,
        y1,

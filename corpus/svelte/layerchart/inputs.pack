  import { cls } from '@layerstack/tailwind';

  import { RuleState } from './Rule.shared.svelte.js';

  let {
    Group,
    Line,
    Circle,
    data: dataProp,
    x = false,
    xOffset = 0,
    y = false,
    yOffset = 0,
    stroke: strokeProp,
    class: className,
    children,
    ...restProps
  }: RuleBaseProps = $props();

  const c = new RuleState(
    () =>
      ({
        data: dataProp,
        x,
        xOffset,
        y,
        yOffset,

	let bandwidth = $state(5);

	const data = [
		{
			group: 'Tight',
			values: [
				28, 29, 30, 30, 30, 31, 31, 31, 32, 32, 32, 32, 33, 33, 33, 33, 33, 34, 34, 34, 34, 35, 35,
				35, 36, 36, 37, 38

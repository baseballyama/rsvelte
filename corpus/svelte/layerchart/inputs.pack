	geo={{
		projection: geoOrthographic,
		fitGeojson: countries
	}}
	transform={{
		mode: 'projection',
		motion: 'spring',
		inertia: enabled ? { decay, minVelocity } : false,
		constrain: ({ scale, translate }) => ({
			scale,
			translate: {
				x: translate.x,
				y: Math.max(-90, Math.min(90, translate.y))
			}
		})
	}}
	padding={{ top: 5, bottom: 5, left: 5, right: 5 }}
	height={400}
>
	<Layer>

<script lang="ts">
	import type { ComponentProps } from 'svelte';
	import { Field, RangeField, Switch, TextField, ToggleGroup, ToggleOption } from 'svelte-ux';
	import { Text } from 'layerchart';

	interface Props {
		config?: {
			x: number;
			y: number;
			value: string;
			width: number;
			textAnchor: ComponentProps<typeof Text>['textAnchor'];
			verticalAnchor: ComponentProps<typeof Text>['verticalAnchor'];
			lineHeight: string;
			rotate: number;
			scaleToFit: boolean;
			showAnchor: boolean;
			resizeSvg: boolean;
			truncate: boolean;
			truncateOptions: {
				maxChars?: number;
				minChars?: number;
				ellipsis?: string;
				position?: 'start' | 'middle' | 'end';
			};
		};
	}

	let {
		config = $bindable({
			x: 0,
			y: 0,
			value: 'This is really long text',
			width: 300,
			textAnchor: 'start',
			verticalAnchor: 'start',
			lineHeight: '1em',
			rotate: 0,
			scaleToFit: false,
			showAnchor: true,
			resizeSvg: true,
			truncate: false,
			truncateOptions: {
				maxChars: 22,
				minChars: 0,
				ellipsis: '…',
				position: 'end'
			}
		})
	}: Props = $props();
</script>


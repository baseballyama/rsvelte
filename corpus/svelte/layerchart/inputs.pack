			},
			{
				key: 'dirtyh2o',
				color: 'hsl(0, 84%, 60%)',
				props: {
					rounded: 'none'
				}
			},
			{
				key: 'rain_induced',
				color: 'hsl(142, 71%, 45%)',
				props: {
					rounded: 'none'
				}
			}

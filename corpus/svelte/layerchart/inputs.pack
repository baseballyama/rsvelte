	const data: Item[] = milestones.map((m) => ({
		date: m.date,
		category: m.category,
		label: m.label.replace(/\n/g, ' ')
	}));

	/** Estimate the half width of a label based on its character length */
	function labelHalfWidth(label: string) {
		return (label.length * 6.5) / 2;
	}

	export { data };
</script>


<script module lang="ts">
	import { getAppleStock } from '$lib/data.remote';
	const data = await getAppleStock();
</script>

<script lang="ts">
	import {
		Area,
		Axis,
		Chart,
		ChartClipPath,
		Layer,
		LinearGradient,
		defaultChartPadding,
		type DomainType
	} from 'layerchart';

	export { data };

	let xDomain = $state<DomainType>([null, null]);
	let yDomain = $state<DomainType>([null, null]);
</script>

<Chart
	{data}
	x="date"
	{xDomain}
	y="value"
	{yDomain}
	padding={defaultChartPadding({ left: 25, bottom: 24 })}
	brush={{
		axis: 'both',
		onBrushEnd: (e) => {
			xDomain = e.brush.x;
			yDomain = e.brush.y;
			e.brush.reset();
		}
	}}
	height={300}
>
	<Layer>
		<Axis placement="left" grid rule />

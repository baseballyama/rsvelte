			y={120}
			{length}
			{rotate}
			{anchor}
			shape="spike"
			class="stroke-danger fill-danger/25"
		/>

		<!-- Spike with fixed width -->
		<Text x={305} y={16} textAnchor="middle" class="text-xs fill-surface-content/50"
			>spike (width)</Text
		>
		<Vector
			x={305}
			y={120}
			{length}
			{rotate}
			{anchor}
			shape="spike"
			{width}
			class="stroke-danger fill-danger/25"
		/>

		<!-- Custom: line + circle -->

			{/snippet}
		</RadialGradient>

		<RadialGradient stops={['hsl(195 100% 50%)', 'hsl(270 100% 30%)']} r="30%">
			{#snippet children({ gradient })}
				<Circle cx={radius + 2 * 120} cy={radius} r={radius} fill={gradient} />
			{/snippet}
		</RadialGradient>
	</Layer>

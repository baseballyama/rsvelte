<script lang="ts">
	import { scaleUtc } from 'd3-scale';
	import { curveCatmullRom } from 'd3-shape';
	import { Axis, Chart, Layer, Spline } from 'layerchart';

	export { data };
</script>

<Chart
	{data}
	x="date"
	xScale={scaleUtc()}
	y="value"
	yRange={({ height }) => [height / 5, height / 2]}
	yPadding={[0, 20]}
	z="year"
	zDomain={[1940, 2024]}

        <circle
          cx={circle.cx}
          cy={circle.cy}
          r={circle.r}
          fill={circle.fill}
          opacity={circle.opacity}
        />
      {/each}

      {#each shapes.filter((s) => s.type === 'rect') as rect}
        <rect
          x={rect.x}
          y={rect.y}
          width={rect.width}
          height={rect.height}
          rx={rect.rx as number | string | undefined}
          ry={rect.ry as number | string | undefined}
          fill={rect.fill}
          opacity={rect.opacity}
        />
      {/each}
    {/if}
  </pattern>

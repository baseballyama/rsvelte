export function renderRect(
  ctx: CanvasRenderingContext2D,
  coords: {
    x: number;
    y: number;
    width: number;
    height: number;
    rx?: number;
    ry?: number;
    /** Per-corner radii [tl, tr, br, bl]. Takes precedence over `rx`/`ry`. */
    corners?: [number, number, number, number];

  width?: number;
  /** @default 0.5 */
  capWidth?: number;
  /** @default 0 */
  radius?: number;
  /** @default 3 */
  outlierRadius?: number;
  tooltip?: boolean;
} & CommonStyleProps;

export type BoxPlotProps = BoxPlotPropsWithoutHTML &
  Without<SVGAttributes<SVGElement>, BoxPlotPropsWithoutHTML> &
  CommonEvents;


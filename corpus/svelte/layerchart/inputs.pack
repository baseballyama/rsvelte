	{data}
	x="date"
	y="value"
	padding={{ left: 16 }}
	brush={{
		x: mainContext?.xDomain,
		onChange: (e) => {
			if (mainContext && e.brush.active) {
				mainContext.zoomToBrush(e.brush, 'x');
			}
		},
		onBrushEnd: (e) => {
			if (mainContext && !e.brush.active) {
				mainContext.transform.reset();
			}
		}
	}}
	height={40}
>
	<Layer>
		<Area line={{ class: 'stroke-2 stroke-primary' }} class="fill-primary/20" />
	</Layer>
</Chart>


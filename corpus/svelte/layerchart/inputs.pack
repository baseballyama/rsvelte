  cap?: TrailCap;
  tension?: number;
  resolution?: number;
  fill?: string;
  fillOpacity?: number;
  opacity?: number;
  class?: string;
  motion?: MotionProp;
};

export type TrailProps = TrailPropsWithoutHTML & Omit<PathProps, keyof TrailPropsWithoutHTML | 'r'>;


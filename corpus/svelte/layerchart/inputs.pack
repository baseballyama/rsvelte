			start: new Date('2021-10-01'),
			end: new Date('2021-12-15')
		},
		{
			category: 'Five',
			start: new Date('2021-02-01'),
			end: new Date('2021-04-15')
		},
		{
			category: 'Five',
			start: new Date('2021-10-01'),
			end: new Date('2021-12-31')
		}
	];
	export { data };

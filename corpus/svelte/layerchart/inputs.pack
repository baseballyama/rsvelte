			{/if}
			{#if config.showPoints}
				<Points>
					{#snippet children({ points })}
						{#each points as point, index}
							<Circle
								cx={point.x}
								cy={point.y}
								r={2}
								class={index % 2 ? 'fill-primary' : 'fill-secondary'}
								motion={config.tweened ? 'tween' : undefined}
							/>
						{/each}
					{/snippet}
				</Points>
			{/if}
		</Layer>
	</Chart>
</div>


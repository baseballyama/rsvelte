<Field label="Placement">
	<ToggleGroup bind:value={placement} variant="outline">
		<ToggleOption value="inside">Inside</ToggleOption>
		<ToggleOption value="outside">Outside</ToggleOption>
	</ToggleGroup>
</Field>

<BarChart
	{data}
	x={['start', 'end']}
	xScale={scaleTime()}
	y="category"
	xBaseline={undefined}
	xNice={false}
	c="category"
	cRange={[
		'var(--color-success)',
		'var(--color-danger)',
		'var(--color-warning)',
		'var(--color-info)',
		'var(--color-secondary)'
	]}
	grid={{ y: true, bandAlign: 'between' }}
	orientation="horizontal"
	labels={{
		placement,
		format: { type: 'day', options: { variant: 'short' } },
		fill: placement === 'inside' ? 'white' : undefined
	}}
	props={{
		xAxis: {
			format: 'month'
		},
		tooltip: {
			context: { mode: 'bounds' }
		}
	}}
	padding={defaultChartPadding({ left: 30 })}
	height={400}
>
	{#snippet tooltip({ context })}
		<Tooltip.Root>
			{#snippet children({ data })}
				<Tooltip.Header>{format(context.y(data))}</Tooltip.Header>
				<Tooltip.List>
					<Tooltip.Item label="Start" value={data.start} format="day" />
					<Tooltip.Item label="End" value={data.end} format="day" />
				</Tooltip.List>
			{/snippet}
		</Tooltip.Root>
	{/snippet}
</BarChart>


	export { data };

	let mainContext = $state<ChartState>();
</script>

<LineChart
	bind:context={mainContext}
	{data}
	x="date"
	y="value"
	yDomain={[0, null]}
	transform={{
		mode: 'domain',
		axis: 'x',
		scaleExtent: [1, 50],
		domainExtent: {
			x: { min: 'data', max: 'data', minRange: 7 * 24 * 60 * 60 * 1000 }
		}
	}}
	clip
	padding={defaultChartPadding({ left: 25, bottom: 24 })}
	height={300}
/>


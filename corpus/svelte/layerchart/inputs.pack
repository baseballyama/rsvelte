}

/** Whether two selections cover the same extent, from the same source */
function sameSelection(a: ChartGroupBrush, b: ChartGroupBrush) {
  return (
    a.source === b.source &&
    isEqualValue(a.x[0], b.x[0]) &&
    isEqualValue(a.x[1], b.x[1]) &&
    isEqualValue(a.y[0], b.y[0]) &&

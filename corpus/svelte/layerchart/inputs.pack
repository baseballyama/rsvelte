		<Chart
			{data}
			x="x"
			y="y"
			yNice
			brush={{
				axis: 'both',
				x: brushX as any,
				y: brushY as any,
				onChange: (e) => {
					xDomain = e.brush.x;
					yDomain = e.brush.y;
					brushX = e.brush.x;
					brushY = e.brush.y;
				}
			}}
		>
			{#snippet children({ context })}
				<Layer>
					<Points>
						{#snippet children({ points })}
							{#each points as point}
								{@const isSelected = context.brush.contains(point.data)}

								<Circle
									cx={point.x}
									cy={point.y}
									r={0.5}
									class={cls(
										isSelected
											? 'fill-primary/30 stroke-primary'
											: 'fill-surface-content/10 stroke-neutral'
									)}
									motion="spring"
								/>
							{/each}
						{/snippet}
					</Points>
				</Layer>
			{/snippet}
		</Chart>
	</div>
</div>


	</div>

	{#if config.isFiltered !== undefined}
		<div class="grid grid-cols-4 gap-2">
			<Field label="Apply Partial Filter" let:id>
				<Switch {id} bind:checked={config.isFiltered} />
			</Field>
		</div>
	{/if}
</div>


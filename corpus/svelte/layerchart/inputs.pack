        {...restProps}
        x1={line.x1}
        y1={line.y1}
        x2={line.x2}
        y2={line.y2}
        {stroke}
        class={cls(line.axis === 'x' ? 'lc-rule-x-line' : 'lc-rule-y-line', className)}
      />

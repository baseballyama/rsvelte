					variant="outline"
					size="sm"
					inset
					class="w-full"
				>
					<ToggleOption value="start">start</ToggleOption>
					<ToggleOption value="middle">middle</ToggleOption>
					<ToggleOption value="end">end</ToggleOption>
				</ToggleGroup>
			</Field>
			<TextField label="ellipsis" bind:value={config.truncateOptions.ellipsis} />
		{/if}
	</div>
</div>


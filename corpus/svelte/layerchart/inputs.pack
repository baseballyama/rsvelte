  const markerMidId = $derived(markerMid || marker ? createId('marker-mid', uid) : '');
  const markerEndId = $derived(markerEnd || marker ? createId('marker-end', uid) : '');

  c.chartCtx.registerComponent({
    name: 'Line',
    kind: 'mark',

    });

    expect(setLineDashSpy).toHaveBeenCalledWith([2, 2]);
  });

  it('does not apply strokeDasharray when value is "none"', () => {
    const setLineDashSpy = vi.spyOn(ctx, 'setLineDash');

    renderPathData(ctx, 'M0,0 L100,0', {
      styles: {
        fill: 'none',
        stroke: 'black',
        strokeDasharray: 'none',
        strokeOpacity: '1',

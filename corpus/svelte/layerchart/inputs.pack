				<Spline y="baseline" {curve} class="[stroke-dasharray:4]" />
				<Spline y="value" {curve} class="stroke-[1.5]" />
			{/snippet}

			{#snippet below({ curve })}
				<Area y0="value" y1="baseline" {curve} class="fill-danger/30" />
			{/snippet}
		</Threshold>
	{/snippet}
</AreaChart>


		const q3 = quantile(sorted, 0.75);
		const med = quantile(sorted, 0.5);
		const iqr = q3 - q1;
		const lowerFence = q1 - iqrMultiplier() * iqr;
		const upperFence = q3 + iqrMultiplier() * iqr;
		const outliers = [];

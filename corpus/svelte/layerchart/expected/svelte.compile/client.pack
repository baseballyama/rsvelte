			color: 'var(--color-info-500)'
		},

		{
			label: 'Latency (ms)',
			data: createDateSeries({ count: 40, min: 20, max: 180, value: 'integer' }),
			color: 'var(--color-warning-500)'
		},

		{
			label: 'Errors',
			data: createDateSeries({ count: 40, min: 0, max: 30, value: 'integer' }),
			color: 'var(--color-danger-500)'

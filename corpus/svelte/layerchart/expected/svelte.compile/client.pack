				r: 2.5,
				fill: 'var(--color-primary)',
				fillOpacity: 0.6
			});
		};

		Chart($$anchor, {
			get data() {
				return data;
			},
			x: 'flipper_length_mm',
			y: 'body_mass_g',
			fx: 'species',
			xNice: true,
			yNice: true,
			padding: { left: 52, bottom: 32, top: 24, right: 8 },
			height: 300,
			marks,
			$$slots: { marks: true }
		});
	}

	return $.pop($$exports);
}

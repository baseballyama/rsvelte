									},

									children: ($$anchor, $$slotProps) => {
										const nodeWidth = $.derived(() => $.get(node).x1 - $.get(node).x0);
										const nodeHeight = $.derived(() => $.get(node).y1 - $.get(node).y0);
										var fragment_5 = root();
										var node_2 = $.first_child(fragment_5);

										{

					},

					children: ($$anchor, $$slotProps) => {
						Layer($$anchor, {
							children: ($$anchor, $$slotProps) => {
								GeoPath($$anchor, {
									get geojson() {
										return $.get(geojson);
									},
									fill: 'white'
								});
							},
							$$slots: { default: true }
						});
					},
					$$slots: { default: true }

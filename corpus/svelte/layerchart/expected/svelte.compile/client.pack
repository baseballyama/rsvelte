			parts.forEach((part, i) => {
				currentPath = currentPath ? `${currentPath}/${part}` : part;

				const isLastPart = i === parts.length - 1;
				let existingNode = currentLevel.find((node) => node.name === part);

				if (!existingNode) {
					const newNode = {
						name: part,
						path: currentPath,
						open: isOpen && !isLastPart,
						children: []

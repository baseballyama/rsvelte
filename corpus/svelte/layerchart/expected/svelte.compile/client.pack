	let show = $.prop($$props, 'show', 15),
		label = $.prop($$props, 'label', 3, 'Show'),
		labelPlacement = $.prop($$props, 'labelPlacement', 3, 'left'),
		inline = $.prop($$props, 'inline', 3, false),

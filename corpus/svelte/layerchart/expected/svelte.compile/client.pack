import * as $ from 'svelte/internal/client';
import { Axis, Chart, Layer, defaultChartPadding } from 'layerchart';

import {
	timeDay,
	timeHour,
	timeMillisecond,
	timeMinute,
	timeMonth,
	timeSecond,
	timeYear

			domainExtent: {
				x: { min: 'data', max: 'data', minRange: 7 * 24 * 60 * 60 * 1000 }
			}
		}));

		let $1 = $.derived(() => defaultChartPadding({ left: 25, bottom: 24 }));

		LineChart(node, {
			get data() {
				return data;

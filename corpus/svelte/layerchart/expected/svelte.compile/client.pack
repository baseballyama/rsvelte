									innerRadius: -20,
									cornerRadius: 4,
									padAngle: 0.02,
									get fill() {
										return $.get(color);
									},
									class: 'hover:scale-90 origin-center [transform-box:fill-box] transition-transform',
									onpointermove: (e) => context().tooltip.show(e, $.get(color)),
									onpointerleave: () => context().tooltip.hide()

		var alternate = ($$anchor) => {
			EmptyMessage($$anchor, {
				class: 'h-full',
				children: ($$anchor, $$slotProps) => {
					$.next();

					var text_3 = $.text('Please specify a file');

					$.append($$anchor, text_3);
				},
				$$slots: { default: true }
			});
		};

		$.if(node_9, ($$render) => {
			if ($.get(geojson)) $$render(consequent); else $$render(alternate, -1);
		});
	}

	$.reset(div_3);
	$.reset(div);
	$.append($$anchor, div);

				$.append($$anchor, div_1);
			});

			$.reset(div);
			$.append($$anchor, div);
		};

		let $0 = $.derived(() => scaleOrdinal(
			[
				'<10',
				'10-19',
				'20-29',
				'30-39',
				'40-49',
				'50-59',
				'60-69',
				'70-79',
				'≥80'
			],
			schemeSpectral[10]
		));

		Legend($$anchor, {
			get scale() {
				return $.get($0);
			},
			title: 'Age (years)',
			children,
			$$slots: { default: true }
		});
	}

	$.pop();
}

										var fragment_5 = $.comment();
										var node_2 = $.first_child(fragment_5);

										{
											var consequent = ($$anchor) => {
												{
													let $0 = $.derived(() => groupColor($.get(node).group.toString()));

													Circle($$anchor, {
														get cx() {
															return $.get(node).x;
														},

														get cy() {
															return $.get(node).y;
														},

														get r() {
															return $.get(node).r;
														},

														get fill() {
															return $.get($0);
														}
													});

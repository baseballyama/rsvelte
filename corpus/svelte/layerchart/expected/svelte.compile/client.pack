								stroke: 'oklch(0.7 0.08 260)',
								strokeWidth: 1
							});

							var node_5 = $.sibling(node_4, 2);

							BoxPlot(node_5, {
								get data() {
									return $.get(item);
								},
								min: 'min',
								q1: 'q1',
								median: 'median',

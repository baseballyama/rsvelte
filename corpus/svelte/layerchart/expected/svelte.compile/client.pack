		{ label: 'bump-x', value: curveBumpX },
		{ label: 'catmull-rom', value: curveCatmullRom },
		{ label: 'monotone-x', value: curveMonotoneX }
	];

	const caps = ['round', 'butt'];

	const data = [
		{ x: 0, y: 1, r: 2 },
		{ x: 1, y: 3, r: 8 },
		{ x: 2, y: 0.5, r: 14 },
		{ x: 3, y: 2, r: 5 }

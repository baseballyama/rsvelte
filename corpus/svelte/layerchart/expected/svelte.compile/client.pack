								var fragment_5 = $.comment();
								var node_6 = $.first_child(fragment_5);

								$.each(node_6, 17, () => coordinates, $.index, ($$anchor, coords) => {
									{
										let $0 = $.derived(() => [$.get(coords)[0], $.get(coords)[1]]);

										GeoCircle($$anchor, {
											get center() {

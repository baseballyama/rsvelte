							});

							$.append($$anchor, fragment_1);
						},
						$$slots: { default: true }
					});
				},
				$$slots: { default: true }
			});

			var span = $.sibling(node, 2);
			var text_1 = $.only_child(span, true);

			$.reset(div_4);
			$.template_effect(() => $.set_text(text_1, $.get(curve).label));
			$.append($$anchor, div_4);
		});

		$.reset(div_3);
		$.reset(div_1);
		$.template_effect(() => $.set_text(text, cap));

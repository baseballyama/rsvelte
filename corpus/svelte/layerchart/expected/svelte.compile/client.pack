import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { Chart, Group, Layer, Rect, Text } from 'layerchart';
import { Treemap } from 'layerchart/hierarchy';
import { scaleOrdinal } from 'd3-scale';

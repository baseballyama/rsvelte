	'$$slots',
	'$$events',
	'$$legacy',
	'Group',
	'Rect',
	'Line',
	'Circle',
	'data',
	'min',
	'q1',
	'median',
	'q3',
	'max',
	'outliers',
	'values',
	'iqrMultiplier',
	'width',
	'capWidth',
	'radius',
	'outlierRadius',
	'fill',
	'fillOpacity',
	'stroke',
	'strokeWidth',
	'opacity',

						},
						$$slots: { default: true }
					});
				};

				let $0 = $.derived(() => ({
					x: xForce,
					y: yForce,
					collide: collideForce,
					charge: manyBodyForce.strength((d, i) => i ? 0 : -context().width * 2 / 3)
				}));

				let $1 = $.derived(() => ({ nodes: data }));

				ForceSimulation($$anchor, {
					get forces() {
						return $.get($0);
					},


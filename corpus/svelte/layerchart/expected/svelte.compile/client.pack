					var fragment_2 = $.comment();
					var node_1 = $.first_child(fragment_2);

					$.each(node_1, 16, () => unitOptions, (opt) => opt, ($$anchor, opt) => {
						ToggleOption($$anchor, {
							get value() {
								return opt;

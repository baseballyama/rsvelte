var root_1 = $.from_svg(`<g><!></g>`);
var root_2 = $.from_svg(`<!><!>`, 1);
var root_3 = $.from_html(`<!> <!> <!>`, 1);

export default function Basic($$anchor, $$props) {
	$.push($$props, true);


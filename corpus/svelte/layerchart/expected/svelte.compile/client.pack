var root = $.from_html(`<div><!></div>`);

export default function FileTree($$anchor, $$props) {
	$.push($$props, true);

	let selectedFile = $.prop($$props, 'selectedFile', 15, ''),
		openAllNodes = $.prop($$props, 'openAllNodes', 3, false),
		alphabetize = $.prop($$props, 'alphabetize', 3, true),

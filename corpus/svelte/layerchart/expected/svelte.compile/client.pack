			{ name: 'C', value: 800 },
			{ name: 'D', value: 700 },
			{ name: 'E', value: 600 },
			{ name: 'F', value: 500 },
			{ name: 'G', value: 400 },
			{ name: 'H', value: 300 },
			{ name: 'I', value: 200 },
			{ name: 'J', value: 100 },
			{ name: 'K', value: 100 }
		]
	}).sum((d) => {
		// @ts-expect-error
		return d.value;
	});

	const simpleOrdinalColor = scaleOrdinal(schemeSpectral[11].filter((c) => hsl(c).h < 60 || hsl(c).h > 90) // filter out hard to see yellow and green
	);
	var $$exports = { data };

	Chart($$anchor, {
		height: 400,
		children: ($$anchor, $$slotProps) => {

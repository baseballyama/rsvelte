			$.template_effect(($0) => $.set_text(text_6, `Wide data (property per series). ${$0 ?? ''} data points`), [() => format(data.cpu.length)]);
			$.append($$anchor, text_6);
		},
		$$slots: { default: true }
	});

	$.reset(div);
	$.append($$anchor, div);
	$.pop();
}

  @layer base {
    :where(.lc-path) {
      --fill-color: transparent;
      --stroke-color: var(--color-surface-content, currentColor);
    }

    :where(.lc-layout-svg .lc-path, svg.lc-path):not([fill]) {
      fill: var(--fill-color);
    }
    :where(.lc-layout-svg .lc-path, svg.lc-path):not([stroke]) {
      stroke: var(--stroke-color);
    }
  }


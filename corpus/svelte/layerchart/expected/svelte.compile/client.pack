import * as $ from 'svelte/internal/client';
import { Chart, Circle, Layer, RadialGradient } from 'layerchart';

var root = $.from_html(`<!> <!> <!>`, 1);

export default function Focal_location_and_radius_with_custom_colors($$anchor) {

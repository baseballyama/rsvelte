				Button($$anchor, {
					slot: 'item',
					base: true,
					class: 'px-2 py-1 rounded-sm',
					$$events: { click: () => $.set(selected, $.get(item), true) },
					children: $.invalid_default_snippet,
					$$slots: {
						default: ($$anchor, $$slotProps) => {

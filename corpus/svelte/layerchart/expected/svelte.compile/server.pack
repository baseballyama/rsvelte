			ShowControls($$renderer, {
				label: 'Show Bars',
				get show() {
					return show;
				},

				set show($$value) {
					show = $$value;
					$$settled = false;
				}
			});

			$$renderer.push(`<!----> `);

			Chart($$renderer, {
				data,
				x: 'date',
				xScale: scaleBand().padding(0.4),
				y: 'value',
				yDomain: [0, null],
				yNice: true,
				padding: { left: 24, bottom: 20, top: 8 },
				height: 300,
				children: ($$renderer) => {

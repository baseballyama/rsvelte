		AreaChart($$renderer, {
			data: data2,
			x: 'date',
			y: 'value',
			xDomain,
			brush: {
				onBrushEnd: (e) => {
					xDomain = e.brush.x;
					e.brush.reset();
				}
			},
			motion: { type: 'spring' },
			props: { xAxis: { tickMultiline: true } },
			padding: defaultChartPadding({ bottom: 30 }),
			height: 300
		});

		$$renderer.push(`<!----></div></div>`);
		$.bind_props($$props, { data });
	});
}

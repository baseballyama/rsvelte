						$$renderer.push(`<!--[-->`);

						const each_array_1 = $.ensure_array_like(Array(count));

						for (let i = 0, $$length = each_array_1.length; i < $$length; i++) {
							let _ = each_array_1[i];

							if (primitive === 'rect') {

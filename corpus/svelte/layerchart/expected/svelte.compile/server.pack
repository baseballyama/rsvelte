				yRange: ({ height }) => [height / 5, height / 2],
				c: 'category',
				cRange: [
					'var(--color-success)',
					'var(--color-danger)',
					'var(--color-warning)',
					'var(--color-info)',
					'var(--color-secondary)'
				],
				radial: true,
				orientation: 'horizontal',
				props: {
					xAxis: { format: 'month' },
					tooltip: { context: { mode: 'bounds' } }
				},
				padding: defaultChartPadding({ top: 15, bottom: 15 }),
				height: 400,
				tooltip,
				$$slots: { tooltip: true }
			});
		}


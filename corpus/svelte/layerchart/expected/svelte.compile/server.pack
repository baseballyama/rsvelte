				series: [
					{ key: 'svelte', label: 'Svelte', color: 'var(--color-danger)' },
					{
						key: 'sveltekit',
						label: 'SvelteKit',
						color: 'var(--color-surface-content)'
					},

					{
						key: 'ecosystem',
						label: 'Ecosystem',
						color: 'var(--color-info)'
					}
				],
				padding: { top: 24, bottom: 24 },
				xPadding: [50, 50],
				height: 360,

					$$settled = false;
				}
			});

			$$renderer.push(`<!----></div> `);

			PieChart($$renderer, {
				data,
				key: 'fruit',
				value: 'value',
				cRange: fruitColors,
				innerRadius: -40,
				padding: { top: 24, bottom: 24, left: 80, right: 80 },
				labels: {
					placement,
					offset,
					value: 'fruit',
					class: 'text-xs fill-surface-content'
				},
				height: 360
			});

			$$renderer.push(`<!---->`);
		}

		do {
			$$settled = true;
			$$inner_renderer = $$renderer.copy();
			$$render_inner($$inner_renderer);
		} while (!$$settled);

		$$renderer.subsume($$inner_renderer);
		$.bind_props($$props, { data });
	});
}

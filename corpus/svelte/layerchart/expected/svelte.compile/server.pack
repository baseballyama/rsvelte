				max: 100,
				value: 'integer',
				keys: ['value', 'baseline']
			}),

			...createTimeSeries({
				min: 20,
				max: 100,
				value: 'integer',
				keys: ['value', 'baseline']
			})
		];

		let settings = {
			mode: 'bounds',
			highlight: ['area'],

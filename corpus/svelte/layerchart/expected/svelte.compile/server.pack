=== 861 docs/src/examples/components/AnnotationRange/bar-chart-(multiple).svelte	js
import * as $ from 'svelte/internal/server';
import { AnnotationRange, BarChart } from 'layerchart';
import { createDateSeries } from '$lib/utils/data.js';

export default function Bar_chart__multiple_($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let { data } = $$props;

		const dateSeriesData = createDateSeries({
			count: 10,
			min: 20,
			max: 100,
			value: 'integer',
			keys: ['value', 'baseline']
		});

		{
			function belowMarks($$renderer, { context }) {
				AnnotationRange($$renderer, {
					x: [dateSeriesData[2].date, dateSeriesData[4].date],
					pattern: { size: 8, lines: { rotate: -45, opacity: 0.2 } }
				});
			}

			BarChart($$renderer, {
				data: dateSeriesData,
				x: 'date',
				y: 'value',
				height: 300,
				belowMarks,
				$$slots: { belowMarks: true }
			});
		}

		$.bind_props($$props, { data });
	});
}
=== 859 docs/src/examples/components/AnnotationRange/bar-chart-(single).svelte	js
import * as $ from 'svelte/internal/server';
import { AnnotationRange, BarChart } from 'layerchart';
import { createDateSeries } from '$lib/utils/data.js';

export default function Bar_chart__single_($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let { data } = $$props;

		const dateSeriesData = createDateSeries({
			count: 10,
			min: 20,
			max: 100,
			value: 'integer',
			keys: ['value', 'baseline']
		});

		{
			function belowMarks($$renderer, { context }) {
				AnnotationRange($$renderer, {
					x: [dateSeriesData[2].date, dateSeriesData[2].date],
					pattern: { size: 8, lines: { rotate: -45, opacity: 0.2 } }
				});
			}

			BarChart($$renderer, {
				data: dateSeriesData,
				x: 'date',
				y: 'value',
				height: 300,
				belowMarks,
				$$slots: { belowMarks: true }
			});
		}

		$.bind_props($$props, { data });

													color: context.cScale?.(d.fruit),
													format: 'integer',
													valueAlign: 'right'
												});

												$$renderer.push('<!--]-->');
											} else {
												$$renderer.push('<!--[!-->');
												$$renderer.push('<!--]-->');
											}
										}

										$$renderer.push(`<!--]--> `);

										if (Tooltip.Separator) {

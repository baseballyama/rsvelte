		watch.pre(() => staticProp, () => {
			// Any time the `static` prop gets toggled we
			// either attach or detach our internal event listeners:
			if (staticProp) {
				simulation.on('tick', null).on('end', null);
			} else {
				simulation.on('tick', onTick).on('end', onEnd);

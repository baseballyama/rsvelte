			{ shape: 'fill-success', content: 'fill-success-content' },
			{ shape: 'fill-warning', content: 'fill-warning-content' },
			{ shape: 'fill-danger', content: 'fill-danger-content' }
		];

		Chart($$renderer, {
			data,
			x: 'value',
			c: 'date',
			padding: 24,
			height: 400,

						y: dataY,
						r: radius,
						label: placement,
						labelPlacement: placement,
						labelXOffset: xOffset,
						labelYOffset: yOffset,
						labelX: placement === 'smart' ? ringX + xOffset : undefined,
						labelY: placement === 'smart' ? ringY + yOffset : undefined,
						fontSize,
						labelGap,

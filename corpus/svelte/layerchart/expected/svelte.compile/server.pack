import { watch } from 'runed';
import { forceSimulation } from 'd3-force';

export const DEFAULT_ALPHA = 1;
export const DEFAULT_ALPHA_TARGET = 0;
export const DEFAULT_ALPHA_DECAY = 1 - Math.pow(0.001, 1 / 300);

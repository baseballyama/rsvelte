import { Legend } from 'layerchart';
import { scaleSequential } from 'd3-scale';
import { interpolateViridis } from 'd3-scale-chromatic';

export default function Styling($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		Legend($$renderer, {

									Points($$renderer, { children, $$slots: { default: true } });
								}
							},
							$$slots: { default: true }
						});
					}

					Chart($$renderer, {
						data,
						x: 'x',
						y: 'y',
						yNice: true,
						brush: { axis: 'both', x: viewportX, y: viewportY },
						groupOptions: { publish: ['domain'], subscribe: ['pointer'] },
						children,
						$$slots: { default: true }
					});
				}

				$$renderer.push(`<!----></div></div>`);
			}

			ChartGroup($$renderer, {
				domain: { axis: 'both' },
				children,
				$$slots: { default: true }
			});
		}

		$.bind_props($$props, { data });
	});
}

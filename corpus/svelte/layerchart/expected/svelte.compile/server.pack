											$$renderer.push(`<!--[0-->${$.escape(data.node.name)}`);
										} else if (data.link) {
											$$renderer.push(`<!--[1-->${$.escape(data.link.source.name)} `);
											Icon($$renderer, { data: LucideArrowRight, class: 'text-white/50' });
											$$renderer.push(`<!----> ${$.escape(data.link.target.name)}`);
										} else {

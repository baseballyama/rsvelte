							children: ($$renderer) => {
								$$renderer.push(`<!---->${$.escape(data.fruit)}`);
							},
							$$slots: { default: true }
						});

						$$renderer.push('<!--]-->');
					} else {
						$$renderer.push('<!--[!-->');
						$$renderer.push('<!--]-->');
					}


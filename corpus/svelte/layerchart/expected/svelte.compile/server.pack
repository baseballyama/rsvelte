																		$$renderer.push(`<!----></g>`);
																	},
																	$$slots: { default: true }
																});
															},
															$$slots: { default: true }
														});
													}

													$$renderer.push(`<!--]-->`);
												}

												Partition($$renderer, {
													hierarchy,
													orientation: 'vertical',

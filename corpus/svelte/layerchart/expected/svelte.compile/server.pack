							} else if (primitive === 'text') {
								$$renderer.push('<!--[1-->');
								TextSvg($$renderer, { x: 10, y: 20, value: 'Hello', fill: 'steelblue' });
							} else {
								$$renderer.push('<!--[-1-->');
							}

							$$renderer.push(`<!--]-->`);
						}

						$$renderer.push(`<!--]-->`);
					},
					$$slots: { default: true }
				});
			},
			$$slots: { default: true }
		});
	} else if (mode === 'native-in-chart') {
		$$renderer.push('<!--[2-->');

		Chart($$renderer, {
			width: 500,
			height: 300,
			children: ($$renderer) => {

  @layer base {
    :where(.lc-text) {
      --fill-color: var(--color-surface-content, currentColor);
      --stroke-color: initial;
    }

    :where(.lc-text-svg) {
      overflow: visible;
      paint-order: stroke;
    }

    /* Svg | Canvas layers */
    :where(.lc-layout-svg .lc-text, svg.lc-text):not([fill]) {
      color: var(--fill-color);
      fill: currentColor;
    }
    :where(.lc-layout-svg .lc-text, svg.lc-text):not([stroke]) {
      stroke: var(--stroke-color);
    }
  }


										width: innerBoxWidth(),
										height: Math.abs(valueScale()(stats().q3) - valueScale()(stats().q1)),
										fill: 'currentColor',
										fillOpacity: 0.3,
										stroke: 'none',
										class: cls('lc-violin-box', className)
									});

									$$renderer.push('<!--]-->');
								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}
							} else {
								$$renderer.push('<!--[-1-->');

								if (Rect) {
									$$renderer.push('<!--[-->');

									Rect($$renderer, {
										x: Math.min(valueScale()(stats().q1), valueScale()(stats().q3)),
										y: categoryPos() - innerBoxWidth() / 2,
										width: Math.abs(valueScale()(stats().q3) - valueScale()(stats().q1)),
										height: innerBoxWidth(),
										fill: 'currentColor',
										fillOpacity: 0.3,
										stroke: 'none',
										class: cls('lc-violin-box', className)
									});

									$$renderer.push('<!--]-->');
								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}
							}

							$$renderer.push(`<!--]-->`);
						} else {
							$$renderer.push('<!--[-1-->');
						}

						$$renderer.push(`<!--]--> `);

						if (showMedian && stats()) {
							$$renderer.push('<!--[0-->');

							if (isVertical()) {
								$$renderer.push('<!--[0-->');

								if (Line) {
									$$renderer.push('<!--[-->');

									Line($$renderer, {

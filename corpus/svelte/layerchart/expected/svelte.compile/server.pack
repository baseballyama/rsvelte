		}

		$$renderer.push(`<!--]--> `);

		if (show.includes('scrollMode')) {
			$$renderer.push('<!--[0-->');

			Tooltip($$renderer, {
				title: 'Scroll mode',
				children: ($$renderer) => {
					MenuButton($$renderer, {
						iconOnly: true,
						options: [
							{ label: 'None', value: 'none', icon: LucideCircleOff },
							{ label: 'Zoom', value: 'scale', icon: LucideImageUpscale },
							{ label: 'Move', value: 'translate', icon: LucideMove }

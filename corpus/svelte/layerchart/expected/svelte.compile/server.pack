			Chart($$renderer, {
				transform: {
					mode: 'canvas',
					initialScale: 0.75,
					initialTranslate: { x: 0, y: -110 },
					scrollMode: 'scale',
					motion: { type: 'tween', duration: 800, easing: cubicOut }
				},
				clip: true,
				height: 700,
				children: ($$renderer) => {
					TransformContextControls($$renderer, {});
					$$renderer.push(`<!----> `);


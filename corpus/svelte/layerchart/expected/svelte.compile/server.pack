			TreeControls($$renderer, {
				datasetOptions,
				get config() {
					return config;
				},

				set config($$value) {
					config = $$value;
					$$settled = false;
				},

				get dataset() {
					return selectedDataset;
				},

				set dataset($$value) {
					selectedDataset = $$value;
					$$settled = false;
				}
			});

			$$renderer.push(`<!----> `);


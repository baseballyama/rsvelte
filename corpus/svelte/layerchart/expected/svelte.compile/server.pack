					$$settled = false;
				}
			});

			$$renderer.push(`<!----> `);

			SelectField($$renderer, {
				label: 'Color Scheme',
				options: colorSchemes.map((s) => ({ label: s.replace('interpolate', ''), value: s })),
				stepper: true,
				clearable: false,
				toggleIcon: null,
				class: 'col-span-full',
				get value() {
					return colorScheme;
				},

				set value($$value) {
					colorScheme = $$value;
					$$settled = false;

		});

		ModeWatcher($$renderer, {});
		$$renderer.push(`<!----> <main class="p-4"><div class="pb-4 text-right">`);

		Switch($$renderer, {
			checked: mode.current === 'dark',
			onCheckedChange: (checked) => setMode(checked ? 'dark' : 'light')
		});

		$$renderer.push(`<!----></div> `);
		children?.($$renderer);
		$$renderer.push(`<!----></main>`);
	});

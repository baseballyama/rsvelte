							$$renderer.push(`<!----> `);
							Graticule($$renderer, { class: 'stroke-surface-content/20' });
							$$renderer.push(`<!----> `);

							GeoPath($$renderer, {
								geojson: land(),
								curve,
								class: 'stroke-surface-content/50 fill-white'
							});

							$$renderer.push(`<!---->`);
						},
						$$slots: { default: true }
					});
				},
				$$slots: { default: true }

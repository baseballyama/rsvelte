							x: 'date',
							y: 'value',
							value: 'label',
							textAnchor: 'middle',
							dy: -8,
							fill: 'category',
							class: 'text-xs'
						});

						$$renderer.push(`<!---->`);
					},
					$$slots: { default: true }
				});
			},
			$$slots: { default: true }
		});
	});
}

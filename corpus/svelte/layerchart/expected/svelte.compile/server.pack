					{ label: 'lines', value: 'lines' },
					{ label: 'area', value: 'area' },
					{ label: 'bar', value: 'bar' }
				],
				formatSelected: ({ options }) => options.map((x) => x.label).join(', '),
				get value() {
					return settings.highlight;
				},


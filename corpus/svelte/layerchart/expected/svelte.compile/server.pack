import * as $ from 'svelte/internal/server';
import { Field, Switch } from 'svelte-ux';

import {
	Area,
	Axis,
	Chart,
	Layer,
	Highlight,
	Tooltip,
	defaultChartPadding
} from 'layerchart';

import { createDateSeries } from '$lib/utils/data.js';

export default function Portal_overflow($$renderer, $$props) {
	$$renderer.component(($$renderer) => {

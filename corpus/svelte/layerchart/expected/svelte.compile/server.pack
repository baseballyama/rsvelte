		let $$inner_renderer;

		function $$render_inner($$renderer) {
			$$renderer.push(`<div class="grid grid-cols-[1fr_1fr_1fr] gap-2 mb-2">`);

			RangeField($$renderer, {
				label: 'Value',
				min: 0,
				max: 100,
				step: 1,
				get value() {
					return value;
				},


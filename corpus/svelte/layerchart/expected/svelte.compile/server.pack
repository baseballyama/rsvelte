import * as $ from 'svelte/internal/server';
import { Area, Axis, Brush, Chart, Layer, defaultChartPadding } from 'layerchart';
import { Button, ButtonGroup } from 'svelte-ux';
import { getAppleStock } from '$lib/data.remote';


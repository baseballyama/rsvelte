							strokeWidth: 1 / context.transform.scale
						});

						$$renderer.push(`<!----> `);

						Circle($$renderer, {
							cx: 'longitude',
							cy: 'latitude',
							r: 1 / context.transform.scale,
							fill: 'currentColor'
						});

						$$renderer.push(`<!---->`);
					},
					$$slots: { default: true }
				});

				$$renderer.push(`<!----> `);

				Layer($$renderer, {
					children: ($$renderer) => {
						if (context.tooltip.data) {
							$$renderer.push('<!--[0-->');

							Circle($$renderer, {
								data: [context.tooltip.data],
								cx: 'longitude',
								cy: 'latitude',
								r: 4 / context.transform.scale,
								strokeWidth: 1 / context.transform.scale,
								class: 'stroke-surface-content/30 fill-surface-content/10 pointer-events-none',
								motion: 'spring'
							});
						} else {
							$$renderer.push('<!--[-1-->');
						}

						$$renderer.push(`<!--]-->`);
					},
					$$slots: { default: true }
				});

				$$renderer.push(`<!----> `);

				{
					function children($$renderer, { data }) {
						if (Tooltip.Header) {
							$$renderer.push('<!--[-->');

							Tooltip.Header($$renderer, {
								children: ($$renderer) => {

import * as $ from 'svelte/internal/server';
import { Chart, Waffle, Axis, Text } from 'layerchart';

export default function Survey($$renderer, $$props) {
	const data = [
		{ question: 'don’t go out after dark', yes: 96 },
		{ question: 'do no activities other than school', yes: 89 },
		{
			question: 'engage in political discussion and social movements, including online',
			yes: 10
		},

		{
			question: 'would like to do activities but are prevented by safety concerns',
			yes: 73
		}
	];

	const TOTAL = 120;

	$$renderer.push(`<div class="text-center mb-2"><h3 class="text-2xl font-bold">Subdued</h3> <p class="text-sm text-surface-content/60">Of 120 surveyed Syrian teenagers:</p></div> `);

	{
		function axis($$renderer, { context }) {
			Axis($$renderer, {
				placement: 'bottom',
				tickLength: 0,
				tickLabelProps: {
					width: (context.xScale.bandwidth?.() ?? 0) - 8,

											$$renderer.push(`<!----> `);

											if (labelRight - labelLeft > 24) {
												$$renderer.push('<!--[0-->');

												RectClipPath($$renderer, {
													x: labelLeft,
													width: labelRight - labelLeft - 4,
													height: barHeight,
													children: ($$renderer) => {
														Text($$renderer, {
															value: frame.name,
															x: labelLeft + 5,
															y: barHeight / 2,
															verticalAnchor: 'middle',
															class: 'text-[10px] fill-black pointer-events-none'
														});
													},
													$$slots: { default: true }
												});
											} else {
												$$renderer.push('<!--[-1-->');
											}

											$$renderer.push(`<!--]-->`);
										},
										$$slots: { default: true }
									});
								} else {
									$$renderer.push('<!--[-1-->');

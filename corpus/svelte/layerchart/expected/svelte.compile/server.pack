										$$renderer.push('<!--[-->');

										Tooltip.Item($$renderer, {
											label: 'start',
											value: data.startDate,
											format: { type: 'time', options: { variant: 'short' } }
										});

										$$renderer.push('<!--]-->');
									} else {
										$$renderer.push('<!--[!-->');
										$$renderer.push('<!--]-->');
									}

									$$renderer.push(` `);

									if (Tooltip.Item) {
										$$renderer.push('<!--[-->');

										Tooltip.Item($$renderer, {
											label: 'end',
											value: data.endDate,
											format: { type: 'time', options: { variant: 'short' } }
										});

										$$renderer.push('<!--]-->');
									} else {
										$$renderer.push('<!--[!-->');
										$$renderer.push('<!--]-->');
									}

									$$renderer.push(` `);

									if (Tooltip.Separator) {
										$$renderer.push('<!--[-->');
										Tooltip.Separator($$renderer, {});
										$$renderer.push('<!--]-->');
									} else {
										$$renderer.push('<!--[!-->');
										$$renderer.push('<!--]-->');
									}

									$$renderer.push(` `);

									if (Tooltip.Item) {
										$$renderer.push('<!--[-->');

										Tooltip.Item($$renderer, {
											label: 'duration',
											valueAlign: 'right',
											children: ($$renderer) => {
												Duration($$renderer, { start: data.startDate, end: data.endDate, totalUnits: 2 });
											},
											$$slots: { default: true }
										});


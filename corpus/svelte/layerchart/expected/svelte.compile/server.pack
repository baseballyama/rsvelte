			yNice: true,
			c: (d) => d.close < d.open ? 'desc' : 'asc',
			cDomain: ['desc', 'asc'],
			cRange: ['var(--color-danger)', 'var(--color-success)'],
			padding: { left: 20, bottom: 32, top: 20 },
			tooltipContext: { mode: 'quadtree-x' },
			height: 300,

		function marks($$renderer, { context }) {
			const bw = context.xScale.bandwidth?.() ?? 0;

			Waffle($$renderer, {
				y: () => TOTAL,
				fill: 'currentColor',
				fillOpacity: 0.2,
				rx: '100%',
				gap: 2

						$$renderer.push('<!--]-->');
					} else {
						$$renderer.push('<!--[!-->');
						$$renderer.push('<!--]-->');
					}
				}
			}

			LineChart($$renderer, {
				data,
				x: 'date',
				y: 'value',
				annotations: annotations().map((a) => {
					return {
						type: 'point',
						label: a.label,
						details: a.details,
						x: a.date,
						r: 6,
						props: {
							circle: { class: 'fill-secondary' },
							label: { class: 'text-[10px] fill-secondary-content font-bold' }
						}
					};
				}),
				padding: defaultChartPadding({ left: 30 }),
				height: 300,
				tooltip,
				$$slots: { tooltip: true }

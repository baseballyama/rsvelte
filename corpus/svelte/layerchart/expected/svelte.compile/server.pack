					}
				}
			}

			Chart($$renderer, {
				data,
				x: 'date',
				xNice: true,
				padding: { top: 12, bottom: 28, left: 12, right: 12 },
				height: 420,
				children,
				$$slots: { default: true }
			});
		}
	});
}

								$$renderer.push('<!--[2-->');
								Ellipse($$renderer, { cx: 30, cy: 30, rx: 20, ry: 10, fill: 'steelblue' });
							} else if (primitive === 'line') {
								$$renderer.push('<!--[3-->');

								Line($$renderer, {
									x1: 0,
									y1: 0,
									x2: 50,
									y2: 50,
									stroke: 'steelblue',
									strokeWidth: 2
								});
							} else if (primitive === 'group') {
								$$renderer.push('<!--[4-->');
								Group($$renderer, { x: 10, y: 10 });
							} else if (primitive === 'text') {
								$$renderer.push('<!--[5-->');
								Text($$renderer, { x: 10, y: 20, value: 'Hello', fill: 'steelblue' });
							} else if (primitive === 'path') {
								$$renderer.push('<!--[6-->');

								Path($$renderer, {
									pathData: 'M0,0 L50,50 L100,0 Z',
									fill: 'none',
									stroke: 'steelblue',
									strokeWidth: 2
								});
							} else {
								$$renderer.push('<!--[-1-->');
							}

							$$renderer.push(`<!--]-->`);
						}

						$$renderer.push(`<!--]-->`);
					},
					$$slots: { default: true }
				});
			},
			$$slots: { default: true }
		});
	} else if (mode === 'direct') {
		$$renderer.push('<!--[1-->');

		Chart($$renderer, {
			width: 500,
			height: 300,
			children: ($$renderer) => {
				Layer($$renderer, {

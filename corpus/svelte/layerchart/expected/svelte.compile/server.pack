								});

								$$renderer.push(`<!---->`);
							},
							$$slots: { default: true }
						});
					}

					$$renderer.push(`<!--]--> `);

					Text($$renderer, {
						data,
						x: () => 0,
						y: 'age',
						value: 'age',
						dy: (context.yScale.bandwidth?.() ?? 0) / 2,
						textAnchor: 'middle',
						verticalAnchor: 'middle',

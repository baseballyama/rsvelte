		const land = $.derived(() => feature(simplifiedGeojson(), topology.objects.land));

		const timer = new TimerState({
			delay: 1,
			tick: () => {
				if (!context) return;

				const curr = context.transform.translate;

				context.transform.translate = { x: curr.x += velocity, y: curr.y };

				label: 'Ticks',
				min: 1,
				max: 20,
				get value() {
					return tickCount;
				},

				set value($$value) {
					tickCount = $$value;
					$$settled = false;
				}
			});

			$$renderer.push(`<!----> `);

			RangeField($$renderer, {
				label: 'Inner Radius',
				min: 10,
				max: outerRadius - 2,
				get value() {
					return innerRadius;
				},

				set value($$value) {
					innerRadius = $$value;
					$$settled = false;
				}

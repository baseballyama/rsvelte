											delay: groupBy() ? 0 : 300
										},
										y: {
											type: 'tween',
											easing: cubicInOut,
											delay: groupBy() ? 300 : 0
										},
										width: {
											type: 'tween',
											easing: cubicInOut,
											delay: groupBy() ? 0 : 300
										},
										height: {

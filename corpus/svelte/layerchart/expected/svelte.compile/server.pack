			ranker: 'network-simplex',
			direction: 'top-bottom',
			align: 'none',
			nodeSeparation: 50,
			rankSeparation: 50,
			edgeSeparation: 10,
			edgeLabelPosition: 'center',
			edgeLabelOffset: 10,

			Waffle($$renderer, { fill: 'orange', rx: '100%', gap: 2 });
			$$renderer.push(`<!----> `);

			Text($$renderer, {
				data,
				x: 'question',
				dx: bw / 2,
				y: context.height + 8,
				value: (d) => `${Math.round(d.yes / TOTAL * 100)}%`,
				textAnchor: 'middle',
				verticalAnchor: 'start',
				class: 'text-xl font-bold',
				fill: 'orange'
			});

			$$renderer.push(`<!---->`);
		}

		Chart($$renderer, {
			data,
			x: 'question',
			bandPadding: 0.2,
			y: 'yes',
			yDomain: [0, TOTAL],
			height: 300,
			padding: { top: 8, bottom: 90, left: 0, right: 0 },
			grid: false,
			axis,
			marks,
			$$slots: { axis: true, marks: true }
		});
	}

	$$renderer.push(`<!---->`);
	$.bind_props($$props, { data });
}

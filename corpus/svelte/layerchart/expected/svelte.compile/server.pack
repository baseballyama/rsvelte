					y: [500, null],
					pattern: { size: 8, lines: { rotate: -45, opacity: 0.2 } }
				});

				$$renderer.push(`<!----> `);

				AnnotationLine($$renderer, {
					y: 500,
					label: 'Max',
					labelPlacement: 'bottom-right',
					labelYOffset: 2,

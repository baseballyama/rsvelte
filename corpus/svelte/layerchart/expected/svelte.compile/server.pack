									children: ($$renderer) => {
										Bars($$renderer, { strokeWidth: 1, class: 'fill-primary' });
									},
									$$slots: { default: true }
								});
							}

							Highlight($$renderer, { area, $$slots: { area: true } });
						}

						$$renderer.push(`<!---->`);
					},
					$$slots: { default: true }
				});

				$$renderer.push(`<!----> `);

				{
					function children($$renderer, { data }) {

			{ label: 'Inner', value: 'inner' },
			{ label: 'Middle', value: 'middle' },
			{ label: 'Outer', value: 'outer' }
		];

		let placement = 'callout';
		let offset = 0;
		const data = longData.filter((d) => d.year === 2019);

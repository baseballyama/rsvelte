												}

												$$renderer.push(`<!--]-->`);
											} else {
												$$renderer.push('<!--[-1-->');
											}

											$$renderer.push(`<!--]--> `);

											if (data.node.sourceLinks.length) {
												$$renderer.push('<!--[0-->');


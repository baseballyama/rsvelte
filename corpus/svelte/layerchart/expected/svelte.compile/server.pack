					$$settled = false;
				}
			});

			$$renderer.push(`<!----></div> `);

			Chart($$renderer, {
				geo: { projection: geoOrthographic, fitGeojson: { type: 'Sphere' } },
				transform: {
					mode: 'projection',
					constrain: ({ scale, translate }) => ({
						scale,

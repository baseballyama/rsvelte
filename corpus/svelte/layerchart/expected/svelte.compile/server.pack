		let paused = true;

		// MARK: Reactivity Effects
		watch.pre(() => stopped, () => {
			// Any time the `stopped` prop gets toggled we
			// update the running state of the simulation:
			if (stopped) {
				pauseDynamicSimulation();
			} else {

	} else {
		$$renderer.push(`<!--[-1--><svg${$.attr('width', 500)}${$.attr('height', 300)}><!--[-->`);

		const each_array_3 = $.ensure_array_like(Array(count));

		for (let i = 0, $$length = each_array_3.length; i < $$length; i++) {

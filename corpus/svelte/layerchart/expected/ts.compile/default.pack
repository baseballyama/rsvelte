    const clonedElements = Array.from(clone.querySelectorAll('*'));
    for (let i = 0; i < originalElements.length; i++) {
        const original = originalElements[i];
        const cloneEl = clonedElements[i];
        if (!(cloneEl instanceof SVGElement))
            continue;

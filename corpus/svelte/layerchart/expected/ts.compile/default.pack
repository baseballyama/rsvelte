        noExternal: isTest ? undefined : true,
        // Externalize packages not needed server-side to stay under
        // Cloudflare Workers' 25 MiB uncompressed size limit.
        external: [
            'satori',
            '@resvg/resvg-js',
            'shiki',
            '@shikijs/langs',
            '@shikijs/themes',
            '@napi-rs/canvas',
            'mathjs'
        ]
    }
});


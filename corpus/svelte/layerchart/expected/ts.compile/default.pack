    tooltipLabel(data) {
        const option = this.#ctx.props.facet?.tooltip ?? true;
        if (option === false)
            return undefined;
        if (typeof option === 'function')
            return option(data) ?? undefined;
        const parts = [this.x?.(data), this.y?.(data)].filter((v) => v != null);
        if (!parts.length)

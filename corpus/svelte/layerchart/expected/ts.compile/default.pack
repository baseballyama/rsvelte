        });
    });
    describe('snippets', () => {
        it('should render text inner, middle, outer Text children', async () => {
            render(TestHarness, {
                chartProps: {
                    height: 400,
                    padding: '50',
                },
                component: Arc,
                componentProps: {
                    ...defaultProps,
                    fill: 'blue',
                    value: 50,
                    innerRadius: 70,

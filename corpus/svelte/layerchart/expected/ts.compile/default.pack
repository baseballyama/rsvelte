/**
 * Individual components to measure in isolation.
 * Auto-extracted from the layerchart components index.
 */
const INDIVIDUAL_COMPONENTS = [
    'AnnotationLine',
    'AnnotationPoint',
    'AnnotationRange',
    'Arc',
    'ArcChart',
    'ArcLabel',
    'Area',
    'AreaChart',
    'Axis',
    'Bar',
    'BarChart',
    'Bars',
    'Blur',
    'Bounds',
    'BoxPlot',
    'BrushContext',
    'Calendar',
    'Canvas',
    'Cell',
    'Chart',
    'ChartClipPath',
    'ChartCore',
    'Chord',
    'Circle',
    'CircleClipPath',
    'CircleLegend',
    'ClipPath',
    'ColorRamp',
    'Contour',
    'Dagre',
    'Density',
    'Dodge',
    'Ellipse',
    'ForceSimulation',
    'Frame',
    'GeoCircle',
    'GeoClipPath',
    'GeoEdgeFade',
    'GeoLegend',
    'GeoPath',
    'GeoPoint',
    'GeoProjection',
    'GeoRaster',
    'GeoSpline',
    'GeoTile',
    'GeoVisible',
    'Graticule',
    'Grid',
    'Group',
    'Highlight',
    'Html',
    'Hull',
    'Image',
    'Labels',
    'Layer',
    'Legend',
    'Line',
    'LinearGradient',
    'LineChart',
    'Link',
    'Month',
    'MotionPath',
    'Pack',
    'Partition',
    'Path',
    'Pattern',
    'Pie',
    'PieChart',
    'Point',
    'Points',
    'Polygon',
    'RadialGradient',
    'Raster',
    'Rect',
    'RectClipPath',
    'Ribbon',
    'Rule',
    'Sankey',
    'ScatterChart',
    'Spline',
    'Svg',
    'Text',
    'Threshold',
    'TileImage',
    'Tooltip',
    'Trail',
    'TransformContext',
    'Tree',
    'Treemap',
    'Vector',
    'Violin',
    'Voronoi',
    'WebGL',
];
export function getScenarios(filter) {
    if (!filter)
        return scenarios;
    return scenarios.filter((s) => filter.includes(s.name));
}
export function getComponentScenarios(filter) {
    const components = filter
        ? INDIVIDUAL_COMPONENTS.filter((c) => filter.includes(c))
        : INDIVIDUAL_COMPONENTS;
    return components.map((name) => ({
        name: `component:${name}`,
        description: `Individual component: ${name}`,
        imports: [name],
    }));
}


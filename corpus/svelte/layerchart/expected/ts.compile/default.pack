    const capBias = verticalAnchor != null ? 0 : dirY > 0 ? capHeight / 2 : dirY < 0 ? -capHeight / 2 : 0;
    return {
        direction: { x: dirX, y: dirY },
        anchor: { x: anchorX, y: anchorY },

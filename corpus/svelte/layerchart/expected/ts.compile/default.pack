        grid.fill(NaN);
        return grid;
    }
    // Need at least 3 points for triangulation
    if (points.length < 3) {
        return interpolateNearest(points, width, height, grid);
    }
    switch (method) {
        case 'none':
            return interpolateNone(points, width, height, grid);
        case 'nearest':
            return interpolateNearest(points, width, height, grid);
        case 'barycentric':
            return interpolateBarycentric(points, width, height, grid);
        default:
            return interpolateBarycentric(points, width, height, grid);
    }
}

        it('clips to the panel, so a zoomed mark can`t bleed into its neighbour', async () => {
            // `ChartClipPath` renders inside the layer, so each panel gets its own — sized from
            // `ctx.width` / `height`, which are the panel's box
            render(ScatterChart, {

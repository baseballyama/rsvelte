        ny /= len;
        const x1L = p1.x - nx * r1, y1L = p1.y - ny * r1;
        const x1R = p1.x + nx * r1, y1R = p1.y + ny * r1;
        const x2L = p2.x - nx * r2, y2L = p2.y - ny * r2;
        const x2R = p2.x + nx * r2, y2R = p2.y + ny * r2;
        d += `M${x1L},${y1L}`;
        d += `L${x2L},${y2L}`;
        d += `A${r2},${r2},0,0,1,${x2R},${y2R}`;
        d += `L${x1R},${y1R}`;
        d += `A${r1},${r1},0,0,1,${x1L},${y1L}`;
        d += 'Z';
    }

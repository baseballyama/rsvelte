        .range([0, size])
        .paddingInner(domain.length > 1 ? padding : 0)
        .paddingOuter(0);
}
/** Distinct facet values, in the order given or the order they appear in the data */
export function facetDomain(rows, accessor, explicit) {
    if (explicit)
        return [...explicit];
    if (!accessor)
        return [];
    return unique(rows.map(accessor));
}


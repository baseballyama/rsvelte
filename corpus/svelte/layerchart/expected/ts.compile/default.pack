import { toTitleCase } from './string.js';
import { findScaleName } from './chart.js';
const indent = '    ';
function printObject(obj) {
    Object.entries(obj).forEach(([key, value]) => {
        console.log(`${indent}${key}:`, value);
    });
}
function getRgb(clr) {

            expect(state.seriesState.isDefaultSeries).toBe(false);
            expect(state.seriesState.series).toHaveLength(1);
            expect(state.seriesState.series[0].key).toBe('value');
            expect(state.seriesState.series[0].color).toBe('red');
            unregister();

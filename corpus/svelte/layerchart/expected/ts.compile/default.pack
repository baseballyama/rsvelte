            dirY = ay >= ax * 0.4 ? Math.sign(ddy) : 0;
        }
    }
    else if (labelPlacement !== 'center') {
        dirX = labelPlacement.includes('left') ? -1 : labelPlacement.includes('right') ? 1 : 0;
        dirY = labelPlacement.includes('top') ? -1 : labelPlacement.includes('bottom') ? 1 : 0;
    }

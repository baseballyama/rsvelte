    staticFill = $derived(typeof this.#props.fill === 'string' ? this.#props.fill : undefined);
    staticFillOpacity = $derived(typeof this.#props.fillOpacity === 'number' ? this.#props.fillOpacity : undefined);
    staticStroke = $derived(typeof this.#props.stroke === 'string' ? this.#props.stroke : undefined);
    staticStrokeWidth = $derived(typeof this.#props.strokeWidth === 'number' ? this.#props.strokeWidth : undefined);

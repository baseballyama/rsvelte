import { timeYear, timeDay, timeHour, timeMillisecond, timeMinute, timeSecond, timeTicks, utcDay, utcHour, utcMillisecond, utcMinute, utcSecond, utcYear, } from 'd3-time';
import { format, Duration, isLiteralObject, PeriodType, DateToken, } from '@layerstack/utils';
import { isScaleBand, isScaleTime, isScaleUtc } from './scales.svelte.js';
export function getDurationFormat(duration, options = {
    multiline: false,
}) {
    const { multiline = false, placement = 'bottom' } = options;
    return function (date, i) {
        let result = '';
        if (+duration >= +new Duration({ duration: { years: 1 } })) {
            // Year

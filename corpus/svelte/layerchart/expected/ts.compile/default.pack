            x instanceof Date ||
            x === true ||
            x === '$left' ||
            x === '$right' ||
            (isScaleBand(this.ctx.xScale) && this.ctx.xDomain.includes(x)));
    });
    singleY = $derived.by(() => {
        const y = this.#getProps().y;
        return (typeof y === 'number' ||
            y instanceof Date ||
            y === true ||
            y === '$bottom' ||
            y === '$top' ||
            (isScaleBand(this.ctx.yScale) && this.ctx.yDomain.includes(y)));
    });
    xRangeMinMax = $derived(extent(this.ctx.xRange));
    yRangeMinMax = $derived(extent(this.ctx.yRange));
    lines = $derived.by(() => {
        const props = this.#getProps();
        const x = props.x ?? false;
        const y = props.y ?? false;
        const xOffset = props.xOffset ?? 0;
        const yOffset = props.yOffset ?? 0;
        const strokeProp = props.stroke;
        const result = [];
        // Single x line
        if (this.singleX) {
            const _x = x === true || x === '$left'
                ? this.xRangeMinMax[0]
                : x === '$right'
                    ? this.xRangeMinMax[1]
                    : this.ctx.xScale(x) + xOffset;
            result.push({
                x1: _x,
                y1: this.ctx.yRange[0] || 0,
                x2: _x,
                y2: this.ctx.yRange[1] || 0,
                axis: 'x',
            });
        }
        // Single y line
        if (this.singleY) {
            const _y = y === true || y === '$bottom'
                ? this.yRangeMinMax[1]
                : y === '$top'
                    ? this.yRangeMinMax[0]
                    : this.ctx.yScale(y) + yOffset;
            result.push({
                x1: this.ctx.xRange[0] || 0,

export const getEarthquakes = prerender(async () => {
    const { fetch } = getRequestEvent();
    const data = await fetch('https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_week.geojson')
        .then((r) => r.json())
        .then((d) => d.features.map((f) => {
        const c = geoCentroid(f);
        return {
            place: f.properties.place,
            magnitude: f.properties.mag,
            longitude: c[0],
            latitude: c[1]
        };
    }));
    return data;
});

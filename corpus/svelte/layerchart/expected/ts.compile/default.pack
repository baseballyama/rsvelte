    id: Symbol('FallbackChart'),
    registerMark: () => () => {
        /* no-op */
    },
    registerComponent: (_options) => ({
        id: Symbol('noop'),
        kind: 'mark',
        name: 'noop',
        parent: null,
        children: [],
        insideCompositeMark: false,
    }),

        const out = [];
        for (let column = 0; column < columns.length; column++) {
            for (let row = 0; row < rows.length; row++) {
                const fx = columns[column];
                const fy = rows[row];
                const key = facetKey(fx, fy);
                const data = this.enabled ? (byKey.get(key) ?? []) : allRows;
                out.push({

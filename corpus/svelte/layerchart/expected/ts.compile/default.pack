            const yBandOffset = isScaleBand(this.ctx.yScale) ? this.ctx.yScale.bandwidth() / 2 : 0;
            for (const d of this.data) {
                const xValue = xAccessor(d);
                const yValue = yAccessor(d);
                const x1Value = Array.isArray(xValue)

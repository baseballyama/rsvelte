    it('xKey only', () => {
        const actual = groupStackData(testData, { xKey: 'year' });
        expect(actual.length).toEqual(4);
        expect(actual[0]).toEqual({
            year: 2019,
            keys: { year: 2019 },
            value: 7120,
            values: [0, 7120],
            data: testDataByYear.get(2019),
        });
    });

        y: 0,
        data: null,
        series: [],
        config: {},
        isHoveringTooltipArea: false,
        isHoveringTooltipContent: false,
        mode: 'manual',
        source: null,
        suppressed: false,
        show: () => { },
        hide: () => { },
    },
};

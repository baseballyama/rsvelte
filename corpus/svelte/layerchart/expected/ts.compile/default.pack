            { g: 'b', v: 1, w: 10, id: 'b1' },
            { g: 'b', v: 4, w: 40, id: 'b4' },
        ];
        function renderPaired(chartProps = {}, componentProps = {}) {
            let ctx = null;
            render(TestHarness, {
                component: Circle,
                chartProps: {
                    data: paired,
                    x: 'v',
                    y: 'w',
                    xDomain: [0, 5],
                    yDomain: [0, 50],
                    width: 400,
                    height: 300,
                    padding: 0,
                    fx: 'g',

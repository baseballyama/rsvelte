                const keyFn = props.key ?? defaultKey;
                const activeKeys = new Set();
                for (let i = 0; i < this.#resolvedData.length; i++) {
                    const d = this.#resolvedData[i];
                    const key = keyFn(d, i);
                    activeKeys.add(key);

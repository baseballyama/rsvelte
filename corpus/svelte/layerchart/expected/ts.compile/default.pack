        expect(resolveColorProp('color', data, null)).toBe('#ff0000');
    });
    it('returns undefined when function accessor returns undefined', () => {
        expect(resolveColorProp((d) => d.nonexistent, data, mockCScale)).toBeUndefined();
    });

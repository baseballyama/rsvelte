    curve?: ComponentProps<typeof CurveMenuField>["value"];
    cap: "round" | "butt";
    pointCount: number;
    showLine?: boolean;
    motion?: "tween" | "none";
  }

  interface Props {
    config?: TrailPlaygroundConfig;
  }


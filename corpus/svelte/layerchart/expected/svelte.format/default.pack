    () =>
      ({
        href,
        crossOrigin,
        class: className,
        opacity,
        x,
        y,
        width,
        height,
        r,
        rotate,
        initialX,
        initialY,
        initialWidth,
        initialHeight,
        data,
        key,
        motion,
        preserveAspectRatio,
        imageRendering,
        ...rest,
      }) as ImageProps,
  );


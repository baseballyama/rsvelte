      <ToggleGroup bind:value={config.motion} variant="outline" size="sm">
        <ToggleOption value="tween">tween</ToggleOption>
        <ToggleOption value="draw">draw</ToggleOption>
        <ToggleOption value="none">none</ToggleOption>
      </ToggleGroup>
    </Field>
  {/if}
</div>


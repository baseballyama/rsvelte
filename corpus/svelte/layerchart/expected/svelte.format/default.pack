    </h2>
    <div class="ml-2 border-l border-surface-content/10">
      {#each allUtils as util}
        {@render navItem({
          label: util.name,
          path: `/docs/utils/${util.slug}`,
        })}
      {/each}
    </div>
  </section>
</nav>


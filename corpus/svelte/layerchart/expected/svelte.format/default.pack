  {data}
  x="date"
  y="value"
  yDomain={[0, 100]}
  c="value"
  cScale={scaleThreshold()}
  cDomain={[50, 90]}
  cRange={[
    "var(--color-danger)",
    "var(--color-warning)",
    "var(--color-success)",

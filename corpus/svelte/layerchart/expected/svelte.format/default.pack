      props={{
        line: {
          dashArray: [4],
          stroke: "var(--color-success)",
          strokeOpacity: 0.5,
        },
      }}
    />
    <Circle cx="date" cy="value" r={4} fill="value" />
    <Text
      x="date"
      y="value"
      value="label"
      textAnchor="middle"
      dy={-8}
      fill="value"
      class="text-xs"
    />
  </Layer>
</Chart>


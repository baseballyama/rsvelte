<script lang="ts">
  import GeoPointBase from "./GeoPoint.base.svelte";
  import Circle from "../../Circle/Circle.canvas.svelte";
  import Group from "../../Group/Group.canvas.svelte";
  import type { GeoPointProps } from "./GeoPoint.shared.svelte.js";


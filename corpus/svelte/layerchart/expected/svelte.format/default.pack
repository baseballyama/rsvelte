        width: innerWidth,
        height: innerHeight,
        datum: item.data,
        color,
      })}
    </g>
  {/snippet}
  <Group
    x={item.tx}
    y={item.ty}
    class={cls("lc-waffle", className)}
    opacity={(opacity ?? 1) * c.seriesOpacity}
  >
    <Pattern
      width={item.cx}
      height={item.cy}
      rects={[

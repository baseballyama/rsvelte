=== 874 docs/src/examples/components/ClipPath/use-id.svelte	svelte
<script lang="ts">
  import { Chart, ClipPath, Frame, Layer, Pattern, Polygon } from "layerchart";
</script>

<Chart height={300}>
  {#snippet children({ context })}
    <Layer>
      <!-- Render the polygon once as a visible outline (and to define the shape by id) -->
      <Polygon
        id="star-shape"
        cx={context.width / 2}
        cy={context.height / 2}
        r={120}
        points={10}
        inset={0.5}
        class="fill-none stroke-2 stroke-surface-content"
      />

      <!-- Reference the same shape as a clip region via `useId` -->
      <Pattern size={6} lines={[{ rotate: 45 }, { rotate: -45 }]}>
        {#snippet children({ pattern })}
          <ClipPath useId="star-shape">
            <Frame fill={pattern} class="stroke-surface-content" />
          </ClipPath>
        {/snippet}
      </Pattern>
    </Layer>
  {/snippet}
</Chart>

=== 1099 docs/src/examples/components/ColorRamp/basic.svelte	svelte
<script lang="ts">
  import {
    interpolateRgb,
    interpolateLab,
    interpolateHclLong,
  } from "d3-interpolate";
  import * as d3chromatic from "d3-scale-chromatic";

  import { ColorRamp } from "layerchart";
  import { entries } from "@layerstack/utils";

  let width = $state("100%");
  let height = $state(20);

  const interpolators: [string, (value: number) => string][] = entries<
    any,
    any
  >(d3chromatic).filter(([key]) => key.startsWith("interpolate"));
  interpolators.push([
    `interpolateRgb('red', 'blue')`,
    interpolateRgb("red", "blue"),
  ]);
  interpolators.push([
    `interpolateLab('red', 'blue')`,
    interpolateLab("red", "blue"),
  ]);
  interpolators.push([
    `interpolateHclLong('red', 'blue')`,
    interpolateHclLong("red", "blue"),
  ]);
</script>

<div class="grid gap-4 h-100 overflow-auto pr-2">
  {#each interpolators as [name, interpolator]}
    <div>
      <div class="text-sm">{name}</div>
      <svg {width} {height}>
        <ColorRamp {interpolator} {width} {height} />
      </svg>
    </div>
  {/each}
  <div class="h-1"></div>
</div>


      {#snippet children({ items })}
        {#each items as { data: senator, x, y, r, index } (index)}
          <Circle
            data={[senator]}
            cx={x}
            cy={y}
            {r}
            fill="gender"
            class="stroke-surface-100"
            onpointermove={(e) => context.tooltip.show(e, senator)}
            onpointerleave={context.tooltip.hide}
          />
        {/each}
      {/snippet}

    "var(--color-apples)",
    "var(--color-bananas)",
    "var(--color-cherries)",
    "var(--color-grapes)",
  ]}
  props={{
    xAxis: { format: "none" },
    yAxis: { format: "metric" },
  }}
  height={300}
/>


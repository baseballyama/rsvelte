  export { data };
</script>

<Chart
  {data}
  x={(d) => d.date_of_birth.getFullYear()}
  xNice
  c="gender"
  cRange={["var(--color-info)", "var(--color-warning)"]}
  padding={{ bottom: 20, left: 12, right: 12 }}
  height={300}
  axis="x"
  props={{ xAxis: { format: "none" } }}
>

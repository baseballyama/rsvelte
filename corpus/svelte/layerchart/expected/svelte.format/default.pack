      key: year.toString(),
      data,
      color:
        year >= 2023 ? "var(--color-primary)" : "var(--color-surface-content)",
      props: { opacity: year === 2024 ? 1 : year === 2023 ? 0.5 : 0.1 },
    };
  })}
  padding={defaultChartPadding({ top: 15, bottom: 15 })}
  height={500}
/>


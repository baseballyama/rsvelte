      monthLabel={false}
      tooltip
    />
  </Layer>

  <Tooltip.Root>
    {#snippet children({ data })}
      <Tooltip.Header value={data.date} format="day" />

      {#if data.value != null}
        <Tooltip.List>
          <Tooltip.Item
            label="value"
            value={data.value}
            format="integer"
            valueAlign="right"
          />
        </Tooltip.List>
      {/if}
    {/snippet}
  </Tooltip.Root>
</Chart>


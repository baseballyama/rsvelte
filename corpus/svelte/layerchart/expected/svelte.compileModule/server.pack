		tree.queryInterval(l - padding, h + padding, (interval) => {
			const j = interval[2];
			const yj = packed[j] - y0;
			const dx = item.x - input[j].x;
			const dr = ri + input[j].rx + padding;
			const sq = dr * dr - dx * dx;

			if (sq >= 0) {
				const dy = Math.sqrt(sq);


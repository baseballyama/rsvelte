import * as $ from 'svelte/internal/server';

export class Settings {
	layer;
	debug;

	constructor(options = {}) {
		this.layer = options.layer ?? 'svg';
		this.debug = options.debug ?? false;
	}
}

export const defaultSettings = new Settings();

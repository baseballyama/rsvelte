						$.append($$anchor, span);
					},
					$$slots: { default: true }
				});
			});

			$.append($$anchor, fragment_1);
		},
		$$slots: { default: true }
	});

	var node_2 = $.sibling(node, 4);

	TextArea(node_2, {
		minRows: 4,
		maxRows: 40,
		get value() {
			return val;
		},

		set value($$value) {
			val = $$value;
		}
	});

	$.append($$anchor, fragment);
}

  body {
    font-family: Helvetica, Arial, sans-serif;
    color: rgba(116, 103, 103);
    margin: 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.3) transparent;
  }

  h1 h2 {
    color: #000;
  }

  p {
    color: #999;
    font-size: medium;
    padding-top: 1em;
    padding-bottom: 1em;
    font-style: italic;
  }

  .splitpanes__pane {
    justify-content: center;
    align-items: center;
    color: rgba(106, 106, 106, 0.6);
    display: flex;
    position: relative;
    font-size: 3em;
  }

  em.specs {
    font-size: 0.2em;
    line-height: 1;
    position: absolute;
    color: #bbb;
    bottom: 0.5em;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.5em;
  }

  /* additional styling to the code area */
  code.hljs {
    tab-size: 4;
  }

  .page-container.svelte-12qhfyh {
    display: table;
    font-size: 14px;
    width: 100%;
  }

  main.svelte-12qhfyh {
    max-width: 1150px;
    margin-left: auto;
    margin-right: auto;
    padding: 10px;
    overflow-x: auto;
  }

  .rtl-containers.svelte-12qhfyh .splitpanes {
    direction: rtl;
  }

  .toc-container-space.svelte-12qhfyh {
    display: none;

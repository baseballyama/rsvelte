  .toc-container.svelte-12qhfyh {
    display: flex;
    flex-flow: column-reverse nowrap;
    background: rgb(247, 250, 253);
    color: rgb(65, 65, 72);
  }

  .toc-head.svelte-12qhfyh {
    display: flex;
    flex-flow: row nowrap;
    gap: 8px;
    padding-left: 10px;
  }

  @media (min-width: 832px) {
    .page-container.svelte-12qhfyh {
      display: flex;
      flex-flow: row nowrap;
    }

    .toc-container-space.svelte-12qhfyh {
      display: block;
      min-width: 300px;
      width: 300px;
      height: 100vh;
      margin: auto 0;
    }

    main.svelte-12qhfyh {
      flex-grow: 1;
    }

    .toc-container.svelte-12qhfyh {
      flex-direction: column;
      position: fixed;
      left: 0;
      top: 0;
      width: 300px;

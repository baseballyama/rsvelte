						$$renderer.push(`<span>${$.escape(i + 1)}</span> <p>Double click splitter -></p>`);
					},
					$$slots: { default: true }
				});
			}

			$$renderer.push(`<!--]-->`);
		},
		$$slots: { default: true }
	});
}

=== 831 test/events.spec.ts	js
import { describe, it, expect, vi } from 'vitest';
import { getDatasetAtEvent, getElementAtEvent, getElementsAtEvent, } from '../src/utils/events.js';
function createMockChart() {
    return {
        getElementsAtEventForMode: vi.fn().mockReturnValue([]),
    };
}
describe('Event utilities', () => {
    const event = new MouseEvent('click');
    it.each([
        ['getDatasetAtEvent', getDatasetAtEvent, 'dataset'],
        ['getElementAtEvent', getElementAtEvent, 'nearest'],
        ['getElementsAtEvent', getElementsAtEvent, 'index'],
    ])('%s calls getElementsAtEventForMode with mode "%s"', (_name, fn, expectedMode) => {
        const chart = createMockChart();
        fn(chart, event);
        expect(chart.getElementsAtEventForMode).toHaveBeenCalledWith(event, expectedMode, { intersect: true }, false);
    });
});


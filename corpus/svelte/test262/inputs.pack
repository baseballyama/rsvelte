  first += 1;
  yield;
  second += 1;
};

var iterCount = 0;

for (let [...[,]] = g(); iterCount < 1; ) {
  assert.sameValue(first, 1);
  assert.sameValue(second, 1);

  iterCount += 1;
}

assert.sameValue(iterCount, 1, 'Iteration occurred as expected');


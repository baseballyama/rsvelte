Promise.all([
  import('./eval-rqstd-once_FIXTURE.js'),
  import('./eval-rqstd-once_FIXTURE.js'),
]).then(async () => {
  // Use await to serialize imports
  await import('./eval-rqstd-once_FIXTURE.js');
  await import('./eval-rqstd-once_FIXTURE.js');

  assert.sameValue(global.test262, 262, 'global property was defined');
}).then($DONE, $DONE);


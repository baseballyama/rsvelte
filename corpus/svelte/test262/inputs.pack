  throw new Test262Error('#7: ("aB" <= aa") === true');
}

//CHECK#8
if (("\uD7FF" <= "\u{10000}") !== true) {
  throw new Test262Error('#8: ("\\uD7FF" <= "\\u{10000}") === true');
}

//CHECK#9
if (("\uD800" <= "\uDC00") !== true) {
  throw new Test262Error('#9: ("\\uD800" <= "\\uDC00") === true');
}

//CHECK#10

}

//CHECK#2
if (("xy" <= "xx") !== false) {
  throw new Test262Error('#2: ("xy" <= "xx") === false');
}

//CHECK#3
if (("x" <= "y") !== true) {
  throw new Test262Error('#3: ("x" <= y") === true');
}

//CHECK#4

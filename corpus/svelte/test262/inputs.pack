/*---
es6id: 12.2.5
description: >
    computed property methods can call super methods
---*/

function ID(x) {
  return x;
}

var proto = {
  m() {
    return ' proto m';
  }
};
var object = {
  ['a']() { return 'a' + super.m(); },
  [ID('b')]() { return 'b' + super.m(); },
  [0]() { return '0' + super.m(); },
  [ID(1)]() { return '1' + super.m(); },
};


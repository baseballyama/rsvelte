/*---
es6id: 12.2.5
description: >
    computed property names can be numbers
---*/
var object = {
  [1.2]: 'A',
  [1e55]: 'B',
  [0.000001]: 'C',
  [-0]: 'D',
  [Infinity]: 'E',
  [-Infinity]: 'F',
  [NaN]: 'G',
};

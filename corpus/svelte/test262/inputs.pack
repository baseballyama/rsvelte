    LiteralPropertyName:
      IdentifierName
      ...

    Reserved Words

    A reserved word is an IdentifierName that cannot be used as an Identifier.

---*/


class C {
  default() { return 42; }
}

var obj = new C();

assert.sameValue(obj['default'](), 42, 'property exists');


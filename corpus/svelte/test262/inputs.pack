  throw new Test262Error('#5.1: 0 % Infinity === 0. Actual: ' + (0 % Infinity));
} else {
  if (1 / (0 % Number.POSITIVE_INFINITY) !== Number.POSITIVE_INFINITY) {
    throw new Test262Error('#5.2: 0 % Infinity === + 0. Actual: -0');
  }
}

//CHECK#6

}

//CHECK#7
if (-0 % Number.POSITIVE_INFINITY !== -0) {
  throw new Test262Error('#7.1: -0 % Infinity === 0. Actual: ' + (-0 % Infinity));
} else {
  if (1 / (-0 % Number.POSITIVE_INFINITY) !== Number.NEGATIVE_INFINITY) {
    throw new Test262Error('#7.2: -0 % Infinity === - 0. Actual: +0');

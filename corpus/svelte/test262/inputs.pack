  throw new Test262Error('#2: var object = new Object(); object.prop === undefined. Actual: ' + (object.prop));
}

//CHECK#3
this.y++;
if (isNaN(y) !== true) {
  throw new Test262Error('#3: this.y++; y === Not-a-Number. Actual: ' + (y));
}


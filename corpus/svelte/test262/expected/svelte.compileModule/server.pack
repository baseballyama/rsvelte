assert(!Object.prototype.hasOwnProperty.call(C.prototype, "b"), "b doesn't appear as an own property on C prototype");
assert(!Object.prototype.hasOwnProperty.call(C, "b"), "b doesn't appear as an own property on C constructor");

verifyProperty(c, "b", {

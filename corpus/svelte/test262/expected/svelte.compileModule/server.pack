	[10] = "meep";
	["not initialized"];
};

var c = new C();

assert.sameValue(c.m().next().value, 42);
assert(!Object.prototype.hasOwnProperty.call(c, "m"), "m doesn't appear as an own property on the C instance");
assert.sameValue(c.m, C.prototype.m);

			'data-mdsx-highlight': dataMdsxHighlight,
			'data-language': dataLanguage,
			$$slots,
			$$events,
			...rest
		} = $$props;

		function decodeBase64Url(s) {
			const pad = ('=').repeat((4 - s.length % 4) % 4);

			onclick,
			$$slots,
			$$events,
			...rest
		} = $$props;

		const skinState = useEmojiPickerSkinToneSelector({ previewEmoji: box.with(() => previewEmoji) });

		Button($$renderer, $.spread_props([
			rest, /* eslint-disable-line @typescript-eslint/no-explicit-any */
			{
				variant,
				size,

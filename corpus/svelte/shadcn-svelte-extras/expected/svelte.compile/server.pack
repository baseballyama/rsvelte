											function icon($$renderer, { name }) {
												if (name.endsWith('.svelte')) {
													$$renderer.push('<!--[0-->');

													if (Icons.Svelte) {
														$$renderer.push('<!--[-->');
														Icons.Svelte($$renderer, { class: 'size-4' });
														$$renderer.push('<!--]-->');

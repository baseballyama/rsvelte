			$$renderer.push(`<!--]--> `);
			YearSelect($$renderer);
			$$renderer.push(`<!---->`);
		} else {
			$$renderer.push(`<!--[-1-->${$.escape(formatMonth(month))} ${$.escape(formatYear(month))}`);
		}

		$$renderer.push(`<!--]-->`);

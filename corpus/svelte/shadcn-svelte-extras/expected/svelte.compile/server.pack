			diff: 'diff',
			javascript: 'javascript',
			js: 'javascript',
			json: 'json',
			svelte: 'svelte',
			text: 'text',
			plaintext: 'text',
			typescript: 'typescript',
			ts: 'typescript'
		};

		const lang = $.derived(() => {

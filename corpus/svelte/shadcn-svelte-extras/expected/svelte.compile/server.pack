import { cn } from '$lib/utils.js';
import { Skeleton } from '$lib/components/ui/skeleton/index.js';

export default function Sidebar_menu_skeleton($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let {
			ref = null,
			class: className,
			showIcon = false,
			children,
			$$slots,
			$$events,
			...restProps
		} = $$props;


							$$renderer.push('<!--[-->');

							DropdownMenu.Content($$renderer, {
								align,
								children: ($$renderer) => {
									if (DropdownMenu.RadioGroup) {
										$$renderer.push('<!--[-->');

										DropdownMenu.RadioGroup($$renderer, {
											onValueChange: onChange,
											get value() {

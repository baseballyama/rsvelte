												$$renderer.push('<!--]-->');
											}
										}

										if (EmojiPicker.Footer) {
											$$renderer.push('<!--[-->');

											EmojiPicker.Footer($$renderer, {
												class: 'flex max-w-full place-items-center gap-2 px-2',
												children,
												$$slots: { default: true }

=== 1093 src/lib/demos/meter.svelte	js
import * as $ from 'svelte/internal/server';
import { Meter } from '$lib/components/ui/meter';
import { cn } from '$lib/utils.js';
import { onMount } from 'svelte';
import { linear } from 'svelte/easing';
import { Tween } from 'svelte/motion';

export default function Meter_1($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		const LIMIT = 100;
		const usage = new Tween(0, { duration: 2500, easing: linear });

		onMount(() => {
			setTimeout(
				() => {
					usage.set(100);
				},
				500
			);
		});

		$$renderer.push(`<div class="w-[200px]"><div class="flex place-items-center justify-between text-sm"><span>Tokens</span> <span>${$.escape(usage.current.toFixed(0))}/100</span></div> `);

		Meter($$renderer, {
			class: cn('--meter-background:(var(--color-blue-500)) [&_div]:transition-colors [&_div]:transition-none', {
				'[--meter-background:var(--destructive)]!': usage.current === LIMIT,
				'[--meter-background:var(--color-orange-400)]': usage.current > LIMIT * 0.75
			}),
			value: usage.current,
			max: LIMIT
		});

		$$renderer.push(`<!----></div>`);
	});
}

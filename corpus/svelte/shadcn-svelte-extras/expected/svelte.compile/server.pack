											class: 'border-border bg-background relative rounded-md border',
											children: ($$renderer) => {
												$$renderer.push(`<!---->`);

												{
													$$renderer.push(`<iframe${$.attr('title', `Preview ${$.stringify(demo)}`)}${$.attr('src', `/demos/${demo}`)} loading="lazy" class="relative z-20 h-full w-full"></iframe>`);
												}

												$$renderer.push(`<!---->`);

															Sheet.Title($$renderer, {
																children: ($$renderer) => {
																	$$renderer.push(`<!---->Sidebar`);
																},
																$$slots: { default: true }
															});

															$$renderer.push('<!--]-->');
														} else {
															$$renderer.push('<!--[!-->');
															$$renderer.push('<!--]-->');
														}

														$$renderer.push(` `);

														if (Sheet.Description) {
															$$renderer.push('<!--[-->');

															Sheet.Description($$renderer, {
																children: ($$renderer) => {

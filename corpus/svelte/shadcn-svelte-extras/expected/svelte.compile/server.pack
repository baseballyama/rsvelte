						children: ($$renderer) => {
							if (Command.Empty) {
								$$renderer.push('<!--[-->');

								Command.Empty($$renderer, {
									class: 'absolute inset-0 flex place-items-center justify-center py-0',
									children: ($$renderer) => {
										$$renderer.push(`<!---->${$.escape(emptyMessage)}`);
									},
									$$slots: { default: true }
								});

								$$renderer.push('<!--]-->');
							} else {
								$$renderer.push('<!--[!-->');

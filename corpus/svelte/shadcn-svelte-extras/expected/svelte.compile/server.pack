									$$renderer.push('<!--]-->');
								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}
							},
							$$slots: { icon: true, default: true }
						});

						$$renderer.push('<!--]-->');
					} else {
						$$renderer.push('<!--[!-->');
						$$renderer.push('<!--]-->');
					}
				}

				$$renderer.push(` `);

				if (TreeView.Folder) {
					$$renderer.push('<!--[-->');

					TreeView.Folder($$renderer, {
						name: 'src',
						children: ($$renderer) => {
							if (TreeView.Folder) {
								$$renderer.push('<!--[-->');


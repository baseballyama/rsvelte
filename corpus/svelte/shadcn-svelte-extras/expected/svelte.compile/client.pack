		var alternate = ($$anchor) => {
			var div_1 = root_1();

			$.append($$anchor, div_1);
		};

		$.if(node, ($$render) => {
			if (isMac) $$render(consequent); else $$render(alternate, -1);
		});
	}

	$.append($$anchor, fragment);
}

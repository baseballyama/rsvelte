var root = $.from_html(`<div class="w-full p-6"><!></div>`);

export default function Tags_input_autocomplete_restricted($$anchor) {
	const suggestions = [
		'Svelte',
		'React',
		'Vue',
		'Angular',
		'Solid',
		'Ember',
		'Next.js',
		'Nuxt'
	];

	let value = $.state($.proxy([]));
	var div = root();
	var node = $.child(div);

	TagsInput(node, {
		placeholder: 'Select a framework',
		get suggestions() {
			return suggestions;
		},
		restrictToSuggestions: true,
		get value() {
			return $.get(value);
		},

		set value($$value) {
			$.set(value, $$value, true);
		}
	});

	$.reset(div);
	$.append($$anchor, div);
}

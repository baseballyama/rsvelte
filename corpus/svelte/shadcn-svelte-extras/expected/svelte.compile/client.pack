		}

		this.loading = true;

		this.options?.onConfirm().then(() => {
			this.open = false;
		}).finally(() => {
			this.loading = false;
		});
	}

	cancel() {
		this.options?.onCancel?.();
		this.open = false;
	}
}

const dialogState = new ConfirmDeleteDialogState();

export function confirmDelete(options) {
	if (options.skipConfirmation) {
		options.onConfirm();

		return;
	}

	dialogState.newConfirmation(options);
}


	let date = new SvelteDate();

	onDestroy(async () => {
		for (const file of $.get(files)) {
			URL.revokeObjectURL(await file.url);
		}
	});

	$.user_effect(() => {
		const interval = setInterval(
			() => {
				date.setTime(Date.now());
			},
			10
		);

		return () => {
			clearInterval(interval);
		};
	});

	var div = root_2();
	var node = $.child(div);

	{
		let $0 = $.derived(() => 3 * FileDropZone.MEGABYTE);


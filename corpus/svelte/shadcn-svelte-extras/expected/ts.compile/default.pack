import { UseClipboard } from '$lib/hooks/use-clipboard.svelte';
import { resolveCommand } from 'package-manager-detector/commands';
import { getContext, setContext } from 'svelte';
/** Stable keys for Svelte context (Symbol.for avoids duplicate-key issues from multiple `runed` copies). */
const ADD_PROVIDER_KEY = Symbol.for('shadcn-svelte-extras.add-provider');
const ADD_ROOT_KEY = Symbol.for('shadcn-svelte-extras.add-root');
export const AGENTS = ['pnpm', 'npm', 'yarn', 'bun'];
export const INSTALLERS = ['jsrepo', 'shadcn-svelte'];
class AddProviderState {
    opts;
    constructor(opts) {
        this.opts = opts;
    }
}
export function useAddProvider(opts) {
    return setContext(ADD_PROVIDER_KEY, new AddProviderState(opts));
}
function getAddProvider() {
    const ctx = getContext(ADD_PROVIDER_KEY);
    if (ctx === undefined) {
        throw new Error('Context "add-provider" not found');
    }
    return ctx;
}
class AddRootState {

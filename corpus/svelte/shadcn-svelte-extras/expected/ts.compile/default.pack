 * @param err Error of the result
 * @returns
 *
 * ## Usage
 *
 * ```ts
 * Err("I failed!");
 * ```
 *
 * ## Examples
 *
 * ```ts
 * const functionThatCanFail = (condition) => {
 * 	if (condition) {
 * 		Ok("Success")
 * 	}
 *
 * 	return Err("Failure");
 * }
 * ```
 */
const Err = (err) => {
    return new Result({ ok: false, err });
};
export { Ok, Err };


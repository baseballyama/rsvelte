                if (['$app/server', '$app/state', '$app/navigation'].includes(warning.specifier)) {
                    return;
                }
            }
            handler(warning);
        }
    },
    hooks: {
        after: async (args) => {
            if (args.command !== 'build')
                return;
            execSync('pnpm exec shadcn-svelte registry build', {
                cwd: args.options.cwd,
                stdio: 'inherit',
                env: process.env
            });
        }
    }
});


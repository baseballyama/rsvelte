        return this.triggerRef;
    }
    isLast = $derived.by(() => {
        return this.step === this.rootState.steps.length;
    });
    isFirst = $derived.by(() => {
        return this.step === 1;
    });
    state = $derived.by(() => {
        if (this.step < this.rootState.opts.step.current)

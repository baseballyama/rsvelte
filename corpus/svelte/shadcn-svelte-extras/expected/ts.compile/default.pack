=== 357 src/lib/docs/tags-input-custom-validate.ts	js
export const customValidate = (val, tags) => {
    // trim and convert to lowercase
    const transformed = val.trim().toLowerCase();
    // disallow empties
    if (transformed.length === 0)
        return undefined;
    // disallow duplicates
    if (tags.find((t) => transformed === t.toLowerCase()))
        return undefined;
    return transformed;
};


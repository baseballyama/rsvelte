import { hasFlag } from 'country-flag-icons';
let flagIcons = null;
export async function getFlag(country) {
    if (!country)
        return null;
    if (!hasFlag(country.iso2))
        return null;
    flagIcons ??= await import('country-flag-icons/string/3x2');
    return flagIcons[country.iso2] ?? null;
}


export function createStringProp({ description, required = false, bindable = false, defaultValue }) {
    return {
        type: 'string',
        description,
        required,
        bindable,
        defaultValue
    };
}
export function createNumberProp({ description, required = false, bindable = false, defaultValue }) {
    return {
        type: 'number',
        description,
        required,
        bindable,
        default: defaultValue?.toString()
    };
}
export function createBooleanProp({ description, required = false, bindable = false, defaultValue }) {
    return {
        type: 'boolean',
        description,
        required,
        bindable,
        defaultValue: defaultValue?.toString()
    };
}
export function createStringUnionProp({ type, description, required = false, bindable = false, defaultValue }) {
    return {
        type: 'enum',
        description,
        required,
        bindable,
        defaultValue,
        tooltip: type
    };
}
export function createNumberUnionProp({ type, description, required = false, bindable = false, defaultValue }) {
    return {
        type: 'enum',
        description,
        required,
        bindable,
        defaultValue,
        tooltip: type
    };
}
export function createDateProp({ description, required = false, bindable = false, defaultValue }) {
    return {
        type: 'date',
        description,
        required,
        bindable,
        defaultValue
    };
}
export function createFunctionProp({ description, required = false, type, defaultValue }) {
    return {
        type: 'function',
        description,
        required,
        tooltip: type,
        defaultValue
    };
}
export function createAnyProp({ description, required = false, bindable = false, type, tooltip, defaultValue }) {
    return {
        type,
        description,
        required,
        bindable,
        tooltip,
        defaultValue
    };
}
export function createComponentReference({ name, description, props, forwardTo }) {
    return {
        name,
        description,
        props,
        forwardTo
    };
}


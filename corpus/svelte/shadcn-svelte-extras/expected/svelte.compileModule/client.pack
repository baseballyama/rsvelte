						$.get(this.#animations)[i].opts.delay.current
					);
				}
			},
			this.opts.delay.current
		);
	}

	onComplete() {
		this.opts.onComplete.current?.();
		this.loop?.onComplete();
	}

	dispose() {
		clearTimeout(this.#timeout);
	}

	registerAnimation(animation) {
		$.get(this.#animations).push(animation);
	}
}


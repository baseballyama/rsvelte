export class TerminalSession {
	opts;
	loop;
	#animations = $.state($.proxy([]));
	#timeout;

	constructor(opts, loop) {
		this.opts = opts;
		this.loop = loop;
		this.onComplete = this.onComplete.bind(this);
	}

	play() {
		this.#timeout = setTimeout(
			() => {
				$.get(this.#animations).sort((a, b) => a.opts.delay.current - b.opts.delay.current);

				for (let i = 0; i < $.get(this.#animations).length; i++) {
					$.get(this.#animations)[i].timeout = setTimeout(
						() => {
							$.get(this.#animations)[i].play(this.opts.speed.current);

							// when the most delayed animation is complete call onComplete
							if (i === $.get(this.#animations).length - 1) {
								$.get(this.#animations)[i].onComplete = this.onComplete;
							}

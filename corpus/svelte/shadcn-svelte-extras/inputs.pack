					<span class="text-muted-foreground text-xs">
						The 2 commits from this branch will be rebased and added to the base branch.
					</span>
				</SplitButton.SelectAction>
			</SplitButton.SelectGroup>
		</SplitButton.SelectContent>
	</SplitButton.Select>
</SplitButton.Root>


	import * as Resizable from '$lib/components/ui/resizable';
	import * as Tabs from '$lib/components/ui/tabs';
	import { cn } from '$lib/utils';
	import { useDemoPreview } from './demo.svelte.js';
	import type { Snippet } from 'svelte';

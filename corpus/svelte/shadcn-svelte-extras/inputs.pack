	id="{uid}-code"
	value="code"
	class={cn('border-border rounded-md border', className)}
	{...rest}
></Tabs.Content>

<Portal to="#{uid}-code">
	{#await codeState.code then code}
		<Code.Root lang="svelte" {code} class="aspect-video border-none [&_pre]:aspect-video">
			<Code.CopyButton />
		</Code.Root>
	{/await}
</Portal>


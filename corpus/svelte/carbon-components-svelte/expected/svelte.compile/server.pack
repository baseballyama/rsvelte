							$$renderer.push(`<!----> `);

							Button($$renderer, {
								kind: 'tertiary',
								children: ($$renderer) => {
									$$renderer.push(`<!---->View next decade`);
								},
								$$slots: { default: true }
							});

							$$renderer.push(`<!---->`);
						},
						$$slots: { default: true }
					});

					$$renderer.push(`<!---->`);
				},
				$$slots: { default: true }
			});
		}

		do {

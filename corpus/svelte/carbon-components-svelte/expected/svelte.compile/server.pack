	let cbFillSelectedId = "orwell";
	let cbFillValue = "";
	let cbSwapItems = make();
	let cbSwapSelectedId = "orwell";
	let cbSwapValue = "George Orwell";
	let cbRemoveItems = make();
	let cbRemoveSelectedId = "orwell";

import { Button, Checkbox, CheckboxGroup, Stack } from "carbon-components-svelte";

export default function CheckboxGroupReactive($$renderer) {
	let selected = ["email"];
	let $$settled = true;
	let $$inner_renderer;

	function $$render_inner($$renderer) {
		Stack($$renderer, {
			inline: true,
			gap: 4,

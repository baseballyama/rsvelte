								$$renderer.push(`<!----> `);

								if (showAdminTab) {
									$$renderer.push('<!--[0-->');

									TabContent($$renderer, {
										children: ($$renderer) => {
											$$renderer.push(`<p>Admin panel for managing users and permissions.</p>`);
										},
										$$slots: { default: true }
									});
								} else {
									$$renderer.push('<!--[-1-->');
								}

								$$renderer.push(`<!--]--> `);

								if (showSettingsTab) {
									$$renderer.push('<!--[0-->');

									TabContent($$renderer, {
										children: ($$renderer) => {

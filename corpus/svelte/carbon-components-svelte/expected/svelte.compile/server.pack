					$$renderer.push(`<!--[0--><p>Last close trigger: <code>${$.escape(lastTrigger)}</code></p>`);
				} else {
					$$renderer.push('<!--[-1-->');
				}

				$$renderer.push(`<!--]-->`);
			},

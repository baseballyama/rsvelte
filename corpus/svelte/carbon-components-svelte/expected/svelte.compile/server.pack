	// make() returns a new array reference, like an async refetch.
	const make = () => [
		{ id: "austen", text: "Jane Austen" },
		{ id: "dickens", text: "Charles Dickens" },
		{ id: "orwell", text: "George Orwell" },
		{ id: "woolf", text: "Virginia Woolf" }
	];

	const makeWithoutOrwell = () => [
		{ id: "austen", text: "Jane Austen" },
		{ id: "dickens", text: "Charles Dickens" },
		{ id: "woolf", text: "Virginia Woolf" }
	];


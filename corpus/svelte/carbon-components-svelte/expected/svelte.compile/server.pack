								children: ($$renderer) => {
									$$renderer.push(`<!---->View all`);
								},
								$$slots: { default: true }
							});
						}
					}
				});

				$$renderer.push(`<!----> `);

				SearchMenuGroup($$renderer, {
					label: 'Catalog results',
					children: ($$renderer) => {
						$$renderer.push(`<!--[-->`);


			children: ($$renderer) => {
				$$renderer.push(`<!---->Toggle rows`);
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> `);

		DataTable($$renderer, {
			headers: [
				{ key: "name", value: "Name" },
				{ key: "rule", value: "Rule" }
			],
			rows,
			children: ($$renderer) => {
				FilterRowsCaller($$renderer, { searchValue: 'round' });
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!---->`);
	});
}

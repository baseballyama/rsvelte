					filter: true,
					children: ($$renderer) => {
						$$renderer.push(`<!---->${$.escape(tag.label)}`);
					},
					$$slots: { default: true }
				});
			}

			$$renderer.push(`<!--]-->`);
		},
		$$slots: { default: true }
	});
}

		}

		function viewNextDecade() {
			calendar?.changeYear(calendar.currentYear + 10);
		}

		let $$settled = true;
		let $$inner_renderer;

		function $$render_inner($$renderer) {
			Stack($$renderer, {
				gap: 4,

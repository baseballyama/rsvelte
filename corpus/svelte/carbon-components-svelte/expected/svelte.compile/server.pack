				portalMenu: true,
				labelText: 'Notification methods',
				label: 'Select methods...',
				items: [
					{ id: "0", text: "Slack" },
					{ id: "1", text: "Email" },
					{ id: "2", text: "Fax" }
				]
			});

			$$renderer.push(`<!---->`);
		},
		$$slots: { default: true }
	});
}

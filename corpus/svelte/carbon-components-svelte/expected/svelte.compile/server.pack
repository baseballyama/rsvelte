export default function VirtualizeItemHeight($$renderer) {
	const items = Array.from({ length: 10_000 }, (_, i) => ({
		id: i,
		text: `Item ${i + 1}`,
		description: `Description for item ${i + 1}`
	}));

	let selectedIds = [1000];
	let $$settled = true;
	let $$inner_renderer;


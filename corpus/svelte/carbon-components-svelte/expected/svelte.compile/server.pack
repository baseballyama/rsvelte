				});

				$$renderer.push(`<!---->`);
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <div data-testid="last-select">${$.escape(lastSelect)}</div> <div data-testid="last-submit">${$.escape(lastSubmit)}</div>`);
	}

	do {
		$$settled = true;
		$$inner_renderer = $$renderer.copy();

			children: ($$renderer) => {
				$$renderer.push(`<!---->Create account`);
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> `);

		Modal($$renderer, {
			modalHeading: 'Create account',
			primaryButtonText: 'Submit',
			secondaryButtonText: 'Cancel',
			hasForm: true,
			formId: 'account-form',
			get open() {
				return open;
			},

			set open($$value) {
				open = $$value;
				$$settled = false;
			},

			children: ($$renderer) => {

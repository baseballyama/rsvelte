			var div_1 = $.sibling(node, 2);
			var text_1 = $.sibling($.child(div_1));

			$.reset(div_1);
			$.template_effect(($0) => $.set_text(text_1, ` ${$0 ?? ''}`), [() => JSON.stringify(group)]);
			$.append($$anchor, fragment_1);
		},
		$$slots: { default: true }
	});
}

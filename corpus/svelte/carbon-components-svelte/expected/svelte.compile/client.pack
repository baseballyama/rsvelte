				}
			},

			children: ($$anchor, $$slotProps) => {
				$.next();

				var text = $.text('Clear (programmatic)');

				$.append($$anchor, text);
			},
			$$slots: { default: true }
		});
	}

	var node_2 = $.sibling(node_1, 2);

	{
		let $0 = $.derived(() => !files.length);

		Button(node_2, {
			kind: 'tertiary',
			get disabled() {
				return $.get($0);
			},
			$$events: { click: () => files = [] },
			children: ($$anchor, $$slotProps) => {
				$.next();

				var text_1 = $.text('Clear (two-way binding)');

				$.append($$anchor, text_1);
			},
			$$slots: { default: true }
		});
	}

	$.append($$anchor, fragment);
}

export default function TreeViewSlot($$anchor) {
	let activeId = 0;
	let selectedIds = [0, 7, 9];

	let nodes = [
		{ id: 0, text: "AI / Machine learning" },
		{
			id: 1,
			text: "Analytics",
			nodes: [

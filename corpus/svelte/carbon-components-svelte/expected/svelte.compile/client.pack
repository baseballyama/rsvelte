		},

		set selectedId($$value) {
			selectedId = $$value;
		}
	});

	var node_1 = $.sibling(node, 4);

	Button(node_1, {
		$$events: { click: () => selectedId = undefined },
		children: ($$anchor, $$slotProps) => {
			$.next();


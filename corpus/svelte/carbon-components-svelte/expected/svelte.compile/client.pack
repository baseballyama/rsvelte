		{ id: "1", name: "Row 1", port: 443 }
	];

	var fragment = root();
	var node = $.first_child(fragment);

	DataTable(node, {
		expandable: true,
		get headers() {
			return headers;
		},

		get rows() {
			return rows;
		}
	});

	var node_1 = $.sibling(node, 2);

	DataTable(node_1, {
		expandable: true,
		get headers() {
			return headers;
		},

		get rows() {
			return rows;
		}
	});

	$.append($$anchor, fragment);
}

						$.bubble_event.call(this, $$props, $$arg);
					}
				},

				children: ($$anchor, $$slotProps) => {
					DatePickerInput($$anchor, { labelText: 'Billing month', placeholder: 'mm/yyyy' });
				},
				$$slots: { default: true }
			});


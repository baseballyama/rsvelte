export default function TreeViewDuplicateIds_test($$anchor) {
	const nodes = [
		{
			id: 0,
			text: "Parent",
			nodes: [{ id: 1, text: "Child A" }, { id: 2, text: "Child B" }]
		}
	];

	var fragment = root();
	var node_1 = $.first_child(fragment);


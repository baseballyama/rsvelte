		{ id: "dickens", text: "Charles Dickens" },
		{ id: "woolf", text: "Virginia Woolf" }
	];

	// Drops a non-selected option (austen) while keeping the selected one (orwell).
	const makeWithoutAusten = () => [
		{ id: "dickens", text: "Charles Dickens" },
		{ id: "orwell", text: "George Orwell" },
		{ id: "woolf", text: "Virginia Woolf" }
	];


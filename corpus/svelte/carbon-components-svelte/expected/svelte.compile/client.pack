			$$slots: {
				error: ($$anchor, $$slotProps) => {
					Button($$anchor, {
						kind: 'ghost',
						$$events: { click: () => imageLoader.loadImage(src) },
						children: ($$anchor, $$slotProps) => {
							$.next();

							var text_1 = $.text('Error. Try again');

							$.append($$anchor, text_1);
						},
						$$slots: { default: true }
					});
				}
			}
		}),
		($$value) => imageLoader = $$value,
		() => imageLoader
	);

	$.append($$anchor, fragment);
}

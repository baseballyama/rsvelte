				$.template_effect(() => {
					$.set_text(text, $.get(item).text);

					$.set_text(text_1, `id: ${$.get(item).id ?? ''} - index: ${$.get(index) ?? ''} - selected: ${$.get(selected) ?? ''} - highlighted:

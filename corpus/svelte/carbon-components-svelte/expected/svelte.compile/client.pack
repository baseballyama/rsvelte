		children: $.invalid_default_snippet,
		$$slots: {
			default: ($$anchor, $$slotProps) => {
				const node = $.derived(() => $$slotProps.node);

				$.next();

				var text = $.text();

				$.template_effect(() => $.set_text(text, $.get(node).text));
				$.append($$anchor, text);
			}
		}
	});

	var node_2 = $.sibling(node_1, 2);


				files = $$value;
			},

			$$events: {
				change: (e) => {
					console.log("change", e.detail);
				},

				clear: () => {
					console.log("clear");
				}
			}
		}),
		($$value) => fileUploader = $$value,
		() => fileUploader
	);

	var node_1 = $.sibling(node, 4);

	{
		let $0 = $.derived(() => !files.length);

		Button(node_1, {
			kind: 'tertiary',
			get disabled() {
				return $.get($0);
			},

			$$events: {
				click: function (...$$args) {

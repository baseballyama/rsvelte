					$.next();

					var text = $.text('Open modal');

					$.append($$anchor, text);
				},
				$$slots: { default: true }
			});

			$.reset(div);

			var node_1 = $.sibling(div, 2);

			Portal(node_1, {
				children: ($$anchor, $$slotProps) => {
					ComposedModal($$anchor, {
						get open() {

		get maxDate() {
			return end;
		},

		$$events: {
			change: function ($$arg) {
				$.bubble_event.call(this, $$props, $$arg);
			}
		},

		children: ($$anchor, $$slotProps) => {
			DatePickerInput($$anchor, { labelText: 'Date (2025 only)', placeholder: 'mm/dd/yyyy' });
		},
		$$slots: { default: true }
	});

	$.pop();
}

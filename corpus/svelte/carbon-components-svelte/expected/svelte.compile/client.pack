		labelText: 'Second',
		get nodes() {
			return nodes;
		},
		expandedIds: [0],
		children: $.invalid_default_snippet,
		$$slots: {
			default: ($$anchor, $$slotProps) => {
				const node = $.derived(() => $$slotProps.node);


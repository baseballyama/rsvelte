    await page
      .getByRole("checkbox", { name: "Option A" })
      .click({ force: true });
    await expect(page.getByTestId("selected-values")).toContainText("a");

    await page
      .getByRole("checkbox", { name: "Option A" })
      .click({ force: true });
    await expect(page.getByTestId("selected-values")).not.toBeVisible();
  });
});


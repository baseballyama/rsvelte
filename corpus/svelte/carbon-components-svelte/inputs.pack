  it("should handle direction prop", () => {
    render(Dropdown, {
      props: {
        items,
        selectedId: "0",
        direction: "top",
      },
    });

    const dropdown = screen.getByRole("combobox").closest(".bx--dropdown");
    expect(dropdown).toHaveClass("bx--list-box--up");

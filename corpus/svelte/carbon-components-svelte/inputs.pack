  import { DataTable } from "carbon-components-svelte";

  const headers = [
    { key: "name", value: "Name" },
    { key: "value", value: "Value" },
  ];

  const rows = Array.from({ length: 80 }, (_, i) => ({
    id: i,
    name: `Row ${i}`,

    name: `Server instance ${i + 1}`,
    rule: i % 2 ? "Round!" : "DNS!",
  }));

  let rows: typeof initialRows = initialRows;
</script>

<Button on:click={() => (rows = toggledRows)}>Toggle rows</Button>

<DataTable
  headers={[
    { key: "name", value: "Name" },
    { key: "rule", value: "Rule" },
  ]}
  {rows}
>
  <FilterRowsCaller searchValue="round" />
</DataTable>


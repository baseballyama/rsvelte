      // Pick a year that is always in the initial decade grid (decadeStart - 1
      // through decadeStart + 10), avoiding the current year cell when possible.
      const targetYear = String(currentDecadeStart + 3);

      render(DatePicker, {
        datePickerType: "year",
        dateFormat: "Y",

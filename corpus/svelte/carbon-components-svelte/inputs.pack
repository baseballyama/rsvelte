  });

  test("renders with legend", async ({ page }) => {
    await expect(
      page.getByRole("group", { name: "Choose options" }),
    ).toBeVisible();
  });

  test("selects multiple checkboxes", async ({ page }) => {
    await page
      .getByRole("checkbox", { name: "Option A" })

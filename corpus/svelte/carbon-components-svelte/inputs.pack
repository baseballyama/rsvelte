    render(Dropdown, {
      props: {
        items,
        selectedId: "0",
        open: true,
      },
    });

    expect(screen.getByRole("listbox")).toBeVisible();

    const event = new Event("click", { bubbles: true });
    Object.defineProperty(event, "target", { value: null });
    window.dispatchEvent(event);

    expect(screen.getByRole("listbox")).toBeVisible();

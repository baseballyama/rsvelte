    <FloatingPortal
      anchor={anchorStart}
      open={openStart}
      intrinsicWidth={true}
      intrinsicAlign="start"
    >
      <Tile>Align start</Tile>
    </FloatingPortal>
  </div>

  <div>
    <div bind:this={anchorCenter}>
      <Button on:click={() => (openCenter = !openCenter)}>Center</Button>
    </div>
    <FloatingPortal
      anchor={anchorCenter}
      open={openCenter}
      intrinsicWidth={true}
      intrinsicAlign="center"
    >
      <Tile>Align center</Tile>
    </FloatingPortal>
  </div>

  <div>
    <div bind:this={anchorEnd}>
      <Button on:click={() => (openEnd = !openEnd)}>End</Button>
    </div>
    <FloatingPortal
      anchor={anchorEnd}
      open={openEnd}
      intrinsicWidth={true}
      intrinsicAlign="end"
    >
      <Tile>Align end</Tile>
    </FloatingPortal>
  </div>
</div>


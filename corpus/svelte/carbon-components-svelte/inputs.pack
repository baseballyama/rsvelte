    const tableRows = screen
      .getAllByRole("row")
      .filter((row) => row.closest("tbody") !== null);
    const firstRow = tableRows[0];
    const _emptyCell = within(firstRow).getAllByRole("cell").slice(-1)[0];

    // Click on the row but not on an interactive element

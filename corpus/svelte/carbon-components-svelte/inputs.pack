  import {
    FileUploaderDropContainer,
    FileUploaderItem,
    Stack,
  } from "carbon-components-svelte";

  let files = [];
  let rejectedFiles = [];
</script>

<Stack gap={2}>
  <FileUploaderDropContainer
    multiple
    maxFileSize={1024}
    preventDuplicate
    labelText="Drag and drop files here or click to upload"
    bind:files
    on:rejected={(e) => {

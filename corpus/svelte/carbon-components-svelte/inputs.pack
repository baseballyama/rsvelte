          name: "Dept A",
          level3: {
            name: "Team A",
            level4: {
              name: "Project A",
              level5: {
                name: "Subproject A",
              },
            },
          },
        },
      },
    },
    {
      id: "2",
      level1: {
        name: "Org B",
        level2: {
          name: "Dept B",
          level3: {
            name: "Team B",
            level4: {
              name: "Project B",
              level5: {
                name: "Subproject B",
              },
            },
          },
        },
      },
    },
    {
      id: "3",
      level1: {
        name: "Org C",
        level2: {
          name: "Dept C",
          level3: {
            name: "Team C",
            level4: {
              name: "Project C",
              level5: {
                name: "Subproject C",
              },
            },
          },
        },
      },
    },
  ];
</script>


  it("prevents closing when preventDefault is called on close event", async () => {
    const closeHandler = vi.fn((e) => {
      e.preventDefault();
    });
    const { container } = render(ComposedModalTest, {
      props: {
        open: true,
        headerTitle: "Prevent Close Test",
        onclose: closeHandler,
      },
    });


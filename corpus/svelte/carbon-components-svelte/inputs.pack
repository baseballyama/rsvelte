      expect(
        screen.getByRole("group", { name: "Density" }),
      ).toBeInTheDocument();
      expect(
        screen.getByRole("menuitemradio", { name: "Compact" }),
      ).toHaveAttribute("aria-checked", "false");
      expect(
        screen.getByRole("menuitemradio", { name: "Comfortable" }),

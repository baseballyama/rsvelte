"use strict";

async function* saverGen() {
	let pending = [];

	while (true) {
		const p = yield;

		if (p != null) pending.push(p); else {
			const results = await Promise.all(pending);

			pending = [];
			console.log('Storing...');
			await storeResults(results);
		}
	}
}

function storeResults(results) {
	console.log(results);

	return Promise.resolve();
}


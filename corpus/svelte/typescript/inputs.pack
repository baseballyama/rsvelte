function f3(obj: Thing, key: keyof Thing) {
    if (obj[key] !== undefined) {
        if (typeof obj[key] === "string") {
            obj[key].toUpperCase();
        }
        if (typeof obj[key] === "number") {
            obj[key].toFixed();
        }
    }
}


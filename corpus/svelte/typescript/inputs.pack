    }

    interface Base2 { // T
        // M's
        (x: 'a'): number;
        (x: string): number;
    }

    // S's
    interface I2 extends Base2 {
        // N's
        (x: 'a'): string;
        (x: string): string; // error because base returns non-void;
    }

    // S's

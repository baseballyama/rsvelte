          class="inline-flex items-center rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors"
        >
          {s("settings.sync.notLoggedIn.signIn") || "Sign In"}
        </a>
      </div>
    </div>
  {/if}
</div>

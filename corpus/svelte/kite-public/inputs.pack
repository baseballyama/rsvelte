// Detect ?view=chaos on initial page load
if (browser && page.url.searchParams.get('view') === 'chaos') {
	state.chaosModalOpen = true;
}

// Helper functions
const parseInitialUrl = (): NavigationParams => {
	if (!browser) return {};

      class="flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap {value
        ? 'font-medium'
        : 'text-gray-500 dark:text-gray-400'}"
    >
      {#if selectedOption?.icon}
        {@const IconComponent = selectedOption.icon}

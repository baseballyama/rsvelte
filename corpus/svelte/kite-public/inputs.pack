      <div class="text-sm font-medium text-blue-600 dark:text-blue-400">
        {dateDisplay}
      </div>
      <button
        onclick={async () => {
          timeTravel.reset();
          timeTravelBatch.clear();
          isExitingTimeTravel = true;
          try {
            await dataReloadService.reloadData();

					>
						3
					</div>
					<div>
						<h3
							class="text-sm font-semibold text-primary"
						>
							{s('contribute.onboarding.pipeline.step3.title')}
						</h3>
						<p
							class="text-sm text-primary-600 leading-relaxed"

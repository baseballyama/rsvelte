                                : "text-purple-400/70 dark:text-purple-400/80"}
                          >
                            ({option.gender})
                          </span>
                        {/if}
                      </span>
                    </button>
                    {/if}
                  {/if}
                {/each}
              {/if}
            </div>
          </OverlayScrollbarsComponent>
        </div>
      </div>
    </Portal>
  {/if}
</div>

<style>
  /* clears the 'X' from Internet Explorer */
  input[type="search"]::-ms-clear {
    display: none;
    width: 0;
    height: 0;
  }
  input[type="search"]::-ms-reveal {
    display: none;
    width: 0;

		state.temporaryCategory = null;
		state.showTemporaryCategoryTooltip = false;
	},
}));

// Story toggle handler
const storyToggle = useStoryToggle(
	() => state.expandedStories,
	(value) => {
		state.expandedStories = value;
	},
	() => state.readStories,
	(value) => {
		state.readStories = value;

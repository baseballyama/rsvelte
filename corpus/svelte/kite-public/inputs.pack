              </div>
            {:else}
              <div class="rounded-lg bg-gray-50 dark:bg-gray-800/50 p-3">
                <div class="grid grid-cols-7 gap-1">
                  <!-- Weekday Headers -->
                  {#each weekdayHeaders as day}

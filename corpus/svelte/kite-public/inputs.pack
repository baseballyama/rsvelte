					{s('keyboard.help.title')}
				</h1>
				<p class="text-sm text-gray-600 dark:text-gray-400">
					{@html s('keyboard.help.closeInstructions', {
						key1: '<kbd class="kbd-key-small">?</kbd>',
						key2: '<kbd class="kbd-key-small">Esc</kbd>'
					})}
				</p>
			</div>

			<!-- Sections -->

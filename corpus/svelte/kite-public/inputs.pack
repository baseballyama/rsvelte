                          dir="auto"
                        >
                          {mediaInfo?.owner ||
                            s("source.info.notSpecified") ||
                            "Not specified"}
                        </div>
                      </div>
                    </div>

                    <!-- Organization -->
                    <div class="flex items-start gap-3">
                      <div class="flex-shrink-0 mt-0.5">
                        <IconBuilding class="h-5 w-5 text-gray-500" />
                      </div>
                      <div class="min-w-0 flex-1">
                        <div

    color: #1abc9c;
  } /* teal */
  :global(.topic-color-6) {
    color: #e91e63;
  } /* pink */
  :global(.topic-color-7) {
    color: #3f51b5;
  } /* indigo */
  :global(.topic-color-8) {
    color: #ff9800;
  } /* amber */

  /* Dark mode variants - optimized for better contrast and distinctness */
  :global(.dark .topic-color-0) {
    color: #ff6b6b;
  } /* red */
  :global(.dark .topic-color-1) {
    color: #74b9ff;
  } /* blue */

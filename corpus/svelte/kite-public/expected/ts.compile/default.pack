import { browser } from '$app/environment';
import { runMigrations } from './migrations';
import { Setting } from './setting.svelte';
/**
 * All application settings centralized in one place
 * Uses the Setting class for consistent behavior and sync support
 */
// Define all settings
export const settings = {
    // Theme Settings
    theme: new Setting('theme', 'system', 'when_not_default', 'appearance'),
    // Language Settings
    language: new Setting('kiteLanguage', 'en', 'when_not_default', 'language'),
    // Translation mode: 'default' | 'source' | 'custom' | specific language code
    // Controls how content should be translated/displayed
    dataLanguage: new Setting('dataLanguage', 'default', 'when_not_default', 'language'),
    // Languages the user can read/speak (used when dataLanguage is 'custom')
    // First element is the main language for translations
    contentLanguages: new Setting('contentLanguages', [], 'always', 'language'),
    // Display Settings
    fontSize: new Setting('fontSize', 'normal', 'when_not_default', 'display'),
    storyCount: new Setting('storyCount', 12, 'when_not_default', 'display'),
    categoryHeaderPosition: new Setting('categoryHeaderPosition', 'bottom', 'when_not_default', 'display'),
    storyExpandMode: new Setting('storyExpandMode', 'doubleClick', 'when_not_default', 'display'),
    storyOpenMode: new Setting('storyOpenMode', 'multiple', 'when_not_default', 'display'),
    useLatestUrls: new Setting('useLatestUrls', false, 'when_true', 'display'),
    mapsProvider: new Setting('mapsProvider', 'auto', 'when_not_default', 'display'),
    layoutWidth: new Setting('layoutWidth', 'normal', 'when_not_default', 'display'),
    // Category Settings
    categoryOrder: new Setting('categoryOrder', [], 'always', 'categories'),
    enabledCategories: new Setting('enabledCategories', [], 'always', 'categories'),
    disabledCategories: new Setting('disabledCategories', [], 'always', 'categories'),
    singlePageMode: new Setting('singlePageMode', 'disabled', 'when_not_default', 'categories'),
    // Content Settings
    contentFilter: new Setting('contentFilter', 'default', 'when_not_default', 'content'),
    // Global reading level setting (applies to all categories unless overridden)
    globalReadingLevel: new Setting('globalReadingLevel', 'normal', 'when_not_default', 'content'),
    // Per-category reading level settings (overrides global setting)
    // Maps category ID to preferred reading level
    categoryReadingLevels: new Setting('categoryReadingLevels', {}, 'when_not_default', 'content'),
    // Section Visibility Settings
    sections: new Setting('sections', {
        showSource: true,
        showTechnicalDetails: false,
        showPerspectives: false,
        showQuestions: false,
        showTimeline: false,
        showSummaryBullets: true,
        showDetailedSummary: true,
    }, 'when_not_default', 'sections'),
    // Experimental Settings
    experimental: new Setting('experimental', {
        enableReadAloud: false,
        showDebugInfo: false,
        enableAnimations: true,
    }, 'when_not_default', 'experimental'),
    // Preloading Config
    preloadingConfig: new Setting('preloadingConfig', {
        enablePreloading: true,
        preloadOnHover: false,
    }, 'when_not_default', 'preloading'),
    // UI State
    introShown: new Setting('introShown', false, 'when_true', 'ui_state'),

		a.href = url;
		a.download = `kite-content-filters-${new Date().toISOString().split('T')[0]}.json`;
		a.click();
		URL.revokeObjectURL(url);
	}

	// Handle file selection
	function handleFileSelect(event) {
		const input = event.target;

		{ id: 'binancecoin', color: 'bg-yellow-500' },
		{ id: 'solana', color: 'bg-green-500' },
		{ id: 'ripple', color: 'bg-blue-500' },
		{ id: 'cardano', color: 'bg-indigo-500' },
		{ id: 'avalanche-2', color: 'bg-red-500' },

    color: #f39c12;
  } /* orange */
  .topic-color-5 {
    color: #1abc9c;
  } /* teal */
  .topic-color-6 {
    color: #e91e63;
  } /* pink */
  .topic-color-7 {
    color: #3f51b5;
  } /* indigo */
  .topic-color-8 {
    color: #ff9800;
  } /* amber */

  /* Dark mode variants - optimized for better contrast and distinctness */
  .dark .topic-color-0 {
    color: #ff6b6b;
  } /* red */
  .dark .topic-color-1 {
    color: #74b9ff;
  } /* blue */
  .dark .topic-color-2 {
    color: #55efc4;

		if (diffDays === 0) {
			return timeStr;
		} else if (diffDays === 1) {
			return `${s('nfl.tomorrow')} ${timeStr}`;
		} else if (diffDays > 1 && diffDays <= 7) {
			return date.toLocaleDateString(language.currentLocale, { weekday: 'short', hour: 'numeric', minute: '2-digit' });

		} else if (amount >= 1000) {
			return `$${(amount / 1000).toFixed(0)}K`;
		}

		return `$${amount.toFixed(0)}`;
	}

	// Generate tooltip text for odds
	function getOddsTooltip(odds) {
		if (!odds.moneyline) return '';

		const parts = [];

		if (odds.moneyline.volume) {

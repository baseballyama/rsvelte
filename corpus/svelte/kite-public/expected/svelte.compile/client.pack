  /* Topic color classes - ordered by perceptual distinctness */
  /* Light mode colors */
  .topic-color-0 {
    color: #e74c3c;
  } /* red */
  .topic-color-1 {
    color: #3498db;
  } /* blue */
  .topic-color-2 {
    color: #2ecc71;
  } /* green */

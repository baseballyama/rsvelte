		const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
		const gameDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());
		const diffDays = Math.floor((gameDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));

			} else if (left + tooltipRect.width > viewportWidth - padding) {
				left = viewportWidth - tooltipRect.width - padding;
			}

			if (top < padding) {
				// If there's no space above, force bottom
				if (position === 'top') {
					top = triggerRect.bottom + 8;
				} else {
					top = padding;
				}

			} else {
				$$renderer.push('<!--[-1-->');
			}

			$$renderer.push(`<!--]--></div> `);

			if (isBlurred && filterKeywords && filterKeywords.length > 0) {
				$$renderer.push(`<!--[0--><div class="absolute left-0 top-4 z-dropdown flex items-center gap-3 px-4" role="alert" aria-live="polite"><span class="text-sm font-medium text-gray-700 dark:text-gray-300">${$.escape(isLinkedStory
					? s("contentFilter.linkedStoryFilteredBecause") || "The story you wanted to view is blocked by your content filter:"
					: s("contentFilter.filteredBecause") || "Hidden due to filter:")}</span> <div class="flex items-center gap-2"><!--[-->`);

				const each_array = $.ensure_array_like(filterKeywords.slice(0, 3));

				for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
					let keyword = each_array[$$index];

					$$renderer.push(`<span class="text-xs font-semibold text-gray-800 dark:text-gray-200 bg-white/50 dark:bg-black/30 px-2 py-0.5 rounded">${$.escape(keyword)}</span>`);

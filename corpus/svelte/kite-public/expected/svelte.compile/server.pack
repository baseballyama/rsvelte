			{
				value: 'kagi',
				label: s('settings.mapsProvider.kagi') || 'Kagi Maps'
			},

			{
				value: 'google',
				label: s('settings.mapsProvider.google') || 'Google Maps'
			},

			{
				value: 'openstreetmap',
				label: s('settings.mapsProvider.openstreetmap') || 'OpenStreetMap'
			},

			{
				value: 'apple',
				label: s('settings.mapsProvider.apple') || 'Apple Maps'

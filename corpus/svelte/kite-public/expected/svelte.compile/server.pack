				$$renderer.push(`<!--[0--><button class="text-sm text-gray-600 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300">${$.escape(s('settings.readingLevel.clearOverrides') || 'Clear overrides')}</button>`);
			} else {
				$$renderer.push('<!--[-1-->');

							IconLoader2($$renderer, { size: 16, class: 'animate-spin text-gray-400' });
						} else if (feed.status === 'valid') {
							$$renderer.push('<!--[1-->');
							IconCircleCheck($$renderer, { size: 16, class: 'text-green-500' });
						} else if (feed.status === 'error') {

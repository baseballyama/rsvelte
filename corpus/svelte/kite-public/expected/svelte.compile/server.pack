				const response = await fetch('/api/widgets/f1/standings');

				if (response.ok) {
					const result = await response.json();

					data = result.data;
					error = null;
				} else {
					error = 'Failed to load standings';
				}
			} catch(err) {
				console.error('Failed to fetch F1 standings:', err);
				error = 'Failed to load standings';

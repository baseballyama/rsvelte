  .citation-wrapper.svelte-hchnco {
    display: block;
  }

  .citation-wrapper.svelte-hchnco:has(.citation-content.inline:where(.svelte-hchnco)) {
    display: inline;
  }

  .citation-content.svelte-hchnco {
    display: block;
  }

  .citation-content.inline.svelte-hchnco {
    display: inline;
  }


			Select($$renderer, {
				value: newCategoryLanguage,
				options: LANGUAGES,
				onChange: (v) => newCategoryLanguage = v,
				id: 'new-category-lang',
				label: s('contribute.feedLanguage'),
				hideLabel: true
			});

			$$renderer.push(`<!----></div></div>`);
		}

		$$renderer.push(`<!--]--></div>`);

		$.bind_props($$props, {
			mode,
			selectedCategory,
			newCategoryName,
			newCategoryLanguage,
			showExistingFeeds
		});
	});
}

				let label = name;

				if (isCore) {
					label += ` (${s('contribute.coreCategory')})`;
				} else {
					label += ` (${s('contribute.feedCount', { count: String(data.feeds.length) })})`;
				}

				if (pendingPr) {
					label += ` · ${s('contribute.pendingFeedsAdded', { count: String(pendingPr.feedCount) })}`;
				}

				return { value: name, label };

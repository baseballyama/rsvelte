			middleware: [
				offset(8), // 8px gap from button
				flip(), // Flip if no space
				shift({ padding: 8 }) // Keep within viewport
			]
		});

		if (// Track tooltip visibility
		// Clear any existing timeout
		// Auto-dismiss after 3 seconds

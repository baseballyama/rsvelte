				$$renderer.push(`<!--[2--><div class="space-y-3"><div class="flex items-center gap-2 text-green-600 dark:text-green-400"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg> <p class="text-sm">${$.escape(s("settings.sync.clear.success") || "All synced data has been deleted successfully.")}</p></div> <button class="inline-flex items-center gap-1 px-3 py-1.5 text-sm bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 rounded-md text-gray-700 dark:text-gray-300 transition-colors">`);
				IconArrowLeft($$renderer, { size: 14 });
				$$renderer.push(`<!----> ${$.escape(s("ui.back") || "Back")}</button></div>`);
			} else if (clearError) {
				$$renderer.push(`<!--[3--><div class="space-y-3"><div class="flex items-start gap-2"><svg class="h-5 w-5 text-red-600 dark:text-red-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg> <p class="text-sm text-red-600 dark:text-red-400">${$.escape(clearError)}</p></div> <button class="inline-flex items-center gap-1 px-3 py-1.5 text-sm bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 rounded-md text-gray-700 dark:text-gray-300 transition-colors">`);
				IconArrowLeft($$renderer, { size: 14 });
				$$renderer.push(`<!----> ${$.escape(s("ui.back") || "Back")}</button></div>`);
			} else {
				$$renderer.push(`<!--[-1--><p class="mb-4 text-sm text-gray-600 dark:text-gray-400">${$.escape(s("settings.sync.clear.description") || "You are in control of your data. Export or delete your cloud data at any time. Deletion does not affect local data.")}</p> <div class="flex gap-2"><button type="button"${$.attr('disabled', isExporting, true)} class="inline-flex items-center gap-2 px-3 py-1.5 text-sm bg-gray-600 text-white rounded-md hover:bg-gray-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">`);

				if (isExporting) {
					$$renderer.push('<!--[0-->');

			if (hideTimeout) {
				clearTimeout(hideTimeout);
			}

			if (pendingFocusTimeout) {
				clearTimeout(pendingFocusTimeout);
			}

			if (browser) {
				window.removeEventListener('scroll', hideTooltipOnScroll);
				window.removeEventListener('click', handleClickOutside, { capture: true });
			}
		});


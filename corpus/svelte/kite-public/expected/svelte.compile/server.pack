						// Min: 200px, Max: 500px or 60% of viewport height
						const minHeight = 200;

						const maxHeight = Math.min(500, window.innerHeight * 0.6);
						const optimalHeight = Math.min(Math.max(minHeight, availableHeight - 16), maxHeight);


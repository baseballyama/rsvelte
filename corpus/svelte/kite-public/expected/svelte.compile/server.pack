			},

			{
				value: 'doubleClick',
				label: s('settings.storyExpandMode.doubleClick') || 'Double-click to expand all'
			},

			{
				value: 'never',
				label: s('settings.storyExpandMode.never') || 'Never expand all'
			}
		]);


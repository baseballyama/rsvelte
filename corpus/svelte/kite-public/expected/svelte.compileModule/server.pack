/* useSinglePageMode.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { browser } from '$app/environment';

export function useSinglePageMode(options) {
	const loadedCategoriesForSinglePage = new Set();
	let previousSinglePageMode = null;
	let previousSinglePageModeForLoading = null;

	// Effect to load categories when single page mode is ENABLED (transition from false to true)
	// Track the transition
	// Only load categories when transitioning from disabled to enabled

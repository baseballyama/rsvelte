		grid-template: 1fr / 1fr;
		text-align: left;
		background: var(--sc-theme-calendar-colors-background-highlight);
		margin: 0;
		grid-column: 1;
		display: grid;
		height: 100%;
		align-items: center;
	}
	.column-primary.svelte-u5cdty > * {
		grid-column: 1;
		grid-row: 1;
		width: 100%;
		height: 100%;
	}
	.column-secondary.svelte-u5cdty {
		display: grid;
		height: 100%;
		align-items: center;
	}
	h1.svelte-u5cdty {
		font-size: 8em;
		line-height: 90px;
		color: #fff;
		display: inline-block;
		margin: 0;
		z-index: 2;
		text-shadow: -5px -2px 3px rgb(0 0 0 / 18%);
	}
	.title-section.svelte-u5cdty {
		align-items: center;
		display: grid;
		padding: 40px;
		animation: 280ms svelte-u5cdty-slide-left 150ms forwards cubic-bezier(0.175, 0.885, 0.32, 1.275);
		opacity: 0;
	}
	pre.svelte-u5cdty {
		background: #0f0b0c;
		color: #fff;
		font-size: 2.4em;
		padding: 40px;
		animation: 280ms svelte-u5cdty-slide-right 200ms forwards cubic-bezier(0.175, 0.885, 0.32, 1.275);
		opacity: 0;
	}
	@keyframes svelte-u5cdty-slide-left {
		from {
			opacity: 0;
			transform: translateX(100px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}
	@keyframes svelte-u5cdty-slide-right {
		from {
			opacity: 0;
			transform: translateX(-100px);
		}
		to {
			opacity: 0.8;
			transform: translateX(0);
		}
	}

	@media (max-width: 720px) {
		.grid.svelte-u5cdty {
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
		}
		.title-section.svelte-u5cdty {
			padding: 30px 18px;
		}
		h1.svelte-u5cdty {

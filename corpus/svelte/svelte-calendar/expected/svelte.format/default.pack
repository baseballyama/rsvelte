    grid-template-rows: 1fr auto auto;
    align-items: center;
    height: 100%;
    text-align: center;
    align-items: center;
  }

  @media (min-width: 720px) {
    .modal .example {
    }
  }

  @media (max-width: 720px) {
    .modal {
      width: 100vw;
      height: 100vh;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
    }
    .modal .example {
      padding: 20px 0;
    }
  }

  .modal .example > :global(*) {
    margin: 0 auto;
  }

  .modal .example > :global(p) {
    margin-top: 30px;
    color: #666;
  }

  .modal .example > :global(p a) {
    font-weight: bold;
  }
</style>


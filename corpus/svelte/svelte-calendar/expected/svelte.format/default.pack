    background: #fff;
    box-shadow: var(--sc-theme-calendar-shadow);
    display: grid;
    grid-template-columns: 1fr auto;
    z-index: 3;
  }

  .modal .code {
    display: grid;
    height: 100%;
    overflow-y: auto;
  }

  .modal .code > :global(*) {
    padding: 35px;
  }

  .modal .result-column {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 57vw;
  }

  .modal .result-column h1 {
    margin: 0;

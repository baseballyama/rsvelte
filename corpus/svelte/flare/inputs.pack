							class="text-muted-foreground group-hover:text-foreground size-4"
						/>
					</Button>
				</div>
			{/if}
		</div>
	</div>
</div>

<ActionBar
	title={extension.title}
	icon={extension.icons.light
		? { source: extension.icons.light, mask: 'roundedRectangle' }

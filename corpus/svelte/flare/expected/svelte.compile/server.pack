					$$renderer.push('<!--[-1-->');

					Button($$renderer, {
						class: 'bg-white/10 text-white hover:bg-white/20',
						onclick: selectAndImportFile,
						disabled: importState === 'importing' || !!snippetsToImport,
						children: ($$renderer) => {

				name,
				link,
				application: application === 'Default' ? undefined : application,
				icon: icon === 'link-16' ? undefined : icon
			};

			try {
				if (quicklink) {
					await quicklinksStore.update(quicklink.id, data);
				} else {
					await quicklinksStore.create(data);
				}


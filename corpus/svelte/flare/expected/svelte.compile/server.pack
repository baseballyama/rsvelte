						},
						$$slots: { default: true }
					});
				}

				$$renderer.push(`<!--]-->`);
			}

			ActionBar($$renderer, {
				title: 'Import Snippets',
				icon: snippetIcon,
				primaryAction,
				$$slots: { primaryAction: true }
			});
		}

		$$renderer.push(`<!----></div>`);
	});
}

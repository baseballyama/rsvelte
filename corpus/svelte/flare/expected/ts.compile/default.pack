import { root, setCurrentRootElement } from './state';
import { hostConfig } from './hostConfig';
import { writeLog } from './io';
const reconciler = Reconciler(hostConfig);
const onRecoverableError = (error) => {
    writeLog(`--- REACT RECOVERABLE ERROR ---`);
    writeLog(`Error: ${error.message}`);
    writeLog(`Stack: ${error.stack}`);
};
export const container = reconciler.createContainer(root, 0, // LegacyRoot
null, false, null, '', onRecoverableError, null);
export const updateContainer = (element, callback) => {
    setCurrentRootElement(element);
    reconciler.updateContainer(element, container, null, callback);
};
export const batchedUpdates = (callback) => {
    reconciler.batchedUpdates(callback, null);
};


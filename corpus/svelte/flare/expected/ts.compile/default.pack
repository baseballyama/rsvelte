=== 865 src/lib/node.svelte.ts	js
import { getTypedProps } from '$lib/props';
export function useTypedNode(args) {
    const { nodeId, uiTree, type: expectedTypes } = $derived.by(args);
    let node = $state(undefined);
    let props = $state(null);
    $effect(() => {
        const n = uiTree.get(nodeId);
        if (n) {
            const types = Array.isArray(expectedTypes) ? expectedTypes : [expectedTypes];
            if (!types.includes(n.type)) {
                console.error(`Type mismatch for node ${nodeId}. Expected one of [${types.join(', ')}], but got ${n.type}`);
                node = undefined;
                props = null;
            }
            else {
                node = n;
                props = getTypedProps(n);
            }
        }
        else {
            node = undefined;
            props = null;
        }
    });
    return () => ({ node, props });
}


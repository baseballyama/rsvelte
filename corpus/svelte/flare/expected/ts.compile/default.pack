    'Detail.Metadata.TagList.Item': DetailMetadataTagListItemPropsSchema,
    'Detail.Metadata.Separator': DetailMetadataSeparatorPropsSchema
};
export function getTypedProps(node) {
    const result = componentSchemas[node.type].safeParse(node.props);
    if (!result.success) {
        console.error(`[Props Validation Error] For node ${node.id} (type: ${node.type}):`, z.prettifyError(result.error));
        return null;
    }
    return result.data;
}


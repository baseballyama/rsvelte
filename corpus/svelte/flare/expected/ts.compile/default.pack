import { uiStore } from '$lib/ui.svelte';
import { sidecarService } from '$lib/sidecar.svelte';
import { invoke } from '@tauri-apps/api/core';
import { extensionsStore } from './components/extensions/store.svelte';
import { fetch } from '@tauri-apps/plugin-http';
import { ExtensionSchema } from '$lib/store';
class ViewManager {
    currentView = $state('command-palette');
    quicklinkToEdit = $state(undefined);
    snippetsForImport = $state(null);
    commandToConfirm = $state(null);
    pluginToSelectInSettings = $state(undefined);
    extensionToSelect = $state(null);

=== 2437 sidecar/src/api/environment.ts	js
import { LaunchType } from './types';
import * as fs from 'fs';
import { writeOutput } from '../io';
import { config } from '../config';
import { browserExtensionState, aiContext } from '../state';
import { invokeCommand } from './rpc';
const supportPath = config.supportDir;
try {
    if (!fs.existsSync(supportPath)) {
        fs.mkdirSync(supportPath, { recursive: true });
    }
}
catch (e) {
    console.error('Could not create support path', e);
}
export const BrowserExtension = { name: 'BrowserExtension' };
export const AI = { name: 'AI' };
export const environment = {
    appearance: 'dark',
    assetsPath: config.assetsDir,
    commandMode: 'view',
    commandName: 'index',
    extensionName: 'my-extension',
    isDevelopment: true,
    launchType: LaunchType.UserInitiated,
    ownerOrAuthorName: 'Flare',
    raycastVersion: '1.0.0',
    supportPath: supportPath,
    textSize: 'medium',
    canAccess: (feature) => {
        if (feature && feature.name === 'BrowserExtension') {
            return browserExtensionState.isConnected;
        }
        if (feature && feature.name === 'AI') {
            return aiContext.hasAccess;
        }
        return true;
    }
};
export async function getSelectedFinderItems() {
    return invokeCommand('get_selected_finder_items');
}
export async function getSelectedText() {
    return invokeCommand('get_selected_text');
}
export async function open(target, application) {
    let openWith;
    if (typeof application === 'string') {
        openWith = application;
    }
    else if (application) {
        openWith = application.path;
    }
    writeOutput({
        type: 'open',
        payload: {
            target,
            application: openWith
        }
    });
}
export async function getApplications(path) {
    const pathString = path ? path.toString() : undefined;
    return invokeCommand('get_applications', { path: pathString });
}
export async function getDefaultApplication(path) {
    return invokeCommand('get_default_application', { path: path.toString() });
}
export async function getFrontmostApplication() {
    return invokeCommand('get_frontmost_application');
}
export async function showInFinder(path) {
    return invokeCommand('show_in_finder', { path: path.toString() });
}
export async function trash(path) {
    const paths = (Array.isArray(path) ? path : [path]).map((p) => p.toString());
    return invokeCommand('trash', { paths });
}


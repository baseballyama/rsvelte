            if (index !== -1 && index !== selectedIndex) {
                selectedIndex = index;
            }
        }
        else {
            // Default selection
            if (selectedIndex < 0 && allItems.length > 0) {
                selectedIndex = 0;
            }
        }
    });
    $effect(() => {
        if (selectedIndex >= allItems.length) {
            selectedIndex = allItems.length > 0 ? 0 : -1;

	};

	/**
	 * Dereference this cache entry. If the entry's `proxy_count` hits zero, schedule a deferred eviction check.
	 *
	 * @param {CacheEntry<R>} entry
	 * @param {string} id
	 * @param {string} payload
	 */
	deref = (entry, id, payload) => {
		entry.proxy_count--;

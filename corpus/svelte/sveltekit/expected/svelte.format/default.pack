    {#each Object.entries(src.sources) as [format, srcset]}
      <source {srcset} type={"image/" + format} />
    {/each}
    <img
      src={src.img.src}
      alt="attribute shorthand test"
      width={src.img.w}
      height={src.img.h}
    />
  </picture>
{/if}

{#each images as image}

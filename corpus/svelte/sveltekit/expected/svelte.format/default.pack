    status = "query created";
  }}
>
  create query
</button>

<button
  id="await"
  onclick={async () => {
    result = String(await stored);
    status = "query awaited";
  }}
>
  await query
</button>

<button
  id="read-current"
  onclick={async () => {
    try {
      await stored;
      result = String(stored.current);
    } catch (error) {
      result = get_message(error);
    }
  }}
>
  read current
</button>


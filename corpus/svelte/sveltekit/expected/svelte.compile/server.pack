import * as $ from 'svelte/internal/server';
import { browser } from '$app/env';
import { PUBLIC_ANSWER } from '$app/env/public';

export default function _page($$renderer) {
	$$renderer.push(`<h1>The answer is ${$.escape(PUBLIC_ANSWER)}</h1> `);


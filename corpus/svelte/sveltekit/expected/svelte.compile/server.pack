		$$renderer.push(`<!--[0--><h2>The dynamic answer is ${$.escape(PUBLIC_ANSWER)}</h2>`);
	} else {
		$$renderer.push('<!--[-1-->');
	}

	$$renderer.push(`<!--]-->`);
}

import * as $ from 'svelte/internal/client';
import { goto } from '$app/navigation';

var root = $.from_html(`<button>goto</button> <p> </p>`, 1);

export default function _page($$anchor, $$props) {
	$.push($$props, true);

	let message = $.state('...');

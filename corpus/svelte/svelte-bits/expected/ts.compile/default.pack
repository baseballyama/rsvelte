// Slug helpers (kebab-case used in URLs).
export const slug = (s) => s.replace(/\s+/g, '-').toLowerCase();
export const decodeLabel = (s) => s
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');

			name: 'textClass',
			type: 'string',
			default: '""',
			description: 'Classes applied to the inner text wrapper.'
		},

		{
			name: 'animationDuration',
			type: 'number',
			default: '1',
			description: 'GSAP tween duration for each character.'
		},


						return $.get(glowIntensity);
					},

					get coneSpread() {
						return $.get(coneSpread);
					},

					get animated() {
						return $.get(animated);
					},

					get colors() {
						return $.get(colors);
					},

					children: ($$anchor, $$slotProps) => {
						var div_1 = root();

						$.append($$anchor, div_1);
					},
					$$slots: { default: true }
				});
			});

			$.reset(div);
			$.append($$anchor, div);
		};

		const code = ($$anchor) => {

					return $.get(lightColor);
				},

				get speed() {
					return $.get(speed);
				},

				get noiseIntensity() {
					return $.get(noiseIntensity);
				},

				get scale() {
					return $.get(scale);
				},

				get rotation() {
					return $.get(rotation);
				}
			});

			var node_2 = $.sibling(node_1, 2);

			BackgroundContentToggle(node_2, {

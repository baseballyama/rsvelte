	$.snippet(node, () => $$props.children);
	$.reset(div);
	$.bind_this(div, ($$value) => el = $$value, () => el);
	$.template_effect(() => $.set_class(div, 1, $.clsx(className())));
	$.append($$anchor, div);
	$.pop();

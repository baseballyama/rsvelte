					},

					get menuColor() {
						return $.get(currentTheme).menuColor;
					},

					get buttonBgColor() {
						return $.get(currentTheme).buttonBgColor;
					},

					get buttonTextColor() {
						return $.get(currentTheme).buttonTextColor;
					},


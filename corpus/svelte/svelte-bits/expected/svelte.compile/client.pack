					});

					var node_4 = $.sibling(node_3, 2);

					PreviewColorPicker(node_4, {
						title: 'Background Color',
						get value() {
							return $.get(bgColor);
						},

						onChange: (v) => {
							$.set(bgColor, v, true);
							$.update(key);
						}
					});

					var node_5 = $.sibling(node_4, 2);

					PreviewColorPicker(node_5, {
						title: 'Marquee Bg Color',
						get value() {
							return $.get(marqueeBgColor);
						},


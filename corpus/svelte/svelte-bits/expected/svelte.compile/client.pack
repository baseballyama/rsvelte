					});

					var node_6 = $.sibling(node_5, 2);

					PreviewSwitch(node_6, {
						title: 'Force Hover State',
						get checked() {
							return $.get(forceHoverState);
						},
						onChange: (v) => $.set(forceHoverState, v, true)
					});

					var node_7 = $.sibling(node_6, 2);

					PreviewColorPicker(node_7, {
						title: 'Background',
						get value() {

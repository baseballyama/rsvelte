import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { onMount } from 'svelte';

var root = $.from_html(`<canvas class="relative h-full w-full"></canvas>`);

export default function Lightning($$anchor, $$props) {
	$.push($$props, true);

	let hue = $.prop($$props, 'hue', 3, 230),
		xOffset = $.prop($$props, 'xOffset', 3, 0),
		speed = $.prop($$props, 'speed', 3, 1),
		intensity = $.prop($$props, 'intensity', 3, 1),
		size = $.prop($$props, 'size', 3, 1);

	const current = $.derived(() => ({
		hue: hue(),
		xOffset: xOffset(),
		speed: speed(),
		intensity: intensity(),
		size: size()
	}));


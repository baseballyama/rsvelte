					var fragment_4 = root_1();
					var node_2 = $.first_child(fragment_4);

					PreviewInput(node_2, {
						title: 'Text',
						get value() {
							return $.get(text);
						},
						placeholder: 'Enter text...',
						onChange: (v) => $.set(text, v, true)
					});

					var node_3 = $.sibling(node_2, 2);

					PreviewSelect(node_3, {

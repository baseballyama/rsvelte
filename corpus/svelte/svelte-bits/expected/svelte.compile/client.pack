						min: 0,
						max: 1000,
						step: 100,
						get value() {
							return $.get(particleR);
						},

						onChange: (v) => {
							$.set(particleR, v, true);
							$.update(key);
						}
					});

					$.append($$anchor, fragment_4);
				},
				$$slots: { default: true }

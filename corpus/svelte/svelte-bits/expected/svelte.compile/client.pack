import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { onMount } from 'svelte';
import { Renderer, Camera, Geometry, Program, Mesh } from 'ogl';

var root = $.from_html(`<div></div>`);

export default function Particles($$anchor, $$props) {
	$.push($$props, true);

	let particleCount = $.prop($$props, 'particleCount', 3, 200),
		particleSpread = $.prop($$props, 'particleSpread', 3, 10),
		speed = $.prop($$props, 'speed', 3, 0.1),
		moveParticlesOnHover = $.prop($$props, 'moveParticlesOnHover', 3, false),
		particleHoverFactor = $.prop($$props, 'particleHoverFactor', 3, 1),
		alphaParticles = $.prop($$props, 'alphaParticles', 3, false),
		particleBaseSize = $.prop($$props, 'particleBaseSize', 3, 100),
		sizeRandomness = $.prop($$props, 'sizeRandomness', 3, 1),
		cameraDistance = $.prop($$props, 'cameraDistance', 3, 20),
		disableRotation = $.prop($$props, 'disableRotation', 3, false),
		pixelRatio = $.prop($$props, 'pixelRatio', 3, 1),
		className = $.prop($$props, 'class', 3, '');

	let containerRef;

	const current = $.derived(() => ({
		speed: speed(),
		moveParticlesOnHover: moveParticlesOnHover(),
		particleHoverFactor: particleHoverFactor(),
		disableRotation: disableRotation()
	}));

	function hexToRgb(hex) {
		hex = hex.replace(/^#/, '');

		if (hex.length === 3) hex = hex.split('').map((c) => c + c).join('');

		const i = parseInt(hex, 16);

		return [(i >> 16 & 255) / 255, (i >> 8 & 255) / 255, (i & 255) / 255];
	}

	onMount(() => {
		const renderer = new Renderer({ dpr: pixelRatio(), depth: false, alpha: true });
		const gl = renderer.gl;

		// eslint-disable-next-line svelte/no-dom-manipulating
		containerRef.appendChild(gl.canvas);

		gl.clearColor(0, 0, 0, 0);

		const camera = new Camera(gl, { fov: 15 });

		camera.position.set(0, 0, cameraDistance());

		const resize = () => {
			const w = containerRef.clientWidth;
			const h = containerRef.clientHeight;

			renderer.setSize(w, h);
			camera.perspective({ aspect: gl.canvas.width / gl.canvas.height });
		};

		window.addEventListener('resize', resize);
		resize();

		const mouse = { x: 0, y: 0 };

		const handleMouseMove = (e) => {
			const rect = containerRef.getBoundingClientRect();

			mouse.x = (e.clientX - rect.left) / rect.width * 2 - 1;
			mouse.y = -((e.clientY - rect.top) / rect.height * 2 - 1);
		};

		containerRef.addEventListener('mousemove', handleMouseMove);

		const defaultColors = ['#ffffff', '#ffffff', '#ffffff'];
		const palette = $$props.particleColors && $$props.particleColors.length > 0 ? $$props.particleColors : defaultColors;
		const positions = new Float32Array(particleCount() * 3);
		const randoms = new Float32Array(particleCount() * 4);
		const colors = new Float32Array(particleCount() * 3);

		for (let i = 0; i < particleCount(); i++) {
			let x, y, z, len;

			do {
				x = Math.random() * 2 - 1;
				y = Math.random() * 2 - 1;

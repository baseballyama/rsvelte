							});

							$.append($$anchor, fragment_4);
						};

						$.if(node_15, ($$render) => {
							if ($.get(isViscous)) $$render(consequent);
						});
					}

					$.append($$anchor, fragment_3);
				},
				$$slots: { default: true }
			});
		};

		const propTable = ($$anchor) => {
			PropTable($$anchor, {
				get rows() {

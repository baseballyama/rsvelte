	.search-backdrop.svelte-kk6vmu {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		justify-content: center;
		padding-top: 12vh;
		background: rgba(0, 0, 0, 0.7);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		animation: svelte-kk6vmu-search-fade-in 0.15s ease;
	}

	@keyframes svelte-kk6vmu-search-fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.search-dialog.svelte-kk6vmu {
		width: 100%;
		max-width: 560px;
		margin: 0 16px;
		height: fit-content;
		border-radius: 16px;
		border: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(23, 19, 15, 0.9);
		backdrop-filter: blur(32px) saturate(1.3);
		-webkit-backdrop-filter: blur(32px) saturate(1.3);
		box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 138, 76, 0.04);
		overflow: hidden;
		font-family: 'Geist Mono', monospace;
		animation: svelte-kk6vmu-search-slide-in 0.2s ease;
	}

	@keyframes svelte-kk6vmu-search-slide-in {
		from { opacity: 0; transform: translateY(-8px) scale(0.98); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}

	.search-input-row.svelte-kk6vmu {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 14px 16px;
	}

	.search-input-icon.svelte-kk6vmu {
		flex-shrink: 0;
		color: rgba(255, 255, 255, 0.35);
	}

	.search-input.svelte-kk6vmu {
		flex: 1;
		background: none;
		border: none;
		outline: none;
		font-family: 'Geist Mono', monospace;
		font-size: 14px;
		font-weight: 400;
		color: #fff;
		caret-color: rgba(255, 138, 76, 0.85);
	}

	.search-input.svelte-kk6vmu::placeholder {
		color: rgba(255, 255, 255, 0.25);
	}

	.search-kbd.svelte-kk6vmu {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 2px 6px;
		font-size: 10px;
		font-weight: 600;
		font-family: 'Geist Mono', monospace;
		color: rgba(255, 255, 255, 0.4);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 5px;
		background: rgba(255, 255, 255, 0.05);
		cursor: pointer;
		transition: border-color 0.15s ease;
	}

	.search-kbd.svelte-kk6vmu:hover {
		border-color: rgba(255, 255, 255, 0.2);
	}

	.search-results-motion.svelte-kk6vmu {
		overflow: hidden;
		animation: svelte-kk6vmu-search-results-in 0.3s ease;
	}

	@keyframes svelte-kk6vmu-search-results-in {
		from { opacity: 0; max-height: 0; }
		to { opacity: 1; max-height: 460px; }
	}

	.search-results-wrapper.svelte-kk6vmu {
		position: relative;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.search-results.svelte-kk6vmu {
		max-height: 400px;
		overflow-y: auto;
		padding: 6px 10px 10px;
	}

	.search-results.svelte-kk6vmu::-webkit-scrollbar {
		width: 4px;
	}

	.search-results.svelte-kk6vmu::-webkit-scrollbar-track {
		background: transparent;
	}

	.search-results.svelte-kk6vmu::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.08);
		border-radius: 4px;
	}

	.search-result-anim.svelte-kk6vmu {
		cursor: pointer;
		animation: svelte-kk6vmu-search-result-pop 0.2s ease both;
	}

	@keyframes svelte-kk6vmu-search-result-pop {
		from { opacity: 0; transform: scale(0.7); }
		to { opacity: 1; transform: scale(1); }
	}

	.search-result-item.svelte-kk6vmu {
		display: flex;
		align-items: center;
		padding: 10px 12px;
		margin-top: 4px;
		border-radius: 10px;
		border: 1px solid transparent;
		background: rgba(255, 255, 255, 0.03);
		transition: background 0.15s ease, border-color 0.15s ease;
	}

	.search-result-item.selected.svelte-kk6vmu {
		background: rgba(255, 255, 255, 0.07);
		border-color: rgba(255, 138, 76, 0.18);
	}

	.search-result-icon.svelte-kk6vmu {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		margin-right: 12px;
		border-radius: 8px;
		background: rgba(255, 138, 76, 0.1);
		color: rgba(255, 138, 76, 0.76);
	}

	.search-result-text.svelte-kk6vmu {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}

	.search-result-name.svelte-kk6vmu {
		font-size: 13px;
		font-weight: 600;
		color: #fff;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.search-result-category.svelte-kk6vmu {
		font-size: 11px;
		color: rgba(255, 255, 255, 0.35);
	}

	.search-result-enter.svelte-kk6vmu {
		flex-shrink: 0;
		color: rgba(255, 255, 255, 0.2);
		margin-left: 8px;
	}

	.search-result-item.selected.svelte-kk6vmu .search-result-enter:where(.svelte-kk6vmu) {
		color: rgba(255, 255, 255, 0.4);
	}

	.search-no-results.svelte-kk6vmu {
		text-align: center;
		padding: 20px 16px;
		font-size: 13px;
		color: rgba(255, 255, 255, 0.35);
	}

	.search-no-results.svelte-kk6vmu strong:where(.svelte-kk6vmu) {
		color: rgba(255, 255, 255, 0.6);
	}

	.search-gradient.svelte-kk6vmu {
		position: absolute;
		left: 0;
		right: 0;
		pointer-events: none;
		transition: opacity 0.3s;
	}

	.search-gradient-top.svelte-kk6vmu {
		top: 0;
		height: 50px;
		background: linear-gradient(to bottom, rgba(23, 19, 15, 0.9), transparent);
	}

	.search-gradient-bottom.svelte-kk6vmu {
		bottom: 0;
		height: 80px;
		background: linear-gradient(to top, rgba(23, 19, 15, 0.9), transparent);
	}

	@media (max-width: 768px) {
		.search-backdrop.svelte-kk6vmu { padding-top: 8vh; }
		.search-dialog.svelte-kk6vmu { max-width: none; margin: 0 12px; }
	}


			type: '{x,y,rotate}',
			default: '-',
			description: 'Top wave position/rotate.'
		},

		{
			name: 'middleWavePosition',
			type: '{x,y,rotate}',
			default: '-',
			description: 'Middle wave position/rotate.'
		},

		{
			name: 'bottomWavePosition',
			type: '{x,y,rotate}',
			default: '{x:2,y:-0.7,rotate:-1}',

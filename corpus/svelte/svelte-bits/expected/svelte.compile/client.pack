					return $.get(shineColor);
				},

				get spread() {
					return $.get(spread);
				},

				get direction() {
					return $.get(direction);
				},

				get yoyo() {
					return $.get(yoyo);
				},

				get pauseOnHover() {
					return $.get(pauseOnHover);
				},

				get disabled() {
					return $.get(disabled);
				}
			});

			$.reset(div);
			$.append($$anchor, div);
		};

		const code = ($$anchor) => {
			DemoCodeTab($$anchor, {
				slug: 'shiny-text',
				get usage() {
					return $.get(usage);
				},

				get source() {
					return shinyTextSource;
				}
			});
		};

		const customize = ($$anchor) => {
			Customize($$anchor, {
				children: ($$anchor, $$slotProps) => {
					var fragment_3 = root_1();
					var node_2 = $.first_child(fragment_3);

					PreviewColorPicker(node_2, {
						title: 'Text Color',
						get value() {
							return $.get(color);

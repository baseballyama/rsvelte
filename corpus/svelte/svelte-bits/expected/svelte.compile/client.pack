import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { onMount } from 'svelte';
import { Renderer, Camera, Transform, Program, Mesh, Geometry } from 'ogl';

var root = $.from_html(`<div class="h-full w-full"></div>`);

export default function PlasmaWave($$anchor, $$props) {
	$.push($$props, true);

	let xOffset = $.prop($$props, 'xOffset', 3, 0),
		yOffset = $.prop($$props, 'yOffset', 3, 0),
		rotationDeg = $.prop($$props, 'rotationDeg', 3, 0),
		focalLength = $.prop($$props, 'focalLength', 3, 0.8),
		speed1 = $.prop($$props, 'speed1', 3, 0.05),
		speed2 = $.prop($$props, 'speed2', 3, 0.05),
		dir2 = $.prop($$props, 'dir2', 3, 1.0),
		bend1 = $.prop($$props, 'bend1', 3, 1),
		bend2 = $.prop($$props, 'bend2', 3, 0.5),
		colors = $.prop($$props, 'colors', 19, () => ['#ff8a3d', '#06B6D4']);

	let containerRef;

	const current = $.derived(() => ({
		xOffset: xOffset(),
		yOffset: yOffset(),
		rotationDeg: rotationDeg(),
		focalLength: focalLength(),
		speed1: speed1(),
		speed2: speed2(),
		dir2: dir2(),
		bend1: bend1(),
		bend2: bend2(),
		colors: colors()
	}));

	function hexToRgb(hex) {
		const r = parseInt(hex.slice(1, 3), 16) / 255;
		const g = parseInt(hex.slice(3, 5), 16) / 255;
		const b = parseInt(hex.slice(5, 7), 16) / 255;

		return [r, g, b];
	}

	onMount(() => {
		const renderer = new Renderer({
			alpha: true,
			dpr: Math.min(window.devicePixelRatio, 1.5),
			antialias: false,
			depth: false,
			stencil: false,
			premultipliedAlpha: false,
			powerPreference: 'high-performance'
		});

		const gl = renderer.gl;

		gl.clearColor(0, 0, 0, 0);

		// eslint-disable-next-line svelte/no-dom-manipulating
		containerRef.appendChild(gl.canvas);

		const camera = new Camera(gl);
		const scene = new Transform();

		const geometry = new Geometry(gl, {
			position: { size: 2, data: new Float32Array([-1, -1, 3, -1, -1, 3]) }
		});


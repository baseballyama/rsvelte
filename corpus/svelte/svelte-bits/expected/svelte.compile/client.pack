	function reset() {
		$.set(shapeSize, DEFAULTS.shapeSize, true);
		$.set(roundness, DEFAULTS.roundness, true);
		$.set(borderSize, DEFAULTS.borderSize, true);
		$.set(circleSize, DEFAULTS.circleSize, true);
		$.set(circleEdge, DEFAULTS.circleEdge, true);
	}


import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { onMount } from 'svelte';
import { Renderer, Program, Triangle, Mesh } from 'ogl';

var root = $.from_html(`<div></div>`);

export default function LightRays($$anchor, $$props) {
	$.push($$props, true);

	let raysOrigin = $.prop($$props, 'raysOrigin', 3, 'top-center'),
		raysColor = $.prop($$props, 'raysColor', 3, '#ffffff'),
		raysSpeed = $.prop($$props, 'raysSpeed', 3, 1),
		lightSpread = $.prop($$props, 'lightSpread', 3, 1),
		rayLength = $.prop($$props, 'rayLength', 3, 2),
		pulsating = $.prop($$props, 'pulsating', 3, false),
		fadeDistance = $.prop($$props, 'fadeDistance', 3, 1.0),
		saturation = $.prop($$props, 'saturation', 3, 1.0),
		followMouse = $.prop($$props, 'followMouse', 3, true),
		mouseInfluence = $.prop($$props, 'mouseInfluence', 3, 0.1),
		noiseAmount = $.prop($$props, 'noiseAmount', 3, 0.0),
		distortion = $.prop($$props, 'distortion', 3, 0.0),
		className = $.prop($$props, 'class', 3, '');


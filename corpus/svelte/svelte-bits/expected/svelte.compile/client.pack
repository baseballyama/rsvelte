		$.set(flex, DEFAULTS.flex, true);
		$.set(alpha, DEFAULTS.alpha, true);
		$.set(stroke, DEFAULTS.stroke, true);
		$.set(width, DEFAULTS.width, true);
		$.set(weight, DEFAULTS.weight, true);

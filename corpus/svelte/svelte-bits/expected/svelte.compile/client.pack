	function reset() {
		$.set(intensity, D.intensity, true);
		$.set(speed, D.speed, true);
		$.set(animationType, D.animationType, true);
		$.set(distort, D.distort, true);
		$.set(paused, D.paused, true);
		$.set(hoverDampness, D.hoverDampness, true);

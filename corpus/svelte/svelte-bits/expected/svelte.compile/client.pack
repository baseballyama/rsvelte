import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { onMount } from 'svelte';
import { Renderer, Program, Mesh, Triangle, Vec2 } from 'ogl';

var root = $.from_html(`<canvas class="block h-full w-full"></canvas>`);

export default function DarkVeil($$anchor, $$props) {
	$.push($$props, true);

	let hueShift = $.prop($$props, 'hueShift', 3, 0),
		noiseIntensity = $.prop($$props, 'noiseIntensity', 3, 0),
		scanlineIntensity = $.prop($$props, 'scanlineIntensity', 3, 0),
		speed = $.prop($$props, 'speed', 3, 0.5),
		scanlineFrequency = $.prop($$props, 'scanlineFrequency', 3, 0),
		warpAmount = $.prop($$props, 'warpAmount', 3, 0),
		resolutionScale = $.prop($$props, 'resolutionScale', 3, 1);

	const current = $.derived(() => ({
		hueShift: hueShift(),
		noiseIntensity: noiseIntensity(),
		scanlineIntensity: scanlineIntensity(),

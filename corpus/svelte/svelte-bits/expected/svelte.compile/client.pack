		raysOrigin: raysOrigin(),
		raysColor: raysColor(),
		raysSpeed: raysSpeed(),
		lightSpread: lightSpread(),
		rayLength: rayLength(),
		pulsating: pulsating(),
		fadeDistance: fadeDistance(),
		saturation: saturation(),
		followMouse: followMouse(),
		mouseInfluence: mouseInfluence(),
		noiseAmount: noiseAmount(),
		distortion: distortion()

	$.bind_this(div, ($$value) => containerRef = $$value, () => containerRef);
	$.template_effect(() => $.set_class(div, 1, `absolute inset-0 h-full w-full transform-gpu will-change-transform backface-hidden ${className() ?? ''}`));

const DEFAULT_CONFIG = {
	count: 200,
	colors: [0, 0, 0],
	ambientColor: 0xffffff,
	ambientIntensity: 1,
	lightIntensity: 200,
	materialParams: {
		metalness: 0.5,
		roughness: 0.5,
		clearcoat: 1,
		clearcoatRoughness: 0.15
	},
	minSize: 0.5,
	maxSize: 1,
	size0: 1,
	gravity: 0.5,
	friction: 0.9975,
	wallBounce: 0.95,
	maxVelocity: 0.15,
	maxX: 5,
	maxY: 5,
	maxZ: 2,

		{
			name: 'scanPhaseTaper',
			type: 'number',
			default: '0.9',
			description: 'Phase taper.'
		},

		{
			name: 'enablePost',
			type: 'boolean',
			default: 'true',
			description: 'Enable postprocessing.'
		},

		{
			name: 'bloomIntensity',
			type: 'number',
			default: '0',
			description: 'Bloom intensity.'

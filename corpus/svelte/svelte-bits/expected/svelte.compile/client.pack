					Open source. Always free.</p> <div class="ln-cta-buttons"><a href="/get-started/index" class="ln-cta-btn ln-cta-btn--primary">Browse Components <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a> <a target="_blank" rel="noopener noreferrer" class="ln-cta-btn ln-cta-btn--secondary"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg> Star on GitHub</a></div></div></div></div></section>`);

export default function CTA($$anchor, $$props) {
	$.push($$props, true);

	let innerEl = $.state(null);
	let visible = $.state(false);

	onMount(() => {
		if (!$.get(innerEl)) return;

		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						$.set(visible, true);
						io.disconnect();
					}
				}
			},
			{ threshold: 0.1, rootMargin: '-60px' }
		);

		io.observe($.get(innerEl));

		return () => io.disconnect();
	});

	var section = root();
	var div = $.sibling($.child(section), 2);
	let classes;
	var div_1 = $.child(div);
	var div_2 = $.sibling($.child(div_1), 2);
	var div_3 = $.sibling($.child(div_2), 4);
	var a = $.sibling($.child(div_3), 2);

	$.reset(div_3);
	$.reset(div_2);
	$.reset(div_1);
	$.reset(div);
	$.bind_this(div, ($$value) => $.set(innerEl, $$value), () => $.get(innerEl));
	$.reset(section);

	$.template_effect(() => {
		classes = $.set_class(div, 1, 'ln-cta-inner', null, classes, { 'is-visible': $.get(visible) });
		$.set_attribute(a, 'href', GITHUB_URL);
	});

	$.append($$anchor, section);
	$.pop();
}

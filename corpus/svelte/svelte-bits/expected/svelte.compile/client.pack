				width: '500px',
				height: '300px',
				background: '#1a1a1a',
				borderRadius: '10px',
				borderColor: '#333',
				get glareColor() {
					return $.get(glareColor);
				},

				get glareOpacity() {
					return $.get(glareOpacity);
				},

				get glareSize() {
					return $.get(glareSize);
				},

				get transitionDuration() {
					return $.get(transitionDuration);
				},

				get playOnce() {
					return $.get(playOnce);

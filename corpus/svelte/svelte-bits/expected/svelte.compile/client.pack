		speedTrigger = $.prop($$props, 'speedTrigger', 3, 100),
		shockRadius = $.prop($$props, 'shockRadius', 3, 250),
		shockStrength = $.prop($$props, 'shockStrength', 3, 5),
		maxSpeed = $.prop($$props, 'maxSpeed', 3, 5000),

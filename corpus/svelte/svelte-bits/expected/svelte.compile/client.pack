						},
						onChange: (v) => $.set(gravity, v, true)
					});

					var node_5 = $.sibling(node_4, 2);

					PreviewSlider(node_5, {
						title: 'Friction',
						min: 0.9,
						max: 1,
						step: 0.0005,
						get value() {
							return $.get(friction);
						},
						onChange: (v) => $.set(friction, v, true)
					});

					var node_6 = $.sibling(node_5, 2);

					PreviewSlider(node_6, {
						title: 'Wall Bounce',
						min: 0,
						max: 1,

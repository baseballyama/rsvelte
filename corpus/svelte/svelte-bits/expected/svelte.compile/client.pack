=== 4335 src/lib/components/library/Components/MagicBento/MagicBento.svelte	css

	.bento-section.svelte-f4wcgw {
		position: relative;
		user-select: none;
		--white: hsl(0, 0%, 100%);
		--border-color: #2A2620;
		--background-dark: #14110E;
		--accent-glow: rgba(255, 138, 76, 0.2);
	}
	.bento-section .card-grid {
		display: grid;
		gap: 0.5em;
		padding: 0.75em;
		max-width: 54em;
		font-size: clamp(1rem, 0.9rem + 0.5vw, 1.5rem);
	}
	.bento-section .magic-bento-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		position: relative;
		aspect-ratio: 4/3;
		min-height: 200px;
		width: 100%;
		max-width: 100%;
		padding: 1.25em;
		border-radius: 20px;
		border: 1px solid var(--border-color);
		background: var(--background-dark);
		font-weight: 300;
		overflow: hidden;
		transition: all 0.3s ease;
		color: var(--white);
		--glow-x: 50%;
		--glow-y: 50%;
		--glow-intensity: 0;
		--glow-radius: 200px;
	}
	.bento-section .magic-bento-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
	}
	.bento-section .magic-bento-card__header,
	.bento-section .magic-bento-card__content {
		display: flex;
		position: relative;
		color: var(--white);
	}
	.bento-section .magic-bento-card__header {
		gap: 0.75em;
		justify-content: space-between;
	}
	.bento-section .magic-bento-card__content { flex-direction: column; }
	.bento-section .magic-bento-card__label { font-size: 16px; }
	.bento-section .magic-bento-card__title,
	.bento-section .magic-bento-card__description {
		--clamp-title: 1;
		--clamp-desc: 2;
	}
	.bento-section .magic-bento-card__title {
		font-weight: 400;
		font-size: 16px;
		margin: 0 0 0.25em;
	}
	.bento-section .magic-bento-card__description {
		font-size: 12px;
		line-height: 1.2;
		opacity: 0.9;
	}
	.bento-section .magic-bento-card--text-autohide .magic-bento-card__title,
	.bento-section .magic-bento-card--text-autohide .magic-bento-card__description {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.bento-section .magic-bento-card--text-autohide .magic-bento-card__title {
		-webkit-line-clamp: var(--clamp-title);
		line-clamp: var(--clamp-title);
	}
	.bento-section .magic-bento-card--text-autohide .magic-bento-card__description {
		-webkit-line-clamp: var(--clamp-desc);
		line-clamp: var(--clamp-desc);
	}

	@media (max-width: 599px) {
		.bento-section .card-grid {
			grid-template-columns: 1fr;
			width: 90%;
			margin: 0 auto;
			padding: 0.5em;
		}
		.bento-section .magic-bento-card { width: 100%; min-height: 180px; }
	}
	@media (min-width: 600px) {
		.bento-section .card-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (min-width: 1024px) {
		.bento-section .card-grid { grid-template-columns: repeat(4, 1fr); }
		.bento-section .magic-bento-card:nth-child(3) { grid-column: span 2; grid-row: span 2; }
		.bento-section .magic-bento-card:nth-child(4) { grid-column: 1 / span 2; grid-row: 2 / span 2; }
		.bento-section .magic-bento-card:nth-child(6) { grid-column: 4; grid-row: 3; }
	}

	.bento-section .magic-bento-card--border-glow::after {
		content: '';
		position: absolute;
		inset: 0;
		padding: 6px;
		background: radial-gradient(
			var(--glow-radius) circle at var(--glow-x) var(--glow-y),
			rgba(255, 138, 76, calc(var(--glow-intensity) * 0.8)) 0%,
			rgba(255, 138, 76, calc(var(--glow-intensity) * 0.4)) 30%,
			transparent 60%
		);
		border-radius: inherit;
		-webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
		mask-composite: exclude;
		pointer-events: none;
		opacity: 1;
		transition: opacity 0.3s ease;
		z-index: 1;
	}
	.bento-section .magic-bento-card--border-glow:hover {
		box-shadow: 0 4px 20px rgba(78, 38, 18, 0.4), 0 0 30px var(--accent-glow);
	}
	.particle-container { position: relative; overflow: hidden; }
	.particle::before {
		content: '';
		position: absolute;
		top: -2px; left: -2px; right: -2px; bottom: -2px;
		background: rgba(255, 138, 76, 0.2);
		border-radius: 50%;
		z-index: -1;
	}
	.bento-section .particle-container:hover {
		box-shadow: 0 4px 20px rgba(78, 38, 18, 0.2), 0 0 30px rgba(255, 138, 76, 0.2);
	}
	.global-spotlight {
		mix-blend-mode: screen;
		will-change: transform, opacity;
		z-index: 200 !important;
		pointer-events: none;
	}


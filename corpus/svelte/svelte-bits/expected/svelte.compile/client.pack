export default function GradientBlindsDemo($$anchor) {
	const D = {
		angle: 0,
		noise: 0.3,
		blindCount: 16,
		blindMinWidth: 60,
		mouseDampening: 0.15,
		mirrorGradient: false,
		spotlightRadius: 0.5,
		spotlightSoftness: 1,
		spotlightOpacity: 1,
		distortAmount: 0,
		shineDirection: 'left'
	};


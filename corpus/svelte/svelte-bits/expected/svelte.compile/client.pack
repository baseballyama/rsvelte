						max: 50,
						step: 1,
						get value() {
							return $.get(borderRadius);
						},
						onChange: (v) => $.set(borderRadius, v, true)
					});

					var node_4 = $.sibling(node_3, 2);

					PreviewSlider(node_4, {
						title: 'Glow Radius',
						min: 10,
						max: 80,
						step: 1,
						get value() {
							return $.get(glowRadius);
						},
						onChange: (v) => $.set(glowRadius, v, true)
					});

					var node_5 = $.sibling(node_4, 2);


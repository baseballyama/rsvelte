						onChange: (v) => $.set(glareSize, v, true)
					});

					var node_5 = $.sibling(node_4, 2);

					PreviewSlider(node_5, {
						title: 'Transition Duration',
						min: 100,
						max: 2000,
						step: 50,
						get value() {
							return $.get(transitionDuration);
						},
						valueUnit: 'ms',
						onChange: (v) => $.set(transitionDuration, v, true)

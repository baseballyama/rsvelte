			type: 'CardNavItem[]',
			default: '-',
			description: 'Array of nav items.'
		},

		{
			name: 'class',
			type: 'string',
			default: '""',
			description: 'Extra classes for the container.'
		},

		{
			name: 'ease',
			type: 'string',
			default: '"power3.out"',
			description: 'GSAP easing function.'
		},

		{
			name: 'baseColor',
			type: 'string',
			default: '"#fff"',
			description: 'Background color of the nav.'

	}

	const usage = $.derived(() => `<ElectricBorder color="${$.get(color)}" speed={${$.get(speed)}} chaos={${$.get(chaos)}} borderRadius={${$.get(borderRadius)}}>
  <div>Your content</div>
</ElectricBorder>`);

	const props = [
		{
			name: 'children',
			type: 'Snippet',
			default: 'required',
			description: 'Content wrapped by the electric border.'
		},


					var fragment_3 = root_2();
					var node_3 = $.first_child(fragment_3);

					PreviewColorPicker(node_3, {
						title: 'Color 1',
						get value() {
							return $.get(color0);
						},
						onChange: (v) => $.set(color0, v, true)
					});


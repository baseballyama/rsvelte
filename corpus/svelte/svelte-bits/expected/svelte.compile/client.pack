			name: 'ease',
			type: 'string',
			default: '"back.inOut(2)"',
			description: 'GSAP easing string.'
		},

		{
			name: 'scrollStart',
			type: 'string',
			default: '"center bottom+=50%"',
			description: 'ScrollTrigger start position.'
		},

		{
			name: 'scrollEnd',
			type: 'string',
			default: '"bottom bottom-=40%"',
			description: 'ScrollTrigger end position.'

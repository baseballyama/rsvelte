class W {
	config;
	positionData;
	velocityData;
	sizeData;
	center = new Vector3();

	constructor(config) {
		this.config = config;
		this.positionData = new Float32Array(3 * config.count);
		this.velocityData = new Float32Array(3 * config.count);
		this.sizeData = new Float32Array(config.count).fill(1);

			planeWidth,
			planeHeight,
			distortion,
			scrollEase,
			cameraFov,
			cameraZ
		}
	) {
		this.container = container;
		this.canvas = canvas;
		this.items = items;
		this.planeWidth = planeWidth;
		this.planeHeight = planeHeight;
		this.distortion = distortion;
		this.scroll = { ease: scrollEase, current: 0, target: 0, last: 0 };

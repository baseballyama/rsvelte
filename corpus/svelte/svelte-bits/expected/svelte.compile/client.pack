			name: "direction",
			type: "'left' | 'right'",
			default: '"left"',
			description: 'Direction the shine travels.'
		},

		{
			name: 'disabled',
			type: 'boolean',
			default: 'false',
			description: 'Disables the effect.'
		},

		{
			name: 'class',
			type: 'string',
			default: '""',

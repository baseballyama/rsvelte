		const vertex = `
			precision highp float;
			attribute vec3 position;
			attribute vec3 next;
			attribute vec3 prev;
			attribute vec2 uv;
			attribute float side;
			uniform vec2 uResolution;
			uniform float uDPR;
			uniform float uThickness;
			uniform float uTime;

						},
						onChange: (v) => $.set(beamNumber, v, true)
					});

					var node_5 = $.sibling(node_4, 2);

					PreviewSlider(node_5, {
						title: 'Beam Width',
						min: 0.5,
						max: 10,
						step: 0.1,
						get value() {

			BubbleMenu(node_1, {
				get logo() {
					return logo;
				},

				get menuBg() {
					return $.get(menuBg);
				},

				get menuContentColor() {
					return $.get(menuContentColor);
				},

				get animationEase() {
					return $.get(animationEase);
				},

				get animationDuration() {
					return $.get(animationDuration);
				},


				},

				get rotateOnHover() {
					return $.get(rotateOnHover);
				},

				get forceHoverState() {
					return $.get(forceHoverState);
				},

				get backgroundColor() {
					return $.get(backgroundColor);
				}
			});

			var node_2 = $.sibling(node_1, 2);

			BackgroundContentToggle(node_2, {
				get showContent() {
					return $.get(showContent);
				},

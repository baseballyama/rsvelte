export default function AITerminal($$anchor, $$props) {
	$.push($$props, true);

	const AI_CONVOS = [
		{
			q: 'add a glowing card',
			lines: [
				{ cls: 'kw', text: 'import ' },
				{ cls: 'comp', text: 'BorderGlow' },
				{ cls: 'kw', text: ' from ' },

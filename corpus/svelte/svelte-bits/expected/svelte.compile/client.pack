  width={${$.get(width)}}
  weight={${$.get(weight)}}
  italic={${$.get(italic)}}
  textColor="${$.get(textColor)}"
  strokeColor="${$.get(strokeColor)}"
  minFontSize={36}
/>`);

	const props = [
		{

import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import * as THREE from 'three';

var root = $.from_html(`<div></div>`);

export default function Antigravity($$anchor, $$props) {
	$.push($$props, true);

	let count = $.prop($$props, 'count', 3, 300),
		magnetRadius = $.prop($$props, 'magnetRadius', 3, 10),
		ringRadius = $.prop($$props, 'ringRadius', 3, 10),
		waveSpeed = $.prop($$props, 'waveSpeed', 3, 0.4),
		waveAmplitude = $.prop($$props, 'waveAmplitude', 3, 1),
		particleSize = $.prop($$props, 'particleSize', 3, 2),
		lerpSpeed = $.prop($$props, 'lerpSpeed', 3, 0.1),
		color = $.prop($$props, 'color', 3, '#FF9FFC'),
		autoAnimate = $.prop($$props, 'autoAnimate', 3, false),
		particleVariance = $.prop($$props, 'particleVariance', 3, 1),
		rotationSpeed = $.prop($$props, 'rotationSpeed', 3, 0),
		depthFactor = $.prop($$props, 'depthFactor', 3, 1),
		pulseSpeed = $.prop($$props, 'pulseSpeed', 3, 3),
		particleShape = $.prop($$props, 'particleShape', 3, 'capsule'),
		fieldStrength = $.prop($$props, 'fieldStrength', 3, 10),
		className = $.prop($$props, 'class', 3, '');

	let host;

	$.user_effect(() => {
		if (!host) return;

		const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });

		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		renderer.setClearColor(0x000000, 0);
		host.appendChild(renderer.domElement);
		renderer.domElement.style.display = 'block';
		renderer.domElement.style.width = '100%';
		renderer.domElement.style.height = '100%';

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 1000);

		camera.position.set(0, 0, 50);

		let geom;

		switch (particleShape()) {
			case 'sphere':
				geom = new THREE.SphereGeometry(0.2, 16, 16);
				break;

			case 'box':
				geom = new THREE.BoxGeometry(0.3, 0.3, 0.3);
				break;

			case 'tetrahedron':
				geom = new THREE.TetrahedronGeometry(0.3);
				break;

			default:
				geom = new THREE.CapsuleGeometry(0.1, 0.4, 4, 8);
		}

		const mat = new THREE.MeshBasicMaterial({ color: color() });
		const mesh = new THREE.InstancedMesh(geom, mat, count());

		scene.add(mesh);

		const dummy = new THREE.Object3D();
		let viewportW = 100;
		let viewportH = 100;

		const computeViewport = () => {
			const dist = camera.position.z;
			const fov = camera.fov * Math.PI / 180;

			viewportH = 2 * Math.tan(fov / 2) * dist;
			viewportW = viewportH * camera.aspect;
		};

		const particles = Array.from({ length: count() }, () => ({
			t: Math.random() * 100,
			speed: 0.01 + Math.random() / 200,
			mx: 0,
			my: 0,
			mz: 0,
			cx: 0,
			cy: 0,
			cz: 0,
			randomRadiusOffset: (Math.random() - 0.5) * 2
		}));

		const initParticles = () => {
			for (const p of particles) {
				p.mx = p.cx = (Math.random() - 0.5) * viewportW;
				p.my = p.cy = (Math.random() - 0.5) * viewportH;
				p.mz = p.cz = (Math.random() - 0.5) * 20;
			}
		};

		const resize = () => {

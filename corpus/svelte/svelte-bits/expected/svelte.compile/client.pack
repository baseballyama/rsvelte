			get hasChanges() {
				return $.get(hasChanges);
			},
			componentName: 'CountUp',
			get usage() {
				return $.get(usage);
			},

			get source() {
				return countUpSource;
			},

			get props() {
				return props;
			},
			preview,
			code,
			customize,
			propTable,
			$$slots: { preview: true, code: true, customize: true, propTable: true }

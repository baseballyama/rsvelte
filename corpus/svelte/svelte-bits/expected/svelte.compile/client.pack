import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { onMount } from 'svelte';
import * as THREE from 'three';

var root = $.from_html(`<div class="relative h-full w-full"></div>`);

export default function Dither($$anchor, $$props) {
	$.push($$props, true);

	let waveSpeed = $.prop($$props, 'waveSpeed', 3, 0.05),
		waveFrequency = $.prop($$props, 'waveFrequency', 3, 3),
		waveAmplitude = $.prop($$props, 'waveAmplitude', 3, 0.3),
		waveColor = $.prop($$props, 'waveColor', 19, () => [0.5, 0.5, 0.5]),
		colorNum = $.prop($$props, 'colorNum', 3, 4),
		pixelSize = $.prop($$props, 'pixelSize', 3, 2),
		disableAnimation = $.prop($$props, 'disableAnimation', 3, false),
		enableMouseInteraction = $.prop($$props, 'enableMouseInteraction', 3, true),
		mouseRadius = $.prop($$props, 'mouseRadius', 3, 1);

	let containerRef;

	const current = $.derived(() => ({
		waveSpeed: waveSpeed(),
		waveFrequency: waveFrequency(),
		waveAmplitude: waveAmplitude(),
		waveColor: waveColor(),
		colorNum: colorNum(),
		pixelSize: pixelSize(),
		disableAnimation: disableAnimation(),
		enableMouseInteraction: enableMouseInteraction(),
		mouseRadius: mouseRadius()
	}));


					return $.get(rotate);
				},

				get width() {
					return $.get(width);
				},

				get peelBackHoverPct() {
					return $.get(peelBackHoverPct);
				},

				get peelBackActivePct() {
					return $.get(peelBackActivePct);
				},

				get lightingIntensity() {
					return $.get(lightingIntensity);
				},

				get shadowIntensity() {
					return $.get(shadowIntensity);
				},

				get peelDirection() {
					return $.get(peelDirection);
				}
			});

			$.reset(div);
			$.append($$anchor, div);
		};

		const code = ($$anchor) => {

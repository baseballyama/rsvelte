	let typed = $.state('');
	let phase = $.state('prompt');
	let codeLines = $.state(0);
	let timers = [];
	const conv = $.derived(() => AI_CONVOS[$.get(idx)]);

	function clearTimers() {
		timers.forEach(clearTimeout);
		timers = [];
	}

	function schedule(fn, ms) {
		const id = setTimeout(fn, ms);

		timers.push(id);
	}

	function runConvo(i) {
		const c = AI_CONVOS[i];

		$.set(typed, '');
		$.set(phase, 'prompt');
		$.set(codeLines, 0);


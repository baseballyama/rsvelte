	let styles;

	$.bind_this(div, ($$value) => containerRef = $$value, () => containerRef);

	$.template_effect(() => {
		$.set_class(div, 1, `relative h-full w-full overflow-hidden ${className() ?? ''}`);
		styles = $.set_style(div, '', styles, { 'mix-blend-mode': mixBlendMode() });
	});

	$.append($$anchor, div);
	$.pop();
}

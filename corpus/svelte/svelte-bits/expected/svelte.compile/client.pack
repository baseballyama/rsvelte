	let noise = $.state($.proxy(D.noise));
	let blindCount = $.state($.proxy(D.blindCount));
	let blindMinWidth = $.state($.proxy(D.blindMinWidth));
	let mouseDampening = $.state($.proxy(D.mouseDampening));

import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';
import { onMount } from 'svelte';
import * as THREE from 'three';

var root = $.from_html(`<div class="relative h-full w-full"></div>`);

export default function Silk($$anchor, $$props) {
	$.push($$props, true);

	let speed = $.prop($$props, 'speed', 3, 5),
		scale = $.prop($$props, 'scale', 3, 1),
		color = $.prop($$props, 'color', 3, '#7B7481'),
		noiseIntensity = $.prop($$props, 'noiseIntensity', 3, 1.5),
		rotation = $.prop($$props, 'rotation', 3, 0);

	const current = $.derived(() => ({
		speed: speed(),
		scale: scale(),
		color: color(),
		noiseIntensity: noiseIntensity(),
		rotation: rotation()
	}));

	let container;

	function hexToRgb(hex) {
		const clean = hex.replace('#', '');

		return [
			parseInt(clean.slice(0, 2), 16) / 255,
			parseInt(clean.slice(2, 4), 16) / 255,
			parseInt(clean.slice(4, 6), 16) / 255
		];
	}

	const vertexShader = `
varying vec2 vUv;
varying vec3 vPosition;

void main() {
  vPosition = position;
  vUv = uv;
  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
}
`;

	const fragmentShader = `
varying vec2 vUv;

	const usage = $.derived(() => `${sO}
  import GridScan from '$lib/components/GridScan.svelte';
${sC}

<div style="width: 100%; height: 600px; position: relative;">
  <GridScan linesColor="${$.get(linesColor)}" scanColor="${$.get(scanColor)}" />
</div>`);

	const props = [
		{

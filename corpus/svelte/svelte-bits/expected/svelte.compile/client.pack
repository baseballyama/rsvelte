					return props;
				}
			});
		};

		TabsLayout(node, {
			onreset: reset,
			get hasChanges() {
				return $.get(hasChanges);
			},
			componentName: 'TargetCursor',
			get usage() {
				return $.get(usage);
			},

			get source() {
				return source;
			},

			get props() {

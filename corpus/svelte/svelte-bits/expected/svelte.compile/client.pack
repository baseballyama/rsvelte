		{
			name: 'patternScaleY',
			type: 'number',
			default: '1',
			description: 'Scaling factor for the Y-axis of the grain pattern.'
		},

		{
			name: 'patternRefreshInterval',
			type: 'number',
			default: '2',
			description: 'Number of frames between regenerations of the grain.'
		},


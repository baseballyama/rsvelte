		baseThickness = $.prop($$props, 'baseThickness', 3, 30),
		offsetFactor = $.prop($$props, 'offsetFactor', 3, 0.05),
		maxAge = $.prop($$props, 'maxAge', 3, 500),
		pointCount = $.prop($$props, 'pointCount', 3, 50),

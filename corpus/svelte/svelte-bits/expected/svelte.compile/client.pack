			q: 'animate hero text',
			lines: [
				{ cls: 'kw', text: 'import ' },
				{ cls: 'comp', text: 'SplitText' },
				{ cls: 'kw', text: ' from ' },
				{ cls: 'str', text: '"./SplitText"' }
			],
			jsx: [
				{ cls: 'tag', text: '<' },
				{ cls: 'comp', text: 'SplitText' },
				{ cls: 'attr', text: ' animation' },
				{ cls: 'punc', text: '=' },
				{ cls: 'str', text: '"fadeUp"' },
				{ cls: 'tag', text: ' />' }
			]

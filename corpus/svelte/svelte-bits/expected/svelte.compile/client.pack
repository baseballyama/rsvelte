						title: 'Color 3',
						get value() {
							return $.get(color2);
						},
						onChange: (v) => $.set(color2, v, true)
					});

					var node_6 = $.sibling(node_5, 2);

					PreviewSlider(node_6, {
						title: 'Mouse Force',
						min: 0,
						max: 60,
						step: 1,
						get value() {
							return $.get(mouseForce);
						},
						onChange: (v) => $.set(mouseForce, v, true)
					});

					var node_7 = $.sibling(node_6, 2);


  import ScrollFloat from '$lib/components/ScrollFloat.svelte';
${scriptClose}

<div class="h-[200vh]">
  <ScrollFloat
    children="${$.get(children)}"
    animationDuration={${$.get(animationDuration)}}
    stagger={${$.get(stagger)}}
    ease="${$.get(ease)}"
  />
</div>`);


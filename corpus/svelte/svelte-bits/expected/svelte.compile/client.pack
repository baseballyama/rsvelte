var root_2 = $.from_html(`<h1 class="sub-category">Prismatic Burst</h1> <!>`, 1);

export default function PrismaticBurstDemo($$anchor) {
	const D = {
		intensity: 2,
		speed: 0.5,
		animationType: 'rotate3d',
		distort: 0,
		paused: false,
		hoverDampness: 0,
		rayCount: 0

			$.document.title = 'Flying Posters - svelte-bits';
		});
	});

	var node = $.sibling($.first_child(fragment), 2);

	{
		const preview = ($$anchor) => {
			var div = root();
			var node_1 = $.child(div);

			$.key(node_1, () => $.get(renderKey), ($$anchor) => {
				FlyingPosters($$anchor, {

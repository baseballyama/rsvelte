					var node_3 = $.sibling(node_2, 2);

					PreviewSlider(node_3, {
						title: 'Glare Opacity',
						min: 0,
						max: 1,
						step: 0.05,
						get value() {
							return $.get(glareOpacity);
						},
						onChange: (v) => $.set(glareOpacity, v, true)
					});

					var node_4 = $.sibling(node_3, 2);

					PreviewSlider(node_4, {
						title: 'Glare Size',
						min: 50,
						max: 500,
						step: 10,
						get value() {
							return $.get(glareSize);

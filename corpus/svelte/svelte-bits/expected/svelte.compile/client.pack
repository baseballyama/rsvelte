		const scene = new Transform();

		mesh.setParent(scene);

		const effective = Math.min(ballCount(), 50);
		const ballParams = [];

		for (let i = 0; i < effective; i++) {
			const h1 = hash31(i + 1);
			const st = h1[0] * (2 * Math.PI);

						return $.get(scrollEase);
					},

					get cameraFov() {
						return $.get(cameraFov);
					},

					get cameraZ() {
						return $.get(cameraZ);
					}
				});
			});

			$.next(2);
			$.reset(div);
			$.append($$anchor, div);
		};

		const code = ($$anchor) => {
			DemoCodeTab($$anchor, {
				slug: 'flying-posters',
				usage: $.get(usage),
				get source() {
					return source;
				}
			});
		};

		const customize = ($$anchor) => {
			Customize($$anchor, {
				children: ($$anchor, $$slotProps) => {
					var fragment_4 = root_1();
					var node_2 = $.first_child(fragment_4);

					PreviewSlider(node_2, {
						title: 'Plane Width',
						min: 300,
						max: 400,
						step: 10,
						get value() {
							return $.get(planeWidth);
						},

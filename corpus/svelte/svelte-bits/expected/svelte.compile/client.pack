					PreviewSelect(node_2, {
						title: 'Ease',
						get value() {
							return $.get(animationEase);
						},

						options: [
							{ label: 'back.out(1.5)', value: 'back.out(1.5)' },
							{ label: 'power3.out', value: 'power3.out' },
							{ label: 'power2.out', value: 'power2.out' },

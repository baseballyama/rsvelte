		function median(buf) {
			if (buf.length === 0) return 0;

			const a = [...buf].sort((x, y) => x - y);
			const mid = Math.floor(a.length / 2);

			return a.length % 2 ? a[mid] : (a[mid - 1] + a[mid]) * 0.5;

					color: colorful ? 'orange' : '#444',
					label: 'Notes'
				},

				{
					icon: barChart,
					color: colorful ? 'green' : '#444',
					label: 'Stats'
				}
			];

			$$renderer.push(`<div class="demo-container" style="position:relative;display:flex;align-items:center;justify-content:center;min-height:500px;overflow:hidden;">`);

			intensity = 2,
			speed = 0.5,
			animationType = 'rotate3d',
			colors,
			distort = 0,
			paused = false,
			offset = { x: 0, y: 0 },
			hoverDampness = 0,
			rayCount,
			mixBlendMode = 'lighten'

	$$renderer.push(`<h1 class="sub-category">Prism</h1> `);

	{
		function preview($$renderer) {
			$$renderer.push(`<div class="relative h-[500px] w-full overflow-hidden rounded-[14px]"><!---->`);

			{
				Prism($$renderer, {

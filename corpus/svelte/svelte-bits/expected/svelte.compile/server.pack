						onChange: (v) => coneSpread = v
					});

					$$renderer.push(`<!----> `);

					PreviewSwitch($$renderer, {
						title: 'Animated Intro',
						checked: animated,
						onChange: (v) => {
							animated = v;
							key++;
						}
					});

					$$renderer.push(`<!----> `);

					PreviewColorPicker($$renderer, {
						title: 'Background',
						value: backgroundColor,
						onChange: (v) => backgroundColor = v
					});

					$$renderer.push(`<!----> `);

					PreviewColorPicker($$renderer, {
						title: 'Color 1',
						value: colors[0],
						onChange: (v) => colors = [v, colors[1], colors[2]]
					});

					$$renderer.push(`<!----> `);

					PreviewColorPicker($$renderer, {
						title: 'Color 2',
						value: colors[1],
						onChange: (v) => colors = [colors[0], v, colors[2]]
					});

					$$renderer.push(`<!----> `);

					PreviewColorPicker($$renderer, {
						title: 'Color 3',
						value: colors[2],
						onChange: (v) => colors = [colors[0], colors[1], v]
					});

					$$renderer.push(`<!---->`);
				},
				$$slots: { default: true }
			});
		}

		function propTable($$renderer) {
			PropTable($$renderer, { rows: props });
		}

		TabsLayout($$renderer, {

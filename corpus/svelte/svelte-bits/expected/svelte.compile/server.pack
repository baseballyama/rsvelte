			const target = !openRef;

			openRef = target;
			open = target;

			if (target) {
				onMenuOpen?.();
				playOpen();
			} else {
				onMenuClose?.();
				playClose();
			}

			animateIcon(target);
			animateColor(target);
			animateText(target);
		}

		function closeMenu() {
			if (openRef) {
				openRef = false;
				open = false;

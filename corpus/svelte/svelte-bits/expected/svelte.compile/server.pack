			type: 'string',
			default: '"black"',
			description: 'Starting color for the gradient overlays.'
		},

		{
			name: 'gradientTo',
			type: 'string',
			default: '"transparent"',
			description: 'Ending color for the gradient overlays.'
		}
	];

	$.head('h70fqo', $$renderer, ($$renderer) => {

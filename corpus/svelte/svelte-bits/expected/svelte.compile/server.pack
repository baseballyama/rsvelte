						onChange: (v) => waveSpeed = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Wave Frequency',
						min: 0.5,
						max: 10,
						step: 0.1,
						value: waveFrequency,
						onChange: (v) => waveFrequency = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Wave Amplitude',

			lineJitter,
			scanDirection,
			bloomIntensity,
			bloomThreshold,
			bloomSmoothing,
			chromaticAberration,
			noiseIntensity,
			scanGlow,
			scanSoftness,
			scanPhaseTaper,
			scanDuration,
			scanDelay,
			enableGyro,
			scanOnClick,
			snapBackDelay,

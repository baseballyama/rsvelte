					PreviewSlider($$renderer, {
						title: 'Gap',
						min: 0,
						max: 50,
						step: 10,
						value: gap,
						onChange: (v) => gap = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Font Size',
						min: 40,
						max: 200,
						step: 10,
						value: fontSize,
						onChange: (v) => fontSize = v

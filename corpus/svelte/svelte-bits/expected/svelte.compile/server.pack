					$$renderer.push(`<!----> `);
					PreviewColorPicker($$renderer, { title: 'Color 3', value: color3, onChange: (v) => color3 = v });
					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Time Speed',
						min: 0,
						max: 2,
						step: 0.05,
						value: timeSpeed,
						onChange: (v) => timeSpeed = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {

		}
	];

	$.head('1g3g70l', $$renderer, ($$renderer) => {
		$$renderer.title(($$renderer) => {
			$$renderer.push(`<title>Grainient - svelte-bits</title>`);
		});
	});

	$$renderer.push(`<h1 class="sub-category">Grainient</h1> `);

	{

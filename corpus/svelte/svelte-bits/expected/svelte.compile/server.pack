						onChange: (v) => rerender((next) => scale = next, v)
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Digit Size',
						min: 0.5,
						max: 3,
						step: 0.1,
						value: digitSize,
						onChange: (v) => rerender((next) => digitSize = next, v)
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Speed',
						min: 0,
						max: 3,
						step: 0.1,
						value: timeScale,
						onChange: (v) => rerender((next) => timeScale = next, v)
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Noise Amplitude',
						min: 0.5,
						max: 1,
						step: 0.1,
						value: noiseAmp,
						onChange: (v) => rerender((next) => noiseAmp = next, v)
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Brightness',
						min: 0.1,
						max: 1,
						step: 0.1,
						value: brightness,
						onChange: (v) => rerender((next) => brightness = next, v)
					});


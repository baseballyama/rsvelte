		.pc-handle.svelte-1qk9xnc {
			font-size: 11px;
		}
		.pc-status.svelte-1qk9xnc {
			font-size: 8px;
		}
		.pc-contact-btn.svelte-1qk9xnc {
			padding: 4px 8px;
			font-size: 9px;
			border-radius: 50px;
		}
	}


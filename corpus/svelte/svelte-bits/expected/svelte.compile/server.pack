		let containerRef;

		const current = $.derived(() => ({
			timeSpeed,
			colorBalance,
			warpStrength,
			warpFrequency,
			warpSpeed,
			warpAmplitude,
			blendAngle,
			blendSoftness,
			rotationAmount,
			noiseScale,
			grainAmount,
			grainScale,
			grainAnimated,
			contrast,
			gamma,
			saturation,
			centerX,
			centerY,
			zoom,
			color1,
			color2,
			color3
		}));

		function hexToRgb(hex) {
			const r = (/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i).exec(hex);

			return r
				? [
					parseInt(r[1], 16) / 255,
					parseInt(r[2], 16) / 255,
					parseInt(r[3], 16) / 255

import {
	BloomEffect,
	EffectComposer,
	EffectPass,
	RenderPass,
	SMAAEffect,
	SMAAPreset
} from 'postprocessing';

import * as THREE from 'three';

export const hyperspeedPresets = {
	one: {
		onSpeedUp: () => {},
		onSlowDown: () => {},
		distortion: 'turbulentDistortion',
		length: 400,
		roadWidth: 10,

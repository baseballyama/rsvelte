				constructor(a, b, c) {
					this.a = a;
					this.b = b;
					this.c = c;
				}
			}

			class Vertex {
				position;
				normal;
				uv;

				constructor(x, y, z) {
					this.position = vec3.fromValues(x, y, z);
					this.normal = vec3.create();
					this.uv = vec2.create();

			default: '1.5',
			description: 'Contrast multiplier.'
		},

		{
			name: 'gamma',
			type: 'number',
			default: '1',
			description: 'Gamma correction.'
		},

		{
			name: 'saturation',
			type: 'number',
			default: '1',

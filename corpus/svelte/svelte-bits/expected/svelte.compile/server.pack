			type: 'number',
			default: '750',
			description: 'Inertia resistance.'
		},

		{
			name: 'returnDuration',
			type: 'number',
			default: '1.5',
			description: 'Return animation duration.'
		}
	];

	$.head('15m2iy1', $$renderer, ($$renderer) => {
		$$renderer.title(($$renderer) => {

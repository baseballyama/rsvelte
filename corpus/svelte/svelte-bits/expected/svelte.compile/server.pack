					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Size',
						min: 0.5,
						max: 4,
						step: 0.1,
						value: size,
						onChange: (v) => size = v
					});

					$$renderer.push(`<!---->`);
				},
				$$slots: { default: true }
			});
		}

		function propTable($$renderer) {

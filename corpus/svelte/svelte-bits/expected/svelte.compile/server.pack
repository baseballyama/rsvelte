	let warpFrequency = D.warpFrequency;
	let warpSpeed = D.warpSpeed;
	let grainAmount = D.grainAmount;
	let contrast = D.contrast;
	let saturation = D.saturation;
	let zoom = D.zoom;
	let grainAnimated = D.grainAnimated;
	let color1 = D.color1;
	let color2 = D.color2;
	let color3 = D.color3;
	let showContent = true;
	const sO = '<' + 'script lang="ts">';
	const sC = '</' + 'script>';
	const hasChanges = $.derived(() => timeSpeed !== D.timeSpeed || warpStrength !== D.warpStrength || warpFrequency !== D.warpFrequency || warpSpeed !== D.warpSpeed || grainAmount !== D.grainAmount || contrast !== D.contrast || saturation !== D.saturation || zoom !== D.zoom || grainAnimated !== D.grainAnimated || color1 !== D.color1 || color2 !== D.color2 || color3 !== D.color3);

	function reset() {
		timeSpeed = D.timeSpeed;
		warpStrength = D.warpStrength;
		warpFrequency = D.warpFrequency;
		warpSpeed = D.warpSpeed;
		grainAmount = D.grainAmount;
		contrast = D.contrast;
		saturation = D.saturation;
		zoom = D.zoom;

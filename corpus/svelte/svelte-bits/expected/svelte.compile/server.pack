		}

		$$renderer.push(`<!--]--> <!--[-->`);

		const each_array = $.ensure_array_like(images);

		for (let i = 0, $$length = each_array.length; i < $$length; i++) {
			let src = each_array[i];
			const itemOffset = fill ? i / totalItems() * 100 : 0;

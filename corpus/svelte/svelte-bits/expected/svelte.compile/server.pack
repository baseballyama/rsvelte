export default function PreviewSwitch($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let { title = '', checked = false, isDisabled = false, onChange } = $$props;

		function toggle() {
			if (isDisabled) return;

			onChange?.(!checked);
		}


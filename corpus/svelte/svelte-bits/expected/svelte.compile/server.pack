${sC}

<div style="width: 100%; height: 600px; position: relative;">
  <GridDistortion imageSrc="..." grid={${grid}} mouse={${mouse}} strength={${strength}} relaxation={${relaxation}} />
</div>`);

	const props = [
		{
			name: 'grid',
			type: 'number',
			default: '15',
			description: 'Grid resolution.'
		},

		{

					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Duration',
						min: 0.1,
						max: 3,
						step: 0.1,
						value: duration,
						valueUnit: 's',
						onChange: (v) => duration = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Delay',
						min: 0,
						max: 2,
						step: 0.05,
						value: delay,
						valueUnit: 's',
						onChange: (v) => delay = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Initial Opacity',
						min: 0,
						max: 1,
						step: 0.05,
						value: initialOpacity,
						onChange: (v) => initialOpacity = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Scale',
						min: 0.5,
						max: 2,
						step: 0.05,
						value: scale,
						onChange: (v) => scale = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Threshold',
						min: 0,
						max: 1,
						step: 0.05,
						value: threshold,
						onChange: (v) => threshold = v
					});

					$$renderer.push(`<!----> `);

					PreviewSwitch($$renderer, {
						title: 'Reverse',
						checked: reverse,
						onChange: (v) => reverse = v
					});

					$$renderer.push(`<!----> `);

					PreviewSwitch($$renderer, {
						title: 'Animate Opacity',
						checked: animateOpacity,
						onChange: (v) => animateOpacity = v
					});

					$$renderer.push(`<!---->`);
				},
				$$slots: { default: true }
			});
		}

		function propTable($$renderer) {
			PropTable($$renderer, { rows: props });
		}

		TabsLayout($$renderer, {
			onreset: reset,
			hasChanges: hasChanges(),
			componentName: 'AnimatedContent',
			usage: usage(),
			source,
			props,
			preview,
			code,
			customize,
			propTable,
			$$slots: { preview: true, code: true, customize: true, propTable: true }
		});
	}

	$$renderer.push(`<!---->`);
}

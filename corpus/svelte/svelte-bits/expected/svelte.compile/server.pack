			description: "The duration of the scramble effect on a character."
		},

		{
			name: "speed",
			type: "number",
			default: "0.5",
			description: "The speed of the scramble animation."
		},

		{
			name: "scrambleChars",
			type: "string",
			default: "'.:'",
			description: "The characters used for scrambling."
		},


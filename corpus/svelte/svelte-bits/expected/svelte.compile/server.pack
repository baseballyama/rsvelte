			type: 'number',
			default: '0',
			description: 'Color blend angle.'
		},

		{
			name: 'blendSoftness',
			type: 'number',
			default: '0.05',
			description: 'Color blend softness.'
		},

		{
			name: 'rotationAmount',
			type: 'number',
			default: '500',
			description: 'Noise-driven rotation.'
		},

		{

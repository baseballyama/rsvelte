						max: 16,
						step: 1,
						value: colorNum,
						onChange: (v) => colorNum = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Pixel Size',
						min: 1,
						max: 10,
						step: 1,
						value: pixelSize,
						onChange: (v) => pixelSize = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Mouse Radius',
						min: 0.1,

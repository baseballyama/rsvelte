			type: 'number',
			default: '1',
			description: 'Size of the bolt pattern.'
		}
	];

	$.head('1nlqon2', $$renderer, ($$renderer) => {
		$$renderer.title(($$renderer) => {
			$$renderer.push(`<title>Lightning - svelte-bits</title>`);
		});
	});


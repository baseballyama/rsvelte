		}

		function customize($$renderer) {
			Customize($$renderer, {
				children: ($$renderer) => {
					PreviewSwitch($$renderer, {
						title: 'Enable Blur',
						checked: enableBlur,
						onChange: (v) => {
							enableBlur = v;
							rerender();
						}
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Blur Strength',
						min: 0,
						max: 15,
						step: 1,
						value: blurStrength,
						onChange: (v) => {
							blurStrength = v;
							rerender();
						}
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Starting Opacity',
						min: 0,
						max: 1,
						step: 0.1,
						value: baseOpacity,
						onChange: (v) => {
							baseOpacity = v;
							rerender();
						}
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Starting Rotation',
						min: 0,
						max: 10,
						step: 1,
						value: baseRotation,
						valueUnit: '°',
						onChange: (v) => {
							baseRotation = v;
							rerender();
						}
					});

					$$renderer.push(`<!---->`);
				},
				$$slots: { default: true }
			});
		}

		function propTable($$renderer) {
			PropTable($$renderer, { rows: props });
		}

		TabsLayout($$renderer, {
			onreset: reset,
			hasChanges: hasChanges(),
			componentName: 'ScrollReveal',
			usage: usage(),
			source,
			props,
			preview,
			code,

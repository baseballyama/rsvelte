				waveSpeed,
				waveFrequency,
				waveAmplitude,
				colorNum,
				pixelSize,
				disableAnimation,
				enableMouseInteraction,
				mouseRadius,
				waveColor: [1.0, 0.541, 0.298]
			});

			$$renderer.push(`<!----> `);

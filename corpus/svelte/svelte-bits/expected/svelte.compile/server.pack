					PreviewColorPicker($$renderer, {
						title: 'Glare Color',
						value: glareColor,
						onChange: (v) => glareColor = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Glare Opacity',
						min: 0,
						max: 1,
						step: 0.05,
						value: glareOpacity,
						onChange: (v) => glareOpacity = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Glare Size',
						min: 50,
						max: 500,
						step: 10,
						value: glareSize,
						onChange: (v) => glareSize = v

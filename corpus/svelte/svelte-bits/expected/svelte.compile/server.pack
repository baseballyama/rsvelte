					PreviewSlider($$renderer, {
						title: 'Spin Amount',
						min: 0,
						max: 1,
						step: 0.01,
						value: spinAmount,
						onChange: (v) => spinAmount = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Pixel Filter',
						min: 50,
						max: 2000,
						step: 1,
						value: pixelFilter,
						onChange: (v) => pixelFilter = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Spin Ease',
						min: 0,
						max: 5,
						step: 0.05,
						value: spinEase,
						onChange: (v) => spinEase = v
					});

					$$renderer.push(`<!----> `);

					PreviewSwitch($$renderer, {
						title: 'Rotate Over Time',
						checked: isRotate,
						onChange: (v) => isRotate = v
					});

					$$renderer.push(`<!----> `);

					PreviewSwitch($$renderer, {
						title: 'Mouse Interaction',
						checked: mouseInteraction,
						onChange: (v) => mouseInteraction = v
					});

					$$renderer.push(`<!---->`);
				},
				$$slots: { default: true }
			});
		}

		function propTable($$renderer) {
			PropTable($$renderer, { rows: props });

	.effect.svelte-3hotau { position: absolute; opacity: 1; pointer-events: none; display: grid; place-items: center; z-index: 1; }
	.effect.text.svelte-3hotau { color: white; transition: color 0.3s ease; }
	.effect.text.active { color: black; }
	.effect.filter.svelte-3hotau { filter: blur(7px) contrast(100) blur(0); mix-blend-mode: lighten; }
	.effect.filter.svelte-3hotau::before { content: ""; position: absolute; inset: -75px; z-index: -2; background: black; }

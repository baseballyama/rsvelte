				shadowIntensity,
				peelDirection
			});

			$$renderer.push(`<!----></div>`);
		}

		function code($$renderer) {
			DemoCodeTab($$renderer, { slug: 'sticker-peel', usage: usage(), source });
		}

		function customize($$renderer) {
			Customize($$renderer, {
				children: ($$renderer) => {
					PreviewSlider($$renderer, {
						title: 'Rotate',
						min: -180,
						max: 180,
						step: 1,
						value: rotate,
						valueUnit: '°',
						onChange: (v) => rotate = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Width',
						min: 80,
						max: 400,
						step: 5,
						value: width,
						valueUnit: 'px',
						onChange: (v) => width = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Peel Back Hover %',
						min: 0,
						max: 100,
						step: 1,
						value: peelBackHoverPct,
						valueUnit: '%',
						onChange: (v) => peelBackHoverPct = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Peel Back Active %',
						min: 0,
						max: 100,
						step: 1,
						value: peelBackActivePct,
						valueUnit: '%',
						onChange: (v) => peelBackActivePct = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Lighting Intensity',
						min: 0,
						max: 1,
						step: 0.05,
						value: lightingIntensity,
						onChange: (v) => lightingIntensity = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Shadow Intensity',
						min: 0,
						max: 1,
						step: 0.05,
						value: shadowIntensity,
						onChange: (v) => shadowIntensity = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Peel Direction',
						min: -180,
						max: 180,
						step: 1,
						value: peelDirection,
						valueUnit: '°',
						onChange: (v) => peelDirection = v
					});

					$$renderer.push(`<!---->`);
				},

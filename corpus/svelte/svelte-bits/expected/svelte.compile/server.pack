import * as $ from 'svelte/internal/server';
import { onMount } from 'svelte';
import { motionValue, animate } from 'motion';

export default function ElasticSlider($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let {
			defaultValue = 50,
			startingValue = 0,
			maxValue = 100,

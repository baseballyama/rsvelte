			noiseScale = 0.5,
			chromaticSpread = 2,
			mouseAnimation = false,
			distortion = 1,
			contour = 0.2,
			tintColor = '#feb3ff'
		} = $$props;

		let canvas;

		$$renderer.push(`<canvas class="block h-full w-full object-contain"></canvas>`);

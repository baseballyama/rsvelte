			if (typeof v === 'number') return v;

			const num = parseFloat(String(v).trim().replace('px', ''));

			return isNaN(num) ? 0 : num;
		};

		onMount(() => {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);

			const renderer = new Renderer({
				dpr,
				alpha: true,
				premultipliedAlpha: false,
				antialias: false

			type: 'number',
			default: '0.2',
			description: 'Animation speed.'
		},

		{
			name: 'amplitude',
			type: 'number',
			default: '0.5',
			description: 'Wave amplitude.'
		},

		{
			name: 'frequencyX',
			type: 'number',
			default: '3',
			description: 'X-axis frequency.'
		},

		{
			name: 'frequencyY',
			type: 'number',
			default: '2',
			description: 'Y-axis frequency.'
		},

		{
			name: 'interactive',
			type: 'boolean',
			default: 'true',
			description: 'Pointer interaction.'
		}
	];

	$.head('1i0kxx8', $$renderer, ($$renderer) => {

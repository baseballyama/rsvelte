						$$renderer.push(`<!----> `);

						PreviewSlider($$renderer, {
							title: 'Background Opacity',
							min: 0,
							max: 1,
							step: 0.01,
							value: backgroundOpacity,
							onChange: (v) => backgroundOpacity = v
						});

						$$renderer.push(`<!----> `);

						PreviewSlider($$renderer, {

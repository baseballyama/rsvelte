			const finished = controls.finished;

			if (finished && typeof finished.then === 'function') finished.then(finalize, finalize); else finalize();
		}

		function markExiting(item) {
			if (item.exiting) return;

			item.exiting = true;
			startExitAnimation(item);
		}


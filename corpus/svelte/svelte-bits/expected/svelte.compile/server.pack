			type: 'number',
			default: '2',
			description: 'Vignette strength.'
		},

		{
			name: 'glowIntensity',
			type: 'number',
			default: '0.1',
			description: 'Glow intensity.'
		},

		{
			name: 'opacity',
			type: 'number',
			default: '1',
			description: 'Overall opacity.'
		},

		{

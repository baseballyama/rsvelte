			type: 'number',
			default: '5',
			description: 'Warp frequency.'
		},

		{
			name: 'warpSpeed',
			type: 'number',
			default: '2',
			description: 'Warp animation speed.'
		},

		{
			name: 'warpAmplitude',
			type: 'number',
			default: '50',
			description: 'Warp amplitude.'
		},

		{

		},

		{
			name: 'menuContentColor',
			type: 'string',
			default: '"#111"',
			description: 'Color for menu icon lines & pill text.'
		},

		{
			name: 'useFixedPosition',
			type: 'boolean',
			default: 'false',
			description: 'Use fixed positioning instead of absolute.'
		},

		{
			name: 'items',

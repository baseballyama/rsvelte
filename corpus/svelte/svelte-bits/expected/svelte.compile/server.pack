		}

		function customize($$renderer) {
			Customize($$renderer, {
				children: ($$renderer) => {
					PreviewColorPicker($$renderer, {
						title: 'Light Color',
						value: lightColor,
						onChange: (v) => lightColor = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Beam Number',
						min: 1,
						max: 30,
						step: 1,
						value: beamNumber,
						onChange: (v) => beamNumber = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Beam Width',
						min: 0.5,

		if (this.maxPixelRatio && pr > this.maxPixelRatio) pr = this.maxPixelRatio; else if (this.minPixelRatio && pr < this.minPixelRatio) pr = this.minPixelRatio;

		this.renderer.setPixelRatio(pr);

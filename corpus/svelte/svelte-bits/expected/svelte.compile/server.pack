						value: particleSize,
						onChange: (v) => particleSize = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Lerp Speed',
						min: 0.01,
						max: 1,
						step: 0.01,
						value: lerpSpeed,
						onChange: (v) => lerpSpeed = v
					});

					$$renderer.push(`<!----> `);

					PreviewSlider($$renderer, {
						title: 'Field Strength',
						min: 1,
						max: 50,
						step: 1,
						value: fieldStrength,
						onChange: (v) => fieldStrength = v
					});

					$$renderer.push(`<!----> `);

					PreviewSwitch($$renderer, {

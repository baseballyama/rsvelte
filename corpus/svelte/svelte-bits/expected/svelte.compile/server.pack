				$$renderer.push(`<div${$.attr_style(`position:absolute;left:0;right:0;top:0;animation:stepper-enter 0.4s cubic-bezier(0.4,0,0.2,1) forwards;--enter-x:${direction >= 0 ? '-100%' : '100%'};`)}><div class="px-8">`);

	s.container.addEventListener('mousemove', onMove);
	s.container.addEventListener('touchmove', onMove);

	const init = (ev) => {
		const r = s.container.getBoundingClientRect();

		s.mouse = getLocalPointerPos(ev, r);
		s.cache = { ...s.mouse };

		const tick = () => {
			if (stopped) return;

			render();
			raf = requestAnimationFrame(tick);
		};

		raf = requestAnimationFrame(tick);

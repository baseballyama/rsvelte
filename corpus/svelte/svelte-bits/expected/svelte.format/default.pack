          { label: "Vertical", value: "vertical" },
          { label: "Diagonal", value: "diagonal" },
        ]}
        value={direction}
        onChange={(v) =>
          (direction = v as "horizontal" | "vertical" | "diagonal")}
      />
      <PreviewSwitch
        title="Show Border"
        checked={showBorder}
        onChange={(v) => (showBorder = v)}
      />
      <PreviewSwitch title="Yoyo" checked={yoyo} onChange={(v) => (yoyo = v)} />
      <PreviewSwitch
        title="Pause on Hover"
        checked={pauseOnHover}
        onChange={(v) => (pauseOnHover = v)}
      />
    </Customize>
  {/snippet}
  {#snippet propTable()}
    <PropTable rows={props} />
  {/snippet}
</TabsLayout>


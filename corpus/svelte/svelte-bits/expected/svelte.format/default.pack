      }
    };
    const render = () => {
      const d = getMouseDistance(s.mouse, s.last);
      s.cache.x = lerp(s.cache.x, s.mouse.x, 0.3);
      s.cache.y = lerp(s.cache.y, s.mouse.y, 0.3);
      if (d > s.threshold) {
        show();
        s.last = { ...s.mouse };

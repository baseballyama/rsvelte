        max={5}
        step={0.1}
        value={patternScaleY}
        onChange={(v) => {
          patternScaleY = v;
          forceRerender();
        }}
      />
      <PreviewSlider
        title="Pattern Alpha"
        min={0}
        max={25}
        step={5}
        value={patternAlpha}
        onChange={(v) => {
          patternAlpha = v;
          forceRerender();
        }}
      />
    </Customize>
  {/snippet}
  {#snippet propTable()}
    <PropTable rows={props} />
  {/snippet}
</TabsLayout>


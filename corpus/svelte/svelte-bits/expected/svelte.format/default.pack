      style="position:relative;height:700px;overflow:hidden;display:flex;align-items:center;justify-content:center;"
    >
      {#key key}
        <ProfileCard
          name="Javi A. Torres"
          title="Software Engineer"
          handle="javicodes"
          status="Online"
          contactText="Contact Me"
          avatarUrl="/assets/demo/person.webp"

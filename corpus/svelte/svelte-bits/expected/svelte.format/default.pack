      style="position:relative;min-height:400px;display:flex;align-items:center;justify-content:center;width:100%;"
    >
      <ReplayButton onClick={() => replay++} />
      {#key replay}
        <FadeContent {blur} {duration} {delay} {threshold} {initialOpacity}>
          <div
            style="padding:1.2em 2em;border-radius:14px;border:1px solid var(--border-primary);background:var(--bg-elevated);color:var(--text-primary);font-size:1.1rem;font-weight:600;"

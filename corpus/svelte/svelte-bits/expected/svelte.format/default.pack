      type: "number",
      default: "15",
      description: "Number of balls (1-50).",
    },
    {
      name: "clumpFactor",
      type: "number",
      default: "1",
      description: "How tightly balls cluster.",
    },
    {
      name: "enableMouseInteraction",
      type: "boolean",
      default: "true",
      description: "Cursor ball follows mouse.",

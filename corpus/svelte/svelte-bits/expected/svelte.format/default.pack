      bloom !== D.bloom ||
      timeScale !== D.timeScale ||
      transparent !== D.transparent,
  );
  function reset() {
    height = D.height;
    baseWidth = D.baseWidth;
    animationType = D.animationType;
    glow = D.glow;
    noise = D.noise;
    scale = D.scale;
    hueShift = D.hueShift;
    colorFrequency = D.colorFrequency;
    hoverStrength = D.hoverStrength;
    inertia = D.inertia;
    bloom = D.bloom;

      type: "GlassIconsItem[]",
      default: "[]",
      description:
        "Array of items. Each: { icon: Snippet, color: string, label: string, customClass?: string }.",
    },
    {
      name: "class",
      type: "string",
      default: "''",
      description: "Optional additional class for the container.",
    },
  ];
</script>


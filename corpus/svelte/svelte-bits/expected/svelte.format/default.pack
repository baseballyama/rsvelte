    },
    {
      name: "animationDuration",
      type: "number",
      default: "1",
      description: "GSAP tween duration for each character.",
    },
    {
      name: "ease",
      type: "string",
      default: '"back.inOut(2)"',
      description: "GSAP easing string.",

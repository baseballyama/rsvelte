        min={0}
        max={30}
        step={1}
        value={skewAmount}
        onChange={(v) => {
          skewAmount = v;
          key++;
        }}
      />
      <PreviewSelect
        title="Easing"
        value={easing}
        options={[
          { label: "elastic", value: "elastic" },
          { label: "linear", value: "linear" },
        ]}
        onChange={(v) => {
          easing = v as "elastic" | "linear";
          key++;
        }}
      />
      <PreviewSwitch
        title="Pause on Hover"
        checked={pauseOnHover}
        onChange={(v) => {
          pauseOnHover = v;
          key++;
        }}
      />
    </Customize>
  {/snippet}
  {#snippet propTable()}<PropTable rows={props} />{/snippet}
</TabsLayout>


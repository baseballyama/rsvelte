          { label: "Bottom", value: "bottom" },
        ]}
        value={direction}
        onChange={(v) => {
          direction = v as "top" | "bottom";
          replay++;
        }}
      />
      <PreviewSlider
        title="Threshold"
        min={0}
        max={1}
        step={0.05}
        value={threshold}
        onChange={(v) => (threshold = v)}
      />
      <PreviewSlider
        title="Step Duration"
        min={0.1}
        max={1.5}
        step={0.05}
        value={stepDuration}
        valueUnit="s"
        onChange={(v) => (stepDuration = v)}
      />
    </Customize>
  {/snippet}
  {#snippet propTable()}
    <PropTable rows={props} />
  {/snippet}
</TabsLayout>


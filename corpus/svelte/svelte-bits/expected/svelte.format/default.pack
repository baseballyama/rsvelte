      type: "number",
      default: "200",
      description: "Point light intensity.",
    },
    {
      name: "minSize",
      type: "number",
      default: "0.5",
      description: "Min sphere size.",
    },
    {
      name: "maxSize",
      type: "number",
      default: "1",
      description: "Max sphere size.",
    },
    {
      name: "gravity",
      type: "number",
      default: "0.5",
      description: "Gravity strength.",
    },
    {
      name: "friction",
      type: "number",
      default: "0.9975",
      description: "Velocity friction.",
    },
    {
      name: "wallBounce",
      type: "number",
      default: "0.95",
      description: "Wall bounce factor.",

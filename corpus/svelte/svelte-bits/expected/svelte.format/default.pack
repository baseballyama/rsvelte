      default: "true",
      description: "Drag to rotate.",
    },
    {
      name: "enableHoverRotation",
      type: "boolean",
      default: "true",
      description: "Hover rotation.",
    },
    {
      name: "enableManualZoom",
      type: "boolean",
      default: "true",
      description: "Wheel/pinch zoom.",
    },
    {

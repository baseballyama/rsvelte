    cursorSize={${cursorSize}}
    isViscous={${isViscous}}
    viscous={${viscous}}
    iterationsViscous={${iterationsViscous}}
    iterationsPoisson={${iterationsPoisson}}
    resolution={${resolution}}
    isBounce={${isBounce}}
    autoDemo={${autoDemo}}
    autoSpeed={${autoSpeed}}
    autoIntensity={${autoIntensity}}
  />
</div>`);

  const props: PropRow[] = [

    buf[0]=sigmoid(buf[0]);
    return vec4(buf[0].x,buf[0].y,buf[0].z,1.);
}

void mainImage(out vec4 fragColor,in vec2 fragCoord){
    vec2 uv=fragCoord/uResolution.xy*2.-1.;
    uv.y*=-1.;
    uv+=uWarp*vec2(sin(uv.y*6.283+uTime*0.5),cos(uv.x*6.283+uTime*0.5))*0.05;
    fragColor=cppn_fn(uv,0.1*sin(0.3*uTime),0.1*sin(0.69*uTime),0.1*sin(0.44*uTime));
}

void main(){
    vec4 col;mainImage(col,gl_FragCoord.xy);
    col.rgb=hueShiftRGB(col.rgb,uHueShift);
    float scanline_val=sin(gl_FragCoord.y*uScanFreq)*0.5+0.5;
    col.rgb*=1.-(scanline_val*scanline_val)*uScan;
    col.rgb+=(rand(gl_FragCoord.xy+uTime)-0.5)*uNoise;
    vec3 dvOut = clamp(col.rgb, 0.0, 1.0);
    gl_FragColor = vec4(dvOut, max(max(dvOut.r, dvOut.g), dvOut.b));
}
`;

  onMount(() => {
    const parent = canvas.parentElement as HTMLElement;
    const renderer = new Renderer({
      dpr: Math.min(window.devicePixelRatio, 2),
      canvas,
      alpha: true,
      premultipliedAlpha: false,
    });

    const gl = renderer.gl;
    gl.clearColor(0, 0, 0, 0);
    const geometry = new Triangle(gl);

    const program = new Program(gl, {
      vertex,
      fragment,
      uniforms: {
        uTime: { value: 0 },
        uResolution: { value: new Vec2() },
        uHueShift: { value: current.hueShift },
        uNoise: { value: current.noiseIntensity },
        uScan: { value: current.scanlineIntensity },
        uScanFreq: { value: current.scanlineFrequency },
        uWarp: { value: current.warpAmount },
      },
    });

    const mesh = new Mesh(gl, { geometry, program });

    const resize = () => {
      const w = parent.clientWidth;
      const h = parent.clientHeight;
      renderer.setSize(
        w * current.resolutionScale,
        h * current.resolutionScale,
      );
      program.uniforms.uResolution.value.set(w, h);
    };
    window.addEventListener("resize", resize);
    resize();

    const start = performance.now();
    let raf = 0;
    const loop = () => {
      const c = current;
      program.uniforms.uTime.value =
        ((performance.now() - start) / 1000) * c.speed;
      program.uniforms.uHueShift.value = c.hueShift;
      program.uniforms.uNoise.value = c.noiseIntensity;
      program.uniforms.uScan.value = c.scanlineIntensity;
      program.uniforms.uScanFreq.value = c.scanlineFrequency;
      program.uniforms.uWarp.value = c.warpAmount;
      renderer.render({ scene: mesh });
      raf = requestAnimationFrame(loop);
    };
    loop();

    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener("resize", resize);
    };
  });
</script>


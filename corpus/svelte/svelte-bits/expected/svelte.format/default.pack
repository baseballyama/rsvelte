    isViscous: true,
    viscous: 30,
    iterationsViscous: 32,
    iterationsPoisson: 32,
    isBounce: false,
    autoDemo: true,
    autoSpeed: 0.5,
    autoIntensity: 2.2,
  };

  let color0 = $state(DEFAULTS.color0);
  let color1 = $state(DEFAULTS.color1);

      description: "Edge fade amount.",
    },
    {
      name: "noiseAmount",
      type: "number",
      default: "0",
      description: "Postprocess grain.",
    },
  ];

  let key = $state(0);
  $effect(() => {
    void liquid;
    untrack(() => key++);
  });
  // noiseAmount and antialias also require reinit
</script>


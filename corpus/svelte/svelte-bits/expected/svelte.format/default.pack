          {
            duration: 0.4,
            ease: "power3",
            scale: sv,
            rotationZ: gsap.utils.random(-3, 3),
            x: s.mouse.x - (img.rect?.width ?? 0) / 2,
            y: s.mouse.y - (img.rect?.height ?? 0) / 2,

				$$renderer.push('<!--[-1-->');
			}

			$$renderer.push(`<!--]-->`);
		}

		$$renderer.push(`<label${$.attr('for', unique)} class="inline-flex cursor-pointer items-center gap-3">`);

		if (children) {

		suffixSnip($$renderer);
		$$renderer.push(`<!----></div></button></div> <div class="border-kui-light-gray-400 dark:border-kui-dark-gray-400 grow border-t"></div></div></div>`);
		$.bind_props($$props, { isActive });
	});
}

				if (checked) {
					$$renderer.push('<!--[0-->');

					const CheckedIcon = icon.checked;

					$$renderer.push(`<div${$.attr_class(`absolute ${$.stringify(iconSizeClass())}`)}>`);

					if (CheckedIcon) {
						$$renderer.push('<!--[-->');
						CheckedIcon($$renderer, {});
						$$renderer.push('<!--]-->');
					} else {
						$$renderer.push('<!--[!-->');
						$$renderer.push('<!--]-->');

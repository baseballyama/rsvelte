		error: "bg-kui-light-red-700 dark:bg-kui-dark-red-700",
		warning: "bg-kui-light-amber-700 dark:bg-kui-dark-amber-700",
		secondary: "bg-kui-light-gray-700 dark:bg-kui-dark-gray-700"
	};


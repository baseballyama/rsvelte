			$.set_attribute(input, 'id', unique);
			$.set_attribute(input, 'name', name);
			$.set_value(input, $$props.value);
			input.disabled = disabled();
		},
		[() => rootState.getSelected() == $$props.value]
	);

	$.delegated('change', input, onchange);
	$.append($$anchor, label_1);
	$.pop();
}


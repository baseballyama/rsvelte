/* group.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export function createGroupState(initial) {
	let selected = $.state($.proxy(initial.selected));

	function get() {
		return $.get(selected);
	}

	function set(value) {
		$.set(selected, value, true);
		initial.onchange?.(value);
	}

	return {
		name: initial.name,
		type: initial.type,
		disabledParent: initial.disabledParent,
		get,
		set
	};
}
=== 754 src/lib/collapse/root.svelte.ts	js
/* root.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export function createCollapseState(initial) {
	let multiple = $.state($.proxy(initial.multiple));
	let item = $.state($.proxy(initial.item));

	function getMultiple() {
		return $.get(multiple);
	}

	function setMultiple(value) {
		$.set(multiple, value, true);
	}

	function getItem() {
		return $.get(item);
	}

	function setItem(value) {
		if (!$.get(item).includes(value)) {
			$.get(item).push(value);
		}
	}

	function deleteItem(value) {
		$.set(item, $.get(item).filter((i) => i !== value), true);
	}

	function clearItems() {
		$.set(item, [], true);
	}

	return {
		getMultiple,
		setMultiple,
		getItem,
		setItem,
		deleteItem,
		clearItems
	};
}

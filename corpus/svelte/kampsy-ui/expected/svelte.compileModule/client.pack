/* themeSwitcher.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

function createTheme() {
	let theme = $.state("system");

	return {
		get theme() {
			return $.get(theme);
		},

		setTheme: (value) => {
			$.set(theme, value, true);
		}
	};
}

export const switcher = createTheme();

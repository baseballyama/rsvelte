import * as $ from 'svelte/internal/client';

export function createRootState(initial) {
	let isMobile = $.state($.proxy(initial.isMobile));
	let error = $.state($.proxy(initial.error));
	let loading = $.state($.proxy(initial.loading));
	let selected = $.state($.proxy(initial.selected));
	let isActive = $.state($.proxy(initial.isActive));
	let contentPosition = $.state($.proxy(initial.contentPosition));
	let transY = $.state($.proxy(initial.transY));

	function getIsMobile() {
		return $.get(isMobile);
	}

	function setIsMobile(value) {
		$.set(isMobile, value, true);
	}

	function getError() {
		return $.get(error);
	}

	function setError(value) {
		$.set(error, value, true);
	}

	function getLoading() {
		return $.get(loading);
	}

	function setLoading(value) {
		$.set(loading, value, true);
	}

	function getSelected() {
		return $.get(selected);
	}

	function setSelected(value) {
		$.set(selected, value, true);
	}

	function getIsActive() {
		return $.get(isActive);
	}

	function setIsActive(value) {
		$.set(isActive, value, true);
	}

	function getContentPosition() {
		return $.get(contentPosition);
	}

	function setContentPosition(value) {
		$.set(contentPosition, value, true);
	}

	function setTransY(value) {
		$.set(transY, value, true);
	}

	function getTransY() {
		return $.get(transY);
	}

	return {
		size: initial.size,
		getIsMobile,
		setIsMobile,
		getError,
		setError,
		getLoading,
		setLoading,
		getSelected,
		setSelected,
		getIsActive,
		setIsActive,
		getContentPosition,
		setContentPosition,
		getTransY,
		setTransY
	};
}

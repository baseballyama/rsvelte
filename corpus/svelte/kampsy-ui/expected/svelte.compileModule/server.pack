/* root.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';

export function createCollapseState(initial) {
	let multiple = initial.multiple;
	let item = initial.item;

	function getMultiple() {
		return multiple;
	}

	function setMultiple(value) {
		multiple = value;
	}

	function getItem() {
		return item;
	}

	function setItem(value) {
		if (!item.includes(value)) {
			item.push(value);
		}
	}

	function deleteItem(value) {
		item = item.filter((i) => i !== value);
	}

	function clearItems() {
		item = [];
	}

	return {
		getMultiple,
		setMultiple,
		getItem,
		setItem,
		deleteItem,
		clearItems
	};
}

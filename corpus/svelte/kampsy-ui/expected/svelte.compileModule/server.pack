/* themeSwitcher.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';

function createTheme() {
	let theme = "system";

	return {
		get theme() {
			return theme;
		},

		setTheme: (value) => {
			theme = value;
		}
	};
}

export const switcher = createTheme();

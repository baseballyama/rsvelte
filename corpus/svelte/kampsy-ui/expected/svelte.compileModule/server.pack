/* group.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';

export function createGroupState(initial) {
	let selected = initial.selected;

	function get() {
		return selected;
	}

	function set(value) {
		selected = value;
		initial.onchange?.(value);
	}

	return {
		name: initial.name,
		type: initial.type,
		disabledParent: initial.disabledParent,
		get,
		set
	};
}

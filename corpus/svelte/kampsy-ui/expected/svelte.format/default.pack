                >
                <Table.Cell></Table.Cell>
                <Table.Cell></Table.Cell>
                <Table.Cell
                  class="text-kui-light-gray-1000 dark:text-kui-dark-gray-1000 font-medium"
                >
                  {formatCurrency(

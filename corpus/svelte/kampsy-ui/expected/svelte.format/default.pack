<script lang="ts">
  import Aside from "$lib/../docs/ui/aside.svelte";
  import Row from "$lib/../docs/ui/row.svelte";
  import Shell from "$lib/../docs/ui/shell.svelte";
  import { asideData } from "$lib/../docs/utils/data.js";

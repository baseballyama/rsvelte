  import {
    projectBannerError,
    projectBannerSuccess,
    projectBannerWarning,
  } from "../../docs/data/project-banner.js";
  import {
    RotateCounterClockWise,
    ShieldCheck,
    Warning,
  } from "$lib/icons/index.js";
  import LinkH2 from "$lib/../docs/ui/linkH2.svelte";
</script>


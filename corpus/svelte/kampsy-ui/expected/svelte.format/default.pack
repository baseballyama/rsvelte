      {#snippet demo()}
        <div>
          <Tooltip
            text="The Evil Rabbit Jumped over the Fence"
            position="top"
            type="success"
          >
            <span>Top</span>
          </Tooltip>
        </div>
        <div>
          <Tooltip
            text="The Evil Rabbit Jumped over the Fence"
            position="bottom"
            type="error"
          >
            <span>Bottom</span>

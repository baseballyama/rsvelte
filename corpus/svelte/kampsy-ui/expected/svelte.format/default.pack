    LogoBitbucketColor,
    LogoGithub,
    LogoGitlab,
  } from "$lib/icons/index.js";
  import LinkH2 from "$lib/../docs/ui/linkH2.svelte";

  let selected = $state("apple");
  let tabDisabled = $state("apple");

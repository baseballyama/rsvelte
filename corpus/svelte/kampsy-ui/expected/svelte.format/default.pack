          </AvatarWithIcon>
          <AvatarWithIcon
            size={32}
            iconBackground
            role="img"
            aria-label="Verified avatar"
          >
            {#snippet icon()}
              <CircleCheck />
            {/snippet}
          </AvatarWithIcon>
          <AvatarWithIcon
            size={32}
            iconBackground
            role="img"
            aria-label="Information avatar"
          >
            {#snippet icon()}
              <Info />
            {/snippet}
          </AvatarWithIcon>
        </div>
      {/snippet}
      {@render demoAndCode(demo, avatarWithIcon)}
    </div>
  </Row>
{/snippet}

{#snippet letter()}
  <Row>

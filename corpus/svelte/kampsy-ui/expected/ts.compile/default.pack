        return [checkboxContBase, checkboxContDisabled];
    if (selected)
        return [checkboxContBase, checkboxContSelected];
    return [checkboxContBase, checkboxContDefault];
}
export function resolveCheckboxCheckClass({ selected = false, }) {
    return [checkboxCheckBase, selected ? checkboxCheckSelected : checkboxCheckDefault];
}
export function resolveGroupLabelClass({ disabled = false, }) {
    return [legendBase, disabled ? legendDisabled : legendDefault];
}


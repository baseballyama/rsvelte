			deck.on('slidechanged', (event) => {
				if ('currentSlide' in event) {
					const currentSlideEl = event.currentSlide;

					currentSlideEl?.dispatchEvent(inEvent);
				}

				if ('previousSlide' in event) {
					const currentPreviousEl = event.previousSlide;


=== 994 svelte/demos/cases/Tabs.svelte	svelte	runes	runes
<script>
	import { Tabs } from "../../src/index";
	import { getContext } from "svelte";

	const { showNotice } = getContext("wx-helpers");

	const tabs = [
		{ id: 0, label: "Info", icon: "wxi-alert" },
		{ id: 1, label: "About" },
		{ id: 3, label: "", icon: "wxi-check" },
	];

	let active = $state(2);

	function onchange({ value }) {
		active = value;
		showNotice({
			type: "info",
			expire: 2000,
			text: "ID: " + active,
		});
	}
</script>

<div class="demo-box">
	<h3>Tabs</h3>

	<div class="tabbar">
		<Tabs options={tabs} bind:value={active} />
		{#if active === 0}
			<div class="body">Info</div>
		{:else if active === 1}
			<div class="body">About</div>
		{:else}
			<div class="body">Check</div>
		{/if}
		<Tabs options={tabs} bind:value={active} type="bottom" />
	</div>

	<h3>onchange</h3>
	<Tabs options={tabs} value={0} {onchange} />
</div>

<style>
	.body {
		height: 200px;
		padding: 20px;
	}
	.tabbar {
		border-left: var(--wx-border);
		margin-left: 20px;
	}
</style>


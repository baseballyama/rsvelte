		title = "",
		tooltip,
		disabled = false,
		error = false,
		css = "",
		onchange,
		dropdown = {},
	} = $props();
	const inputId = $state(getInputId(id));

	let popup = $state(false);

	function selectColor(ev, color) {
		ev.stopPropagation();
		value = color;
		popup = false;
		onchange && onchange({ value });
	}
	function unselectColor(ev) {
		ev.stopPropagation();
		value = "";
		onchange && onchange({ value });
	}
	function handlePopup() {
		if (disabled) return false;
		popup = true;
	}
</script>


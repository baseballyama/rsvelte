<script>
	import { getInputId } from "./helpers/getInputId.js";

	let {
		id,
		value = $bindable(false),
		disabled = false,
		css = "",
		onchange,
	} = $props();

	const inputId = $state(getInputId(id));

	function onChange(event) {
		value = event.target.checked;
		onchange && onchange({ value });
	}
</script>

<label class="wx-switch {css}">
	<input
		type="checkbox"
		checked={value}
		onchange={onChange}
		{disabled}
		id={inputId}
	/>
	<span></span>
</label>


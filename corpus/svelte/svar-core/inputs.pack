			<path d="M11.2501 1.74994H0.750092V0.249939H11.2501V1.74994Z" />
		</svg>
	</button>
	<input
		id={inputId}
		type="text"
		class="wx-input"
		{disabled}
		{readonly}
		required
		bind:value
		onblur={blur}
		oninput={input}

<script>
	import Dropdown from "./Dropdown.svelte";
	import ColorBoard from "./ColorBoard.svelte";
	import { getInputId } from "./helpers/getInputId.js";

	let {
		value = $bindable(""),
		id,
		placeholder = "",
		title = "",
		tooltip,
		disabled = false,
		error = false,
		clear = false,
		css = "",
		onchange,
		dropdown = {},
	} = $props();

	const inputId = $state(getInputId(id));

	let popup = $state(false);

	function handlePopup() {
		if (disabled) return false;
		popup = true;
	}

	function selectColor(ev) {
		if (ev.input) return;

		popup = false;
		value = ev.value;
		onchange && onchange({ value });
	}

	function unselectColor(ev) {
		ev.stopPropagation();
		value = "";
		onchange && onchange({ value });
	}
</script>

<!-- svelte-ignore a11y_click_events_have_key_events -->
<!-- svelte-ignore a11y_no_static_element_interactions -->
<div
	class="wx-colorpicker {css}"
	onclick={handlePopup}
	data-tooltip-text={tooltip}
>
	<input
		{title}
		{value}
		readonly
		id={inputId}
		{placeholder}
		{disabled}
		class:wx-error={error}
		class:wx-focus={popup}
	/>
	<div class="wx-color" style="background: {value}"></div>

	{#if clear && !disabled && value}
		<i class="wxi-close" onclick={unselectColor}></i>
	{/if}

	{#if popup}
		<Dropdown oncancel={() => (popup = false)} {...dropdown}>
			<ColorBoard {value} button="true" onchange={selectColor} />
		</Dropdown>
	{/if}
</div>


<script>
	import { getInputId } from "./helpers/getInputId.js";

	let {
		id,
		label = "",
		width = "",
		min = 0,
		max = 100,
		value = $bindable(0),
		step = 1,
		title = "",
		tooltip,
		disabled = false,
		css = "",
		onchange,
	} = $props();

	const inputId = $state(getInputId(id));

	let bgStyle = $derived(() => {
		return disabled
			? ""
			: `background: linear-gradient(90deg, var(--wx-slider-primary) 0% ${progress}, var(--wx-slider-background) ${progress} 100%);`;
	});

	let progress = $derived(((value - min) / (max - min)) * 100 + "%");

	let previousInput = value;
	let previousValue = value;
	function oninput({ target }) {
		value = target.value * 1;
		onchange && onchange({ value, previous: previousInput, input: true });
		previousInput = value;
	}
	function change({ target }) {
		value = target.value * 1;
		onchange && onchange({ value, previous: previousValue });
		previousValue = value;
	}
</script>

<div
	class="wx-slider {css}"
	style={width ? `width: ${width}` : ""}
	{title}
	data-tooltip-text={tooltip}
>
	{#if label}<label for={id}>{label}</label>{/if}
	<div>
		<input
			id={inputId}
			type="range"
			{min}
			{max}
			{step}
			{disabled}
			{value}
			{oninput}
			onchange={change}
			style={bgStyle()}
		/>
	</div>
</div>


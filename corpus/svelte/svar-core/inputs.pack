<script>
	import { clickOutside } from "@svar-ui/lib-dom";

	let {
		position = "bottom",
		align = "start",
		autoFit = true,
		oncancel = null,
		width = "100%",
		css = "",
		children,
	} = $props();

	let node;
	$effect(() => {
		if (autoFit) {
			const nodeCoords = node.getBoundingClientRect();
			const bodyCoords = document.body.getBoundingClientRect();

			if (nodeCoords.right >= bodyCoords.right) {
				align = "end";
			}

			if (nodeCoords.bottom >= bodyCoords.bottom) {
				position = "top";
			}
			return `${position}-${align}`;
		}
	});

	function down(e) {
		oncancel && oncancel(e);
	}
</script>

<div
	use:clickOutside={down}
	bind:this={node}
	class="wx-dropdown {`wx-${position}-${align}`} {css}"
	style="width:{width}"
>
	{@render children?.()}
</div>

<style>

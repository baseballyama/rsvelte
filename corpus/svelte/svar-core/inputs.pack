	}

	.list .card:not(:global(:first-child)) {
		border-top: var(--wx-input-border);
		padding-top: 6px;
		height: 46px;
	}
	.card {
		height: 40px;
		width: 100%;
		display: flex;
		gap: 12px;
	}
	.card > .avatar {
		height: 40px;
		width: 40px;
	}
	.card > .avatar .avatar-box {
		height: 100%;
		width: 100%;
		border-radius: 50%;
		background-color: #00d19a;
		display: flex;

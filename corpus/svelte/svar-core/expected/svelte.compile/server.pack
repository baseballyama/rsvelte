		$$renderer.push(`<!----> `);

		Field($$renderer, {
			label: 'Align auto',
			children: ($$renderer) => {
				DatePicker($$renderer, {});
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> `);

		Field($$renderer, {
			label: 'Disabled',
			children: ($$renderer) => {
				DatePicker($$renderer, { disabled: true });
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> `);

		Field($$renderer, {
			label: 'Editable (new Date())',
			children: ($$renderer) => {
				DatePicker($$renderer, { editable: true });
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> `);

		Field($$renderer, {
			label: 'Editable custom format (MMDDYYYY)',
			children: ($$renderer) => {
				DatePicker($$renderer, { editable: parseDate, format: "%m%d%Y" });
			},
			$$slots: { default: true }

			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <h3>Combo with ids: '0', '000', '0E1'</h3> `);

		Field($$renderer, {
			children: ($$renderer) => {
				Combo($$renderer, {
					options: ["0", "000", "0E1"].map((id) => ({ id, label: `"${id}" option` }))
				});
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----></div>`);
	});

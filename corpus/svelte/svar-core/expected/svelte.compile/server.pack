				const pxX = width / 100;
				const pxY = height / 100;

				_sValue = Math.ceil(blockLeft / pxX) / 100;
				_vValue = Math.ceil(Math.abs(blockTop / pxY - 100)) / 100;
			}

			const currentColor = colorTransformator.hvsToHex(hueColor, _sValue, _vValue);

			value = currentColor;

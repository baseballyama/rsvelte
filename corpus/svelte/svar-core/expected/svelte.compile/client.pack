=== 717 svelte/demos/cases/Tooltips.svelte	css

	.item.svelte-od1v3x {
		border: var(--wx-border);
		text-align: center;
		margin: 20px 0px 20px;
		padding: 20px 40px;
		white-space: nowrap;
		width: max-content;

		&.margin {
			margin-left: 130px;
		}
	}

	.properties.svelte-od1v3x {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: 12px;
	}

	.controls.svelte-od1v3x {
		width: 300px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		align-items: start;
	}

	.grid.svelte-od1v3x {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		width: max-content;
		cursor: default;

		div:where(.svelte-od1v3x) {
			border: var(--wx-border);
			padding: 10px;
			text-align: center;
		}
	}

	.button-overflow {
		width: 150px;
	}


		children: ($$anchor, $$slotProps) => {
			Checkbox($$anchor, {});
		},
		$$slots: { default: true }
	});

	var node_3 = $.sibling(node_2, 2);

	Field(node_3, {
		label: 'Disabled',
		type: 'checkbox',
		position: 'left',
		children: ($$anchor, $$slotProps) => {

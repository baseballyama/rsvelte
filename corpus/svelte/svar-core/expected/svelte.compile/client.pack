	var node_2 = $.first_child(fragment_2);

	{
		var consequent_1 = ($$anchor) => {
			var div = root_1();
			var node_3 = $.child(div);

			$.snippet(node_3, () => $$props.children);
			$.reset(div);
			$.append($$anchor, div);
		};

		$.if(node_2, ($$render) => {
			if ($$props.children) $$render(consequent_1);
		});
	}

	$.append($$anchor, fragment_2);
	$.pop();
}

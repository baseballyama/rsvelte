	});

	var node_2 = $.sibling(node_1, 2);

	Field(node_2, {
		label: 'Delay',
		children: ($$anchor, $$slotProps) => {
			{
				let $0 = $.derived(() => `${$.get(delay)} ms`);

				Slider($$anchor, {
					min: 0,

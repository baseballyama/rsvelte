		},
		$$slots: { default: true }
	});

	var node_4 = $.sibling(node_3, 2);

	Field(node_4, {
		label: 'Disabled',
		type: 'checkbox',
		position: 'left',
		children: ($$anchor, $$slotProps) => {
			Checkbox($$anchor, {
				label: 'Checked',
				disabled: true,
				get value() {

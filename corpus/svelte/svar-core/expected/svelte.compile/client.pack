		$$slots: { default: true }
	});

	var node_4 = $.sibling(node_3, 2);

	Field(node_4, {
		label: 'With negative numbers',
		children: ($$anchor, $$slotProps) => {
			Counter($$anchor, { min: -Infinity });
		},
		$$slots: { default: true }
	});

	var node_5 = $.sibling(node_4, 2);

	Field(node_5, {
		label: 'With custom min and max values (-30, 30)',
		children: ($$anchor, $$slotProps) => {
			Counter($$anchor, {
				min: -30,

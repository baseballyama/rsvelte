		--wx-modal-header-font-color: #fff;
		/* end modal */

		/* notice */
		--wx-notice-z-index: 1010;
		--wx-notice-background: var(--wx-background-alt);
		--wx-notice-shadow: var(--wx-shadow-medium);
		--wx-notice-border: none;
		--wx-notice-border-radius: 0 var(--wx-border-radius)

					label: "Join",
					circles: [{ pattern: "blue" }, { pattern: "none" }],
					_class: ""
				});

				$$renderer.push(`<!----> `);

				circularUI($$renderer, {
					label: "Exclusion",
					circles: [{ pattern: "primary" }, { pattern: "none" }],
					_class: "hidden sm:block"
				});

				$$renderer.push(`<!----></div>`);
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----></div></div></section>`);
	});
}

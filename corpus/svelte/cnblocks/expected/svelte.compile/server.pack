import * as $ from 'svelte/internal/server';
import Button from "$lib/components/ui/button/button.svelte";
import Check from "@lucide/svelte/icons/check";
import { VercelFull, SupabaseFull, Spotify, Figma, FirebaseFull } from "$lib/svgs";

export default function Pricing_five($$renderer) {
	let list = [
		"First premium advantage",
		"Second advantage weekly",
		"Third advantage donate to project",
		"Fourth, access to all components weekly"
	];

	$$renderer.push(`<div class="relative py-16 md:py-32"><div class="mx-auto max-w-5xl px-6"><div class="mx-auto max-w-2xl text-center"><h2 class="text-3xl font-bold text-balance md:text-4xl lg:text-5xl">Start managing your company smarter today</h2></div> <div class="mt-8 md:mt-20"><div class="relative rounded-3xl border bg-card shadow-2xl shadow-zinc-950/5"><div class="grid items-center gap-12 divide-y p-12 md:grid-cols-2 md:divide-x md:divide-y-0"><div class="pb-12 text-center md:pr-12 md:pb-0"><h3 class="text-2xl font-semibold">Suite Enterprise</h3> <p class="mt-2 text-lg">For your company of any size</p> <span class="mt-12 mb-6 inline-block text-6xl font-bold"><span class="text-4xl">$</span>234</span> <div class="flex justify-center">`);

	Button($$renderer, {
		href: '/',
		size: 'lg',
		children: ($$renderer) => {
			$$renderer.push(`<!---->Get Started`);
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!----></div> <p class="mt-12 text-sm text-muted-foreground">Includes : Security, Unlimited Storage, Payment, Search engine, and all
							features</p></div> <div class="relative"><ul role="list" class="space-y-4"><!--[-->`);

	const each_array = $.ensure_array_like(list);

	for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
		let item = each_array[$$index];

		$$renderer.push(`<li class="flex items-center gap-2">`);
		Check($$renderer, { class: 'size-3' });
		$$renderer.push(`<!----> <span>${$.escape(item)}</span></li>`);
	}

	$$renderer.push(`<!--]--></ul> <p class="mt-6 text-sm text-muted-foreground">Team can be any size, and you can add or switch members as needed.
							Companies using our platform include:</p> <div class="mt-12 flex flex-wrap items-center justify-between gap-6">`);

	VercelFull($$renderer, { class: 'h-5 w-fit dark:invert' });
	$$renderer.push(`<!----> `);
	SupabaseFull($$renderer, { class: 'h-4 w-fit dark:invert' });
	$$renderer.push(`<!----> `);
	Spotify($$renderer, { class: 'h-4 w-fit dark:invert' });
	$$renderer.push(`<!----> `);
	Figma($$renderer, { class: 'h-5 w-fit dark:invert' });
	$$renderer.push(`<!----> `);
	FirebaseFull($$renderer, { class: 'h-5 w-fit dark:invert' });
	$$renderer.push(`<!----></div></div></div></div></div></div></div>`);
}

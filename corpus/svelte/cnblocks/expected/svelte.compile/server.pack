			});

			$$renderer.push(`<!----></li>`);
		}

		$$renderer.push(`<!--]--></ul></div></div> <div class="mb-6 hidden w-full flex-wrap items-center justify-end space-y-8 rounded-3xl border bg-background p-6 shadow-2xl shadow-zinc-300/20 in-data-[state=active]:block md:flex-nowrap lg:m-0 lg:flex lg:w-fit lg:gap-6 lg:space-y-0 lg:border-transparent lg:bg-transparent lg:p-0 lg:shadow-none lg:in-data-[state=active]:flex dark:shadow-none dark:lg:bg-transparent"><div class="lg:hidden"><ul class="space-y-6 text-base"><!--[-->`);

		const each_array_1 = $.ensure_array_like(menuItems);

		for (let index = 0, $$length = each_array_1.length; index < $$length; index++) {
			let item = each_array_1[index];

			$$renderer.push(`<li><a${$.attr('href', item.href)} class="block text-muted-foreground duration-150 hover:text-accent-foreground"><span>${$.escape(item.name)}</span></a></li>`);
		}

		$$renderer.push(`<!--]--></ul></div> <div class="flex w-full flex-col space-y-3 sm:flex-row sm:gap-3 sm:space-y-0 md:w-fit">`);

		Button($$renderer, {

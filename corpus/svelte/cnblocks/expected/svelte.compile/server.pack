			$$slots: { default: true }
		});

		$$renderer.push(`<!----> `);

		if (description) {
			$$renderer.push('<!--[0-->');

			Paragraph($$renderer, {
				class: 'mt-1',
				children: ($$renderer) => {
					$$renderer.push(`<!---->${$.escape(description)}`);
				},
				$$slots: { default: true }
			});
		} else {
			$$renderer.push('<!--[-1-->');
		}

		$$renderer.push(`<!--]--></section> `);
		children?.($$renderer);
		$$renderer.push(`<!----></article></div>`);
	});
}

import { Separator } from "$lib/components/ui/separator/index.js";
import { cn } from "$lib/utils.js";

export default function Sidebar_separator($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let {
			ref = null,
			class: className,
			$$slots,
			$$events,
			...restProps
		} = $$props;


	$$renderer.push(`<!----> <!--[-->`);

	const each_array = $.ensure_array_like(comparator);

	for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
		let block = each_array[$$index];

		BlockPreview($$renderer, $.spread_props([block]));
	}

	$$renderer.push(`<!--]-->`);
}

								tooltipContentProps,
								{
									children: ($$renderer) => {
										if (typeof tooltipContent === "string") {
											$$renderer.push(`<!--[0-->${$.escape(tooltipContent)}`);
										} else if (tooltipContent) {
											$$renderer.push('<!--[1-->');
											tooltipContent($$renderer);
											$$renderer.push(`<!---->`);
										} else {
											$$renderer.push('<!--[-1-->');

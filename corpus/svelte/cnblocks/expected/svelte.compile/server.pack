															Add.Group($$renderer, $.spread_props([
																props,
																{
																	class: cn("h-8 w-80 max-w-full", className),
																	children: ($$renderer) => {
																		if (Add.Button) {
																			$$renderer.push('<!--[-->');
																			Add.Button($$renderer, { class: 'h-8 min-w-0 md:pr-2 md:pl-2 [&>div]:size-8' });

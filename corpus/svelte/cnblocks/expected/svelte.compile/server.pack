												$$renderer.push('<!--]-->');
											}

											$$renderer.push(` <div class="grid flex-1 text-start text-sm leading-tight"><span class="truncate font-medium">${$.escape(user.name)}</span> <span class="truncate text-xs text-muted-foreground">${$.escape(user.desc)}</span></div>`);

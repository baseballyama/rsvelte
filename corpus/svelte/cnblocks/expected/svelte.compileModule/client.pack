/* code.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { Context } from "runed";
import { highlighter } from "./shiki";
import DOMPurify from "isomorphic-dompurify";

class CodeOverflowState {
	opts;

	constructor(opts) {
		this.opts = opts;
		this.toggleCollapsed = this.toggleCollapsed.bind(this);
	}

	toggleCollapsed() {
		this.opts.collapsed.current = !this.opts.collapsed.current;
	}

	get collapsed() {
		return this.opts.collapsed.current;
	}
}

class CodeRootState {
	opts;
	overflow;
	#highlighter = $.state(null);

	get highlighter() {
		return $.get(this.#highlighter);
	}

	set highlighter(value) {
		$.set(this.#highlighter, value, true);
	}

	constructor(opts, overflow) {
		this.opts = opts;
		this.overflow = overflow;
		highlighter.then((hl) => this.highlighter = hl);
	}

	highlight(code) {
		return this.highlighter?.codeToHtml(code, {
			lang: this.opts.lang.current,
			themes: { light: "github-light-default", dark: "vesper" },
			transformers: [
				{
					pre: (el) => {
						el.properties.style = "";

						if (!this.opts.hideLines.current) {
							el.properties.class += " line-numbers";
						}

						return el;
					},

					line: (node, line) => {
						if (within(line, this.opts.highlight.current)) {
							node.properties.class = node.properties.class + " line--highlighted";
						}

						return node;
					}
				}
			]
		});
	}

	get code() {
		return this.opts.code.current;
	}

	#highlighted = $.derived(() => DOMPurify.sanitize(this.highlight(this.code) ?? ""));

	get highlighted() {
		return $.get(this.#highlighted);
	}

	set highlighted(value) {
		$.set(this.#highlighted, value);
	}
}

function within(num, range) {
	if (!range) return false;

	let within = false;

	for (const r of range) {
		if (typeof r === "number") {
			if (num === r) {
				within = true;

				break;
			}

			continue;
		}

		if (r[0] <= num && num <= r[1]) {
			within = true;

			break;
		}
	}

	return within;
}

class CodeCopyButtonState {
	root;

	constructor(root) {
		this.root = root;
	}

	get code() {
		return this.root.opts.code.current;
	}
}

const overflowCtx = new Context("code-overflow-state");
const ctx = new Context("code-root-state");

export function useCodeOverflow(props) {
	return overflowCtx.set(new CodeOverflowState(props));
}

export function useCode(props) {
	return ctx.set(new CodeRootState(props, overflowCtx.getOr(undefined)));
}

export function useCodeCopyButton() {
	return new CodeCopyButtonState(ctx.get());
}

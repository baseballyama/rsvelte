import * as $ from 'svelte/internal/client';
import { UseClipboard } from "$lib/hooks/use-clipboard.svelte";
import { resolveCommand } from "package-manager-detector/commands";
import { Context } from "runed";

export const AGENTS = ["pnpm", "npm", "yarn", "bun"];

class AddProviderState {
	opts;

	constructor(opts) {
		this.opts = opts;
	}
}

const ProviderCtx = new Context("add-provider-ctx");

export function useAddProvider(opts) {
	return ProviderCtx.set(new AddProviderState(opts));
}

class AddRootState {
	opts;
	provider;
	clipboard = new UseClipboard({ delay: 2000 });

	constructor(opts, provider) {
		this.opts = opts;
		this.provider = provider;
	}

	get registryOptions() {
		return this.provider.opts.registryOptions.current;
	}

	#addCommand = $.derived(() => {
		const command = resolveCommand(this.agent, "execute", ["shadcn-svelte@latest", "add", this.opts.item.current]);

		return command
			? `${command.command} ${command.args.join(" ")}`
			: `npx shadcn-svelte@latest add ${this.opts.withoutRegistry.current
				? this.opts.item.current
				: `${this.registry}/${this.opts.item.current}`}`;
	});

	get addCommand() {
		return $.get(this.#addCommand);
	}

	set addCommand(value) {
		$.set(this.#addCommand, value);
	}

	#initCommand = $.derived(() => {
		const command = resolveCommand(this.agent, "execute", ["shadcn-svelte@latest", "init", this.registry]);

		return command
			? `${command.command} ${command.args.join(" ")}`
			: `npx shadcn-svelte@latest init ${this.registry}`;
	});

	get initCommand() {
		return $.get(this.#initCommand);
	}

	set initCommand(value) {
		$.set(this.#initCommand, value);
	}

	get registry() {
		return this.provider.opts.registry.current;
	}

	set registry(value) {
		this.provider.opts.registry.current = value;
	}

	get agent() {
		return this.provider.opts.agent.current;
	}

	set agent(value) {
		this.provider.opts.agent.current = value;
	}
}

const AddCtx = new Context("add-ctx");

class AddButtonState {
	root;

	constructor(root) {
		this.root = root;
	}

	#props = $.derived(() => ({
		onclick: () => this.root.clipboard.copy(this.root.addCommand)
	}));

	get props() {
		return $.get(this.#props);
	}

	set props(value) {
		$.set(this.#props, value);
	}
}

class AddDropdownAgentOptionState {
	opts;
	root;

	constructor(opts, root) {
		this.opts = opts;
		this.root = root;
	}

	#props = $.derived(() => ({
		onSelect: () => {
			this.root.agent = this.opts.agent.current;
			this.root.clipboard.copy(this.root.addCommand);
		}
	}));

	get props() {
		return $.get(this.#props);
	}

	set props(value) {
		$.set(this.#props, value);
	}
}

class AddDropdownRegistryOptionState {
	opts;
	root;

	constructor(opts, root) {
		this.opts = opts;
		this.root = root;
	}

	#props = $.derived(() => ({
		onSelect: () => {
			this.root.registry = this.opts.registry.current;
			this.root.clipboard.copy(this.root.addCommand);
		}
	}));

	get props() {
		return $.get(this.#props);
	}

	set props(value) {
		$.set(this.#props, value);
	}
}

class AddDropdownCopyInitState {
	root;

	constructor(root) {
		this.root = root;
	}

	#props = $.derived(() => ({
		onSelect: () => this.root.clipboard.copy(this.root.initCommand)
	}));

	get props() {
		return $.get(this.#props);
	}

	set props(value) {
		$.set(this.#props, value);
	}
}

export function useAdd(props) {
	return AddCtx.set(new AddRootState(props, ProviderCtx.get()));
}

export function useAddButton() {
	return new AddButtonState(AddCtx.get());
}

export function useAddDropdownAgentOption(opts) {
	return new AddDropdownAgentOptionState(opts, AddCtx.get());
}

export function useAddDropdownRegistryOption(opts) {
	return new AddDropdownRegistryOptionState(opts, AddCtx.get());
}

export function useAddDropdownCopyInit() {
	return new AddDropdownCopyInitState(AddCtx.get());
}

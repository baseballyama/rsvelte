/* use-toc.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { SvelteMap } from "svelte/reactivity";

export const INDEX_ATTRIBUTE = "data-toc-index";
export const TOC_IGNORE_ATTRIBUTE = "data-toc-ignore";

export class UseToc {
	#ref = $.state();
	#toc = $.state($.proxy([]));

	// This sets everything up once #ref is bound
	set ref(ref) {
		$.set(this.#ref, ref, true);

		if (!$.get(this.#ref)) return;

		$.set(this.#toc, getToc($.get(this.#ref)), true);

		// should detect if a heading is added / removed / updated
		const mutationObserver = new MutationObserver(() => {
			if (!$.get(this.#ref)) return;

			$.set(this.#toc, getToc($.get(this.#ref)), true);
		});

		mutationObserver.observe($.get(this.#ref), { childList: true, subtree: true });

		const resetActiveHeading = (headings) => {
			for (let i = 0; i < headings.length; i++) {
				headings[i].active = false;
				resetActiveHeading(headings[i].children);
			}
		};

		const setHeadingActive = (headings, index) => {
			for (let i = 0; i < headings.length; i++) {
				if (index === headings[i].index) {
					headings[i].active = true;

					break;
				}

				setHeadingActive(headings[i].children, index);
			}
		};

		// reactive to the table of contents
		$.user_effect(() => {
			const sectionVisibility = new SvelteMap();

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => sectionVisibility.set(entry.target, entry.intersectionRatio));

				// headings that are (partly) visible
				const visible = [...sectionVisibility.entries()].filter(([, ratio]) => ratio > 0).// sort by distance from viewport top
				sort(([a], [b]) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);

				if (visible.length === 0) return;

				// the heading nearest to the top wins
				const activeEl = visible[0][0];

				const idx = +activeEl.getAttribute(INDEX_ATTRIBUTE);

				resetActiveHeading($.get(this.#toc));
				setHeadingActive($.get(this.#toc), idx);
			});

			const observe = (heading) => {
				observer.observe(heading.ref);
				heading.children.forEach(observe);
			};

			$.get(this.#toc).forEach(observe);

			return () => observer.disconnect();
		});
	}

	get ref() {
		return $.get(this.#ref);
	}

	/** The generated table of contents */
	get current() {
		return $.get(this.#toc);
	}
}

function createHeading(element, index) {
	const kind = element.tagName.toLowerCase();

	element.setAttribute(INDEX_ATTRIBUTE, index.toString());

	return {
		index,
		ref: element,
		kind,
		id: element.id,
		level: parseInt(kind[1]),
		label: element.innerText ?? "",
		active: false,
		children: []
	};
}

/** Gets all of the headings contained in the provided element and create a table of contents.
 *
 * @param el
 * @returns
 */
function getToc(el) {
	const headings = Array.from(el.querySelectorAll("h1, h2, h3, h4, h5, h6")).map((h, i) => createHeading(h, i)).filter((h) => h.ref.closest(`[${TOC_IGNORE_ATTRIBUTE}]`) === null);

	if (headings.length === 0) return [];

	const toc = [];
	let i = 0;

	while (i < headings.length) {
		const heading = headings[i];
		const nextIndex = addChildren(headings, heading, i + 1);

		toc.push(heading);
		i = nextIndex;
	}

	return toc;
}

function addChildren(headings, base, index) {
	let i = index;

	while (i < headings.length) {
		const sub = headings[i];

		// example: h1 < h2 or h1 = h1
		if (sub.level <= base.level) break;

		const nextIndex = addChildren(headings, sub, i + 1);

		base.children.push(sub);
		i = nextIndex;
	}

	return i;
}

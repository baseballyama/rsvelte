								</div>
							</div>
							<div class="swiper-slide px-2">
								<div
									class="h-44 max-w-lg rounded-(--radius) border bg-background p-9"
								>
									<div class="mx-auto h-fit w-full">
										{@render workosLogo()}
									</div>

							"w-15 rounded px-1.5 py-1 text-center text-xs font-semibold",
							"bg-emerald-50 text-emerald-600 dark:bg-emerald-400/10 dark:text-emerald-400"
						)}
					>
						{item.percentage}
					</span>
				</span>
			</li>
		{/each}
	</ul>
</div>


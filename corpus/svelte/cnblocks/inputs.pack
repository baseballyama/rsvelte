					>
						<Button size="lg" href="/" class="h-12 rounded-full pr-3 pl-5 text-base">
							Start Building
							<ChevronRight class="ml-1" />
						</Button>
						<Button
							size="lg"
							variant="ghost"
							href="/"
							class="h-12 rounded-full px-5 text-base hover:bg-zinc-950/5 dark:hover:bg-white/5"
						>
							Request a demo
						</Button>
					</div>
				</div>
			</div>
			<!-- <div

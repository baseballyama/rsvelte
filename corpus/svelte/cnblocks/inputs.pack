{/if}

{#snippet CopyButton()}
	<Button
		class="absolute top-2 right-2 z-50 h-8 w-8 backdrop-blur-sm"
		variant="ghost"
		size="icon"
		onclick={copyCode}
	>
		{#if clipboard.status === "success"}
			<span in:scale>
				<Check class="size-3.5! text-[#10B981]" />
			</span>
		{:else}
			<span in:scale>
				<Copy class="size-3.5! opacity-50" />
			</span>
		{/if}
	</Button>
{/snippet}


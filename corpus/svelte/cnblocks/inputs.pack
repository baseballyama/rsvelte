		{ label: "Storage", amount: 285, percentage: 33.1, color: "amber" },
		{ label: "Bandwidth", amount: 125, percentage: 14.6, color: "rose" },
	];

	const colorClasses = {
		emerald: "bg-emerald-500 dark:bg-emerald-400",
		amber: "bg-amber-500 dark:bg-amber-400",

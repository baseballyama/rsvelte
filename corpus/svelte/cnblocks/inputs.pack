				</div>
			</div>
		</div>
		<div class="relative">
			<div
				class="absolute flex h-9 w-9 items-center justify-center rounded-full border-[3px] border-background bg-neutral-300 select-none dark:bg-neutral-800"
			>
				<span class="font-semibold text-primary">3</span>

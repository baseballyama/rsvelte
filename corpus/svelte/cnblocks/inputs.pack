	type IntegrationCardProps = {
		title: string;
		description: string;
		link?: string;
		children?: Snippet;
	};
	let {
		children,
		title,
		description,
		link = "https://github.com/SikandarJODD/cnblocks",
	}: IntegrationCardProps = $props();
</script>

<Card class="p-6">
	<div class="relative">
		<div class="*:size-10">{@render children?.()}</div>

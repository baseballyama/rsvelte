						height="460"
						width="460"
						loading="lazy"
					/>
				</div>
				<span class="mt-2 block text-sm">{member.name}</span>
				<span class="block text-xs text-muted-foreground group-hover:text-yellow-500"
					>{member.role}</span
				>
			</a>
		{/each}

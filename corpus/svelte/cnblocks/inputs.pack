		<div class="*:size-10">{@render children?.()}</div>
		<div class="mt-6 space-y-1.5">
			<h3 class="text-lg font-semibold">{title}</h3>
			<p class="line-clamp-2 text-muted-foreground">{description}</p>
		</div>
	</div>
</Card>


									class="mr-0.5 -ml-1 h-5 w-5 shrink-0 self-center text-red-500"
								/>
							{/if}

							<span class="sr-only">
								{item.trend === "up" ? "Increased" : "Decreased"} by
							</span>
							{item.difference}
						</Badge>
					</div>
				</CardContent>

	<Sidebar.Menu>
		{#each projects as item (item.name)}
			<Sidebar.MenuItem>
				<Sidebar.MenuButton
					class={cn({
						"bg-sidebar-accent  text-sidebar-accent-foreground":
							page.url.pathname === item.url,
					})}
				>
					{#snippet child({ props })}
						<a
							href={item.url}
							target={item.external ? "_blank" : undefined}
							rel={item.external ? "noopener noreferrer" : undefined}
							class="text-xs"
							{...props}
						>
							<span>{item.name}</span>
						</a>
					{/snippet}
				</Sidebar.MenuButton>
			</Sidebar.MenuItem>
		{/each}
	</Sidebar.Menu>
</Sidebar.Group>


											stroke-linecap="round"
											stroke-linejoin="round"
										></path>
										<path
											d="M5.5 7H6.5M5.5 10H6.5"
											class={showIframeComp
												? "stroke-green-500"
												: "stroke-primary"}
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"
										></path>
										<path
											d="M17 10L15 12L17 14"
											class={showIframeComp
												? "stroke-green-500"
												: "stroke-primary"}
											stroke-width="1.5"

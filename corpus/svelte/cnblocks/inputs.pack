					<CardTitle class="text-base font-normal">
						{item.metric}
					</CardTitle>
					<div class="mt-1 flex items-baseline gap-2 md:block lg:flex">
						<div class="flex items-baseline text-2xl font-semibold text-primary">
							{item.current}

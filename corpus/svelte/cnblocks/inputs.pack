<script lang="ts">
	import SEOComponent from "$lib/seo/SEO.svelte";
	import DocsPageShell from "$lib/components/layout/DocsPageShell.svelte";
	import { H2, Paragraph, Steps, Step, Link } from "$lib/components/markdown/index";

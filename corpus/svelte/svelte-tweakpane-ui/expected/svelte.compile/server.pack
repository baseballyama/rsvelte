											TabPage($$renderer, {
												title: 'A',
												children: ($$renderer) => {
													Button($$renderer, { title: 'Cycle Mode' });
												},
												$$slots: { default: true }
											});

											$$renderer.push(`<!----> `);

											TabPage($$renderer, {
												title: 'B',
												children: ($$renderer) => {
													Button($$renderer, { title: 'Cycle Mode' });
												},
												$$slots: { default: true }

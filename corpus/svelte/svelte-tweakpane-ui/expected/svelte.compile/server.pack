import { Checkbox, Pane, Slider } from '$lib';

export default function TestGridLayoutPane($$renderer) {
	let colors = 0.95;
	let darkMode = true;
	let numbers = true;
	let oneMore = true;
	let $$settled = true;
	let $$inner_renderer;


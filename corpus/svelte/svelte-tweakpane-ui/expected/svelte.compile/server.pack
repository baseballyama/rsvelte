		mode = (mode + 1) % 3;
	}

	let $$settled = true;
	let $$inner_renderer;

	function $$render_inner($$renderer) {
		$$renderer.push(`<p>Mode: ${$.escape(mode)}</p> <p>TabIndexA: ${$.escape(tabIndexA)}</p> <p>TabIndexB: ${$.escape(tabIndexB)}</p> `);


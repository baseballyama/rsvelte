	var span_5 = $.sibling($.child(pre_5));
	var text_5 = $.only_child(span_5, true);

	$.reset(pre_5);

	var pre_6 = $.sibling(pre_5, 2);
	var span_6 = $.sibling($.child(pre_6));
	var text_6 = $.only_child(span_6, true);


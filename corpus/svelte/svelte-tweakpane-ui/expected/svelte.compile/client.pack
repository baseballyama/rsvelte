			text = $$value;
		},

		$$events: {
			change: (event) => {
				if (event.detail.origin === 'internal') {
					binding1InternalEventCount++;
				} else {
					binding1ExternalEventCount++;
				}
			}
		}
	});

	var node_2 = $.sibling(node_1, 2);

	Text(node_2, {
		label: 'The Message',
		get live() {
			return live;
		},

		get value() {
			return text;
		},

		set value($$value) {
			text = $$value;
		},

		$$events: {
			change: (event) => {
				if (event.detail.origin === 'internal') {
					binding2InternalEventCount++;

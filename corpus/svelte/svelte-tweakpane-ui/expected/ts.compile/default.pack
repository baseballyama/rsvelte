    if (url === undefined || url === '') {
        throw new Error('No repository url found in package.json');
    }
    const sourceBaseUrl = `${url.replace(GIT_PREFIX_REGEX, '').replace(GIT_SUFFIX_REGEX, '')}/blob/main/`;

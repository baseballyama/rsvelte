    return findFile('dist', componentName, '.svelte.d.ts', warn);
}
export function getSourceFilePath(componentName, warn = true) {
    return findFile('src/lib', componentName, '.svelte', warn);
}
export function getAllLibraryFiles() {
    return globSync('./src/lib/**/*', { posix: true }).filter((file) => fs.statSync(file).isFile());
}
export function getAllLibraryComponentNames() {
    // What happens with js components?
    return globSync('./src/lib/**/*.svelte', { posix: true }).map((file) => path.basename(file).replace('.svelte', ''));
}
const sourceFileCache = new Map();
function getOrCreateSourceFile(filePath) {
    let sourceFile = sourceFileCache.get(filePath);
    if (!sourceFile) {
        sourceFile = new Project().addSourceFileAtPath(filePath);
        sourceFileCache.set(filePath, sourceFile);

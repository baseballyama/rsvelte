function stringToCssValue(v) {
    if (v === undefined) {
        return undefined;
    }
    if (typeof v === 'string') {
        return v;
    }
    if (isRgbaColorObject(v)) {
        return `rgba(${v.r}, ${v.g}, ${v.b}, ${v.a})`;

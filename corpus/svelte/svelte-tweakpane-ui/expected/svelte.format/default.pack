    display: flex;
    flex-wrap: wrap;
  }

  div.layout-wrapper > :global(div.tp-lblv) {
    flex-grow: 1;
  }

  div.layout-wrapper > :global(.tp-lblv:has(.tp-ckbv)) {
    flex-direction: row-reverse;
    flex-grow: 0;

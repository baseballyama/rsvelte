<h1>Text Component</h1>
{#each Object.keys(strings) as key}
	<Text label={key} bind:value={strings[key]} />
{/each}
<hr />
<h1>Auto Value</h1>
{#each Object.keys(strings) as key}
	<AutoValue label={key} bind:value={strings[key]} />
{/each}

<hr />
<h1>Auto Object</h1>
<AutoObject bind:object={strings} />
<hr />
<h1>Color Component</h1>
{#each Object.keys(strings) as key}
	<Color label={key} bind:value={strings[key]} />
{/each}

=== 1125 src/examples/tests/TestTextarea.svelte	svelte	runes	neutral
<script lang="ts">
	import { Checkbox, Textarea } from '$lib'

	let text = 'Cosmic Manifold'
	let live = true

	let binding1InternalEventCount = 0
	let binding1ExternalEventCount = 0
	let binding2InternalEventCount = 0
	let binding2ExternalEventCount = 0
</script>

<Checkbox label="Live" bind:value={live} />

<Textarea
	label="The Message"
	{live}
	rows={8}
	bind:value={text}
	on:change={(event) => {
		if (event.detail.origin === 'internal') {
			binding1InternalEventCount++
		} else {
			binding1ExternalEventCount++
		}
	}}
/>
<Textarea
	label="The Message"
	{live}
	rows={8}
	bind:value={text}
	on:change={(event) => {
		if (event.detail.origin === 'internal') {
			binding2InternalEventCount++
		} else {
			binding2ExternalEventCount++
		}
	}}
/>

<pre>Value: <span>{text}</span></pre>
<pre>Live: <span>{live}</span></pre>
<pre>Binding 1 Internal: <span>{binding1InternalEventCount}</span></pre>
<pre>Binding 1 External: <span>{binding1ExternalEventCount}</span></pre>
<pre>Binding 2 Internal: <span>{binding2InternalEventCount}</span></pre>
<pre>Binding 2 External: <span>{binding2ExternalEventCount}</span></pre>


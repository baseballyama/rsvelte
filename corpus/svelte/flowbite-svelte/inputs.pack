      href={hrefStatus ? "/" : ""}
      dot={dotStatus ? { placement: "bottom-right", color: "green" } : undefined}
      target={targetStatus ? "_blank" : undefined}
      onclick={eventStatus ? () => alert("Clicked!") : undefined}

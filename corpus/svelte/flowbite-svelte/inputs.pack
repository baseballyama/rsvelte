    <button type="button" class="cursor-pointer rounded-lg border-0 bg-transparent p-0 hover:opacity-80" onclick={() => (main = item)}>
      <img src={item.src} alt={item.alt} class="rounded-lg" />
    </button>
  {/snippet}
</Gallery>


    {#if basicSizes.length > 0 && basicContainerWidth > 0}
      <div class="mb-2 text-sm text-gray-600">
        <strong>Container:</strong>
        {basicContainerWidth}px
        <span class="ml-4"><strong>Sizes:</strong></span>

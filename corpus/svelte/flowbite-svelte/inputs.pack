    <Rating total={comment.total} rating={comment.rating}>
      {#snippet text()}
        <p class="ms-2 pt-1 text-sm font-medium text-gray-500 dark:text-gray-400">
          {comment.rating} out of {comment.total}
        </p>
      {/snippet}
    </Rating>

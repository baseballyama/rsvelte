            true: {
                base: "first:rounded-s-lg last:rounded-e-lg not-first:-ms-px group",
                select: "group-first:rounded-s-lg group-last:rounded-e-lg group-not-first:-ms-px h-full"
            }
        }
    },
    defaultVariants: {
        underline: false,
        size: "md"
    }
});
export const multiSelect = tv({
    slots: {

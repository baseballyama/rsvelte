import { error } from "@sveltejs/kit";
export const load = async ({ params }) => {
    try {
        const post = await import(`../${params.slug}.svelte`);
        const content = post.default;
        return {
            content
        };
    }
    catch (err) {
        throw error(404, `Timeline example "${params.slug}" not found`);
    }
};


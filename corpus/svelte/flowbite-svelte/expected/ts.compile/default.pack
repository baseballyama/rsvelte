const getTrafficChannelsChartConfig = (dark) => {
    let trafficChannelsChartColors = { strokeColor: "#ffffff" };
    if (dark) {
        trafficChannelsChartColors = {
            strokeColor: "#1f2937"
        };
    }
    else {
        trafficChannelsChartColors = {
            strokeColor: "#ffffff"
        };
    }
    return {
        series: [70, 5, 25],
        labels: ["Desktop", "Tablet", "Phone"],
        colors: ["#16BDCA", "#FDBA8C", "#1A56DB"],
        chart: {
            type: "donut",
            height: 400,
            fontFamily: "Inter, sans-serif",
            toolbar: {

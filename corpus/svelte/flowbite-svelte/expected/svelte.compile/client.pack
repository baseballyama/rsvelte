						children: ($$anchor, $$slotProps) => {
							var fragment_4 = root_1();
							var node_6 = $.first_child(fragment_4);

							Avatar(node_6, { src: '/images/profile-picture-2.webp', dot: { color: "red" } });
							$.next(2);
							$.append($$anchor, fragment_4);
						},

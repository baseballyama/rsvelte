						placeholder: 'name@company.com',
						required: true
					});

					$.append($$anchor, fragment_3);
				},
				$$slots: { default: true }
			});

			var node_5 = $.sibling(node_3, 2);

			Label(node_5, {
				class: 'space-y-2',
				children: ($$anchor, $$slotProps) => {
					var fragment_4 = root_1();
					var node_6 = $.sibling($.first_child(fragment_4), 2);

					Input(node_6, {

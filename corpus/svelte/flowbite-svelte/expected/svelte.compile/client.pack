				var img_1 = $.first_child(fragment_1);
				var node = $.sibling(img_1, 2);

				Gallery(node, {
					class: 'grid-cols-5',
					get items() {
						return images2;
					},

					get figure() {
						return figure;
					}
				});

				$.template_effect(() => {
					$.set_attribute(img_1, 'src', $.get(main).src);
					$.set_attribute(img_1, 'alt', $.get(main).alt);
				});

				$.append($$anchor, fragment_1);
			},
			$$slots: { figure: true, default: true }
		});
	}
}

$.delegate(['click']);

	P(node_10, {
		children: ($$anchor, $$slotProps) => {
			var fragment_2 = root_1();
			var text_7 = $.sibling($.first_child(fragment_2));

			$.template_effect(() => $.set_text(text_7, ` ${($.get(current) === 0

var root_2 = $.from_html(`<!> <!>`, 1);

export default function Custom($$anchor) {
	let selected = $.state(void 0);

	let countries = [
		{ value: "us", name: "United States" },
		{ value: "ca", name: "Canada" },
		{ value: "fr", name: "France" }
	];


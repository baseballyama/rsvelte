export default function Reddit($$anchor, $$props) {
	let small = $.prop($$props, 'small', 3, false);
	var fragment = $.comment();
	var node = $.first_child(fragment);

	{
		var consequent = ($$anchor) => {
			var svg = root();

			$.append($$anchor, svg);
		};

		var alternate = ($$anchor) => {
			var svg_1 = root_1();

			$.append($$anchor, svg_1);
		};

		$.if(node, ($$render) => {
			if (small()) $$render(consequent); else $$render(alternate, -1);
		});
	}

	$.append($$anchor, fragment);
}

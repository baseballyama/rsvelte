	const sizes = ["4", "5", "6", "8", "10", "12", "16"];
	let spinnerSize = $.state("8");
	let spinnerClass = $.state("");

	const changeClass = () => {
		$.set(spinnerClass, $.get(spinnerClass) === "" ? "ml-4" : "", true);
	};


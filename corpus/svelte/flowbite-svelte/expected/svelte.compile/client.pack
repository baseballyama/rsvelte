	const transitions = [
		{
			name: "Fly",
			transition: fly,
			params: { duration: 500, easing: linear, x: 150 }
		},

		{
			name: "Blur",
			transition: blur,
			params: { duration: 500, easing: linear }
		},

		{
			name: "Slide",
			transition: slide,
			params: { duration: 500, easing: linear, x: -150 }
		},

		{
			name: "Scale",
			transition: scale,
			params: { duration: 500, easing: linear }
		}
	];

	let selectedTransition = $.state("Fly");
	let currentTransition = $.derived(() => transitions.find((t) => t.name === $.get(selectedTransition)) || transitions[0]);


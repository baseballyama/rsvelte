import * as $ from 'svelte/internal/client';

import {
	Footer,
	FooterLinkGroup,
	FooterLink,
	ImagePlaceholder,
	TextPlaceholder,
	Skeleton,
	FooterCopyright
} from "flowbite-svelte";

var root = $.from_html(`<!> <!> <!> <!>`, 1);
var root_1 = $.from_html(`<!> <!>`, 1);

		$$slots: { default: true }
	});

	var node_10 = $.sibling(node_7, 2);

	P(node_10, {
		class: 'mt-4 text-sm text-gray-600 dark:text-gray-400',
		children: ($$anchor, $$slotProps) => {
			$.next();

			var text_9 = $.text('Note: Step 1 is forced to "completed" and Step 4 is forced to "pending" regardless of the current value.');

			$.append($$anchor, text_9);
		},
		$$slots: { default: true }
	});

	$.reset(div_1);
	$.append($$anchor, fragment);
}

						$.append($$anchor, text_4);
					},
					$$slots: { default: true }
				});

				$.reset(div_3);
				$.reset(div);
				$.append($$anchor, div);
			},
			$$slots: { header: true, default: true }
		});
	}

	$.append($$anchor, fragment);
	$.pop();
}

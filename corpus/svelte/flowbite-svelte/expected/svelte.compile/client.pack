	var node_11 = $.sibling(node_10, 2);

	PlusPlaceholder(node_11, {});

	var node_12 = $.sibling(node_11, 2);

	PlusPlaceholder(node_12, { colnum: 2, rownum: 2 });
	$.reset(div_2);
	$.reset(div_1);
	$.reset(div);
	$.append($$anchor, fragment);
	$.pop();
}

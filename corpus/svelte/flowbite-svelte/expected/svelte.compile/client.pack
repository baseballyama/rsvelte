	LockSolid,
	WandMagicSparklesOutline,
	ChartPieOutline,
	RectangleListSolid,
	TableColumnSolid,
	GridSolid
} from "flowbite-svelte-icons";

var root = $.from_html(`<!> <!> <!>`, 1);

export default function DefaultIcon($$anchor) {
	let current = $.state(1);

	const steps = [
		{
			label: "Personal",
			description: "Info",
			icon: UserCircleOutline
		},

		{
			label: "Account",
			description: "Info",
			icon: BadgeCheckOutline
		},
		{ label: "Confirmation", icon: CheckOutline }
	];

	var fragment = root_3();
	var node = $.first_child(fragment);

	Heading(node, {
		tag: 'h3',
		class: 'mb-2 text-lg font-semibold',
		children: ($$anchor, $$slotProps) => {
			$.next();

			var text = $.text('Example 3: With icons - Checkmark for completed ✓');

			$.append($$anchor, text);
		},
		$$slots: { default: true }
	});

	var node_1 = $.sibling(node, 2);

	P(node_1, {
		class: 'mb-2 text-sm text-gray-600',
		children: ($$anchor, $$slotProps) => {
			$.next();

			var text_1 = $.text('When you click step 2 or 3, previous steps show checkmarks (default: showCheckmarkForCompleted=true)');

			$.append($$anchor, text_1);
		},
		$$slots: { default: true }
	});

	var node_2 = $.sibling(node_1, 2);

	Stepper(node_2, {
		get steps() {
			return steps;
		},

		get current() {
			return $.get(current);
		},

		set current($$value) {
			$.set(current, $$value, true);
		}
	});

	var node_3 = $.sibling(node_2, 2);

	Heading(node_3, {
		tag: 'h3',
		class: 'mt-8 mb-2 text-lg font-semibold',
		children: ($$anchor, $$slotProps) => {
			$.next();

			var text_2 = $.text('Example 4: With icons - Keep icons for completed');

			$.append($$anchor, text_2);
		},
		$$slots: { default: true }
	});

	var node_4 = $.sibling(node_3, 2);

	P(node_4, {
		class: 'mb-2 text-sm text-gray-600',
		children: ($$anchor, $$slotProps) => {
			$.next();

			var text_3 = $.text('All steps keep their icons (showCheckmarkForCompleted=false)');

			$.append($$anchor, text_3);
		},
		$$slots: { default: true }
	});

	var node_5 = $.sibling(node_4, 2);

	Stepper(node_5, {
		get steps() {
			return steps;
		},
		showCheckmarkForCompleted: false,
		get current() {
			return $.get(current);
		},

		set current($$value) {
			$.set(current, $$value, true);
		}
	});

	var div = $.sibling(node_5, 2);
	var node_6 = $.child(div);

	{
		let $0 = $.derived(() => $.get(current) === 0);


									: i + 1 === $.get(current) ? "current" : "pending")));

								$.append($$anchor, text_8);
							},
							$$slots: { default: true }
						});

						$.template_effect(() => $.set_text(text_7, `${stepLabels[i] ?? ''}: `));
						$.append($$anchor, fragment_4);

										$.append($$anchor, text_4);
									},
									$$slots: { default: true }
								});

								var node_8 = $.sibling(node_7, 2);

								TableBodyCell(node_8, {
									children: ($$anchor, $$slotProps) => {
										$.next();

										var text_5 = $.text();

										$.template_effect(() => $.set_text(text_5, $.get(item).maker));
										$.append($$anchor, text_5);

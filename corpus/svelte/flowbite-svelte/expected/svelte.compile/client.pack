	var div = root_1();
	var node = $.child(div);

	Card(node, {
		img: '/images/image-1.webp',
		href: '/',
		horizontal: true,
		size: 'md',
		get reverse() {
			return hCard;
		},

		children: ($$anchor, $$slotProps) => {
			var div_1 = root();

			$.append($$anchor, div_1);
		},
		$$slots: { default: true }
	});

	var node_1 = $.sibling(node, 2);

	Toggle(node_1, {
		class: 'italic dark:text-gray-500',
		get checked() {
			return hCard;
		},

		set checked($$value) {
			hCard = $$value;
		},

		children: ($$anchor, $$slotProps) => {
			$.next();

			var text = $.text('Reverse');

			$.append($$anchor, text);
		},
		$$slots: { default: true }

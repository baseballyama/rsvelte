			$.set(textareaRef, $$value, true);
		},

		get value() {
			return $.get(textContent);
		},

		set value($$value) {
			$.set(textContent, $$value, true);
		}
	});

	var node_1 = $.sibling(node, 2);

	Button(node_1, {
		class: 'mt-2',
		onclick: () => {

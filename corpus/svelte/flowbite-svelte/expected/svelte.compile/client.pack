				$.reset(div_1);
				$.reset(div);

				var div_2 = $.sibling(div, 2);
				var node_4 = $.child(div_2);

				Label(node_4, {
					class: 'mb-4 w-full font-bold',
					children: ($$anchor, $$slotProps) => {

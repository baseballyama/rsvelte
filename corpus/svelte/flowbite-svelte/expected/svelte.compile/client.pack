		var d = $.derived(() => blockDirs.has($$props.dir));

		var alternate = ($$anchor) => {
			var div_2 = root_1();
			var div_3 = $.child(div_2);
			var node_5 = $.child(div_3);

			PageHeadSection(node_5, {
				get title() {
					return $$props.title;

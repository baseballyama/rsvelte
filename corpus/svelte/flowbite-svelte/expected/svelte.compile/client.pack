		$.set(counterInput, Math.max(1, $.get(counterInput)), true);
	});

	var form = root();
	var node = $.child(form);

	Label(node, {
		for: 'counter-input',
		class: 'mb-1 text-sm text-gray-900 dark:text-white',
		children: ($$anchor, $$slotProps) => {

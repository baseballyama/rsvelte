				$$slots: { default: true }
			});

			var node_7 = $.sibling(node_5, 2);

			Label(node_7, {
				class: 'space-y-2',
				children: ($$anchor, $$slotProps) => {
					var fragment_5 = root_2();
					var node_8 = $.sibling($.first_child(fragment_5), 2);

					Input(node_8, { type: 'text', name: 'tags', placeholder: 'tag1, tag2, tag3' });

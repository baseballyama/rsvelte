			if (badgeDismissable) props.push(" dismissable");
			if (badgeClass) props.push(` class="${badgeClass}"`);
			if (!badgeStatus2) props.push(" badgeStatus={false}");
			if (border) props.push(" border");
			if (link) props.push(` href="${link}"`);

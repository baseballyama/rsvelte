		};

		let rounded = false;

		const changeRounded = () => {
			rounded = !rounded;
		};

		let link = "";

		const changeLink = () => {
			link = link === "" ? "/" : "";
		};

		let iconSlot = false;

		const changeIconSlot = () => {
			iconSlot = !iconSlot;
		};


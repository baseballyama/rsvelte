	});

	$$renderer.push(`<!----> `);

	Label($$renderer, {
		class: 'space-y-2',
		children: ($$renderer) => {
			$$renderer.push(`<div>Default input - right icon</div> `);

			{
				function left($$renderer) {
					EnvelopeSolid($$renderer, { class: 'h-5 w-5' });
				}

				Input($$renderer, {
					type: 'email',
					placeholder: 'name@flowbite.com',

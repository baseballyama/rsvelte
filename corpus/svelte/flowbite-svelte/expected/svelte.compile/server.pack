	Tooltip($$renderer, {
		class: 'dark:bg-gray-900',
		placement: 'bottom',
		children: ($$renderer) => {
			$$renderer.push(`<!---->${$.escape(name)}`);
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!---->`);
}

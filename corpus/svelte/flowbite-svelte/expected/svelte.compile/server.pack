				class: 'font-medium underline decoration-solid decoration-2 underline-offset-2 hover:no-underline dark:decoration-1',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Flowbite Library`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----></span></p>`);
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!---->`);
}

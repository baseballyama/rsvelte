export default function Default($$renderer) {
	$$renderer.push(`<div class="text-center">`);

	Heading($$renderer, {
		tag: 'h1',
		class: 'mb-4 text-4xl font-extrabold  md:text-5xl lg:text-6xl',
		children: ($$renderer) => {

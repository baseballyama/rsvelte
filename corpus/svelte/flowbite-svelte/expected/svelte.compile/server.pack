					EnvelopeSolid($$renderer, { class: 'h-4 w-4' });
				}

				Input($$renderer, {
					type: 'email',
					placeholder: 'name@flowbite.com',
					size: 'sm',
					class: 'ps-8',
					left,
					$$slots: { left: true }
				});
			}

			$$renderer.push(`<!---->`);
		},

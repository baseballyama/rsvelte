							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);

						Toggle($$renderer, {
							class: `italic dark:text-gray-500 ${!hasImageContent(cardImage) ? 'cursor-not-allowed opacity-50' : ''}`,
							disabled: !hasImageContent(cardImage),
							get checked() {

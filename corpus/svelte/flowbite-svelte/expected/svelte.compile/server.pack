		let eventLocation = "California, USA";
		let eventDuration = "30 min";
		let eventType = "Web conference";

		let participants = [
			{ img: "/images/profile-picture-1.webp", alt: "Participant 1" },
			{ img: "/images/profile-picture-2.webp", alt: "Participant 2" },

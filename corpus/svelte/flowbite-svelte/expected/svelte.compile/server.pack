		warnThemeDeprecation("Table", untrack(() => ({ divClass })), { divClass: "div" });

		const styling = $.derived(() => classes ?? { div: divClass });
		const theme = $.derived(() => getTheme("table"));

		const $$d = $.derived(() => tableCls({ color, shadow })),
			div = $.derived(() => $$d().div),
			table = $.derived(() => $$d().table);


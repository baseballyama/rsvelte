			$$slots,
			$$events,
			...restProps
		} = $$props;

		// Theme context
		const theme = $.derived(() => getTheme("avatar"));

		let dotProps = $.derived(() => dot
			? { placement: "top-right", color: "gray", size: "lg", ...dot }
			: undefined);

		let avatarClass = $.derived(() => avatar({
			cornerStyle,

	function $$render_inner($$renderer) {
		Heading($$renderer, {
			tag: 'h3',
			class: 'mb-4 text-lg font-semibold',
			children: ($$renderer) => {
				$$renderer.push(`<!---->Breadcrumb Stepper with Custom Icons`);
			},

		let groupClass = "space-y-2";
		const sidebarUi = uiHelpers();
		let isOpen = false;
		const closeSidebar = sidebarUi.close;

		afterNavigate(() => {
			// this fixes https://github.com/themesberg/flowbite-svelte/issues/364

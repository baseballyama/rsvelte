			ctxBtnClass
		} = {
			toggleSelected: ctx?.toggleSelected ?? (() => {}),
			isSelected: ctx?.isSelected ?? (() => false),
			multiSelect: ctx?.multiSelect ?? false,
			size: ctx?.size,
			roundedSize: ctx?.roundedSize,

			});

			$$renderer.push(` `);

			P($$renderer, {
				children: ($$renderer) => {
					$$renderer.push(`<!---->This installs \`flowbite-svelte\` (Svelte components) and \`flowbite\` as development dependencies.`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----></section> <section id="basic-usage" class="px-4 pb-16">`);

			Heading($$renderer, {
				tag: 'h2',
				class: 'mb-6 text-3xl font-bold',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Basic Usage`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);

			P($$renderer, {
				class: 'mb-6 text-gray-700 dark:text-gray-300',
				children: ($$renderer) => {
					$$renderer.push(`<!---->The simplest way to use ScrollSpy is to provide an array of navigation items:`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);

			$.css_props($$renderer, true, { '--langtag-color': 'orange' }, () => {
				HighlightSvelte($$renderer, {
					code: exampleModules["./md/usage.md"],
					langtag: true,
					class: 'mb-4'
				});
			});

			$$renderer.push(` `);

			Alert($$renderer, {
				color: 'red',
				class: 'text-md p-6',
				children: ($$renderer) => {
					$$renderer.push(`<strong>Note:</strong> Make sure each section has an <code>id</code> attribute that matches the <code>id</code> in your items array.`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----></section> <section id="features" class="px-4 pb-16">`);

			Heading($$renderer, {
				tag: 'h2',
				class: 'mb-6 text-3xl font-bold',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Features`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> <h3 class="mb-4 text-2xl font-semibold text-gray-800 dark:text-gray-200">Custom Positioning</h3> <p class="mb-4 text-gray-700 dark:text-gray-300">You can position the navigation on the top, left, or right:</p> `);

			$.css_props($$renderer, true, { '--langtag-color': 'orange' }, () => {
				HighlightSvelte($$renderer, {
					code: exampleModules["./md/position.md"],
					langtag: true,
					class: 'mb-4'
				});
			});

			$$renderer.push(` <h3 class="mb-4 text-2xl font-semibold text-gray-800 dark:text-gray-200">Offset for Fixed Headers</h3> <p class="mb-4 text-gray-700 dark:text-gray-300">If you have a fixed header, use the <code>offset</code> prop to adjust when sections are considered "active":</p> `);

			$.css_props($$renderer, true, { '--langtag-color': 'orange' }, () => {
				HighlightSvelte($$renderer, {
					code: exampleModules["./md/offset.md"],
					langtag: true,
					class: 'mb-4'
				});
			});

			$$renderer.push(` <h3 class="mb-4 text-2xl font-semibold text-gray-800 dark:text-gray-200">Custom Active Styling</h3> <p class="mb-4 text-gray-700 dark:text-gray-300">Customize the appearance of active navigation items:</p> `);

			$.css_props($$renderer, true, { '--langtag-color': 'orange' }, () => {
				HighlightSvelte($$renderer, {
					code: exampleModules["./md/style.md"],
					langtag: true,
					class: 'mb-4'

				color: 'lime',
				onclick: () => createFromTemplate("SMARTPHONE", "APPLE"),
				children: ($$renderer) => {
					$$renderer.push(`<!---->iPhone Template`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);

			Button($$renderer, {
				color: 'indigo',
				onclick: () => createFromTemplate("SMARTPHONE", "SAMSUNG"),
				children: ($$renderer) => {
					$$renderer.push(`<!---->Samsung Phone`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);

			Button($$renderer, {

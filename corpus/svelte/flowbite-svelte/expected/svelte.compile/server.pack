			iconClass,
			txtClass,
			contentClass,
			classes,
			$$slots,
			$$events,
			...restProps
		} = $$props;

		warnThemeDeprecation("ButtonToggle", untrack(() => ({ iconClass, txtClass, contentClass })), { iconClass: "icon", txtClass: "text", contentClass: "content" });


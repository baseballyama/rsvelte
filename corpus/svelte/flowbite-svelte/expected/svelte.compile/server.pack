import { KanbanBoard, Modal, Label, Input, Textarea, Button } from "flowbite-svelte";

export default function UsingModal($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let columns = [
			{
				id: "backlog",
				title: "Backlog",
				color: "#6b7280",

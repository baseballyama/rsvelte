				if (Slide) {
					$$renderer.push('<!--[-->');
					Slide($$renderer, { image: images[index] });
					$$renderer.push('<!--]-->');
				} else {
					$$renderer.push('<!--[!-->');
					$$renderer.push('<!--]-->');
				}

				$$renderer.push(`</a>`);
			}

			Carousel($$renderer, { images, duration: 3900, slide, $$slots: { slide: true } });
		}

		$$renderer.push(`<!----></div>`);
	});
}

			});

			$$renderer.push(`</section> <section id="props" class="px-4 pb-16">`);

			Heading($$renderer, {
				tag: 'h2',
				class: 'mb-6 text-3xl font-bold',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Props Reference`);
				},

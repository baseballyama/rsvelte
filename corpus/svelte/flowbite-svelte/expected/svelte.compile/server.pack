					TableBodyRow($$renderer, {
						class: 'divide-x rtl:divide-x-reverse dark:divide-gray-700',
						children: ($$renderer) => {
							TableBodyCell($$renderer, {
								children: ($$renderer) => {
									Label($$renderer, {
										for: 'radio1',

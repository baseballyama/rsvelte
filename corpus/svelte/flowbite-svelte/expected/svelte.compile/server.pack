						class: 'cursor-pointer',
						children: ($$renderer) => {
							$$renderer.push(`<!---->Slide`);

							ChevronDownOutline($$renderer, {
								class: 'text-primary-800 ms-2 inline h-6 w-6 dark:text-white'

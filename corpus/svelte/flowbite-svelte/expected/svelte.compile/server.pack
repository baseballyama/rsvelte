						$$renderer.push(`<p class="mb-5">Hi <a href="#top" class="text-primary-600 dark:text-primary-500 font-medium hover:underline">@josephh</a> Sure, just let me know whean you are available and we can speak.</p> <label for="chat" class="sr-only">Your message</label> <div class="flex items-center gap-5">`);
						Textarea($$renderer, { rows: 1, placeholder: 'Reply in thread...' });
						$$renderer.push(`<!----> `);

						ToolbarButton($$renderer, {
							type: 'submit',
							color: 'default',
							class: 'text-primary-600 hover:bg-primary-100 p-2',
							children: ($$renderer) => {
								$$renderer.push(`<svg aria-hidden="true" class="h-6 w-6 rotate-90" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"></path></svg> <span class="sr-only">Send message</span>`);

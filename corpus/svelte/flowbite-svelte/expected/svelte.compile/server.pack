			children: ($$renderer) => {
				Controls($$renderer, {});
				$$renderer.push(`<!----> `);
				CarouselIndicators($$renderer, {});
				$$renderer.push(`<!---->`);
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----></div>`);
	});
}

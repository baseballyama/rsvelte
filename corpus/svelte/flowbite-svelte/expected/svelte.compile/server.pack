			$$renderer.push(`<!--]--> `);

			if (percentRating()) {
				$$renderer.push('<!--[0-->');

				if (Icon) {
					$$renderer.push('<!--[-->');

					Icon($$renderer, {
						size,
						fillPercent: percentRating(),
						iconIndex: fullStars(),
						groupId: `rating-${ratingGroupId}-partial`
					});

					$$renderer.push('<!--]-->');
				} else {
					$$renderer.push('<!--[!-->');
					$$renderer.push('<!--]-->');
				}
			} else {

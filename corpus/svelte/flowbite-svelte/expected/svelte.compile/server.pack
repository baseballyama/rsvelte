						Button($$renderer, {
							class: 'w-40',
							onclick: changeUnderline,
							children: ($$renderer) => {
								$$renderer.push(`<!---->${$.escape(underline ? "Default" : "Underline")}`);
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);

						Button($$renderer, {
							class: 'w-40',
							color: 'secondary',
							onclick: changeDiabled,
							children: ($$renderer) => {
								$$renderer.push(`<!---->${$.escape(disabled ? "Enabled" : "Disabled")}`);
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);

						Button($$renderer, {

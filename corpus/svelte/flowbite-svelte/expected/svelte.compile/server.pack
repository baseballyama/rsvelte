				});
			}

			$$renderer.push(`<!--]-->`);
		} else {
			$$renderer.push('<!--[-1-->');
		}

		$$renderer.push(`<!--]--> <span${$.attr_class($.clsx(text()({ selected, class: clsx(theme()?.text, styling().text) })))}>`);
		children($$renderer);
		$$renderer.push(`<!----></span></div></button>`);

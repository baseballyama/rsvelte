			$$slots: { default: true }
		});

		$$renderer.push(`<!----></div> <div class="col-span-full space-y-4 xl:col-auto">`);
		UserProfile($$renderer, { src: users[4].avatar });
		$$renderer.push(`<!----> `);
		LanguageTime($$renderer, { languages, timezones });
		$$renderer.push(`<!----> `);
		SocialAccounts($$renderer, {});

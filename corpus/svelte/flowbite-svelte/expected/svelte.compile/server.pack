								$$renderer.push(`<!---->${$.escape(bg ? "Remove bg" : "Add bg")}`);
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);

						Button($$renderer, {
							class: 'w-40',
							color: 'sky',

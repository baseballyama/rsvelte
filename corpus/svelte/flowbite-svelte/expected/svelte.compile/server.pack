	function handleSingleSelect(value) {
		if (typeof value === "string" || value === null) {
			singleValue = value;
			console.log("Single selection:", value);
		}
	}

	function handleMultiSelect(values) {
		if (Array.isArray(values)) {
			multiValues = values;
			console.log("Multi selection:", values);
		}
	}


							$$renderer.push(`<!--[0--><div${$.attr_class($.clsx(title()({ class: clsx(theme()?.title, classes?.title) })))}><h3${$.attr_class($.clsx(h3()({ class: clsx(theme()?.h3, classes?.h3) })))}>${$.escape(titleSlot)}</h3></div>`);

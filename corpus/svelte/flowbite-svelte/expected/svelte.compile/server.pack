import {
	Sidebar,
	SidebarGroup,
	SidebarItem,
	SidebarDropdownWrapper,
	SidebarButton,
	uiHelpers
} from "flowbite-svelte";

import {
	ChartOutline,
	GridSolid,
	UserSolid,
	EditSolid,
	ShoppingBagSolid
} from "flowbite-svelte-icons";


				}

				CodeWrapper($$renderer, {
					codeblock,
					children: ($$renderer) => {
						Label($$renderer, {
							class: 'text-lg font-bold',
							color: labelColor,
							children: ($$renderer) => {
								$$renderer.push(`<!---->${$.escape(capitalizeFirstLetter(labelColor))}`);
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> <div class="flex flex-wrap space-x-2">`);

						Label($$renderer, {
							class: 'm-4 w-full font-bold',
							children: ($$renderer) => {
								$$renderer.push(`<!---->Color`);
							},
							$$slots: { default: true }
						});


import { Popover } from "flowbite-svelte";
import { QuestionCircleSolid, ChevronRightOutline } from "flowbite-svelte-icons";

export default function Description($$renderer) {
	$$renderer.push(`<div class="flex items-center text-sm font-light text-gray-500 dark:text-gray-400">This is just some informational text <button id="b3">`);
	QuestionCircleSolid($$renderer, { class: 'ms-1.5 h-5 w-5' });
	$$renderer.push(`<!----> <span class="sr-only">Show information</span></button></div> `);

	Popover($$renderer, {
		triggeredBy: '#b3',
		class: 'w-72 bg-white text-sm font-light text-gray-500 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400',
		placement: 'bottom-start',
		children: ($$renderer) => {
			$$renderer.push(`<div class="space-y-2 p-3"><h3 class="font-semibold text-gray-900 dark:text-white">Activity growth - Incremental</h3> Report helps navigate cumulative growth of community activities. Ideally, the chart should have a growing trend. <span class="font-semibold text-gray-900 dark:text-white">Calculation</span> For each date bucket, the all-time volume of activities is calculated. This means that activities in period n contain all activities up to period n. <a href="/" class="text-primary-600 dark:text-primary-500 dark:hover:text-primary-600 hover:text-primary-700 flex items-center font-medium">Read more `);

			ChevronRightOutline($$renderer, {
				class: 'text-primary-600 dark:text-primary-500 ms-1.5 h-4 w-4'
			});

			$$renderer.push(`<!----></a></div>`);
		},
		$$slots: { default: true }
	});

	$$renderer.push(`<!---->`);
}

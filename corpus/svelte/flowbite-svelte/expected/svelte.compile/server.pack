			prev: prevClass,
			next: nextClass,
			span: spanClass,
			tableDiv: tableDivClass
		});

		const theme = $.derived(() => getTheme("paginationNav"));

		// Create context object
		const ctx = {
			get group() {
				return true;
			},

			get size() {
				return size;
			},

			get table() {
				return layout === "table";
			},

			get activeClasses() {
				return classes?.active;
			}
		};


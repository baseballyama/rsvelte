	function calculateGridItems() {
		return colnum * rownum;
	}

	const colclass = $.derived(() => `grid-cols-${colnum}`);

	$$renderer.push(`<div${$.attr_class(`mb-4 grid ${colclass()} gap-4`)}><!--[-->`);


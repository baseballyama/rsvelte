			currentPage = 1,
			totalPages = 1,
			visiblePages = 5, // New prop to control visible pages
			onPageChange,
			prevContent,
			nextContent,
			prevClass,
			nextClass,
			layout = "pagination",
			nextLabel = "Next",
			previousLabel = "Previous",
			ariaLabel = "Page navigation",
			size = "default",

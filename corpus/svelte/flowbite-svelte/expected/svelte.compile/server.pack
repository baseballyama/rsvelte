			$$slots,
			$$events,
			...restProps
		} = $$props;

		warnThemeDeprecation("PaginationNav", untrack(() => ({ prevClass, nextClass, spanClass, tableDivClass })), {
			prevClass: "prev",
			nextClass: "next",
			spanClass: "span",
			tableDivClass: "tableDiv"

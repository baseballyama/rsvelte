import * as $ from 'svelte/internal/server';
import { ScrollSpy, Radio, P, Heading, Alert } from "$lib";
import { HighlightSvelte } from "svelte-rune-highlight";
import "highlight.js/styles/github-dark.css";

export default function _page($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		const exampleModules = import.meta.glob("./md/*.*", { query: "?raw", import: "default", eager: true });

		const navigationItems = [
			{ id: "introduction", label: "Introduction" },
			{ id: "installation", label: "Installation" },
			{ id: "basic-usage", label: "Basic Usage" },
			{ id: "features", label: "Features" },
			{ id: "props", label: "Props" },
			{ id: "accessibility", label: "Accessibility" }
		];

		const TOP_OFFSET = 80;
		const SIDE_OFFSET = 20;
		let isFlex = false;
		let position = "top";
		let offsetValue = 80;
		let isSticky = true;

		const handleStickyToggle = () => {
			// if position is top, set isSticky to true, else set to true
			isSticky = position === "top" ? true : true;
		};

		const handleFlexToggle = () => {
			// if position is top, set no flex, else set flex
			isFlex = position !== "top" ? true : false;
		};

		const handleOffsetChange = () => {
			offsetValue = position === "top" ? TOP_OFFSET : SIDE_OFFSET;
		};

		const handlePositionChange = (newPosition) => {
			position = newPosition;
			handleFlexToggle();
			handleOffsetChange();
			handleStickyToggle();
		};

		const mainMarginClass = $.derived(() => position === "left" ? "ml-64" : position === "right" ? "mr-64" : "");
		let $$settled = true;
		let $$inner_renderer;

		function $$render_inner($$renderer) {
			$$renderer.push(`<div${$.attr_class(`${isFlex ? 'flex' : ''} pb-32 dark:bg-gray-900`)}>`);

			ScrollSpy($$renderer, {
				items: navigationItems,
				position,
				offset: offsetValue,
				sticky: isSticky,
				smoothScroll: true
			});

			$$renderer.push(`<!----> <main${$.attr_class(`container mx-auto px-4 pb-8 ${mainMarginClass()}`)}><div class="my-4 flex p-2">`);

			P($$renderer, {
				class: 'me-2 text-xl font-semibold',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Position:`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> <div class="flex gap-3">`);

			Radio($$renderer, {
				value: 'top',
				onchange: () => handlePositionChange("top"),
				get group() {
					return position;
				},

				set group($$value) {
					position = $$value;
					$$settled = false;
				},

				children: ($$renderer) => {
					$$renderer.push(`<!---->Top`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);

			Radio($$renderer, {
				value: 'left',
				onchange: () => handlePositionChange("left"),
				get group() {
					return position;
				},

				set group($$value) {
					position = $$value;
					$$settled = false;
				},

				children: ($$renderer) => {
					$$renderer.push(`<!---->Left`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);

			Radio($$renderer, {
				value: 'right',
				onchange: () => handlePositionChange("right"),
				get group() {
					return position;
				},

				set group($$value) {
					position = $$value;
					$$settled = false;
				},

				children: ($$renderer) => {
					$$renderer.push(`<!---->Right`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----></div></div> <section id="introduction" class="p-4">`);

			Heading($$renderer, {
				tag: 'h1',
				class: 'text-4xl',
				children: ($$renderer) => {
					$$renderer.push(`<!---->ScrollSpy Component`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);

			P($$renderer, {
				class: 'mb-4 text-lg',
				children: ($$renderer) => {
					$$renderer.push(`<!---->A navigation component that tracks scroll position and highlights the currently visible section. Supports smooth scrolling, sticky positioning, custom scroll containers, offset handling, and
        active state callbacks for building interactive page or documentation navigation.`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----></section> <section id="installation" class="border-t border-gray-200 px-4 py-8 dark:border-gray-700">`);

			Heading($$renderer, {
				tag: 'h2',
				class: 'mb-6 text-3xl font-bold',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Installation`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);

			P($$renderer, {
				children: ($$renderer) => {
					$$renderer.push(`<!---->Install the required packages:`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> `);

			$.css_props($$renderer, true, { '--langtag-color': 'orange' }, () => {
				HighlightSvelte($$renderer, {
					code: exampleModules["./md/installation.md"],

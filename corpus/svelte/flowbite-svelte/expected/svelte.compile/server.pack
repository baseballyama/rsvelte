					children: ($$renderer) => {
						UndoRedoButtonGroup($$renderer, { editor: editorInstance });
					},
					$$slots: { default: true }
				});
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> <div class="mt-4">`);

		Button($$renderer, {
			onclick: () => console.log(getEditorContent()),
			children: ($$renderer) => {
				$$renderer.push(`<!---->Get Content`);
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----> `);


/* countdown.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export function createCountdown(initialSeconds = 60) {
	let timeLeft = $.state($.proxy(initialSeconds));
	let isRunning = $.state(false);
	let animationId = null;
	let lastTimestamp = null;

	function tick(timestamp) {
		if (!lastTimestamp) {
			lastTimestamp = timestamp;
		}

		const elapsed = timestamp - lastTimestamp;

		if (elapsed >= 1000) {
			$.update(timeLeft, -1);
			lastTimestamp = timestamp;

			if ($.get(timeLeft) <= 0) {
				stop();
				$.set(timeLeft, 0);

				return;
			}
		}

		if ($.get(isRunning)) {
			animationId = requestAnimationFrame(tick);
		}
	}

	function start() {
		if ($.get(timeLeft) > 0 && !$.get(isRunning)) {
			$.set(isRunning, true);
			lastTimestamp = null;
			animationId = requestAnimationFrame(tick);
		}
	}

	function stop() {
		$.set(isRunning, false);
		lastTimestamp = null;

		if (animationId) {
			cancelAnimationFrame(animationId);
			animationId = null;
		}
	}

	function reset(seconds) {
		stop();
		$.set(timeLeft, seconds, true);
	}

	function destroy() {
		if (animationId) {
			cancelAnimationFrame(animationId);
		}
	}

	// ensures cleanup happens automatically when the component using createCountdown unmounts
	$.user_effect(() => {
		return () => destroy();
	});

	return {
		get timeLeft() {
			return $.get(timeLeft);
		},

		get isRunning() {
			return $.get(isRunning);
		},
		start,
		stop,
		reset,
		destroy
	};
}

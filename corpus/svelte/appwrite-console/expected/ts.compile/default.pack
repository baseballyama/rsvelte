=== 403 src/lib/commandCenter/subPanels.ts	js
import { writable } from 'svelte/store';
export const subPanels = writable([]);
export function addSubPanel(subPanel) {
    subPanels.update((curr) => {
        curr.push(subPanel);
        return curr;
    });
}
export function popSubPanel() {
    subPanels.update((curr) => {
        curr = curr.slice(0, -1);
        return curr;
    });
}
export function clearSubPanels() {
    subPanels.set([]);
}


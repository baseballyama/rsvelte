        const ctx = canvas.getContext('2d');
        if (!ctx)
            return '';
        canvas.width = 200;
        canvas.height = 50;
        ctx.textBaseline = 'top';
        ctx.font = '14px Arial';
        ctx.fillStyle = '#f60';
        ctx.fillRect(125, 1, 62, 20);
        ctx.fillStyle = '#069';
        ctx.fillText('Appwrite Console', 2, 15);
        ctx.fillStyle = 'rgba(102, 204, 0, 0.7)';

import { Dependencies } from '$lib/constants';
import { sdk } from '$lib/stores/sdk';
import { ProjectPolicyId } from '@appwrite.io/console';
const ProjectEmailPolicyId = {
    DenyAliasedEmail: 'deny-aliased-email',
    DenyDisposableEmail: 'deny-disposable-email',
    DenyFreeEmail: 'deny-free-email',
    DenyCorporateEmail: 'deny-corporate-email'
};
const getDefaultEnabledPolicy = (policyId) => ({
    $id: policyId,
    enabled: false
});
const getDefaultPasswordStrengthPolicy = () => ({
    $id: ProjectPolicyId.Passwordstrength,
    min: 8,
    uppercase: false,
    lowercase: false,
    number: false,
    symbols: false
});
export const load = async ({ depends, params }) => {
    depends(Dependencies.PROJECT);
    const { policies } = await sdk.forProject(params.region, params.project).project.listPolicies();
    const policiesById = Object.fromEntries(policies.map((policy) => [policy.$id, policy]));
    return {
        mfaFactorsPolicy: policiesById[ProjectPolicyId.Mfafactors],
        membershipPrivacyPolicy: policiesById[ProjectPolicyId.Membershipprivacy],
        passwordDictionaryPolicy: policiesById[ProjectPolicyId.Passworddictionary],
        passwordHistoryPolicy: policiesById[ProjectPolicyId.Passwordhistory],
        passwordStrengthPolicy: policiesById[ProjectPolicyId.Passwordstrength] ??
            getDefaultPasswordStrengthPolicy(),
        passwordPersonalDataPolicy: policiesById[ProjectPolicyId.Passwordpersonaldata],
        sessionAlertPolicy: policiesById[ProjectPolicyId.Sessionalert],
        sessionDurationPolicy: policiesById[ProjectPolicyId.Sessionduration],
        sessionInvalidationPolicy: policiesById[ProjectPolicyId.Sessioninvalidation],
        sessionLimitPolicy: policiesById[ProjectPolicyId.Sessionlimit],
        userLimitPolicy: policiesById[ProjectPolicyId.Userlimit],
        denyAliasedEmailPolicy: policiesById[ProjectEmailPolicyId.DenyAliasedEmail] ??
            getDefaultEnabledPolicy(ProjectEmailPolicyId.DenyAliasedEmail),
        denyDisposableEmailPolicy: policiesById[ProjectEmailPolicyId.DenyDisposableEmail] ??
            getDefaultEnabledPolicy(ProjectEmailPolicyId.DenyDisposableEmail),
        denyFreeEmailPolicy: policiesById[ProjectEmailPolicyId.DenyFreeEmail] ??
            getDefaultEnabledPolicy(ProjectEmailPolicyId.DenyFreeEmail),
        denyCorporateEmailPolicy: policiesById[ProjectEmailPolicyId.DenyCorporateEmail] ??
            getDefaultEnabledPolicy(ProjectEmailPolicyId.DenyCorporateEmail)
    };
};

=== 875 src/routes/(console)/project-[region]-[project]/auth/settings/+page.ts	js
import { Dependencies } from '$lib/constants';
import { oAuthProviders } from '$lib/stores/oauth-providers';
import { sdk } from '$lib/stores/sdk';
export const load = async ({ depends, params }) => {
    depends(Dependencies.PROJECT);
    const [providerList, consoleProviderList] = await Promise.all([
        sdk.forProject(params.region, params.project).project.listOAuth2Providers(),
        sdk.forConsole.console.listOAuth2Providers()
    ]);
    const consoleParamsMap = new Map();
    for (const cp of consoleProviderList.oAuth2Providers) {
        consoleParamsMap.set(cp.$id, cp.parameters ?? []);
    }
    const oauthProviders = providerList.providers
        .filter((p) => p.$id !== 'mock')
        .map((p) => ({
        ...p,
        key: p.$id,
        name: oAuthProviders[p.$id]?.name ?? p.$id
    }));
    return { oauthProviders, consoleParamsMap };
};


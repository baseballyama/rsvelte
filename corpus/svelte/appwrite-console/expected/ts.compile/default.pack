export const TRAILING_COMMA_REGEX = /,\s*$/;
export const WHITESPACE_REGEX = /^\s*/;
export const WHITESPACE_ONLY_REGEX = /^\s+$/;
export const NESTED_KEY_REGEX = /^(\s{4,})([A-Za-z_$][A-Za-z0-9_$]*)\s*:/;

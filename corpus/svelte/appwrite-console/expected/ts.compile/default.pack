import { trackEvent } from '$lib/actions/analytics';
import { writable } from 'svelte/store';
function createWizardStore() {
    const { subscribe, update, set } = writable({
        show: false,
        component: null,
        cover: null,
        interceptor: null,
        interceptorNotificationEnabled: true,
        media: null,
        nextDisabled: false,
        step: 1,
        finalAction: null,
        props: {}
    });
    return {
        subscribe,
        set,
        start: (component, media = null, step = 1, props = {}) => update((n) => {
            n.show = true;
            n.component = component;
            n.interceptor = null;
            n.interceptorNotificationEnabled = true;
            n.media = media;
            n.step = step;
            n.cover = null;
            n.nextDisabled = false;
            n.finalAction = null;
            n.props = props;
            trackEvent('wizard_start');
            return n;
        }),
        setInterceptor: (callback) => {
            update((n) => {
                n.interceptor = callback;
                return n;
            });
        },
        setNextDisabled: (disabled) => {
            update((n) => {
                n.nextDisabled = disabled;
                return n;
            });
        },
        hide: () => update((n) => {
            n.show = false;
            n.component = null;
            n.interceptor = null;
            n.interceptorNotificationEnabled = true;
            n.media = null;
            n.step = 1;
            n.cover = null;
            n.nextDisabled = false;
            n.finalAction = null;
            return n;
        }),
        showCover: (component) => update((n) => {
            n.cover = component;
            return n;
        }),
        updateStep: (cb) => {
            update((n) => {
                n.step = cb(n.step);
                return n;
            });
        },
        setStep: (step) => {
            update((n) => {
                n.step = step;
                return n;
            });
        }
    };
}
export const wizard = createWizardStore();
export const isNewWizardStatusOpen = writable(false);
export function updateStepStatus(map, key, status) {
    const updatedComponent = {
        ...map.get(key),
        disabled: status
    };
    map.set(key, updatedComponent);
    return map;
}


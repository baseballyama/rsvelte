=== 1019 src/lib/helpers/regions.ts	js
import { getFlagUrl } from '$lib/helpers/flag';
export function filterRegions(regions) {
    if (!regions.length)
        return [];
    return regions
        .filter((region) => region.$id !== 'default')
        .sort((a, b) => {
        // Check if regions are truly available (not disabled and available)
        const aAvailable = !a.disabled && a.available;
        const bAvailable = !b.disabled && b.available;
        // Prioritize truly available regions
        if (aAvailable && !bAvailable)
            return -1;
        if (!aAvailable && bAvailable)
            return 1;
        // Within the same availability group, sort alphabetically
        return a.name.localeCompare(b.name);
    })
        .map((region) => ({
        label: region.name,
        value: region.$id,
        disabled: region.disabled || !region.available,
        leadingHtml: `<img src='${getFlagUrl(region.flag)}' alt='Region flag'/>`,
        badge: region.disabled || !region.available ? 'Coming soon' : undefined
    }));
}

=== 1231 src/lib/helpers/search.ts	js
/**
 * Finds common attribute keys across documents by analyzing their frequency.
 */
export function fuzzySearchKeys(documents, options = {}) {
    if (!documents || documents.length < 5) {
        return null;
    }
    const { minOccurrences = 2, limit } = options;
    const attributeCount = new Map();
    const threshold = minOccurrences === null ? 5 : Math.max(2, Math.min(minOccurrences, 5));
    // Process only first 5 documents
    const docLimit = Math.min(5, documents.length);
    for (let docIndex = 0; docIndex < docLimit; docIndex++) {
        const document = documents[docIndex];
        if (!document || typeof document !== 'object')
            continue;
        // track per-document keys
        const seenInDoc = new Map();
        for (const key in document) {
            if (key[0] === '$' || seenInDoc.has(key))
                continue;
            seenInDoc.set(key, true);
            attributeCount.set(key, (attributeCount.get(key) || 0) + 1);
        }
    }
    const result = [];
    for (const [key, count] of attributeCount) {
        if (count >= threshold) {
            result.push(key);
        }
    }
    result.sort();
    return limit && limit > 0 ? result.slice(0, limit) : result;
}


export var View;
(function (View) {
    View["Table"] = "table";
    View["Grid"] = "grid";
})(View || (View = {}));
export function getView(url, route, fallback, overwrite) {
    const view = url.searchParams.get('view') ?? preferences.getForRoute(route).view;
    return view === View.Grid
        ? View.Grid
        : view === View.Table
            ? View.Table
            : (overwrite ?? View.Table ?? fallback);

export function checkForUsageFees(plan, id) {
    const billingPlan = billingIdToPlan(plan);
    const supportsUsage = Object.keys(billingPlan?.usage ?? {}).length > 0;
    if (supportsUsage) {
        switch (id) {
            case 'bandwidth':
            case 'storage':
            case 'users':
            case 'executions':
            case 'realtime':
            case 'realtimeMessages':
                return true;
            default:
                return false;
        }

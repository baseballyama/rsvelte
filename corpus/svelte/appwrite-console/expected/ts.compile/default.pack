export var DeploymentResourceType;
(function (DeploymentResourceType) {
    DeploymentResourceType["FUNCTION"] = "function";
    DeploymentResourceType["SITE"] = "site";
})(DeploymentResourceType || (DeploymentResourceType = {}));
export var RuleTrigger;
(function (RuleTrigger) {
    RuleTrigger["DEPLOYMENT"] = "deployment";
    RuleTrigger["MANUAL"] = "manual";

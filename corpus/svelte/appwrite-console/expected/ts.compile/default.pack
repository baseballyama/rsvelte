    vi.mock('$app/environment', () => ({
        dev: true,
        building: true,
        browser: true,
        page: {
            params: {
                project: 'tests',
                region: 'tests'
            }
        }
    }));
    vi.mock('$app/navigation', () => ({
        goto: vi.fn(),
        beforeNavigate: vi.fn()
    }));
    vi.mock('$env/static/public', () => import.meta.env);
    vi.mock('$env/dynamic/public', () => ({
        env: import.meta.env
    }));
});


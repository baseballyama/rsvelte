    }
    return 'open';
}

=== 1163 src/lib/helpers/sizeConvertion.ts	js
import prettyBytes from 'pretty-bytes';
const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
export function calculateSize(bytes, decimals = 1, base = 1000) {
    if (bytes === 0)
        return '0 Bytes';
    const dm = decimals < 0 ? 0 : decimals;
    const i = Math.floor(Math.log(bytes) / Math.log(base));
    return parseFloat((bytes / Math.pow(base, i)).toFixed(dm)) + ' ' + sizes[i];
}
export function sizeToBytes(value, unit, base = 1000) {
    if (typeof value !== 'number')
        return 0;
    const index = sizes.indexOf(unit);
    return value * Math.pow(base, index);
}
export function bytesToSize(value, unit, base = 1000) {
    const index = sizes.indexOf(unit);
    return value / Math.pow(base, index);
}
export function mbSecondsToGBHours(value, base = 1000) {
    return value / base / (60 * 60);
}
export function humanFileSize(bytes, useBits = false) {
    if (typeof bytes !== 'number')
        return { value: '0', unit: 'Bytes' };
    const value = prettyBytes(bytes, {
        locale: 'en',
        bits: useBits
    }).split(' ');
    return {
        value: value[0],
        unit: value[1].toUpperCase()
    };
}


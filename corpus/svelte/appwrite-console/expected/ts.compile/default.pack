export function updateSidebarState(state) {
    if (state === 'open' || state === 'icons') {
        const currentPrefs = userPreferences();
        const newPrefs = {
            ...currentPrefs,
            sidebarState: state
        };
        sdk.forConsole.account.updatePrefs({ prefs: newPrefs });
    }

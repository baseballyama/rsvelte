import { writable } from 'svelte/store';
export const bottomModalAlertsConfig = writable({ alerts: [] });
export const hideAllModalAlerts = () => {
    bottomModalAlertsConfig.update((state) => ({
        ...state,
        alerts: state.alerts.map((t) => ({ ...t, show: false }))
    }));
};
export const setMobileSingleAlertLayout = (config) => {
    bottomModalAlertsConfig.update((state) => ({
        ...state,
        mobileSingleLayout: config
    }));
};
export const dismissBottomModalAlert = (id) => {
    bottomModalAlertsConfig.update((state) => ({
        ...state,
        alerts: state.alerts.filter((t) => t.id !== id)
    }));
};
export const showBottomModalAlert = (notification) => {
    const defaults = {
        show: true,
        importance: 5,
        isHtml: false,
        ...notification
    };
    bottomModalAlertsConfig.update((state) => {
        if (state.alerts.some((t) => t.id === notification.id))
            return state;
        return {
            ...state,
            alerts: [...state.alerts, defaults]
        };
    });
};


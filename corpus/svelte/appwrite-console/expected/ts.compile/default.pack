import { resolve } from '$app/paths';
import { goto } from '$app/navigation';
export function withPath(base, ...parts) {
    // remove slashes at the end if any
    const normalizedBase = base.replace(/\/+$/, '');
    // remove slashes at the start of each part if any
    const normalizedParts = parts.map((part) => part.replace(/^\/+/, ''));
    // join em with slashes
    return [normalizedBase, ...normalizedParts].join('/');
}
export function resolveRoute(route, params) {
    // type cast is necessary here!
    const resolveArgs = params ? [route, params] : [route];
    return resolve(...resolveArgs);
}
export function navigate(route, params) {
    // type cast is necessary here!
    return goto(resolveRoute(route, params));
}

=== 1113 src/lib/stores/notifications.ts	js
import { writable } from 'svelte/store';
let counter = 0;
const activeTimeouts = new Map();
export const notifications = writable([]);
export const dismissNotification = (id) => {
    const timeoutId = activeTimeouts.get(id);
    if (timeoutId) {
        clearTimeout(timeoutId);
        activeTimeouts.delete(id);
    }
    notifications.update((all) => all.filter((t) => t.id !== id));
};
export const dismissAllNotifications = () => {
    activeTimeouts.forEach((timeoutId) => clearTimeout(timeoutId));
    activeTimeouts.clear();
    notifications.set([]);
};
export const addNotification = (notification) => {
    const defaults = {
        id: counter++,
        type: 'info',
        dismissible: true,
        timeout: 6000,
        ...notification
    };
    notifications.update((all) => [defaults, ...all.slice(0, 4)]);
    if (defaults.timeout) {
        const timeoutId = setTimeout(() => {
            activeTimeouts.delete(defaults.id);
            dismissNotification(defaults.id);
        }, defaults.timeout);
        activeTimeouts.set(defaults.id, timeoutId);
    }
    return defaults.id;
};


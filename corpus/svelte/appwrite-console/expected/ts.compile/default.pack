=== 3954 src/routes/(console)/project-[region]-[project]/databases/+page.ts	js
import { CARD_LIMIT, Dependencies } from '$lib/constants';
import { getLimit, getPage, getSearch, getView, pageToOffset, View } from '$lib/helpers/load';
import { sdk } from '$lib/stores/sdk';
import { Query } from '@appwrite.io/console';
import { timeFromNow } from '$lib/helpers/date';
import { isSelfHosted } from '$lib/system';
import { isCloud } from '$lib/system';
import { toDatabaseType, useDatabaseSdk } from '$database/(entity)';
export const load = async ({ url, route, depends, params, parent }) => {
    depends(Dependencies.DATABASES);
    const page = getPage(url);
    const search = getSearch(url);
    const limit = getLimit(url, route, CARD_LIMIT);
    const view = getView(url, route, View.Grid);
    const offset = pageToOffset(page, limit);
    // already loaded by parent.
    const { currentPlan } = await parent();
    const { databases, entities, policies, lastBackups } = await fetchDatabasesAndBackups(limit, offset, params, search, currentPlan);
    return {
        offset,
        limit,
        view,
        search,
        entities,
        policies,
        databases,
        lastBackups
    };
};
async function fetchDatabasesAndBackups(limit, offset, params, search, currentPlan) {
    const backupsEnabled = currentPlan?.backupsEnabled ?? true;
    const databaseSdk = useDatabaseSdk(params.region, params.project);
    const databases = await databaseSdk.list({
        queries: [Query.limit(limit), Query.offset(offset), Query.orderDesc('$createdAt')],
        search: search || undefined
    });
    const entities = {};
    await Promise.all(
    // TODO: backend should allow `Query.select` for perf!
    databases.databases.map(async ({ $id, type }) => {
        const res = await databaseSdk.listEntities({
            databaseId: $id,
            databaseType: toDatabaseType(type),
            queries: [Query.limit(1), Query.orderDesc('')]
        });
        entities[$id] = res.entities?.[0]?.$id ?? null;
    }));
    let lastBackups = {};
    let policies = {};
    if (isCloud && backupsEnabled) {
        [policies, lastBackups] = await Promise.all([
            fetchPolicies(databases, params),
            fetchLastBackups(databases, params)
        ]);
    }
    return { databases, entities, policies, lastBackups };
}
async function fetchPolicies(databases, params) {
    if (isSelfHosted)
        return {};
    const databasePolicies = {};
    await Promise.all(databases.databases.map(async (database) => {
        try {
            const { policies } = await sdk
                .forProject(params.region, params.project)
                .backups.listPolicies({
                queries: [
                    // TODO: are all needed!?
                    // Query.limit(3),
                    Query.equal('resourceType', 'database'),
                    Query.equal('resourceId', database.$id)
                ]
            });
            if (policies.length > 0) {
                databasePolicies[database.$id] = policies;
            }
        }
        catch (e) {
            // ignore
        }
    }));
    return databasePolicies;
}
async function fetchLastBackups(databases, params) {
    if (isSelfHosted)
        return {};
    const lastBackups = {};
    await Promise.all(databases.databases.map(async (database) => {
        try {
            const { archives } = await sdk
                .forProject(params.region, params.project)
                .backups.listArchives({
                queries: [
                    Query.limit(1),
                    Query.orderDesc('$createdAt'),
                    Query.equal('resourceType', 'database'),
                    Query.equal('resourceId', database.$id)
                ]
            });
            if (archives.length > 0) {
                lastBackups[database.$id] = timeFromNow(archives[0].$createdAt);
            }
        }
        catch (e) {
            // ignore
        }
    }));
    return lastBackups;
}


export const ALLOWED_DOLLAR_PROPS = ['$id', '$createdAt', '$updatedAt'];
export const SYSTEM_KEYS = new Set(['$id:', '$createdAt:', '$updatedAt:']);
// timing constants
export const LINTER_DELAY = 250;
export const DEBOUNCE_DELAY = 200;
export const SAVE_UNDO_TOOLBAR_TIMEOUT = 8000;
// regex patterns

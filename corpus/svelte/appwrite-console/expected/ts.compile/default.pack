        isCloud
            ? sdk.forConsole.domains.list({ queries: [Query.equal('teamId', organization.$id)] })
            : Promise.resolve({ total: 0, domains: [] })
    ]);
    return {
        func,
        rules,
        domainsList,
        installations
    };
};


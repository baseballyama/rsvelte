import { Range, RangeSet, RangeSetBuilder, StateField } from '@codemirror/state';
import { forEachDiagnostic, setDiagnosticsEffect } from '@codemirror/lint';
import { NESTED_KEY_REGEX } from '../helpers/constants';
export const SYSTEM_FIELD_ID = '$id';
export const SYSTEM_FIELD_CREATED_AT = '$createdAt';
export const SYSTEM_FIELD_UPDATED_AT = '$updatedAt';
export const SYSTEM_FIELDS = [

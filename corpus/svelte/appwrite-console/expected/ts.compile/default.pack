const SYSTEM_FIELDS_SOURCE = SYSTEM_FIELDS.map(escapeRegExp).join('|');
const SYSTEM_FIELD_KEY_LINE_PATTERN = new RegExp(`^\\s*("(?:${SYSTEM_FIELDS_SOURCE})"|(?:${SYSTEM_FIELDS_SOURCE}))\\s*:`);
function skipInlineWhitespace(text, from) {
    let i = from;
    while (i < text.length) {
        const ch = text[i];
        // Don't cross lines; values for the system fields we style are expected to be on the same line.
        if (ch !== ' ' && ch !== '\t')
            break;
        i += 1;
    }
    return i;
}
function findSingleLineValueEnd(text, from) {
    if (from >= text.length)
        return from;
    const quote = text[from];
    if (quote === '"' || quote === "'") {
        let escaped = false;
        for (let i = from + 1; i < text.length; i += 1) {
            const ch = text[i];
            if (escaped) {
                escaped = false;
                continue;
            }
            if (ch === '\\') {
                escaped = true;
                continue;
            }
            if (ch === quote) {
                return i + 1;
            }
            if (ch === '\n' || ch === '\r') {
                return i;
            }
        }
        return text.length;
    }
    // Scalar token: read until comma or newline.
    for (let i = from; i < text.length; i += 1) {

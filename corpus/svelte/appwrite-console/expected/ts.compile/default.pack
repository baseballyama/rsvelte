                    throw new Error(`Unknown database type`);
            }
        },
        async updateEntity(params) {
            switch (type ?? params.databaseType) {
                case 'legacy': /* databases api */
                case 'tablesdb':
                    return toSupportiveEntity(await baseSdk.tablesDB.updateTable({

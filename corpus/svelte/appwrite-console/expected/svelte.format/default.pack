      min-width: 96px;
    }
  }

  .controlled-selection :global([role="rowheader"]) {
    pointer-events: none;

    :global([role="cell"]) {
      opacity: 0.5;
      cursor: not-allowed;
      color: var(--fgcolor-neutral-secondary);
    }
  }
</style>


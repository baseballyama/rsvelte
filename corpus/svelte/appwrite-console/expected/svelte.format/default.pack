  }

  :global(.theme-dark) .spreadsheet-fade-bottom {
    background: linear-gradient(
      180deg,
      rgba(29, 29, 33, 0) 0%,
      rgba(29, 29, 33, 0.86) 21%,
      #1d1d21 100%

                disabled={!data.hasProdReadyDeployments}
              >
                Instant rollback
              </Button>
            </div>
            <div slot="tooltip" style={BODY_TOOLTIP_WRAPPER_STYLE}>
              Rollback is possible only if there is a deployment that is ready
              and was active.
            </div>

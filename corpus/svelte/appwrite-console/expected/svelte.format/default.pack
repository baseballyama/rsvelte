        >
          <Image
            border
            radius="s"
            ratio="16/9"
            style="width: 100%; align-self: start"
            src={getScreenshot($app.themeInUse, deployment)}
            alt="Screenshot"
          />
        </Card>
      {:else}
        <Image
          border
          radius="s"

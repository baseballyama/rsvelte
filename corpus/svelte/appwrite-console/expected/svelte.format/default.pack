              </Layout.Stack>
            </Form>
          </Layout.Stack>
        </Layout.Stack>
      </Card.Base>
    </div>
  </section>
  <footer>
    {#if $app.themeInUse === "dark"}
      <img
        src="{base}/images/appwrite-logo-dark.svg"
        width="120"
        height="22"
        alt="Appwrite Logo"

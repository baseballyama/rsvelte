  const tabs = [
    {
      href: path,
      title: "Subscribers",
      event: "subscribers",
    },
    {
      href: `${path}/settings`,
      title: "Settings",
      event: "settings",
      disabled: !$canWriteTopics,
    },
  ].filter((tab) => !tab.disabled);
</script>


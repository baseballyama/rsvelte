          <EmptySheetCards
            icon={IconPlus}
            title="Create document"
            subtitle="Manually add documents"
            onClick={() => {
              noSqlDocument.create(buildInitDoc());
            }}
          />
        {/snippet}
      </EmptySheet>
    {/if}
  </div>
{/key}

{#if showImportJson}
  <FilePicker

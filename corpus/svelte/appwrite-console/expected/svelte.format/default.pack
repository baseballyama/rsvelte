      {
        href: resolveRoute(
          "/(console)/project-[region]-[project]",
          page.params,
        ),
        title: project?.name,
      },
      {
        href: resolveRoute(
          "/(console)/project-[region]-[project]/databases",
          page.params,
        ),
        title: "Databases",
      },
    ];
  });
</script>


        </ul>
        <div>
          <Layout.Stack direction="row" gap="xs">
            <span>Provider:</span><Provider
              noIcon
              provider={$providerData.provider}
            />
          </Layout.Stack>
          <p class="title">Type: {getProviderText($providerData.type)}</p>
          <p>Created: {toLocaleDateTime($providerData.$createdAt)}</p>
        </div>
      </div>
    </div>
  </svelte:fragment>

  <svelte:fragment slot="actions">
    <div class="u-flex u-flex-wrap u-gap-12">
      <Button
        disabled={$providerData.enabled === enabled}
        on:click={() => updateStatus()}>Update</Button
      >
    </div>
  </svelte:fragment>
</CardGrid>


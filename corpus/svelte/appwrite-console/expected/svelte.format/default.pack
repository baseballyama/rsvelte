    // Hide lint tooltip since we show errors in header
    :global(.cm-tooltip.cm-tooltip-lint),
    :global(.cm-tooltip-lint),
    :global([class*="cm-tooltip"][class*="lint"]) {
      display: none !important;
      visibility: hidden !important;

  .dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes loading-dots {
    0% {
      transform: translateY(0.25rem);
    }
    25% {
      transform: translateY(0rem);
    }
    50%,
    100% {
      transform: translateY(0.25rem);
    }
  }

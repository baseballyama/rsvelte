      >
        Terms
      </Link.Anchor>
      <span class="divider-wrapper">
        <Divider vertical />
      </span>
      <Link.Anchor
        size="s"
        variant="quiet"
        href="https://appwrite.io/privacy"
        target="_blank"
        rel="noreferrer"
      >
        Privacy
      </Link.Anchor>
      {#if isCloud}
        <span class="divider-wrapper">
          <Divider vertical />
        </span>
        <Link.Anchor
          size="s"
          variant="quiet"
          href="https://appwrite.io/cookies"
          target="_blank"
          rel="noreferrer"

        <Typography.Text>Columns</Typography.Text>
        <ColumnSelector ui="new" {columns} {isCustomTable}>
          {#snippet children(toggle, selectedColumnsNumber)}
            <Button.Button
              size="s"
              variant="secondary"
              badge={selectedColumnsNumber.toString()}
              on:click={toggle}
            >
              Columns
              <Icon slot="start" icon={IconViewBoards} />
            </Button.Button>
          {/snippet}
        </ColumnSelector>
      </Layout.Stack>
    {/if}
  </Layout.Stack>
</Confirm>


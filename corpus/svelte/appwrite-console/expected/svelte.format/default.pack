  import { sdk } from "$lib/stores/sdk";
  import { page } from "$app/state";
  import type { Models } from "@appwrite.io/console";

  export async function submitPolygon(
    databaseId: string,
    tableId: string,
    key: string,
    data: Partial<Models.ColumnPolygon>,
  ) {

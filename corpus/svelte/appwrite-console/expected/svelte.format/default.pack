          active={selectedTab === "aaaa"}
        >
          AAAA
        </Tabs.Item.Button>
      {/if}
    </Tabs.Root>
    <Divider />
  </div>
  {#if selectedTab === "nameserver"}
    <NameserverTable
      {verified}

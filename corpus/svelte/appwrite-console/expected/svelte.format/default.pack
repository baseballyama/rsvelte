            >
              docs.
            </Link.Anchor>
          </Typography.Text>
        {/if}
      {/snippet}

      {#snippet actions()}
        {#if isCloud}
          <EmptySheetCards
            icon={IconAI}
            title="Suggest columns"
            subtitle="Use AI to generate columns"
            onClick={() => {
              $showColumnsSuggestionsModal = true;

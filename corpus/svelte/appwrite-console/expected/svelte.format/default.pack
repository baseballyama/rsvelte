    @media (max-width: 1024px) {
      // experiment
      margin-bottom: 15%;
    }
  }

  @media (max-width: 768px) {
    // global but controlled properly!
    :global(main:has(.no-custom-columns) .console-container) {
      opacity: 0;
    }
  }
</style>


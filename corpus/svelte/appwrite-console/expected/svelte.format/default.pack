    <Layout.Stack gap="m">
      <Selector.Radio
        size="s"
        bind:group={importOnDuplicate}
        name="importOnDuplicate"
        value={OnDuplicate.Fail}
        label="Fail on duplicate (default)"
      >
        <svelte:fragment slot="description">
          Import aborts on the first document with a matching ID.

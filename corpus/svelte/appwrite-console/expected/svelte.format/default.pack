  let {
    deployment,
    proxyRuleList,
    variant = "primary",
    activeDeployment = false,
    footer,
  }: {
    deployment: Models.Deployment;
    proxyRuleList: Models.ProxyRuleList;
    variant?: "primary" | "secondary";
    activeDeployment?: boolean;
    footer?: Snippet;
  } = $props();

  const effectiveStatus = $derived(
    getEffectiveBuildStatus(deployment, $regionalConsoleVariables),
  );
  const displayStatus = $derived(
    effectiveStatus === "finalizing" ? "ready" : effectiveStatus,
  );
  const totalSize = $derived(humanFileSize(deployment?.totalSize ?? 0));
</script>


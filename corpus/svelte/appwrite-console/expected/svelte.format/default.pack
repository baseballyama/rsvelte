          {#if $canWriteProviders}
            <CreateProviderDropdown let:toggle>
              <Button on:click={toggle} event="create_provider" secondary>
                Create provider
              </Button>
            </CreateProviderDropdown>
          {/if}
        </svelte:fragment>
      </Empty>
    </Card.Base>
  {/if}
</Container>


            />
          </Layout.Stack>
        </Fieldset>
      {/if}
    </Layout.Stack>
  </Form>

  <svelte:fragment slot="footer">
    <Button secondary href={routeBase}>Cancel</Button>
    <Button
      on:click={() => formComponent.triggerSubmit()}
      bind:disabled={$isSubmitting}
    >
      Add
    </Button>
  </svelte:fragment>
</Wizard>


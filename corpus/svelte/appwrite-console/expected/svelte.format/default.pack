    BODY_TOOLTIP_WRAPPER_STYLE_PRELINE,
  } from "$lib/helpers/tooltipContent";

  let { data }: PageProps = $props();

  async function bucketCreated(event: CustomEvent<Models.Bucket>) {
    showCreateBucket.set(false);
    await goto(
      resolveRoute(
        "/(console)/project-[region]-[project]/storage/bucket-[bucket]",
        {
          ...page.params,
          bucket: event.detail.$id,
        },
      ),
    );
  }

  const isLimited = $derived(
    isServiceLimited("buckets", $organization, data.buckets.total),
  );
</script>

<Container>
  <ResponsiveContainerHeader
    {columns}
    hasSearch
    view={data.view}
    searchPlaceholder="Search by name or ID"

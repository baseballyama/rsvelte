<script lang="ts">
  import { Container } from "$lib/layout";
  import { realtime } from "$lib/stores/sdk";
  import { onMount } from "svelte";
  import SiteCard from "../../../(components)/siteCard.svelte";
  import Logs, { badgeTypeDeployment } from "../../../(components)/logs.svelte";

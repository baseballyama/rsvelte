      <Tooltip disabled={!isLimited} maxWidth={BODY_TOOLTIP_MAX_WIDTH}>
        <div>
          <Button
            size="s"
            event="create_bucket"
            disabled={isLimited}
            on:click={() => ($showCreateBucket = true)}
          >
            <Icon icon={IconPlus} slot="start" size="s" />
            Create bucket

            title="Documentation"
            subtitle="Read the Appwrite docs"
            href="https://appwrite.io/docs/products/databases/tables#indexes"
          />
        {/if}
      {/snippet}
    </EmptySheet>
  {/snippet}

  {#snippet emptyEntitiesSheetView()}

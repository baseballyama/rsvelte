                  >
                    <Tooltip slot="info" maxWidth="15rem">
                      <Icon icon={IconInfo} size="s" />
                      <Typography.Caption variant="400" slot="tooltip">
                        {placeholder[platform].tooltip}
                      </Typography.Caption>
                    </Tooltip>
                  </InputText>

        href: `${path}/indexes`,
        title: "Indexes",
        event: "indexes",
      },
      {
        href: `${path}/settings`,
        title: "Settings",
        event: "settings",
        disabled: !$canWriteTables,
      },
    ].filter((tab) => !tab.disabled),
  );
</script>


            </svelte:fragment>
          </InputSwitch>
        </Layout.Stack>
      </Fieldset>

      <Fieldset legend="Targets">
        <Targets type={MessagingProviderType.Email} bind:topics bind:targets />
      </Fieldset>
      <Fieldset legend="Settings">
        <Schedule bind:scheduledAt {targets} />
      </Fieldset>
    </Layout.Stack>

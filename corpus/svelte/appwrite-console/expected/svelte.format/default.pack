                onCustomOptionClick={() => (showCustomColumnsModal = true)}
              />
            </div>

            <svelte:fragment slot="tooltip">Columns</svelte:fragment>
          </Tooltip>

          <Tooltip>
            <Filters
              onlyIcon
              query={data.query}
              columns={filterColumns}

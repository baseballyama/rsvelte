  import { FloatingActionBar, Icon, Layout } from "@appwrite.io/pink-svelte";
  import {
    IconExclamationCircle,
    IconExclamation,
  } from "@appwrite.io/pink-icons-svelte";

  let {
    message,
    severity = "error",
  }: {
    message: string;
    severity?: "error" | "warning";

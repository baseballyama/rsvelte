    onChangePoint: (
      lineIndex: number,
      pointIndex: number,
      coordIndex: number,
      newValue: number,
    ) => void;
    disabled?: boolean;
  };

  let {
    values,
    nullable = false,
    minDeletableIndex = 4,
    onAddPoint,
    onAddLine,
    onDeletePoint,
    onChangePoint,
    disabled,
  }: Props = $props();
</script>


      async (response) => {
        if (
          response.events.includes(
            `sites.${page.params.site}.deployments.${page.params.deployment}.update`,
          )
        ) {
          await invalidate(Dependencies.DEPLOYMENT);
        }
      },
    );
  });
</script>

<Container>

                  type={isCloud ? "success" : null}
                  content={isCloud ? "Connected" : "Available on Cloud"}
                />
              </Layout.Stack>
            </Layout.Stack>
          </Layout.Stack>
        </Layout.Stack>
        <Layout.Stack gap="xxs" inline style="width: min-content;">
          <Typography.Text variant="m-400" color="--fgcolor-neutral-tertiary">

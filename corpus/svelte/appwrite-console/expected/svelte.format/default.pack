          </svelte:fragment>
          <p class="u-color-text-offline u-small">
            {restoreOption.description}
          </p>
        </LabelCard>
      </div>
    {/each}
  </Layout.Stack>

  {#if selectedRestoreOption === "new"}
    <Layout.Stack gap="s" alignItems="flex-start">
      <InputText
        id="name"
        label="Database name"
        placeholder="Enter database name"
        bind:value={newDatabaseInfo.name}

/* init.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { page } from '$app/state';

import {
	useAnalytics,
	useDependencies,
	useTerminology,
	useDatabaseSdk
} from '$database/(entity)';

const terminologies = $.derived(() => {
	const terminology = useTerminology(page);

	return {
		terminology,
		analytics: useAnalytics(terminology),
		dependencies: useDependencies(terminology),
		databaseSdk: useDatabaseSdk(page, terminology)
	};
});

export function getTerminologies() {
	return terminologies();
}

		function generateIndexKey() {
			let indexKeys = entity.indexes.map((index) => index.key);

			let highestIndex = indexKeys.reduce(
				(max, key) => {
					const match = key.match(/^index_(\d+)$/);

					return match ? Math.max(max, parseInt(match[1], 10)) : max;

		let $$inner_renderer;

		function $$render_inner($$renderer) {
			$$renderer.push(`<div${$.attr_class('spreadsheet-wrapper svelte-88spcx', void 0, { 'has-json-editor': typeof noSqlEditor !== 'undefined' })}${$.attr_style('', { height: spreadsheetHeight })}>`);

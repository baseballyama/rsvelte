const val APPWRITE_PROJECT_NAME = "${$.store_get($$store_subs ??= {}, '$project', project).name}"
const val APPWRITE_PUBLIC_ENDPOINT = "${sdk.forProject(page.params.region, page.params.project).client.config.endpoint}"`;


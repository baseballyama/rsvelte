					{
						value: VectorsDBIndexType.HnswEuclidean,
						label: 'HNSW Euclidean'
					},
					{ value: VectorsDBIndexType.HnswDot, label: 'HNSW Dot' },
					{ value: VectorsDBIndexType.HnswCosine, label: 'HNSW Cosine' },

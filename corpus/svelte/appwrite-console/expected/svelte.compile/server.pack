		const tabs = [
			{
				href: path,
				title: 'Deployments',
				event: 'deployments',
				hasChildren: true
			},

			{
				href: `${path}/executions`,
				title: 'Executions',
				event: 'executions',
				hasChildren: true
			},
			{ href: `${path}/domains`, title: 'Domains', event: 'domains' },
			{
				href: `${path}/settings`,
				event: 'settings',
				title: 'Settings',
				disabled: !$.store_get($$store_subs ??= {}, '$canWriteFunctions', canWriteFunctions)
			}
		].filter((tab) => !tab.disabled);


		const projectsLimit = $.derived(() => limit ?? (Number(page.url.searchParams.get('limit')) || DEFAULT_BILLING_PROJECTS_LIMIT));
		const projectsOffset = $.derived(() => offset ?? ((Number(page.url.searchParams.get('page')) || 1) - 1) * projectsLimit());

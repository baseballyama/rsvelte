    .divider-wrapper.svelte-kjga07 {
        height: 18px;
    }
    footer.svelte-kjga07 {
        margin-block-start: auto;
        padding-block: 1rem;
        display: flex;
        flex-direction: column;
        gap: var(--gap-l);
        margin-inline: 2rem;

        &.hide {
            display: none;
        }

        & i {
            // because the `IconCloud` shows above floating action bars.
            position: unset;
        }
    }

    main:has(.sub-navigation) footer.svelte-kjga07 {
        @media (min-width: 1024px) {
            margin-inline-end: 2rem;
            margin-inline-start: -1.5rem;
        }
    }

    main:has(.wide-screen-wrapper) footer.svelte-kjga07 {
        margin-inline-start: 2rem !important;
    }


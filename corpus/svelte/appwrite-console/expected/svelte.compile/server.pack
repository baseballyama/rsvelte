											children: ($$renderer) => {
												if (Layout.Stack) {
													$$renderer.push('<!--[-->');

													Layout.Stack($$renderer, {
														direction: 'row',
														gap: 'xxs',
														children: ($$renderer) => {
															InputText($$renderer, { id: 'id', value: 'Row ID', readonly: true });
															$$renderer.push(`<!----> <span${$.attr_style('', { visibility: 'hidden' })}>`);

															Button($$renderer, {
																icon: true,
																extraCompact: true,
																children: ($$renderer) => {
																	Icon($$renderer, { icon: IconX });

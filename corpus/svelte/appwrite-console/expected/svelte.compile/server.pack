								if (supportsProjectRoles()) {
									$$renderer.push('<!--[0-->');

									if (Layout.Stack) {
										$$renderer.push('<!--[-->');

										Layout.Stack($$renderer, {
											direction: 'row',
											gap: 's',
											children: ($$renderer) => {
												InputRadio($$renderer, {
													id: 'edit-access-all',
													name: 'edit-access-type',
													label: 'All projects',
													value: 'all',
													get group() {
														return accessType;
													},

													set group($$value) {
														accessType = $$value;
														$$settled = false;
													}
												});

												$$renderer.push(`<!----> `);

												InputRadio($$renderer, {
													id: 'edit-access-specific',
													name: 'edit-access-type',
													label: 'Specific projects',
													value: 'specific',
													get group() {

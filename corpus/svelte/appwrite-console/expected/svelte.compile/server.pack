		const progressCard = { title: 'Get started', percentage: 33 };

		const navbarProps = {
			logo: {
				src: 'https://appwrite.io/images/logos/logo.svg',
				alt: 'Logo Appwrite'
			},
			avatar: undefined,
			organizations: []
		};


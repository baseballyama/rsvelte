        position: absolute;
        inset: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bgcolor-neutral-default, hsl(var(--p-body-bg-color)));
        opacity: 0.9;
        border-radius: var(--border-radius-s);
        pointer-events: none;

		let $$inner_renderer;

		function $$render_inner($$renderer) {
			CardGrid($$renderer, {
				children: ($$renderer) => {
					$$renderer.push(`<!---->The project will be permanently deleted, including all the metadata, resources and stats within it.
    This action is irreversible.`);

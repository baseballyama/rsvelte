		function formatHumanSize(bytes) {
			const size = humanFileSize(bytes || 0);

			return `${size.value} ${size.unit}`;
		}

		function formatBandwidthUsage(currentBytes, maxGB) {
			const currentSize = humanFileSize(currentBytes || 0);

			if (!maxGB) {

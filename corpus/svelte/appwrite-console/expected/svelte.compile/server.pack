			return allScopesList;
		});

		const categories = $.derived(() => {
			return Array.from(new Set(filteredScopes().map((scope) => normalizeCategory(scope.category))));
		});

		const scopeCatalog = $.derived(() => new Set(filteredScopes().map((s) => s.scope)));

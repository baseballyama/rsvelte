        a new one.</span>`);
					},

					footer: ($$renderer) => {
						{
							if (repositoryBehaviour === 'existing') {
								$$renderer.push('<!--[0-->');

								if (Layout.Stack) {
									$$renderer.push('<!--[-->');

									Layout.Stack($$renderer, {
										children: ($$renderer) => {
											Link($$renderer, {
												variant: 'quiet',
												href: connectGitHub(callbackState).toString(),
												children: ($$renderer) => {
													if (Layout.Stack) {

				? [
					{
						type: 'documentsdb',
						title: 'DocumentsDB',
						subtitle: 'Store flexible data without a fixed schema. Best for unstructured data and simple querying.'
					},

					{
						type: 'vectorsdb',
						title: 'VectorsDB',
						subtitle: 'Store data as vectors to find similar results. Best for semantic search and recommendations.'
					}
				]
				: []

			$$renderer.push('<!--[0-->');

			Button($$renderer, {
				href: `${base}/project-${page.params.region}-${page.params.project}/overview/api-keys/create`,
				children: ($$renderer) => {
					$$renderer.push(`<!---->Create API key`);
				},

				$$slots: {
					default: true,
					start: ($$renderer) => {
						Icon($$renderer, { icon: IconPlus, slot: 'start', size: 's' });
					}
				}
			});
		} else {
			$$renderer.push('<!--[-1-->');
		}

		$$renderer.push(`<!--]-->`);

		if ($$store_subs) $.unsubscribe_stores($$store_subs);
	});
}

    .auth-bg.svelte-dsikgi {
        position: fixed;
        background: var(--bgcolor-neutral-default, #fff);
        background-size: cover;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;

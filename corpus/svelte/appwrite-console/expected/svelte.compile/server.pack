export function badgeTypeDeployment(status) {
	switch (status) {
		case 'failed':
			return 'error';

		case 'ready':
			return 'success';

		case 'building':

		case 'finalizing':
			return 'warning';

		case 'processing':
			return undefined;

		default:
			return undefined;
	}
}


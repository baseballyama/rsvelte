    .drop-target.svelte-1tyzc {
        position: relative;
        min-height: 100%;
    }

    .drop-target.is-dragging.svelte-1tyzc {
        outline: 2px dashed var(--color-border-neutral-strong, hsl(var(--p-body-text-color)));
        outline-offset: -2px;
        border-radius: var(--border-radius-s);
    }


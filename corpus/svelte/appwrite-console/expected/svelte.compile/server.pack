											let table = each_array[$$index];

											if (Table.Row.Base) {
												$$renderer.push('<!--[-->');

												Table.Row.Base($$renderer, {
													root,
													children: ($$renderer) => {
														if (Table.Cell) {
															$$renderer.push('<!--[-->');

															Table.Cell($$renderer, {
																root,
																children: ($$renderer) => {
																	$$renderer.push(`<!---->${$.escape(table.name)}`);
																},

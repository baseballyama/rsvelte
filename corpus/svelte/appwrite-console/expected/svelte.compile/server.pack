												fullWidth: true,
												children: ($$renderer) => {
													if (loading) {
														$$renderer.push(`<!--[0-->Restoring...`);
													} else {
														$$renderer.push(`<!--[-1-->Restore project`);
													}

													$$renderer.push(`<!--]-->`);
												},
												$$slots: { default: true }
											});

											$$renderer.push(`<!----> `);

											Button($$renderer, {
												text: true,

												avatarList,
												() => {
													Skeleton($$renderer, { width: 40, height: 40, variant: 'circle' });
												},
												(avatars) => {
													AvatarGroup($$renderer, { avatars });
												}
											);

											$$renderer.push(`<!--]-->`);
										},

										$$slots: {
											default: true,

    .auth-methods-grid.svelte-1byz0st {
        display: grid;
        gap: var(--space-6) var(--space-8);
        grid-template-columns: repeat(3, minmax(0, 1fr));
        width: 100%;
    }

    .auth-method-item.svelte-1byz0st {
        min-width: 0;
    }

    .oauth-providers-header.svelte-1byz0st {
        align-items: center;
        display: flex;
        gap: var(--space-4);
        justify-content: space-between;
    }

    .oauth-providers-search.svelte-1byz0st {
        max-width: 20rem;
        width: 100%;

	var img = $.child(div_1);
	var img_1 = $.sibling(img, 2);

	$.reset(div_1);

	var div_2 = $.sibling(div_1, 2);
	var img_2 = $.child(div_2);
	var img_3 = $.sibling(img_2, 2);


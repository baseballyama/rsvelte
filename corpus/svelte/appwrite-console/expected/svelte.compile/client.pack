												var node_3 = $.first_child(fragment_4);

												$.component(node_3, () => Typography.Text, ($$anchor, Typography_Text) => {
													Typography_Text($$anchor, {
														variant: 'm-400',
														color: '--fgcolor-neutral-tertiary',
														children: ($$anchor, $$slotProps) => {
															$.next();


var root = $.from_html(`<!> <!> <!> <!> <!> <!>`, 1);
var root_1 = $.from_html(`<div class="wide-screen-wrapper databases-spreadsheet"><!></div>`);

export default function _page($$anchor, $$props) {
	$.push($$props, true);

	/* served from parent layout */

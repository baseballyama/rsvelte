		slotSpacing: true,
		databasesScreen: true,
		children: ($$anchor, $$slotProps) => {
			var fragment = root();
			var node_1 = $.first_child(fragment);

			UpdateStatus(node_1, {
				get entity() {
					return $.get(table);
				},
				onChangeStatus: (enabled) => updateTable({ enabled })

		},

		$$slots: {
			default: true,
			header: ($$anchor, $$slotProps) => {
				var fragment_5 = $.comment();
				var node_1 = $.first_child(fragment_5);

				$.component(node_1, () => Typography.Title, ($$anchor, Typography_Title) => {

					},

					children: ($$anchor, $$slotProps) => {
						$.next();

						var text = $.text('DNS records');

						$.append($$anchor, text);
					},
					$$slots: { default: true }
				});
			});

			$.append($$anchor, fragment_1);
		};

		$.if(node, ($$render) => {
			if ($.get(dnsData)) $$render(consequent);
		});
	}

	$.append($$anchor, fragment);
	$.pop();
}

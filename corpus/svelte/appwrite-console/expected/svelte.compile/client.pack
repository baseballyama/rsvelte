			await Promise.all([
				invalidate(Dependencies.ADDONS),
				invalidate(Dependencies.PROJECT)
			]);

			addNotification({
				message: 'Premium Geo DB addon will be removed at the end of your current billing cycle',
				type: 'success'
			});

			show(false);

    /* ---- Header ------------------------------------------------------------ */
    .header.svelte-1ltsqli {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 2rem 1.75rem 1.5rem;
        background: radial-gradient(
            120% 100% at 50% 0%,
            var(--bgcolor-neutral-secondary) 0%,
            transparent 70%
        );
    }

    .identity.svelte-1ltsqli {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .avatar.svelte-1ltsqli {
        width: 3.5rem;
        height: 3.5rem;
        border-radius: var(--border-radius-l, 0.85rem);
        flex-shrink: 0;
        border: 1px solid var(--border-neutral-strong);
        background: var(--bgcolor-neutral-primary);
    }

    /* Keep wordmarks readable inside the square avatar (cover crops them). */
    img.avatar.svelte-1ltsqli {
        object-fit: contain;
        padding: 0.4rem;
        box-sizing: border-box;
    }

    .avatar.placeholder.svelte-1ltsqli {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bgcolor-neutral-secondary);
        color: var(--fgcolor-neutral-secondary);
        font-size: 1.25rem;
        font-weight: 600;
    }

    .avatar.account.svelte-1ltsqli {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bgcolor-neutral-invert);
        color: var(--fgcolor-neutral-on-invert, var(--bgcolor-neutral-primary));
        font-size: 1.1rem;
        font-weight: 600;
    }

    .connector.svelte-1ltsqli {
        display: flex;
        align-items: center;
        margin-inline: 0.35rem;
    }

    .connector-line.svelte-1ltsqli {
        width: 1.1rem;
        height: 0;
        border-top: 2px dashed var(--border-neutral-strong);
    }

    .connector-node.svelte-1ltsqli {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 50%;
        border: 1px solid var(--border-neutral);
        background: var(--bgcolor-neutral-primary);
        color: var(--fgcolor-neutral-secondary);
    }

    .headline.svelte-1ltsqli {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        max-width: 22rem;
    }

    .account-chip.svelte-1ltsqli {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        max-width: 100%;
        padding: 0.3rem 0.85rem 0.3rem 0.35rem;
        border: 1px solid var(--border-neutral-strong);
        border-radius: 2rem;
        font-size: 0.8125rem;
        color: var(--fgcolor-neutral-secondary);
        background: var(--bgcolor-neutral-primary);
    }

    .account-chip.interactive.svelte-1ltsqli {
        padding-inline-end: 0.6rem;
        cursor: pointer;
        font: inherit;
        font-size: 0.8125rem;
        transition:
            background 0.15s ease,
            border-color 0.15s ease;
    }

    .account-chip.interactive.svelte-1ltsqli:hover:not(:disabled),
    .account-chip.interactive.open.svelte-1ltsqli {
        background: var(--overlay-neutral-hover, var(--bgcolor-neutral-secondary));
        border-color: var(--border-neutral-strong);
    }

    .account-chip.interactive.svelte-1ltsqli:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .account-menu.svelte-1ltsqli {
        position: relative;
        display: flex;
        justify-content: center;
        max-width: 100%;
    }

    .account-dropdown.svelte-1ltsqli {
        position: absolute;
        top: calc(100% + 0.4rem);
        z-index: 10;

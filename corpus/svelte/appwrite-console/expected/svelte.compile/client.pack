			}

			await sdk.forProject(project.region ?? 'default', projectId).project.get();

			const jwt = await sdk.forConsole.account.createJWT();

			window.location.href = `${origin}/_appwrite/authorize?jwt=${jwt.jwt}&path=${path}`;

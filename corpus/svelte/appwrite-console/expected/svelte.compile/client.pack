			$.template_effect(() => $.set_attribute(img_1, 'src', `${base ?? ''}/images/appwrite-logo-light.svg`));
			$.append($$anchor, img_1);
		};

		$.if(node_2, ($$render) => {
			if ($app().themeInUse === 'dark') $$render(consequent); else $$render(alternate, -1);

		$.set_attribute(img, 'src', ArtworkDarkMobile);
		$.set_attribute(img_1, 'src', ArtworkLightMobile);
		$.set_attribute(img_2, 'src', ArtworkDark);
		$.set_attribute(img_3, 'src', ArtworkLight);

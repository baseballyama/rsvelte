						$.template_effect(() => $.set_text(text_1, $template().id));
						$.append($$anchor, text_1);
					},
					$$slots: { default: true }
				});

				$.append($$anchor, fragment_1);
			}
		}
	});

	$.pop();
	$$cleanup();
}

                ValidTypes.String,
                ValidTypes.Varchar,
                ValidTypes.Text,
                ValidTypes.Mediumtext,
                ValidTypes.Longtext,
                ValidTypes.Integer,
                ValidTypes.Double,
                ValidTypes.Boolean,

    /**
     * Aggregated statistics of total number of databases.
     */
    databasesTotal: number;
    /**
     * Aggregated statistics of total number of users.
     */
    usersTotal: number;
    /**
     * Aggregated statistics of total occupied storage size (in bytes).
     */

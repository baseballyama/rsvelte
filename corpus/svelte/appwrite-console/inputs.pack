    const path = `${base}/project-${page.params.region}-${page.params.project}/auth`;
    const tabs = [
        {
            href: path,
            title: 'Users',
            hasChildren: true,
            event: 'users'
        },
        {
            href: `${path}/teams`,
            title: 'Teams',
            hasChildren: true,
            event: 'teams'
        },
        {
            href: `${path}/security`,
            title: 'Security',
            event: 'security',
            disabled: !$canWriteProjects
        },
        {
            href: `${path}/templates`,
            title: 'Templates',
            hasChildren: false,
            event: 'templates',
            disabled: !$canWriteProjects
        },
        {
            href: `${path}/settings`,
            title: 'Settings',
            event: 'settings',
            disabled: !$canWriteProjects
        }
    ].filter((tab) => !tab.disabled);
</script>


                        {project}
                        title="Policies"
                        buttonText="Create policy"
                        buttonType="secondary"
                        buttonDisabled />
                </div>

                <div style="width: 69%; padding-inline-start: 1.5rem;">
                    <ContainerHeader
                        {project}
                        title="Backups"
                        buttonText="Manual backup"
                        buttonType="secondary"
                        buttonDisabled />

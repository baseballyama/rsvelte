                <Badge
                    variant="secondary"
                    type={statusBadge.type}
                    size="xs"
                    content={statusBadge.content} />
            {:else if verified === true}
                <Badge variant="secondary" type="success" size="xs" content="Verified" />
            {/if}
        {/if}

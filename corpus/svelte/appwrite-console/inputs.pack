        <Layout.Stack gap="m" direction="row">
            <div style="width: 100%;max-width: 91.5%">
                <InputSelect id="copy" bind:value={url} {options}></InputSelect>
            </div>
            <Tooltip placement="bottom">
                <div>
                    <Button
                        secondary
                        icon
                        on:click={() => {
                            copy(url);
                            tooltipMessage = 'Copied';

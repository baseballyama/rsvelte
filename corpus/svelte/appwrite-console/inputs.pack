                                                                color="--fgcolor-neutral-secondary">
                                                                {usageParts[0]}
                                                            </Typography.Text>
                                                            <Typography.Text
                                                                variant="m-400"
                                                                color="--fgcolor-neutral-tertiary">
                                                                {' / '}
                                                            </Typography.Text>
                                                            <Typography.Text
                                                                variant="m-400"
                                                                color="--fgcolor-neutral-tertiary">
                                                                {usageParts[1]}

                <Button
                    on:click={async () => {
                        $randomDataModalState.show = false;
                        await $randomDataModalState.onSubmit?.();
                        resetSampleFieldsConfig();
                    }}>Create</Button>
            </Layout.Stack>
        </svelte:fragment>
    </Modal>
{/if}


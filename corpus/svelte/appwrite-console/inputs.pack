    let {
        href = null,
        collapsed = false,
        children,
        ...restProps
    }: {
        href?: string | null;
        collapsed?: boolean;
        children: Snippet;
    } & HTMLAttributes<HTMLDivElement> = $props();

    const buttonSize = $derived(collapsed ? 'xs' : 's');
    const currentLineHeight = $derived(collapsed ? '130%' : '140%');
    const currentLetterSpacing = $derived(collapsed ? '0' : '-0.144px');

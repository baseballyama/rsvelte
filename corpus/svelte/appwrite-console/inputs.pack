                >{'status' in page.error
                    ? page.error.status || 'Invalid Argument'
                    : 'Invalid Argument'}</Typography.Title>
            <Typography.Title>{page.error.message}</Typography.Title>
        </div>
        <div>
            <Button href={base}>Back to the console</Button>
        </div>
    </Container>
{/if}

<style>

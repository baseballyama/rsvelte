import { Query, type Models } from '@appwrite.io/console';
import { sdk } from '$lib/stores/sdk';
import { RuleTrigger, RuleType } from '$lib/stores/sdk';
import { Dependencies } from '$lib/constants.js';
import { isCloud } from '$lib/system';

export const load = async ({ depends, params, parent }) => {
    const { organization } = await parent();
    depends(Dependencies.DOMAINS);

    const [rules, domainsList] = await Promise.all([
        sdk.forProject(params.region, params.project).proxy.listRules({
            queries: [Query.equal('type', RuleType.API), Query.equal('trigger', RuleTrigger.MANUAL)]
        }),
        isCloud
            ? sdk.forConsole.domains.list({ queries: [Query.equal('teamId', organization.$id)] })
            : Promise.resolve<Models.DomainsList>({ total: 0, domains: [] })
    ]);

    return {
        rules,
        domainsList
    };
};


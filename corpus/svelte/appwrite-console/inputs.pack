                        {#if column.id === '$id'}
                            {#key column.id}
                                <Id value={subscriber.$id}>
                                    {subscriber.$id}
                                </Id>
                            {/key}
                        {:else if column.id === 'targetId'}
                            <Id value={subscriber[column.id]}>
                                {subscriber[column.id]}
                            </Id>
                        {:else if column.id === 'target'}

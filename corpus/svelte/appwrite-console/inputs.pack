                label="Bundle ID"
                bind:value={bundleIdentifier}
                required
                placeholder="com.company.appname" />
        </svelte:fragment>

        <svelte:fragment slot="actions">
            <Button
                disabled={bundleIdentifier === ($platform as Models.PlatformApple).bundleIdentifier}
                submit>Update</Button>
        </svelte:fragment>
    </CardGrid>
</Form>


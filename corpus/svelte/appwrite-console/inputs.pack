                                    Open the preview of your site on any mobile or tablet device.
                                </Typography.Text>
                            </Layout.Stack>
                        </Card.Button>
                    </Layout.Grid>
                </Layout.Stack>
            </Step.Item>
        </Step.List>
    </Layout.Stack>

    <svelte:fragment slot="footer">

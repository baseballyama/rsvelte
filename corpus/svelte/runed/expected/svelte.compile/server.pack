								$$settled = false;
							}
						});

						$$renderer.push(`<!----> `);

						Button($$renderer, {
							class: 'shrink-0',
							variant: 'brand',
							onclick: () => removeField(key),
							children: ($$renderer) => {
								$$renderer.push(`<!---->Remove`);
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----></div>`);
					}

					$$renderer.push(`<!--]--> <form class="flex items-center gap-3">`);

					Input($$renderer, {
						class: 'flex-1',
						placeholder: 'Key',
						get value() {
							return newField.key;
						},

						set value($$value) {
							newField.key = $$value;
							$$settled = false;
						}
					});

					$$renderer.push(`<!----> `);

					Input($$renderer, {

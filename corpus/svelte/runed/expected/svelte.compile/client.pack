			var b_1 = $.sibling($.child(p_1));
			var text_1 = $.only_child(b_1, true);

			$.reset(p_1);

			$.template_effect(() => {
				$.set_text(text, visible.current ? "true" : "false");
				$.set_text(text_1, $.get(becameVisibleCount));
			});

			$.append($$anchor, fragment_1);
		},
		$$slots: { default: true }
	});


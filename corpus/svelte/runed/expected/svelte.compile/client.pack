				$.set(isVisible, entry.isIntersecting, true);
			} else {
				$.set(isVisible, false);
			}
		},
		{ root: () => $.get(root) }
	);

	DemoContainer($$anchor, {
		class: 'flex flex-col gap-4 text-center',
		children: ($$anchor, $$slotProps) => {
			var fragment_1 = root_1();
			var div = $.first_child(fragment_1);
			var node = $.child(div);


					$.append($$anchor, text);
				},
				$$slots: { default: true }
			});

			var node_1 = $.sibling(node, 2);

			Input(node_1, {
				id: 'duration',
				type: 'number',
				get value() {
					return $.get(durationMs);
				},

				set value($$value) {
					$.set(durationMs, $$value, true);
				}
			});

			$.reset(div);

			var div_1 = $.sibling(div, 2);
			var node_2 = $.child(div_1);

			Button(node_2, {
				variant: 'brand',
				size: 'sm',
				onclick: ding,
				children: ($$anchor, $$slotProps) => {
					$.next();

					var text_1 = $.text('DING DING DING');

					$.append($$anchor, text_1);
				},
				$$slots: { default: true }
			});

			var node_3 = $.sibling(node_2, 2);

			{
				let $0 = $.derived(() => !logCount.pending);

				Button(node_3, {
					variant: 'ghost',
					size: 'sm',
					get onclick() {
						return logCount.runScheduledNow;
					},

					get disabled() {
						return $.get($0);
					},

					children: ($$anchor, $$slotProps) => {
						$.next();

						var text_2 = $.text('Run now');

						$.append($$anchor, text_2);
					},
					$$slots: { default: true }
				});
			}

			var node_4 = $.sibling(node_3, 2);

			{
				let $0 = $.derived(() => !logCount.pending);

				Button(node_4, {
					variant: 'ghost',
					size: 'sm',
					get onclick() {
						return logCount.cancel;
					},

					get disabled() {
						return $.get($0);
					},

					children: ($$anchor, $$slotProps) => {
						$.next();

						var text_3 = $.text('Cancel message');

						$.append($$anchor, text_3);
					},
					$$slots: { default: true }
				});
			}

			$.reset(div_1);

			var p = $.sibling(div_1, 2);
			var text_4 = $.only_child(p, true);

			$.template_effect(() => $.set_text(text_4, $.get(logged) || "Press the button!"));
			$.append($$anchor, fragment_1);
		},
		$$slots: { default: true }

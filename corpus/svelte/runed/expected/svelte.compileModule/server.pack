describe("FiniteStateMachine", () => {
	describe("simple toggle switch", () => {
		let f;
		const offEnterHandler = vi.fn();
		const offExitHandler = vi.fn();
		const onEnterHandler = vi.fn();
		const onExitHandler = vi.fn();

		beforeEach(() => {

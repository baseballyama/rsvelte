/* is-idle.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { extract } from "../extract/index.js";
import { useDebounce } from "../use-debounce/index.js";
import { useEventListener } from "$lib/utilities/use-event-listener/use-event-listener.svelte.js";
import { defaultWindow } from "$lib/internal/configurable-globals.js";

const DEFAULT_EVENTS = ["keypress", "mousemove", "touchmove", "click", "scroll"];

const DEFAULT_OPTIONS = {
	events: DEFAULT_EVENTS,
	initialState: false,
	timeout: 60000,
	trackLastActive: true
};

export class IsIdle {
	#current = false;
	#lastActive = Date.now();

	constructor(_options) {
		const opts = { ...DEFAULT_OPTIONS, ..._options };
		const window = opts.window ?? defaultWindow;
		const document = opts.document ?? window?.document;
		const timeout = $.derived(() => extract(opts.timeout));
		const events = $.derived(() => extract(opts.events));
		const detectVisibilityChanges = $.derived(() => extract(opts.detectVisibilityChanges));
		const trackLastActive = $.derived(() => extract(opts.trackLastActive));

		this.#current = opts.initialState;

		const debouncedReset = useDebounce(
			() => {
				this.#current = true;
			},
			() => timeout()
		);

		debouncedReset();

		const handleActivity = () => {
			this.#current = false;

			if (trackLastActive()) {
				this.#lastActive = Date.now();
			}

			debouncedReset();
		};

		useEventListener(
			() => window,
			() => events(),
			() => {
				handleActivity();
			},
			{ passive: true }
		);
	}

	get lastActive() {
		return this.#lastActive;
	}

	get current() {
		return this.#current;
	}
}

		timeout = undefined;
		promise = null;
		resolve = null;
		reject = null;
	}

	function throttled(...args) {
		return untrack(() => {
			const now = Date.now();
			const intervalValue = typeof interval === "function" ? interval() : interval;
			const nextAllowedTime = lastCall + intervalValue;

			if (!promise) {
				promise = new Promise((res, rej) => {
					resolve = res;
					reject = rej;
				});
			}


/* is-document-visible.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { defaultWindow } from "$lib/internal/configurable-globals.js";
import { on } from "svelte/events";

export class IsDocumentVisible {
	#visible = false;

	constructor(options = {}) {
		const window = options.window ?? defaultWindow;
		const document = options.document ?? window?.document;

		this.#visible = document ? !document.hidden : false;
	}

	get current() {
		return this.#visible;
	}
}

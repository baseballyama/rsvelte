vi.mock("$app/stores", () => {
    const getStores = () => {
        const navigating = readable(null);
        const page = readable({
            // @ts-expect-error - shh
            url: new URL("http://localhost"),
            params: {},
            route: {
                id: null,
            },
            status: 200,
            error: null,
            data: {},
            form: undefined,
            state: {},

=== 369 packages/runed/src/lib/utilities/extract/extract.svelte.ts	js
import { isFunction } from "$lib/internal/utils/is.js";
export function extract(value, defaultValue) {
    if (isFunction(value)) {
        const getter = value;
        const gotten = getter();
        if (gotten === undefined)
            return defaultValue;
        return gotten;
    }
    if (value === undefined)
        return defaultValue;
    return value;
}


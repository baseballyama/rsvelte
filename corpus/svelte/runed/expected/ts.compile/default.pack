import { useResizeObserver } from "$lib/utilities/use-resize-observer/index.js";
import { watch } from "$lib/utilities/watch/index.js";
import { tick } from "svelte";
import { extract } from "$lib/utilities/extract/index.js";
const stylesToCopy = [
    "box-sizing",
    "width",
    "padding-top",

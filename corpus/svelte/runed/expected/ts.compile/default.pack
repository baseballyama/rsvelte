=== 1228 sites/docs/src/lib/utils/docs.ts	js
import { docs } from "$content/index.js";
import { error } from "@sveltejs/kit";
export function getDocMetadata(slug = "index") {
    return docs.find((doc) => doc.slug === slug);
}
export function getAllDocs() {
    return docs;
}
function slugFromPath(path) {
    return path.replace("/src/content/", "").replace(".md", "");
}
export async function getDoc(slug = "index", fetch) {
    const modules = import.meta.glob("/src/content/**/*.md");
    let match = {};
    for (const [path, resolver] of Object.entries(modules)) {
        if (slugFromPath(path) === slug) {
            match = { path, resolver: resolver };
            break;
        }
    }
    const doc = await match?.resolver?.();
    const metadata = getDocMetadata(slug);
    if (!doc || !metadata) {
        error(404, "Could not find the document.");
    }
    let contributors = [];
    if (slug.includes("utilities/")) {
        const utility = slug.split("/").pop();
        if (utility) {
            const res = await fetch(`/api/contributors.json`);
            const data = await res.json();
            contributors = data[utility] ?? [];
        }
    }
    return {
        component: doc.default,
        metadata,
        contributors,
    };
}


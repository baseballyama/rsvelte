<script lang="ts">
  import RunedDark from "$lib/components/logos/runed-dark.svelte";
  import RunedLight from "$lib/components/logos/runed-light.svelte";
  import { DocsLayout } from "@svecodocs/kit";
  import { navigation } from "$lib/config/navigation";

  let { children } = $props();
</script>

<DocsLayout {navigation}>
  {#snippet logo()}
    <RunedDark class="hidden w-7 dark:block" />
    <RunedLight class="block w-7 dark:hidden" />
    <span class="sr-only">Svecodocs</span>
  {/snippet}

  {@render children?.()}
</DocsLayout>

=== 538 sites/docs/src/routes/(docs)/docs/+page.svelte	svelte
<script lang="ts">
  import { DocPage } from "@svecodocs/kit";
  let { data } = $props();

  const ogUrl = $derived(
    `https://runed.dev/og?title=${encodeURIComponent(data.metadata.title)}&description=${encodeURIComponent(data.metadata.description)}`,
  );
</script>

<svelte:head>
  <title>{data.metadata.title}</title>
  <meta name="description" content={data.metadata.description} />
</svelte:head>
<DocPage
  component={data.component}
  {...data.metadata}
  metadata={{ ogImage: { url: ogUrl, width: "1200", height: "630" } }}
/>


    <div class="flex items-center gap-3">
      <Button
        disabled={clickOutside.enabled}
        size="sm"
        onclick={clickOutside.start}>Start</Button
      >
      <Button
        disabled={!clickOutside.enabled}
        size="sm"
        onclick={clickOutside.stop}>Stop</Button
      >
      <Button

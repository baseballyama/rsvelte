<script lang="ts">
  import "../app.css";
  import { siteConfig } from "$lib/config/site";
  import { useSiteConfig } from "@svecodocs/kit";
  import { dev } from "$app/environment";

  let { children } = $props();

  useSiteConfig(() => siteConfig);
</script>

<svelte:head>

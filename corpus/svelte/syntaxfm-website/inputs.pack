import { UserSubmissionType } from '@prisma/client';
import { z } from 'zod';

export const user_submission_schema = z.object({
	submission_type: z.nativeEnum(UserSubmissionType),
	body: z.string().min(25).max(15000),
	name: z.optional(z.string().max(100)),
	email: z.optional(z.union([z.string().email().max(100), z.literal('')]))
});

=== 818 src/lib/forms/validateTurnstileToken.ts	ts	module	-
interface TokenValidateResponse {
	'error-codes': string[];
	success: boolean;
	action: string;
	cdata: string;
}

export async function validateToken(
	token: string | FormDataEntryValue | null | unknown,
	secret: string
) {
	if (!token || typeof token !== 'string') {
		return {
			success: false,
			error: 'Missing Captcha Token'
		};
	}
	const response = await fetch('https://challenges.cloudflare.com/turnstile/v0/siteverify', {
		method: 'POST',
		headers: {
			'content-type': 'application/json'
		},
		body: JSON.stringify({
			response: token,
			secret: secret
		})
	});

	const data: TokenValidateResponse = await response.json();

	return {
		// Return the status
		success: data.success,
		// Return the first error if it exists
		error: data['error-codes']?.length ? data['error-codes'][0] : null
	};
}


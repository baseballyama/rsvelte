			slide-in 1s ease-in-out 2 alternate;
		transform-origin: center center;
		text-align: center;
		z-index: -1;
	}

	/* Define the second animation */
	@keyframes slide-in {
		80% {
			translate: 35px;
		}
		100% {
			translate: 35px;
		}
	}

	@keyframes spin {
		to {
			rotate: 360deg;
		}
	}
</style>


	.logos {
		bottom: 10px;
		right: 10px;
		gap: 10px;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		width: 100px;
		svg {
			display: block;
			width: 100%;
			height: auto;
		}
	}
</style>


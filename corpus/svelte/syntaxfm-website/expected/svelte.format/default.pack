<div>
  <AdminSearch bind:text={search_text} />

  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Videos</th>
          <th>Published At</th>
          <th>Id</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        {#if filtered}
          {#each filtered as playlist}
            <tr>
              <td>
                {playlist.title}
              </td>
            </tr>
          {/each}
        {/if}
      </tbody>
    </table>
  </div>
</div>


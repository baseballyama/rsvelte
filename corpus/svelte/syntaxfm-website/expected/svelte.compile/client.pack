			$.set_class(div_2, 1, `box`, 'svelte-19zn03o');

			var text_1 = $.only_child(div_2);

			$.template_effect(
				($0) => {
					$.set_style(div_2, $0);
					$.set_text(text_1, `${$.get(color) ?? ''}-${index + 1}`);

		var text = $.only_child(p);

		$.template_effect(() => {
			styles = $.set_style(p, '', styles, { background: key() });
			$.set_text(text, `${val() ?? ''} ${key() ?? ''}`);
		});

		$.append($$anchor, p);
	});

	$.reset(div);
	$.append($$anchor, div);
	$.pop();
}

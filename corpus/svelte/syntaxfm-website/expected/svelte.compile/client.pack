	var option_2 = $.sibling(option_1);

	option_2.value = option_2.__value = 'OKLCH';

	var option_3 = $.sibling(option_2);

	option_3.value = option_3.__value = 'RGBA';
	$.reset(select);
	$.init_select(select);
	$.reset(label);

	var section = $.sibling(label, 2);

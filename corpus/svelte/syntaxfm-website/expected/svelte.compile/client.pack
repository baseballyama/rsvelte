var root = $.from_html(`<main><header class="center svelte-1l9dban"><h2 class="h6"> </h2> <p class="text-sm"> <br/> <a href="/snackpack">← Back to all issues</a></p></header> <div class="newsletter-output svelte-1l9dban"><div></div></div></main>`);


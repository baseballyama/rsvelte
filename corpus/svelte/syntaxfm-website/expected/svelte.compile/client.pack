			if (!swapper || !toSwap) return;

			node.setAttribute('src', toSwap);
		}

		// the node has been mounted in the DOM
		node.addEventListener('pointerenter', swap);

		node.addEventListener('pointerleave', swap);

		return {
			destroy() {

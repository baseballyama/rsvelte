				$$renderer.push(`<tr><td>${$.escape(transcript.show_number)}</td><td>${$.escape(transcript.show.title)}</td><td>${$.escape(transcript._count.utterances)}</td></tr>`);
			}

			$$renderer.push(`<!--]-->`);
		}

		$$renderer.push(`<!--]--></tbody></table></div>`);
	});
}

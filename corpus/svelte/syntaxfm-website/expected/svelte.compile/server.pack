import * as $ from 'svelte/internal/server';
import Transcript from '$lib/transcript/Transcript.svelte';

export default function _page($$renderer, $$props) {
	let { data } = $$props;

	let transcript = $.derived(() => data.transcript),
		show = $.derived(() => data.show);

	if (transcript()) {

			if (!playing_show_is_this_show()) return ''; // not playing this show

			if (currentTopic()?.id === summary.id) {
				return 'current';
			} else if (current_time > summaryEnd) {
				return 'past';
			} else {
				return 'future';
			}
		});

		if (aiShowNote) {
			$$renderer.push('<!--[0-->');
			TableOfContents($$renderer, { aiShowNote });

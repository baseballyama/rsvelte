=== 529 src/utilities/time_param_to_seconds.ts	js
export function time_param_to_seconds(time) {
    const parts = time.split(':').map(Number);
    let seconds = 0;
    // Depending on the number of parts, calculate the total seconds
    if (parts.length === 3) {
        // hh:mm:ss format
        seconds = parts[0] * 3600 + parts[1] * 60 + parts[2];
    }
    else if (parts.length === 2) {
        // mm:ss format
        seconds = parts[0] * 60 + parts[1];
    }
    else if (parts.length === 1) {
        // ss format
        seconds = parts[0];
    }
    return seconds;
}

=== 198 src/utilities/within_last_two_weeks.ts	js
export function is_within_last_two_weeks(provided_date) {
    const two_weeks_ago = new Date();
    two_weeks_ago.setDate(two_weeks_ago.getDate() - 14);
    return provided_date >= two_weeks_ago;
}


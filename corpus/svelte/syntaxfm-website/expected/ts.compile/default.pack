=== 752 src/lib/forms/validateTurnstileToken.ts	js
export async function validateToken(token, secret) {
    if (!token || typeof token !== 'string') {
        return {
            success: false,
            error: 'Missing Captcha Token'
        };
    }
    const response = await fetch('https://challenges.cloudflare.com/turnstile/v0/siteverify', {
        method: 'POST',
        headers: {
            'content-type': 'application/json'
        },
        body: JSON.stringify({
            response: token,
            secret: secret
        })
    });
    const data = await response.json();
    return {
        // Return the status
        success: data.success,
        // Return the first error if it exists
        error: data['error-codes']?.length ? data['error-codes'][0] : null
    };
}

=== 1514 src/lib/hotkeys/hotkeys.test.ts	js
import { describe, expect, it } from 'vitest';
import { formatShortcut } from './utils';
describe('Format shortcuts', () => {
    it('Simple hotkeys', () => {
        const trigger = {
            key: 'k',
            modifier: 'ctrl'
        };
        expect(formatShortcut(trigger)).toBe('ctrl+k');
    });
    it('Without modifier', () => {
        const trigger = {
            key: 'k'
        };
        expect(formatShortcut(trigger)).toBe('k');
    });
    it('Should replace space key', () => {
        const trigger = {
            key: ' ',
            modifier: 'ctrl'
        };
        expect(formatShortcut(trigger)).toBe('ctrl+Space');
    });
    it('Multiple modifiers', () => {
        const trigger = {
            key: 'k',
            modifier: ['ctrl', 'shift']
        };
        expect(formatShortcut(trigger)).toBe('ctrl+shift+k');
    });
    it('Multiple modifiers with arrays', () => {
        const trigger = {
            key: 'k',
            modifier: [
                ['ctrl', 'shift'],
                ['alt', 'shift']
            ]
        };
        expect(formatShortcut(trigger)).toBe('ctrl+shift or alt+shift+k');
    });
    it('Multiple shortcuts for the same action', () => {
        const shortcuts = [
            {
                key: 'k',
                modifier: 'ctrl'
            },
            {
                key: 'k',
                modifier: 'alt'
            }
        ];
        expect(formatShortcut(shortcuts)).toBe('ctrl+k or alt+k');
    });
});


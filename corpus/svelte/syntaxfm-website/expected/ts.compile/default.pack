function rando(under, lower) {
    const minimum = lower ?? 0;
    return Math.random() * (under - minimum) + minimum;
}
const grits = [
    'M1,2 C1.6,2 2,1.6 2,1 C2,0.4 1.6,0 1,0 C0.4,0 0,0.4 0,1 C0,1.6 0.4,2 1,2 Z',

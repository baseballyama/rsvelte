				type: "String",
				default: "Empty&nbsp;string"
			},

			{
				prop: "outlined",
				description: "Outlined variant",
				type: "Boolean",
				default: "false"
			},

			{
				prop: "hint",
				description: "Hint text appearing under the input",
				type: "String",
				default: "Empty&nbsp;string"
			},

			{
				prop: "error",

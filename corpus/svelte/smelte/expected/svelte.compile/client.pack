		}
	});

	var node_3 = $.sibling(node_2, 2);

	Checkbox(node_3, {
		label: 'Persistent',
		get checked() {
			$.mark_store_binding();

			return $persistent();
		},

		set checked($$value) {
			$.store_set(persistent, $$value);
		}
	});

	var node_4 = $.sibling(node_3, 2);

	Code(node_4, {
		get code() {
			return drawers;
		}
	});

	$.append($$anchor, fragment);
	$$cleanup();
}

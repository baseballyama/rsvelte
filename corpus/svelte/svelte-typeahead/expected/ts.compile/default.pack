import { flushSync } from "svelte";
/** Sets an input's value and fires a native `input` event, flushing Svelte's scheduler. */
export function typeInto(input, text) {
    flushSync(() => {
        input.value = text;
        input.dispatchEvent(new Event("input", { bubbles: true }));
    });
}
/** Fires a keydown event on an element, flushing Svelte's scheduler. */
export function pressKey(element, key) {
    flushSync(() => {
        element.dispatchEvent(new KeyboardEvent("keydown", { key, bubbles: true, cancelable: true }));
    });
}

=== 673 tests/unit/render.ts	js
import { flushSync, mount, unmount, } from "svelte";
/** Mounts a component into a detached container and returns a matching cleanup function. */
export function render(ComponentToRender, props) {
    const target = document.createElement("div");
    document.body.appendChild(target);
    // `mount`'s options type is conditional on whether Props allows no props,
    // which TS can't resolve through a generic — cast to sidestep it.
    const instance = flushSync(() => mount(ComponentToRender, { target, props }));
    return {
        target,
        instance,
        cleanup: () => {
            unmount(instance);
            target.remove();
        },
    };
}


export type MonitorTag = string;

export type MonitorStatus = "UP" | "DOWN" | "DEGRADED" | "MAINTENANCE" | "NO_DATA";

export const MONITOR_TYPES = [
  "API",
  "PING",
  "TCP",
  "DNS",
  "NONE",
  "GROUP",
  "SSL",
  "SQL",
  "HEARTBEAT",
  "GAMEDIG",
  "GRPC",
] as const;

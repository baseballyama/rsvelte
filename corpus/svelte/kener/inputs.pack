                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                    >
                      <tbody style="width: 100%">
                        <tr style="width: 100%">
                          <td data-id="__react-email-column" style="text-align: center">
                            <img
                              alt="{{site_name}}"
                              src="{{site_logo_url}}"
                              style="
                                height: auto;
                                display: block;
                                outline: none;
                                border: none;
                                text-decoration: none;
                                margin-left: auto;

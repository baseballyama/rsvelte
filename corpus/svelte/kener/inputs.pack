  async hasTriggeredAlertForConfig(configId: number): Promise<boolean> {
    const result = await this.knex("monitor_alerts_v2")
      .count("* as count")
      .where({ config_id: configId, alert_status: "TRIGGERED" })
      .first<CountResult>();
    return Number(result?.count) > 0;
  }


                      alt="{{site_name}}"
                      height="40"
                      src="{{site_logo_url}}"
                      style="
                        margin-left: auto;
                        margin-right: auto;
                        display: block;
                        outline: none;
                        border: none;
                        text-decoration: none;
                      "
                      width="120"
                    />
                  </td>

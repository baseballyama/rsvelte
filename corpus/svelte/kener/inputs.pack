                class="rounded-btn"
                onclick={() => handleBadgeCopy("latency_min")}
              >
                <Copy />
              </CopyButton>
            </div>
          {/if}
        </div>
      </div>

      <!-- Live Status Section -->
      <div>
        <h3 class="mb-2 text-sm font-semibold">{$t("Live Status")}</h3>

        <div class="flex flex-row gap-2">
          {#if badgeDotUrl}
            <div class="flex items-center gap-2 rounded-3xl border px-2 py-1">

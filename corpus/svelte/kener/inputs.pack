      </Card.Content>
      <Card.Footer class="flex justify-end">
        <Button onclick={saveEventDisplaySettings} disabled={savingEventDisplaySettings} class="cursor-pointer">
          {#if savingEventDisplaySettings}
            <Loader class="h-4 w-4 animate-spin" />
            Saving...

   */
  async getMonitorAlertConfigs(filter: MonitorAlertConfigFilter): Promise<MonitorAlertConfigRecord[]> {
    let query = this.knex("monitor_alerts_config as mac").select("mac.*").whereRaw("1=1");

    if (filter.id !== undefined) {

					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						tag: monitorTag,
						startOfDayTodayAtTz: selectedDay.timestamp,
						nowAtTz: Math.min(selectedDay.timestamp + 86400 - 60, page.data.nowAtTz)

							$$renderer.push('<!--[-->');

							Item.Actions($$renderer, {
								children: ($$renderer) => {
									ChevronRight($$renderer, { class: 'size-4' });
								},
								$$slots: { default: true }
							});

							$$renderer.push('<!--]-->');
						} else {
							$$renderer.push('<!--[!-->');
							$$renderer.push('<!--]-->');
						}

						$$renderer.push(`</a>`);
					}

					if (Item.Root) {
						$$renderer.push('<!--[-->');

						Item.Root($$renderer, {
							variant: 'outline',
							class: 'rounded-3xl',
							child,

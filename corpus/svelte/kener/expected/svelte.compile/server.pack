			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

			if (reduceMotion.matches) return; // static seeded bar, no live march

			let timer;

			const tick = () => {
				clock += 1;

				const phase = clock % CYCLE;

				if (!result.error) {
					triggers = result.map((t) => ({ ...t, testLoaders: "idle" }));
					totalCount = triggers.length;
					totalPages = Math.ceil(totalCount / limit);
				}
			} catch(error) {
				console.error("Error fetching triggers:", error);
				toast.error("Failed to load triggers");

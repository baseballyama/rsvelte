					} catch {
						existingSettings = {};
					}
				}

				const mergedSettings = {
					...existingSettings,
					monitor_status_history_days: {
						desktop: statusHistoryDays.desktop,
						mobile: statusHistoryDays.mobile
					}
				};

				const payload = {
					...monitor,
					type_data: JSON.stringify(typeData),
					monitor_settings_json: JSON.stringify(mergedSettings)

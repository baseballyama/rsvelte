    letter-spacing: 0.05em;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  .rail-meta-dot.svelte-1ppbv43 {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 9999px;
    background: var(--demo-up);
  }

  @media (max-width: 560px) {
    .rail-title.svelte-1ppbv43 {
      white-space: normal;
    }
    .rail-rule.svelte-1ppbv43 {
      display: none;
    }
    .rail.svelte-1ppbv43 {
      justify-content: space-between;
    }
  }

  /* ===== Monitor rows ===== */
  .rows.svelte-1ppbv43 {
    border-top: 1px solid color-mix(in oklch, var(--foreground) 9%, transparent);
  }

  .row.svelte-1ppbv43 {
    display: grid;
    grid-template-columns: auto 1fr auto;
    column-gap: 0.875rem;
    row-gap: 0.25rem;
    align-items: baseline;
    padding: 1rem 0.625rem;
    border-bottom: 1px solid color-mix(in oklch, var(--foreground) 7%, transparent);
    text-decoration: none;
    transition: background 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }

  a.row.svelte-1ppbv43:hover {
    background: color-mix(in oklch, var(--foreground) 2.5%, transparent);
  }

  .row-dot.svelte-1ppbv43 {

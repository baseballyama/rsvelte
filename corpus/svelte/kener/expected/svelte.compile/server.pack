				}
			} else {
				hoveredBar = null;

				if (hoveredIndex !== null) {
					hoveredIndex = null;
					drawBars(null);
				}
			}
		}

		function handleMouseLeave() {
			hoveredBar = null;

			if (hoveredIndex !== null) {

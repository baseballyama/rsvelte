									mobile: settings.monitor_status_history_days.mobile ?? GC.DEFAULT_STATUS_HISTORY_DAYS_MOBILE
								};
							}
						} catch(e) {
							console.error("Failed to parse monitor_settings_json:", e);
						}
					}
				} else {
					error = "Monitor not found";

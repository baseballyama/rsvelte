													if (testing === "loading") {
														$$renderer.push('<!--[0-->');
														Loader($$renderer, { class: 'size-4 animate-spin' });
													} else if (testing === "success") {
														$$renderer.push('<!--[1-->');
														CheckIcon($$renderer, { class: 'size-4 text-green-500' });
													} else if (testing === "error") {

					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						action: "getMonitoringDataPaginated",
						data: { page: 1, limit: 10, monitor_tag }
					})
				});

				const result = await response.json();

				if (!result.error) {

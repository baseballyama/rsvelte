							} else {
								$$renderer.push('<!--[!-->');
								$$renderer.push('<!--]-->');
							}

							$$renderer.push(` `);

							if (Card.Footer) {
								$$renderer.push('<!--[-->');

								Card.Footer($$renderer, {
									class: 'flex justify-end gap-2',
									children: ($$renderer) => {
										if (!isNew()) {
											$$renderer.push('<!--[0-->');

											Button($$renderer, {
												variant: 'outline',
												onclick: testTrigger,
												disabled: testing === "loading",

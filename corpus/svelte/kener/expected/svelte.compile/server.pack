							Card.Content($$renderer, {
								class: 'space-y-4',
								children: ($$renderer) => {
									$$renderer.push(`<div class="grid grid-cols-2 gap-4"><div class="space-y-2">`);

									Label($$renderer, {
										for: 'monitor-history-desktop',
										children: ($$renderer) => {

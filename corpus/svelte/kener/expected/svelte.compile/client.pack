				if (result.error) {
					toast.error(result.error);
				} else {
					toast.success("Maintenance updated successfully");
				}
			}
		} catch(e) {
			toast.error(e instanceof Error ? e.message : "Failed to save");
		} finally {
			$.set(saving, false);
		}
	}

	// Delete maintenance
	async function deleteMaintenance() {

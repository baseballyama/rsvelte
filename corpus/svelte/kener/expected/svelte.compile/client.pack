    font-weight: 500;
    padding-left: 0.625rem;
  }

  .cmp-table.svelte-1ppbv43 th.cmp-feature:where(.svelte-1ppbv43) {
    color: var(--foreground);
  }

  .cmp-table.svelte-1ppbv43 .cmp-kener:where(.svelte-1ppbv43) {
    color: var(--primary);
    font-weight: 600;

									class: 'text-base font-medium',
									children: ($$anchor, $$slotProps) => {
										$.next();

										var text = $.text();

										$.template_effect(() => $.set_text(text, $.get(dayOptions)[$.get(selectedDayIndex)].text));
										$.append($$anchor, text);
									},
									$$slots: { default: true }
								});

		$.set(selectedMonitors, $.get(selectedMonitors).map((m) => m.tag === tag ? { ...m, status } : m), true);
	}

	// Get monitor name by tag
	function getMonitorName(tag) {
		const monitor = $.get(availableMonitors).find((m) => m.tag === tag);

		return monitor?.name || tag;
	}


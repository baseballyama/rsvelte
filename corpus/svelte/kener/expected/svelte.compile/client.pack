  }

  .cmp-table.svelte-1ppbv43 th.cmp-kener:where(.svelte-1ppbv43) {
    color: var(--primary);
  }

  .cmp-table.svelte-1ppbv43 tbody:where(.svelte-1ppbv43) tr:where(.svelte-1ppbv43):last-child td:where(.svelte-1ppbv43) {
    border-bottom: none;

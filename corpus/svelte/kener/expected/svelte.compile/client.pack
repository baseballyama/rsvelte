			$.set(loadingPages, false);
		}
	}

	async function savePageOrdering() {
		$.set(savingPageOrdering, true);

		try {
			const payload = {
				enabled: $.get(pageOrderingEnabled),
				order: $.get(displayPages).map((p) => p.id)

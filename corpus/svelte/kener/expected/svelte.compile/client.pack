				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					action: "getMaintenanceEvents",
					data: { maintenance_id: parseInt($$props.params.id) }
				})
			});

			const result = await response.json();

			if (!result.error) {
				$.set(events, result, true);

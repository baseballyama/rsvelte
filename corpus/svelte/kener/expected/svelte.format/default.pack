        </Tooltip.Content>
      </Tooltip.Root>
    </div>
    <div class="flex items-center space-x-2">
      <Tooltip.Root>
        <Tooltip.Trigger class="flex items-center space-x-2">
          <Switch id="gamedig-rules" bind:checked={data.requestRules} />

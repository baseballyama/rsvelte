                <Loader class="h-4 w-4 animate-spin" />
                Deleting...
              {:else}
                <TrashIcon class="h-4 w-4" />
                Delete Page
              {/if}
            </Button>
          </Card.Footer>
        </Card.Root>
      {/if}
    {/if}
  {/if}
</div>


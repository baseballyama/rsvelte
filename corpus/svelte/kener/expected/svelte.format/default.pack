        bind:value={data.timeout}
        placeholder="10000"
      />
    </div>
  </div>

  <div class="flex gap-6">
    <div class="flex items-center space-x-2">
      <Tooltip.Root>
        <Tooltip.Trigger class="flex items-center space-x-2">
          <Switch id="gamedig-guessport" bind:checked={data.guessPort} />

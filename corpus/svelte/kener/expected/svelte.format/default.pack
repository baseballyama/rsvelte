  async function saveNavigation() {
    savingNav = true;
    try {
      const cleanNav = nav.map((item) => ({
        name: item.name,
        url: item.url,
        iconURL: item.iconURL,
      }));
      const response = await fetch(clientResolver(resolve, "/manage/api"), {
        method: "POST",

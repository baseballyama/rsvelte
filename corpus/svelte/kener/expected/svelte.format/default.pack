                  {form.monitor_tags.length} monitors selected
                {/if}
                <ChevronsUpDownIcon
                  class="text-muted-foreground size-4 shrink-0"
                />
              </Button>
            </Popover.Trigger>
            <Popover.Content
              class="w-[var(--bits-popover-trigger-width)] p-0"
              align="start"
            >
              <Command.Root>
                <Command.Input placeholder="Search monitors..." />
                <Command.List>
                  <Command.Empty>No monitors found.</Command.Empty>
                  <Command.Group>
                    {#each monitors as monitor (monitor.tag)}
                      <Command.Item
                        value={monitor.name}

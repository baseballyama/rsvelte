                            : 'opacity-0'}"
                        />
                        {monitor.name}
                      </Command.Item>
                    {/each}
                  </Command.Group>
                </Command.List>
              </Command.Root>
            </Popover.Content>
          </Popover.Root>
          {#if form.monitor_tags.length > 0}
            <div class="flex flex-wrap gap-1.5">

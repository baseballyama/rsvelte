        expect(isMonitoringStatus("UP")).toBe(true);
        expect(isMonitoringStatus("DOWN")).toBe(true);
        expect(isMonitoringStatus("DEGRADED")).toBe(true);
        expect(isMonitoringStatus("MAINTENANCE")).toBe(false);

            .select(this.knex.raw("CASE WHEN COUNT(*) <= SUM(CASE WHEN latency < ? THEN 1 ELSE 0 END) THEN 1 ELSE 0 END as is_recovered", [latencyThreshold]))
            .from("last_records")

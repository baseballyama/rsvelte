            updateData.alert_for = data.alert_for;
        if (data.alert_value !== undefined)
            updateData.alert_value = data.alert_value;
        if (data.failure_threshold !== undefined)
            updateData.failure_threshold = data.failure_threshold;
        if (data.success_threshold !== undefined)
            updateData.success_threshold = data.success_threshold;
        if (data.alert_description !== undefined)
            updateData.alert_description = data.alert_description;
        if (data.create_incident !== undefined)
            updateData.create_incident = data.create_incident;
        if (data.is_active !== undefined)
            updateData.is_active = data.is_active;

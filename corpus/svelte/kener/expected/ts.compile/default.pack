    if (!alert) {
        throw new Error(`Monitor alert with id '${id}' not found`);
    }
    await db.updateMonitorAlertV2Status(id, alertStatus);
    const updatedAlert = await db.getMonitorAlertV2ById(id);
    if (!updatedAlert) {

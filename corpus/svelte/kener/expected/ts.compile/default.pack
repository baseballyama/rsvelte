        id: comment.id,
        incident_id: comment.incident_id,
        comment: comment.comment,
        timestamp: comment.commented_at,
        state: comment.state,
        created_at: formatDateToISO(comment.created_at),
        updated_at: formatDateToISO(comment.updated_at),
    };
}

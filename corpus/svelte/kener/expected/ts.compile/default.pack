    const { action } = params;
    const handler = getHandler(action, "put");
    if (!handler) {
        return error(404, { message: `Handler not found for PUT /${action}` });
    }
    const apiRequest = {
        action,
        query: url.searchParams,
        cookies,
        headers: request.headers,
        body: await request.json(),
    };
    return handler(apiRequest);
};

// Badge styles supported by badge-maker
export const BADGE_STYLES = ["flat", "plastic", "flat-square", "for-the-badge", "social"];
// Status types
export const MONITORING_STATUSES = ["UP", "DOWN", "DEGRADED"];
export function isMonitoringStatus(value) {
    return typeof value === "string" && MONITORING_STATUSES.includes(value);
}
// Page status messages for overall system status
export const PAGE_STATUS_MESSAGES = {
    UNDER_MAINTENANCE: "Under Maintenance",
    ALL_OPERATIONAL: "All Systems Operational",

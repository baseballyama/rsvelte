var root = $.from_html(`<div class="flex -space-x-1.5"><enhanced:img class="ring-background size-5 rounded-full ring-1" alt="Avatar 01" loading="lazy" decoding="async"></enhanced:img> <enhanced:img class="ring-background size-5 rounded-full ring-1" alt="Avatar 02" loading="lazy" decoding="async"></enhanced:img> <enhanced:img class="ring-background size-5 rounded-full ring-1" alt="Avatar 03" loading="lazy" decoding="async"></enhanced:img> <enhanced:img class="ring-background size-5 rounded-full ring-1" alt="Avatar 04" loading="lazy" decoding="async"></enhanced:img></div>`);


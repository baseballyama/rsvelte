		});
	}

	var div_2 = $.sibling(node, 2);
	var node_1 = $.child(div_2);

	SearchIcon(node_1, { size: 16 });
	$.reset(div_2);
	$.reset(div_1);

	var div_3 = $.sibling(div_1, 2);
	var div_4 = $.child(div_3);
	var node_2 = $.child(div_4);

	Label(node_2, {
		get for() {

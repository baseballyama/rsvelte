		{ date: 'Apr 19, 2024', id: 4, title: 'Testing & Deployment' },
		{ date: 'May 3, 2024', id: 5, title: 'User Training' },
		{ date: 'May 17, 2024', id: 6, title: 'Project Handover' }
	];

	Timeline($$anchor, {
		defaultValue: 3,

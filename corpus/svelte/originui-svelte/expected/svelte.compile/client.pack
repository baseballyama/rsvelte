							var node_3 = $.child(div_1);

							Clock(node_3, { size: 16, 'aria-hidden': 'true' });
							$.reset(div_1);

							var text_1 = $.sibling(div_1);

							$.template_effect(() => $.set_text(text_1, ` ${$.get(selected)?.label ?? 'Select a time' ?? ''}`));
							$.append($$anchor, fragment_1);

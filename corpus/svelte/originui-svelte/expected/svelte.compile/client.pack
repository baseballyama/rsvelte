	$.user_effect(() => {
		if (!$.get(inputElement)) return;

		const im = new Inputmask('99:99:99', { placeholder: '-', showMaskOnHover: false }).mask($.get(inputElement));

		return () => im.remove();
	});

	var div = root();
	var node = $.child(div);

	Label(node, {
		get for() {
			return uid;
		},

		children: ($$anchor, $$slotProps) => {
			$.next();

			var text = $.text('Timestamp');

			$.append($$anchor, text);
		},
		$$slots: { default: true }
	});

	var node_1 = $.sibling(node, 2);

	Input(node_1, {
		get id() {
			return uid;
		},
		placeholder: '00:00:00',
		type: 'text',
		get ref() {
			return $.get(inputElement);
		},

		set ref($$value) {
			$.set(inputElement, $$value, true);
		}
	});

	$.next(2);
	$.reset(div);
	$.append($$anchor, div);
	$.pop();
}

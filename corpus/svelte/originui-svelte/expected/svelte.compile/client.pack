		'aria-label': 'Open layout menu',
		children: ($$anchor, $$slotProps) => {
			LayoutGridIcon($$anchor, { size: 16, 'aria-hidden': 'true' });
		},
		$$slots: { default: true }
	});

	var node_5 = $.sibling(node_4, 2);

	InfoMenu(node_5, {});

	var node_6 = $.sibling(node_5, 2);


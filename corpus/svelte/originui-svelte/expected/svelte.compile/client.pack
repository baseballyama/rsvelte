			id: 4,
			image: Avatar05,
			title: 'Alex Morgan'
		}
	];

	Timeline($$anchor, {
		children: ($$anchor, $$slotProps) => {
			var fragment_1 = $.comment();
			var node = $.first_child(fragment_1);


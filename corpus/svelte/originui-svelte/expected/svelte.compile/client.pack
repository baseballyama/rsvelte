} from '$lib/components/ui/timeline';

var root = $.from_html(`<!> <!> <!> <!>`, 1);

export default function Timeline_08($$anchor) {
	const items = [
		{ date: 'Mar 15, 2024', id: 1, title: 'Project Kickoff' },
		{ date: 'Mar 22, 2024', id: 2, title: 'Design Phase' },

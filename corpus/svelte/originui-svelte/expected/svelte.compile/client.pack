	var node_7 = $.sibling(node_6, 2);

	SettingsMenu(node_7, {});
	$.reset(div_5);

	var node_8 = $.sibling(div_5, 2);

	Button(node_8, {
		class: 'size-8 rounded-full',
		size: 'icon',
		'aria-label': 'Add new item',
		children: ($$anchor, $$slotProps) => {
			PlusIcon($$anchor, { size: 16, 'aria-hidden': 'true' });
		},
		$$slots: { default: true }
	});


		'aria-label': 'Rate your experience',
		get value() {
			return $.get(value);
		},

		set value($$value) {
			$.set(value, $$value, true);
		}
	});

	var span = $.sibling(node_1, 2);
	var text_1 = $.only_child(span, true);

	$.reset(div_1);
	$.reset(div);
	$.template_effect(() => $.set_text(text_1, emojis[$.get(value) - 1]));
	$.append($$anchor, div);
}

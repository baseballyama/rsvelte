						const name = getName();

						return { render: () => `<div class="font-medium">${name}</div>` };
					});

					return renderSnippet(nameSnippet, row.getValue('name'));
				},
				header: 'Name'
			},
			{ accessorKey: 'email', header: 'Email' },
			{
				accessorKey: 'location',
				cell: ({ row }) => {

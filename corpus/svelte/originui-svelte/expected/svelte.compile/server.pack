														TooltipTrigger($$renderer, { child, $$slots: { child: true } });
													}

													$$renderer.push(`<!----> `);

													TooltipContent($$renderer, {
														class: 'px-2 py-1 text-xs',
														children: ($$renderer) => {
															$$renderer.push(`<!---->Copy to clipboard`);
														},
														$$slots: { default: true }
													});

													$$renderer.push(`<!---->`);
												},
												$$slots: { default: true }
											});
										},
										$$slots: { default: true }
									});

									$$renderer.push(`<!----></div></div>`);
								},
								$$slots: { default: true }

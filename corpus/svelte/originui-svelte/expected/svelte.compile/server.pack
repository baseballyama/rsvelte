export default function Slider_26($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let value = [200, 780];
		const itemsInRange = $.derived(() => items.filter((item) => item.price >= value[0] && item.price <= value[1]).length);
		const tickCount = 40;
		const min = Math.min(...items.map((item) => item.price));
		const max = Math.max(...items.map((item) => item.price));
		const priceStep = (max - min) / tickCount;

		const itemCounts = Array.from({ length: tickCount }, (_, tick) => {
			const rangeMin = min + tick * priceStep;
			const rangeMax = min + (tick + 1) * priceStep;

			return items.filter((item) => item.price >= rangeMin && item.price < rangeMax).length;
		});

		const maxCount = Math.max(...itemCounts);

		function isBarInSelectedRange(index) {
			const rangeMin = min + index * priceStep;
			const rangeMax = min + (index + 1) * priceStep;

			return itemsInRange() > 0 && rangeMin <= value[1] && rangeMax >= value[0];
		}

		function handleInputChange(e, index) {
			const v = parseFloat(e.currentTarget.value) || 0;

			if (index == 0 && v > value[1]) value = [value[1], value[1]]; else if (index == 1 && v < value[0]) value = [value[0], value[0]]; else value[index] = v;
		}

		let $$settled = true;
		let $$inner_renderer;

		function $$render_inner($$renderer) {
			$$renderer.push(`<div class="*:not-first:mt-4">`);

			Label($$renderer, {
				children: ($$renderer) => {
					$$renderer.push(`<!---->Price slider`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> <div><div class="flex h-12 w-full items-end px-3" aria-hidden="true"><!--[-->`);

			const each_array = $.ensure_array_like(itemCounts);

			for (let i = 0, $$length = each_array.length; i < $$length; i++) {
				let count = each_array[i];

				$$renderer.push(`<div class="flex flex-1 justify-center"${$.attr_style(`height: ${$.stringify(count / maxCount * 100)}%`)}><span${$.attr('data-selected', isBarInSelectedRange(i))} class="bg-primary/20 h-full w-full"></span></div>`);
			}

			$$renderer.push(`<!--]--></div> `);

			Slider($$renderer, {
				min,
				max,
				'aria-label': 'Price range',
				type: 'multiple',
				get value() {
					return value;
				},

				set value($$value) {
					value = $$value;
					$$settled = false;
				}
			});

			$$renderer.push(`<!----></div> <div class="flex items-center justify-between gap-4"><div class="space-y-1">`);

			Label($$renderer, {
				for: 'min-price',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Min price`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> <div class="relative">`);

			Input($$renderer, {
				class: 'peer w-full ps-6',
				type: 'text',
				inputmode: 'decimal',
				onchange: (e) => handleInputChange(e, 0),
				min,
				max: value[1],
				value: value[0],
				'aria-label': 'Enter minimum price'
			});

			$$renderer.push(`<!----> <span class="text-muted-foreground pointer-events-none absolute inset-y-0 start-0 flex items-center justify-center ps-3 text-sm peer-disabled:opacity-50">$</span></div></div> <div class="space-y-1">`);

			Label($$renderer, {
				for: 'max-price',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Max price`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----> <div class="relative">`);

			Input($$renderer, {
				class: 'peer w-full ps-6',
				type: 'text',
				inputmode: 'decimal',
				onchange: (e) => handleInputChange(e, 1),
				min: value[0],
				max,
				value: value[1],
				'aria-label': 'Enter maximum price'
			});

			$$renderer.push(`<!----> <span class="text-muted-foreground pointer-events-none absolute inset-y-0 start-0 flex items-center justify-center ps-3 text-sm peer-disabled:opacity-50">$</span></div></div></div> `);

			Button($$renderer, {
				class: 'w-full',
				variant: 'outline',
				children: ($$renderer) => {
					$$renderer.push(`<!---->Show ${$.escape(itemsInRange())} items`);
				},
				$$slots: { default: true }
			});

			$$renderer.push(`<!----></div>`);
		}

		do {
			$$settled = true;
			$$inner_renderer = $$renderer.copy();
			$$render_inner($$inner_renderer);
		} while (!$$settled);

		$$renderer.subsume($$inner_renderer);
	});
}

	$$renderer.push(`<!----> `);

	TooltipProvider($$renderer, {
		delayDuration: 0,
		children: ($$renderer) => {
			Tooltip($$renderer, {
				children: ($$renderer) => {
					{
						function child($$renderer, { props }) {
							Button($$renderer, $.spread_props([
								{
									class: 'col-start-1',
									variant: 'outline',
									size: 'icon',

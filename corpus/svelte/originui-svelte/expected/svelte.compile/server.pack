											$$renderer.push('<!--[-->');

											Dialog.Content($$renderer, {
												class: 'block h-auto max-h-[calc(80svh)] max-w-[calc(100svw-5rem)] overflow-y-auto sm:max-w-2xl',
												children: ($$renderer) => {
													Content($$renderer, {
														component: componentDialogCtx.component,
														onGotoComponent: () => {
															open(false);

export class ImageUpload {
    #previewUrl = $state(null);
    #fileName = $state(null);
    #fileInput = $state(null);
    #files = $state(null);
    #onUpload;
    constructor(options = {}) {
        this.#onUpload = options.onUpload;
        if (options.initialImage) {
            this.#previewUrl = options.initialImage;
        }
    }
    get previewUrl() {
        return this.#previewUrl;
    }
    get fileName() {
        return this.#fileName;
    }
    get fileInput() {
        return this.#fileInput;
    }
    set fileInput(input) {
        this.#fileInput = input;
    }
    get files() {
        return this.#files;
    }
    set files(files) {
        this.#files = files;
        const file = files?.[0];
        if (file) {
            this.#fileName = file.name;
            const url = URL.createObjectURL(file);
            if (this.#previewUrl) {
                URL.revokeObjectURL(this.#previewUrl);
            }
            this.#previewUrl = url;
            this.#onUpload?.(url);
        }
    }

        this.#fileInput?.click();
    };
    handleRemove = () => {
        if (this.#previewUrl) {
            URL.revokeObjectURL(this.#previewUrl);
        }
        this.#previewUrl = null;
        this.#fileName = null;
        if (this.#fileInput) {
            this.#fileInput.value = '';

import * as $ from 'svelte/internal/server';

export class Pagination {
	currentPage = 1;
	totalPages = 1;
	#itemsCount = 5;
	#showLeftEllipsis = $.derived(() => this.currentPage > Math.ceil(this.#itemsCount / 2));

	get showLeftEllipsis() {
		return this.#showLeftEllipsis();
	}

	set showLeftEllipsis($$value) {
		return this.#showLeftEllipsis($$value);
	}

	#showRightEllipsis = $.derived(() => this.totalPages - this.currentPage >= Math.ceil(this.#itemsCount / 2));

	get showRightEllipsis() {
		return this.#showRightEllipsis();
	}

	set showRightEllipsis($$value) {
		return this.#showRightEllipsis($$value);
	}

	#pages = $.derived(() => {
		if (this.totalPages <= this.#itemsCount) {
			return Array.from({ length: this.totalPages }, (_, i) => i + 1);
		}

		const half = Math.floor(this.#itemsCount / 2);
		let start = Math.max(1, this.currentPage - half);
		let end = Math.min(this.totalPages, start + this.#itemsCount - 1);

		if (end === this.totalPages) {
			start = Math.max(1, end - this.#itemsCount + 1);
		} else if (start === 1) {
			end = Math.min(this.totalPages, this.#itemsCount);
		}

		if (this.showLeftEllipsis) start++;
		if (this.showRightEllipsis) end--;

		return Array.from({ length: end - start + 1 }, (_, i) => start + i);
	});

	get pages() {
		return this.#pages();
	}

	set pages($$value) {
		return this.#pages($$value);
	}

	constructor(props) {
		this.currentPage = props.currentPage;
		this.#itemsCount = props.paginationItemsToDisplay;
		this.totalPages = props.totalPages;
	}

	setPage(newPage) {
		if (newPage >= 1 && newPage <= this.totalPages) {
			this.currentPage = newPage;
		}
	}

	updateTotalPages(count) {
		if (count >= 1) {
			this.totalPages = count;

			if (this.currentPage > count) {
				this.currentPage = count;
			}
		}
	}
}

export function usePagination(options) {
	return new Pagination(options);
}

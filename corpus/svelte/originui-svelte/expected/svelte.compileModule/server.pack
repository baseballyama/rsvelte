import * as $ from 'svelte/internal/server';
import { getContext, setContext } from 'svelte';

const COMPONENT_DIALOG_CTX_KEY = Symbol('ctx:component-dialog');

class ComponentDialog {
	#component;

	constructor(props) {
		this.#component = props.component;
	}

	get component() {
		return this.#component;
	}

	reset() {
		this.#component = undefined;
	}

	setComponent(component) {
		this.#component = component;
	}
}

export const setComponentDialogCtx = (props) => {
	return setContext(COMPONENT_DIALOG_CTX_KEY, new ComponentDialog(props));
};

export const getComponentDialogCtx = () => {
	return getContext(COMPONENT_DIALOG_CTX_KEY);
};

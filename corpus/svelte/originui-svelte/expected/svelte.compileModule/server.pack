/* use-locale.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/server';
import { getContext, setContext } from 'svelte';

const LOCALE_CONTEXT_KEY = Symbol('ctx:locale');

export class LocaleManager {
	#locale = '';

	constructor(options = {}) {
		this.#locale = options.locale ?? getDefaultLocale();
	}

	get locale() {
		return this.#locale;
	}

	set locale(value) {
		this.#locale = value;
	}
}

export function useLocale(options = {}) {
	const contextLocale = getContext(LOCALE_CONTEXT_KEY);

	if (contextLocale) {
		return contextLocale;
	}

	const localeManager = new LocaleManager(options);

	setContext(LOCALE_CONTEXT_KEY, localeManager);

	return localeManager;
}

function getDefaultLocale() {
	if (typeof navigator !== 'undefined' && navigator.language) {
		return navigator.language;
	}

	return 'en-US';
}

import * as $ from 'svelte/internal/client';

export class CharacterLimit {
	#value = $.state('');
	#characterCount = $.derived(() => $.get(this.#value).length);

	get characterCount() {
		return $.get(this.#characterCount);
	}

	set characterCount(value) {
		$.set(this.#characterCount, value);
	}

	maxLength;

	constructor(maxLength, initialValue = '') {
		this.maxLength = maxLength;
		$.set(this.#value, initialValue, true);
	}

	set value(value) {
		if (value.length <= this.maxLength) {
			$.set(this.#value, value, true);
		}
	}

	get value() {
		return $.get(this.#value);
	}
}

export function useCharacterLimit(maxLength, initialValue = '') {
	return new CharacterLimit(maxLength, initialValue);
}

/* use-password-strength.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

const DEFAULT_REQUIREMENTS = [
	{ regex: /.{8,}/, text: 'At least 8 characters' },
	{ regex: /[0-9]/, text: 'At least 1 number' },
	{ regex: /[a-z]/, text: 'At least 1 lowercase letter' },
	{ regex: /[A-Z]/, text: 'At least 1 uppercase letter' }
];

export class PasswordStrength {
	#password = $.state('');
	#isVisible = $.state(false);
	id;
	requirements = DEFAULT_REQUIREMENTS;

	constructor(options) {
		this.id = options.id;
		$.set(this.#password, options.initialPassword ?? '', true);

		if (options.requirements) {
			this.requirements = options.requirements;
		}

		this.toggleVisibility = this.toggleVisibility.bind(this);
	}

	get password() {
		return $.get(this.#password);
	}

	set password(value) {
		$.set(this.#password, value, true);
	}

	get isVisible() {
		return $.get(this.#isVisible);
	}

	toggleVisibility = () => {
		$.set(this.#isVisible, !$.get(this.#isVisible));
	};

	#strength = $.derived(() => this.requirements.map((req) => ({ met: req.regex.test($.get(this.#password)), text: req.text })));

	get strength() {
		return $.get(this.#strength);
	}

	set strength(value) {
		$.set(this.#strength, value);
	}

	#strengthScore = $.derived(() => this.strength.filter((req) => req.met).length);

	get strengthScore() {
		return $.get(this.#strengthScore);
	}

	set strengthScore(value) {
		$.set(this.#strengthScore, value);
	}

	get strengthColor() {
		if (this.strengthScore === 0) return 'bg-border';
		if (this.strengthScore <= 1) return 'bg-red-500';
		if (this.strengthScore <= 2) return 'bg-orange-500';
		if (this.strengthScore === 3) return 'bg-amber-500';

		return 'bg-emerald-500';
	}

	get strengthText() {
		if (this.strengthScore === 0) return 'Enter a password';
		if (this.strengthScore <= 2) return 'Weak password';
		if (this.strengthScore === 3) return 'Medium password';

		return 'Strong password';
	}
}

export function usePasswordStrength(options) {
	return new PasswordStrength(options);
}

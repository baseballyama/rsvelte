import * as $ from 'svelte/internal/client';

export class Pagination {
	#currentPage = $.state(1);

	get currentPage() {
		return $.get(this.#currentPage);
	}

	set currentPage(value) {
		$.set(this.#currentPage, value, true);
	}

	#totalPages = $.state(1);

	get totalPages() {
		return $.get(this.#totalPages);
	}

	set totalPages(value) {
		$.set(this.#totalPages, value, true);
	}

	#itemsCount = $.state(5);
	#showLeftEllipsis = $.derived(() => this.currentPage > Math.ceil($.get(this.#itemsCount) / 2));

	get showLeftEllipsis() {
		return $.get(this.#showLeftEllipsis);
	}

	set showLeftEllipsis(value) {
		$.set(this.#showLeftEllipsis, value);
	}

	#showRightEllipsis = $.derived(() => this.totalPages - this.currentPage >= Math.ceil($.get(this.#itemsCount) / 2));

	get showRightEllipsis() {
		return $.get(this.#showRightEllipsis);
	}

	set showRightEllipsis(value) {
		$.set(this.#showRightEllipsis, value);
	}

	#pages = $.derived(() => {
		if (this.totalPages <= $.get(this.#itemsCount)) {
			return Array.from({ length: this.totalPages }, (_, i) => i + 1);
		}

		const half = Math.floor($.get(this.#itemsCount) / 2);
		let start = Math.max(1, this.currentPage - half);
		let end = Math.min(this.totalPages, start + $.get(this.#itemsCount) - 1);

		if (end === this.totalPages) {
			start = Math.max(1, end - $.get(this.#itemsCount) + 1);
		} else if (start === 1) {
			end = Math.min(this.totalPages, $.get(this.#itemsCount));
		}

		if (this.showLeftEllipsis) start++;
		if (this.showRightEllipsis) end--;

		return Array.from({ length: end - start + 1 }, (_, i) => start + i);
	});

	get pages() {
		return $.get(this.#pages);
	}

	set pages(value) {
		$.set(this.#pages, value);
	}

	constructor(props) {
		this.currentPage = props.currentPage;
		$.set(this.#itemsCount, props.paginationItemsToDisplay, true);
		this.totalPages = props.totalPages;
	}

	setPage(newPage) {
		if (newPage >= 1 && newPage <= this.totalPages) {
			this.currentPage = newPage;
		}
	}

	updateTotalPages(count) {
		if (count >= 1) {
			this.totalPages = count;

			if (this.currentPage > count) {
				this.currentPage = count;
			}
		}
	}
}

export function usePagination(options) {
	return new Pagination(options);
}

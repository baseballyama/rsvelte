/* use-local-storage.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { on } from 'svelte/events';
import { createSubscriber } from 'svelte/reactivity';

export class LocalStorage {
	#key;
	#value;
	#update;

	#subscribe = createSubscriber((update) => {
		this.#update = update;

		return on(window, 'storage', (e) => {
			if (e.storageArea !== localStorage) return;
			if (e.key !== this.#key) return;

			update();
		});
	});

	constructor(key, initial) {
		this.#key = key;
		this.#value = initial;

		if (typeof localStorage !== 'undefined') {
			if (localStorage.getItem(key) === null) {
				localStorage.setItem(key, JSON.stringify(initial));
			}
		}
	}

	get current() {
		this.#subscribe();

		const root = typeof localStorage !== 'undefined'
			? JSON.parse(localStorage.getItem(this.#key))
			: this.#value;

		const proxies = new WeakMap();

		const proxy = (value) => {
			if (typeof value !== 'object' || value === null) {
				return value;
			}

			let p = proxies.get(value);

			if (!p) {
				p = new Proxy(value, {
					get: (target, property) => {
						this.#subscribe();

						return proxy(Reflect.get(target, property));
					},

					set: (target, property, value) => {
						Reflect.set(target, property, value);

						if (typeof localStorage !== 'undefined') {
							localStorage.setItem(this.#key, JSON.stringify(root));
						}

						this.#update?.();

						return true;
					}
				});

				proxies.set(value, p);
			}

			return p;
		};

		return proxy(root);
	}

	set current(value) {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(this.#key, JSON.stringify(value));
		}

		this.#update?.();
	}
}

export function useLocalStorage(key, initial) {
	return new LocalStorage(key, initial);
}

/* use-image-upload.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export class ImageUpload {
	#previewUrl = $.state(null);
	#fileName = $.state(null);
	#fileInput = $.state(null);
	#files = $.state(null);
	#onUpload;

	constructor(options = {}) {
		this.#onUpload = options.onUpload;

		if (options.initialImage) {
			$.set(this.#previewUrl, options.initialImage, true);
		}
	}

	get previewUrl() {
		return $.get(this.#previewUrl);
	}

	get fileName() {
		return $.get(this.#fileName);
	}

	get fileInput() {
		return $.get(this.#fileInput);
	}

	set fileInput(input) {
		$.set(this.#fileInput, input, true);
	}

	get files() {
		return $.get(this.#files);
	}

	set files(files) {
		$.set(this.#files, files, true);

		const file = files?.[0];

		if (file) {
			$.set(this.#fileName, file.name, true);

			const url = URL.createObjectURL(file);

			if ($.get(this.#previewUrl)) {
				URL.revokeObjectURL($.get(this.#previewUrl));
			}

			$.set(this.#previewUrl, url, true);
			this.#onUpload?.(url);
		}
	}

	handleThumbnailClick = () => {
		$.get(this.#fileInput)?.click();
	};

	handleRemove = () => {
		if ($.get(this.#previewUrl)) {
			URL.revokeObjectURL($.get(this.#previewUrl));
		}

		$.set(this.#previewUrl, null);
		$.set(this.#fileName, null);

		if ($.get(this.#fileInput)) {
			$.get(this.#fileInput).value = '';
		}

		$.set(this.#files, null);
	};

	destroy() {
		if ($.get(this.#previewUrl)) {
			URL.revokeObjectURL($.get(this.#previewUrl));
		}
	}
}

export function useImageUpload(options) {
	return new ImageUpload(options);
}

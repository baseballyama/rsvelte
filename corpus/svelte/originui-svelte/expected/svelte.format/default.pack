<TooltipProvider>
  <Tooltip>
    <TooltipTrigger aria-label="Bookmark this">
      {#snippet child({ props })}
        <Toggle
          class="group size-9 p-0 hover:bg-indigo-50 hover:text-indigo-500 data-[state=on]:bg-indigo-50 data-[state=on]:text-indigo-500"
          pressed={bookmarked}
          onPressedChange={() => (bookmarked = !bookmarked)}

          <strong class="text-sm font-medium">Features include:</strong>
        </p>
        <ul class="text-muted-foreground space-y-2 text-sm">
          <li class="flex gap-2">
            <Check
              size={16}
              class="text-primary mt-0.5 shrink-0"
              aria-hidden="true"
            />
            Create unlimited projects.

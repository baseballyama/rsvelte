      id: "checkbox-18-c2",
      label: "Tuesday",
      value: "c2",
    },
    { id: "checkbox-18-c3", label: "Wednesday", value: "c3" },
    {
      defaultChecked: true,
      id: "checkbox-18-c4",
      label: "Thursday",
      value: "c4",
    },
    {
      defaultChecked: true,
      id: "checkbox-18-c5",
      label: "Friday",
      value: "c5",
    },
    { id: "checkbox-18-c6", label: "Saturday", value: "c6" },
    { disabled: true, id: "checkbox-18-c7", label: "Sunday", value: "c7" },
  ];

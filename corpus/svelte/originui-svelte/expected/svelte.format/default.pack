          <Bookmark size={16} aria-hidden="true" {...props} />
        </Toggle>
      {/snippet}
    </TooltipTrigger>
    <TooltipContent class="px-2 py-1 text-xs">
      <p>{bookmarked ? "Remove bookmark" : "Bookmark this"}</p>
    </TooltipContent>
  </Tooltip>
</TooltipProvider>


  import { useSliderWithInput } from "$lib/hooks/use-slider-with-input.svelte";

  const minValue = 0;
  const maxValue = 200;
  const initialValue = [50, 150];

  const slider = useSliderWithInput({ initialValue, maxValue, minValue });

import * as $ from 'svelte/internal/server';

export default function _978af891d9c7d0c($$renderer, $$props) {
	let { options = [], children } = $$props;

	$$renderer.push(`<div><!--[-->`);

	const each_array = $.ensure_array_like(options);

	for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
		let option = each_array[$$index];

		$$renderer.push(`<button>`);

		if (children) {
			$$renderer.push('<!--[0-->');
			children($$renderer, { option });
			$$renderer.push(`<!---->`);
		} else {
			$$renderer.push('<!--[-1-->');

			if (option.icon) {
				$$renderer.push(`<!--[0--><i${$.attr_class(`wx-icon ${$.stringify(option.icon)} ${!option.label ? 'wx-only' : ''}`, 'svelte-nlbtia')}></i>`);
			} else {
				$$renderer.push('<!--[-1-->');
			}

			$$renderer.push(`<!--]--> `);

			if (option.label) {
				$$renderer.push(`<!--[0--><span class="wx-label svelte-nlbtia">${$.escape(option.label)}</span>`);
			} else {
				$$renderer.push('<!--[-1-->');
			}

			$$renderer.push(`<!--]-->`);
		}

		$$renderer.push(`<!--]--></button>`);
	}

	$$renderer.push(`<!--]--></div>`);
}

import 'svelte/internal/disclose-version';
import * as $ from 'svelte/internal/client';

var root = $.from_html(`<b class="x"></b>`);
var root_1 = $.from_html(`<p class="a"> </p>`);
var root_2 = $.from_html(`<!> <section></section>`, 1);

export default function A9f0d10b94f3bd4d($$anchor) {
	let items = [1, 2];
	let cond = true;
	var fragment = root_2();
	var node = $.first_child(fragment);

	$.boundary(node, {}, ($$anchor) => {
		var b = root();

		$.append($$anchor, b);
	});

	var section = $.sibling(node, 2);

	$.each(section, 21, () => items, $.index, ($$anchor, i) => {
		var p = root_1();
		var text = $.only_child(p, true);

		$.template_effect(() => $.set_text(text, $.get(i)));
		$.append($$anchor, p);
	});

	$.reset(section);
	$.append($$anchor, fragment);
}

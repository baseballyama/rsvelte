import * as $ from 'svelte/internal/server';

export const defaultSerializer = () => ({
	serialize: (value) => JSON.stringify(value),
	deserialize: (value) => JSON.parse(value)
});

export function useStore() {
	let value = '';

	return {
		get value() {
			return value;
		},

		set value(v) {
			value = v;
		}

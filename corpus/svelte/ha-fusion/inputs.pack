		[key: string]: {
			input: string | undefined;
			output: string | undefined;
			error: string | undefined;
			entity_id: string | undefined;
		};
	};
}

export interface PersistentNotification {
	created_at: string;
	message: string;
	notification_id: string;
	title: string;
	status: 'read' | 'unread';
}

export type SidebarItem = BarItem &
	CameraItem &
	DateItem &

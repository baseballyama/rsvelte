		this.opts = opts;
		this.group = group;
		this.attachment = attachRef(opts.ref, (v) => this.group.labelNode = v);
	}

	#props = $.derived(() => ({
		id: this.opts.id.current,
		[this.group.root.getBitsAttr("group-label")]: "",
		...this.attachment
	}));

	get props() {
		return $.get(this.#props);

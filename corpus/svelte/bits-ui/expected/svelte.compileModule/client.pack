/* use-toc.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { untrack } from "svelte";
import { page } from "$app/state";
import { on } from "svelte/events";

export function useToc(getItemIds) {
	const itemIds = $.derived(getItemIds);
	let activeId = $.state(null);
	const urlHash = $.derived(() => page.url.hash);
	const isAtBottom = useIsAtBottom();
	const activeIndex = $.derived(() => $.get(itemIds).findIndex((id) => id === $.get(activeId)));

	const markerTopStyle = $.derived(() => {
		if ($.get(activeIndex) === -1) return "0px";

		return $.get(activeIndex) * 28 + "px";
	});

	function isActive(item) {
		return item.url === $.get(urlHash) && `#${$.get(activeId)}` === $.get(urlHash) || isParentOfActiveItem(item) || item.url === `#${$.get(activeId)}`;
	}

	function isParentOfActiveItem(item) {
		return Boolean(item.items?.some((item) => item.url === `#${$.get(activeId)}`));
	}

	function isLastItem(item) {
		return `#${$.get(itemIds)[$.get(itemIds).length - 1]}` === item.url;
	}

	$.user_effect(() => {
		const hash = $.get(urlHash);

		untrack(() => {
			if (hash === `#${$.get(activeId)}`) return;

			$.set(activeId, hash.split("#")[1], true);
		});
	});

	$.user_effect(() => {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						untrack(() => $.set(activeId, entry.target.id, true));
						$.set(activeId, entry.target.id, true);
					}
				}
			},
			{ rootMargin: "0% 0% -80% 0% " }
		);

		for (const id of $.get(itemIds)) {
			const node = document.getElementById(id);

			if (node) observer.observe(node);
		}

		return () => {
			for (const id of $.get(itemIds)) {
				const node = document.getElementById(id);

				if (node) observer.unobserve(node);
			}
		};
	});

	$.user_effect(() => {
		if (isAtBottom.current) {
			untrack(() => {
				$.set(activeId, $.get(itemIds)[$.get(itemIds).length - 1], true);
			});
		}
	});

	return {
		get activeId() {
			return $.get(activeId);
		},

		get markerTopStyle() {
			return $.get(markerTopStyle);
		},
		isActive,
		isLastItem
	};
}

function useIsAtBottom() {
	let isAtBottom = $.state(false);

	function checkScrollPos() {
		const buffer = 20;

		untrack(() => {
			$.set(isAtBottom, window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - buffer);
		});
	}

	$.user_effect(() => {
		return on(window, "scroll", checkScrollPos);
	});

	return {
		get current() {
			return $.get(isAtBottom);
		}
	};
}

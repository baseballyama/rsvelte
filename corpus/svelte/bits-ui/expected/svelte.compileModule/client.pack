	}
}

const SITE_CONFIG_KEY = Symbol("sveco-site-config");

export function useSiteConfig(getProps) {
	if (getProps) {
		return setContext(SITE_CONFIG_KEY, new SiteConfigState(getProps));
	} else if (hasContext(SITE_CONFIG_KEY)) {

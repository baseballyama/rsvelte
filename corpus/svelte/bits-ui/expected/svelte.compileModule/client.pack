	}

	set isDisabled(value) {
		$.set(this.#isDisabled, value);
	}

	#snippetProps = $.derived(() => {
		return {
			monthItems: this.monthItems,
			selectedMonthItem: this.monthItems.find((month) => month.value === this.currentMonth)
		};
	});


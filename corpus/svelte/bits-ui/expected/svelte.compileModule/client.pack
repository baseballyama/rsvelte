/* copy-to-clipboard.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';
import { getContext, hasContext, setContext } from "svelte";

export class CopyToClipboard {
	opts;
	#isCopied = $.state(false);

	get isCopied() {
		return $.get(this.#isCopied);
	}

	set isCopied(value) {
		$.set(this.#isCopied, value, true);
	}

	#codeString = $.state("");

	get codeString() {
		return $.get(this.#codeString);
	}

	set codeString(value) {
		$.set(this.#codeString, value, true);
	}

	#timeout = $.derived(() => this.opts.timeout ?? 2000);

	get timeout() {
		return $.get(this.#timeout);
	}

	set timeout(value) {
		$.set(this.#timeout, value);
	}

	constructor(opts = {}) {
		this.opts = opts;
	}

	setCodeString = (v) => {
		this.codeString = v;
	};

	copyToClipboard = (value = this.codeString) => {
		if (typeof window === "undefined" || !navigator.clipboard.writeText) return;
		if (!value) return;

		navigator.clipboard.writeText(value).then(
			() => {
				this.isCopied = true;

				if (this.opts.onCopy) {
					this.opts.onCopy();
				}

				setTimeout(
					() => {
						this.isCopied = false;
					},
					this.timeout
				);
			},
			console.error
		);
	};

	setCodeStringAction = (node) => {
		this.codeString = node.innerText.trim() ?? "";
	};
}

const COPY_TO_CLIPBOARD_KEY = Symbol("copy-to-clipboard");

export function setCopyToClipboard(props) {
	return setContext(COPY_TO_CLIPBOARD_KEY, new CopyToClipboard(props));
}

export function useCopyToClipboard() {
	if (!hasContext(COPY_TO_CLIPBOARD_KEY)) {
		return null;
	}

	return getContext(COPY_TO_CLIPBOARD_KEY);
}

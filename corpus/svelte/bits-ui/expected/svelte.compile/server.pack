				checked = true;
			} else {
				checked = false;
			}
		}

		watch.pre(() => value, () => {
			if (group && value) {
				if (group.opts.value.current.includes(value)) {
					checked = true;
				} else {
					checked = false;
				}
			}
		});

		const checkboxItemState = MenuCheckboxItemState.create(
			{

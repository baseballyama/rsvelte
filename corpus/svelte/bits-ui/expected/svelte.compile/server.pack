							if (Combobox.Portal) {
								$$renderer.push('<!--[-->');

								Combobox.Portal($$renderer, $.spread_props([
									portalProps,
									{
										children: ($$renderer) => {
											if (Combobox.Content) {
												$$renderer.push('<!--[-->');

												Combobox.Content($$renderer, $.spread_props([
													{ 'data-testid': 'content' },

									AlertDialog.Content($$renderer, {
										class: 'fixed\n      left-[50%] top-[50%] z-[90] w-full max-w-[calc(100%-2rem)]\n      translate-x-[-50%] translate-y-[-50%] rounded-xl\n      border bg-black p-5\n      md:w-[350px]\n      ',
										children: ($$renderer) => {

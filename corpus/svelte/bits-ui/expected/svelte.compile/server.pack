											if (Select.ScrollDownButton) {
												$$renderer.push('<!--[-->');

												Select.ScrollDownButton($$renderer, {
													class: 'flex w-full items-center justify-center',
													delay: autoScrollDelay,
													children: ($$renderer) => {
														CaretDoubleDown($$renderer, { class: 'size-3' });
													},
													$$slots: { default: true }
												});


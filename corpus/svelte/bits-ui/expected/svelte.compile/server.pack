				children: ($$renderer) => {
					RaycastCommand($$renderer, {});
				},
				$$slots: { default: true }
			});
		} else if (theme === "linear") {
			$$renderer.push('<!--[1-->');

			CommandWrapper($$renderer, {
				children: ($$renderer) => {
					LinearCommand($$renderer, {});
				},
				$$slots: { default: true }
			});
		} else if (theme === "vercel") {
			$$renderer.push('<!--[2-->');

			CommandWrapper($$renderer, {
				children: ($$renderer) => {
					VercelCommand($$renderer, {});
				},
				$$slots: { default: true }
			});
		} else if (theme === "framer") {
			$$renderer.push('<!--[3-->');

			CommandWrapper($$renderer, {
				children: ($$renderer) => {
					FramerCommand($$renderer, {});
				},
				$$slots: { default: true }
			});
		} else {
			$$renderer.push('<!--[-1-->');
		}

		$$renderer.push(`<!--]--></div> `);

		ThemeSwitcher($$renderer, {
			get theme() {
				return theme;
			},

			set theme($$value) {
				theme = $$value;
				$$settled = false;

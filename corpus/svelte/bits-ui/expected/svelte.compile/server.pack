								} else {
									$$renderer.push('<!--[!-->');
									$$renderer.push('<!--]-->');
								}

								$$renderer.push(` <!--[-->`);

								const each_array = $.ensure_array_like(names);

								for (let $$index = 0, $$length = each_array.length; $$index < $$length; $$index++) {
									let txt = each_array[$$index];

									if (Command.Item) {
										$$renderer.push('<!--[-->');


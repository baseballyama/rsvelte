    const group = page.getByTestId("group");
    const groupHeading = page.getByTestId("group-label");
    await tick();
    return {
        ...returned,
        group,
        groupHeading,
        content,
    };
}
async function openMultiple(props = {}, openWith = "click", searchValue) {

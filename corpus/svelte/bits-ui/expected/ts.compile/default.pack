        expect(cssEscape("abcdefghijklmnopqrstuvwxyz")).toBe("abcdefghijklmnopqrstuvwxyz");
        expect(cssEscape("ABCDEFGHIJKLMNOPQRSTUVWXYZ")).toBe("ABCDEFGHIJKLMNOPQRSTUVWXYZ");
    });
    it("should escape special characters", () => {
        expect(cssEscape("\x20\x21\x78\x79")).toBe("\\ \\!xy");
    });
    it("should handle unicode surrogates", () => {

        }),
    ],
    cssVars: floatingContentCSSVars("popover"),
});
export const contentStatic = defineComponentApiSchema({
    title: "ContentStatic",
    description: "The contents of the popover which are displayed when the popover is open. (Static/No Floating UI)",

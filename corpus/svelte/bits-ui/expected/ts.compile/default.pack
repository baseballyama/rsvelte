    subTriggerEl.dispatchEvent(new PointerEvent("pointerleave", {
        bubbles: true,
        pointerType: "mouse",
        clientX: leavePt.x,
        clientY: leavePt.y,
        relatedTarget: subContentWrapper,
    }));
    document.dispatchEvent(new PointerEvent("pointermove", {

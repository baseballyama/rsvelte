        return (node) => node.focus();
    });
    #getCurrentItem = $derived.by(() => {
        if (this.#opts.getCurrentItem)
            return this.#opts.getCurrentItem;
        return this.#opts.getActiveElement;
    });
    constructor(opts) {
        this.#opts = opts;

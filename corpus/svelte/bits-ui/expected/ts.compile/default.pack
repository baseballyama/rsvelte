const empty = defineComponentApiSchema({
    title: "Empty",
    description: "A component to display when no results are found.",
    props: {
        forceMount: defineBooleanProp({
            default: false,
            description: "Whether or not to forcefully mount the empty state, regardless of the internal filtering logic. Useful when you want to handle filtering yourself.",
        }),
        ...withChildProps({ elType: "HTMLDivElement" }),
    },
    dataAttributes: [
        defineSimpleDataAttr({
            name: "command-empty",
            description: "Present on the empty element.",
        }),
    ],
});
const loading = defineComponentApiSchema({
    title: "Loading",
    description: "A component to display while results are being fetched or processed.",
    props: {
        progress: defineNumberProp({
            default: 0,
            description: "The progress of the loading state.",
        }),
        ...withChildProps({ elType: "HTMLDivElement" }),
    },
    dataAttributes: [
        defineSimpleDataAttr({
            name: "command-loading",
            description: "Present on the loading element.",
        }),
    ],
});
const separator = defineComponentApiSchema({
    title: "Separator",
    description: "A visual separator to divide different sections of the command list. Visible when the search query is empty or the `forceMount` prop is `true`.",
    props: {
        forceMount: defineBooleanProp({
            default: false,
            description: "Whether or not the separator should always be mounted to the DOM, regardless of the internal filtering logic",
        }),
        ...withChildProps({ elType: "HTMLDivElement" }),
    },
    dataAttributes: [
        defineSimpleDataAttr({
            name: "command-separator",
            description: "Present on the separator element.",
        }),
    ],
});
export const command = [
    root,
    input,
    list,
    viewport,
    group,
    groupHeading,
    groupItems,
    item,
    linkItem,
    empty,
    loading,
    separator,
];


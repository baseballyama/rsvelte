            const thumbLabel0 = page.getByTestId("thumb-label-0").element();
            const thumbLabel1 = page.getByTestId("thumb-label-1").element();
            thumb0.focus();
            await userEvent.keyboard(kbd.ARROW_RIGHT);
            await userEvent.keyboard(kbd.ARROW_RIGHT);

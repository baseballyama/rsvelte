                    else {
                        this.#prev(e);
                    }
                }
                break;
            }
            case kbd.h: {
                // vim left
                if (isVim && this.isGrid) {
                    this.#prev(e);
                }
                break;
            }
            case kbd.ARROW_UP:
                if (this.isGrid) {
                    this.#up(e);
                }
                else {
                    this.#prev(e);
                }
                break;
            case kbd.ARROW_LEFT:
                if (!this.isGrid)
                    break;

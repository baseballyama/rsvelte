            elType: "HTMLDivElement",
            child: floatingContentChildDefinition,
        }),
    },
    dataAttributes: [
        openClosedDataAttr,
        ...transitionStyleDataAttrs,
        defineSimpleDataAttr({
            name: "popover-content",

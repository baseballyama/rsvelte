    const t = setup({ value });
    await expect.element(t.hiddenInput).toHaveValue(value);
});
it("should sync the `disabled` prop to the hidden input", async () => {
    const t = setup({ disabled: true });
    await expect.element(t.hiddenInput).toHaveAttribute("disabled", "");

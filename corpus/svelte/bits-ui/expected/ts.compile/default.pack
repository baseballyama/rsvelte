/**
 * Gets the number of decimal places in a number
 */
function getDecimalPlaces(num) {
    if (Math.floor(num) === num)
        return 0;
    const str = num.toString();
    if (str.indexOf(".") !== -1 && str.indexOf("e-") === -1) {

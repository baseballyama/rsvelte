        return snapValueToCustomSteps(currentValue, steps);
    }
    if (direction === "next") {
        return currentIndex < steps.length - 1 ? steps[currentIndex + 1] : currentValue;
    }
    else {
        return currentIndex > 0 ? steps[currentIndex - 1] : currentValue;
    }

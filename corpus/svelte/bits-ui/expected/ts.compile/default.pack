        granularity: defineEnumProp({
            options: ["day", "hour", "minute", "second"],
            description: "The granularity to use for formatting the field. Defaults to `'day'` if a `CalendarDate` is provided, otherwise defaults to `'minute'`. The field will render segments for each part of the date up to and including the specified granularity.",
            definition: GranularityProp,

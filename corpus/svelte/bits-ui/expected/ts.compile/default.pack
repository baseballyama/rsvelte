        "content",
        "trigger",
        "group",
        "group-heading",
        "separator",
        "sub-trigger",
        "item",
        "checkbox-item",
        "radio-group",
        "radio-item",
        "checkbox-group",
    ];
    for (const part of parts) {
        const el = page.getByTestId(part);

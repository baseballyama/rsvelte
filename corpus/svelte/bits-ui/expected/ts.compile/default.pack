export function getSelectedDays(calendar) {
    return Array.from(calendar.querySelectorAll("[data-bits-day][data-selected]"));
}
export function getSelectedDay(calendar) {
    return calendar.querySelector("[data-bits-day][data-selected]");
}

=== 363 tests/src/tests/helpers/select.ts	js
/**
 * Generates consistent test ids for select items, handling empty strings and null values
 * @param value - The value of the item
 * @returns The test id
 */
export function generateTestId(value) {
    return value && value !== null ? value : "empty";
}
export function getTestId(item) {
    return item.value && item.value !== null ? item.value : "empty";
}


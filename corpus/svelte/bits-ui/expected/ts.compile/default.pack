import { cssEscape } from "./css-escape.js";
describe("cssEscape", () => {
    it("should handle null characters", () => {
        expect(cssEscape("\0")).toBe("\uFFFD");
        expect(cssEscape("a\0")).toBe("a\uFFFD");
        expect(cssEscape("\0b")).toBe("\uFFFDb");
        expect(cssEscape("a\0b")).toBe("a\uFFFDb");
    });

 */
function setup(props = {}) {
    const returned = render(MenubarTest, { ...props });
    const getTrigger = (id) => page.getByTestId(`${id}-trigger`);
    const getContent = (id) => page.getByTestId(`${id}-content`);
    const getSubTrigger = (id) => page.getByTestId(`${id}-sub-trigger`);
    const getSubContent = (id) => page.getByTestId(`${id}-sub-content`);
    return { ...returned, getTrigger, getContent, getSubTrigger, getSubContent };
}
it("should navigate triggers within the menubar using arrow keys", async () => {

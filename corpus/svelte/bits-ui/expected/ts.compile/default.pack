        thumb.focus();
        await userEvent.keyboard(key);
        expectPercentage({ percentage: 51, thumb, range });
    });
    it.each([kbd.ARROW_LEFT, kbd.ARROW_DOWN])("should change by 10% when pressing %s", async (key) => {
        setup({
            value: [0],
            min: -50,
            max: 50,
            step: 1,
        });
        const thumb = page.getByTestId("thumb").element();
        const range = page.getByTestId("range").element();
        thumb.focus();
        await userEvent.keyboard(key);
        expectPercentage({ percentage: 49, thumb, range });
    });
});

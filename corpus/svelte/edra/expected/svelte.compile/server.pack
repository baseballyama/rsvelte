									shortCut: command.shortCut ?? '',
									children: ($$renderer) => {
										$$renderer.push(`<button${$.attr_class(`edra-btn edra-btn-ghost edra-btn-icon ${isActive(command) ? 'active' : ''}`, 'svelte-szouqa')}${$.attr('disabled', !isClickable(command), true)}>`);

										if (Icon) {

	$.head('h48y44', $$renderer, ($$renderer) => {
		$$renderer.title(($$renderer) => {
			$$renderer.push(`<title>Mathematics | Edra Docs</title>`);
		});
	});

	$$renderer.push(`<article class="prose dark:prose-invert max-w-none"><h1>Mathematics (LaTeX / KaTeX)</h1> <p class="lead">Render publication-grade math formulas directly inside the editor using LaTeX syntax and KaTeX.</p> <hr class="my-6"/> <h2>Configuration</h2> <p>The math extension uses <code>@tiptap/extension-mathematics</code> as a wrapper around the super

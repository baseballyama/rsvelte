	@property --angle {
		syntax: '<angle>';
		inherits: false;
		initial-value: 0deg;
	}
	@keyframes svelte-1unrtp5-rotate {
		to {
			--angle: 360deg;
		}
	}
	.animated-gradient-border.svelte-1unrtp5 {
		background: conic-gradient(from var(--angle), #e50909, #c8b207, #e608e6, #6eec07);
		animation: svelte-1unrtp5-rotate 3s linear infinite;
		border-radius: 12px !important;
	}
	.dot.svelte-1unrtp5 {
		animation: svelte-1unrtp5-bounce-dots 1.4s ease-in-out infinite;
	}
	@keyframes svelte-1unrtp5-bounce-dots {
		0%,
		100% {
			transform: translateY(0);
			opacity: 0.35;
		}
		50% {
			transform: translateY(-4px);
			opacity: 1;
		}
	}


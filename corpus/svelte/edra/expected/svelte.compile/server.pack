			} catch(err) {
				if (thisRender !== renderCounter) return;

				error = err.message?.replace(/[\s\S]*?Syntax error in text[\s\S]*?mermaid version[\s\S]*$/m, '').trim() || err.message || 'Failed to render diagram';


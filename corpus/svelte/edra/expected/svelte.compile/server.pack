						DropdownMenu.Portal($$renderer, {
							children: ($$renderer) => {
								if (DropdownMenu.Content) {
									$$renderer.push('<!--[-->');

									DropdownMenu.Content($$renderer, {
										children: ($$renderer) => {
											if (DropdownMenu.Label) {
												$$renderer.push('<!--[-->');


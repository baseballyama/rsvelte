							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);

						Button($$renderer, {
							variant: 'outline',
							size: 'sm',
							onclick: insertNext,
							children: ($$renderer) => {
								CornerDownLeft($$renderer, {});
								$$renderer.push(`<!----> Insert`);
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);

						Button($$renderer, {
							variant: 'outline',
							size: 'sm',
							onclick: copyToClipboard,
							children: ($$renderer) => {
								Copy($$renderer, {});
								$$renderer.push(`<!----> Copy`);
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);

						Button($$renderer, {
							variant: 'outline',
							size: 'sm',
							onclick: retry,
							children: ($$renderer) => {
								RotateCcw($$renderer, {});
								$$renderer.push(`<!----> Retry`);
							},
							$$slots: { default: true }
						});

						$$renderer.push(`<!----> `);

						Button($$renderer, {
							variant: 'destructive',
							size: 'sm',
							onclick: discardChanges,

	defaultVariants: { variant: 'default', size: 'default' }
});

export default function Button($$renderer, $$props) {
	$$renderer.component(($$renderer) => {
		let {
			class: className,
			variant = 'default',
			size = 'default',
			ref = null,
			href = undefined,
			type = 'button',
			disabled,
			children,
			$$slots,
			$$events,
			...restProps
		} = $$props;

		if (href) {
			$$renderer.push(`<!--[0--><a${$.attributes({
				'data-slot': 'button',
				class: $.clsx(cn(buttonVariants({ variant, size }), className)),

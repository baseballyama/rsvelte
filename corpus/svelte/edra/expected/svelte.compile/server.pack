											Icon($$renderer, {});
											$$renderer.push('<!--]-->');
										} else {
											$$renderer.push('<!--[!-->');
											$$renderer.push('<!--]-->');
										}

										$$renderer.push(`</button>`);
									},
									$$slots: { default: true }
								});
							}

							$$renderer.push(`<!--]-->`);
						}

						$$renderer.push(`<!--]--> <div class="edra-separator" role="separator" aria-orientation="vertical"></div>`);
					}

					$$renderer.push(`<!--]-->`);
				}

				$$renderer.push(`<!--]--> `);
				FontSize($$renderer, {});
				$$renderer.push(`<!----> `);
				Colors($$renderer, {});
				$$renderer.push(`<!---->`);
			},
			$$slots: { default: true }
		});
	});

								$$settled = false;
							},
							trigger,
							children: ($$renderer) => {
								Tabs($$renderer, {
									value: 'link',
									class: 'tabs-container',
									children: ($$renderer) => {
										TabsList($$renderer, {
											class: 'tabs-list-margin',
											children: ($$renderer) => {
												TabsTrigger($$renderer, {
													value: 'link',

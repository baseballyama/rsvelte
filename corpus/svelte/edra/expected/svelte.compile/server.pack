				if (Edra.ToC) {
					$$renderer.push('<!--[-->');
					Edra.ToC($$renderer, {});
					$$renderer.push('<!--]-->');
				} else {
					$$renderer.push('<!--[!-->');
					$$renderer.push('<!--]-->');
				}

				$$renderer.push(` `);

				if (Edra.BubbleMenu) {
					$$renderer.push('<!--[-->');
					Edra.BubbleMenu($$renderer, {});
					$$renderer.push('<!--]-->');
				} else {
					$$renderer.push('<!--[!-->');
					$$renderer.push('<!--]-->');
				}

				$$renderer.push(` `);

				if (Edra.Content) {
					$$renderer.push('<!--[-->');

					Edra.Content($$renderer, {
						class: cn('mx-auto w-full cursor-auto px-8 py-4 text-base transition-all duration-300 *:outline-none', fullWidth ? 'max-w-full' : 'max-w-3xl')

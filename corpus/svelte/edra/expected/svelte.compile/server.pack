				} else {
					$$renderer.push('<!--[!-->');
					$$renderer.push('<!--]-->');
				}

				$$renderer.push(` `);

				if (Edra.DragHandle) {
					$$renderer.push('<!--[-->');
					Edra.DragHandle($$renderer, { type: 'extended', class: 'transition-all! duration-300!' });
					$$renderer.push('<!--]-->');
				} else {
					$$renderer.push('<!--[!-->');
					$$renderer.push('<!--]-->');
				}
			},
			$$slots: { default: true }
		});

		$$renderer.push(`<!----></main></div>`);
	});

			$$renderer.push(`<!--[0--><div${$.attr_class(`edra-dropdown-content dropdown-subcontent ${$.stringify(className)}`, 'svelte-1rd6k5p')} style="left: 0; top: 0; width: max-content; min-width: 8rem; visibility: hidden;" role="menu" tabindex="-1">`);

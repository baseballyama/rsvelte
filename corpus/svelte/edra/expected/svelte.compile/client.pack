	var node = $.child(div);

	Code(node, { code: jsonCode, language: 'typescript' });
	$.reset(div);

	var div_1 = $.sibling(div, 10);
	var node_1 = $.child(div_1);

	Code(node_1, { code: htmlCode, language: 'typescript' });
	$.reset(div_1);

	var div_2 = $.sibling(div_1, 8);
	var node_2 = $.child(div_2);


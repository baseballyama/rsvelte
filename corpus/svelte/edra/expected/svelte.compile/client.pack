		overflow: hidden;
	}
	.demo-toolbar {
		border-bottom: 1px solid var(--edra-border);
		padding: 4px;
		background-color: var(--edra-canvas-soft) !important;
		overflow-x: scroll;
		max-width: 100% !important;
	}
	.demo-content {
		cursor: auto;
		padding: 2rem;
		height: 30rem; /* h-120 */
		overflow-y: scroll;
		background-color: var(--edra-canvas);
	}
	.demo-content *:outline-none {
		outline: none;
	}


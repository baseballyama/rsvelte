		class: 'gap-2',
		children: ($$anchor, $$slotProps) => {
			$.next();

			var fragment = root();
			var node_1 = $.sibling($.first_child(fragment));

			ArrowRight(node_1, { class: 'size-4' });
			$.append($$anchor, fragment);

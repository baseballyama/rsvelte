import * as $ from 'svelte/internal/client';
import { mount, unmount } from 'svelte';

export class SvelteRenderer {
	container;
	componentInstance = null;

	// eslint-disable-next-line @typescript-eslint/no-explicit-any
	component;

	#store = $.state($.proxy({}));

	get store() {
		return $.get(this.#store);
	}

	set store(value) {
		$.set(this.#store, value, true);
	}

	destroyed = false;
	el = null;

	constructor(component, { props = {} } = {}) {
		this.component = component;
		this.container = document.createElement('div');
		Object.assign(this.store, props);
		this.mountComponent();
	}

	get element() {
		return this.el;
	}

	get props() {
		return this.store;
	}

	get ref() {
		return this.componentInstance;
	}

	mountComponent() {
		if (this.destroyed) {
			return;
		}

		this.componentInstance = mount(this.component, { target: this.container, props: this.store });
		this.el = this.container.firstElementChild;
	}

	updateProps(props = {}) {
		if (this.destroyed) {
			return;
		}

		Object.assign(this.store, props);
	}

	destroy() {
		if (this.destroyed) {
			return;
		}

		this.destroyed = true;

		if (this.componentInstance) {
			unmount(this.componentInstance);
			this.componentInstance = null;
		}

		this.el = null;
	}
}

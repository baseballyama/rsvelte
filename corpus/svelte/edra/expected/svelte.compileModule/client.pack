/* useEditorTransaction.svelte.ts generated by Svelte v5.57.3 */
import * as $ from 'svelte/internal/client';

export function useEditorTransaction(editor) {
	let version = $.state(0);

	$.user_effect(() => {
		const handler = () => {
			$.update(version);
		};

		editor.on('transaction', handler);

		return () => {
			editor.off('transaction', handler);
		};
	});

	return {
		get version() {
			return $.get(version);
		}
	};
}

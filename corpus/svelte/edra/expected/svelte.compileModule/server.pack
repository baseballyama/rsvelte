import * as $ from 'svelte/internal/server';
import { browser } from '$app/environment';
import { Editor } from '../Editor.ts';

export const useEditor = (options = {}) => {
	let editor = undefined;

	if (browser) {
		editor = new Editor(options);
	}

	return editor;
};

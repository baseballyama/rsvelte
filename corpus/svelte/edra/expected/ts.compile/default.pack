                    else if (mediaType === 'video') {
                        editor.commands.setVideo({ src });
                    }
                    else {
                        editor.commands.setImage({ src });
                    }
                })
                    .catch((error) => {
                    console.error('Failed to upload media:', error);
                });
                return true;
            }
        };
    }
});


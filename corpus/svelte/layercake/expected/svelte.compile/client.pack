			$.append($$anchor, a_1);
		});

		$.reset(li);

		$.template_effect(() => {
			$.set_class(a, 1, `section ${$.get(section).slug === $$props.activeGuideSection ? 'active' : ''}`, 'svelte-p8o6km');
			$.set_attribute(a, 'href', `/guide#${$.get(section).slug ?? ''}`);
			$.set_text(text, $.get(section).metadata.title);
		});

		$.delegated('click', a, close);
		$.append($$anchor, li);
	});

	$.reset(ul);
	$.append($$anchor, ul);
	$.pop();
}


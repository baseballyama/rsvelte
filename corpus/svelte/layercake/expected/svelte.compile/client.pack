			x: xKey,
			y: yKey,
			z: zKey,
			get zScale() {
				return $.get($0);
			},

			get zDomain() {
				return seriesNames;
			},

			get zRange() {
				return seriesColors;
			},

			get flatData() {
				return $.get($1);
			},
			yDomain: [0, null],
			get data() {
				return dataLong;
			},


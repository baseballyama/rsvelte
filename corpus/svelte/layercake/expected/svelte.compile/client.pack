	$.reset(pre);
	$.reset(div_1);

	var div_2 = $.sibling(div_1, 2);

	$.each(div_2, 21, () => examples, $.index, ($$anchor, example) => {
		var div_3 = root_1();
		var h4 = $.child(div_3);
		var a = $.child(h4);
		var text = $.only_child(a, true);

		$.reset(h4);

		var node = $.sibling(h4, 2);


				});
			},
			$$slots: { default: true }
		});
	}

	$.reset(div_1);
	$.template_effect(() => $.set_text(text, `${$.get(binCount) ?? ''} bins`));
	$.bind_value(input, () => $.get(binCount), ($$value) => $.set(binCount, $$value));
	$.append($$anchor, fragment);
	$.pop();
}

			z: zKey,
			get xScale() {
				return $.get($0);
			},
			xDomainSort: false,
			get zScale() {
				return $.get($1);
			},

			get zDomain() {
				return seriesNames;
			},

			get zRange() {
				return seriesColors;
			},

			get flatData() {
				return $.get($2);
			},

			get data() {
				return stackedData;
			},

			children: ($$anchor, $$slotProps) => {
				Svg($$anchor, {
					children: ($$anchor, $$slotProps) => {
						var fragment_1 = root();
						var node_1 = $.first_child(fragment_1);

						AxisX(node_1, { gridlines: false });

						var node_2 = $.sibling(node_1, 2);

						AxisY(node_2, { ticks: 4, gridlines: false, format: formatLabelY });

						var node_3 = $.sibling(node_2, 2);


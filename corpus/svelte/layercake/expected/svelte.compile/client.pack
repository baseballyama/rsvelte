		});

		$.reset(div_2);
		$.append($$anchor, div_2);
	});

	$.reset(div_1);
	$.bind_group(binding_group, [], input, () => $.get(scale), ($$value) => $.set(scale, $$value));
	$.bind_group(binding_group, [], input_1, () => $.get(scale), ($$value) => $.set(scale, $$value));
	$.append($$anchor, fragment);

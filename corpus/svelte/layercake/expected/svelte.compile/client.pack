	.chart-container.svelte-36sxra {
		flex: 1;
		position: relative;
	}
	.props.svelte-36sxra {
		flex-grow: 0;
		flex-shrink: 1;
		display: flex;
		flex-direction: column;
		user-select: none;
		overflow-y: auto;
		font-size: 0.9rem;
	}
	label.svelte-36sxra {
		display: flex;
		cursor: pointer;
		align-items: center;
	}
	input[type='checkbox'].svelte-36sxra {
		margin-left: 0;
	}

	label.number.svelte-36sxra {
		display: flex;
		justify-content: space-between;
	}

	input[type='number'].svelte-36sxra {
		max-width: 35px;
		margin-left: 10px;
		float: right;
	}
	span.disabled.svelte-36sxra {
		opacity: 0.5;
	}
	label.disabled.svelte-36sxra {
		pointer-events: none;
	}


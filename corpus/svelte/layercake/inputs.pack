				rel="noreferrer"
				href="https://github.com/mhkeller/layercake"
				aria-label="Layer Cake GitHub Repository"
			>
			</a>
		</li>
	</ul>

	<div class="secondary">
		<GuideContents {sections} bind:open />
	</div>
</nav>


		{data}
		x={xKey}
		r={rKey}
		z={zKey}
		xScale={scaleBand()}
		xDomain={seriesNames}
		rRange={[3, 12]}
		zScale={scaleOrdinal()}
		zDomain={seriesNames}
		zRange={seriesColors}
	>

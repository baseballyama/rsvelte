	<LayerCake
		{data}
		x={xKey}
		r={rKey}
		z={zKey}
		xScale={scaleBand()}
		rRange={[3, 12]}
		zScale={scaleOrdinal()}
		zRange={seriesColors}
	>
		<Svg>
			<ForceLayout {manyBodyStrength} {xStrength} groupBy={JSON.parse(groupBy)} nodeStroke="#000" />
		</Svg>
	</LayerCake>
</div>


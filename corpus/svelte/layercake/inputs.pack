				<AxisY
					{tickMarks}
					{snapBaselineLabel}
					{labelPosition}
					{gridlines}
					{tickMarkLength}
					{tickGutter}
					{dx}
					{dy}
					ticks={4}
				/>
			</Svg>
		</LayerCake>
	</div>
</div>


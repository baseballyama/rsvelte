	const seriesNameSet = new Set();
	const seriesColors = ['#f0c', '#0cf', '#fc0'];

	data.forEach(d => {
		seriesNameSet.add(d[zKey]);
	});

	/* --------------------------------------------
	 * Convert this to an array so we can use it in our scales

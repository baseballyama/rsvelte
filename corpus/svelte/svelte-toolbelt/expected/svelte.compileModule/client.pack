import * as $ from 'svelte/internal/client';
import { untrack } from "svelte";

export function watch(box, callback, options = {}) {
	let prev = $.state($.proxy(box.current));
	let ranOnce = false;

	const watchEffect = $.effect_root(() => {
		$.user_pre_effect(() => {
			if ($.get(prev) === box.current || !options.immediate) return;
			if (options.once && ranOnce) return;

			callback(box.current, untrack(() => $.get(prev)));
			untrack(() => $.set(prev, box.current, true));
			ranOnce = true;
		});

		$.user_effect(() => {
			if ($.get(prev) === box.current || options.immediate) return;
			if (options.once && ranOnce) return;

			callback(box.current, untrack(() => $.get(prev)));
			untrack(() => $.set(prev, box.current, true));
			ranOnce = true;
		});
	});

	return watchEffect;
}

describe("mergeProps", () => {
	it("should merge objects", () => {
		const props1 = { a: 1, b: 2 };
		const props2 = { c: 3 };
		const result = mergeProps(props1, props2);
		expect(result).toEqual({ a: 1, b: 2, c: 3 });
	});

	it("should override values with the last one", () => {
		const props1 = { a: 1 };
		const props2 = { a: 2 };
		const result = mergeProps(props1, props2);
		expect(result).toEqual({ a: 2 });
	});


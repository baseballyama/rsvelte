            border: '1px solid transparent',
            borderBottom: orientation === 'horizontal' ? '0' : '1px solid transparent',
            borderRight: orientation === 'vertical' ? '0' : '1px solid transparent',
            color: theme.fn.themeColor('gray', 7),

import { useSvelteUITheme, useSvelteUIThemeContext } from '../../../SvelteUIProvider';
export function themeColor(color, shade = 0) {
    const theme = useSvelteUIThemeContext()?.theme || useSvelteUITheme();
    let _shade = '50';
    if (!isSvelteUIColor(color))
        return color;
    if (shade !== Number(0))
        _shade = `${shade.toString()}00`;
    return theme.colors[`${color}${_shade}`]?.value;
}
function isSvelteUIColor(color) {
    let valid = false;
    switch (color) {
        case 'dark':

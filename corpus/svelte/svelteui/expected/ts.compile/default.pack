export function getCumulativeSections(sections) {
    return sections.reduce((acc, section) => {
        acc.sections.push({ ...section, accumulated: acc.accumulated });
        acc.accumulated += section.value;
        return acc;
    }, { accumulated: 0, sections: [] }).sections;

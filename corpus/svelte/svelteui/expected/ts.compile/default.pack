=== 267 packages/svelteui-core/src/components/JsonInput/validate-json/validate-json.ts	js
export function validateJson(value, deserialize) {
    if (!value || (typeof value === 'string' && value.trim().length === 0)) {
        return true;
    }
    try {
        deserialize(value);
        return true;
    }
    catch (e) {
        return false;
    }
}


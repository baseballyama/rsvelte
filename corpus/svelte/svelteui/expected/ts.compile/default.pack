=== 297 packages/svelteui-core/src/styles/theme/functions/fns/radius/radius.ts	js
import { useSvelteUITheme, useSvelteUIThemeContext } from '../../../SvelteUIProvider';
export function radius(radii) {
    const theme = useSvelteUIThemeContext()?.theme || useSvelteUITheme();
    if (typeof radii === 'number') {
        return radii;
    }
    return theme.radii[radii].value;
}

=== 290 packages/svelteui-core/src/styles/theme/functions/fns/rgba/rgba.ts	js
import { toRgba } from '../../../utils/to-rgba/to-rgba';
export function rgba(color, alpha = 1) {
    if (typeof color !== 'string' || alpha > 1 || alpha < 0) {
        return 'rgba(0, 0, 0, 1)';
    }
    const { r, g, b } = toRgba(color);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

=== 278 packages/svelteui-core/src/styles/theme/functions/fns/size/size.ts	js
export function size(props) {
    if (typeof props.size === 'number') {
        return props.size;
    }
    if (typeof props.sizes[props.size] === 'number') {
        return props.sizes[props.size];
    }
    return +props.sizes[props.size]?.value || +props.sizes.md?.value;
}


						label: 'Controls also not rendered when input is disabled',
						placeholder: 'Disabled',
						disabled: true
					});

					$$renderer.push(`<!---->`);
				},
				$$slots: { default: true }
			});
		},
		$$slots: { default: true }
	});
}

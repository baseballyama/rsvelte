				children: ($$renderer) => {
					$$renderer.push(`<a${$.attr('href', `${$.stringify(base)}/introduction`)}>`);

					Button($$renderer, {
						fullSize: $.store_get($$store_subs ??= {}, '$mobile', mobile) ? true : false,
						size: 'xl',
						variant: 'gradient',

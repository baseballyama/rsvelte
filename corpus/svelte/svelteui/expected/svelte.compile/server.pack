						$$renderer.push('<!--[!-->');
						$$renderer.push('<!--]-->');
					}

					$$renderer.push(` `);

					if (Timeline.Item) {
						$$renderer.push('<!--[-->');

						Timeline.Item($$renderer, {
							bullet: LightningBolt,

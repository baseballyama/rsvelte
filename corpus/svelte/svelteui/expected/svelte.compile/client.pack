<ActionIcon
    variant='default'
    on:click={() => input.decrement()}
>
    -
<\/ActionIcon>
<NumberInput
    bind:this={input}
    hideControls
    defaultValue={0}
    max={10}
    min={0}
    step={2}
\/>
<ActionIcon
    variant='default'
    on:click={() => input.increment()}
>
    +
<\/ActionIcon>
`;


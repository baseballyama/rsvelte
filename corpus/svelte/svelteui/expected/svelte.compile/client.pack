					});

					$.append($$anchor, fragment_1);
				},
				$$slots: { default: true }
			});

			var node_4 = $.sibling(node_1, 2);

			Badge(node_4, {
				override: { display: 'inline-block' },
				variant: 'outline',
				children: ($$anchor, $$slotProps) => {

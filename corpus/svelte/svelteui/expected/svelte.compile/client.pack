			var fragment_1 = root();
			var node = $.first_child(fragment_1);

			Image(node, {
				width: 200,
				height: 120,
				src: null,
				alt: 'Without placeholder'
			});

			var node_1 = $.sibling(node, 2);

			Image(node_1, {
				width: 200,
				height: 120,
				src: null,
				alt: 'With default placeholder',
				usePlaceholder: true
			});

			var node_2 = $.sibling(node_1, 2);

			Image(node_2, {

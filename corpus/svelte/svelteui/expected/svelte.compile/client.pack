				position: 'center',
				children: ($$anchor, $$slotProps) => {
					Button($$anchor, {
						$$events: { click: () => open = true },
						children: ($$anchor, $$slotProps) => {
							$.next();

							var text = $.text('Open Modal');

							$.append($$anchor, text);
						},
						$$slots: { default: true }
					});
				},
				$$slots: { default: true }
			});


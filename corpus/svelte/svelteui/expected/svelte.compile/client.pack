					var fragment_1 = root();
					var node_2 = $.first_child(fragment_1);

					Title(node_2, {
						get override() {
							return title;
						},
						order: 2,
						inline: true,
						children: ($$anchor, $$slotProps) => {
							$.next();

							var text = $.text('Svelte');

							$.append($$anchor, text);
						},
						$$slots: { default: true }
					});

					var node_3 = $.sibling(node_2, 2);

					Title(node_3, {
						get override() {
							return title;
						},
						order: 2,
						inline: true,
						color: 'blue',
						children: ($$anchor, $$slotProps) => {
							$.next();

							var text_1 = $.text('UI');

							$.append($$anchor, text_1);
						},

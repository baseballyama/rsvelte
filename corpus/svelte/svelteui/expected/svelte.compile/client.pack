							defaultValue: 0,
							max: 10,
							min: 0,
							step: 2
						}),
						($$value) => input = $$value,
						() => input
					);
				},
				$$slots: { default: true }
			});

			var node_2 = $.sibling(node_1, 2);

			ActionIcon(node_2, {
				variant: 'default',
				$$events: { click: () => input.increment() },
				children: ($$anchor, $$slotProps) => {
					$.next();

					var text_1 = $.text('+');

					$.append($$anchor, text_1);
				},
				$$slots: { default: true }
			});

			$.append($$anchor, fragment_1);
		},
		$$slots: { default: true }
	});
}

				$$slots: {
					placeholder: ($$anchor, $$slotProps) => {
						Text($$anchor, {
							align: 'center',
							children: ($$anchor, $$slotProps) => {
								$.next();

								var text = $.text('This image would have changed your life');

								$.append($$anchor, text);
							},
							$$slots: { default: true }
						});
					}
				}
			});

			$.append($$anchor, fragment_1);
		},
		$$slots: { default: true }
	});
}

						$.next();

						var text_2 = $.text('Toggle overlay');

						$.append($$anchor, text_2);
					},
					$$slots: { default: true }
				});

				$.append($$anchor, fragment_4);
			}
		}
	});

	$.append($$anchor, fragment);
}

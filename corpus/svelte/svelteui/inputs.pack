=== 252 packages/svelteui-core/src/components/JsonInput/validate-json/validate-json.ts	ts	module	-
export function validateJson(value: string, deserialize: typeof JSON.parse) {
	if (!value || (typeof value === 'string' && value.trim().length === 0)) {
		return true;
	}

	try {
		deserialize(value);
		return true;
	} catch (e) {
		return false;
	}
}


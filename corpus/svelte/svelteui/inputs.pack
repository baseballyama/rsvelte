		label="Price"
		defaultValue={1000}
		parser={(value) => value.replace(/\$\s?|(,*)/g, '')}
		formatter={(value) =>
			!Number.isNaN(parseFloat(value))
				? ('$ ' + value).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
				: '$ '}
	/>
</Group>


import { createStyles } from '$lib/styles';

export interface AspectRatioStylesParams {
	ratio: number;
}

export default createStyles((theme, { ratio }: AspectRatioStylesParams) => {
	return {
		root: {
			position: 'relative',
			maxWidth: '100%',

			'&::before': {
				content: '""',
				height: 0,
				display: 'block',
				paddingBottom: `${(1 / ratio) * 100}%`
			},

			'&::after': {
				content: '""',
				display: 'table',
				clear: 'both'
			},

			'& > *:not(style)': {
				...theme.fn.cover(),
				overflow: 'hidden',
				display: 'flex',
				justifyContent: 'center',
				alignItems: 'center',
				width: '100%',
				height: '100%'
			},

			'& img, & video': {
				objectFit: 'cover'
			},

			'& figure': {
				width: '100%'
			}
		}
	};
});


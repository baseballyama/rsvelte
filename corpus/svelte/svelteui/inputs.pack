=== 243 packages/svelteui-dates/src/utils/get-years-range/get-years-range.ts	ts	module	-
export interface YearsRange {
	from: number;
	to: number;
}

export function getYearsRange(range: YearsRange) {
	const years: number[] = [];

	for (let year = range.from; year <= range.to; year += 1) {
		years.push(year);
	}

	return years;
}


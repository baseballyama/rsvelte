		</div>
		<Button on:click={() => (opened = false)}>Save to profile</Button>
	</Tooltip>

	{#if !opened}
		<Button variant="default" override={{ marginLeft: '10px' }} on:click={() => (opened = true)}>
			Reopen tooltip
		</Button>
	{/if}
</Center>


=== 483 packages/svelteui-core/src/styles/theme/utils/extract-system-styles/extract-system-styles.ts	ts	module	-
import type { SvelteUIStyleSystemProps } from '../../types';

export function extractSystemStyles(others: SvelteUIStyleSystemProps & { [key: string]: any }) {
	const { m, mx, my, mt, mb, ml, mr, p, px, py, pt, pb, pl, pr, ...rest } = others;
	const systemStyles = { m, mx, my, mt, mb, ml, mr, p, px, py, pt, pb, pl, pr };

	Object.keys(systemStyles).forEach((key) => {
		if (systemStyles[key] === undefined) {
			delete systemStyles[key];
		}
	});

	return { systemStyles, rest };
}


	import { useFocusWithin, upperFirst } from '@svelteuidev/composables';

	const [focused, ref] = useFocusWithin();
	const theme = useSvelteUITheme();
	const blue = theme.colors.blue50.value;
	const style = 'padding:1rem;border-radius:8px';

<Story name="Bind group" id="radioBindGroupStory">
	<RadioGroup
		bind:group={bindGroup}
		items={[
			{ label: 'One', value: 'one' },
			{ label: 'Two', value: 'two' },
			{ label: 'Three', value: 'three' }
		]}
	/>
	<p>Variable bound to group: <code>{bindGroup}</code></p>
</Story>

<Story name="Spacing" id="radioSpacingStory">

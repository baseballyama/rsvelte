    @media screen and (min-width: 640px) {
        .layout.svelte-12qhfyh {
            grid-template-areas:
                "header header"
                "menu main"
                "menu main";
        }

        .header.svelte-12qhfyh {
            box-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
            z-index: 2;
        }

        .menu.svelte-12qhfyh {
            flex-direction: column;
            align-items: stretch;
            justify-content: start;
            width: 10rem;
            padding: 0;
            box-shadow: 0 0 5px rgba(0, 0, 0, 0.5);

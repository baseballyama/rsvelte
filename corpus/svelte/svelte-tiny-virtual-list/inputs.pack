		<label for="scroll-offset">Scroll to offset...</label>
	</div>

	<article>
		<VirtualList
			height={500}
			width="auto"
			itemCount={10000}
			itemSize={(index) => rowHeights[index]}
			{scrollOffset}
		>
			{#snippet item({ style, index })}
				<div {style} class="virtual-list-row">
					Item #{index}
				</div>
			{/snippet}
